// `must x` on a `T?`: the `T`, or a stop at the `none`.
import "testing"

type User = shared struct {
    name: str
    nick: str?
}

func find(anon id: int64) -> User? {
    if id < 0 {
        return none
    }
    return User(name: f"user{id}", nick: f"n{id}")
}

func twice(anon n: int64) -> int64 {
    return n * 2
}

test "must gives the value of a present optional" {
    let n: int64? = 4
    let a = must n
    assert a + 1 == 5
    assert twice(must n) == 8
    assert (must find(1)).name == "user1"
    assert must find(2)?.nick == "n2"
    assert must "a,b".find(",") == 1
    mut m = Map[str, int64]()
    m.set("k", 9)
    assert must m.get("k") == 9
}

test "must on none stops the program" {
    let r = testing.run(func() {
        let missing: int64? = none
        print(must missing)
        print("not reached")
    })
    assert r.status == 1
    assert r.stdout == ""
    assert r.stderr.contains("must on none")
}
