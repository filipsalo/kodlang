// A hint names the file of a call it follows into another module.
import "./hint_xmod_line_dep"

func pick(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    return hint_xmod_line_dep.die("neg")
}

func main() -> int64 {
    print_int(pick(1))
    return 0
}

