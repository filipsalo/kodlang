// A generic type another module declares, constructed through the module's name.
import "./generic_qual_dep"

type Stack[T] = struct {
    items: [T]
}

type Holder = struct {
    fs: [func(int64) -> int64]
}

func main() -> int64 {
    let a = generic_qual_dep.Box[int64](v: 1)
    print(a.get())

    // Arguments from the module, from here, and nested.
    let b = generic_qual_dep.Box[generic_qual_dep.Pt](v: generic_qual_dep.Pt(x: 2))
    print(b.get().x)
    let c = generic_qual_dep.Box[[generic_qual_dep.Pt]](v: [generic_qual_dep.Pt(x: 3)])
    print(c.v[0].x)
    let d = generic_qual_dep.Pair[str, generic_qual_dep.Box[generic_qual_dep.Pt]](a: "s", b: b)
    print(d.b.get().x)
    let e = generic_qual_dep.Box[Stack[int64]](v: Stack[int64](items: [4]))
    print(e.v.items[0])
    let f = generic_qual_dep.Box[int64?](v: none)
    print(f.v is none)

    // As a type argument of a type here, an enum among them.
    let g = Stack[generic_qual_dep.Box[str]](items: [generic_qual_dep.Box[str](v: "five")])
    print(g.items[0].get())
    let h = Stack[generic_qual_dep.Opt[int64]](items: [.Yes(v: 6), .No])
    print(len(h.items))

    // A written type and the constructor are one type.
    let i: generic_qual_dep.Box[generic_qual_dep.Pt] = generic_qual_dep.Box[generic_qual_dep.Pt](v: generic_qual_dep.Pt(x: 7))
    print(i.get().x)

    // Square brackets that aren't type arguments still index or call.
    print(generic_qual_dep.first[int64]([8]))
    print(generic_qual_dep.TABLE[0](8))
    let holder = Holder(fs: [generic_qual_dep.add_one])
    print(holder.fs[0](9))
    return 0
}

// expected output:
// 1
// 2
// 3
// 2
// 4
// true
// five
// 2
// 7
// 8
// 9
// 10
