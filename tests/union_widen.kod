// A union widens into one with all of its members, and prints as the member it holds.
type Pt = struct {
    x: int64
    func to_str(self) -> str { return f"Pt({self.x})" }
}
type Small = int64 | str
type Big = int64 | str | bool | Pt
type Holder = struct { v: Big }
type Box = enum {
    Full(v: Big)
    Empty
}

func show(anon b: Big) -> str {
    return match b {
        int64(n) -> f"int {n}"
        str(s) -> f"str {s}"
        bool(t) -> f"bool {t}"
        Pt(p) -> f"pt {p.x}"
    }
}

func up(anon s: Small) -> Big {
    return s
}

func main() -> int64 {
    let s: Small = "hi"
    let b: Big = s
    print(show(b))
    print(show(up(7)))
    let h = Holder(v: s)
    print(show(h.v))
    let x = Box.Full(v: s)
    if x is .Full(v) {
        print(show(v))
    }
    let o: Big? = s
    print(f"{o is none}")
    let p: Big = Pt(x: 3)
    print(f"{s} {b} {p}")
    print(s)
    print(p)
    let mixed: Big = true
    print("v=" + str(mixed))
    return 0
}

// expected output:
// str hi
// int 7
// str hi
// str hi
// false
// hi hi Pt(3)
// hi
// Pt(3)
// v=true
