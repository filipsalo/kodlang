// Enums passed as arguments, compared and matched in the callee.
type Direction = enum {
	North
	South
}

type Message = enum {
	Text(content: str)
	Number(value: int64)
}

func which_dir(anon d: Direction) -> str {
	if d == Direction.North {
		return "north"
	} else {
		return "south"
	}
}

func describe(anon m: Message) -> str {
	match m {
		Message.Text(content) -> return content
		Message.Number(value) -> return f"{value}"
	}
}

test "enums as arguments" {
	let d1: Direction = Direction.North
	let d2: Direction = Direction.South
	assert which_dir(d1) == "north"
	assert which_dir(d2) == "south"
	let m1: Message = Message.Text(content: "hello")
	let m2: Message = Message.Number(value: 42)
	assert describe(m1) == "hello"
	assert describe(m2) == "42"
}
