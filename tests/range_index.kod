// `for i in 0..len(xs)` indexes `xs[i]` without a bounds check, reading and
// writing. Arrays only grow, so an index below the length at the start stays
// in range.

func total(anon xs: [int64]) -> int64 {
    mut sum = 0
    for i in 0..len(xs) {
        sum += xs[i] * i
    }
    return sum
}

func main() -> int64 {
    mut xs = [5, 6, 7, 8]
    print(total(xs))
    for i in 1..len(xs) {
        xs[i] = xs[i] + xs[i - 1]
    }
    print(xs[3])
    mut words = ["a", "b"]
    for i in 0..len(words) {
        words[i] = words[i] + words[i]
    }
    print(" ".join(words))
    mut seen = 0
    for i in 0..len(xs) {
        for j in 0..len(words) {
            if len(words[j]) == 2 and xs[i] > 10 {
                seen += 1
            }
        }
    }
    print(seen)
    return 0
}

// expected output:
// 44
// 26
// aa bb
// 6
// expected status:
// 0
