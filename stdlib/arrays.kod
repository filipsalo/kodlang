// What's the same for an array of any type. Elements compare with `==`.

func contains[T](anon xs: [T], anon x: T) -> bool {
    for item in xs {
        if item == x {
            return true
        }
    }
    return false
}

func equal[T](anon a: [T], anon b: [T]) -> bool {
    if len(a) != len(b) {
        return false
    }
    for i, item in a {
        if item != b[i] {
            return false
        }
    }
    return true
}

// Takes the last element off and gives it, or none when there are none.
func pop[T](anon mut xs: [T]) -> T? {
    if len(xs) == 0 {
        return none
    }
    let last = xs[len(xs) - 1]
    xs = xs[..-1]
    return last
}

// The elements, last first, in a new array.
func reversed[T](anon xs: [T]) -> [T] {
    return [xs[i] for i in len(xs) - 1..=0 step -1]
}

// What the numbers come to, 0 for none.
func sum(anon xs: [int64]) -> int64 {
    mut total = 0
    for x in xs {
        total += x
    }
    return total
}

func sum_floats(anon xs: [float64]) -> float64 {
    mut total = 0.0
    for x in xs {
        total += x
    }
    return total
}

// The smallest element, the first of those that are, or none when there are none.
func min[T](anon xs: [T]) -> T? {
    if len(xs) == 0 {
        return none
    }
    mut best = xs[0]
    for x in xs {
        if x < best {
            best = x
        }
    }
    return best
}

// The largest element, the first of those that are, or none when there are none.
func max[T](anon xs: [T]) -> T? {
    if len(xs) == 0 {
        return none
    }
    mut best = xs[0]
    for x in xs {
        if best < x {
            best = x
        }
    }
    return best
}

// Whether one of them is true: not when there are none.
func any(anon xs: [bool]) -> bool {
    for x in xs {
        if x {
            return true
        }
    }
    return false
}

// Whether all of them are true, as they are when there are none.
func all(anon xs: [bool]) -> bool {
    for x in xs {
        if not x {
            return false
        }
    }
    return true
}
