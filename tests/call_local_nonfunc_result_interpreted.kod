// A `T or Error` is spelled from its Ok payload, not by the interpreter's
// own class for it.
type Oops = struct {
    code: int64

    func to_str(self) -> str {
        return "oops"
    }
}

func might(anon n: int64) -> int64 or Error {
    if n == 0 {
        throw Oops(code: 1)
    }
    return n
}

func main() -> int64 {
    print("start")
    let g = might(1)
    print_int(g(1))
    return 0
}

// expected mode:
// interpret
// expected output:
// start
// expected stderr:
// 21:15: error: `g` is a local of type `int64 or Error`, not a function
// expected status:
// 1
