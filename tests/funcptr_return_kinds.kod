// A call through a function value has the function type's return kind,
// so interpolating the result prints the str rather than its pointer.

type Holder = struct {
    fn: func(int64) -> str
}

func label(anon n: int64) -> str {
    return f"#{n}"
}

func shout(anon n: int64) -> int64 {
    return n * 100
}

func get_fn() -> func(int64) -> str {
    return label
}

func main() -> int64 {
    let f = label
    print(f"{f(1)}")
    let fs = [label]
    print(f"{fs[0](2)}")
    let h = Holder(fn: label)
    print(f"{h.fn(7)}")
    print(f"{get_fn()(3)}")
    let s = f(4)
    print(s + "!")
    let shout = label
    print(f"{shout(5)}")
    return 0
}

// expected output:
// #1
// #2
// #7
// #3
// #4!
// #5
// expected status:
// 0
