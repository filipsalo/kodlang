    for row in rows {
        assert kod_f64_from_bits(row[0].parse_int()? or 0).to_str() == row[1]
    }
}

// `digits` without the zeros at their end.
func without_zeros(anon digits: str) -> str {
    mut n = len(digits)
    for n > 1 and digits[n - 1] == '0' {
        n -= 1
    }
    return digits[0..n]
}

// The significant digits of a number as text.
func digits_of(anon x: float64) -> str {
    let mantissa = x.to_str().split("e")[0].replace(".", to: "")
    mut from = 0
    for from < len(mantissa) - 1 and mantissa[from] == '0' {
        from += 1
    }
    return without_zeros(mantissa[from..len(mantissa)])
}

test "the quick ways give what the exact ones do" {
    mut x: int64 = 88172645463325252
    mut small = 0
    for i in 0..4000 {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        // Any bits, and magnitudes near 1 with few or many of them.
        mut bits = x & 0x7fffffffffffffff
        if i % 4 > 0 {
            bits = (x & 0xfffffffffffff) | (1023 - 35 + ((x >> 52) & 63)) << 52
        }
        if i % 4 > 1 {
            bits = bits >> 40 << 40
        }
        let f = kod_f64_from_bits(bits)
        if f.is_nan() or f.is_inf() or bits >> 52 == 0 {
            continue
        }
        let back = f.to_str().parse_float()? or 0.0
        assert kod_f64_bits(back) == bits
        let m = (bits & 0xfffffffffffff) + (1 << 52)
        let e = (bits >> 52) - 1075
        if bits % 1024 != 0 or i % 8 == 3 {
            assert without_zeros(float_text.shortest_exact(m, e).split(":")[0]) == digits_of(f)
        }
        for s in [0, 1, 2, 3, 6, 17, 27, -1, -2, -9, -27] {
            let q = float_text.scaled_small(m, e, s)
            if q >= 0 {
                small += 1
                assert f"{q}" == float_text.scaled_exact(m, e, s)
            }
        }
    }
    assert small > 20000
}

test "specs, more of them than are remembered" {
    for round in 0..3 {
        for w in 1..60 {
            assert len(f"{7.format(f"{w}")}") == w
            assert len(f"{7.5.format(f"{w}.1f")}") == (if_more(w, 3))
            assert 255.format(f"0{w}x").ends_with("ff")
            assert "ab".format(f"<{w}").starts_with("ab")
        }
        assert round >= 0
    }
}

func if_more(anon w: int64, anon least: int64) -> int64 {
    if w > least {
        return w
    }
    return least
}
