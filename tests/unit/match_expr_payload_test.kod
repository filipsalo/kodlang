// Match expressions bind payload fields the same way match statements do:
// qualified and implicit patterns, multi-field, str and struct payloads,
// plus T? and Result subjects.

type Point = shared struct {
	x: int64
	y: int64
}

type Shape = enum {
	Circle(r: int64)
	Rect(w: int64, h: int64)
	Label(text: str)
	At(p: Point)
	Empty
}

type IoError = shared struct {
	message: str
	func to_str(self) -> str { return self.message }
}

func plain(anon s: Shape) -> int64 {
	return match s {
		Shape.Circle(r) -> r
		else 0
	}
}

func tripled(anon s: Shape) -> int64 {
	let v: int64 = match s {
		.Circle(r) -> r * 3
		else 0
	}
	return v
}

func area(anon s: Shape) -> int64 {
	return match s {
		Shape.Circle(r) -> 3 * r * r
		Shape.Rect(w, h) -> w * h
		.At(p) -> p.x * p.y
		else -1
	}
}

func describe(anon s: Shape) -> str {
	return match s {
		.Circle(r) -> f"circle {r}"
		.Rect(w, h) -> f"rect {w}x{h}"
		.Label(text) -> "label " + text
		.At(p) -> f"at ({p.x}, {p.y})"
		.Empty -> "empty"
	}
}

func double(anon n: int64) -> int64 {
	return n * 2
}

func find(anon n: int64) -> int64? {
	if n > 0 {
		return n
	}
	return none
}

func parse(anon n: int64) -> int64 or Error {
	if n < 0 {
		throw IoError(message: "negative")
	}
	return n + 100
}

test "payload bindings in returns and lets" {
	assert plain(Shape.Circle(r: 2)) == 2
	assert plain(Shape.Empty) == 0
	assert tripled(.Circle(r: 5)) == 15
	assert area(Shape.Circle(r: 2)) == 12
	assert area(Shape.Rect(w: 4, h: 6)) == 24
	assert area(Shape.At(p: Point(x: 3, y: 7))) == 21
	assert area(Shape.Empty) == -1
	assert describe(Shape.Circle(r: 1)) == "circle 1"
	assert describe(Shape.Rect(w: 2, h: 3)) == "rect 2x3"
	assert describe(Shape.Label(text: "hi")) == "label hi"
	assert describe(Shape.At(p: Point(x: -1, y: 9))) == "at (-1, 9)"
	assert describe(Shape.Empty) == "empty"
}

test "match expressions as operands and arguments" {
	let s: Shape = Shape.Rect(w: 10, h: 20)
	// `f"{e}"` lowers to `"" + str(e)`; f-string interpolations can't
	// hold a `{`, so spell out the lowered form.
	assert "sum=" + str(match s { .Rect(w, h) -> w + h  else 0 }) == "sum=30"
	assert double(match s { Shape.Rect(w, h) -> h - w  else 0 }) == 20

	let label: Shape = Shape.Label(text: "kod")
	let name: str = match label {
		.Label(text) -> text + "!"
		else ""
	}
	assert name == "kod!"
}

test "optional and result subjects" {
	assert match find(7) { Some(n) -> n + 1  none -> 0 } == 8
	assert match find(-7) { Some(n) -> n + 1  none -> 0 } == 0
	assert match parse(5) { Ok(v) -> v  Err(e) -> -1 } == 105
	assert match parse(-5) { Ok(v) -> v.to_str()  Err(e) -> e.to_str() } == "negative"
}
