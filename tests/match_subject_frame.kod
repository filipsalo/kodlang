// Each match keeps its subject in its own stack slot, so a later match on a
// str still sees its subject after the calls that compare it to each arm.
type Color = enum { Red  Green  Blue }

func describe(anon c: Color, anon s: str) -> str {
    match c {
        .Red -> print("red")
        else -> print("not red")
    }
    match c {
        .Green -> print("green")
        else -> print("not green")
    }
    let n = match c {
        .Blue -> 3
        else -> 0
    }
    let .Red = c else {
        print(f"blue is {n}")
        match s {
            "aa" -> return "is aa"
            "bb" -> return "is bb"
            else -> return "other"
        }
    }
    match s {
        "aa" -> return "is aa"
        "bb" -> return "is bb"
        "cc" -> return "is cc"
        else -> return "other"
    }
}

func main() -> int64 {
    print(describe(.Red, "cc"))
    print(describe(.Blue, "bb"))
    return 0
}

// expected output:
// red
// not green
// is cc
// not red
// not green
// blue is 3
// is bb
