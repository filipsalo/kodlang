// An if with else-if branches takes the first branch whose condition holds.
func classify(anon n: int64) -> str {
	if n < 0 {
		return "negative"
	} else if n == 0 {
		return "zero"
	} else if n < 10 {
		return "small"
	} else {
		return "big"
	}
}

test "else if chains" {
	assert classify(-3) == "negative"
	assert classify(0) == "zero"
	assert classify(5) == "small"
	assert classify(100) == "big"
}
