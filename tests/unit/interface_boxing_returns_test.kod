// A struct returned as an interface's Ok or Some, or stored through op_index_set, is boxed.
interface Animal {
    func name(self) -> str
}

type Cat = shared struct {
    n: str
    func name(self) -> str { return self.n }
}

func mk() -> Animal or Error {
    return Cat(n: "res-cat")
}

func mko() -> Animal? {
    return Cat(n: "opt-cat")
}

test "returned as Ok or Some" {
    let a = must mk()
    assert a.name() == "res-cat"
    match mko() {
        Some(b) -> assert b.name() == "opt-cat"
        none -> fail("none")
    }
}

test "stored through set and op_index_set" {
    mut m: Map[str, Animal] = Map[str, Animal]()
    m.set("a", Cat(n: "via-set"))
    match m.get("a") {
        Some(v) -> assert v.name() == "via-set"
        none -> fail("miss a")
    }
    m["b"] = Cat(n: "via-index")
    match m.get("b") {
        Some(v) -> assert v.name() == "via-index"
        none -> fail("miss b")
    }
}
