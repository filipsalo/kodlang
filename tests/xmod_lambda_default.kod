import "./xmod_lambda_default_dep"

func main() -> int64 {
    let nine = func() -> int64 { return 9 }
    print(f"lambda default: {xmod_lambda_default_dep.run_lambda()}")
    print(f"function value default: {xmod_lambda_default_dep.run()}")
    print(f"own lambda: {xmod_lambda_default_dep.run(cb: nine)}")
    print(f"dep lambda: {xmod_lambda_default_dep.bumped()}")
    return 0
}

// expected output:
// lambda default: 7
// function value default: 1
// own lambda: 9
// dep lambda: 2
