// A union is one type however, and wherever, it is spelled.
import "./../union_dep"
import "./../union_dep" { Value, Unit, describe }

// Declared before the type it holds, and used before it is declared.
type Later = Far | str
type Holder = shared struct {
    v: Value
    later: Later = "soon"
}
type Boxed = enum {
    Full(v: union_dep.Value)
    Empty
}
type Far = shared struct {
    n: int64
}
type Op = func(int64) -> int64

func spell(anon v: int64 | union_dep.Unit | str) -> str {
    return describe(v)
}

func twice(anon n: int64) -> int64 {
    return n * 2
}

func apply(anon f: Op | int64) -> int64 {
    match f {
        Op(g) -> return g(4)
        int64(n) -> return n
    }
}

test "a union spelled in another module" {
    assert spell(1) == "number 1"
    assert spell("s") == "text s"
    assert spell(Unit(name: "m")) == "unit m"
    assert describe(union_dep.default_value()) == "unit kg"
    let h = Holder(v: 3)
    assert describe(h.v) == "number 3"
    let b: Boxed = .Full(v: "boxed")
    match b {
        .Full(v) -> assert describe(v) == "text boxed"
        .Empty -> fail("empty")
    }
}

test "a union declared before the type it holds" {
    let h = Holder(v: 3)
    if h.later is str(s) {
        assert s == "soon"
    } else {
        fail("not str")
    }
    let far: Later = Far(n: 6)
    if far is Far(f) {
        assert f.n == 6
    } else {
        fail("not Far")
    }
}

test "a union with a function type" {
    assert apply(twice) == 8
    assert apply(5) == 5
}

test "let-else takes a member through Some" {
    let maybe: Value | none = "there"
    let .Some(str(s)) = maybe else {
        fail("no member")
        return
    }
    assert s == "there"
}
