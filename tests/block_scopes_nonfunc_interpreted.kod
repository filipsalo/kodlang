// A binding in a block that holds no function hides an outer function value
// of its name, so the call is the compiler's error.
func double(anon n: int64) -> int64 {
    return n * 2
}

func main() -> int64 {
    let g = double
    print_int(g(1))
    if true {
        let g = 5
        print_int(g)
        print_int(g(1))
    }
    return 0
}

// expected mode:
// interpret
// expected output:
// 2
// 5
// expected stderr:
// 13:19: error: `g` is a local of type `int64`, not a function
// expected status:
// 1
