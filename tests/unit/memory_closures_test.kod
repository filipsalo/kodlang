// A closure's cell, and what it holds, go when the last reference does.
extern func rc_live_bytes() -> int64

type Thunk = func() -> str

type Box = shared struct {
    name: str
    run: func() -> str = plain
}

func plain() -> str {
    return "plain"
}

func make(anon s: str) -> func() -> str {
    return func() -> str {
        return s
    }
}

func nested(anon s: str) -> func() -> func() -> str {
    return func() -> func() -> str {
        return func() -> str {
            return s
        }
    }
}

func grows(anon f: func() -> none) -> bool {
    f()
    let start = rc_live_bytes()
    for _ in 0..1000 {
        f()
    }
    return rc_live_bytes() - start > 8000
}

func made_and_dropped() -> none {
    let f = make("a" + "b")
    let _ = f()
}

func called_as_temporary() -> none {
    let _ = make("a" + "b")()
}

func nested_dropped() -> none {
    let _ = nested("a" + "b")()()
}

func in_array() -> none {
    mut fs: [func() -> str] = []
    for i in 0..3 {
        let s = f"{i}" + "x"
        fs += [func() -> str { return s }]
    }
    for f in fs {
        let _ = f()
    }
}

func in_field() -> none {
    let s = "a" + "b"
    let b = Box(name: "n" + "m", run: func() -> str { return s })
    let _ = b.run()
    b.run = make("c" + "d")
    let _ = b.run()
    b.run = plain
}

func in_optional() -> none {
    let s = "a" + "b"
    let o: Thunk? = func() -> str { return s }
    let _ = (must o)()
}

func reassigned() -> none {
    mut f = make("a" + "b")
    f = make("c" + "d")
    f = plain
    let _ = f()
}

func returns_capture() -> none {
    let s = "a" + "b"
    let f = func() -> str { return s }
    let got = f()
    let _ = got + "c"
}

// The cell a call is running in goes away during the call.
func replaced_while_running() -> str {
    let b = Box(name: "x")
    let s = "still" + " here"
    b.run = func() -> str {
        b.run = plain
        return s + "!"
    }
    let got = b.run()
    b.run = plain
    return got
}

func cycle_broken() -> none {
    let b = Box(name: "x" + "y")
    b.run = func() -> str { return b.name }
    let _ = b.run()
    b.run = plain
}

func cycle() -> none {
    let b = Box(name: "x" + "y")
    b.run = func() -> str { return b.name }
}

test "a closure made and dropped is freed" {
    assert not grows(made_and_dropped)
}

test "a closure called as a temporary is freed" {
    assert not grows(called_as_temporary)
}

test "nested closures are freed" {
    assert not grows(nested_dropped)
}

test "closures in an array are freed" {
    assert not grows(in_array)
}

test "a closure in a field is freed when the field changes" {
    assert not grows(in_field)
}

test "a closure in a T? is freed" {
    assert not grows(in_optional)
}

test "a reassigned closure is freed" {
    assert not grows(reassigned)
}

test "what a closure returns of its capture is freed" {
    assert not grows(returns_capture)
}

test "the cell a call is running in can go away during the call" {
    assert not grows(func() -> none { let _ = replaced_while_running() })
    assert replaced_while_running() == "still here!"
}

test "a cycle through a closure is freed once broken" {
    assert not grows(cycle_broken)
}

// Documented: the one kind of leak there is.
test "a cycle through a closure leaks" {
    assert grows(cycle)
}
