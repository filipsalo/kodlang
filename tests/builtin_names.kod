// An unqualified `len`, `str`, `hash` or `kod_panic` is a local or
// parameter first, then the module's own function or an import item, then
// the builtin.
import "./builtin_names_dep" { hash, len, str, kod_panic }

type Point = struct {
    x: int64
}

func hash(anon p: Point) -> int64 {
    return p.x * 10
}

func len(anon a: int64, anon b: int64) -> int64 {
    return a + b
}

func kod_panic(anon m: str) -> none {
    print(f"own {m}")
}

func local_names() -> none {
    let str = func(anon n: int64) -> str {
        return f"<{n}>"
    }
    let kod_panic = func(m: str) -> none {
        print(f"local {m}")
    }
    print(str(5))
    kod_panic("x")
}

func param_names(anon hash: func(str) -> int64, anon kod_panic: func(str) -> none) -> int64 {
    kod_panic("y")
    return hash("abc")
}

func soft(anon m: str) -> none {
    print(f"soft {m}")
}

func seven(anon s: str) -> int64 {
    return 7
}

func main() -> int64 {
    print_int(hash(Point(x: 4)))
    print_int(len(2, 3))
    kod_panic("call")
    print(str(12))
    local_names()
    print_int(param_names(seven, soft))
    print_int(builtin_names_dep.hash("abc"))
    print_int(builtin_names_dep.len([1, 2]))
    print(builtin_names_dep.str(5))
    builtin_names_dep.kod_panic("q")
    return 0
}

// expected output:
// 40
// 5
// own call
// num
// <5>
// local x
// soft y
// 7
// 7
// 99
// num
// dep q 2
