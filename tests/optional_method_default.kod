// `x?.method(...)` fills the arguments it leaves out from the method's
// defaults, like an ordinary method call; a none receiver skips the call
// and its arguments.

type Counter = struct {
    value: int64

    func bump(self, by: int64 = 1, times: int64 = 1) -> int64 {
        self.value = self.value + by * times
        return self.value
    }
}

func noisy() -> int64 {
    print("evaluated")
    return 3
}

func main() -> int64 {
    let c: Counter? = Counter(value: 10)
    print_int(c?.bump()? or -1)
    print_int(c?.bump(by: 2)? or -1)
    print_int(c?.bump(by: 1, times: 2)? or -1)
    let gone: Counter? = none
    print_int(gone?.bump()? or -1)
    print_int(gone?.bump(by: noisy())? or -1)
    print_int(c?.bump(by: noisy())? or -1)
    return 0
}

// expected output:
// 11
// 13
// 15
// -1
// -1
// evaluated
// 18
