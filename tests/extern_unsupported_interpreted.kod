// An extern the interpreter doesn't mirror stops with a message; it is
// compiled-only.
import "process"

func main() -> int64 {
    print("before")
    let r: process.ProcessResult = process.run(["echo", "hi"])
    print(r.stdout)
    return 0
}

// expected output:
// before
// expected status:
// 1
// expected stderr:
// error: extern `kod_run_process` is not available in the interpreter; compile the program (`kod run`) to call it
// expected mode:
// interpret
