// Methods on the int64 primitive type. The compiler dispatches
// `n.to_str()`, `n.hash()`, etc. for int64 receivers to these
// functions. Not user-extensible: the codegen reaches into this
// specific module by hardcoded path.

func to_str(mut self: int64) -> str {
	if self == 0 {
		return "0"
	}
	let negative: bool = self < 0
	let digits: str = "0123456789"
	mut result: str = ""
	// Negating the smallest int64 overflows, so take digits off the signed value.
	for self != 0 {
		mut d: int64 = self % 10
		if d < 0 {
			d = 0 - d
		}
		result = digits[d..d+1] + result
		self = self / 10
	}
	if negative {
		result = "-" + result
	}
	return result
}

func hash(self: int64) -> int64 {
	return self
}

// The bit methods below are single instructions: the compiler puts the
// instruction in place of a call (`inline_intrinsic` in codegen.kod). These
// bodies give the same results for code built by an older compiler.

// How many zero bits are above the highest one bit; 64 for 0.
func leading_zeros(self: int64) -> int64 {
	mut x = self
	mut n: int64 = 0
	if x == 0 {
		return 64
	}
	for (x >> 63) == 0 {
		x = x << 1
		n += 1
	}
	return n
}

// How many zero bits are below the lowest one bit; 64 for 0.
func trailing_zeros(self: int64) -> int64 {
	mut x = self
	mut n: int64 = 0
	if x == 0 {
		return 64
	}
	for (x & 1) == 0 {
		x = x >> 1
		n += 1
	}
	return n
}

// How many bits are one.
func count_ones(self: int64) -> int64 {
	mut x = self
	mut n: int64 = 0
	for x != 0 {
		x = x & (x - 1)
		n += 1
	}
	return n
}

// The top 64 bits of the 128-bit product of self and m as unsigned numbers.
func mul_high(self: int64, anon m: int64) -> int64 {
	let mask: int64 = 4294967295
	let a_lo = self & mask
	let a_hi = self >> 32
	let b_lo = m & mask
	let b_hi = m >> 32
	let lh = a_lo * b_hi
	let hl = a_hi * b_lo
	let mid = ((a_lo * b_lo) >> 32) + (lh & mask) + (hl & mask)
	return a_hi * b_hi + (lh >> 32) + (hl >> 32) + (mid >> 32)
}
