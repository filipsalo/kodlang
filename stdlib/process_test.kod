// Direct in-process tests for `stdlib/process.kod`. Migrated from
// tests/process_run.kod — no build_and_run dance needed since the
// test program can just call `process.run` itself.

import "posix"
import "process"
import "stream" { IoError, IoKind }
import "time" { Duration }

test "process.run captures stdout and status from echo" {
    let r: process.ProcessResult = process.run(["echo", "hello"])
    assert r.status == 0
    assert r.stdout == "hello\n"
    assert r.stderr == ""
}

test "process.run captures stderr and a non-zero exit" {
    // `sh -c` drives both streams and a chosen exit code in one shot.
    let r: process.ProcessResult = process.run(["sh", "-c", "echo out; echo err 1>&2; exit 3"])
    assert r.status == 3
    assert r.stdout == "out\n"
    assert r.stderr == "err\n"
}

test "process.run reports -1 for a missing binary" {
    // posix_spawnp ENOENT — the runtime maps that to status -1 so
    // callers can distinguish "binary not found" from a real failure.
    let r: process.ProcessResult = process.run(["this-binary-does-not-exist-on-purpose"])
    assert r.status == -1
}

test "process.kill ends a child by its process id" {
    let pid = (must process.start(["sleep", "60"], stdin: .Null, stdout: .Null, stderr: .Null)).pid
    assert process.kill(pid)
    // reaped by `kill`, so there is nothing left to signal
    assert not process.kill(pid)
}

func output(anon child: process.Child) -> str {
    let out = must child.stdout.read_all()
    must child.stdout.close()
    return str(out)
}

test "process.start pipes stdin and stdout" {
    let child = must process.start(["cat"], stdin: .Pipe, stdout: .Pipe)
    assert child.pid > 0
    must child.stdin.write_str("through the pipe\n")
    must child.stdin.close()
    assert output(child) == "through the pipe\n"
    assert (must child.wait()) == 0
}

test "process.start gives the exit code and stderr" {
    let child = must process.start(["sh", "-c", "echo out; echo err 1>&2; exit 3"], stdout: .Null, stderr: .Pipe)
    let err = must child.stderr.read_all()
    assert str(err) == "err\n"
    assert (must child.wait()) == 3
}

test "process.start inherits by default" {
    let child = must process.start(["true"])
    assert child.stdin.fd == -1
    assert child.stdout.read(1) is Err(_)
    assert (must child.wait()) == 0
}

test "process.wait closes a piped stdin" {
    let child = must process.start(["cat"], stdin: .Pipe, stdout: .Null)
    assert (must child.wait()) == 0
    assert child.stdin.fd == -1
    assert child.wait() is Err(_)
}

test "process.start runs in dir and with env" {
    let here = must process.start(["pwd"], stdout: .Pipe, dir: "/")
    assert output(here) == "/\n"
    must here.wait()
    let child = must process.start(["sh", "-c", "printf %s \"$KOD_ONE-${HOME-none}\""], stdout: .Pipe, env: ["KOD_ONE=1"])
    assert output(child) == "1-none"
    must child.wait()
}

test "process.start fails for a missing program or directory" {
    let missing = process.start(["this-binary-does-not-exist-on-purpose"])
    if missing is Err(IoError(e)) {
        assert e.kind is .NotFound
        assert e.to_str().contains("this-binary-does-not-exist-on-purpose")
    } else {
        assert false
    }
    assert process.start(["true"], dir: "/no/such/dir/on/purpose") is Err(_)
    assert process.start([]) is Err(_)
}

test "process.kill ends a child that wait reports" {
    let child = must process.start(["sleep", "60"])
    must child.kill()
    let r = child.wait()
    if r is Err(process.ProcessError(e)) {
        assert e.message == "sleep was killed by SIGTERM"
    } else {
        assert false
    }
}

test "child.kill sends the signal it is given" {
    let child = must process.start(["sleep", "60"])
    must child.kill(signal: .Kill)
    let r = child.wait()
    if r is Err(process.ProcessError(e)) {
        assert e.message == "sleep was killed by SIGKILL"
    } else {
        assert false
    }
}

test "child.try_wait is none while the child runs, then its exit code" {
    let child = must process.start(["sh", "-c", "read x; exit 4"], stdin: .Pipe)
    assert (must child.try_wait()) is none
    must child.stdin.close()
    mut code: int64? = none
    for code is none {
        code = must child.try_wait()
    }
    assert (code? or -1) == 4
    assert child.wait() is Err(_)
}

test "child.try_wait reports a signal" {
    let child = must process.start(["sleep", "60"])
    must child.kill(signal: .Int)
    mut r = child.try_wait()
    for r is Ok(none) {
        r = child.try_wait()
    }
    if r is Err(process.ProcessError(e)) {
        assert e.message == "sleep was killed by SIGINT"
    } else {
        assert false
    }
}

test "process.output captures stdout, stderr and the status" {
    let out = must process.output(["sh", "-c", "echo out; echo err 1>&2; exit 2"])
    assert out.status == 2
    assert out.stdout == "out\n"
    assert out.stderr == "err\n"
}

test "process.output passes input and runs in dir with env" {
    let out = must process.output(["tr", "a-z", "A-Z"], input: "shout\n")
    assert out.stdout == "SHOUT\n"
    let here = must process.output(["sh", "-c", "pwd; printf %s \"$KOD_ONE\""], dir: "/", env: ["KOD_ONE=1"])
    assert here.stdout == "/\n1"
    let empty = must process.output(["cat"])
    assert empty.stdout == ""
}

test "process.output doesn't stall on a lot of output to both streams and input" {
    let big = "0123456789".repeat(50000)
    let script = "cat; i=0; while [ $i -lt 2000 ]; do echo error line $i 1>&2; i=$((i+1)); done"
    let out = must process.output(["sh", "-c", script], input: big)
    assert out.stdout == big
    assert len(out.stderr) > 30000
}

test "process.output doesn't mind a program that ignores its input" {
    let out = must process.output(["true"], input: "x".repeat(200000))
    assert out.status == 0
}

test "process.output fails for a missing program or a signal" {
    let missing = process.output(["this-binary-does-not-exist-on-purpose"])
    if missing is Err(IoError(e)) {
        assert e.kind is .NotFound
    } else {
        assert false
    }
    let killed = process.output(["sh", "-c", "kill -9 $$"])
    if killed is Err(process.ProcessError(e)) {
        assert e.message == "sh was killed by SIGKILL"
    } else {
        assert false
    }
}

test "posix.poll says which pipe is ready" {
    let quiet = must process.start(["sleep", "60"], stdout: .Pipe)
    let loud = must process.start(["echo", "hi"], stdout: .Pipe)
    let ready = must posix.poll(read: [quiet.stdout, loud.stdout])
    assert not ready.read[0]
    assert ready.read[1]
    let none_yet = must posix.poll(read: [quiet.stdout], timeout: Duration(ms: 20))
    assert not none_yet.read[0]
    must quiet.kill()
    let ended = must posix.poll(read: [quiet.stdout])
    assert ended.read[0]
    assert len(must quiet.stdout.read(10)) == 0
    assert quiet.wait() is Err(_)
    must loud.wait()
    must quiet.stdout.close()
    must loud.stdout.close()
}

test "posix.poll on a pipe to write to" {
    let child = must process.start(["sleep", "60"], stdin: .Pipe)
    let ready = must posix.poll(read: [], write: [child.stdin], timeout: Duration())
    assert ready.write[0]
    assert len(ready.read) == 0
    must child.kill()
    assert child.wait() is Err(_)
}

test "posix.poll needs something to wait for" {
    let closed = posix.Fd(fd: -1)
    let r = posix.poll(read: [closed])
    if r is Err(IoError(e)) {
        assert e.kind is .InvalidInput
    } else {
        assert false
    }
    assert posix.poll(read: []) is Err(_)
}

test "posix.signal sends a signal by number" {
    let child = must process.start(["sleep", "60"])
    must posix.signal(child.pid, 9)
    let r = child.wait()
    if r is Err(process.ProcessError(e)) {
        assert e.message == "sleep was killed by SIGKILL"
    } else {
        assert false
    }
    assert posix.signal(99999999, 0) is Err(_)
}

test "add_env sets variables on top of the environment" {
    let added = must process.output(["sh", "-c", "printf %s \"$KOD_A-$KOD_B-${PATH+path}\""], add_env: ["KOD_A=1", "KOD_B=two"])
    assert added.stdout == "1-two-path"
    let replaced = must process.output(["sh", "-c", "printf %s \"$HOME\""], add_env: ["HOME=/elsewhere"])
    assert replaced.stdout == "/elsewhere"
    let over_env = must process.output(["sh", "-c", "printf %s \"$KOD_A-$KOD_B-${PATH-none}\""], env: ["KOD_A=1", "KOD_B=2", "PATH=/bin:/usr/bin"], add_env: ["KOD_B=3", "KOD_C=4"])
    assert over_env.stdout == "1-3-/bin:/usr/bin"
    let empty_value = must process.output(["sh", "-c", "printf %s \"[${KOD_E-unset}]\""], add_env: ["KOD_E="])
    assert empty_value.stdout == "[]"
}

test "add_env takes only NAME=value" {
    for bad in ["NOEQUALS", "=value"] {
        let r = process.start(["true"], add_env: [bad])
        if r is Err(process.ProcessError(e)) {
            assert e.message.contains(bad)
        } else {
            assert false
        }
    }
}
