// A `.Variant` in a comparison chain takes the enum of the operand next to
// it, even when another enum the module sees declares the same name.
import "./chain_variant_context_dep"

type Mark = enum {
    Red
    End
}

func main() -> int64 {
    let c = chain_variant_context_dep.red()
    let d = chain_variant_context_dep.red()
    let m = Mark.End
    print(f"{.Red == c == d} {c == .Red == d} {c == d == .Red}")
    print(f"{.Green != c == d} {c == .Green == d} {m == .End == .End}")
    return 0
}

// expected output:
// true true true
// true false true
