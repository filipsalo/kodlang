// Type parameters in unions: instances, inference, and type patterns that name
// a union or an optional.

type Id = int64 | str

type MaybeInt = int64?

type Slot[T] = struct {
    value: T | str

    func show(self) -> str {
        match self.value {
            str(s) -> return f"str {s}"
            T(t) -> return f"T {t}"
        }
    }
}

type Either[T] = enum {
    One(value: T | bool)
    Two
}

func label[T](anon x: T | str) -> str {
    match x {
        str(s) -> return f"str {s}"
        T(t) -> return f"T {t}"
    }
}

func pick[T](anon x: T, text: bool) -> T | str {
    if text {
        return "text"
    }
    return x
}

// `T` stays a `T`, whatever the instance holds besides.
func keep[T](anon x: T | str, fallback: T) -> T {
    if x is T(t) {
        return t
    }
    return fallback
}

func either_text[T](anon e: Either[T]) -> str {
    match e {
        .One(v) -> {
            if v is bool(b) {
                return f"bool {b}"
            }
            return "T"
        }
        .Two -> return "two"
    }
}

func count_ids(anon xs: [int64 | str | bool]) -> int64 {
    mut n = 0
    for x in xs {
        if x is Id(_id) {
            n += 1
        }
    }
    return n
}

func describe(anon x: int64 | str | bool) -> str {
    match x {
        Id(id) -> return f"id {id}"
        bool(b) -> return f"bool {b}"
    }
}

func maybe(anon x: int64 | str | none) -> str {
    match x {
        MaybeInt(n) -> {
            if n is none {
                return "nothing"
            }
            return f"int {n}"
        }
        str(s) -> return f"str {s}"
    }
}

func main() -> int64 {
    print(label[int64](3))
    print(label[int64]("a"))
    print(label[str]("b"))
    print(label[int64 | bool](true))
    print(label[int64 | bool]("c"))
    print(label(4))
    let u: bool | str = false
    print(label(u))

    print(pick(5, text: false))
    print(pick(5, text: true))
    let p: int64 | str = pick(6, text: false)
    print(p)

    print(Slot[int64](value: 7).show())
    print(Slot[str](value: "s").show())
    print(Slot[int64 | bool](value: true).show())

    print(keep[int64](8, fallback: 0))
    print(keep[int64]("x", fallback: 9))
    let kept: int64 | bool = keep[int64 | bool](true, fallback: 1)
    print(kept)

    let e1: Either[int64] = .One(value: true)
    let e2: Either[int64] = .One(value: 3)
    let e3: Either[int64] = .Two
    print(either_text(e1))
    print(either_text(e2))
    print(either_text(e3))

    print(count_ids([1, "a", true, 2, false]))
    print(describe(10))
    print(describe("k"))
    print(describe(true))
    print(maybe(none))
    print(maybe(11))
    print(maybe("m"))
    return 0
}

// expected output:
// T 3
// str a
// str b
// T true
// str c
// T 4
// T false
// 5
// text
// 6
// T 7
// str s
// T true
// 8
// 9
// true
// bool true
// T
// two
// 3
// id 10
// id k
// bool true
// nothing
// int 11
// str m
