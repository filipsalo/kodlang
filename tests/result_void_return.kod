// A `none or Error` function that ends or returns without a value returns Ok(none).
type Oops = struct {
    n: int64
    func to_str(self) -> str { return f"oops {self.n}" }
}
func step(anon k: int64) -> none or Error {
    if k > 1 {
        throw Oops(n: k)
    }
    print(f"step {k}")
}
func early(anon k: int64) -> none or Error {
    if k == 0 {
        return
    }
    print(f"early {k}")
}
func chain() -> none or Error {
    let a = try step(0)
    let b = try early(0)
    let c = try step(5)
    print("unreachable")
}
func main() -> none or Error {
    if step(0) is Ok {
        print("ok0")
    }
    if step(2) is Err(e) {
        print(e.to_str())
    }
    let d = must step(1)
    let f = must early(0)
    let g = must early(3)
    if chain() is Err(e2) {
        print(f"chain {e2.to_str()}")
    }
    print("after")
}

// expected output:
// step 0
// ok0
// oops 2
// step 1
// early 3
// step 0
// chain oops 5
// after
// expected status:
// 0
