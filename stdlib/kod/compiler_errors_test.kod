test "values that fit the declared type compile cleanly" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Foo = struct {
            n: int64
            tag: int64? = none
        }
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        func twice(anon n: int64) -> int64 { return n * 2 }
        func main() -> int64 {
            let o: int64? = 5
            let gone: int64? = none
            let sh: Shape = Sq(s: 2)
            let shapes: [Shape] = [Sq(s: 1)]
            let foos: [Foo] = []
            let opts: [int64?] = [1, none]
            let opt: Option[int64] = .Some(value: 3)
            let f: func(int64) -> int64 = twice
            let foo = Foo(n: 1)
            foo.tag = 5
            foo.tag = none
            mut n: int64 = 0
            n = foo.n + 1
            return 0
        }
        """)
    assert len(errs) == 0
}

test "an unannotated generic enum constructor can't be inferred" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        func main() -> int64 {
            let m = Maybe.Just(value: 41)
            match m {
                .Just(value) -> print_int(value + 1)
                .Nothing -> print("nothing")
            }
            let c = .Just(value: 7)
            let n = Maybe.Nothing
            let r = Result.Ok(5)
            let o = Option.Some(3)
            if o is .Some(x) {
                print_int(x * 3)
            }
            match Maybe.Just(value: 1) {
                .Just(v) -> print_int(v)
                else -> {}
            }
            return 0
        }
        """)
    assert len(errs) == 6
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `m`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `c`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `n`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `r`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `o`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of this expression; add a type annotation")
}

test "a generic enum constructor takes its type from where it goes" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        type MaybeInt = Maybe[int64]
        func show(anon m: Maybe[int64]) -> none {
            if m is .Just(v) {
                print_int(v)
            }
        }
        func make(anon n: int64) -> Maybe[int64] {
            if n > 0 {
                return Maybe.Just(value: n)
            }
            return .Nothing
        }
        func parse(anon n: int64) -> int64 or Error {
            return .Ok(value: n)
        }
        func main() -> int64 {
            let a: Maybe[int64] = Maybe.Just(value: 41)
            let b: Maybe[int64] = .Just(value: 1)
            let c: MaybeInt? = .Just(value: 2)
            show(a)
            show(Maybe.Just(value: 3))
            show(.Nothing)
            show(make(4))
            let o: Option[int64] = Option.Some(value: 5)
            return must parse(1)
        }
        """)
    assert len(errs) == 0
}

test "an alias target with wrong type arguments" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Box = struct { x: int64 }
        type Pair[A, B] = struct {
            first: A
            second: B
        }
        type B = Map[str]
        type C = [Map[str]]
        type D = Box[int64]
        type P = Pair
        func main() -> int64 {
            let b: B = Map[str, int64]()
            b.set("a", 1)
            print_int(b.len())
            let c: C = []
            print_int(c[0].len())
            let d: D = Box(x: 1)
            print_int(d.x)
            let p: P = Pair[int64, int64](first: 1, second: 2)
            print_int(p.first)
            let q = Pair[P, int64](first: p, second: 1)
            let r: B? = none
            return 0
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "`Map` expects 2 type arguments, got 1")
    assert test_support.any_message_contains(errs, needle: "`Box` is not generic")
    assert test_support.any_message_contains(errs, needle: "generic struct `Pair` needs type arguments: write `Pair[A, B]`")
}

test "an unresolved alias isn't reported again where it's used" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Pair[A, B] = struct {
            first: A
            second: B
        }
        type A = Nope
        func main() -> int64 {
            let p = Pair[A, int64](first: 1, second: 2)
            let r: A[int64] = 1
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown type `Nope`")
}

test "operators don't take optional operands" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func main() -> int64 {
            let seen = Map[str, bool]()
            seen.set("a", true)
            if seen.get("a") == true {
                print("seen")
            }
            let ob: bool? = true
            if ob != false {
                print("ne")
            }
            let flag = true
            let oi: int64? = 1
            if flag == oi {
                print("x")
            }
            let n: int64? = 3
            if n == 3 {
                print("three")
            }
            let m = n + 1
            if n < 4 {
                print("lt")
            }
            if n == none or none != n {
                print("none")
            }
            if n? == 3 and (n? or 0) + 1 == 4 {
                print("ok")
            }
            return 0
        }
        """)
    assert len(errs) == 6
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool?` with `bool`; unwrap it first with `x?` or `x? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool?` with `bool`; unwrap it first with `ob?` or `ob? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool` with `int64?`; unwrap it first with `oi?` or `oi? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot compare `int64?` with `int64`; unwrap it first with `n?` or `n? or default`")
    assert test_support.any_message_contains(errs, needle: "`+` doesn't take an optional operand; unwrap it first with `n?` or `n? or default`")
    assert test_support.any_message_contains(errs, needle: "`<` doesn't take an optional operand; unwrap it first with `n?` or `n? or default`")
}

test "a value of unknown type doesn't cascade wherever it's used" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Box = struct {
            x: int64
            func get(self) -> int64 { return self.x }
        }
        interface Shower {
            func show(self) -> str
        }
        func take(anon s: str) -> none {
            print(s)
        }
        func takei(anon s: Shower) -> none {
            print(s.show())
        }
        func main() -> int64 {
            let b = Box(x: 1)
            mut w = b.nope()
            let z0 = w + 1
            let z1 = 1 + w.x
            let z2 = [w, w]
            print(f"{w + 1}")
            w.x = 5
            print_int(len(w))
            let z4 = w?.x
            let z5 = w?.m(1)
            let z6 = w(1)
            let z8 = match w {
                1 -> 2
                else -> 3
            }
            if w is none {
                print("none")
            }
            let .Some(r) = w else { return 1 }
            print_int(r.x)
            for q in w {
                print(q.name)
            }
            let s = w[1..2]
            w[0] = 1
            take(w)
            takei(w)
            let z9: int64? = w
            let z10: Shower = w
            if w == true and w {
                print("t")
            }
            let z12 = w? or 0
            let z13 = w.get()
            let z14 = w.x.y.z
            let z20 = hash(w)
            let z21 = [1, 2][w]
            w += 1
            return w
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown method `nope` on `b`")
}

test "a parameter of unknown type doesn't cascade" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func f(anon o: int64?) -> Strr {
            return o
        }
        func g(anon a: Strr) -> int64 {
            a.x = 1
            let n = [a]
            return len(a)
        }
        func h(anon a: Strr?) -> int64 {
            let v = a?.x
            return 0
        }
        func k(anon cb: func(Strr) -> int64) -> none {
            print(f"{cb}")
            if cb {
                print("cb")
            }
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 4
    for e in errs {
        assert e.message.contains("unknown type `Strr`")
    }
}

test "an uninferable value is reported where it's used" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        func take(anon n: int64) -> none {
            print_int(n)
        }
        func give() -> int64 {
            return Maybe.Just(value: 1)
        }
        func main() -> int64 {
            take(Maybe.Just(value: 2))
            mut n: int64 = 0
            n = Maybe.Nothing
            let xs = [1, Maybe.Just(value: 3)]
            return 0
        }
        """)
    assert len(errs) == 4
    for e in errs {
        assert e.message.contains("cannot infer the type of this expression")
    }
}

test "an implicit variant the expected enum doesn't declare" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Dir = enum {
            Left
            Right
        }
        type Move = enum {
            Up
            Down
        }
        func main() -> int64 {
            let d: Dir = .Up
            let o: Dir? = .Down
            let r: Result[int64, str] = .Some(value: 1)
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "enum `Dir` has no variant `Up`")
    assert test_support.any_message_contains(errs, needle: "enum `Dir` has no variant `Down`")
    assert test_support.any_message_contains(errs, needle: "enum `Result[int64, str]` has no variant `Some`")
}

test "try, must and ? need a fallible or optional value" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func f() -> int64 or Error {
            let n = 5
            let c = try n
            return c
        }
        func g(anon r: int64 or Error) -> int64 {
            return try r
        }
        func main() -> int64 {
            let n = 5
            let b = n? or 3
            let a = must n
            let o: int64? = 4
            let ok = must f() + (o? or 0) + o?
            return 0
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "`try` needs a `T or Error` value, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`try` only works in a function that returns `T or Error`")
    assert test_support.any_message_contains(errs, needle: "`?` needs an optional value, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`must` needs a `T or Error` value, got `int64`")
}

test "match expression arms of different types" {
    let errs: [codegen.Error] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        type Circle = struct {
            r: int64
            func area(self) -> int64 { return self.r }
        }
        func main() -> int64 {
            let k = 1
            let x = match k {
                1 -> "a"
                else -> 2
            }
            let s = match k {
                1 -> Sq(s: 2)
                else -> Circle(r: 1)
            }
            let n: str = match k {
                1 -> "a"
                else -> none
            }
            let ok: Shape = match k {
                1 -> Sq(s: 2)
                else -> Circle(r: 1)
            }
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "expected `str`, got `int64`")
    assert test_support.any_message_contains(errs, needle: "expected `Sq`, got `Circle`")
    assert test_support.any_message_contains(errs, needle: "expected `str`, got `none`")
}

test "an implicit variant pattern from another enum" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Shape = enum {
            Circle(radius: int64)
            Rect(w: int64, h: int64)
        }
        type Other = enum {
            Square
            Circle(r: int64, extra: int64)
        }
        func main() -> int64 {
            let s: Shape = .Circle(radius: 5)
            match s {
                .Square -> print("square")
                .Circle(r) -> print_int(r)
                else -> print("else")
            }
            let n = match s {
                .Square -> 1
                else -> 2
            }
            let .Square = s else { return 1 }
            return 0
        }
        """)
    assert len(errs) == 3
    for e in errs {
        assert e.message.contains("enum `Shape` has no variant `Square`")
    }
}

test "a plain value where a `T or Error` is declared" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func main() -> int64 {
            let r: int64 or Error = 3
            let ok: int64 or Error = .Ok(value: 3)
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "expected `int64 or Error`, got `int64`; write `.Ok(value: ...)` for a successful result")
}

test ".Some and .None patterns on an optional" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func main() -> int64 {
            let o: int64? = 5
            match o {
                .Some(v) -> print_int(v)
                .None -> print("none")
            }
            let n = match o {
                .Some(v) -> v
                .None -> 0
            }
            return n
        }
        """)
    assert len(errs) == 0
}

test "`is` binds tighter than `and` and `or`" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Color = enum {
            Red
            Green
        }
        func main() -> int64 {
            let f = true
            let o: int64? = none
            if f and o is none {
                print("both")
            }
            if o is not none or f {
                print("either")
            }
            let c: Color = .Red
            let red = c is .Red and o is none
            return 0
        }
        """)
    assert len(errs) == 0
}

test "an `is` pattern that binds inside a larger condition" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Color = enum {
            Red
            Green
        }
        func main() -> int64 {
            let f = true
            let o: int64? = 3
            mut v = 0
            if f and o is Some(v) {
                print_int(v)
            }
            let c: Color = .Red
            let r: int64 or Error = .Ok(value: 1)
            let a = c is .Blue
            let b = r is Some
            let d = o is .Ok
            return 0
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "`is` can't bind `v` here")
    assert test_support.any_message_contains(errs, needle: "enum `Color` has no variant `Blue`")
    assert test_support.any_message_contains(errs, needle: "`is` on a `T or Error` value takes `Ok` or `Err`")
    assert test_support.any_message_contains(errs, needle: "`is` on an optional takes `none` or `Some`")
}
