// Says it is ready, then waits on stdin until a signal ends it (or stdin
// closes). tests/stdio_test.py sends SIGTERM to `kod run` and expects the
// signal to be the program's own end.
import "io"

func main() -> int64 {
    print("ready")
    io.flush_stdout()
    let line: str = io.read_stdin_line()
    print(f"stdin ended: {line}")
    return 0
}

// expected mode:
// skip
