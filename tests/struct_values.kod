type Point = struct {
    x: int64
    y: int64

    func sum(self) -> int64 {
        return self.x + self.y
    }

    func shift(mut self, anon by: int64) -> none {
        self.x += by
        self.y += by
    }

    func bumped(self) -> Point {
        mut copy = self
        copy.shift(1)
        return copy
    }
}

type Line = struct {
    from: Point
    to: Point
    tags: [str] = []
}

type Log = shared struct {
    lines: [str] = []
}

type Holder = shared struct {
    p: Point
}

func moved(anon p: Point) -> Point {
    mut q = p
    q.x = 100
    return q
}

func grow(mut p: Point) -> none {
    p.shift(5)
}

func main() -> int64 {
    // Assigning shares, changing copies.
    mut a = Point(x: 1, y: 2)
    let b = a
    a.x = 10
    print(f"{a.x} {b.x}")

    // Fields of fields, and arrays in fields.
    mut line = Line(from: a, to: b)
    line.from.y = 5
    line.tags += ["t"]
    let kept = line
    line.to.x = 7
    line.tags[0] = "u"
    print(f"{line.from.y} {a.y} {line.to.x} {kept.to.x} {line.tags} {kept.tags}")

    // `mut self`, on a local, a field and an element.
    a.shift(1)
    line.from.shift(2)
    mut ps = [Point(x: 0, y: 0), Point(x: 1, y: 1)]
    ps[1].shift(3)
    print(f"{a.x} {line.from.x} {ps[1].x} {b.bumped().x} {b.x}")

    // Passing gives the function the struct as it is.
    let m = moved(a)
    print(f"{m.x} {a.x}")
    grow(p: mut a)
    print(a.x)

    // A value struct in a shared struct changes through the shared one.
    let h = Holder(p: Point(x: 1, y: 1))
    let same = h
    h.p.x = 9
    h.p.shift(1)
    print(f"{same.p.x} {same.p.sum()}")

    // A shared struct is shared.
    let log = Log()
    let other = log
    other.lines += ["one"]
    print(log.lines)

    // An array of structs holds each one's own.
    mut row = [a] * 2
    row[0].x = -1
    print(f"{row[0].x} {row[1].x}")
    return 0
}

// expected output:
// 10 1
// 5 2 7 1 [u] [t]
// 11 12 4 2 1
// 100 11
// 16
// 10 12
// [one]
// -1 16
