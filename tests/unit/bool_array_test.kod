// A [bool] holds a byte per element: literals, *, +, +=, slices, loops,
// copies and a Map's bool values all agree on that.

func flip(anon xs: [bool]) -> [bool] {
    mut out: [bool] = []
    for x in xs {
        out += [not x]
    }
    return out
}

test "bool arrays: literals, *, +, +=, slices, loops and copies" {
    let a = [true, false, true]
    mut b = [false] * 5
    b[3] = true
    mut c = a + b
    c += [true]
    assert len(c) == 9
    mut shown = ""
    for x in c {
        if x {
            shown += "1"
        } else {
            shown += "0"
        }
    }
    assert shown == "101000101"
    let d = c[2..6]
    assert d == [true, false, false, false]
    let e = flip(a)
    assert e == [false, true, false]
    mut copy = c
    copy[0] = false
    assert c[0] == true
    assert copy[0] == false
    mut seen = ""
    for i, x in a {
        seen += f"{i} {x};"
    }
    assert seen == "0 true;1 false;2 true;"
}

test "a map's bool values" {
    mut m = Map[str, bool]()
    m.set("x", true)
    m.set("y", false)
    assert (m.get("x")? or false) == true
    assert (m.get("y")? or true) == false
    assert m.len() == 2
}
