// A weak field refers to a struct without keeping it alive.

type Node = shared struct {
    name: str
    children: [Node] = []
    weak parent: Node?
}

type Watch = shared struct {
    weak target: Node? = none
    weak other: Node?
}

mut seen_parent: str = ""

func parent_name(anon n: Node) -> str {
    if n.parent is Node(p) {
        return p.name
    }
    return "none"
}

// The root goes when this returns: only the leaf's weak field refers to it.
func orphan() -> Node {
    let root = Node(name: "root" + "!")
    let leaf = Node(name: "leaf", parent: root)
    root.children += [leaf]
    seen_parent = parent_name(leaf)
    return leaf
}

// The binding `t` keeps the struct alive until this returns (a local lasts
// until its function returns), though `keep` lets go of it first.
func hold_while_replaced(anon held: Watch) -> str {
    mut keep = Node(name: "keep" + "!")
    held.target = keep
    if held.target is Node(t) {
        keep = Node(name: "other")
        return t.name
    }
    return "no target"
}

test "a weak parent goes with its last strong reference" {
    let leaf = orphan()
    assert seen_parent == "root!"
    assert parent_name(leaf) == "none"
}

test "weak fields follow assignments" {
    let a = Node(name: "a")
    let b = Node(name: "b")
    let w = Watch(target: a, other: a)
    assert (w.target?.name? or "gone") == "a"
    w.target = b
    assert (w.target?.name? or "gone") == "b"
    assert (w.other?.name? or "gone") == "a"
    w.target = none
    assert (w.target?.name? or "gone") == "gone"

    // Many weak fields, one struct.
    mut kids: [Node] = []
    for i in 0..3 {
        kids += [Node(name: f"kid{i}", parent: a)]
    }
    mut lines: [str] = []
    for k in kids {
        lines += [f"{k.name} of {parent_name(k)}"]
    }
    assert lines == ["kid0 of a", "kid1 of a", "kid2 of a"]
}

test "a value read from a weak field keeps the struct alive while it is used" {
    let held = Watch()
    assert hold_while_replaced(held) == "keep!"
    assert (held.target?.name? or "gone") == "gone"
}
