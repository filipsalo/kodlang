// Only the module that declares a variable assigns it.
import "./module_vars_assign_dep"
import "./module_vars_assign_dep" { count }

func main() -> int64 {
    count = 1
    module_vars_assign_dep.count += 2
    module_vars_assign_dep.words = ["x"]
    return 0
}

