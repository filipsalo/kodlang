// `.Variant(...)` takes its enum from where the value goes.
type Message = enum {
    Quit
    Text(content: str)
}

type Holder = shared struct {
    m: Message
}

func show(anon m: Message) -> str {
    return match m {
        .Quit -> "quit"
        .Text(content) -> content
    }
}

func make() -> Message {
    return .Text(content: "return")
}

test "the enum comes from where the value goes" {
    let a: Message = .Text(content: "let")
    assert show(a) == "let"
    assert show(.Text(content: "argument")) == "argument"
    assert show(make()) == "return"
    let h = Holder(m: .Text(content: "field"))
    assert show(h.m) == "field"
    h.m = .Text(content: "field assignment")
    assert show(h.m) == "field assignment"
    mut b: Message = .Quit
    b = .Text(content: "assignment")
    assert show(b) == "assignment"
    let ms: [Message] = [.Text(content: "element"), .Quit]
    mut shown: [str] = []
    for m in ms {
        shown += [show(m)]
    }
    assert shown == ["element", "quit"]
    let k = 1
    let c: Message = match k {
        1 -> .Text(content: "match arm")
        else -> .Quit
    }
    assert show(c) == "match arm"
    let u = .Text(content: "unannotated")
    assert show(u) == "unannotated"
}
