import "arrays"

type Color = enum {
    Red
    Green
}

test "contains: compares by ==, with strs by content" {
    assert arrays.contains([1, 2], 2)
    assert not arrays.contains([1, 2], 3)
    let joined = "a" + "b"
    assert arrays.contains(["ab"], joined)
    assert not arrays.contains(["ab"], "a")
    assert arrays.contains([Color.Red, Color.Green], .Green)
}

test "contains: empty" {
    assert not arrays.contains([], 1)
    let none_here: [str] = []
    assert not arrays.contains(none_here, "a")
}

test "equal: length and elements in order" {
    assert arrays.equal([1, 2], [1, 2])
    assert not arrays.equal([1, 2], [2, 1])
    assert not arrays.equal([1], [1, 2])
    assert arrays.equal(["a"], ["a"])
    let no_strs: [str] = []
    assert arrays.equal(no_strs, [])
}
