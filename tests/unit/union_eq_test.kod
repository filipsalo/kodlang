// `==` and `!=` on a union: equal when both hold the same member and those are `==`.
type Color = enum {
    Red
    Blue
}
type V = shared struct {
    n: int64
    func op_eq(self, anon other: V) -> bool { return self.n == other.n }
}
type Id = int64 | str
type Wide = int64 | str | bool
type Any = Color | V | float64 | bytes

mut trace: [str] = []

func id_of(anon s: str) -> Id {
    trace += [f"id {s}"]
    return s
}

test "== and != on unions" {
    let a: Id = 1
    let b: Id = 1
    let c: Id = "1"
    let d: Id = "1"
    assert f"{a == b} {a == c} {c == d} {a != c} {c != d}" == "true false true true false"
    let lit = c == "1"
    let lit_left = "1" == c
    assert f"{a == 1} {1 == a} {a == 2} {lit} {lit_left} {c == 1} {a != 1}" == "true true false true true false false"
    let w: Wide = 1
    let t: Wide = true
    assert f"{a == w} {w == a} {c == w} {t == true} {t != a}" == "true true false true true"
    let x: Any = .Red
    let y: Any = V(n: 4)
    let z: Any = 1.5
    let e: Any = b"hi"
    assert f"{x == .Red} {x == .Blue} {x == Color.Red} {y == V(n: 4)} {y == V(n: 5)} {y == x}" == "true false true true false false"
    let same_bytes = e == b"hi"
    assert f"{z == 1.5} {z != 2.5} {same_bytes}" == "true true true"
    mut hits = 0
    for v in [a, b, c, d] {
        if v == 1 {
            hits += 1
        }
    }
    assert hits == 2
}

test "each side is evaluated once, left to right" {
    let calls = id_of("p") == id_of("p")
    assert trace == ["id p", "id p"]
    assert calls
}
