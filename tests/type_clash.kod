// A type can't take the name of one another module of the program declares.
import "./type_clash_alias_dep"

type Label = struct {
    text: str
    width: int64
}

type Score = enum {
    Low
    High(points: int64)
}

func main() -> int64 {
    print(type_clash_alias_dep.describe("x"))
    return 0
}

// expected errors:
// 4:6: error: type `Label` is also declared in tests/type_clash_alias_dep.kod; the modules of a program share type names for now, so rename one of them
// 9:6: error: type `Score` is also declared in tests/type_clash_alias_dep.kod; the modules of a program share type names for now, so rename one of them
