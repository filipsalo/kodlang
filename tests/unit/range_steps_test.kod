// `a..=b` and `step k` in `for` loops and comprehensions.
import "panics"

func up_to(anon n: int64) -> [int64] {
    return [i for i in 1..=n]
}

test "..= includes the end" {
    assert up_to(3) == [1, 2, 3]
    assert up_to(0) == []
    assert [i for i in 5..=5] == [5]
    mut sum = 0
    for i in 1..=100 {
        sum += i
    }
    assert sum == 5050
}

test "step counts by more than 1" {
    assert [i for i in 0..10 step 4] == [0, 4, 8]
    assert [i for i in 0..=8 step 4] == [0, 4, 8]
    assert [i for i in 0..9 step 3] == [0, 3, 6]
    let xs = [10, 20, 30, 40, 50]
    mut t = 0
    for i in 0..len(xs) step 2 {
        t += xs[i]
    }
    assert t == 90
}

test "a negative step counts down" {
    assert [i for i in 3..=0 step -1] == [3, 2, 1, 0]
    assert [i for i in 3..0 step -1] == [3, 2, 1]
    assert [i for i in 10..0 step -3] == [10, 7, 4, 1]
    assert [i for i in 0..3 step -1] == []
}

test "a step worked out at run time" {
    let k = -2
    assert [i for i in 6..=0 step k] == [6, 4, 2, 0]
    let up = 2
    assert [i for i in 0..5 step up] == [0, 2, 4]
    mut calls = 0
    func two() -> int64 {
        calls += 1
        return 2
    }
    assert [i for i in 0..10 step two()] == [0, 2, 4, 6, 8]
    assert calls == 1
}

test "a step of 0 panics" {
    let zero = 0
    let caught = panics.run(func() -> none {
        for _ in 0..3 step zero {
        }
    })
    assert (caught?.message? or "") == "a range's step is 0"
}
