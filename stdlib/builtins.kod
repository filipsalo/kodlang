// Open-addressing hash map laid out as in CPython's PEP 468 dict
// (3.6+): dense, insertion-ordered `_keys` / `_values` arrays plus a
// sparse `_indices` table mapping hash slots to entry positions.
//
// Lookup hashes the key, probes `_indices` until it finds an empty
// slot (miss) or a slot whose entry's key matches (hit). The probe
// sequence is Python's `(5*i + 1 + perturb)` recurrence so a single
// missing slot doesn't trigger a long linear scan.
//
// `remove` leaves a hole: the entry stays in `_keys` / `_values` marked dead
// in `_live`, and its slot is marked -2, which a probe passes over. Once
// holes are half the entries, `_rebuild` closes them.
//
// Keys are compared with `==` and hashed with `hash`, which agree for every key kind.
type Map[K, V] = struct {
	_keys: [K] = []
	_values: [V] = []
	_live: [bool] = []
	// How many entries are live.
	_count: int64 = 0
	// Sparse open-addressing index table: an entry's position, -1 for an
	// empty slot, -2 for a removed entry's. Always a power of two with
	// entries (holes included) at most ~2/3 of it. Empty until the first
	// insert.
	_indices: [int64] = []

	// A fresh `size`-slot indices table, all empty.
	func _empty_indices(self, anon size: int64) -> [int64] {
		mut arr: [int64] = []
		for _ in 0..size {
			arr += [-1]
		}
		return arr
	}

	// The slot in `_indices` of `key`'s entry; when it has none, where it
	// would go: the first removed entry's slot on the way, or else the empty
	// slot that ends the search. Assumes len(self._indices) > 0.
	func _probe(self, anon key: K) -> int64 {
		let size = len(self._indices)
		let h = hash(key)
		mut perturb = h
		mut slot = ((h % size) + size) % size
		mut free = -1
		for true {
			let entry_idx = self._indices[slot]
			if entry_idx == -1 {
				if free >= 0 {
					return free
				}
				return slot
			}
			if entry_idx == -2 {
				if free < 0 {
					free = slot
				}
			} else if self._keys[entry_idx] == key {
				return slot
			}
			perturb = perturb / 32
			slot = ((5 * slot + 1 + perturb) % size + size) % size
		}
		return -1
	}

	// Close the holes, keeping the order, and lay out a `size`-slot table.
	func _rebuild(self, anon size: int64) -> none {
		if self._count < len(self._keys) {
			mut keys: [K] = []
			mut values: [V] = []
			mut live: [bool] = []
			for i in 0..len(self._keys) {
				if self._live[i] {
					keys += [self._keys[i]]
					values += [self._values[i]]
					live += [true]
				}
			}
			self._keys = keys
			self._values = values
			self._live = live
		}
		self._indices = self._empty_indices(size)
		for i in 0..len(self._keys) {
			let slot = self._probe(self._keys[i])
			self._indices[slot] = i
		}
	}

	func get(self, anon key: K) -> V? {
		if len(self._indices) == 0 {
			return none
		}
		let entry_idx = self._indices[self._probe(key)]
		if entry_idx < 0 {
			return none
		}
		return self._values[entry_idx]
	}

	func set(self, anon key: K, anon value: V) -> none {
		if len(self._indices) == 0 {
			self._indices = self._empty_indices(8)
		}
		let slot = self._probe(key)
		let entry_idx = self._indices[slot]
		if entry_idx >= 0 {
			self._values[entry_idx] = value
			return none
		}
		self._keys += [key]
		self._values += [value]
		self._live += [true]
		self._count += 1
		self._indices[slot] = len(self._keys) - 1
		// Past ~2/3 full, holes included: close the holes, and double the
		// table if the live entries alone are past it.
		let size = len(self._indices)
		if len(self._keys) * 3 > size * 2 {
			if self._count * 3 > size * 2 {
				self._rebuild(size * 2)
			} else {
				self._rebuild(size)
			}
		}
	}

	func contains(self, anon key: K) -> bool {
		if len(self._indices) == 0 {
			return false
		}
		return self._indices[self._probe(key)] >= 0
	}

	// Take `key` out of the map: the value it had, or none.
	func remove(self, anon key: K) -> V? {
		if len(self._indices) == 0 {
			return none
		}
		let slot = self._probe(key)
		let entry_idx = self._indices[slot]
		if entry_idx < 0 {
			return none
		}
		let value = self._values[entry_idx]
		self._indices[slot] = -2
		self._live[entry_idx] = false
		self._count -= 1
		if (len(self._keys) - self._count) * 2 > len(self._keys) and len(self._keys) >= 8 {
			self._rebuild(len(self._indices))
		}
		return value
	}

	// The keys, in the order they were first set, as a new array.
	func keys(self) -> [K] {
		mut out: [K] = []
		for i in 0..len(self._keys) {
			if self._live[i] {
				out += [self._keys[i]]
			}
		}
		return out
	}

	// The values, in their keys' order, as a new array.
	func values(self) -> [V] {
		mut out: [V] = []
		for i in 0..len(self._values) {
			if self._live[i] {
				out += [self._values[i]]
			}
		}
		return out
	}

	func op_index(self, anon key: K) -> V? {
		return self.get(key)
	}

	func op_index_set(self, anon key: K, anon value: V) -> none {
		self.set(key, value)
	}

	// Number of entries. Reachable via the global `len(m)` — the
	// codegen dispatches `len(x)` to a struct's `len` method when the
	// struct defines one.
	func len(self) -> int64 {
		return self._count
	}
}

// A fallible result: either an Ok payload of T, or an Err of E.
// The unified tagged-sum representation of `T or Error` — same
// {discriminant, payload} runtime layout, but spelled as a generic
// enum so it composes with the rest of the enum machinery (pattern
// matching, `is`, methods). The `T or Error` syntax remains as
// sugar for `Result[T, Error]`.
type Result[T, E] = enum {
	Ok(value: T)
	Err(error: E)
}

// Write `s` to stdout followed by a newline. Routed through the
// runtime's `kod_puts` (which uses fwrite + the embedded length)
// instead of libc puts, so embedded NULs print correctly and `s`
// can stay a `{ buf, len }` struct pointer.
extern func kod_puts(anon s: str) -> int64
// putchar takes a byte (no Kod string involved) so it stays bound
// to the libc symbol.
extern func putchar(anon c: int64) -> int64
// Pack a `[int64]` of byte values (low 8 bits of each entry) into a
// fresh `bytes`. The Kod-level operator `+` on bytes does whole-buffer
// copies, so accumulating arbitrary bytes through repeated concat is
// O(n²); collect into an int64 array, then convert in one shot.
extern func kod_bytes_from_array(anon arr: [int64]) -> bytes
// Reinterpret a `str` as `bytes` (and vice versa). Both types share
// the same runtime layout — these are zero-copy identity casts at the
// type-system level. Use at the boundary between text-shaped APIs
// (`str`) and raw-buffer APIs (`bytes`).
extern func kod_str_to_bytes(anon s: str) -> bytes
extern func kod_bytes_to_str(anon b: bytes) -> str
// The 8 bytes from `at` as one int64, the first byte lowest. The compiler
// compiles a call to a bounds check and one load (`emit_bytes_le64`).
extern func kod_bytes_le64(anon b: bytes, anon at: int64) -> int64
// The growable byte buffer behind `StrBuilder` and the str methods that
// build strings (stdlib/runtime.c). A handle is typed `str` to be counted, but isn't one.
extern func kod_sb_new() -> str
extern func kod_sb_append(anon sb: str, anon s: str) -> none
extern func kod_sb_append_byte(anon sb: str, anon b: int64) -> none
extern func kod_sb_len(anon sb: str) -> int64
extern func kod_sb_clear(anon sb: str) -> none
extern func kod_sb_to_str(anon sb: str) -> str
// Print `msg` to stderr (with a `panic: ` prefix) and a backtrace, and exit(1).
// Externs get a leading `_` added at codegen; this one is the C runtime's
// `kod_panic` (stdlib/runtime.c), as `extern_label` says.
extern func panic(anon msg: str) -> none
// Print to stderr without exiting; see stdlib/runtime.c.
extern func kod_eprint(anon msg: str) -> none
// Called by the codegen's array-bounds check when an index is out of
// range. Negative-index normalisation has already run, so any value
// reaching here is genuinely out of bounds.
extern func kod_index_oob(anon idx: int64, anon len: int64) -> none
extern func kod_div_zero() -> none

// Test framework: flip the current test's failure flag and print `msg`
// (indented, to stderr). A test program's `_main` defines this to call the
// runner in stdlib/testing.kod; anywhere else the runtime's panics.
extern func kod_test_fail(anon msg: str) -> none

func fail(anon msg: str) -> none {
	kod_test_fail(msg)
}

// A call is a header load; this body runs only through a function value.
func len(anon s: str) -> int64 {
	return len(s)
}

// Any type whose values can be rendered as a string. F-string
// interpolations of types other than `str` are lowered to to_str() calls.
// Primitives (int64, bool, str) participate implicitly via builtin
// conversions; user structs participate by declaring `func to_str(self) -> str`.
interface Stringable {
	func to_str(self) -> str
}

// Any value that can be `throw`n from a function declared `T or Error`.
// Errors must be displayable; users define their own error enums and
// implement to_str on each.
interface Error {
	func to_str(self) -> str
}

// Not consulted yet: an `Err` that `main` returns exits with status 1.
interface ExitCode {
	func exit_code(self) -> int64
}

func print(anon string: str) -> none {
	kod_puts(string)
}

func print_int(anon arg: int64) -> none {
	print(arg.to_str())
}
