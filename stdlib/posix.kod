// File descriptors as streams, with the POSIX calls behind them. See docs/io.md.
import "stream" { IoError, os_error }

extern func kod_io_errno() -> int64
extern func kod_fd_open(anon path: str, anon mode: int64) -> int64
extern func kod_fd_read(anon fd: int64, anon max: int64) -> bytes
extern func kod_fd_write(anon fd: int64, anon data: bytes) -> int64
extern func kod_fd_close(anon fd: int64) -> int64

type Fd = struct {
    fd: int64

    func read(self, anon max: int64) -> bytes or Error {
        let data = kod_fd_read(self.fd, max)
        let err = kod_io_errno()
        if err != 0 {
            throw os_error("read", errno: err)
        }
        return data
    }

    func write(self, anon data: bytes) -> int64 or Error {
        let n = kod_fd_write(self.fd, data)
        if n < 0 {
            throw os_error("write", errno: kod_io_errno())
        }
        return n
    }

    func close(self) -> none or Error {
        if kod_fd_close(self.fd) < 0 {
            throw os_error("close", errno: kod_io_errno())
        }
    }
}

func open_with(anon path: str, anon mode: int64) -> Fd or Error {
    let fd = kod_fd_open(path, mode)
    if fd < 0 {
        throw os_error(f"open {path}", errno: kod_io_errno())
    }
    return Fd(fd: fd)
}

func open_read(anon path: str) -> Fd or Error {
    return try open_with(path, 0)
}

func create(anon path: str) -> Fd or Error {
    return try open_with(path, 1)
}

func append(anon path: str) -> Fd or Error {
    return try open_with(path, 2)
}

func stdin() -> Fd {
    return Fd(fd: 0)
}

func stdout() -> Fd {
    return Fd(fd: 1)
}

func stderr() -> Fd {
    return Fd(fd: 2)
}
