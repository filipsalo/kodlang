// A Map shows as `{key: value, ...}` and a Set as `{a, b}`, in order.
import "sets" { Set }

type Bare = shared struct {
    n: int64
}

test "a map's text" {
    mut m = Map[str, int64]()
    m.set("a", 1)
    m.set("b", 2)
    m.set("c", 3)
    m.remove("b")
    assert str(m) == "{a: 1, c: 3}"
    assert f"map {m}" == "map {a: 1, c: 3}"
    assert str(Map[int64, str]()) == "{}"
    mut nested = Map[str, [int64]]()
    nested.set("xs", [1, 2])
    assert str(nested) == "{xs: [1, 2]}"
}

test "a set's text" {
    mut s = Set[str]()
    s.add("x")
    s.add("y")
    s.add("x")
    assert str(s) == "{x, y}"
    assert str([s]) == "[{x, y}]"
    assert str(Set[int64]()) == "{}"
}
