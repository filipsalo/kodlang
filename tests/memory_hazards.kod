// Values a call could free from under its caller, and shapes that are easy to get wrong.
type Holder = struct {
    s: str
    h: Holder?
    xs: [str] = []
}

func clobber(anon h: Holder) -> str {
    h.s = "other" + "!"
    h.xs = []
    return "x" + "y"
}

func two(anon a: str, anon b: str) -> str {
    return a + b
}

func callee_clobbers(anon a: str, h: Holder) -> str {
    h.s = "gone" + "!"
    return a
}

func rebinds(anon a: str) -> str {
    let a = a + "1"
    return a
}

func mut_param(mut a: str) -> str {
    a = a + "2"
    a = a + "3"
    return a
}

type Shape = enum {
    Circle(name: str)
    Square(name: str, side: int64)
}

func name_of(anon s: Shape) -> str {
    return match s {
        .Circle(name) -> name
        .Square(name, _s) -> name
    }
}

interface Named {
    func name(self) -> str
}

type N = struct {
    n: str

    func name(self) -> str {
        return self.n
    }

    func me(self) -> N {
        return self
    }
}

func opt(anon on: bool) -> str? {
    if on {
        return "yes" + "!"
    }
    return none
}

func fallible(anon on: bool) -> str or Error {
    if on {
        return "ok" + "!"
    }
    throw E(m: "bad" + "!")
}

type E = struct {
    m: str

    func to_str(self) -> str {
        return self.m
    }
}

func chain() -> str or Error {
    let a = try fallible(true)
    let b = try fallible(false)
    return a + b
}

// An int64 in the middle of the address range the heap uses, in a name that held a reference.
func retyped() -> int64 {
    let x = "a" + "b"
    if len(x) > 0 {
        let x = 52776558133264
        print(x)
    }
    print(x)
    let x = 52776558133264
    return x
}

// A value in a slot past what a header's mask covers outlives the frame that made it.
type Far = struct {
    f0: int64 = 0
    f1: int64 = 0
    f2: int64 = 0
    f3: int64 = 0
    f4: int64 = 0
    f5: int64 = 0
    f6: int64 = 0
    f7: int64 = 0
    f8: int64 = 0
    f9: int64 = 0
    f10: int64 = 0
    f11: int64 = 0
    f12: int64 = 0
    f13: int64 = 0
    f14: int64 = 0
    f15: int64 = 0
    f16: int64 = 0
    f17: int64 = 0
    f18: int64 = 0
    f19: int64 = 0
    f20: int64 = 0
    f21: int64 = 0
    f22: int64 = 0
    f23: int64 = 0
    f24: int64 = 0
    f25: int64 = 0
    f26: int64 = 0
    f27: int64 = 0
    f28: int64 = 0
    f29: int64 = 0
    s: str = ""
    next: Far? = none
}

func far() -> Far {
    return Far(s: "far" + "!", next: Far(s: "next" + "!"))
}

func main() -> int64 {
    let h = Holder(s: "first" + "!", h: none)
    print(two(h.s, clobber(h)))
    h.s = "second" + "!"
    print(callee_clobbers(h.s, :h))
    print(rebinds("a" + "b"))
    print(mut_param(a: "c" + "d"))

    h.xs = ["p" + "q", "r" + "s"]
    for x in h.xs {
        h.xs = []
        print(x)
    }

    print(name_of(.Circle(name: "circle" + "!")))
    print(name_of(.Square(name: "square" + "!", side: 2)))

    let n: Named = N(n: "named" + "!")
    print(n.name())
    print(N(n: "chain" + "!").me().me().name())

    if opt(true) is Some(v) {
        print(v)
    }
    print(opt(false)? or "default" + "!")

    let r = chain()
    if r is Err(e) {
        print(e.to_str())
    }

    // Shared by two holders, then dropped by one.
    let shared = "shared" + "!"
    let a = Holder(s: shared, h: none)
    let b = Holder(s: shared, h: a)
    a.s = "changed" + "!"
    print(b.s)
    print((b.h? or a).s)

    // A long list goes without taking the stack with it.
    mut head = Holder(s: "0", h: none)
    for i in 1..200000 {
        head = Holder(s: "n", h: head)
    }
    head = Holder(s: "end", h: none)
    print(head.s)

    // Arrays: aliases, slices, growth, overwriting.
    mut xs: [str] = []
    for i in 0..100 {
        xs += [i.to_str()]
    }
    let alias = xs
    let tail = xs[90..]
    xs[95] = "changed" + "!"
    xs = []
    print(alias[95])
    print(tail[5])
    print(len(alias))

    let m = Map[str, str]()
    for i in 0..100 {
        m.set(i.to_str(), f"v{i}")
    }
    m.set("7", "seven" + "!")
    print(m.get("7")? or "none")
    print(m.get("99")? or "none")
    print(retyped())
    let fr = far()
    print(fr.s)
    print(fr.next?.s? or "")
    return 0
}

// expected output:
// first!xy
// second!
// ab1
// cd23
// pq
// rs
// circle!
// square!
// named!
// chain!
// yes!
// default!
// bad!
// shared!
// changed!
// end
// changed!
// 95
// 100
// seven!
// v99
// 52776558133264
// ab
// 52776558133264
// far!
// next!
