import "tasks"
import "testing"

mut trace: [str] = []

func note(anon what: str) -> none {
    trace += [what]
}

test "a task's result comes back through wait" {
    let a = tasks.start(func() -> int64 { return 6 * 7 })
    let b = tasks.start(func() -> str { return "hi" })
    assert a.wait() == 42
    assert b.wait() == "hi"
    // A result can be waited for again.
    assert a.wait() == 42
}

test "tasks run when the starting one waits or gives way, in the order they became ready" {
    trace = []
    let a = tasks.start_none(func() -> none {
        note("a1")
        tasks.give_way()
        note("a2")
    })
    let b = tasks.start_none(func() -> none {
        note("b1")
        tasks.give_way()
        note("b2")
    })
    note("main")
    tasks.give_way()
    note("main again")
    a.wait()
    b.wait()
    assert trace == ["main", "a1", "b1", "main again", "a2", "b2"]
}

test "give_way with nothing else ready goes straight on" {
    tasks.give_way()
    tasks.give_way()
}

test "a task can start tasks and wait for them" {
    let outer = tasks.start(func() -> int64 {
        let inner = tasks.start(func() -> int64 { return 20 })
        let other = tasks.start(func() -> int64 { return 22 })
        return inner.wait() + other.wait()
    })
    assert outer.wait() == 42
}

test "several tasks can wait for one" {
    let slow = tasks.start(func() -> int64 {
        tasks.give_way()
        tasks.give_way()
        return 7
    })
    let x = tasks.start(func() -> int64 { return slow.wait() * 2 })
    let y = tasks.start(func() -> int64 { return slow.wait() * 3 })
    assert x.wait() + y.wait() == 35
}

test "thousands of tasks" {
    mut all: [tasks.Task[int64]] = []
    for i in 0..5000 {
        all += [tasks.start(func() -> int64 {
            tasks.give_way()
            return i
        })]
    }
    mut sum: int64 = 0
    for t in all {
        sum += t.wait()
    }
    assert sum == 5000 * 4999 / 2
}

func depth(anon n: int64) -> int64 {
    if n == 0 {
        return 0
    }
    return 1 + depth(n - 1)
}

test "a task's stack takes deep recursion" {
    let t = tasks.start(func() -> int64 { return depth(100000) })
    assert t.wait() == 100000
}

test "values the task captured and gave back outlive it" {
    let names = ["a", "b", "c"]
    let t = tasks.start(func() -> [str] { return names + ["d"] })
    let got = t.wait()
    assert got == ["a", "b", "c", "d"]
    assert names == ["a", "b", "c"]
}

test "waiting on a task that can't end is a deadlock" {
    let r = testing.run(func() {
        mut me: tasks.Task[int64]? = none
        let stuck = tasks.start(func() -> int64 { return (must me).wait() })
        me = stuck
        print(stuck.wait())
    })
    assert r.status == 1
    assert r.stderr.contains("panic: all tasks are asleep: deadlock")
}

test "a panic in a task stops the program" {
    let r = testing.run(func() {
        let t = tasks.start(func() -> int64 {
            panic("in the task")
            return 0
        })
        print(t.wait())
    })
    assert r.status == 1
    assert r.stderr.contains("panic: in the task")
}
