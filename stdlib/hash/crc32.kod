// CRC-32 (IEEE 802.3 / gzip polynomial) implementation.
//
// Buffers go through the runtime (stdlib/runtime.c), which uses the CPU's
// CRC instructions, eight bytes at a time. Single bytes use a 256-entry
// table for the reflected polynomial 0xEDB88320, built on the first
// `update`.
//
// Streaming use:
//   mut c: Crc32 = make_crc32()
//   c.update_bytes(b"hello")
//   c.update_bytes(b", world")
//   let crc: int64 = c.final()
//
// One-shot helper:
//   let crc: int64 = crc32.compute(b"hello, world")

// The CRC state after `data[start..end]`, continuing from `crc`.
extern func kod_crc32_bytes(anon crc: int64, anon data: bytes, anon start: int64, anon end: int64) -> int64

// Build the standard CRC-32 lookup table. 256 entries, each the CRC
// of a single byte under the polynomial 0xEDB88320 (reflected form of
// the IEEE 0x04C11DB7).
func make_table() -> [int64] {
    mut table: [int64] = []
    let poly: int64 = 0xEDB88320
    mut i: int64 = 0
    for i < 256 {
        mut c: int64 = i
        mut k: int64 = 0
        for k < 8 {
            if (c & 1) != 0 {
                c = (c >> 1) ^ poly
            } else {
                c = c >> 1
            }
            k = k + 1
        }
        table += [c]
        i = i + 1
    }
    return table
}

type Crc32 = struct {
    state: int64
    table: [int64] = []

    // Mix one byte into the running CRC. Standard reflected-CRC step:
    // shift the low byte out, xor in the table entry for the byte
    // that was XOR'd against the freshly-shifted-out low byte.
    func update(self, anon byte: int64) -> none {
        if len(self.table) == 0 {
            self.table = make_table()
        }
        self.state = (self.state >> 8) ^ self.table[(self.state ^ byte) & 0xff]
    }

    func update_bytes(self, anon data: bytes) -> none {
        self.state = kod_crc32_bytes(self.state, data, 0, len(data))
    }

    // Final XOR with 0xFFFFFFFF gives the conventional CRC-32 value.
    // Doesn't reset `state`, so calling final() twice (or interleaving
    // with more updates) is safe — useful for incremental verifiers.
    func final(self) -> int64 {
        return self.state ^ 0xFFFFFFFF
    }
}

// Construct a fresh CRC-32 streamer: state initialised to all-ones.
func make_crc32() -> Crc32 {
    return Crc32(state: 0xFFFFFFFF)
}

// One-shot CRC-32 over a byte buffer.
func compute(anon data: bytes) -> int64 {
    mut c: Crc32 = make_crc32()
    c.update_bytes(data)
    return c.final()
}
