// A type pattern with labels matches a struct field by field.

type Rect = struct {
    w: int64
    h: int64
}

type Circle = struct {
    radius: int64
}

type Shape = Rect | Circle

type Node = struct {
    name: str
    kind: Kind = .Leaf
    parent: Node? = none
    weak up: Node?
}

type Kind = enum {
    Leaf
    Branch(size: int64)
}

func describe(anon s: Shape) -> str {
    match s {
        Rect(w: 0) -> return "flat"
        Rect(:w, h: 1) -> return f"strip {w}"
        Rect(:w, :h) -> return f"rect {w * h}"
        Circle(radius: r) if r > 10 -> return "big circle"
        Circle(c) -> return f"circle {c.radius}"
    }
}

func where(anon n: Node) -> str {
    match n {
        Node(parent: none, :name) -> return f"{name} is a root"
        Node(parent: Node(name: "root")) -> return "under the root"
        Node(kind: .Branch(0)) -> return "an empty branch"
        Node(name: _, kind: .Branch(size)) -> return f"a branch of {size}"
        Node(up: Node(name: up_name), :name) -> return f"{name} looks up to {up_name}"
        else -> return "somewhere"
    }
}

func main() -> int64 {
    print(describe(Rect(w: 0, h: 9)))
    print(describe(Rect(w: 3, h: 1)))
    print(describe(Rect(w: 3, h: 4)))
    print(describe(Circle(radius: 20)))
    print(describe(Circle(radius: 2)))

    let root = Node(name: "root")
    print(where(root))
    print(where(Node(name: "kid", parent: root)))
    let mid = Node(name: "mid", parent: Node(name: "other"))
    print(where(Node(name: "b", kind: .Branch(size: 0), parent: mid)))
    print(where(Node(name: "b", kind: .Branch(size: 5), parent: mid)))
    print(where(Node(name: "leaf", parent: mid, up: root)))
    print(where(Node(name: "leaf", parent: mid)))

    if root is Node(name: "root", parent: none) {
        print("found the root")
    }
    let Rect(:h) = Rect(w: 1, h: 7) else {
        return 1
    }
    print(h)
    return 0
}

// expected output:
// flat
// strip 3
// rect 12
// big circle
// circle 2
// root is a root
// under the root
// an empty branch
// a branch of 5
// leaf looks up to root
// somewhere
// found the root
// 7
// expected status:
// 0
