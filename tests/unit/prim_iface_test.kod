// Primitives implementing interfaces: pass int64/str/bool where
// the parameter is `Stringable`, dispatch through the vtable.

interface Showable {
    func to_str(self) -> str
}

func show(anon thing: Showable) -> str {
    return thing.to_str()
}

test "primitives passed as an interface" {
    let n: int64 = 42
    let s: str = "hello"
    let b: bool = true
    assert show(n) == "42"
    assert show(s) == "hello"
    assert show(b) == "true"
}
