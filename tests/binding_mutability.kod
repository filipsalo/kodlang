// Only a `let`, and a parameter without `mut`, can't be reassigned: a `for`
// variable and the names a pattern or let-else binds can, whatever `let` of
// that name ran or was compiled before them.
func pick(anon n: int64) -> int64? {
    if n > 0 {
        return n
    }
    return none
}

func loop_after(anon flag: bool) -> int64 {
    if flag {
        let a = 7
        print_int(a)
    }
    mut total = 0
    for a in [1, 2] {
        a = a * 10
        total += a
    }
    return total
}

func loop_before() -> int64 {
    mut total = 0
    for i in [1, 2] {
        for a in [i] {
            a = a + 100
            total += a
        }
        if i > 0 {
            let a = 5
            total += a
        }
    }
    return total
}

func loop_rebound() -> int64 {
    mut total = 0
    for x in [1, 2, 3] {
        x = x * 2
        total += x
        let x = 1
        total += x
    }
    return total
}

func arm_after(anon flag: bool) -> int64 {
    if flag {
        let v = 1
        print_int(v)
    }
    match pick(3) {
        Some(v) -> {
            v = v * 2
            return v
        }
        none -> return 0
    }
}

func if_is_after() -> int64 {
    if true {
        let u = 1
        print_int(u)
    }
    if pick(4) is Some(u) {
        u += 1
        return u
    }
    return 0
}

func let_else_after(anon flag: bool) -> int64 {
    if flag {
        let w = 2
        print_int(w)
    }
    let .Some(w) = pick(5) else {
        return 0
    }
    w = w + 1
    return w
}

func let_else_param(anon w: int64?) -> int64 {
    let .Some(w) = w else {
        return 0
    }
    w += 10
    return w
}

func main() -> int64 {
    print_int(loop_after(true))
    print_int(loop_after(false))
    print_int(loop_before())
    print_int(loop_rebound())
    print_int(arm_after(true))
    print_int(if_is_after())
    print_int(let_else_after(false))
    print_int(let_else_param(6))
    return 0
}

// expected output:
// 7
// 30
// 30
// 213
// 15
// 1
// 6
// 1
// 5
// 6
// 16
