// `is` binds tighter than and/or, and a bare `is` tests enum variants.
type Color = enum {
    Red
    Green
}
type Shape = enum {
    Circle(radius: int64)
    Rect(w: int64, h: int64)
}
func main() -> int64 {
    let f = true
    let o: int64? = none
    if f and o is none {
        print("f and none")
    }
    let p: int64? = 3
    if o is not none or p is not none {
        print("one is set")
    }
    let both = o is none and p is not none
    print(f"{both}")
    let c: Color = .Green
    if c is .Green and f {
        print("green")
    }
    let s: Shape = .Rect(w: 2, h: 3)
    print(f"{s is .Circle(_)} {s is Shape.Rect(_, _)} {c is Color.Red} {c is not .Red}")
    let maybe_c: Color? = .Red
    print(f"{maybe_c is .Some} {maybe_c is .None}")
    if p is Some(v) {
        print_int(v)
    }
    if o is none == true {
        print("none == true")
    }
    return 0
}

// expected output:
// f and none
// one is set
// true
// green
// false true false true
// true false
// 3
// none == true
