// A pattern borrows what it binds from an enum's payload when its subject is a
// variable the function never assigns to (docs/memory-layout.md). Each case
// below is a way a borrowed binding could outlive its value; the gates run this
// with a poisoned runtime too, so one that did would print garbage or crash.

type Op = enum {
    Mov(dst: str, src: str)
    Lit(text: str)
    Nop
}

type Holder = struct {
    op: Op
    kept: [str] = []
}

func fresh(anon s: str) -> str {
    return s + "!"
}

// The binding escapes: returned, so the return must count it.
func first(anon op: Op) -> str {
    match op {
        .Mov(dst, _src) -> return dst
        .Lit(text) -> return text
        .Nop -> return ""
    }
}

// The binding is stored, then the only other owner goes away.
func keep_all(anon ops: [Op]) -> [str] {
    mut kept: [str] = []
    for op in ops {
        match op {
            .Mov(dst, src) -> {
                kept += [dst]
                kept += [src]
            }
            .Lit(text) -> kept += [text]
            .Nop -> kept += ["nop"]
        }
    }
    return kept
}

// The subject is assigned in the arm: its old payload is freed while the
// binding is still read, so the binding must own its value.
func reassigned_subject() -> str {
    mut op: Op = .Lit(text: fresh("old"))
    match op {
        .Lit(text) -> {
            op = .Lit(text: fresh("new"))
            return text + " " + first(op)
        }
        else return ""
    }
}

// The binding is assigned in the arm, so it owns what it holds.
func reassigned_binding(anon op: Op) -> str {
    match op {
        .Lit(text) -> {
            let before = text
            text = fresh(text)
            return before + " " + text
        }
        else return ""
    }
}

// The same name bound by a payload in one arm and as a `let` in another
// shares one slot, which the `let` makes owned.
func shared_slot(anon ops: [Op]) -> str {
    mut out = ""
    for op in ops {
        match op {
            .Lit(text) -> out += text
            .Mov(dst, _src) -> {
                let text = fresh(dst)
                out += text
            }
            .Nop -> out += "."
        }
    }
    return out
}

// A field the arm replaces is no variable, so its payload's bindings own their values.
func field_subject(anon h: Holder) -> str {
    match h.op {
        .Lit(text) -> {
            h.op = .Nop
            return text
        }
        else return ""
    }
}

// Nested: the inner subject is a borrowed binding of the outer one.
type Wrap = enum {
    One(op: Op)
    Empty
}

func nested(anon w: Wrap) -> str {
    match w {
        .One(op) -> {
            match op {
                .Mov(dst, src) -> return dst + src
                .Lit(text) -> return text
                .Nop -> return "nop"
            }
        }
        .Empty -> return ""
    }
}

// A let-else: the binding lives on after it.
func narrowed(anon op: Op) -> str {
    let .Lit(text) = op else {
        return "-"
    }
    let h = Holder(op: .Nop)
    h.kept += [text]
    return h.kept[0]
}

func main() -> none {
    let ops: [Op] = [.Mov(dst: fresh("x0"), src: fresh("x1")), .Lit(text: fresh("t")), .Nop]
    print(first(ops[0]))
    let kept = keep_all(ops)
    print(kept)
    print(keep_all([.Lit(text: fresh("gone"))]))
    print(reassigned_subject())
    print(reassigned_binding(.Lit(text: fresh("a"))))
    print(shared_slot(ops))
    print(field_subject(Holder(op: .Lit(text: fresh("field")))))
    print(nested(.One(op: .Mov(dst: fresh("d"), src: fresh("s")))))
    print(narrowed(.Lit(text: fresh("n"))))
    print(narrowed(.Nop))
}

// expected output:
// x0!
// [x0!, x1!, t!, nop]
// [gone!]
// old! new!
// a! a!!
// x0!!t!.
// field!
// d!s!
// n!
// -
