// Build-and-run tests — each one builds a tiny source snippet via
// `test_support.build_and_run`, runs it, and asserts on the output.
// Covers behaviour that's only observable end-to-end:
//   - panics (runtime aborts with status != 0 and a `panic: …` line)
//   - user-declared externs binding to C runtime symbols

import "kod/test_support"
import "process"

test "assert false panics with the source text" {
    let r: process.ProcessResult = test_support.build_and_run("""
        func main() -> int64 {
            let n: int64 = 7
            assert n == 4
            return 0
        }
    """)
    assert r.status != 0
    assert r.stderr.contains("panic")
    assert r.stderr.contains("assertion failed")
    assert r.stderr.contains("n == 4")
}

test "out-of-bounds array read panics with the index and length" {
    let r: process.ProcessResult = test_support.build_and_run("""
        func main() -> int64 {
            let xs: [int64] = [10, 20, 30]
            return xs[5]
        }
    """)
    assert r.status != 0
    assert r.stderr.contains("panic")
    assert r.stderr.contains("index 5 out of bounds for array of length 3")
}

test "out-of-bounds array write panics with the index and length" {
    let r: process.ProcessResult = test_support.build_and_run("""
        func main() -> int64 {
            mut xs: [int64] = [10, 20, 30]
            xs[5] = 99
            return 0
        }
    """)
    assert r.status != 0
    assert r.stderr.contains("panic")
    assert r.stderr.contains("index 5 out of bounds for array of length 3")
}

test "unhandled error from `must` panics with the error's to_str" {
    let r: process.ProcessResult = test_support.build_and_run("""
        type IoError = struct {
            message: str
            func to_str(self) -> str {
                return self.message
            }
        }
        func read_size(anon path: str) -> int64 or Error {
            throw IoError(message: f"file not found: {path}")
        }
        func main() -> int64 {
            let n: int64 = must read_size("missing.txt")
            return n
        }
    """)
    assert r.status != 0
    assert r.stderr.contains("panic")
    assert r.stderr.contains("file not found: missing.txt")
}

test "user-declared extern binds to the C runtime symbol" {
    // `kod_puts` is defined in stdlib/runtime.c; declaring it as an
    // `extern` and calling it should reach the same symbol the
    // builtin `print` ultimately calls.
    let r: process.ProcessResult = test_support.build_and_run("""
        extern func kod_puts(anon s: str) -> int64
        func main() -> int64 {
            kod_puts("hello from extern")
            return 0
        }
    """)
    assert r.status == 0
    assert r.stdout == "hello from extern\n"
}

// A `for i in 0..len(xs)` loop indexes `xs[i]` without a bounds check; these
// are the ways out of that, which must still panic.
test "a range loop's index is still checked where it may be out of range" {
    let shadowed_index = test_support.build_and_run("""
        func main() -> int64 {
            let xs = [1, 2, 3]
            for i in 0..len(xs) {
                let i = 100
                print(xs[i])
            }
            return 0
        }
    """)
    assert shadowed_index.stderr.contains("index 100 out of bounds for array of length 3")
    let shadowed_array = test_support.build_and_run("""
        func main() -> int64 {
            let xs = [1, 2, 3]
            for i in 0..len(xs) {
                let xs = [7]
                print(xs[i])
            }
            return 0
        }
    """)
    assert shadowed_array.stderr.contains("index 1 out of bounds for array of length 1")
    let reassigned = test_support.build_and_run("""
        func main() -> int64 {
            mut xs = [1, 2, 3]
            for i in 0..len(xs) {
                xs = [9]
                print(xs[i])
            }
            return 0
        }
    """)
    assert reassigned.stderr.contains("index 1 out of bounds for array of length 1")
    let in_literal = test_support.build_and_run("""
        func main() -> int64 {
            let xs = [1, 2, 3]
            for i in 0..len(xs) {
                let f = func(i: int64) -> int64 { return xs[i] }
                print(f(10))
            }
            return 0
        }
    """)
    assert in_literal.stderr.contains("index 10 out of bounds for array of length 3")
    let negative_start = test_support.build_and_run("""
        func main() -> int64 {
            let xs = [1, 2, 3]
            let from = -5
            for i in from..len(xs) {
                print(xs[i])
            }
            return 0
        }
    """)
    assert negative_start.stderr.contains("index -2 out of bounds for array of length 3")
}

test "an inlined function's own index is checked inside a range loop" {
    let r = test_support.build_and_run("""
        func at(anon xs: [int64], anon i: int64) -> int64 {
            return xs[i]
        }

        func main() -> int64 {
            let xs = [1, 2, 3]
            for i in 0..len(xs) {
                print(at(xs, i + 10))
            }
            return 0
        }
    """)
    assert r.stderr.contains("index 10 out of bounds for array of length 3")
}
