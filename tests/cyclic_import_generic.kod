// An instance of a generic type from either module of a cycle, holding a
// struct from this one, is the same type on both sides.
import "./cyclic_import_generic_dep"

type Pt = struct {
    x: int64
    y: int64
}

type Box[T] = struct {
    v: T
}

func main() -> int64 {
    let b: Box[Pt] = cyclic_import_generic_dep.boxed(Pt(x: 2, y: 3))
    print_int(b.v.x + b.v.y)
    let back: Pt = cyclic_import_generic_dep.unbox(Box[Pt](v: Pt(x: 9, y: 9)))
    print_int(back.x)
    let held = cyclic_import_generic_dep.hold([Pt(x: 1, y: 0), Pt(x: 4, y: 0)])
    print_int(len(held))
    print_int(cyclic_import_generic_dep.first(held).x)
    return 0
}

// expected output:
// 5
// 9
// 2
// 1
