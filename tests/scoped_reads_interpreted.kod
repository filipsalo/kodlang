// The interpreter rejects a read of a local after its block before
// running anything, as the compiler does.
func pick(anon n: int64) -> int64 {
    if n > 0 {
        let r = n * 2
        print_int(r)
    }
    return r
}

func main() -> int64 {
    print("start")
    print_int(pick(1))
    return 0
}

// expected mode:
// interpret
// expected output:
// expected stderr:
// 8:12: error: `r` is declared in a block that has ended; declare it outside the block to use it here
// expected status:
// 1
