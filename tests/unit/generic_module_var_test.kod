// A generic function compiled into this module assigns the variables of the
// module that declares it, directly and through a function inlined into it,
// and an element store copies their array on write there.
import "./../generic_module_var_dep"

test "a generic function assigns its own module's variables" {
    assert generic_module_var_dep.note(1) == 1
    assert generic_module_var_dep.note("two") == 2
    assert generic_module_var_dep.seen() == [2, 1, -1, 2, -1]
}
