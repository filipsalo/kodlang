// Plain structs compare, hash and print by their fields
// (docs/structs.md#structs-are-values).
import "arrays"
import "sets" { Set }
import "./../struct_fields_dep" { Token, make_token, token_key }

type Place = struct {
    x: int64
    y: int64
    name: str? = none
}

type Node = struct {
    v: int64
    kids: [Node] = []
    next: Node? = none
}

type Pair[A, B] = struct {
    a: A
    b: B
}

type Empty = struct {
}

type Color = enum {
    Red
    Blue
}

type Money = struct {
    cents: int64
    currency: str

    func op_eq(self, other: Money) -> bool {
        return self.cents == other.cents
    }

    func hash(self) -> int64 {
        return self.cents
    }

    func to_str(self) -> str {
        return f"${self.cents}"
    }
}

type Mixed = struct {
    money: Money
    share: float64
    color: Color
    on: bool
    raw: bytes
    either: int64 | str
}

// Shared, with methods that say how it compares and hashes.
type Id = shared struct {
    n: int64

    func op_eq(self, other: Id) -> bool {
        return self.n == other.n
    }

    func hash(self) -> int64 {
        return self.n
    }
}

func mixed(anon cents: int64) -> Mixed {
    return Mixed(money: Money(:cents, currency: "SEK"), share: 0.5, color: .Red, on: true, raw: b"ab", either: "x")
}

test "`==` compares the fields" {
    let a = Place(x: 1, y: 2)
    assert a == Place(x: 1, y: 2) and not (a != Place(x: 1, y: 2))
    assert a != Place(x: 2, y: 1) and a != Place(x: 1, y: 3)
    let named = Place(x: 1, y: 2, name: "home")
    assert a != named and named != a and named == Place(x: 1, y: 2, name: "ho" + "me")
    assert named != Place(x: 1, y: 2, name: "away")
    assert Empty() == Empty()
    assert mixed(3) == mixed(3) and mixed(3) != mixed(4)
    mut m = mixed(3)
    m.either = 4
    assert m != mixed(3)
    m.either = "x"
    m.money = Money(cents: 3, currency: "EUR")
    assert m == mixed(3)
    let nan = 0.0 / 0.0
    assert Pair[float64, bool](a: nan, b: true) != Pair[float64, bool](a: nan, b: true)
    assert 1 == 1 and (a == named) == false
}

test "structs inside themselves, in arrays and in optionals" {
    let n = Node(v: 1, kids: [Node(v: 2), Node(v: 3)], next: Node(v: 4, next: Node(v: 5)))
    let m = Node(v: 1, kids: [Node(v: 2), Node(v: 3)], next: Node(v: 4, next: Node(v: 5)))
    assert n == m and hash(n) == hash(m) and f"{n}" == f"{m}"
    assert n != Node(v: 1, kids: [Node(v: 2), Node(v: 3)], next: Node(v: 4))
    assert n != Node(v: 1, kids: [Node(v: 3), Node(v: 2)], next: n.next)
    assert [n] == [m] and arrays.contains([n], m) and not arrays.contains([n], Node(v: 1))
    assert f"{Node(v: 1, kids: [Node(v: 2)], next: Node(v: 3))}" == "Node(v: 1, kids: [Node(v: 2, kids: [], next: none)], next: Node(v: 3, kids: [], next: none))"
}

test "generic structs" {
    let p = Pair[str, int64](a: "q", b: 1)
    assert p == Pair[str, int64](a: "q", b: 1) and p != Pair[str, int64](a: "q", b: 2)
    assert f"{p}" == "Pair(a: q, b: 1)"
    let nested = Pair[Pair[str, int64], [Place]](a: p, b: [Place(x: 1, y: 2)])
    assert nested == Pair[Pair[str, int64], [Place]](a: p, b: [Place(x: 1, y: 2)])
    assert f"{nested}" == "Pair(a: Pair(a: q, b: 1), b: [Place(x: 1, y: 2, name: none)])"
}

test "as text" {
    assert f"{Place(x: 1, y: 2)}" == "Place(x: 1, y: 2, name: none)"
    assert str(Place(x: 1, y: 2, name: "a b")) == "Place(x: 1, y: 2, name: a b)"
    assert f"{Empty()}" == "Empty()"
    assert f"{mixed(3)}" == "Mixed(money: $3, share: 0.5, color: Red, on: true, raw: ab, either: x)"
    assert f"{Empty():>10}|{[Empty()]}" == "   Empty()|[Empty()]"
    let u: Place | int64 = Place(x: 1, y: 2)
    assert f"{u}" == "Place(x: 1, y: 2, name: none)"
    let other: Place | int64 = Place(x: 1, y: 2)
    assert u == other and u != 3
}

test "keys of maps and elements of sets" {
    mut steps = Map[Place, int64]()
    for x in 0..30 {
        for y in 0..30 {
            steps[Place(:x, :y), default: 0] += x * 100 + y
            steps[Place(:x, :y), default: 0] += 1
        }
    }
    assert len(steps) == 900
    for x in 0..30 {
        for y in 0..30 {
            assert (steps[Place(:x, :y)]? or -1) == x * 100 + y + 1
        }
    }
    assert steps[Place(x: 1, y: 1, name: "a")] is none and steps[Place(x: -1, y: 1)] is none
    assert (steps.remove(Place(x: 3, y: 4))? or 0) == 305 and not steps.contains(Place(x: 3, y: 4))
    mut seen = Set[[int64]]()
    seen.add([1, 2])
    seen.add([1] + [2])
    seen.add([2, 1])
    seen.add([])
    assert len(seen) == 3 and seen.contains([2, 1]) and not seen.contains([1])
    mut nested = Map[[[str]], str]()
    nested[[["a"], ["b"]]] = "x"
    assert (nested[[["a"], ["b"]]]? or "") == "x" and nested[[["a", "b"]]] is none
    mut money = Map[Money, str]()
    money[Money(cents: 3, currency: "SEK")] = "three"
    assert (money[Money(cents: 3, currency: "EUR")]? or "") == "three"
    mut ids = Map[Id, int64]()
    ids[Id(n: 4)] = 1
    ids[Id(n: 4)] = 2
    assert len(ids) == 1
    mut either = Map[Place | [int64], int64]()
    either[Place(x: 1, y: 2)] = 1
    either[[1, 2]] = 2
    assert len(either) == 2 and (either[[1, 2]]? or 0) == 2
}

test "hashes: equal for what is equal, and spread for what is near" {
    assert hash(Place(x: 1, y: 2)) == hash(Place(x: 1, y: 2))
    assert hash([1, 2]) == hash([1, 2]) and hash([1, 2]) != hash([2, 1])
    assert hash(Place(x: 1, y: 2)) != hash(Place(x: 2, y: 1))
    assert hash(Place(x: 1, y: 2, name: "a")) != hash(Place(x: 1, y: 2))
    mut hashes = Set[int64]()
    mut low = Set[int64]()
    for x in -100..100 {
        for y in -100..100 {
            hashes.add(hash(Place(:x, :y)))
            low.add(hash(Place(:x, :y)) & 65535)
        }
    }
    assert len(hashes) == 40000
    // 40000 into 65536, at random, would leave about 30000 in use.
    assert len(low) > 28000
}

test "a key is a value: changing a copy leaves the map's" {
    mut p = Place(x: 1, y: 2)
    mut m = Map[Place, int64]()
    m[p] = 1
    p.x = 5
    assert m.contains(Place(x: 1, y: 2)) and not m.contains(p)
    mut row = [1, 2]
    mut s = Set[[int64]]()
    s.add(row)
    row += [3]
    assert s.contains([1, 2]) and not s.contains(row)
}

test "private fields, from another module" {
    assert make_token(1) == make_token(1) and make_token(1) != make_token(2)
    assert f"{make_token(1)}" == "Token(_secret: 1, shown: t1)"
    mut m = Map[Token, int64]()
    m[make_token(1)] = 7
    assert (m[make_token(1)]? or 0) == 7 and token_key(make_token(1)) == hash(make_token(1))
}

func same[T](anon a: T, anon b: T) -> bool {
    return a == b
}

test "in generic functions and closures" {
    assert same(Place(x: 1, y: 2), Place(x: 1, y: 2)) and not same([Place(x: 1, y: 2)], [])
    let p = Place(x: 3, y: 4)
    let is_p = func(anon q: Place) -> bool {
        return q == p
    }
    assert is_p(Place(x: 3, y: 4)) and not is_p(Place(x: 4, y: 3))
    mut found = -1
    for i, q in [Place(x: 1, y: 1), p] {
        if q == p and found < 0 {
            found = i
        }
    }
    assert found == 1
}

extern func rc_live_bytes() -> int64

func made(anon i: int64) -> Node {
    return Node(v: i, kids: [Node(v: i + 1)], next: if i % 2 == 0 { none } else { Node(v: i) })
}

func work(anon i: int64) -> int64 {
    mut n = 0
    if made(i) == made(i) {
        n += hash(made(i)) & 7
    }
    n += len(f"{made(i)} {[made(i)]}")
    mut m = Map[Node, Place]()
    m[made(i)] = Place(x: i, y: i, name: f"n{i}")
    return n + len(f"{m}")
}

test "nothing is left behind" {
    mut n = 0
    for i in 0..50 {
        n += work(i)
    }
    let before = rc_live_bytes()
    for i in 0..500 {
        n += work(i % 50)
    }
    assert n > 0 and rc_live_bytes() - before < 1000
}
