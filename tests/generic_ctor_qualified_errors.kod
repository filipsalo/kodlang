// What a qualified generic constructor reports.
import "./generic_qual_dep"

func main() -> int64 {
    let a = generic_qual_dep.Bax[int64](v: 1)
    let b = generic_qual_dep.Pt[int64](x: 1)
    let c = generic_qual_dep.Box[int64, str](v: 1)
    let d = generic_qual_dep.Box[Nope](v: 1)
    let e = generic_qual_dep.Box[generic_qual_dep.Nope](v: 1)
    let f = generic_qual_dep.Box[generic_qual_dep.Bax[int64]](v: 1)
    let g = generic_qual_dep.Box[str](v: 1)
    let h = generic_qual_dep._Hidden[int64](v: 1)
    return 0
}

// expected errors:
// 5:13: error: module `generic_qual_dep` has no function or type `Bax`; did you mean `Box`?
// 6:13: error: `generic_qual_dep.Pt` is not generic
// 7:13: error: `generic_qual_dep.Box` expects 1 type argument, got 2
// 8:34: error: unknown type `Nope`; did you mean `none`?
// 9:51: error: module `generic_qual_dep` has no type `Nope`
// 10:34: error: module `generic_qual_dep` has no type `Bax`; did you mean `Box`?
// 11:42: error: expected `str`, got `int64`
// 12:13: error: `_Hidden` is private to module `generic_qual_dep`
