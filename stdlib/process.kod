// Subprocess support. `run` spawns argv[0] via PATH lookup, captures stdout
// and stderr (concurrently, so neither pipe deadlocks), waits for the
// child to exit. Both captured buffers live in the arena. `exec` instead
// turns the calling process into argv[0].

type ProcessResult = struct {
    status: int64
    stdout: str
    stderr: str
}

extern func kod_run_process(anon argv: [str]) -> ProcessResult
extern func kod_exec(anon argv: [str]) -> int64
extern func kod_spawn(anon argv: [str]) -> int64
extern func kod_kill(anon pid: int64) -> int64

// User-facing wrapper. Keep the public name stable across any future
// ABI churn on the C side.
func run(anon argv: [str]) -> ProcessResult {
    return kod_run_process(argv)
}

// Start `argv[0]` (found via PATH) without waiting for it, its stdin, stdout
// and stderr on /dev/null. Returns its process id, or -1 when it could not be
// started. End it with `kill`; until then, or until this process exits, it
// is a child that has not been waited for.
func spawn(anon argv: [str]) -> int64 {
    return kod_spawn(argv)
}

// Send SIGTERM to a child that `spawn` started and wait for it. Returns
// whether the signal was delivered: false for a pid that is not a child of
// this process, such as one already killed.
func kill(anon pid: int64) -> bool {
    return kod_kill(pid) != 0
}

// Replace the calling process with `argv[0]` (found via PATH), which has
// this process's terminal, stdin and process id; stdout is flushed first.
// Input already read from a piped stdin into the buffer is not handed on.
// Returns -1, and only then, when `argv[0]` could not be run.
func exec(anon argv: [str]) -> int64 {
    return kod_exec(argv)
}
