// The routes of a key-value service over HTTP, kept in a kv.Store
// (docs/kv.md#a-service): kv_service.kod serves them, service_test.kod tests them,
// crashes included.
//
// GET    /keys          the keys, one a line
// GET    /keys/{key}    the value, or 404
// PUT    /keys/{key}    sets it to the body: 200 once it is on the disk
// DELETE /keys/{key}    removes it: 200 once that is on the disk
//
// A full disk is a 507, and a store stopped by a failing disk a 503: a change
// that got either may or may not have been kept.
import "kv"
import "net/http"
import "net/http" { HttpError, Request, Response, Router }
import "stream" { IoError }

func routes(anon db: kv.Store) -> Router {
    let r = http.Router()
    r.get("/keys", func(anon _req: Request) -> Response or Error {
        mut out = ""
        for key in db.keys() {
            out += key + "\n"
        }
        return http.text(out)
    })
    r.get("/keys/{key}", func(anon req: Request) -> Response or Error {
        let Some(value) = db.get(req.param("key")) else {
            throw HttpError(status: 404, message: "no such key\n")
        }
        return http.respond(200, str(value), content_type: "application/octet-stream")
    })
    r.put("/keys/{key}", func(anon req: Request) -> Response or Error {
        if db.put(req.param("key"), req.body) is Err(e) {
            throw refused(e)
        }
        return http.text("stored\n")
    })
    r.delete("/keys/{key}", func(anon req: Request) -> Response or Error {
        if db.remove(req.param("key")) is Err(e) {
            throw refused(e)
        }
        return http.text("removed\n")
    })
    return r
}

// What a change the store didn't make is answered with.
func refused(anon e: Error) -> HttpError {
    if e is IoError(io) and io.kind is .StorageFull {
        return HttpError(status: 507, message: "the disk is full\n")
    }
    return HttpError(status: 503, message: f"the store has stopped: {e.to_str()}\n")
}
