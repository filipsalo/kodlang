// The test runner. `kod test` links this module into the test program: each
// module's `__run_tests` dispatcher (emitted by codegen) calls `module_begin`
// once, then `reset` and `report` around every test; `assert` inside a test and
// the builtin `fail` call `fail`; the program's `_main` calls `summary` last
// and exits with what it returns. See docs/testing.md.
//
// The result lines go to stdout and the failure detail to stderr. Stdout is
// block-buffered when it is a pipe or a log and stderr is not, so stdout is
// flushed after every line of the report and before any detail: the two
// streams then keep their order when they end up in one place (and what a
// test printed itself comes out with them).
import "io"
import "posix"
import "term"
import "time"

extern func kod_monotonic_res_ns() -> int64

mut _failed: bool = false
mut _total: int64 = 0
mut _failures: int64 = 0
// When the first test started (for the summary) and when this one did; -1
// before the first.
mut _start_ns: int64 = -1
mut _case_start_ns: int64 = -1
mut _group_seen: bool = false
// -1 until `_colour` has looked, then 0 or 1.
mut _colour_known: int64 = -1

// Whether the report is coloured: stdout is a terminal and colour isn't off.
func _colour() -> bool {
    if _colour_known < 0 {
        _colour_known = 0
        if term.colour(posix.stdout()) {
            _colour_known = 1
        }
    }
    return _colour_known == 1
}

// Prints a module's path as the header of its group of results, after a blank
// line unless it is the first.
func module_begin(anon path: str) -> none {
    if _group_seen {
        io.write_stdout("\n")
    }
    _group_seen = true
    io.write_stdout(f"{path}\n")
    io.flush_stdout()
}

// Called before each test.
func reset() -> none {
    let now = time.monotonic_ns()
    if _start_ns < 0 {
        _start_ns = now
    }
    _case_start_ns = now
    _failed = false
}

// Marks the current test failed and prints `msg` under it. The test goes on,
// so one run shows every failure.
func fail(anon msg: str) -> none {
    _failed = true
    io.flush_stdout()
    // Two spaces for the group, four more so the message belongs to the test.
    io.write_stderr(f"      {msg}\n")
}

// Called after each test: prints its `ok` or `FAIL` line with how long it took.
func report(anon name: str) -> none {
    _total += 1
    mut status = "ok  "
    if _failed {
        _failures += 1
        status = "FAIL"
    }
    mut took = "(" + format_duration(time.monotonic_ns() - _case_start_ns) + ")"
    if _colour() {
        took = term.dim(took)
        if _failed {
            status = term.red(term.bold(status))
        } else {
            status = term.green(status)
        }
    }
    io.write_stdout(f"  {status} {name} {took}\n")
    io.flush_stdout()
}

// Prints how many tests passed and returns the exit status: 1 if any failed.
func summary() -> int64 {
    mut elapsed: int64 = 0
    if _start_ns >= 0 {
        elapsed = time.monotonic_ns() - _start_ns
    }
    mut line = f"{_total - _failures}/{_total} passed in {format_duration(elapsed)}"
    if _colour() and _failures > 0 {
        line = term.red(term.bold(line))
    } else if _colour() {
        line = term.green(line)
    }
    io.write_stdout(f"\n{line}\n")
    io.flush_stdout()
    if _failures > 0 {
        return 1
    }
    return 0
}

// `ns` in μs, ms or s with three significant figures: 208 ns is "0.21 μs",
// 45678 ns "45.7 μs", 1234567 ns "1.23 ms". Microseconds is the finest unit,
// since the clock only resolves about 42 ns; a 0 ns reading (two reads in one
// tick) is reported as below that, "<0.04 μs".
func format_duration(anon ns: int64) -> str {
    if ns == 0 {
        return "<" + fixed(kod_monotonic_res_ns(), unit_ns: 1000, decimals: 2) + " μs"
    }
    mut unit_ns: int64 = 1000000000
    mut unit = "s"
    if ns < 1000000 {
        unit_ns = 1000
        unit = "μs"
    } else if ns < 1000000000 {
        unit_ns = 1000000
        unit = "ms"
    }
    mut decimals: int64 = 0
    if ns < 10 * unit_ns {
        decimals = 2
    } else if ns < 100 * unit_ns {
        decimals = 1
    }
    return fixed(ns, :unit_ns, :decimals) + " " + unit
}

// `ns / unit_ns` rounded to `decimals` places (half up).
func fixed(anon ns: int64, unit_ns: int64, decimals: int64) -> str {
    mut scale: int64 = 1
    for _ in 0..decimals {
        scale = scale * 10
    }
    let scaled = (ns * scale * 2 + unit_ns) / (unit_ns * 2)
    let whole = scaled / scale
    if decimals == 0 {
        return f"{whole}"
    }
    mut frac = f"{scaled % scale}"
    for len(frac) < decimals {
        frac = "0" + frac
    }
    return f"{whole}.{frac}"
}
