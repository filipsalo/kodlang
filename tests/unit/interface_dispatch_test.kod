// What the `display` methods were asked to show, in order.
mut shown: [str] = []

interface Named {
    func display(self) -> none
}

type A = shared struct {
    label: str
    func display(self) -> none {
        shown += [self.label]
    }
}

type B = shared struct {
    label: str
    func display(self) -> none {
        shown += [f"B:{self.label}"]
    }

    // Method taking an interface arg — exercises upcast inside
    // compile_method_call (caller arg → interface param).
    func render(self, n: Named) -> none {
        n.display()
    }
}

test "a method passes a struct, and itself, as an interface argument" {
    let a: A = A(label: "alpha")
    let b: B = B(label: "beta")
    b.render(n: a)
    b.render(n: b)
    assert shown == ["alpha", "B:beta"]
}
