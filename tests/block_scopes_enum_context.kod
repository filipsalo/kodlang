// An enum's name before a `.` means the enum where a local of that name is
// in force, also where the variant's enum comes from the context: a
// comparison, an `is` and a return, whether the local hides another binding
// or not.
type Form = enum {
    Circle(r: int64)
    Dot
}

func same_block(anon fs: [Form]) -> int64 {
    let Form = 1
    mut total = Form
    for f in fs {
        if f == Form.Dot {
            total += 10000
        }
        if f is Form.Dot {
            total += 100000
        }
    }
    return total
}

func hiding(anon fs: [Form], anon Form: int64) -> int64 {
    mut total = Form
    for f in fs {
        let Form = 2
        if f == Form.Dot {
            total += 10000 + Form
        }
        if f is Form.Dot {
            total += 100000
        }
    }
    return total
}

func pick(anon n: int64) -> Form {
    let Form = n
    if Form > 0 {
        return Form.Dot
    }
    return .Circle(r: Form)
}

func main() -> int64 {
    let fs = [Form.Dot, Form.Circle(r: 1), Form.Dot]
    print_int(same_block(fs))
    print_int(hiding(fs, 5))
    print(f"{pick(1) is Form.Dot} {pick(0) is Form.Dot}")
    return 0
}

// expected output:
// 220001
// 220009
// true false
