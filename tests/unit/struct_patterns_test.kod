// A type pattern with labels matches a struct field by field.

type Rect = shared struct {
    w: int64
    h: int64
}

type Circle = shared struct {
    radius: int64
}

type Shape = Rect | Circle

type Node = shared struct {
    name: str
    kind: Kind = .Leaf
    parent: Node? = none
    weak up: Node?
}

type Kind = enum {
    Leaf
    Branch(size: int64)
}

func describe(anon s: Shape) -> str {
    match s {
        Rect(w: 0) -> return "flat"
        Rect(:w, h: 1) -> return f"strip {w}"
        Rect(:w, :h) -> return f"rect {w * h}"
        Circle(radius: r) if r > 10 -> return "big circle"
        Circle(c) -> return f"circle {c.radius}"
    }
}

func where(anon n: Node) -> str {
    match n {
        Node(parent: none, :name) -> return f"{name} is a root"
        Node(parent: Node(name: "root")) -> return "under the root"
        Node(kind: .Branch(0)) -> return "an empty branch"
        Node(name: _, kind: .Branch(size)) -> return f"a branch of {size}"
        Node(up: Node(name: up_name), :name) -> return f"{name} looks up to {up_name}"
        else -> return "somewhere"
    }
}

test "struct patterns on a union of structs" {
    assert describe(Rect(w: 0, h: 9)) == "flat"
    assert describe(Rect(w: 3, h: 1)) == "strip 3"
    assert describe(Rect(w: 3, h: 4)) == "rect 12"
    assert describe(Circle(radius: 20)) == "big circle"
    assert describe(Circle(radius: 2)) == "circle 2"
}

test "nested struct patterns" {
    let root = Node(name: "root")
    assert where(root) == "root is a root"
    assert where(Node(name: "kid", parent: root)) == "under the root"
    let mid = Node(name: "mid", parent: Node(name: "other"))
    assert where(Node(name: "b", kind: .Branch(size: 0), parent: mid)) == "an empty branch"
    assert where(Node(name: "b", kind: .Branch(size: 5), parent: mid)) == "a branch of 5"
    assert where(Node(name: "leaf", parent: mid, up: root)) == "leaf looks up to root"
    assert where(Node(name: "leaf", parent: mid)) == "somewhere"
}

test "struct patterns in is and let-else" {
    let root = Node(name: "root")
    mut found = false
    if root is Node(name: "root", parent: none) {
        found = true
    }
    assert found
    let Rect(:h) = Rect(w: 1, h: 7) else {
        fail("no match")
        return
    }
    assert h == 7
}
