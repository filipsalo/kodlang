// A negative slice bound counts from the end; then bounds clamp to [0, len]: a bound
// still below 0 becomes 0, one past the end becomes len, and an end before the
// start gives an empty slice. Same rules for str, bytes and arrays.

test "str slices clamp" {
    let s: str = "hello"
    let neg: int64 = 0 - 2
    let far: int64 = 900000000
    assert s[3..40] == "lo"
    assert s[neg..] == "lo"
    assert s[-2..3] == ""
    assert s[-9..3] == "hel"
    assert s[0..far] == "hello"
    assert s[4..2] == ""
    assert s[7..9] == ""
    assert s[-5..-1] == "hell"
    assert s[..neg] == "hel"
    assert s[..-9] == ""
    assert s[far..] == ""
    let tail: str = s[3..40]
    assert len(tail) == 2
}

test "bytes slices clamp" {
    let b: bytes = b"hello"
    let b1: bytes = b[3..40]
    let b2: bytes = b[-2..]
    let b3: bytes = b[4..1]
    assert len(b1) == 2
    assert len(b2) == 2
    assert len(b3) == 0
    assert b1 == b"lo"
    assert b2 == b"lo"
}

test "array slices clamp" {
    let neg: int64 = 0 - 2
    let far: int64 = 900000000
    let xs: [int64] = [1, 2, 3]
    assert xs[1..10] == [2, 3]
    assert xs[neg..] == [2, 3]
    assert xs[-1..2] == []
    assert xs[-9..2] == [1, 2]
    assert xs[2..1] == []
    assert xs[5..] == []
    assert xs[..far] == [1, 2, 3]
    assert xs[..-1] == [1, 2]
    assert xs[..-4] == []

    let names: [str] = ["a", "b", "c"]
    let more: [str] = names[2..99]
    assert len(more) == 1
    assert more[0] == "c"
}
