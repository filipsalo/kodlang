// A bad key that reaches a Map through another generic type's parameter
// is reported at that type's argument, naming the instance.
type Pt = struct {
    x: int64
}

type Index[T] = struct {
    m: Map[T, int64]

    func count(self) -> int64 {
        return len(self.m)
    }
}

type Tagged[T] = enum {
    Many(m: Map[T, str])
    Empty
}

type Shape = enum {
    Dot
    Circle(r: int64)
}

func count(anon i: Index[Pt]) -> int64 {
    return i.count()
}

func tags(anon t: Tagged[Shape]) -> int64 {
    return 0
}

func main() -> int64 {
    let i = Index[[int64]](m: Map[[int64], int64]())
    return i.count()
}

// expected errors:
// 25:26: error: `Pt` can't be a `Map` key in `Index[Pt]`; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads
// 29:26: error: `Shape` can't be a `Map` key in `Tagged[Shape]`; some of its variants have payloads; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads
// 34:19: error: `[int64]` can't be a `Map` key in `Index[[int64]]`; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads
