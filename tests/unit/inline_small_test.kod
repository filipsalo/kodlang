// Calls of small functions and methods are compiled in place; each argument
// must still be worked out once and in order, before the body.
import "testing"
import "./../inline_small_dep" { Box, make_box, twice, scaled }

mut calls: int64 = 0

type P = shared struct {
    x: int64
    y: int64

    func sum(self) -> int64 {
        return self.x + self.y
    }

    func is_origin(self) -> bool {
        return self.x == 0 and self.y == 0
    }
}

func sq(anon n: int64) -> int64 {
    return n * n
}

func between(anon lo: int64, anon n: int64, hi: int64) -> bool {
    return lo <= n and n < hi
}

func ratio(anon a: int64, anon b: int64) -> int64 {
    return a / b
}

func half(anon x: float64) -> float64 {
    return x * 0.5
}

func next(anon tag: str) -> int64 {
    calls += 1
    print(f"next {tag}")
    return calls
}

func make_p() -> P {
    print("make_p")
    return P(x: 3, y: 4)
}

test "an argument with a side effect runs once, and arguments run left to right" {
    // `sq` uses its argument twice.
    let r = testing.run(func() {
        print(sq(next("a")))
        print(between(next("lo"), next("n"), hi: next("hi")))
    })
    assert r.status == 0
    assert r.stdout == "next a\n1\nnext lo\nnext n\nnext hi\ntrue\n"
}

test "a caller's local with the name of a parameter" {
    let n: int64 = 5
    assert sq(n + 1) == 36
    let lo: int64 = 10
    assert between(1, lo, hi: 11)
}

test "methods are inlined, the receiver worked out once" {
    let p = P(x: 1, y: 2)
    let r = testing.run(func() {
        print(f"{p.sum()} {p.is_origin()} {P(x: 0, y: 0).is_origin()} {make_p().sum()}")
    })
    assert r.status == 0
    assert r.stdout == "make_p\n3 false true 7\n"
}

test "another module's function and methods, including a private field" {
    let b = make_box(w: 3, h: 4)
    assert f"{b.area()} {b.wider_than(2)} {b.wider_than(3)} {twice(21)} {twice(sq(3))}" == "12 true false 42 18"
    assert f"{half(3.0)} {scaled(1.5)} {scaled(1.5, by: 3.0)}" == "1.5 3.0 4.5"
}

test "inlined calls in a loop" {
    let p = P(x: 1, y: 2)
    mut total: int64 = 0
    for i in 0..10 {
        total += sq(i) + p.sum()
    }
    assert total == 315
}

test "an inlined division by zero still panics" {
    assert ratio(7, 2) == 3
    let r = testing.run(func() {
        print(ratio(7, calls - calls))
    })
    assert r.status == 1
    assert r.stdout == ""
    assert r.stderr.contains("panic: integer division by zero")
}
