// `kb.T` names only a type the module imported as `kb` declares, though
// another module of the program declares a `T`.
import "./qualified_type_wrong_module_ka"
import "./qualified_type_wrong_module_kb"

func key_of(anon e: qualified_type_wrong_module_kb.NotFound) -> str {
    return e.key
}

func found(anon f: qualified_type_wrong_module_kb.Fuond) -> str {
    return f.key
}

func main() -> int64 {
    let nf = qualified_type_wrong_module_kb.NotFound(key: "k")
    let m = Map[str, qualified_type_wrong_module_kb.NotFound]()
    let err: Error = qualified_type_wrong_module_ka.NotFound(key: "x")
    let held = err is qualified_type_wrong_module_kb.NotFound
    if err is qualified_type_wrong_module_kb.NotFound(n) {
        print(n.key)
    }
    let v = qualified_type_wrong_module_kb.E.V
    let w = qualified_type_wrong_module_kb.E.W(n: 1)
    match qualified_type_wrong_module_ka.E.V {
        qualified_type_wrong_module_kb.E.V -> print("v")
        else -> print("other")
    }
    let t: time.Clock = 0
    // Written through a name that is no module: reported as written.
    let outside = err is nosuch.NotFound
    if err is nosuch.NotFound(n) {
        print(n.key)
    }
    let kind: qualified_type_wrong_module_ka.E = .V
    let wrong = kind is qualified_type_wrong_module_kb.Nope.V
    match kind {
        nosuch.E.V -> print("v")
        else -> print("other")
    }
    return 0
}

