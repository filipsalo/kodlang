// Type arguments naming the enclosing generic's parameters (compiled only).

type Pair[A, B] = struct {
    first: A
    second: B
}

type Duo[A, B] = struct {
    a: A
    b: B

    func flipped(self) -> Pair[B, A] {
        return Pair[B, A](first: self.b, second: self.a)
    }

    func listed(self) -> Pair[[A], B] {
        return Pair[[A], B](first: [self.a, self.a], second: self.b)
    }
}

func main() -> int64 {
    let d = Duo[str, int64](a: "a", b: 1)
    let q = d.flipped()
    print(f"{q.first} {q.second}")
    let r = d.listed()
    print(f"{r.first[1]} {len(r.first)} {r.second}")
    return 0
}

// expected output:
// 1 a
// a 2 1
// expected status:
// 0
// expected mode:
// run
