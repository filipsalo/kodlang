import "./cyclic_import_struct"

func sum(anon p: cyclic_import_struct.Pt) -> int64 {
    return p.x + p.y
}

func sum_all(anon ps: [cyclic_import_struct.Pt]) -> int64 {
    mut t = 0
    for p in ps {
        t += p.x + p.y
    }
    return t
}

func first_x(anon o: cyclic_import_struct.Pt?) -> int64 {
    if o is Some(p) {
        return p.x
    }
    return -1
}

func store(anon m: Map[str, cyclic_import_struct.Pt], anon p: cyclic_import_struct.Pt) -> none {
    m["a"] = p
}

func show(anon n: cyclic_import_struct.Named) -> str {
    return n.name()
}

func make() -> cyclic_import_struct.Pt {
    return cyclic_import_struct.Pt(x: 5, y: 6)
}

func make_all() -> [cyclic_import_struct.Pt] {
    return [make(), make()]
}

func make_opt() -> cyclic_import_struct.Pt? {
    return make()
}

func make_map() -> Map[str, cyclic_import_struct.Pt] {
    let m = Map[str, cyclic_import_struct.Pt]()
    m["k"] = make()
    return m
}

func make_named() -> cyclic_import_struct.Named {
    return make()
}

