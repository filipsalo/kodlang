// A block's function value hides a function of its name only inside the block.
func twice(anon n: int64) -> int64 {
    return n * 2
}

test "a block's function value hides a function only inside the block" {
    if true {
        let twice = func(anon n: int64) -> int64 {
            return n * 100
        }
        let len = func(anon s: str) -> int64 {
            return 0 - 1
        }
        assert twice(1) == 100
        assert len("abc") == -1
    }
    assert twice(2) == 4
    assert len("abc") == 3
}
