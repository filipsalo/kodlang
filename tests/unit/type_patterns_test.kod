// `T(n)` and `T` on unions, interfaces and optionals, and through generics.
interface Shape {
    func area(self) -> int64
}

type Circle = shared struct {
    r: int64

    func area(self) -> int64 {
        return 3 * self.r * self.r
    }
}

type Square = shared struct {
    s: int64

    func area(self) -> int64 {
        return self.s * self.s
    }
}

type Id = int64 | str

func shape_name(anon s: Shape) -> str {
    return match s {
        Circle(c) if c.r > 10 -> "big circle"
        Circle(c) -> f"circle {c.r}"
        Square -> "a square"
        else -> "other"
    }
}

type Slot = enum {
    Full(shape: Shape)
    Empty
}

// After `is`, `Circle(c)` in a payload is a type pattern too.
func nested_in_is(anon s: Shape) -> str {
    let slot = Slot.Full(shape: s)
    if slot is .Full(Circle(c)) {
        return f"circle {c.r}"
    }
    return "other"
}

func maybe_id(anon m: Id | none) -> str {
    match m {
        int64(n) -> return f"int {n}"
        str(s) -> return f"str {s}"
        none -> return "none"
    }
}

func maybe_int(anon m: int64?) -> str {
    return match m {
        int64(n) if n > 100 -> "big"
        int64(n) -> f"{n}"
        none -> "none"
    }
}

func maybe_shape(anon m: Shape?) -> str {
    match m {
        Circle(c) -> return f"circle {c.r}"
        none -> return "none"
        else -> return "another shape"
    }
}

type Cell = enum {
    Held(v: Id?)
    Count(n: int64?)
    Blank
}

// In a payload, an optional takes `T(n)` without its `Some`, at any depth.
func cell_text(anon c: Cell) -> str {
    return match c {
        .Held(int64(n)) -> f"held int {n}"
        .Held(str(s)) -> f"held str {s}"
        .Held(none) -> "held none"
        .Count(int64(n)) if n > 9 -> "many"
        .Count(int64(n)) -> f"count {n}"
        .Count(none) -> "no count"
        .Blank -> "blank"
    }
}

func maybe_cell(anon m: Cell?) -> str {
    if m is Some(.Held(str(s))) {
        return f"is {s}"
    }
    match m {
        Some(.Count(int64(n))) -> return f"some count {n}"
        none -> return "no cell"
        else -> return "other cell"
    }
}

// In a payload, a type's name is its pattern, not a binding.
func slot_kind(anon slot: Slot) -> str {
    return match slot {
        .Full(Circle) -> "full of circle"
        .Full(_) -> "full"
        .Empty -> "empty"
    }
}

func held_kind(anon c: Cell) -> str {
    return match c {
        .Held(str) -> "a str"
        .Held(int64) -> "an int"
        else -> "other"
    }
}

func let_else_forms(anon held: Id | none, shape: Shape, plain: int64?) -> str {
    let str(s) = held else { return "no str" }
    let Circle(c) = shape else { return "no circle" }
    let Some(n) = plain else { return "no int" }
    return f"{s} {c.r} {n}"
}

// A type pattern on a value of exactly that type always matches and binds it.
type Box = enum {
    Full(v: int64)
    Empty
}

func ident[T](anon x: T) -> str {
    match x {
        T -> return "a T"
    }
}

// One pattern, compiled for each subject an instance gives it.
func holds_int[T](anon x: T) -> str {
    match x {
        else -> return "any"
    }
}

func generic_optional[T](anon x: T?) -> str {
    match x {
        T -> return "some"
        none -> return "none"
    }
}

test "type patterns on an interface" {
    assert shape_name(Circle(r: 20)) == "big circle"
    assert shape_name(Circle(r: 1)) == "circle 1"
    assert shape_name(Square(s: 1)) == "a square"
    assert nested_in_is(Circle(r: 2)) == "circle 2"

    let shape: Shape = Circle(r: 3)
    if shape is Circle(c) {
        assert c.r == 3
    } else {
        fail("not a circle")
    }
    if shape is Square {
        fail("not reached")
    }
    assert shape is not Square
    let is_circle = shape is Circle
    assert is_circle
}

test "type patterns on optionals" {
    assert maybe_id(1) == "int 1"
    assert maybe_id("s") == "str s"
    assert maybe_id(none) == "none"
    assert maybe_int(500) == "big"
    assert maybe_int(5) == "5"
    assert maybe_int(none) == "none"
    assert maybe_shape(Circle(r: 4)) == "circle 4"
    assert maybe_shape(Square(s: 4)) == "another shape"
    assert maybe_shape(none) == "none"
}

test "is on an optional union" {
    let held: Id | none = "held"
    if held is str(s) {
        assert s == "held"
    } else {
        fail("not a str")
    }
    if held is int64(n) {
        fail(f"int {n}")
    }
    let has_str = held is str
    let has_int = held is int64
    let not_int = held is not int64
    assert f"{has_str} {has_int} {not_int}" == "true false true"
    let gone: Id | none = none
    let gone_str = gone is str
    assert not gone_str
    mut four = false
    if held is str(s) and len(s) == 4 {
        four = true
    }
    assert four

    let plain: int64? = 6
    if plain is int64(n) {
        assert n == 6
    } else {
        fail("not an int")
    }
    let word = match held {
        str(s) -> s
        int64(n) -> f"{n}"
        none -> "none"
    }
    assert word == "held"

    // Both spellings stay valid, next to each other.
    let both = match held {
        Some(int64(n)) -> f"{n}"
        str(s) -> s
        none -> "none"
    }
    assert both == "held"
}

test "optionals in payloads" {
    assert cell_text(.Held(v: 3)) == "held int 3"
    assert cell_text(.Held(v: "x")) == "held str x"
    assert cell_text(.Held(v: none)) == "held none"
    assert cell_text(.Count(n: 12)) == "many"
    assert cell_text(.Count(n: 2)) == "count 2"
    assert cell_text(.Count(n: none)) == "no count"
    assert cell_text(.Blank) == "blank"
    assert maybe_cell(.Held(v: "y")) == "is y"
    assert maybe_cell(.Count(n: 1)) == "some count 1"
    assert maybe_cell(none) == "no cell"
    assert maybe_cell(.Blank) == "other cell"
}

test "type patterns through generics" {
    assert generic_optional[int64](1) == "some"
    assert generic_optional[str]("s") == "some"
    assert generic_optional[str](none) == "none"
    assert holds_int(1) == "any"
}

test "a type's name in a payload is its pattern" {
    assert slot_kind(.Full(shape: Circle(r: 1))) == "full of circle"
    assert slot_kind(.Full(shape: Square(s: 1))) == "full"
    assert slot_kind(.Empty) == "empty"
    assert held_kind(.Held(v: "a")) == "a str"
    assert held_kind(.Held(v: 2)) == "an int"
    assert held_kind(.Blank) == "other"
}

test "let-else with type patterns" {
    assert let_else_forms("w", shape: Circle(r: 7), plain: 8) == "w 7 8"
    assert let_else_forms(1, shape: Circle(r: 7), plain: 8) == "no str"
    assert let_else_forms("w", shape: Square(s: 7), plain: 8) == "no circle"
    assert let_else_forms("w", shape: Circle(r: 7), plain: none) == "no int"
}

test "a type pattern on a value of exactly that type" {
    let s: Shape = Circle(r: 2)
    let n: int64 = 4
    match n {
        int64(m) -> assert m + 1 == 5
    }
    let o: int64? = 6
    match o {
        Some(int64(m)) -> assert m == 6
        none -> fail("none")
    }
    match s {
        Shape(t) -> assert t.area() == 12
    }
    let id: Id = "x"
    let Id(whole) = id else {
        fail("no Id")
        return
    }
    if whole is str(w) {
        assert w == "x"
    } else {
        fail("not a str")
    }
    assert f"{n is int64} {id is Id} {id is not Id} {s is Shape}" == "true true false true"
    let b: Box = .Full(v: 9)
    match b {
        .Full(int64(v)) -> assert v == 9
        .Empty -> fail("empty")
    }
    let int64(again) = n else {
        fail("no int64")
        return
    }
    assert again == 4
    assert ident(1) == "a T"
    assert ident("s") == "a T"
}
