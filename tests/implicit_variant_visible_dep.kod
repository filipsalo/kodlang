import "./implicit_variant_visible_base"

type Mode = enum {
    Fast
    Slow
}

type Box[T] = struct {
    v: T

    func fast_rank(self) -> int64 {
        let m = .Fast
        match m {
            .Fast -> return 1
            .Slow -> return 2
        }
    }

    func modes(self) -> int64 {
        mut n = 0
        for m in [.Slow, .Fast] {
            match m {
                .Fast -> n += 1
                .Slow -> n += 10
            }
        }
        return n
    }
}

func low() -> implicit_variant_visible_base.Gear {
    return .Low
}

