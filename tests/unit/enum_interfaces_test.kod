// Enums as interface values: boxing, calls through the interface, downcasts.

interface Named {
    func name(self) -> str
}

interface Sized {
    func size(self, scale: int64 = 1) -> int64
    func name(self) -> str
}

type Dir = enum {
    Up
    Down

    func name(self) -> str {
        return match self {
            .Up -> "up"
            .Down -> "down"
        }
    }
}

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)

    func name(self) -> str {
        return match self {
            .Circle -> "circle"
            .Rect -> "rect"
        }
    }

    func size(self, scale: int64 = 1) -> int64 {
        return scale * match self {
            .Circle(r) -> 3 * r * r
            .Rect(w, h) -> w * h
        }
    }
}

type Pick[T] = enum {
    One(v: T)
    Nothing

    func name(self) -> str {
        return match self {
            .One(v) -> f"one {v}"
            .Nothing -> "nothing"
        }
    }
}

type IntPick = Pick[int64]

type Label = shared struct {
    text: str

    func name(self) -> str {
        return self.text
    }
}

type Oops = enum {
    Lost(what: str)

    func to_str(self) -> str {
        return match self {
            .Lost(what) -> f"lost {what}"
        }
    }
}

func names(anon xs: [Named]) -> str {
    mut out = ""
    for x in xs {
        if len(out) > 0 {
            out += " "
        }
        out += x.name()
    }
    return out
}

func kind(anon n: Named) -> str {
    match n {
        Dir(d) -> return f"dir {d == .Up}"
        Shape(s) -> return f"shape {s.size()}"
        IntPick(p) -> return f"int pick {p.name()}"
        Label(l) -> return f"label {l.text}"
        else -> return "other"
    }
}

func find(anon what: str) -> int64 or Error {
    if what == "" {
        throw Oops.Lost(what: "nothing")
    }
    return len(what)
}

test "calls through the interface" {
    let d: Named = Dir.Down
    assert d.name() == "down"
    let shapes: [Sized] = [Shape.Circle(r: 1), Shape.Rect(w: 2, h: 3)]
    mut seen: [str] = []
    for s in shapes {
        seen += [f"{s.name()} {s.size()} {s.size(scale: 10)}"]
    }
    assert seen == ["circle 3 30", "rect 6 60"]
    let sized: Sized = Shape.Rect(w: 1, h: 1)
    let named: Named = sized
    assert named.name() == "rect"
    let p: Pick[int64] = .One(v: 7)
    let q: Pick[str] = .Nothing
    assert names([Dir.Up, p, q, Label(text: "hi"), sized]) == "up one 7 nothing hi rect"
}

test "downcasts" {
    let d: Named = Dir.Down
    let sized: Sized = Shape.Rect(w: 1, h: 1)
    let named: Named = sized
    let p: Pick[int64] = .One(v: 7)
    let q: Pick[str] = .Nothing
    assert kind(Dir.Up) == "dir true"
    assert kind(Shape.Rect(w: 2, h: 5)) == "shape 10"
    assert kind(named) == "shape 1"
    assert kind(p) == "int pick one 7"
    assert kind(q) == "other"
    assert kind(Label(text: "x")) == "label x"
    if d is Dir(dir) {
        assert dir.name() == "down"
    } else {
        fail("not Dir")
    }
}

test "optional interface values, errors and many boxes" {
    let maybe: Named? = Dir.Up
    assert (maybe?.name()? or "none") == "up"
    match find("") {
        Ok(_n) -> fail("found")
        Err(e) -> assert e.to_str() == "lost nothing"
    }
    for _ in 0..1000 {
        let _: Named = Shape.Circle(r: 2)
    }
}
