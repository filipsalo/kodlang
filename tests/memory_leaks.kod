// How many bytes stay in use after a thousand rounds of each shape of code.
import "json"
import "time"
import "strbuilder" { StrBuilder }

extern func rc_live_bytes() -> int64

type P = struct {
    s: str
    n: int64
}

type W = enum {
    A(s: str)
    B
}

interface I {
    func name(self) -> str
}

type Q = struct {
    s: str

    func name(self) -> str {
        return self.s
    }
}

func opt(anon s: str) -> str? {
    return s + "!"
}

func res(anon s: str) -> str or Error {
    return s + "!"
}

func res_err() -> str or Error {
    throw Q2(s: "bad" + "!")
}

type Q2 = struct {
    s: str

    func to_str(self) -> str {
        return self.s
    }
}

func tries(anon s: str) -> str or Error {
    let a = try res(s)
    return a + "?"
}

func box(anon s: str) -> I {
    return Q(s: s + "!")
}

func use_str(anon s: str) -> int64 {
    return len(s)
}

type Big = struct {
    s0: str = ""
    s1: str = ""
    s2: str = ""
    s3: str = ""
    s4: str = ""
    s5: str = ""
    s6: str = ""
    s7: str = ""
    s8: str = ""
    s9: str = ""
    s10: str = ""
    s11: str = ""
    s12: str = ""
    s13: str = ""
    s14: str = ""
    s15: str = ""
    s16: str = ""
    s17: str = ""
    s18: str = ""
    s19: str = ""
    s20: str = ""
    s21: str = ""
    s22: str = ""
    s23: str = ""
    s24: str = ""
    s25: str = ""
    s26: str = ""
    s27: str = ""
    s28: str = ""
    s29: str = ""
    last: P? = none
}

type U1 = struct {
    s: str
}
type Strs = [str]
type Un = str | int64 | U1 | Strs | I

func un(anon s: str) -> Un {
    return s + "!"
}
func un_struct(anon s: str) -> Un {
    return U1(s: s + "!")
}
func un_len(anon v: Un) -> int64 {
    return match v {
        str(s) -> len(s)
        int64(n) -> n
        U1(u) -> len(u.s)
        Strs(xs) -> len(xs)
        I(i) -> len(i.name())
    }
}
type UnHolder = struct {
    v: Un
}
func t_union() -> int64 {
    return un_len(un("a")) + un_len(un_struct("b")) + un_len(3)
}
func t_union_is() -> int64 {
    let v = un("a")
    if v is str(s) {
        return len(s + "?")
    }
    return 0
}
func t_union_store() -> int64 {
    let h = UnHolder(v: "a" + "b")
    h.v = ["c" + "d"]
    h.v = Q(s: "e" + "f")
    mut v: Un = "g" + "h"
    v = U1(s: "i" + "j")
    return un_len(h.v) + un_len(v)
}
func t_union_array() -> int64 {
    mut xs: [Un] = ["a" + "b", 1, U1(s: "c" + "d")]
    xs += ["e" + "f"]
    mut total = 0
    for x in xs {
        total += un_len(x)
    }
    return total
}
func t_union_match_expr() -> int64 {
    let v = un("a")
    let w: Un = match v {
        str(s) -> s + "?"
        else -> 1
    }
    return un_len(w)
}
func t_union_optional() -> int64 {
    let o: Un | none = "a" + "b"
    match o {
        Some(str(s)) -> return len(s)
        Some(_) -> return 0
        none -> return 0
    }
}

func t_flat_optional() -> int64 {
    let o: Un | none = "a" + "b"
    match o {
        str(s) -> return len(s)
        none -> return 0
        else -> return 1
    }
}
func t_flat_is() -> int64 {
    let o: Un | none = "a" + "b"
    if o is str(s) {
        return len(s + "?")
    }
    return 0
}
func t_flat_interface() -> int64 {
    let i: I = Q(s: "a" + "b")
    let o: I? = i
    match o {
        Q(q) -> return len(q.s)
        none -> return 0
        else -> return 1
    }
}
func t_downcast() -> int64 {
    let i: I = Q(s: "a" + "b")
    if i is Q(q) {
        return len(q.s + "?")
    }
    return 0
}

type Narrow = str | U1
func narrow(anon s: str) -> Narrow {
    return s + "!"
}
func t_union_widen() -> int64 {
    let n = narrow("a")
    let w: Un = n
    let h = UnHolder(v: narrow("b"))
    return un_len(w) + un_len(h.v)
}
func t_union_print() -> int64 {
    let v: str | int64 = "a" + "b"
    let n: str | int64 = 12
    return len(f"{v} {n}") + len(str(v))
}
func bang(anon s: str) -> str | int64 {
    return s + "!"
}
func quiet(anon msg: str) -> none {
    if len(msg) > 100 {
        print(msg)
    }
}
func stop(anon msg: str) -> none {
    kod_panic(msg)
}
func t_guard_call(anon s: str?) -> int64 {
    if s is none {
        quiet("none")
    }
    let kept = s? or "-"
    let t: str? = "a" + "b"
    if t is none {
        stop("none")
    }
    return len(kept) + len(t)
}
func t_guard_calls() -> int64 {
    return t_guard_call("a" + "b") + t_guard_call(none)
}
func t_union_eq() -> int64 {
    let v: str | int64 = "a" + "b"
    let w: str | int64 = "a" + "b"
    mut n = 0
    if v == w and v == "a" + "b" and bang("x") != v {
        n = 1
    }
    return n
}

func measure(anon name: str, f: func() -> int64) -> none {
    let _first = f()
    let before = rc_live_bytes()
    for _ in 0..1000 {
        let _x = f()
    }
    let grew = rc_live_bytes() - before
    print(f"{grew / 1000} bytes/round  {name}")
}

func t_concat() -> int64 {
    return use_str("a" + "b")
}
func t_fstring() -> int64 {
    let n = 5
    return use_str(f"x{n}y{"s"}")
}
func t_to_str() -> int64 {
    return use_str(5.to_str())
}
func t_slice() -> int64 {
    return use_str("abcdef"[1..3])
}
func t_struct() -> int64 {
    return P(s: "a" + "b", n: 1).n
}
func t_let_struct() -> int64 {
    let p = P(s: "a" + "b", n: 1)
    return p.n
}
func t_enum() -> int64 {
    let w: W = .A(s: "a" + "b")
    return match w {
        .A(s) -> len(s)
        .B -> 0
    }
}
func t_opt() -> int64 {
    if opt("a") is Some(v) {
        return len(v)
    }
    return 0
}
func t_opt_or() -> int64 {
    return len(opt("a")? or "z")
}
func t_let_else() -> int64 {
    let .Some(v) = opt("a") else { return 0 }
    return len(v)
}
func t_res() -> int64 {
    let r = res("a")
    return len(must r)
}
func t_try() -> int64 {
    return len(must tries("a"))
}
func t_err() -> int64 {
    let r = res_err()
    if r is Err(e) {
        return len(e.to_str())
    }
    return 0
}
func t_iface() -> int64 {
    return len(box("a").name())
}
func t_array() -> int64 {
    mut xs: [str] = []
    for i in 0..10 {
        xs += ["a" + "b"]
    }
    return len(xs)
}
func t_array_add() -> int64 {
    let a = ["a" + "b"]
    let b = a + ["c" + "d"]
    return len(b)
}
func t_array_slice() -> int64 {
    let a = ["a" + "b", "c"]
    return len(a[0..1])
}
func t_split() -> int64 {
    return len("a,b,c".split(","))
}
func t_trim() -> int64 {
    return len(" abc ".trim())
}
func t_lower() -> int64 {
    return len("ABC".lower())
}
func t_map() -> int64 {
    let m = Map[str, str]()
    m.set("a" + "b", "c" + "d")
    return len(m.get("ab")? or "")
}
func t_builder() -> int64 {
    let b = StrBuilder()
    b.append("abc")
    return len(b.to_str())
}
func t_bytes() -> int64 {
    return len(kod_str_to_bytes("a" + "b"))
}
func t_str_bytes() -> int64 {
    return len(str(kod_str_to_bytes("a" + "b")))
}
func t_json_parse() -> int64 {
    let v = must json.parse("{\"a\": [1, \"x\"]}")
    return len(json.emit(v))
}
func t_time() -> int64 {
    return len(time.now().to_str())
}
func t_field_opt() -> int64 {
    let p: P? = P(s: "a" + "b", n: 1)
    return (p?.n)? or 0
}
func t_parse_int() -> int64 {
    return "12".parse_int()? or 0
}

// References past what an object's header can describe.
func t_big() -> int64 {
    let b = Big(s0: "a" + "b", s25: "c" + "d", last: P(s: "e" + "f", n: 1))
    b.s29 = "g" + "h"
    return len(b.s25) + len(b.s29)
}
func t_opt_method() -> int64 {
    let q: Q? = Q(s: "a" + "b")
    let n = q?.name()
    return len(n? or "")
}
// A loop condition runs again in the same statement.
func t_loop_cond() -> int64 {
    mut i = 0
    for len("a" + "b") > i {
        i += 1
    }
    return i
}
// Leaving a statement with a value still held for it.
func t_break() -> int64 {
    mut n = 0
    for i in 0..3 {
        if len(f"x{i}" + "y") > 0 {
            n += 1
            break
        }
    }
    return n
}
func t_continue() -> int64 {
    mut n = 0
    for i in 0..3 {
        if len(f"x{i}" + "y") > 2 {
            continue
        }
        n += 1
    }
    return n
}
func t_return_early(anon s: str) -> str {
    let a = s + "!"
    if len(a) > 1 {
        return a
    }
    let b = a + "?"
    return b
}
func t_early() -> int64 {
    return len(t_return_early("x"))
}
func t_retype() -> int64 {
    let x = "a" + "b"
    let x = len(x)
    return x
}
func t_mut_param(mut s: str) -> int64 {
    s = s + "!"
    return len(s)
}
func t_param() -> int64 {
    return t_mut_param(s: "a" + "b")
}
func t_discard() -> int64 {
    "a" + "b"
    box("c")
    return 0
}

func main() -> int64 {
    measure("concat", f: t_concat)
    measure("fstring", f: t_fstring)
    measure("to_str", f: t_to_str)
    measure("slice", f: t_slice)
    measure("struct", f: t_struct)
    measure("let struct", f: t_let_struct)
    measure("enum", f: t_enum)
    measure("optional", f: t_opt)
    measure("optional or", f: t_opt_or)
    measure("let else", f: t_let_else)
    measure("result", f: t_res)
    measure("try", f: t_try)
    measure("err", f: t_err)
    measure("interface", f: t_iface)
    measure("array +=", f: t_array)
    measure("array +", f: t_array_add)
    measure("array slice", f: t_array_slice)
    measure("split", f: t_split)
    measure("trim", f: t_trim)
    measure("lower", f: t_lower)
    measure("map", f: t_map)
    measure("builder", f: t_builder)
    measure("to bytes", f: t_bytes)
    measure("str(bytes)", f: t_str_bytes)
    measure("json", f: t_json_parse)
    measure("time", f: t_time)
    measure("x?.field", f: t_field_opt)
    measure("parse_int", f: t_parse_int)
    measure("big struct", f: t_big)
    measure("x?.method()", f: t_opt_method)
    measure("loop condition", f: t_loop_cond)
    measure("break", f: t_break)
    measure("continue", f: t_continue)
    measure("early return", f: t_early)
    measure("retyped let", f: t_retype)
    measure("mut parameter", f: t_param)
    measure("discarded result", f: t_discard)
    measure("union", f: t_union)
    measure("union is", f: t_union_is)
    measure("union store", f: t_union_store)
    measure("union array", f: t_union_array)
    measure("union match", f: t_union_match_expr)
    measure("union optional", f: t_union_optional)
    measure("flat optional", f: t_flat_optional)
    measure("flat is", f: t_flat_is)
    measure("flat interface", f: t_flat_interface)
    measure("downcast", f: t_downcast)
    measure("union widen", f: t_union_widen)
    measure("union print", f: t_union_print)
    measure("union eq", f: t_union_eq)
    measure("guard calls", f: t_guard_calls)
    return 0
}

// expected output:
// 0 bytes/round  concat
// 0 bytes/round  fstring
// 0 bytes/round  to_str
// 0 bytes/round  slice
// 0 bytes/round  struct
// 0 bytes/round  let struct
// 0 bytes/round  enum
// 0 bytes/round  optional
// 0 bytes/round  optional or
// 0 bytes/round  let else
// 0 bytes/round  result
// 0 bytes/round  try
// 0 bytes/round  err
// 0 bytes/round  interface
// 0 bytes/round  array +=
// 0 bytes/round  array +
// 0 bytes/round  array slice
// 0 bytes/round  split
// 0 bytes/round  trim
// 0 bytes/round  lower
// 0 bytes/round  map
// 0 bytes/round  builder
// 0 bytes/round  to bytes
// 0 bytes/round  str(bytes)
// 0 bytes/round  json
// 0 bytes/round  time
