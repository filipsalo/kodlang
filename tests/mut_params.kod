type Stop = struct {
    message: str

    func to_str(self) -> str {
        return self.message
    }
}

type Counter = struct {
    n: int64 = 0

    func add_to(self, anon s: str, mut seen: [str]) -> none {
        seen += [s]
        self.n += 1
    }
}

func bump(anon mut x: int64) -> none {
    x = x + 1
}

func count(anon s: str, mut seen: [str]) -> int64 {
    seen += [s]
    return len(seen)
}

func replace(mut xs: [int64]) -> none {
    xs = [7, 8, 9]
    xs[0] = 6
}

func rename(mut name: str, suffix: str) -> none {
    name = name + suffix
}

func both(mut a: [int64], mut b: [int64]) -> none {
    a += [1]
    b += [2]
    count_through(xs: mut a)
}

func count_through(mut xs: [int64]) -> none {
    xs += [len(xs)]
}

func early(anon stop: bool, mut xs: [int64]) -> int64 {
    xs += [1]
    if stop {
        return -1
    }
    xs += [2]
    return len(xs)
}

func fails(anon fail: bool, mut log: [str]) -> int64 or Error {
    log += ["start"]
    if fail {
        throw Stop(message: "no")
    }
    log += ["end"]
    return 1
}

func outer(mut log: [str]) -> int64 or Error {
    let r = try fails(true, log: mut log)
    log += ["unreached"]
    return r
}

func main() -> int64 {
    mut n = 1
    bump(mut n)
    bump(mut n)
    print(n)

    mut seen: [str] = []
    print(count("a", seen: mut seen))
    print(count("b", seen: mut seen))
    print(seen)

    mut xs = [1]
    replace(xs: mut xs)
    print(xs)

    mut name = "kod"
    rename(name: mut name, suffix: "lang")
    print(name)

    mut a: [int64] = []
    mut b: [int64] = []
    both(a: mut a, b: mut b)
    print(f"{a} {b}")

    mut e: [int64] = []
    print(early(true, xs: mut e))
    print(e)
    print(early(false, xs: mut e))
    print(e)

    mut log: [str] = []
    if outer(log: mut log) is Error(err) {
        print(f"{err} {log}")
    }

    let c = Counter()
    mut words: [str] = []
    for w in ["x", "y"] {
        c.add_to(w, seen: mut words)
    }
    print(f"{c.n} {words}")
    return 0
}

// expected output:
// 3
// 1
// 2
// [a, b]
// [6, 8, 9]
// kodlang
// [1, 1] [2]
// -1
// [1]
// 3
// [1, 1, 2]
// no [start]
// 2 [x, y]
