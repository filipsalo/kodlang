// The fewest digits that read back as exactly `x`, rounded correctly (half to
// even) from its exact value, in plain decimal for magnitudes from 1e-6 up to
// (not including) 1e21 and as d.ddde+X outside it; always with a point or an
// exponent, so a float never reads as an integer.
func format(anon x: float64) -> str {
	let bits = kod_f64_bits(x)
	let negative = bits < 0
	let biased = (bits >> 52) & 2047
	let frac = bits & (_HIDDEN - 1)
	if biased == 2047 {
		if frac != 0 {
			return "nan"
		}
		if negative {
			return "-inf"
		}
		return "inf"
	}
	if biased == 0 and frac == 0 {
		if negative {
			return "-0.0"
		}
		return "0.0"
	}
	mut f = frac
	mut e: int64 = -1074
	if biased > 0 {
		f = frac + _HIDDEN
		e = biased - 1075
	}
	// x is r / s; the values that read back as x are those within mm below it
	// and mp above it, on the same scale. The ends count when f is even, since
	// a tie rounds to the even neighbour.
	let even = f % 2 == 0
	mut r: [int64] = []
	mut s: [int64] = []
	mut mp: [int64] = []
	mut mm: [int64] = []
	if e >= 0 {
		if f != _HIDDEN {
			r = _big_shl(_big(f), e + 1)
			s = _big(2)
			mp = _big_shl(_big(1), e)
			mm = mp
		} else {
			// The float below is half as far away as the one above.
			r = _big_shl(_big(f), e + 2)
			s = _big(4)
			mp = _big_shl(_big(1), e + 1)
			mm = _big_shl(_big(1), e)
		}
	} else if f != _HIDDEN or e == -1074 {
		r = _big(f * 2)
		s = _big_shl(_big(1), 1 - e)
		mp = _big(1)
		mm = mp
	} else {
		r = _big(f * 4)
		s = _big_shl(_big(1), 2 - e)
		mp = _big(2)
		mm = _big(1)
	}
	// Scale so that 10^(k-1) <= x < 10^k: r / s is then 0.d1d2d3...
	mut k = _floor_div((e + _bit_len(f) - 1) * 78913, 262144) + 1
	if k >= 0 {
		s = _big_mul_pow10(s, k)
	} else {
		r = _big_mul_pow10(r, -k)
		mp = _big_mul_pow10(mp, -k)
		mm = _big_mul_pow10(mm, -k)
	}
	for _big_cmp(r, s) >= 0 {
		s = _big_mul_small(s, 10)
		k += 1
	}
	for _big_cmp(_big_mul_small(r, 10), s) < 0 {
		r = _big_mul_small(r, 10)
		mp = _big_mul_small(mp, 10)
		mm = _big_mul_small(mm, 10)
		k -= 1
	}
	// One more digit at a time, until the digits so far, rounded, read back as x.
	mut digits: [int64] = []
	for true {
		r = _big_mul_small(r, 10)
		mp = _big_mul_small(mp, 10)
		mm = _big_mul_small(mm, 10)
		mut d: int64 = 0
		for _big_cmp(r, s) >= 0 {
			r = _big_sub(r, s)
			d += 1
		}
		digits += [d]
		let half = _big_cmp(_big_shl(r, 1), s)
		let up = half > 0 or (half == 0 and d % 2 == 1)
		mut close = false
		if up {
			let c = _big_cmp(_big_add(r, mp), s)
			close = c > 0 or (c == 0 and even)
		} else {
			let c = _big_cmp(r, mm)
			close = c < 0 or (c == 0 and even)
		}
		if close {
			if up {
				mut i = len(digits) - 1
				digits[i] = digits[i] + 1
				for i > 0 and digits[i] == 10 {
					digits[i] = 0
					i -= 1
					digits[i] = digits[i] + 1
				}
				if digits[0] == 10 {
					digits[0] = 1
					k += 1
				}
			}
			break
		}
	}
	mut nd = len(digits)
	for nd > 1 and digits[nd - 1] == 0 {
		nd -= 1
	}
	let exp10 = k - 1
	let sb = kod_sb_new()
	if negative {
		kod_sb_append_byte(sb, '-')
	}
	if exp10 >= -6 and exp10 < 21 {
		if exp10 >= 0 {
			for i in 0..exp10 + 1 {
				if i < nd {
					kod_sb_append_byte(sb, '0' + digits[i])
				} else {
					kod_sb_append_byte(sb, '0')
				}
			}
			kod_sb_append_byte(sb, '.')
			if nd > exp10 + 1 {
				for i in exp10 + 1..nd {
					kod_sb_append_byte(sb, '0' + digits[i])
				}
			} else {
				kod_sb_append_byte(sb, '0')
			}
		} else {
			kod_sb_append(sb, "0.")
			for _ in 0..-exp10 - 1 {
				kod_sb_append_byte(sb, '0')
			}
			for i in 0..nd {
				kod_sb_append_byte(sb, '0' + digits[i])
			}
		}
	} else {
		kod_sb_append_byte(sb, '0' + digits[0])
		if nd > 1 {
			kod_sb_append_byte(sb, '.')
			for i in 1..nd {
				kod_sb_append_byte(sb, '0' + digits[i])
			}
		}
		if exp10 < 0 {
			kod_sb_append(sb, f"e-{0 - exp10}")
		} else {
			kod_sb_append(sb, f"e+{exp10}")
		}
	}
	return kod_sb_to_str(sb)
}

// `s` as the nearest float64 (a tie goes to the even one) when it is a
// decimal number: an optional sign, digits with an optional point (one digit
// at least) and an optional exponent with digits; otherwise none. A value too
// large for a float64 is infinity, and one too small is zero.
func parse(anon s: str) -> float64? {
	let n = len(s)
	mut i: int64 = 0
	mut negative = false
	if i < n and (s[i] == '+' or s[i] == '-') {
		negative = s[i] == '-'
		i += 1
	}
	let start = i
	// The value is about w × 10^exp10, where w holds the first 19 significant
	// digits (as an unsigned number) and `truncated` says a nonzero digit
	// came after them.
	mut w: int64 = 0
	mut nd: int64 = 0
	mut seen: int64 = 0
	mut exp10: int64 = 0
	mut truncated = false
	for i < n {
		let d = s[i] - '0'
		if d < 0 or d > 9 {
			break
		}
		seen += 1
		if nd < 19 {
			if nd > 0 or d != 0 {
				w = w * 10 + d
				nd += 1
			}
		} else {
			exp10 += 1
			truncated = truncated or d != 0
		}
		i += 1
	}
	if i < n and s[i] == '.' {
		i += 1
		for i < n {
			let d = s[i] - '0'
			if d < 0 or d > 9 {
				break
			}
			seen += 1
			if nd < 19 {
				if nd > 0 or d != 0 {
					w = w * 10 + d
					nd += 1
				}
				exp10 -= 1
			} else {
				truncated = truncated or d != 0
			}
			i += 1
		}
	}
	if seen == 0 {
		return none
	}
	let digits_end = i
	mut exp: int64 = 0
	if i < n and (s[i] == 'e' or s[i] == 'E') {
		i += 1
		mut exp_negative = false
		if i < n and (s[i] == '+' or s[i] == '-') {
			exp_negative = s[i] == '-'
			i += 1
		}
		mut exp_digits: int64 = 0
		for i < n and _is_digit(s[i]) {
			exp_digits += 1
			// Past this, the value is infinity or zero anyway.
			if exp < 1000000 {
				exp = exp * 10 + s[i] - '0'
			}
			i += 1
		}
		if exp_digits == 0 {
			return none
		}
		if exp_negative {
			exp = 0 - exp
		}
		exp10 += exp
	}
	if i != n {
		return none
	}
	mut sign: int64 = 0
	if negative {
		sign = 1 << 63
	}
	if nd == 0 {
		return kod_f64_from_bits(sign)
	}
	// 10^(nd + exp10 - 1) <= value < 10^(nd + exp10).
	if nd + exp10 > 310 {
		return kod_f64_from_bits(sign | (2047 << 52))
	}
	if nd + exp10 < -330 {
		return kod_f64_from_bits(sign)
	}
	if not truncated and w >= 0 and w <= (1 << 53) and exp10 >= -22 and exp10 <= 22 {
		// The digits and the power of ten are both exact, so one rounding.
		mut value = w.to_float64()
		if exp10 >= 0 {
			value = value * _POW10F[exp10]
		} else {
			value = value / _POW10F[0 - exp10]
		}
		return kod_f64_from_bits(kod_f64_bits(value) | sign)
	}
	mut bits = _eisel_lemire(w, q: exp10)
	// With digits dropped, the value lies between w and w + 1 (times the
	// power of ten): when both round to the same float, that's the one.
	if truncated and _eisel_lemire(w + 1, q: exp10) != bits {
		bits = _parse_exact(s, start: start, end: digits_end, exp: exp)
	}
	return kod_f64_from_bits(bits | sign)
}

// The bits of w × 10^q rounded to the nearest float64, where w is an unsigned
// number: Eisel and Lemire's method, with Mushtak and Lemire's proof that the
// first 64 bits of 5^q, and the next 64 when those don't settle it, always do.
func _eisel_lemire(anon w0: int64, q: int64) -> int64 {
	if w0 == 0 or q < -342 {
		return 0
	}
	if q > 308 {
		return 2047 << 52
	}
	let lz = w0.leading_zeros()
	let w = w0 << lz
	let at = 2 * (q + 342)
	mut hi = w.mul_high(_POW5[at])
	mut lo = w * _POW5[at]
	if (hi & 511) == 511 {
		let next = lo + w.mul_high(_POW5[at + 1])
		if _below(next, lo) {
			hi += 1
		}
		lo = next
	}
	let upper = hi >> 63
	mut m = hi >> (upper + 9)
	// floor(q × log2(10)) + 63, plus the exponent bias.
	mut p2 = _floor_div(217706 * q, 65536) + 63 + upper - lz + 1023
	if p2 <= 0 {
		// Below the smallest normal float: one shift, then round.
		if 1 - p2 >= 64 {
			return 0
		}
		m = m >> (1 - p2)
		m += m & 1
		return m >> 1
	}
	// Exactly halfway, which only small powers of ten can make: round to even.
	if (lo == 0 or lo == 1) and q >= -4 and q <= 23 and (m & 3) == 1 and (m << (upper + 9)) == hi {
		m -= 1
	}
	m += m & 1
	m = m >> 1
	if m >= (1 << 53) {
		m = 1 << 52
		p2 += 1
	}
	if p2 >= 2047 {
		return 2047 << 52
	}
	return (p2 << 52) | (m & (((1 << 52) - 1)))
}

// The digits of s[start..end] (a point allowed among them) times 10^exp, as
// the bits of the nearest float64, worked out with big numbers: for the rare
// value with more than 19 digits that lies too close to a midpoint to tell.
func _parse_exact(anon s: str, start: int64, end: int64, exp: int64) -> int64 {
	mut a: [int64] = []
	mut exp10 = exp
	mut point = false
	for i in start..end {
		if s[i] == '.' {
			point = true
		} else {
			a = _big_add(_big_mul_small(a, 10), _big(s[i] - '0'))
			if point {
				exp10 -= 1
			}
		}
	}
	// value = a / b. Scale one of them by 2^k so that the quotient q has 54 or
	// 55 bits; value is then q × 2^-k, plus a remainder that only matters as a
	// tie-breaker.
	mut b = _big(1)
	if exp10 >= 0 {
		a = _big_mul_pow10(a, exp10)
	} else {
		b = _big_mul_pow10(b, 0 - exp10)
	}
	let k = 54 - (_big_bits(a) - _big_bits(b))
	if k >= 0 {
		a = _big_shl(a, k)
	} else {
		b = _big_shl(b, 0 - k)
	}
	mut q: int64 = 0
	mut rem = a
	mut step = _big_shl(b, 55)
	for _ in 0..56 {
		q = q << 1
		if _big_cmp(rem, step) >= 0 {
			rem = _big_sub(rem, step)
			q = q | 1
		}
		step = _big_shr1(step)
	}
	// Drop the bits below the 53 a float64 keeps, or more below its smallest
	// exponent, and round half to even.
	mut drop = _bit_len(q) - 53
	mut e2 = drop - k
	if e2 < -1074 {
		drop = drop + (-1074 - e2)
		e2 = -1074
	}
	if drop > 56 {
		return 0
	}
	mut m = q >> drop
	let half = (q >> (drop - 1)) & 1
	let below = (q & ((1 << (drop - 1)) - 1)) != 0 or len(rem) > 0
	if half == 1 and (below or m % 2 == 1) {
		m += 1
	}
	if m == 2 * _HIDDEN {
		m = _HIDDEN
		e2 += 1
	}
	if e2 > 971 {
		return 2047 << 52
	}
	if m < _HIDDEN {
		return m
	}
	return ((e2 + 1075) << 52) | (m - _HIDDEN)
}

// a < b, both unsigned.
func _below(anon a: int64, anon b: int64) -> bool {
	return (a ^ (1 << 63)) < (b ^ (1 << 63))
}

func _is_digit(anon b: int64) -> bool {
	return b >= '0' and b <= '9'
}

func _floor_div(anon a: int64, anon b: int64) -> int64 {
	let q = a / b
	if a % b != 0 and a < 0 {
		return q - 1
	}
	return q
}

// How many bits a nonnegative number needs; 0 for 0.
func _bit_len(anon n: int64) -> int64 {
	return 64 - n.leading_zeros()
}

func _big(anon n: int64) -> [int64] {
	mut out: [int64] = []
	mut v = n
	for v > 0 {
		out += [v & _LIMB_MASK]
		v = v >> _LIMB_BITS
	}
	return out
}

func _big_trim(anon a: [int64]) -> [int64] {
	mut n = len(a)
	for n > 0 and a[n - 1] == 0 {
		n -= 1
	}
	if n == len(a) {
		return a
	}
	return a[0..n]
}

func _big_bits(anon a: [int64]) -> int64 {
	if len(a) == 0 {
		return 0
	}
	return (len(a) - 1) * _LIMB_BITS + _bit_len(a[len(a) - 1])
}

func _big_cmp(anon a: [int64], anon b: [int64]) -> int64 {
	if len(a) != len(b) {
		if len(a) < len(b) {
			return -1
		}
		return 1
	}
	mut i = len(a) - 1
	for i >= 0 {
		if a[i] != b[i] {
			if a[i] < b[i] {
				return -1
			}
			return 1
		}
		i -= 1
	}
	return 0
}

func _big_add(anon a: [int64], anon b: [int64]) -> [int64] {
	if len(b) > len(a) {
		return _big_add(b, a)
	}
	mut out = a[0..len(a)]
	mut carry: int64 = 0
	for i in 0..len(out) {
		mut t = out[i] + carry
		if i < len(b) {
			t += b[i]
		} else if carry == 0 {
			break
		}
		out[i] = t & _LIMB_MASK
		carry = t >> _LIMB_BITS
	}
	if carry > 0 {
		out += [carry]
	}
	return out
}

// a - b, for a >= b.
func _big_sub(anon a: [int64], anon b: [int64]) -> [int64] {
	mut out = a[0..len(a)]
	mut borrow: int64 = 0
	for i in 0..len(out) {
		if i >= len(b) and borrow == 0 {
			break
		}
		mut t = out[i] - borrow
		if i < len(b) {
			t = t - b[i]
		}
		borrow = 0
		if t < 0 {
			t += _LIMB_MASK + 1
			borrow = 1
		}
		out[i] = t
	}
	return _big_trim(out)
}

// a × m, for 0 < m < 2^30.
func _big_mul_small(anon a: [int64], anon m: int64) -> [int64] {
	mut out = a[0..len(a)]
	mut carry: int64 = 0
	for i in 0..len(out) {
		let t = out[i] * m + carry
		out[i] = t & _LIMB_MASK
		carry = t >> _LIMB_BITS
	}
	for carry > 0 {
		out += [carry & _LIMB_MASK]
		carry = carry >> _LIMB_BITS
	}
	return out
}

func _big_mul_pow10(anon a: [int64], anon n: int64) -> [int64] {
	mut out = a
	mut left = n
	for left >= 9 {
		out = _big_mul_small(out, 1000000000)
		left -= 9
	}
	if left > 0 {
		out = _big_mul_small(out, _POW10[left])
	}
	return out
}

func _big_shl(anon a: [int64], anon n: int64) -> [int64] {
	if len(a) == 0 {
		return a
	}
	mut out: [int64] = []
	for _ in 0..n / _LIMB_BITS {
		out += [0]
	}
	let bits = n % _LIMB_BITS
	mut carry: int64 = 0
	for limb in a {
		let t = (limb << bits) | carry
		out += [t & _LIMB_MASK]
		carry = t >> _LIMB_BITS
	}
	if carry > 0 {
		out += [carry]
	}
	return out
}

func _big_shr1(anon a: [int64]) -> [int64] {
	mut out = a[0..len(a)]
	for i in 0..len(out) {
		mut t = out[i] >> 1
		if i + 1 < len(out) {
			t = t | ((out[i + 1] & 1) << (_LIMB_BITS - 1))
		}
		out[i] = t
	}
	return _big_trim(out)
}

// |x| with `digits` digits after the point (none, and no point, for 0),
// times 10^`scale`, rounded correctly from its exact value, ties to even.
func fixed(anon x: float64, digits: int64, scale: int64 = 0) -> str {
	let d = _scaled(x, digits + scale)
	if digits == 0 {
		return d
	}
	mut padded = d
	for len(padded) <= digits {
		padded = "0" + padded
	}
	let cut = len(padded) - digits
	return padded[0..cut] + "." + padded[cut..len(padded)]
}

// |x| as one digit, then `digits` digits after the point, then `e` and the
// power of ten with its sign and at least two digits: 3.141590e+00.
func exponent(anon x: float64, digits: int64) -> str {
	let bits = kod_f64_bits(x)
	let biased = (bits >> 52) & 2047
	let frac = bits & (_HIDDEN - 1)
	mut k: int64 = 0
	mut d = ""
	if biased == 0 and frac == 0 {
		d = "0"
		for len(d) < digits + 1 {
			d += "0"
		}
	} else {
		mut f = frac
		mut e: int64 = -1074
		if biased > 0 {
			f = frac + _HIDDEN
			e = biased - 1075
		}
		// About log10 of x, then adjusted until the digits number digits + 1.
		k = _floor_div((e + _bit_len(f) - 1) * 78913, 262144)
		for true {
			d = _scaled(x, digits - k)
			if len(d) > digits + 1 {
				k += 1
			} else if len(d) < digits + 1 {
				k -= 1
			} else {
				break
			}
		}
	}
	mut out = d[0..1]
	if digits > 0 {
		out += "." + d[1..len(d)]
	}
	mut sign = "+"
	mut power = k
	if k < 0 {
		sign = "-"
		power = -k
	}
	mut p = str(power)
	if len(p) < 2 {
		p = "0" + p
	}
	return out + "e" + sign + p
}

// The decimal digits of |x| × 10^s rounded to an integer, ties to even, from
// x's exact value f × 2^e.
func _scaled(anon x: float64, anon s: int64) -> str {
	let bits = kod_f64_bits(x)
	let biased = (bits >> 52) & 2047
	let frac = bits & (_HIDDEN - 1)
	if biased == 0 and frac == 0 {
		return "0"
	}
	mut f = frac
	mut e: int64 = -1074
	if biased > 0 {
		f = frac + _HIDDEN
		e = biased - 1075
	}
	mut num = _big(f)
	mut den = _big(1)
	if e >= 0 {
		num = _big_shl(num, e)
	} else {
		den = _big_shl(den, -e)
	}
	if s >= 0 {
		num = _big_mul_pow10(num, s)
	} else {
		den = _big_mul_pow10(den, -s)
	}
	if len(den) == 1 and den[0] == 1 {
		return _big_decimal(num)
	}
	let qr = _big_divmod(num, den)
	mut q = qr[0]
	let c = _big_cmp(_big_shl(qr[1], 1), den)
	if c > 0 or (c == 0 and len(q) > 0 and q[0] % 2 == 1) {
		q = _big_add(q, _big(1))
	}
	return _big_decimal(q)
}

// The quotient and remainder of a ÷ b, for b > 0, by binary long division.
func _big_divmod(anon a: [int64], anon b: [int64]) -> [[int64]] {
	mut q: [int64] = []
	mut r = a
	mut i = _big_bits(a) - _big_bits(b)
	for i >= 0 {
		let shifted = _big_shl(b, i)
		if _big_cmp(r, shifted) >= 0 {
			r = _big_sub(r, shifted)
			q = _big_add(q, _big_shl(_big(1), i))
		}
		i -= 1
	}
	return [q, r]
}

// The decimal text of a nonnegative big number.
func _big_decimal(anon a: [int64]) -> str {
	if len(a) == 0 {
		return "0"
	}
	// Nine digits at a time, least significant first.
	mut chunks: [int64] = []
	mut cur = a
	for len(cur) > 0 {
		mut rem: int64 = 0
		mut q = cur[0..len(cur)]
		mut i = len(q) - 1
		for i >= 0 {
			let t = (rem << _LIMB_BITS) | q[i]
			q[i] = t / 1000000000
			rem = t % 1000000000
			i -= 1
		}
		chunks += [rem]
		cur = _big_trim(q)
	}
	mut out = str(chunks[len(chunks) - 1])
	mut i = len(chunks) - 2
	for i >= 0 {
		mut part = str(chunks[i])
		for len(part) < 9 {
			part = "0" + part
		}
		out += part
		i -= 1
	}
	return out
}
