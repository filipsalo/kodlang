// Interface methods with a body: every implementing type has them.

interface Counter {
    func next(self) -> int64

    // Provided: built on `next` only.
    func sum(self, anon n: int64) -> int64 {
        mut total = 0
        for _ in 0..n {
            total += self.next()
        }
        return total
    }

    // Provided, calling another provided method, with a default.
    func average(self, anon n: int64, scale: int64 = 1) -> int64 {
        return self.sum(n) * scale / n
    }

    func describe(self) -> str {
        if self is Steps(s) {
            return f"steps of {s.by}"
        }
        return label(self)
    }
}

func label(anon c: Counter) -> str {
    return f"counter at {c.next()}"
}

type Steps = shared struct {
    by: int64
    at: int64 = 0

    func next(self) -> int64 {
        self.at += self.by
        return self.at
    }
}

// Overrides `sum`; `average` then uses it through the interface.
type Constant = shared struct {
    value: int64

    func next(self) -> int64 {
        return self.value
    }

    func sum(self, anon n: int64) -> int64 {
        return 1000 + self.value * n
    }
}

type Dice = enum {
    Six
    Twenty

    func next(self) -> int64 {
        match self {
            .Six -> return 6
            .Twenty -> return 20
        }
    }
}

interface Shouty {
    func to_str(self) -> str

    func shout(self) -> str {
        return self.to_str().upper() + "!"
    }
}

func main() -> int64 {
    let s = Steps(by: 2)
    print(s.sum(3))                 // 2 + 4 + 6
    print(s.average(2))             // (8 + 10) / 2
    print(s.describe())

    let c: Counter = Steps(by: 1)
    print(c.sum(4))                 // 1 + 2 + 3 + 4
    print(c.average(2, scale: 10))  // (5 + 6) * 10 / 2

    let k = Constant(value: 3)
    print(k.sum(2))
    let kc: Counter = k
    print(kc.sum(2))
    print(kc.average(2))            // (1000 + 6) / 2
    print(kc.describe())

    print(Dice.Twenty.sum(2))
    let d: Counter = Dice.Six
    print(d.average(3))

    let counters: [Counter] = [Steps(by: 10), Constant(value: 1), Dice.Six]
    for each in counters {
        print(each.sum(2))
    }

    let n = 42
    print(n.shout())
    print("hey".shout())
    let sh: Shouty = true
    print(sh.shout())
    return 0
}

// expected output:
// 12
// 9
// steps of 2
// 10
// 55
// 1006
// 1006
// 503
// counter at 3
// 40
// 6
// 30
// 1002
// 12
// 42!
// HEY!
// TRUE!
// expected status:
// 0
