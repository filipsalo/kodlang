// A `.Variant` in an array `+` chain takes its enum from the chain.
import "./variant_hidden_mid"

func main() -> int64 {
    mut fs = [.Circle(r: 1)] + variant_hidden_mid.list()
    fs += [.Square(side: 2)] + [.Circle(r: 3)]
    fs = [.Circle(r: 4)] + [.Square(side: 5)] + fs
    mut h = variant_hidden_mid.Holder()
    h.fs += [.Circle(r: 6)] + [.Square(side: 7)]
    h.fs = [.Square(side: 8)] + [.Circle(r: 9)] + h.fs
    print_int(variant_hidden_mid.total(fs))
    print_int(variant_hidden_mid.total(h.fs))
    print_int(variant_hidden_mid.total([.Circle(r: 10)] + [.Square(side: 11)]))
    fs = [.Circle(r: 12)]
    print_int(variant_hidden_mid.total(fs))
    let n = variant_hidden_mid.nested()
    let gs = [.Circle(r: 13)] + n[0]
    print_int(variant_hidden_mid.total(gs))
    let nn = [n]
    let hs = [.Circle(r: 15)] + nn[0][0]
    print_int(variant_hidden_mid.total(hs))
    let bags = [variant_hidden_mid.Bag(fss: n)]
    let ks = [.Circle(r: 16)] + bags[0].fss[0]
    print_int(variant_hidden_mid.total(ks))
    let ls = [.Circle(r: 17)] + variant_hidden_mid.nested()[0]
    print_int(variant_hidden_mid.total(ls))
    let ms = [.Circle(r: 18)] + bags[0].all()[0]
    print_int(variant_hidden_mid.total(ms))
    return 0
}

// expected output:
// 16
// 30
// 21
// 12
// 27
// 29
// 30
// 31
// 32
