// The compiler reports `is kb.T` for a `T` only another module declares,
// rather than matching the other module's `T`.
import "./qualified_type_wrong_module_ka"
import "./qualified_type_wrong_module_kb"

func main() -> int64 {
    let err: Error = qualified_type_wrong_module_ka.NotFound(key: "x")
    if err is qualified_type_wrong_module_kb.NotFound {
        return 2
    }
    return 0
}

// expected status:
// 1
// expected stderr:
// 8:8: error: module `qualified_type_wrong_module_kb` has no type `NotFound`
