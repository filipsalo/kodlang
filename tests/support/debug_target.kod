// A program for tests/debug_info_test.kod to debug. The test finds the lines
// it stops at by their text: keep each such line's text unique.

type Counter = struct {
    n: int64

    func bump(mut self, by: int64) -> none {
        self.n += by
    }
}

func triple(anon x: int64) -> int64 {
    let y = x * 3
    return y
}

func main() -> int64 {
    mut c = Counter(n: 1)
    c.bump(by: triple(2))
    print(f"{c.n}")
    print(kinds(2))
    print(f"{pets()}")
    print(shapes(1.5, none, .Circle(radius: 7), .Rect(w: 2, h: "tall")))
    return 0
}

// Values of each kind a debugger is told about, kept until the end.
func kinds(anon n: int64) -> str {
    let count = n + 40
    let flag = count > 10
    let ratio = 2.5
    let name = "kod"
    mut xs = [1, 2, 3]
    xs += [count]
    let words = ["a", "bc"]
    let total = len(xs) + len(words) + len(name)
    print(f"{count} {flag} {ratio} {name} {xs} {words} {total}")
    return name
}

type Pet = struct {
    name: str
    age: int64
    tags: [str]
    owner: Counter
    happy: bool
}

func pets() -> int64 {
    let pet = Pet(name: "Rex", age: 3, tags: ["dog", "good"], owner: Counter(n: 9), happy: true)
    print(f"{pet.name} {pet.age} {pet.tags} {pet.owner.n} {pet.happy}")
    return pet.age
}

type Shape = enum {
    Dot
    Circle(radius: int64)
    Rect(w: int64, h: str)
}

func shapes(anon f: float64?, anon none_yet: int64?, anon s: Shape, anon t: Shape) -> str {
    print(f"{f? or 0.0} {none_yet? or 0} {s is .Dot} {t is .Rect(_, _)}")
    return "shapes"
}
