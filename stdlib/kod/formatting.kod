// The formatter behind `kod fmt`: indentation, spacing and blank lines,
// keeping the lines it is given. The rules are in docs/cli.md#kod-fmt-path.

import "kod/lexing"
import "kod/parsing"
import "sort"

// A file `format` won't touch, and why.
type SyntaxErrors = struct {
    errors: [parsing.ParseError]

    // Each error as the compiler shows it: where and what, the line and a caret.
    func to_str(self) -> str {
        mut out = ""
        for e in self.errors {
            if len(out) > 0 {
                out += "\n"
            }
            out += e.to_str()
            if len(e.source_line) > 0 {
                out += f"\n{e.source_line}\n{e.caret}"
            }
        }
        return out
    }
}

// Formatting `path` gave text that doesn't parse: a bug in the formatter.
type FormatBug = struct {
    path: str
    first: str

    func to_str(self) -> str {
        return f"{self.path}: kod fmt left it as it was: formatting it gave code that doesn't parse ({self.first}); this is a bug in kod fmt"
    }
}

// `source` formatted. `path` names it in errors.
func format(anon source: str, path: str) -> str or Error {
    let tokens = lexing.Lexer(:source, pos: 0, start: 0).lex()
    let p = parsing.make_parser(tokens, :path, :source)
    let _module = p.parse_module()
    if len(p.errors) > 0 {
        throw SyntaxErrors(errors: p.errors)
    }
    let sorted = sort_imports(source, tokens)
    mut formatted = ""
    if sorted == source {
        formatted = layout(source, tokens)
    } else {
        formatted = layout(sorted, lexing.Lexer(source: sorted, pos: 0, start: 0).lex())
    }
    // A bug here must not end up in someone's file: what doesn't parse is refused.
    let again = parsing.make_parser(lexing.Lexer(source: formatted, pos: 0, start: 0).lex(), :path, source: formatted)
    let _again = again.parse_module()
    if len(again.errors) > 0 {
        throw FormatBug(:path, first: again.errors[0].to_str())
    }
    return formatted
}

func is_open(anon k: lexing.TokenKind) -> bool {
    return k is .OpenParen or k is .OpenCurly or k is .OpenBracket
}

func is_close(anon k: lexing.TokenKind) -> bool {
    return k is .CloseParen or k is .CloseCurly or k is .CloseBracket
}

// Whether `k` ends an operand, so a `-` after it is infix, a `(` a call and a
// `[` an index.
func ends_operand(anon k: lexing.TokenKind) -> bool {
    return match k {
        .Identifier | .IntegerLit | .FloatLit | .StringLit | .FStringLit | .BytesLit -> true
        .KwTrue | .KwFalse | .KwNone -> true
        .CloseParen | .CloseBracket | .Question -> true
        else -> false
    }
}

// Whether a space goes between tokens `p` and `c` on a line. `before` is the
// token before `p` (`.EOL` at the start of the line), which tells a prefix `:`
// or `-` from an infix one.
func spaced(anon before: lexing.TokenKind, anon p: lexing.TokenKind, anon c: lexing.TokenKind) -> bool {
    if c is .Comma or c is .CloseParen or c is .CloseBracket {
        return false
    }
    if p is .OpenParen or p is .OpenBracket {
        return false
    }
    if p is .OpenCurly and c is .CloseCurly {
        return false
    }
    if c is .Dot {
        return not ends_operand(p)
    }
    if p is .Dot or p is .DotDot or c is .DotDot or p is .Ellipsis or c is .Ellipsis {
        return false
    }
    if c is .Question {
        return false
    }
    if c is .Colon {
        return p is .Comma
    }
    if p is .Colon {
        // `:name` after `(` or `,` is a shorthand argument.
        return not (before is .OpenParen or before is .Comma)
    }
    if p is .Minus {
        // A prefix, unless it follows an operand.
        return ends_operand(before)
    }
    if c is .OpenParen {
        return not (ends_operand(p) or p is .KwFunc)
    }
    if c is .OpenBracket {
        return not ends_operand(p)
    }
    return true
}

// `n` spaces.
func spaces(anon n: int64) -> str {
    mut out = ""
    for _ in 0..n {
        out += " "
    }
    return out
}

// How many columns the spaces and tabs of `s` take, a tab four.
func width(anon s: str) -> int64 {
    mut w: int64 = 0
    for c in s {
        if c == '\t' {
            w += 4
        } else {
            w += 1
        }
    }
    return w
}

// The leading spaces and tabs of `s`.
func leading_blanks(anon s: str) -> str {
    mut k: int64 = 0
    for k < len(s) and (s[k] == ' ' or s[k] == '\t') {
        k += 1
    }
    return s[0..k]
}

// A string token's text, moved from a line indented `old_indent` to one
// indented `new_indent` columns. A multi-line string's content lines and
// closing `"""` keep their offset from the line: the indent of its closing
// line, which its value is dedented by, becomes that many columns, and each
// content line's copy of it the same, so the value doesn't change.
func moved_string(anon text: str, old_indent: int64, new_indent: int64) -> str {
    let lines = text.split("\n")
    if len(lines) < 2 {
        return text
    }
    let prefix = leading_blanks(lines[len(lines) - 1])
    mut offset = width(prefix) - old_indent
    if offset < 0 {
        offset = 0
    }
    let indent = spaces(new_indent + offset)
    mut out = lines[0]
    for line in lines[1..len(lines)] {
        out += "\n"
        if line == prefix {
            // A content line of nothing but the indent is empty in the value:
            // left empty, with no trailing blanks.
        } else if line.starts_with(prefix) {
            out += indent + line[len(prefix)..len(line)]
        } else {
            out += line
        }
    }
    return out
}

// Whether the bracket at `open` is a comprehension's, which has a `for` of its own.
func is_comprehension(anon tokens: [lexing.Token], anon open: int64) -> bool {
    mut depth: int64 = 0
    for m in open..len(tokens) {
        let kind = tokens[m].kind
        if kind is .OpenParen or kind is .OpenBracket or kind is .OpenCurly {
            depth += 1
        } else if is_close(kind) {
            depth -= 1
            if depth == 0 {
                return false
            }
        } else if kind is .KwFor and depth == 1 {
            return tokens[open].kind is .OpenBracket
        }
    }
    return false
}

// Whether the bracket at `tokens[at]` opens a list that may end in a comma:
// the arguments of a call, the parameters of a `func`, or an array literal.
// A `(` that groups and a `[` that indexes don't.
func opens_list(anon tokens: [lexing.Token], anon at: int64) -> bool {
    let kind = tokens[at].kind
    // The token before, across line ends and comments.
    mut b = at - 1
    for b >= 0 and (tokens[b].kind is .EOL or tokens[b].kind is .Comment) {
        b -= 1
    }
    mut prev: lexing.TokenKind = .EOL
    if b >= 0 {
        prev = tokens[b].kind
    }
    if kind is .OpenParen {
        return ends_operand(prev) or prev is .KwFunc
    }
    if kind is .OpenBracket {
        return not ends_operand(prev)
    }
    return false
}

// `tokens` of `source` laid out by the rules: the tokens of each line,
// reindented and respaced, and the blank lines between.
func layout(anon source: str, anon tokens: [lexing.Token]) -> str {
    mut out = ""
    // For each bracket still open: the line it was opened on, its token, and
    // whether it opens a list. Each line's level.
    mut opened: [int64] = []
    mut opened_at: [int64] = []
    mut opened_list: [bool] = []
    mut levels: [int64] = []
    mut line_no: int64 = 0
    mut blank_run: int64 = 0
    mut wrote_any = false
    // The last line written: whether it was at the top level and started by
    // closing a bracket, which ends a declaration of several lines.
    mut after_block = false
    // The last token written that isn't a comment, and where `out` was just
    // after it: where a list's comma goes.
    mut last_code: int64 = -1
    mut last_code_end: int64 = 0
    // Where the current line starts in `source`.
    mut line_start: int64 = 0
    let n = len(tokens)
    mut i: int64 = 0
    for i < n {
        // The line's tokens are i..j, then its EOL, if any.
        mut j = i
        for j < n and not (tokens[j].kind is .EOL) and not (tokens[j].kind is .EOF) {
            j += 1
        }
        if j == i {
            if wrote_any {
                blank_run += 1
            }
        } else {
            // A list closed by the bracket that starts this line, its last item
            // on an earlier line, ends with a comma.
            let first = tokens[i].kind
            if (first is .CloseParen or first is .CloseBracket) and len(opened) > 0 {
                let top = len(opened) - 1
                if opened_list[top] and opened[top] < line_no and last_code > opened_at[top] and not (tokens[last_code].kind is .Comma) {
                    out = out[0..last_code_end] + "," + out[last_code_end..len(out)]
                }
            }
            // A line that starts by closing brackets is at the level of the line
            // that opened the last of them; any other one deeper than the line
            // of the innermost open bracket.
            mut k = i
            mut closed_line: int64 = -1
            for k < j and is_close(tokens[k].kind) {
                if len(opened) > 0 {
                    let top = len(opened) - 1
                    closed_line = opened[top]
                    opened = opened[0..top]
                    opened_at = opened_at[0..top]
                    opened_list = opened_list[0..top]
                }
                k += 1
            }
            mut level: int64 = 0
            if closed_line >= 0 {
                level = levels[closed_line]
            } else if len(opened) > 0 {
                level = levels[opened[len(opened) - 1]] + 1
            }
            for len(levels) <= line_no {
                levels += [0]
            }
            levels[line_no] = level
            for m in k..j {
                if is_open(tokens[m].kind) {
                    opened += [line_no]
                    opened_at += [m]
                    opened_list += [opens_list(tokens, m) and not is_comprehension(tokens, m)]
                } else if is_close(tokens[m].kind) and len(opened) > 0 {
                    let top = len(opened) - 1
                    opened = opened[0..top]
                    opened_at = opened_at[0..top]
                    opened_list = opened_list[0..top]
                }
            }
            let old_indent = width(source[line_start..tokens[i].start])
            let new_indent = level * 4
            let closes = is_close(first)
            if blank_run > 0 and not closes {
                out += "\n"
            } else if blank_run == 0 and after_block and level == 0 and not closes {
                // A declaration after one of several lines, or the comments above it.
                out += "\n"
            }
            blank_run = 0
            after_block = level == 0 and closes
            out += spaces(new_indent)
            // `{` opened on this line and not closed yet.
            mut braces: int64 = 0
            for m in i..j {
                let tok = tokens[m]
                if m > i {
                    let prev = tokens[m - 1]
                    mut before: lexing.TokenKind = .EOL
                    if m - 2 >= i {
                        before = tokens[m - 2].kind
                    }
                    if tok.kind is .Comment {
                        // An end-of-line comment keeps the gap before it.
                        out += source[prev.end..tok.start]
                    } else if spaced(before, prev.kind, tok.kind) {
                        if braces > 0 and tok.start - prev.end >= 2 {
                            out += "  "
                        } else {
                            out += " "
                        }
                    }
                }
                out += moved_string(source[tok.start..tok.end], :old_indent, :new_indent)
                if not (tok.kind is .Comment) {
                    last_code = m
                    last_code_end = len(out)
                }
                if tok.kind is .OpenCurly {
                    braces += 1
                } else if tok.kind is .CloseCurly and braces > 0 {
                    braces -= 1
                }
            }
            out += "\n"
            wrote_any = true
        }
        line_no += 1
        if j >= n or tokens[j].kind is .EOF {
            break
        }
        line_start = tokens[j].end
        i = j + 1
    }
    return out
}

// A line of the source as tokens see it: a multi-line string is inside one.
type SourceLine = struct {
    // Where it starts and ends in the source, its newline not included.
    start: int64
    end: int64
    // Its first token, or EOL when it has none; whether every token is a
    // comment; and whether no bracket is open at its start.
    first: lexing.TokenKind
    comments_only: bool
    top: bool
    // For an import, its path.
    path: str
}

// The lines of `source`, by its tokens.
func source_lines(anon source: str, anon tokens: [lexing.Token]) -> [SourceLine] {
    mut lines: [SourceLine] = []
    mut depth: int64 = 0
    mut line_start: int64 = 0
    let n = len(tokens)
    mut i: int64 = 0
    for i < n {
        mut j = i
        for j < n and not (tokens[j].kind is .EOL) and not (tokens[j].kind is .EOF) {
            j += 1
        }
        mut end = len(source)
        if j < n {
            end = tokens[j].start
        }
        mut first: lexing.TokenKind = .EOL
        mut comments_only = j > i
        mut path = ""
        if j > i {
            first = tokens[i].kind
            if first is .KwImport and i + 1 < j and tokens[i + 1].kind is .StringLit {
                let lit = tokens[i + 1].value
                path = lit[1..len(lit) - 1]
            }
        }
        let top = depth == 0
        for m in i..j {
            if not (tokens[m].kind is .Comment) {
                comments_only = false
            }
            if is_open(tokens[m].kind) {
                depth += 1
            } else if is_close(tokens[m].kind) and depth > 0 {
                depth -= 1
            }
        }
        lines += [SourceLine(start: line_start, :end, :first, :comments_only, :top, :path)]
        if j >= n or tokens[j].kind is .EOF {
            break
        }
        line_start = tokens[j].end
        i = j + 1
    }
    return lines
}

// Whether import path `a` goes before `b`: the standard library's first,
// then those starting with `./`, each by path.
func import_before(anon a: str, anon b: str) -> bool {
    let a_rel = a.starts_with("./")
    let b_rel = b.starts_with("./")
    if a_rel != b_rel {
        return b_rel
    }
    return a < b
}

// An import line with the comment lines just above it that move with it.
type ImportUnit = struct {
    path: str
    text: str
}

// `source` with each group of top-level import lines sorted (docs/cli.md).
func sort_imports(anon source: str, anon tokens: [lexing.Token]) -> str {
    let lines = source_lines(source, tokens)
    mut out = ""
    // Where `out` has copied `source` up to.
    mut copied: int64 = 0
    mut k: int64 = 0
    let n = len(lines)
    for k < n {
        let line = lines[k]
        if not (line.top and line.first is .KwImport) {
            k += 1
            continue
        }
        // A group: imports, and comment lines between them, with no blank line.
        mut units: [ImportUnit] = []
        mut pending: [str] = []
        let group_start = line.start
        mut group_end = line.end
        mut m = k
        for m < n and lines[m].top and (lines[m].first is .KwImport or lines[m].comments_only) {
            let l = lines[m]
            let text = source[l.start..l.end]
            if l.first is .KwImport {
                mut unit_text = ""
                for c in pending {
                    unit_text += c + "\n"
                }
                units += [ImportUnit(path: l.path, text: unit_text + text)]
                pending = []
                group_end = l.end
            } else {
                pending += [text]
            }
            m += 1
        }
        // Comment lines after the last import stay after the group.
        let sorted = sort.sorted_by(units, less: func(a: ImportUnit, b: ImportUnit) -> bool {
            return import_before(a.path, b.path)
        })
        mut text = ""
        for u in sorted {
            if len(text) > 0 {
                text += "\n"
            }
            text += u.text
        }
        out += source[copied..group_start] + text
        copied = group_end
        k = m
    }
    return out + source[copied..len(source)]
}
