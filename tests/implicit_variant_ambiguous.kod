import "./implicit_variant_ambiguous_dep"

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
}

func area(anon s: Shape) -> int64 {
    match s {
        .Circle(r) -> return 3 * r * r
        .Rect(w, h) -> return w * h
    }
}

func main() -> int64 {
    let u = .Circle(r: 2)
    let v: Shape = .Circle(r: 2)
    return area(u) + area(v)
}

