// `A | B`: values go in where a union is declared, and `match` / `is` take them out.
type Id = int64 | str
type Point = shared struct {
    x: int64
}
type Color = enum {
    Red
    Green
}
interface Named {
    func name(self) -> str
}
type Dog = shared struct {
    func name(self) -> str {
        return "dog"
    }
}

type Holder = shared struct {
    id: Id
    many: [int64 | str] = []
}

func show(anon id: Id) -> str {
    match id {
        int64(n) -> return f"#{n}"
        str(s) -> return s
    }
}

func make(anon n: int64) -> str | int64 {
    if n == 0 {
        return "zero"
    }
    return n
}

func fallible(anon n: int64) -> int64 | str or Error {
    if n == 0 {
        return "zero"
    }
    return n
}

type Ints = [int64]

func wide(anon v: Point | Color | Ints | Named | float64 | bool) -> str {
    return match v {
        Point(p) -> f"point {p.x}"
        Color(c) -> match c {
            .Red -> "red"
            .Green -> "green"
        }
        Ints(xs) -> f"array of {len(xs)}"
        Named(n) -> n.name()
        float64 -> "float"
        bool(b) -> f"bool {b}"
    }
}

func with_default(id: Id = "fallback") -> str {
    return show(id)
}

func same[T](anon x: T) -> T {
    return x
}

test "values go in where a union is declared" {
    // Order doesn't matter: this is the type `show` takes.
    let flipped: str | int64 = 7
    assert show(flipped) == "#7"
    assert show(make(0)) == "zero"
    assert show(make(3)) == "#3"
    assert show(must fallible(0)) == "zero"
    assert with_default() == "fallback"
    assert with_default(id: 5) == "#5"
}

test "reassigning and storing convert too" {
    mut id: Id = 1
    id = "two"
    assert show(id) == "two"
    let h = Holder(id: 9, many: [1, "b"])
    assert show(h.id) == "#9"
    h.id = "field"
    assert show(h.id) == "field"
    mut shown: [str] = []
    for v in h.many {
        shown += [show(v)]
    }
    assert shown == ["#1", "b"]
    mut grown: [Id] = []
    grown += [4]
    grown += ["five"]
    assert len(grown) == 2
    assert show(grown[1]) == "five"

    mut m = Map[str, Id]()
    m.set("a", 1)
    m.set("b", "bee")
    assert show(m.get("b")? or 0) == "bee"
}

test "every kind of member" {
    assert wide(Point(x: 2)) == "point 2"
    assert wide(.Green) == "green"
    assert wide([1, 2, 3]) == "array of 3"
    assert wide([]) == "array of 0"
    assert wide(Dog()) == "dog"
    assert wide(1.5) == "float"
    assert wide(true) == "bool true"
}

test "is, with and without a binding, negated, and chained" {
    mut id: Id = 1
    id = "two"
    if id is str(s) {
        assert s == "two"
    } else {
        fail("not a str")
    }
    if id is int64 {
        fail("not reached")
    }
    assert id is not int64
    let holds_str = id is str
    assert holds_str
    mut three = false
    if id is str(s) and len(s) == 3 {
        three = true
    }
    assert three
}

test "guards, alternatives and match expressions" {
    let picked: Id = 12
    let first = match picked {
        int64(n) if n > 100 -> "big"
        int64(n) -> f"{n}"
        str -> "text"
    }
    assert first == "12"
    let second = match picked {
        int64 | str -> "either"
    }
    assert second == "either"
    let answer: Id = match picked {
        int64 -> "was an int"
        str(s) -> s.char_count()
    }
    assert show(answer) == "was an int"
}

test "a union is passed through generics and closures like any value" {
    mut id: Id = 1
    id = "two"
    let frozen = id
    let f = func() -> str {
        return show(frozen)
    }
    assert f() == "two"
    assert show(same(id)) == "two"
}

test "a union with none is optional" {
    // `T | none` is `T?`, and a union with `none` is optional.
    let o: int64 | none = none
    let plain: int64? = o
    let unwrapped = plain? or 8
    assert unwrapped == 8
    let maybe: int64 | str | none = "here"
    match maybe {
        Some(int64(n)) -> fail(f"int {n}")
        Some(str(s)) -> assert s == "here"
        none -> fail("nothing")
    }
    let nothing: Id? = none
    assert nothing is none
    let one: Id | none = 5
    assert show(one? or "other") == "#5"
}

test "nested unions flatten into one" {
    let nested: Id | bool = true
    let flat: bool | str | int64 = nested
    if flat is bool(b) {
        assert b
    } else {
        fail("not a bool")
    }
}
