// The interpreter checks a constructor's `m.T` before main runs.
import "./qualified_type_wrong_module_kb"

func make() -> int64 {
    let nf = qualified_type_wrong_module_kb.NotFound(key: "k")
    return 0
}

func main() -> int64 {
    print("ran")
    return 0
}

