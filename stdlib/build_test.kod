// kod/build: the naming rules (docs/modules.md, "Symbol and object
// names"), the symbol prefix a path gets and the object file a module is
// written to, and the reader of the link configuration (docs/self-hosting.md,
// "The link configuration"). Run from the repository root, since the twin
// check looks for `stdlib/<path>.kod` there and the configuration is read
// from `link.cfg`.
import "fs"
import "io"
import "process"
import "kod/build"
import "kod/test_support"

func expect_prefix(anon path: str, want: str) -> none {
    let got: str = build.path_to_prefix(path)
    if got != want {
        fail(f"path_to_prefix({path}) is {got}, want {want}")
    }
}

func expect_obj(anon root: str, source: str, want: str) -> none {
    let got: str = build.obj_path(:root, :source)
    if got != want {
        fail(f"obj_path({root}, {source}) is {got}, want {want}")
    }
}

test "an ordinary path keeps the symbols it always had" {
    expect_prefix("tests/hello.kod", want: "tests$hello")
    expect_prefix("stdlib/io.kod", want: "io")
    expect_prefix("stdlib/kod/ast.kod", want: "kod$ast")
    expect_prefix("stdlib/primitives/int64.kod", want: "primitives$int64")
    expect_prefix("kodc.kod", want: "kodc")
    expect_prefix("tools/kod.kod", want: "tools$kod")
    expect_prefix("a/b_2.kod", want: "a$b_2")
    expect_prefix("tests/foo.bar.kod", want: "tests$foo.bar")
    expect_prefix("/tmp/foo.kod", want: "tmp$foo")
}

test "a byte that is no symbol character is escaped to $$ and two hex digits" {
    expect_prefix("my-app.kod", want: "my$$2dapp")
    expect_prefix("tests/with space.kod", want: "tests$with$$20space")
    expect_prefix("a/p$q.kod", want: "a$p$$24q")
    expect_prefix("a/b+c@d.kod", want: "a$b$$2bc$$40d")
    expect_prefix("café.kod", want: "caf$$c3$$a9")
}

test "a leading dot is escaped, and the prefix then gets a dot in front" {
    expect_prefix("-x.kod", want: ".$$2dx")
    expect_prefix(".-x.kod", want: ".$$2e$$2dx")
    expect_prefix(".hidden.kod", want: ".$$2ehidden")
    expect_prefix("a/.b.kod", want: "a$.b")
    expect_prefix(".kod", want: ".")
}

test "a prefix that would start with a digit gets a dot in front" {
    expect_prefix("01_hello.kod", want: ".01_hello")
    expect_prefix("2024/report.kod", want: ".2024$report")
    expect_prefix("3d.kod", want: ".3d")
    expect_prefix("tests/3d.kod", want: "tests$3d")
    expect_prefix("a/2024/report.kod", want: "a$2024$report")
}

test "an e or E after the leading digits of a prefix is escaped, which the assembler would read as a number" {
    expect_prefix("1e5.kod", want: ".1$$655")
    expect_prefix("0example.kod", want: ".0$$65xample")
    expect_prefix("2East/lib.kod", want: ".2$$45ast$lib")
    expect_prefix("12E.kod", want: ".12$$45")
    expect_prefix("1e5_test.kod", want: ".1$$655_test")
    // Not a number to the assembler, so nothing more is escaped.
    expect_prefix("1x5e.kod", want: ".1x5e")
    expect_prefix("1.5e3.kod", want: ".1.5e3")
    expect_prefix("a/1e5.kod", want: "a$1e5")
    expect_prefix("e5.kod", want: "e5")
    expect_prefix("-1e5.kod", want: ".$$2d1e5")
}

test "mangle_path is the whole rule without the twin marker" {
    if build.mangle_path("3d") != ".3d" {
        fail("mangle_path(3d) is " + build.mangle_path("3d"))
    }
    if build.mangle_path("1e5") != ".1$$655" {
        fail("mangle_path(1e5) is " + build.mangle_path("1e5"))
    }
    if build.mangle_path("-x/y") != ".$$2dx$y" {
        fail("mangle_path(-x/y) is " + build.mangle_path("-x/y"))
    }
    if build.mangle_path("") != "." {
        fail("mangle_path() is " + build.mangle_path(""))
    }
    if build.mangle_path("a/b") != "a$b" {
        fail("mangle_path(a/b) is " + build.mangle_path("a/b"))
    }
}

test "a project module named like a stdlib module is in the .user$ namespace" {
    expect_prefix("io.kod", want: ".user$io")
    expect_prefix("kod/ast.kod", want: ".user$kod$ast")
    expect_prefix("json.kod", want: ".user$json")
    expect_prefix("tests/io.kod", want: "tests$io")
    expect_prefix("stdlib/io.kod", want: "io")
    expect_prefix("lib/json.kod", want: "lib$json")
}

test "an import resolves to the prefix of the module it names" {
    let local: build.Resolved = build.resolve_import(target_path: "main.kod", module_name: "./io")
    assert local.file == "io.kod"
    expect_prefix(local.file, want: ".user$io")
    assert local.prefix == ".user$io"
    let std: build.Resolved = build.resolve_import(target_path: "main.kod", module_name: "io")
    assert std.file == "stdlib/io.kod"
    assert std.prefix == "io"
    let nested: build.Resolved = build.resolve_import(target_path: "tests/main.kod", module_name: "./io")
    assert nested.file == "tests/io.kod"
    assert nested.prefix == "tests$io"
    let spelled: build.Resolved = build.resolve_import(target_path: "main.kod", module_name: "./lib/../io")
    assert spelled.prefix == ".user$io"
}

test "paths that differ in a byte the symbol would lose get different prefixes" {
    let pairs: [str] = ["-x", ".-x", "p$q", "p/q", "a-b", "a/-b", "01_x", ".01_x", "io", "stdlib/io", ".user/io", "x/stdlib/io", "a b", "a$$20b", "a.b", "a/.b", ".user", "user"]
    for x in pairs {
        for y in pairs {
            // `io` and `stdlib/io` are the same module on purpose.
            let same_module: bool = (x == "io" and y == "stdlib/io") or (x == "stdlib/io" and y == "io")
            let a: str = build.path_to_prefix(x + ".kod")
            if x != y and not same_module and a == build.path_to_prefix(y + ".kod") {
                fail(f"{x} and {y} share the prefix {a}")
            }
        }
    }
}

// Every string of up to `max_len` bytes over `alphabet`.
func strings_over(alphabet: [str], max_len: int64) -> [str] {
    mut all: [str] = []
    mut level: [str] = [""]
    mut n: int64 = 0
    for n < max_len {
        mut next: [str] = []
        for s in level {
            for c in alphabet {
                next += [s + c]
            }
        }
        for s in next {
            all += [s]
        }
        level = next
        n = n + 1
    }
    return all
}

func is_symbol_char(anon c: int64) -> bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '.' or c == '$'
}

// Does the prefix start with `.`, digits and an `e` or `E`, which the
// assembler takes for a number?
func starts_like_a_number(anon prefix: str) -> bool {
    if len(prefix) == 0 or prefix[0] != '.' {
        return false
    }
    mut k: int64 = 1
    for k < len(prefix) and prefix[k] >= '0' and prefix[k] <= '9' {
        k = k + 1
    }
    return k > 1 and k < len(prefix) and (prefix[k] == 'e' or prefix[k] == 'E')
}

test "every short path gets a prefix the assembler takes, and no two share one" {
    let alphabet: [str] = ["a", "2", "e", "E", "-", ".", "/", "$", " "]
    let seen: Map[str, str] = Map[str, str]()
    mut checked: int64 = 0
    for s in strings_over(:alphabet, max_len: 4) {
        // An absolute path and the relative one share a prefix (documented),
        // and `//` is not a normalized path.
        if s[0] == '/' or s.contains("//") {
            continue
        }
        let path: str = s + ".kod"
        let prefix: str = build.path_to_prefix(path)
        if len(prefix) == 0 {
            fail(f"{path} has an empty prefix")
        }
        if prefix[0] == '$' or (prefix[0] >= '0' and prefix[0] <= '9') {
            fail(f"{path} has the prefix {prefix}, which starts with $ or a digit")
        }
        if starts_like_a_number(prefix) {
            fail(f"{path} has the prefix {prefix}, which the assembler reads as a number")
        }
        mut k: int64 = 0
        for k < len(prefix) {
            if not is_symbol_char(prefix[k]) {
                fail(f"{path} has the prefix {prefix}, which holds a byte the assembler rejects")
            }
            k = k + 1
        }
        if seen.contains(prefix) {
            let other: str = seen[prefix]? or ""
            fail(f"{path} and {other} share the prefix {prefix}")
        }
        seen.set(prefix, path)
        checked = checked + 1
    }
    assert checked > 2000
}

test "an object is named after its source path in a tree" {
    let root: str = "build/apps/hello/hello.obj"
    expect_obj(root, source: "tests/hello.kod", want: "build/apps/hello/hello.obj/tests/hello.kod.o")
    expect_obj(root, source: "stdlib/json.kod", want: "build/apps/hello/hello.obj/stdlib/json.kod.o")
    expect_obj(root, source: "lib/json.kod", want: "build/apps/hello/hello.obj/lib/json.kod.o")
    expect_obj(root, source: "json.kod", want: "build/apps/hello/hello.obj/json.kod.o")
}

test "the .. of a path, the root of an absolute path and a % are written %xx" {
    let root: str = "build/apps/hello/hello.obj"
    expect_obj(root, source: "../d/x.kod", want: "build/apps/hello/hello.obj/%2e%2e/d/x.kod.o")
    expect_obj(root, source: "/tmp/x.kod", want: "build/apps/hello/hello.obj/%2f/tmp/x.kod.o")
    expect_obj(root, source: "a/50%.kod", want: "build/apps/hello/hello.obj/a/50%25.kod.o")
    expect_obj(root, source: "a/%2e%2e/x.kod", want: "build/apps/hello/hello.obj/a/%252e%252e/x.kod.o")
}

test "a stem of obj gets a tree that is not its executable" {
    expect_obj("build/apps/obj/obj.obj", source: "obj.kod", want: "build/apps/obj/obj.obj/obj.kod.o")
}

test "objects of equally named modules are different files" {
    let root: str = "build/apps/util/util.obj"
    assert build.obj_path(:root, source: "x/util.kod") != build.obj_path(:root, source: "y/util.kod")
    assert build.obj_path(:root, source: "json.kod") != build.obj_path(:root, source: "stdlib/json.kod")
    assert build.obj_path(:root, source: "a.kod") != build.obj_path(:root, source: "/a.kod")
}

// The file name of `path` without `.kod`: the name of the program built
// from it.
func stem_of(anon path: str) -> str {
    mut start: int64 = 0
    mut i: int64 = 0
    for i < len(path) {
        if path[i] == '/' {
            start = i + 1
        }
        i = i + 1
    }
    return path[start..len(path)-4]
}

// Build the files as a program with the native driver and check what it
// prints. The program's directory under `build/apps` is removed again
// unless it was there before.
func expect_program_prints(anon files: fs.MemFs, entry: str, want: str) -> none {
    let app_dir: str = f"build/apps/{stem_of(entry)}"
    let existed: process.ProcessResult = process.run(["test", "-e", app_dir])
    let r: process.ProcessResult = test_support.build_and_run_files(:files, :entry)
    if existed.status != 0 {
        process.run(["rm", "-rf", app_dir])
    }
    if r.status != 0 {
        fail(f"{entry} exited {r.status}: {r.stderr}")
    }
    if r.stdout != want {
        fail(f"{entry} printed {r.stdout}, want {want}")
    }
}

test "a project json.kod and the stdlib json link into one program" {
    let files: fs.MemFs = fs.mem_fs()
    files.add("main.kod", """
import "./json"
import "./reports"

func main() -> int64 {
    print(json.name())
    print(reports.render())
    return 0
}
""")
    files.add("json.kod", """
func name() -> str {
    return "local json"
}
""")
    files.add("reports.kod", """
import "json"

func render() -> str {
    return (must json.parse("[1, 2]")).emit()
}
""")
    expect_program_prints(files, entry: "main.kod", want: "local json\n[1,2]\n")
}

test "equally named modules in different directories link" {
    let files: fs.MemFs = fs.mem_fs()
    files.add("main.kod", """
import "./a"
import "./b"

func main() -> int64 {
    print(a.name())
    print(b.name())
    return 0
}
""")
    files.add("a.kod", """
import "./x/util"

func name() -> str {
    return util.name()
}
""")
    files.add("b.kod", """
import "./y/util"

func name() -> str {
    return util.name()
}
""")
    files.add("x/util.kod", """
func name() -> str {
    return "x util"
}
""")
    files.add("y/util.kod", """
func name() -> str {
    return "y util"
}
""")
    expect_program_prints(files, entry: "main.kod", want: "x util\ny util\n")
}

test "an entry whose path has a dash and a space builds and runs" {
    let files: fs.MemFs = fs.mem_fs()
    files.add("my-app/with space.kod", """
func main() -> int64 {
    print("spaced")
    return 0
}
""")
    expect_program_prints(files, entry: "my-app/with space.kod", want: "spaced\n")
}

// The link configuration. Make reads link.cfg too (`include`), so the reader
// accepts exactly the lines whose words Make and the driver read alike.

func parse_cfg(anon text: str) -> build.LinkVars {
    let vars: build.LinkVars = build.LinkVars(items: [])
    let error: str = build.parse_link_config(text, path: "link.cfg", into: vars, overrides: false)
    if len(error) > 0 {
        fail(f"parse_link_config rejected the text: {error}")
    }
    return vars
}

func cfg_error(anon text: str) -> str {
    let vars: build.LinkVars = build.LinkVars(items: [])
    return build.parse_link_config(text, path: "link.cfg", into: vars, overrides: false)
}

// `text` is rejected at `line` with a message that mentions `mentions`.
func expect_cfg_error(anon text: str, line: int64, mentions: str) -> none {
    let error: str = cfg_error(text)
    if not build.starts_with(error, prefix: f"link.cfg:{line}:") {
        fail(f"the error for {text} is {error}, want it at line {line}")
    }
    if not error.contains(": error: ") or not error.contains(mentions) {
        fail(f"the error for {text} is {error}, want it to mention {mentions}")
    }
}

func expect_words(anon vars: build.LinkVars, name: str, want: [str]) -> none {
    let got: [str] = build.split_words(build.link_value(vars, :name))
    if len(got) != len(want) {
        fail(f"{name} has {len(got)} words, want {len(want)}")
    }
    mut i: int64 = 0
    for i < len(want) {
        if got[i] != want[i] {
            fail(f"word {i} of {name} is {got[i]}, want {want[i]}")
        }
        i = i + 1
    }
}

test "a link configuration is NAME := words lines, comments and empty lines" {
    let vars: build.LinkVars = parse_cfg("""
# how programs are linked
LINK := clang -target arm64-apple-darwin -Wl,-dead_strip

# C
CC := clang
CFLAGS := -target arm64-apple-darwin -I stdlib -DKOD=1
OPENSSL := /opt/homebrew/opt/openssl@3
""")
    expect_words(vars, name: "LINK", want: ["clang", "-target", "arm64-apple-darwin", "-Wl,-dead_strip"])
    expect_words(vars, name: "CC", want: ["clang"])
    expect_words(vars, name: "CFLAGS", want: ["-target", "arm64-apple-darwin", "-I", "stdlib", "-DKOD=1"])
    expect_words(vars, name: "OPENSSL", want: ["/opt/homebrew/opt/openssl@3"])
    assert build.link_value(vars, name: "LINK") == "clang -target arm64-apple-darwin -Wl,-dead_strip"
    assert build.link_value(vars, name: "NOPE") == ""
    assert build.link_has(vars, name: "CC")
    assert not build.link_has(vars, name: "NOPE")
    assert len(vars.items) == 4
}

test "an empty value is a value, and a name that is not set is not" {
    let vars: build.LinkVars = parse_cfg("EMPTY :=\nSET := a\n")
    assert build.link_has(vars, name: "EMPTY")
    assert build.link_value(vars, name: "EMPTY") == ""
    assert len(build.split_words(build.link_value(vars, name: "EMPTY"))) == 0
    assert not build.link_has(vars, name: "NEVER")
}

test "the last line needs no newline, and an empty text sets nothing" {
    let vars: build.LinkVars = parse_cfg("A := 1\nB := 2")
    assert build.link_value(vars, name: "B") == "2"
    assert len(parse_cfg("").items) == 0
    assert len(parse_cfg("\n\n# only a comment\n").items) == 0
    assert len(parse_cfg("#").items) == 0
}

test "a repeated word is kept as written" {
    let vars: build.LinkVars = parse_cfg("LIBS := -lz -lz -lssl -lz\n")
    expect_words(vars, name: "LIBS", want: ["-lz", "-lz", "-lssl", "-lz"])
}

test "a comment may hold anything the grammar forbids in a line" {
    // The lines are comments to Make as well, whatever follows the #.
    parse_cfg("# NAME = $(shell x) \"quoted\" 'q' \\ # again: := é\n")
    parse_cfg("#NAME := a  b \n")
    parse_cfg("# a comment with a trailing space \n")
}

test "a second file sets names again and overrides what the first set" {
    let vars: build.LinkVars = build.LinkVars(items: [])
    let first: str = build.parse_link_config("LINK := clang\nCC := clang\n", path: "link.cfg", into: vars, overrides: false)
    assert first == ""
    let second: str = build.parse_link_config("# this machine\nLINK := /usr/bin/clang -v\nCC := /usr/bin/clang\n", path: "link.local.cfg", into: vars, overrides: true)
    assert second == ""
    assert build.link_value(vars, name: "LINK") == "/usr/bin/clang -v"
    assert build.link_value(vars, name: "CC") == "/usr/bin/clang"
    assert len(vars.items) == 2
}

test "a second file only overrides: a name the first did not set is an error" {
    let vars: build.LinkVars = build.LinkVars(items: [])
    assert build.parse_link_config("LINK := clang\nCC := clang\n", path: "link.cfg", into: vars, overrides: false) == ""
    // A typo, a name of Make's own, a name nothing reads.
    for name in ["LNK", "CFLAG", "STAGE0", "SHELL", "MAKEFLAGS", "OPENSSL"] {
        let error: str = build.parse_link_config(f"# machine\nLINK := clang -v\n{name} := x\n", path: "link.local.cfg", into: vars, overrides: true)
        assert build.starts_with(error, prefix: "link.local.cfg:3:1: error: ")
        assert error.contains(f"{name} is not set in link.cfg")
    }
    // What came before the error was read; the first file may set any name.
    assert build.link_value(vars, name: "LINK") == "clang -v"
    let again: build.LinkVars = build.LinkVars(items: [])
    assert build.parse_link_config("OPENSSL := /x\nSTAGE0 := y\n", path: "link.cfg", into: again, overrides: false) == ""
    assert len(again.items) == 2
}

test "a name set twice in one file is an error at the second" {
    expect_cfg_error("LINK := a\nCC := b\nLINK := c\n", line: 3, mentions: "LINK is set twice")
    expect_cfg_error("A :=\nA :=\n", line: 2, mentions: "twice")
    // The error names the file it came from.
    let vars: build.LinkVars = build.LinkVars(items: [])
    let error: str = build.parse_link_config("X := 1\nX := 2\n", path: "link.local.cfg", into: vars, overrides: false)
    assert build.starts_with(error, prefix: "link.local.cfg:2:1: error: ")
}

test "a line is reported at its line number, empty lines and comments counted" {
    expect_cfg_error("# one\n\nLINK := a\nbad line\n", line: 4, mentions: ":=")
    expect_cfg_error("\n\n\n\nlink := a\n", line: 5, mentions: "name")
}

test "a line that does not fit NAME := words is an error" {
    // A name is capital letters, digits and _, starting with a letter.
    expect_cfg_error("link := a\n", line: 1, mentions: "name")
    expect_cfg_error("Link := a\n", line: 1, mentions: "name")
    expect_cfg_error("1X := a\n", line: 1, mentions: "name")
    expect_cfg_error("_X := a\n", line: 1, mentions: "name")
    expect_cfg_error(" X := a\n", line: 1, mentions: "name")
    expect_cfg_error(":= a\n", line: 1, mentions: "name")
    expect_cfg_error("X-Y := a\n", line: 1, mentions: ":=")
    // `:=` follows the name after one space.
    expect_cfg_error("X\n", line: 1, mentions: ":=")
    expect_cfg_error("X a\n", line: 1, mentions: ":=")
    expect_cfg_error("X = a\n", line: 1, mentions: ":=")
    expect_cfg_error("X: a\n", line: 1, mentions: ":=")
    expect_cfg_error("X:= a\n", line: 1, mentions: ":=")
    expect_cfg_error("X  := a\n", line: 1, mentions: ":=")
    expect_cfg_error("X ?= a\n", line: 1, mentions: ":=")
    expect_cfg_error("X += a\n", line: 1, mentions: ":=")
    expect_cfg_error("X ::= a\n", line: 1, mentions: ":=")
    expect_cfg_error("X =: a\n", line: 1, mentions: ":=")
    // A space follows `:=`, unless the value is empty.
    expect_cfg_error("X :=a\n", line: 1, mentions: "space")
}

test "words are separated by one space, with none at the end" {
    expect_cfg_error("X := a  b\n", line: 1, mentions: "one space")
    expect_cfg_error("X := a \n", line: 1, mentions: "one space")
    expect_cfg_error("X := \n", line: 1, mentions: "one space")
    expect_cfg_error("X :=  a\n", line: 1, mentions: "one space")
    expect_cfg_error("X :=   \n", line: 1, mentions: "one space")
}

test "a tab or a carriage return is an error anywhere, a CRLF file included" {
    expect_cfg_error("\tX := a\n", line: 1, mentions: "tab")
    expect_cfg_error("X :=\ta\n", line: 1, mentions: "tab")
    expect_cfg_error("X := a\t\n", line: 1, mentions: "tab")
    expect_cfg_error("# a\tcomment\n", line: 1, mentions: "tab")
    expect_cfg_error("X := a\r\nY := b\r\n", line: 1, mentions: "carriage return")
    expect_cfg_error("# a comment\r\n", line: 1, mentions: "carriage return")
    expect_cfg_error("A := 1\n\r\n", line: 2, mentions: "carriage return")
    expect_cfg_error("X :=\r\n", line: 1, mentions: "carriage return")
}

test "a # is a comment only at the start of a line" {
    expect_cfg_error("X := a # not a comment\n", line: 1, mentions: "#")
    expect_cfg_error("X := a#b\n", line: 1, mentions: "#")
    expect_cfg_error("X := #a\n", line: 1, mentions: "#")
    expect_cfg_error("  # indented\n", line: 1, mentions: "name")
    expect_cfg_error("X :=# a\n", line: 1, mentions: "space")
}

test "an empty line is empty, and a comment does not end in a backslash" {
    expect_cfg_error("A := 1\n \n", line: 2, mentions: "name")
    expect_cfg_error("# continued \\\nB := 2\n", line: 1, mentions: "backslash")
    expect_cfg_error("#\\\n", line: 1, mentions: "backslash")
    parse_cfg("# a backslash \\ inside is fine\n")
}

test "no byte Make or the shell would read specially is in a word" {
    expect_cfg_error("X := $(CC)\n", line: 1, mentions: "$")
    expect_cfg_error("X := ${CC}\n", line: 1, mentions: "$")
    expect_cfg_error("X := $$\n", line: 1, mentions: "$")
    expect_cfg_error("X := a \\\n", line: 1, mentions: "\\")
    expect_cfg_error("X := a\\\n", line: 1, mentions: "\\")
    expect_cfg_error("X := \"a b\"\n", line: 1, mentions: "\"")
    expect_cfg_error("X := 'a'\n", line: 1, mentions: "'")
    expect_cfg_error("X := `cc`\n", line: 1, mentions: "`")
    expect_cfg_error("X := a;b\n", line: 1, mentions: ";")
    expect_cfg_error("X := a&b\n", line: 1, mentions: "&")
    expect_cfg_error("X := a|b\n", line: 1, mentions: "|")
    expect_cfg_error("X := a<b\n", line: 1, mentions: "<")
    expect_cfg_error("X := a>b\n", line: 1, mentions: ">")
    expect_cfg_error("X := (a)\n", line: 1, mentions: "(")
    expect_cfg_error("X := *.c\n", line: 1, mentions: "*")
    expect_cfg_error("X := ~/x\n", line: 1, mentions: "~")
    expect_cfg_error("X := %.c\n", line: 1, mentions: "%")
    expect_cfg_error("X := a:b\n", line: 1, mentions: ":")
    expect_cfg_error("X := !a\n", line: 1, mentions: "!")
    expect_cfg_error("X := café\n", line: 1, mentions: "cannot be in a word")
}

test "a word may hold what a flag, a path or a prefix needs" {
    let vars: build.LinkVars = parse_cfg("W := -Wl,-dead_strip -DKOD=1 -std=c11 /opt/homebrew/opt/openssl@3/lib libc++.a ../a_b-c.d +x\n")
    expect_words(vars, name: "W", want: ["-Wl,-dead_strip", "-DKOD=1", "-std=c11", "/opt/homebrew/opt/openssl@3/lib", "libc++.a", "../a_b-c.d", "+x"])
}

// Does `lines` hold `want`?
func holds_line(anon lines: [str], want: str) -> bool {
    for l in lines {
        if l == want {
            return true
        }
    }
    return false
}

test "Make reads the real link.cfg as the reader does" {
    let vars: build.LinkVars = build.LinkVars(items: [])
    let error: str = build.parse_link_config(io.read_file("link.cfg"), path: "link.cfg", into: vars, overrides: false)
    if len(error) > 0 {
        fail(error)
    }
    // Make's database, printed after "no targets": a variable the file set
    // follows a `# makefile (from 'link.cfg', line N)` line. (Make lists its
    // own MAKEFILE_LIST there too.)
    let made: process.ProcessResult = process.run(["make", "-pq", "-f", "link.cfg"])
    mut from_make: [str] = []
    mut previous: str = ""
    for line in build.lines_of(made.stdout) {
        if build.starts_with(previous, prefix: "# makefile (from ") and previous.contains("link.cfg") and not build.starts_with(line, prefix: "MAKEFILE_LIST ") {
            from_make += [line]
        }
        previous = line
    }
    assert len(from_make) == len(vars.items)
    for v in vars.items {
        let line: str = f"{v.name} := {v.value}"
        if not holds_line(from_make, want: line) {
            fail(f"Make did not read `{line}` from link.cfg")
        }
    }
    // What every program needs is set.
    for name in ["LINK", "CC", "CFLAGS", "RUNTIME_C", "STAGE0_KOD"] {
        if len(build.split_words(build.link_value(vars, :name))) == 0 {
            fail(f"link.cfg sets no {name}")
        }
    }
}

// The link inputs a module declares in the comment lines at its top
// (docs/modules.md, "Link inputs"). Pure: the text of the module and the
// link configuration go in, what it declares and what is wrong with it come
// out.

func decl_vars() -> build.LinkVars {
    return parse_cfg("CC := clang\nOPENSSL := /opt/ssl\nTWO := a b\nNOTHING :=\n")
}

func decls_of(anon source: str) -> build.LinkDecls {
    return build.parse_link_decls(path: "lib/mod.kod", source: source, vars: decl_vars())
}

// `source` declares nothing and nothing is wrong with it.
func expect_no_decls(anon source: str) -> none {
    let d: build.LinkDecls = decls_of(source)
    if len(d.cc) != 0 or len(d.link) != 0 or len(d.require) != 0 or len(d.errors) != 0 or d.first != 0 {
        fail(f"{source} declares something: {len(d.cc)} cc, {len(d.link)} link, {len(d.require)} require, errors {build.join_words(d.errors)}, first {d.first}")
    }
}

// `source` has exactly the one error `want` (the text after `lib/mod.kod:<line>:1: error: `).
func expect_decl_error(anon source: str, line: int64, want: str) -> none {
    let d: build.LinkDecls = decls_of(source)
    if len(d.errors) != 1 {
        fail(f"{source} has {len(d.errors)} errors, want 1: {build.join_words(d.errors)}")
    } else {
        let wanted: str = f"lib/mod.kod:{line}:1: error: {want}"
        if d.errors[0] != wanted {
            fail(f"the error for {source} is {d.errors[0]}, want {wanted}")
        }
    }
}

func expect_strs(anon got: [str], anon want: [str]) -> none {
    if len(got) != len(want) {
        fail(f"[{build.join_words(got)}] has {len(got)} words, want [{build.join_words(want)}]")
    }
    mut i: int64 = 0
    for w in want {
        if got[i] != w {
            fail(f"[{build.join_words(got)}] is not [{build.join_words(want)}]")
        }
        i = i + 1
    }
}

test "a leading block names C files, link arguments and required files" {
    let d: build.LinkDecls = decls_of("// kod:require ${OPENSSL}/include/openssl/ssl.h  brew install openssl@3\n// kod:cc tls.c -I${OPENSSL}/include -DKOD_TLS=1\n// kod:link -L${OPENSSL}/lib -lssl -lcrypto\n\nimport \"io\"\n")
    expect_strs(d.errors, [])
    assert len(d.cc) == 1
    assert d.cc[0].file == "lib/tls.c"
    expect_strs(d.cc[0].flags, ["-I/opt/ssl/include", "-DKOD_TLS=1"])
    assert d.cc[0].line == 2
    expect_strs(d.link, ["-L/opt/ssl/lib", "-lssl", "-lcrypto"])
    assert len(d.require) == 1
    assert d.require[0].file == "/opt/ssl/include/openssl/ssl.h"
    assert d.require[0].hint == "brew install openssl@3"
    assert d.require[0].line == 1
    assert d.first == 1
}

test "a module without such lines declares nothing" {
    expect_no_decls("")
    expect_no_decls("\n\n")
    expect_no_decls("import \"io\"\n")
    expect_no_decls("// Helpers for the reports.\n// Nothing here needs C.\n\nimport \"io\"\n")
    expect_no_decls("// kod is the compiler: a comment may say kod: and not be a line of it\nfunc f() -> int64 {\n    return 1\n}\n")
}

test "only the leading block counts" {
    // After the first line that is neither blank nor a comment, a kod: line is a comment.
    expect_no_decls("import \"io\"\n// kod:link -lz\n")
    expect_no_decls("func f() -> int64 {\n    return 1\n}\n// kod:cc f.c\n")
    expect_no_decls("let s = \"\"\"\n// kod:link -lz\n\"\"\"\n")
    // Text after the block in a module the compiler's own tests quote.
    let d: build.LinkDecls = decls_of("// one\n// kod:link -lz\n\n// two\n// kod:link -lm\nimport \"io\"\n// kod:link -lc\n")
    expect_strs(d.link, ["-lz", "-lm"])
    assert d.first == 2
}

test "blank lines, other comments and an indent are part of the block" {
    let d: build.LinkDecls = decls_of("\n// A TLS stream.\n\n   // kod:link -lssl\n\t// kod:link -lcrypto\n// kod:cc tls.c\n")
    expect_strs(d.errors, [])
    expect_strs(d.link, ["-lssl", "-lcrypto"])
    assert d.cc[0].line == 6
    assert d.first == 4
}

test "a CRLF file reads like an LF one" {
    let d: build.LinkDecls = decls_of("// kod:link -lz\r\n// kod:cc zlib.c -DX\r\n\r\nimport \"io\"\r\n")
    expect_strs(d.errors, [])
    expect_strs(d.link, ["-lz"])
    assert d.cc[0].file == "lib/zlib.c"
    expect_strs(d.cc[0].flags, ["-DX"])
}

test "a directive needs the space after the slashes and none before its name" {
    // `// kod: link` (a space) is a directive without a name.
    expect_decl_error("// kod: link -lz\n", line: 1, want: "a directive is `// kod:` and its name with no space between, as in `// kod:link -lz`")
    expect_decl_error("// kod:\n", line: 1, want: "a directive is `// kod:` and its name with no space between, as in `// kod:link -lz`")
}

test "a comment spelled almost like a directive is an error, not a comment" {
    let slip: str = "a directive is written `// kod:name`, in lower case, with one space after the slashes and none before the colon"
    expect_decl_error("//kod:link -lz\n", line: 1, want: slip)
    expect_decl_error("//  kod:link -lz\n", line: 1, want: slip)
    expect_decl_error("//\tkod:link -lz\n", line: 1, want: slip)
    expect_decl_error("// Kod:link -lz\n", line: 1, want: slip)
    expect_decl_error("// KOD:link -lz\n", line: 1, want: slip)
    expect_decl_error("// kod :link -lz\n", line: 1, want: slip)
    expect_decl_error("// kod\t: link -lz\n", line: 1, want: slip)
    expect_decl_error("// first\n\n   //kod:cc x.c\n", line: 3, want: slip)
    // It counts as the first directive line, as a wrong `// kod:` line does.
    assert decls_of("// a\n//kod:link -lz\n").first == 2
    // Comments that only mention kod are comments.
    expect_no_decls("// kod\n")
    expect_no_decls("//kod\n")
    expect_no_decls("// ko\n// k\n//\n")
    expect_no_decls("// kod is a language\n")
    expect_no_decls("// kodak: a film\n")
    expect_no_decls("// the kod: line is read\n")
    expect_no_decls("// a kod:link -lz\n")
    // Below the block it is a comment, as a `// kod:` line is.
    expect_no_decls("import \"io\"\n//kod:link -lz\n")
}

test "a tab or another control character in a directive line is an error" {
    let tab: str = "a tab or another control character in a directive line; its words are separated by spaces"
    expect_decl_error("// kod:link -lz \t\n", line: 1, want: tab)
    expect_decl_error("// kod:link\t-lz\n", line: 1, want: tab)
    expect_decl_error("// kod:cc ce.c\t\n", line: 1, want: tab)
    expect_decl_error("// kod:require /x\thint\n", line: 1, want: tab)
    expect_decl_error("// kod:link -lz\r-lm\n", line: 1, want: tab)
    // An indent may be a tab, and a CR may end the line; other bytes are fine, non-ASCII ones too.
    let d: build.LinkDecls = decls_of("\t// kod:link -lz\r\n// kod:link -Lcafé/lib -DX=ä\n")
    expect_strs(d.errors, [])
    expect_strs(d.link, ["-lz", "-Lcafé/lib", "-DX=ä"])
}

test "a byte order mark before the block is skipped, as the lexer skips it" {
    let mark: str = kod_bytes_to_str(kod_bytes_from_array([239, 187, 191]))
    let d: build.LinkDecls = decls_of(mark + "// kod:cc x.c -DX\n// kod:link -lz\n\nimport \"io\"\n")
    expect_strs(d.errors, [])
    assert len(d.cc) == 1
    assert d.cc[0].file == "lib/x.c"
    assert d.cc[0].line == 1
    expect_strs(d.link, ["-lz"])
    assert d.first == 1
    // Lines keep their numbers, and a wrong one is found.
    expect_decl_error(mark + "// a\n// kod:linkk\n", line: 2, want: "unknown directive kod:linkk")
    expect_decl_error(mark + "//kod:link -lz\n", line: 1, want: "a directive is written `// kod:name`, in lower case, with one space after the slashes and none before the colon")
    expect_no_decls(mark + "import \"io\"\n// kod:link -lz\n")
    expect_no_decls(mark)
    expect_no_decls(mark + "\n")
}

test "an unknown directive is an error at its line" {
    expect_decl_error("// kod:linkk -lz\n", line: 1, want: "unknown directive kod:linkk")
    expect_decl_error("// first\n\n// kod:CC x.c\n", line: 3, want: "unknown directive kod:CC")
    expect_decl_error("// kod:pkg openssl\n", line: 1, want: "unknown directive kod:pkg")
}

test "kod:cc names a .c file beside the module" {
    let d: build.LinkDecls = decls_of("// kod:cc zlib_crc.c\n")
    assert d.cc[0].file == "lib/zlib_crc.c"
    assert len(d.cc[0].flags) == 0
    // The module's directory is part of the path, normalized.
    let up: build.LinkDecls = build.parse_link_decls(path: "a/../b/./m.kod", source: "// kod:cc x.c\n", vars: decl_vars())
    assert up.cc[0].file == "b/x.c"
    let root: build.LinkDecls = build.parse_link_decls(path: "m.kod", source: "// kod:cc x.c\n", vars: decl_vars())
    assert root.cc[0].file == "x.c"
    let absolute: build.LinkDecls = build.parse_link_decls(path: "/srv/app/m.kod", source: "// kod:cc x.c\n", vars: decl_vars())
    assert absolute.cc[0].file == "/srv/app/x.c"
    let not_c: str = "which is not the name of a .c file beside the module (a bare name that ends in .c)"
    expect_decl_error("// kod:cc sub/x.c\n", line: 1, want: f"kod:cc names `sub/x.c`, {not_c}")
    expect_decl_error("// kod:cc ../x.c\n", line: 1, want: f"kod:cc names `../x.c`, {not_c}")
    expect_decl_error("// kod:cc x.h\n", line: 1, want: f"kod:cc names `x.h`, {not_c}")
    expect_decl_error("// kod:cc x\n", line: 1, want: f"kod:cc names `x`, {not_c}")
    expect_decl_error("// kod:cc .c\n", line: 1, want: f"kod:cc names `.c`, {not_c}")
    expect_decl_error("// kod:cc -DX x.c\n", line: 1, want: f"kod:cc names `-DX`, {not_c}")
    expect_decl_error("// kod:cc\n", line: 1, want: "kod:cc needs the name of a C file")
}

test "kod:link and kod:require need their arguments" {
    expect_decl_error("// kod:link\n", line: 1, want: "kod:link needs at least one argument")
    expect_decl_error("// kod:link   \n", line: 1, want: "kod:link needs at least one argument")
    expect_decl_error("// kod:require\n", line: 1, want: "kod:require needs the file that must exist")
}

test "kod:require has a file and a hint of any number of words" {
    let d: build.LinkDecls = decls_of("// kod:require /usr/include/zlib.h\n// kod:require ${OPENSSL}/lib/libssl.dylib   brew  install   openssl@3\n")
    expect_strs(d.errors, [])
    assert len(d.require) == 2
    assert d.require[0].file == "/usr/include/zlib.h"
    assert d.require[0].hint == ""
    assert d.require[1].file == "/opt/ssl/lib/libssl.dylib"
    assert d.require[1].hint == "brew install openssl@3"
    assert d.require[1].line == 2
}

test "kod:link arguments are kept as written, in order, from every line" {
    let d: build.LinkDecls = decls_of("// kod:link -framework Security -lz\n// kod:link -lz /x/libfoo.a -lz\n")
    expect_strs(d.link, ["-framework", "Security", "-lz", "-lz", "/x/libfoo.a", "-lz"])
}

test "${NAME} is the value link.cfg gives NAME, anywhere in a word" {
    let d: build.LinkDecls = decls_of("// kod:link ${OPENSSL} -L${OPENSSL}/lib ${CC}${CC} ${OPENSSL}:${OPENSSL}\n")
    expect_strs(d.errors, [])
    expect_strs(d.link, ["/opt/ssl", "-L/opt/ssl/lib", "clangclang", "/opt/ssl:/opt/ssl"])
}

test "a ${NAME} that cannot be replaced is an error" {
    expect_decl_error("// kod:link -L${NOPE}/lib\n", line: 1, want: "`${NOPE}` is not set in link.cfg or link.local.cfg")
    // The value must be a word: several or none would change the count of arguments.
    expect_decl_error("// kod:link ${TWO}\n", line: 1, want: "`${TWO}` must be one word to be used in a directive")
    expect_decl_error("// kod:link ${NOTHING}\n", line: 1, want: "`${NOTHING}` must be one word to be used in a directive")
    let bad: str = "a `$` must start `${NAME}` (capital letters, digits and _)"
    expect_decl_error("// kod:link $OPENSSL\n", line: 1, want: bad)
    expect_decl_error("// kod:link $(OPENSSL)\n", line: 1, want: bad)
    expect_decl_error("// kod:link ${OPENSSL\n", line: 1, want: bad)
    expect_decl_error("// kod:link ${}\n", line: 1, want: bad)
    expect_decl_error("// kod:link ${openssl}\n", line: 1, want: bad)
    expect_decl_error("// kod:link -lz$\n", line: 1, want: bad)
    expect_decl_error("// kod:cc x.c -DPRICE=$5\n", line: 1, want: bad)
}

test "every line is checked, and the good ones still count" {
    let d: build.LinkDecls = decls_of("// kod:link -lz\n// kod:linkk -lm\n// kod:cc x.h\n// kod:link ${NOPE}\n// kod:cc ok.c\n")
    assert len(d.errors) == 3
    assert build.starts_with(d.errors[0], prefix: "lib/mod.kod:2:1: error: unknown directive kod:linkk")
    assert build.starts_with(d.errors[1], prefix: "lib/mod.kod:3:1: error: kod:cc names `x.h`")
    assert build.starts_with(d.errors[2], prefix: "lib/mod.kod:4:1: error: `${NOPE}` is not set")
    expect_strs(d.link, ["-lz"])
    assert len(d.cc) == 1
    assert d.cc[0].file == "lib/ok.c"
    assert d.first == 1
}

test "the first directive line is known even when its line is wrong" {
    let d: build.LinkDecls = decls_of("// intro\n// kod:nonsense\n")
    assert d.first == 2
    assert len(d.errors) == 1
}

test "the leading block is the lines up to the first one that is not blank or a comment" {
    assert build.leading_block("") == ""
    assert build.leading_block("import \"io\"\n") == ""
    assert build.leading_block("// a\n\n// b\nimport \"io\"\n// c\n") == "// a\n\n// b\n"
    assert build.leading_block("// a\n// b") == "// a\n// b"
    assert build.leading_block("  // a\n\t\n  \nx\n") == "  // a\n\t\n  \n"
    assert build.leading_block("/* a */\n// b\n") == ""
    assert build.leading_block("// a\r\n\r\nx\r\n") == "// a\r\n\r\n"
}

test "ends_with compares the end of a string" {
    assert build.ends_with("zlib_crc.c", suffix: ".c")
    assert build.ends_with("c", suffix: "c")
    assert not build.ends_with("x", suffix: ".c")
    assert not build.ends_with("", suffix: ".c")
    assert build.ends_with("a.kod", suffix: "") == true
}
