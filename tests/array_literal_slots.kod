// An array literal's elements are boxed or wrapped for every slot it's stored in.
interface Shape {
    func area(self) -> int64
}
type Sq = struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type Holder = struct {
    shapes: [Shape]
    opts: [int64?] = [none, 2]
}
type Bag = enum {
    Items(shapes: [Shape])
    Empty
}
type Shapes = [Shape]
func total(anon xs: [Shape]) -> int64 {
    mut t = 0
    for x in xs {
        t += x.area()
    }
    return t
}
func count(anon xs: [int64?]) -> int64 {
    mut t = 0
    for x in xs {
        t += x? or 100
    }
    return t
}
func defaulted(xs: [Shape] = [Sq(s: 11)]) -> int64 {
    return total(xs)
}
func ret_shapes() -> [Shape] {
    return [Sq(s: 2)]
}
func ret_opts() -> [int64?] {
    return [none, 3]
}
func ret_nested() -> [[int64?]] {
    return [[1, none], [none, 4]]
}
func ret_nested_shapes() -> [[Shape]] {
    return [[Sq(s: 3)], [Sq(s: 1), Sq(s: 2)]]
}
func ret_fallible() -> [Shape] or Error {
    return [Sq(s: 9)]
}
func ret_optional(anon k: int64) -> Shapes? {
    if k > 0 {
        return [Sq(s: 6)]
    }
    return none
}
func ret_match(anon k: int64) -> [Shape] {
    return match k {
        1 -> [Sq(s: 5)]
        else -> []
    }
}
func main() -> int64 {
    let a: [Shape] = [Sq(s: 1), Sq(s: 2)]
    print_int(total(a))
    mut b: [Shape] = []
    b = [Sq(s: 3)]
    print_int(total(b))
    b += [Sq(s: 4)]
    print_int(total(b))
    print_int(total([Sq(s: 5)]))
    print_int(count([none, 7]))
    print_int(defaulted())
    mut h = Holder(shapes: [Sq(s: 6)])
    print_int(total(h.shapes) + count(h.opts))
    h.shapes = [Sq(s: 8)]
    h.opts = [9, none]
    print_int(total(h.shapes) + count(h.opts))
    let bag: Bag = .Items(shapes: [Sq(s: 10)])
    match bag {
        .Items(shapes) -> print_int(total(shapes))
        .Empty -> print("empty")
    }
    print_int(total(ret_shapes()))
    print_int(count(ret_opts()))
    let n = ret_nested()
    print_int(count(n[0]) + count(n[1]))
    let ns = ret_nested_shapes()
    print_int(total(ns[0]) + total(ns[1]))
    print_int(total(must ret_fallible()))
    print_int(total(ret_optional(1)?))
    print_int(total(ret_match(1)))
    mut grid: [[Shape]] = [[Sq(s: 1)]]
    grid[0] = [Sq(s: 7)]
    print_int(total(grid[0]))
    mut ogrid: [[int64?]] = [[1]]
    ogrid[0] = [none, 5]
    print_int(count(ogrid[0]))
    let m = Map[str, [Shape]]()
    m["k"] = [Sq(s: 3)]
    print_int(total(m["k"]?))
    m.set("j", [Sq(s: 12)])
    print_int(total(m["j"]?))
    let om = Map[str, [int64?]]()
    om["o"] = [none, 1]
    print_int(count(om["o"]?))
    return 0
}

// expected output:
// 5
// 9
// 25
// 25
// 107
// 121
// 138
// 173
// 100
// 4
// 103
// 205
// 14
// 81
// 36
// 25
// 49
// 105
// 9
// 144
// 101
