// Negative integer literals as patterns, at the edges of what a `cmp` immediate and a `mov` can hold.

type Reading = enum {
    Temp(degrees: int64)
    Pair(a: int64?, b: int64)
    Off
}

func top(n: int64) -> str {
    return match n {
        0 -> "zero"
        -1 -> "minus one"
        - 2 -> "minus two, spaced"
        -4095 -> "imm edge"
        -4096 -> "past imm edge"
        -65535 -> "mov edge"
        -65536 -> "past mov edge"
        -70000 -> "wide"
        -0x10 -> "hex"
        -0b11 -> "binary"
        -1 000 000 -> "grouped"
        -5000000000 -> "over 32 bits"
        -9223372036854775807 -> "almost smallest"
        -9223372036854775808 -> "smallest"
        9223372036854775807 -> "largest"
        else -> "other"
    }
}

func nested(r: Reading) -> str {
    match r {
        .Temp(-40) -> return "same in both scales"
        .Temp(d) if d < -273 -> return "impossible"
        .Temp(d) -> return f"{d} degrees"
        .Pair(Some(-1), -2) -> return "both negative"
        .Pair(Some(-1), b) -> return f"left negative, {b}"
        .Pair(_, -9223372036854775808) -> return "right smallest"
        .Pair(_, _) -> return "pair"
        .Off -> return "off"
    }
}

func alternatives(n: int64) -> str {
    match n {
        -1 | 1 -> return "unit"
        -2 | 2 if n > 0 -> return "plus two"
        else -> return "other"
    }
}

func in_is(r: Reading, n: int64) -> str {
    if r is .Temp(-1) {
        return "temp minus one"
    }
    if r is .Pair(Some(-3), b) and b > 0 {
        return f"chain {b}"
    }
    if n is -9 {
        return "minus nine"
    }
    return "none"
}

func is_not(r: Reading) -> str {
    if r is not .Pair(_, -7) {
        return "not seven"
    }
    return "seven"
}

func let_else(r: Reading) -> int64 {
    let .Pair(Some(-1), b) = r else { return 0 }
    return b
}

func subtraction(n: int64) -> int64 {
    // Still arithmetic, not a pattern.
    let a = 0 - 1
    return n - a
}

func main() -> int64 {
    print(top(n: 0))
    print(top(n: -1))
    print(top(n: -2))
    print(top(n: -4095))
    print(top(n: -4096))
    print(top(n: -65535))
    print(top(n: -65536))
    print(top(n: -70000))
    print(top(n: -16))
    print(top(n: -3))
    print(top(n: -1000000))
    print(top(n: -5000000000))
    print(top(n: -9223372036854775807))
    print(top(n: -9223372036854775808))
    print(top(n: 9223372036854775807))
    print(top(n: 1))
    print(top(n: -70001))
    print(nested(r: .Temp(degrees: -40)))
    print(nested(r: .Temp(degrees: -300)))
    print(nested(r: .Temp(degrees: 40)))
    print(nested(r: .Pair(a: -1, b: -2)))
    print(nested(r: .Pair(a: -1, b: 2)))
    print(nested(r: .Pair(a: 1, b: -9223372036854775808)))
    print(nested(r: .Pair(a: none, b: -2)))
    print(nested(r: .Off))
    print(alternatives(n: -1))
    print(alternatives(n: 1))
    print(alternatives(n: -2))
    print(alternatives(n: 2))
    print(in_is(r: .Temp(degrees: -1), n: 0))
    print(in_is(r: .Pair(a: -3, b: 4), n: 0))
    print(in_is(r: .Off, n: -9))
    print(in_is(r: .Off, n: 0))
    print(is_not(r: .Pair(a: none, b: -7)))
    print(is_not(r: .Pair(a: none, b: 7)))
    print(is_not(r: .Off))
    print_int(let_else(r: .Pair(a: -1, b: 6)))
    print_int(let_else(r: .Pair(a: 1, b: 6)))
    print_int(subtraction(n: 5))
    return 0
}

// expected output:
// zero
// minus one
// minus two, spaced
// imm edge
// past imm edge
// mov edge
// past mov edge
// wide
// hex
// binary
// grouped
// over 32 bits
// almost smallest
// smallest
// largest
// other
// other
// same in both scales
// impossible
// 40 degrees
// both negative
// left negative, 2
// right smallest
// pair
// off
// unit
// unit
// other
// plus two
// temp minus one
// chain 4
// minus nine
// none
// seven
// not seven
// not seven
// 6
// 0
// 6
