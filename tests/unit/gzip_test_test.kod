// The system's `gunzip` reads what `deflate.gzip` writes, stored, with fixed
// codes (a short input) and with dynamic codes (a long one), at a few levels.

import "compress/deflate"
import "io"
import "process"

func roundtrip(anon label: str, anon input: bytes, anon compressed: bytes) -> str {
    let path: str = f"/tmp/kod_gzip_{label}.gz"
    let rc: int64 = io.write_file(path, kod_bytes_to_str(compressed))
    if rc != 0 {
        return f"{label}: write failed"
    }
    let r: process.ProcessResult = process.run(["gunzip", "-c", path])
    if r.status != 0 {
        return f"{label}: gunzip failed"
    }
    if kod_str_to_bytes(r.stdout) == input {
        return f"{label}: ok"
    }
    return f"{label}: mismatch"
}

test "gunzip reads what gzip writes" {
    let short: bytes = b"The quick brown fox jumps over the lazy dog."
    mut long = ""
    for i in 0..3000 {
        long += f"{i} {i * i % 1000} fox dog "
    }
    let input = kod_str_to_bytes(long)
    assert roundtrip("stored", short, deflate.gzip(short, level: 0)) == "stored: ok"
    assert roundtrip("short", short, deflate.gzip(short)) == "short: ok"
    assert roundtrip("level1", input, deflate.gzip(input, level: 1)) == "level1: ok"
    assert roundtrip("level6", input, deflate.gzip(input)) == "level6: ok"
    assert roundtrip("level9", input, deflate.gzip(input, level: 9)) == "level9: ok"
}
