// HTTP/1.1: URLs, headers, writing a request and reading a response, and a
// Client that sends requests over TCP or TLS, with redirects. See docs/http.md.
import "arrays"
import "compress/deflate"
import "compress/inflate"
import "encoding/base64"
import "io" { file_size }
import "net/tcp"
import "net/tls"
import "net/tls" { TlsStream }
import "panics"
import "posix"
import "posix" { Fd }
import "signals"
import "sort"
import "strbuilder" { StrBuilder }
import "stream" { IoError, BufReader, MemReader, MemWriter, Reader, Writer }
import "tasks"
import "time"
import "time" { Duration }

type Header = shared struct {
    name: str
    value: str
}

type Headers = shared struct {
    items: [Header] = []

    func get(self, anon name: str) -> str? {
        let want = name.lower()
        for h in self.items {
            if h.name.lower() == want {
                return h.value
            }
        }
        return none
    }

    func all(self, anon name: str) -> [str] {
        let want = name.lower()
        mut out: [str] = []
        for h in self.items {
            if h.name.lower() == want {
                out += [h.value]
            }
        }
        return out
    }

    func has(self, anon name: str) -> bool {
        return self.get(name) is not none
    }

    func add(self, anon name: str, anon value: str) -> none {
        self.items += [Header(name: name, value: value)]
    }

    // Replaces the first header of that name in place and drops the others.
    func set(self, anon name: str, anon value: str) -> none {
        let want = name.lower()
        mut out: [Header] = []
        mut placed = false
        for h in self.items {
            if h.name.lower() != want {
                out += [h]
            } else if not placed {
                out += [Header(name: name, value: value)]
                placed = true
            }
        }
        if not placed {
            out += [Header(name: name, value: value)]
        }
        self.items = out
    }
}

type Url = shared struct {
    scheme: str
    host: str
    port: int64
    target: str

    func host_header(self) -> str {
        mut h = self.host
        if h.contains(":") {
            h = "[" + h + "]"
        }
        mut default_port: int64 = 80
        if self.scheme == "https" {
            default_port = 443
        }
        if self.port != default_port {
            h += ":" + self.port.to_str()
        }
        return h
    }
}

// A request as a client writes it (write_request).
type Outgoing = shared struct {
    method: str
    url: Url
    headers: Headers
    body: bytes
    // Where the body comes from instead, and its length when that is known.
    body_from: Reader? = none
    body_length: int64? = none
    // Why writing it failed, when that is what did.
    unsent: Error? = none
}

type Response = shared struct {
    status: int64
    reason: str
    headers: Headers
    body: bytes
    // The connection can carry another request: see docs/http.md.
    keep_alive: bool = false
    // Writes the body, in place of `body`, which is `length` long when that is
    // known (http.stream).
    writer: (func(BodyWriter) -> none or Error)? = none
    length: int64? = none
    // The body that is yet to be read (Client.open).
    stream: OpenBody? = none
    // What that is decoded to, when it is compressed.
    decoded: DecodedBody? = none

    func text(self) -> str {
        return kod_bytes_to_str(self.body)
    }

    // The body, as it comes when the response was opened.
    func reader(self) -> Reader {
        if self.decoded is DecodedBody(d) {
            return d
        }
        if self.stream is OpenBody(b) {
            return b
        }
        return MemReader(data: self.body, pos: 0)
    }

    // Ends the body of an opened response, if it hasn't been read to its end.
    func close(self) -> none {
        if self.stream is OpenBody(b) {
            b.close()
        }
    }

    func ok(self) -> bool {
        return self.status >= 200 and self.status < 300
    }

    func header(self, anon name: str) -> str? {
        return self.headers.get(name)
    }

    // The response itself, with a header added.
    func with_header(self, anon name: str, anon value: str) -> Response {
        self.headers.add(name, value)
        return self
    }
}

type Limits = struct {
    max_body: int64 = 16777216
    max_header_bytes: int64 = 65536
    max_headers: int64 = 100
}

func protocol(anon detail: str) -> IoError {
    return IoError(kind: .Protocol, op: "http", errno: 0, detail: detail)
}

func invalid(anon op: str, anon detail: str) -> IoError {
    return IoError(kind: .InvalidInput, op: op, errno: 0, detail: detail)
}

// ---- character classes ----

func is_digit(anon c: int64) -> bool {
    return c >= 48 and c <= 57
}

func is_alpha(anon c: int64) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

// A token character, as RFC 9110 defines it: names of methods and headers.
func is_token_char(anon c: int64) -> bool {
    if is_digit(c) or is_alpha(c) {
        return true
    }
    return "!#$%&'*+-.^_`|~".find(kod_bytes_to_str(kod_bytes_from_array([c]))) is not none
}

func is_token(anon s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    let n = len(s)
    mut i: int64 = 0
    for i < n {
        if not is_token_char(s[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

// No control characters (a tab is allowed) and no DEL.
func is_clean(anon s: str, tab_ok: bool) -> bool {
    let n = len(s)
    mut i: int64 = 0
    for i < n {
        let c = s[i]
        if c == 127 or (c < 32 and (c != 9 or not tab_ok)) {
            return false
        }
        i = i + 1
    }
    return true
}

func all_digits(anon s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    let n = len(s)
    mut i: int64 = 0
    for i < n {
        if not is_digit(s[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

// ---- URLs ----

func parse_port(anon text: str, op: str) -> int64 or Error {
    if not all_digits(text) or len(text) > 5 {
        throw invalid(op, f"bad port {text}")
    }
    let p = text.parse_int()? or 0
    if p < 1 or p > 65535 {
        throw invalid(op, f"port {text} out of range")
    }
    return p
}

func parse_url(anon s: str) -> Url or Error {
    let op = "parse url"
    if not is_clean(s, tab_ok: false) or s.contains(" ") {
        throw invalid(op, "URL has a space or control character")
    }
    let sep = s.find("://")
    if sep is none {
        throw invalid(op, "URL needs http:// or https://")
    }
    let at = sep
    let scheme = s[0..at].lower()
    if scheme != "http" and scheme != "https" {
        throw invalid(op, f"unsupported scheme {scheme}")
    }
    mut rest = s[at + 3..len(s)]
    let hash = rest.find("#")
    if hash is not none {
        rest = rest[0..hash]
    }
    mut end = len(rest)
    for mark in ["/", "?"] {
        let m = rest.find(mark)
        if m is not none and m < end {
            end = m
        }
    }
    let authority = rest[0..end]
    mut target = rest[end..len(rest)]
    if len(target) == 0 {
        target = "/"
    } else if target[0] == 63 {
        target = "/" + target
    }
    if authority.contains("@") {
        throw invalid(op, "credentials in a URL are not supported")
    }
    mut host = authority
    mut port: int64 = 80
    if scheme == "https" {
        port = 443
    }
    if authority.starts_with("[") {
        let close = authority.find("]")
        if close is none {
            throw invalid(op, "unterminated [ in host")
        }
        let c = close
        host = authority[1..c]
        let after = authority[c + 1..len(authority)]
        if len(after) > 0 {
            if after[0] != 58 {
                throw invalid(op, "text after ] in host")
            }
            port = try parse_port(after[1..len(after)], op: op)
        }
    } else {
        let colon = authority.find(":")
        if colon is not none {
            let c = colon
            host = authority[0..c]
            port = try parse_port(authority[c + 1..len(authority)], op: op)
        }
    }
    if len(host) == 0 {
        throw invalid(op, "URL has no host")
    }
    return Url(scheme: scheme, host: host.lower(), port: port, target: target)
}

// Remove "." and ".." segments from the path part of `target`; a query stays.
func normalize_target(anon target: str) -> str {
    mut path = target
    mut query = ""
    let q = target.find("?")
    if q is not none {
        path = target[0..q]
        query = target[q..len(target)]
    }
    let segments = path.split("/")
    mut out: [str] = []
    mut dir_end = false
    mut first = true
    for seg in segments {
        if first {
            first = false
        } else if seg == "." {
            dir_end = true
        } else if seg == ".." {
            if len(out) > 0 {
                out = out[0..len(out) - 1]
            }
            dir_end = true
        } else {
            out += [seg]
            dir_end = false
        }
    }
    mut joined = "/" + "/".join(out)
    if dir_end and not joined.ends_with("/") {
        joined += "/"
    }
    return joined + query
}

// Where a `Location` header sent from a response to `base` points.
func resolve(anon base: Url, anon location: str) -> Url or Error {
    let op = "resolve redirect"
    mut loc = location
    let hash = loc.find("#")
    if hash is not none {
        loc = loc[0..hash]
    }
    if len(loc) == 0 {
        throw invalid(op, "empty Location")
    }
    let lower = loc.lower()
    if lower.starts_with("http://") or lower.starts_with("https://") {
        return try parse_url(loc)
    }
    if loc.starts_with("//") {
        return try parse_url(base.scheme + ":" + loc)
    }
    let colon = loc.find(":")
    let slash = loc.find("/")
    if colon is not none {
        let c = colon
        if slash is none or c < (slash? or 0) {
            if not loc.starts_with("?") {
                throw invalid(op, f"unsupported Location {loc}")
            }
        }
    }
    mut target = loc
    if loc.starts_with("/") {
        target = normalize_target(loc)
    } else if loc.starts_with("?") {
        let q = base.target.find("?")
        mut path = base.target
        if q is not none {
            path = base.target[0..q]
        }
        target = path + loc
    } else {
        let q = base.target.find("?")
        mut path = base.target
        if q is not none {
            path = base.target[0..q]
        }
        mut dir = "/"
        let last = path.split("/")
        if len(last) > 1 {
            dir = path[0..len(path) - len(last[len(last) - 1])]
        }
        target = normalize_target(dir + loc)
    }
    return try parse_url(base.scheme + "://" + base.host_header() + target)
}

// ---- percent-encoding and query strings ----

func hex_upper(anon n: int64) -> int64 {
    if n < 10 {
        return 48 + n
    }
    return 55 + n
}

func hex_value(anon c: int64) -> int64 {
    if is_digit(c) {
        return c - 48
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    return -1
}

func is_unreserved(anon c: int64) -> bool {
    return is_digit(c) or is_alpha(c) or c == 45 or c == 46 or c == 95 or c == 126
}

// Every byte but A-Z a-z 0-9 - . _ ~ as %XX.
func percent_encode(anon s: str) -> str {
    let out = StrBuilder()
    let n = len(s)
    mut i: int64 = 0
    mut run: int64 = 0
    for i < n {
        let c = s[i]
        if not is_unreserved(c) {
            out.append(s[run..i])
            run = i + 1
            out.append_byte(37)
            out.append_byte(hex_upper(c >> 4))
            out.append_byte(hex_upper(c & 15))
        }
        i = i + 1
    }
    out.append(s[run..n])
    return out.to_str()
}

func percent_decode(anon s: str) -> str or Error {
    let out = StrBuilder()
    let n = len(s)
    mut i: int64 = 0
    for i < n {
        let c = s[i]
        if c != 37 {
            out.append_byte(c)
            i = i + 1
        } else {
            if i + 2 >= n {
                throw invalid("percent decode", "% needs two hex digits")
            }
            let hi = hex_value(s[i + 1])
            let lo = hex_value(s[i + 2])
            if hi < 0 or lo < 0 {
                throw invalid("percent decode", "% needs two hex digits")
            }
            out.append_byte(hi * 16 + lo)
            i = i + 3
        }
    }
    return out.to_str()
}

// Name and value pairs for a URL's query, encoded when written.
type Query = shared struct {
    items: [Header] = []

    func add(self, anon name: str, anon value: str) -> none {
        self.items += [Header(name: name, value: value)]
    }

    func to_str(self) -> str {
        let out = StrBuilder()
        mut first = true
        for h in self.items {
            if not first {
                out.append_byte(38)
            }
            first = false
            out.append(percent_encode(h.name))
            out.append_byte(61)
            out.append(percent_encode(h.value))
        }
        return out.to_str()
    }
}

// `url` with the query added after a `?` (or `&` if it has one), before any
// `#fragment`.
func with_query(anon url: str, anon q: Query) -> str {
    if len(q.items) == 0 {
        return url
    }
    mut base = url
    mut fragment = ""
    let hash = url.find("#")
    if hash is not none {
        base = url[0..hash]
        fragment = url[hash..len(url)]
    }
    mut sep = "?"
    if base.contains("?") {
        sep = "&"
        if base.ends_with("?") or base.ends_with("&") {
            sep = ""
        }
    }
    return base + sep + q.to_str() + fragment
}

// The value of an `Authorization` header for HTTP Basic authentication.
func basic_auth(anon user: str, anon password: str) -> str or Error {
    if user.contains(":") {
        throw invalid("basic auth", "the user name cannot contain a colon")
    }
    return "Basic " + base64.encode_str(user + ":" + password)
}

// ---- writing a request ----

func is_post_like(anon method: str) -> bool {
    return method == "POST" or method == "PUT" or method == "PATCH"
}

func own_header(anon name: str) -> bool {
    let n = name.lower()
    return n == "host" or n == "connection" or n == "content-length" or n == "transfer-encoding"
}

func write_request(anon w: Writer, anon req: Outgoing, keep_alive: bool = false, accept_gzip: bool = false) -> none or Error {
    let op = "write request"
    if not is_token(req.method) {
        throw invalid(op, "bad method")
    }
    if not is_clean(req.url.target, tab_ok: false) or req.url.target.contains(" ") or not req.url.target.starts_with("/") {
        throw invalid(op, "bad request target")
    }
    for h in req.headers.items {
        if not is_token(h.name) {
            throw invalid(op, f"bad header name {h.name}")
        }
        if not is_clean(h.value, tab_ok: true) {
            throw invalid(op, f"bad value for header {h.name}")
        }
    }
    let out = StrBuilder()
    out.append(req.method + " " + req.url.target + " HTTP/1.1\r\n")
    out.append("Host: " + req.url.host_header() + "\r\n")
    for h in req.headers.items {
        if not own_header(h.name) {
            out.append(h.name + ": " + h.value + "\r\n")
        }
    }
    if not req.headers.has("User-Agent") {
        out.append("User-Agent: kod\r\n")
    }
    if not req.headers.has("Accept") {
        out.append("Accept: */*\r\n")
    }
    if accept_gzip and not req.headers.has("Accept-Encoding") {
        out.append("Accept-Encoding: gzip\r\n")
    }
    if req.body_from is not none {
        if req.body_length is int64(n) {
            out.append(length_header(n))
        } else {
            out.append(CHUNKED)
        }
    } else if len(req.body) > 0 or is_post_like(req.method) {
        out.append(length_header(len(req.body)))
    }
    if not keep_alive {
        out.append("Connection: close\r\n")
    }
    out.append("\r\n")
    if req.body_from is Some(from) {
        try write_body_from(w, req, from, after: out)
        return
    }
    out.append_bytes(req.body)
    try write_piece(w, req, out)
}

// Writes `piece` and empties it; a failure is kept with `req`.
func write_piece(anon w: Writer, anon req: Outgoing, anon piece: StrBuilder) -> none or Error {
    if w.write_all(piece.to_bytes()) is Err(e) {
        req.unsent = e
        throw e
    }
    piece.clear()
}

// Writes the body that `from` gives, the first of it together with `after`.
func write_body_from(anon w: Writer, anon req: Outgoing, anon from: Reader, after: StrBuilder) -> none or Error {
    let out = after
    mut total: int64 = 0
    for true {
        let data = try from.read(STREAM_PIECE)
        total += len(data)
        if req.body_length is int64(n) and (total > n or (len(data) == 0 and total < n)) {
            throw invalid("write request", f"{total} bytes of a body of {n}")
        }
        if req.body_length is none {
            add_chunk(out, data)
        } else {
            out.append_bytes(data)
        }
        if out.len() > 0 {
            try write_piece(w, req, out)
        }
        if len(data) == 0 {
            return
        }
    }
}

let CHUNKED: str = "Transfer-Encoding: chunked\r\n"

// `data` as a chunk; without any, the last one.
func add_chunk(anon out: StrBuilder, anon data: bytes) -> none {
    if len(data) == 0 {
        out.append("0\r\n\r\n")
        return
    }
    out.append(f"{len(data):x}\r\n")
    out.append_bytes(data)
    out.append("\r\n")
}

// ---- reading a response ----

// What a response may still use up for its status line, headers and trailers.
type Budget = shared struct {
    left: int64
    headers: int64
}

func truncated(anon detail: str) -> IoError {
    return IoError(kind: .UnexpectedEof, op: "http", errno: 0, detail: detail)
}

// The next line without its line end. The stream ending first, or in the
// middle of the line, is a truncation; the budget running out is an error.
func next_line(anon br: BufReader, anon budget: Budget) -> str or Error {
    let got = br.read_line()
    if got is Err(e) {
        if e is IoError(io) {
            if io.kind == .InvalidInput and io.detail == "line too long" {
                throw protocol("headers too large")
            }
        }
        throw e
    }
    let line = got
    if line is none {
        throw truncated("connection closed before the end of the message")
    }
    if br.ended {
        throw truncated("connection closed in the middle of a line")
    }
    let text = line
    budget.left = budget.left - len(text) - 2
    if budget.left < 0 {
        throw protocol("headers too large")
    }
    return text
}

type StatusLine = struct {
    code: int64
    reason: str
    minor: int64
}

func parse_status(anon line: str) -> StatusLine or Error {
    if not line.starts_with("HTTP/1.") or len(line) < 12 {
        throw protocol("bad status line")
    }
    if not is_digit(line[7]) or line[8] != 32 {
        throw protocol("bad status line")
    }
    let digits = line[9..12]
    if not all_digits(digits) or (len(line) > 12 and line[12] != 32) {
        throw protocol("bad status line")
    }
    let code = digits.parse_int()? or 0
    if code < 100 or code > 599 {
        throw protocol("bad status line")
    }
    mut reason = ""
    if len(line) > 13 {
        reason = line[13..len(line)]
    }
    return StatusLine(code: code, reason: reason, minor: line[7] - 48)
}

// Header lines up to the empty line that ends them, added to `into`.
func read_headers(anon br: BufReader, anon budget: Budget, anon into: Headers, max_headers: int64) -> none or Error {
    for true {
        let line = try next_line(br, budget)
        if len(line) == 0 {
            return
        }
        if line[0] == 32 or line[0] == 9 {
            throw protocol("header continuation lines are not supported")
        }
        let colon = line.find(":")
        if colon is none {
            throw protocol("malformed header line")
        }
        let c = colon
        let name = line[0..c]
        if not is_token(name) {
            throw protocol("bad header name")
        }
        let value = line[c + 1..len(line)].trim()
        if not is_clean(value, tab_ok: true) {
            throw protocol("bad header value")
        }
        budget.headers = budget.headers + 1
        if budget.headers > max_headers {
            throw protocol("too many headers")
        }
        into.add(name, value)
    }
}

func parse_hex(anon text: str) -> int64 or Error {
    if len(text) == 0 or len(text) > 15 {
        throw protocol("bad chunk size")
    }
    mut n: int64 = 0
    let len_text = len(text)
    mut i: int64 = 0
    for i < len_text {
        let c = text[i]
        mut d: int64 = -1
        if is_digit(c) {
            d = c - 48
        } else if c >= 97 and c <= 102 {
            d = c - 87
        } else if c >= 65 and c <= 70 {
            d = c - 55
        }
        if d < 0 {
            throw protocol("bad chunk size")
        }
        n = n * 16 + d
        i = i + 1
    }
    return n
}

// The size of the next chunk, from its line.
func read_chunk_size(anon br: BufReader) -> int64 or Error {
    let size_line = try next_line(br, Budget(left: 4096, headers: 0))
    mut size_text = size_line
    let semi = size_line.find(";")
    if semi is not none {
        size_text = size_line[0..semi]
    }
    return try parse_hex(size_text.trim())
}

// The line break after a chunk.
func read_chunk_end(anon br: BufReader) -> none or Error {
    if kod_bytes_to_str(try br.read_exact(2)) != "\r\n" {
        throw protocol("chunk is missing its closing line break")
    }
}

func read_chunked(anon br: BufReader, anon budget: Budget, limits: Limits) -> bytes or Error {
    let out = StrBuilder()
    for true {
        let size = try read_chunk_size(br)
        if size == 0 {
            break
        }
        if out.len() + size > limits.max_body {
            throw protocol("body too large")
        }
        out.append_bytes(try br.read_exact(size))
        try read_chunk_end(br)
    }
    try read_headers(br, budget, Headers(), max_headers: limits.max_headers)
    return out.to_bytes()
}

func read_length(anon headers: Headers, anon limits: Limits) -> int64 or Error {
    mut n: int64 = -1
    for v in headers.all("content-length") {
        let t = v.trim()
        if not all_digits(t) or len(t) > 18 {
            throw protocol("bad Content-Length")
        }
        let x = t.parse_int()? or -1
        if n >= 0 and x != n {
            throw protocol("conflicting Content-Length headers")
        }
        n = x
    }
    if n > limits.max_body {
        throw protocol("body too large")
    }
    return n
}

// A body as it comes, in whatever way the headers say it is framed.
type Frames = shared struct {
    br: BufReader
    limits: Limits
    chunked: bool = false
    // Of the body, or of this chunk; -1 when it goes on until the connection ends.
    left: int64 = 0
    done: bool = false

    // Some of the body, at most `max` bytes; none of it at the end.
    func next(self, anon max: int64) -> bytes or Error {
        if self.done or max <= 0 {
            return kod_str_to_bytes("")
        }
        if self.chunked and self.left == 0 {
            self.left = try read_chunk_size(self.br)
            if self.left == 0 {
                let budget = Budget(left: self.limits.max_header_bytes, headers: 0)
                try read_headers(self.br, budget, Headers(), max_headers: self.limits.max_headers)
                self.done = true
                return kod_str_to_bytes("")
            }
        }
        mut want = max
        if 0 <= self.left < want {
            want = self.left
        }
        let data = try self.br.read(want)
        if len(data) == 0 {
            if self.left < 0 {
                self.done = true
                return data
            }
            throw truncated("connection closed before the end of the body")
        }
        if self.left > 0 {
            self.left -= len(data)
            if self.left == 0 and self.chunked {
                try read_chunk_end(self.br)
            }
            self.done = self.left == 0 and not self.chunked
        }
        return data
    }
}

// How the body of a response is framed.
func response_frames(anon br: BufReader, anon method: str, status: int64, headers: Headers, limits: Limits) -> Frames or Error {
    if method == "HEAD" or not may_have_body(status) {
        return Frames(:br, :limits, done: true)
    }
    let codings = headers.all("transfer-encoding")
    if len(codings) > 0 {
        for v in codings {
            if v.trim().lower() != "chunked" {
                throw protocol(f"unsupported Transfer-Encoding {v}")
            }
        }
        return Frames(:br, :limits, chunked: true)
    }
    let left = try read_length(headers, limits)
    return Frames(:br, :limits, :left, done: left == 0)
}

func read_body(anon br: BufReader, anon method: str, status: int64, headers: Headers, budget: Budget, limits: Limits) -> bytes or Error {
    let frames = try response_frames(br, method, :status, :headers, :limits)
    if frames.done {
        return kod_str_to_bytes("")
    }
    if frames.chunked {
        return try read_chunked(br, budget, :limits)
    }
    if frames.left > 0 {
        return try br.read_exact(frames.left)
    }
    let out = StrBuilder()
    for true {
        let piece = try br.read(65536)
        if len(piece) == 0 {
            break
        }
        out.append_bytes(piece)
        if out.len() > limits.max_body {
            throw protocol("body too large")
        }
    }
    return out.to_bytes()
}

// Does a `Connection`-style header list `token` (case-insensitively)?
func has_token(anon headers: Headers, anon name: str, anon token: str) -> bool {
    for v in headers.all(name) {
        for part in v.split(",") {
            if part.trim().lower() == token {
                return true
            }
        }
    }
    return false
}

// Does the response say where its body ends, so that the connection can be
// used again after it?
func framed(anon method: str, status: int64, headers: Headers) -> bool {
    if method == "HEAD" or status < 200 or status == 204 or status == 304 {
        return true
    }
    return len(headers.all("transfer-encoding")) > 0 or len(headers.all("content-length")) > 0
}

func may_reuse(anon method: str, status: StatusLine, headers: Headers) -> bool {
    if not framed(method, status: status.code, headers: headers) {
        return false
    }
    if has_token(headers, "connection", "close") {
        return false
    }
    if status.minor >= 1 {
        return true
    }
    return has_token(headers, "connection", "keep-alive")
}

// With `whole` false, the body is left to be read by the response's `stream`.
func read_one(anon br: BufReader, anon method: str, limits: Limits, whole: bool = true) -> Response or Error {
    mut interim: int64 = 0
    for true {
        let budget = Budget(left: limits.max_header_bytes, headers: 0)
        let status = try parse_status(try next_line(br, budget))
        let headers = Headers()
        try read_headers(br, budget, headers, max_headers: limits.max_headers)
        if status.code >= 200 and not whole {
            mut unlimited = limits
            unlimited.max_body = MAX_LENGTH
            let frames = try response_frames(br, method, status: status.code, :headers, limits: unlimited)
            return Response(status: status.code, reason: status.reason, :headers, body: kod_str_to_bytes(""), keep_alive: may_reuse(method, :status, :headers), stream: OpenBody(:frames))
        }
        if status.code >= 200 {
            let body = try read_body(br, method, status: status.code, headers: headers, budget: budget, limits: limits)
            return Response(status: status.code, reason: status.reason, headers: headers, body: body, keep_alive: may_reuse(method, status: status, headers: headers))
        }
        interim = interim + 1
        if interim > 16 {
            throw protocol("too many interim responses")
        }
    }
    throw protocol("unreachable")
}

// One response from `br`. `method` is the request's, which decides whether a
// body follows. Lines longer than the header limit fail.
func read_response(anon br: BufReader, anon method: str, limits: Limits = Limits()) -> Response or Error {
    let old = br.limit
    br.limit = limits.max_header_bytes
    let r = read_one(br, method, limits: limits)
    br.limit = old
    return r
}

// The client: requests over TCP or TLS, with redirects.

// What one request may change about the Client it is sent through. A field left
// out means the Client's value.
type Options = shared struct {
    headers: Headers = Headers()
    body: bytes = kod_str_to_bytes("")
    body_from: Reader? = none
    body_length: int64? = none
    trust_file: str? = none
    timeout: Duration? = none
    max_redirects: int64? = none
    limits: Limits? = none
    deadline: Duration? = none
    accept_gzip: bool? = none
}

// The values a request runs with: the Client's, with the Options laid over them.
type Settings = shared struct {
    headers: Headers
    body: bytes
    body_from: Reader?
    body_length: int64?
    trust_file: str
    timeout: Duration
    max_redirects: int64
    limits: Limits
    deadline: Duration
    accept_gzip: bool
}

// `base` and `extra` together; a header of `extra` replaces those of `base` with its name.
func merged(anon base: Headers, anon extra: Headers) -> Headers {
    let out = Headers()
    for h in base.items {
        if not extra.has(h.name) {
            out.add(h.name, h.value)
        }
    }
    for h in extra.items {
        out.add(h.name, h.value)
    }
    return out
}

func deadline_error() -> IoError {
    return IoError(kind: .TimedOut, op: "http", errno: 0, detail: "deadline exceeded")
}

// How long the next wait may last: `timeout_ms`, or less when the deadline
// (a monotonic time in ns, 0 for none) is nearer. Fails when it has passed.
func wait_ms(timeout_ms: int64, deadline_ns: int64) -> int64 or Error {
    if deadline_ns == 0 {
        return timeout_ms
    }
    let left_ns = deadline_ns - time.monotonic_ns()
    if left_ns <= 0 {
        throw deadline_error()
    }
    let left_ms = (left_ns + 999999) / 1000000
    if left_ms < timeout_ms {
        return left_ms
    }
    return timeout_ms
}

// A wait that ended in `TimedOut` after the deadline is a deadline error.
func after_wait(anon e: Error, deadline_ns: int64) -> Error {
    if deadline_ns != 0 and time.monotonic_ns() >= deadline_ns {
        if e is IoError(io) {
            if io.kind == .TimedOut {
                return deadline_error()
            }
        }
    }
    return e
}

// What the client needs of a connection, plain or TLS.
interface Link {
    func read(self, anon max: int64) -> bytes or Error
    func write(self, anon data: bytes) -> int64 or Error
    func close(self) -> none or Error
    // Nothing is waiting to be read: the peer has not closed it or sent more.
    func idle(self) -> bool
    // Set the limits for the next request and forget what was received.
    func arm(self, anon timeout_ms: int64, anon deadline_ns: int64) -> none
    // Bytes read since `arm`.
    func received(self) -> int64
}

// A plain connection whose every read and write is limited by the deadline.
type TcpLink = shared struct {
    conn: Fd
    timeout_ms: int64
    deadline_ns: int64
    got: int64 = 0

    func read(self, anon max: int64) -> bytes or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try tcp.set_timeout(self.conn, timeout: Duration(ms: ms))
        let data = self.conn.read(max)
        if data is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        let bytes_read = data
        self.got = self.got + len(bytes_read)
        return bytes_read
    }

    func write(self, anon data: bytes) -> int64 or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try tcp.set_timeout(self.conn, timeout: Duration(ms: ms))
        let put = self.conn.write(data)
        if put is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        return put
    }

    func close(self) -> none or Error {
        return try self.conn.close()
    }

    func idle(self) -> bool {
        return tcp.is_idle(self.conn)
    }

    func arm(self, anon timeout_ms: int64, anon deadline_ns: int64) -> none {
        self.timeout_ms = timeout_ms
        self.deadline_ns = deadline_ns
        self.got = 0
    }

    func received(self) -> int64 {
        return self.got
    }
}

type TlsLink = shared struct {
    conn: TlsStream
    timeout_ms: int64
    deadline_ns: int64
    got: int64 = 0

    func read(self, anon max: int64) -> bytes or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try self.conn.set_timeout(timeout: Duration(ms: ms))
        let data = self.conn.read(max)
        if data is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        let bytes_read = data
        self.got = self.got + len(bytes_read)
        return bytes_read
    }

    func write(self, anon data: bytes) -> int64 or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try self.conn.set_timeout(timeout: Duration(ms: ms))
        let put = self.conn.write(data)
        if put is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        return put
    }

    func close(self) -> none or Error {
        return try self.conn.close()
    }

    func idle(self) -> bool {
        return tcp.is_idle(Fd(fd: self.conn.fd))
    }

    func arm(self, anon timeout_ms: int64, anon deadline_ns: int64) -> none {
        self.timeout_ms = timeout_ms
        self.deadline_ns = deadline_ns
        self.got = 0
    }

    func received(self) -> int64 {
        return self.got
    }
}

// A new connection to where `url` points, within `connect_ms`.
func open_link(anon url: Url, cfg: Settings, connect_ms: int64) -> Link or Error {
    if url.scheme == "https" {
        let conn = try tls.connect(url.host, port: url.port, trust_file: cfg.trust_file, timeout: Duration(ms: connect_ms))
        return TlsLink(conn: conn, timeout_ms: cfg.timeout.ceil_ms(), deadline_ns: 0)
    }
    let conn = try tcp.connect(url.host, port: url.port, timeout: Duration(ms: connect_ms))
    return TcpLink(conn: conn, timeout_ms: cfg.timeout.ceil_ms(), deadline_ns: 0)
}

// Methods that are safe to send again when a reused connection turns out to
// be dead.
func repeatable(anon method: str) -> bool {
    return method == "GET" or method == "HEAD" or method == "OPTIONS" or method == "PUT" or method == "DELETE" or method == "TRACE"
}

type Idle = shared struct {
    key: str
    link: Link
    since_ns: int64
}

// Close a connection that nothing more is wanted from.
func discard(anon link: Link) -> none {
    if link.close() is Err(_) {
        return
    }
}

type Acquired = shared struct {
    link: Link
    reused: bool
}

// `body` decoded as the coding `gzip` or `deflate` says, to at most `max` bytes.
func inflated(anon body: bytes, coding: str, max: int64) -> bytes or Error {
    if coding != "deflate" {
        return try inflate.gunzip(body, max_output: max)
    }
    if len(body) >= 2 and inflate.zlib_header(body[0], body[1]) {
        return try inflate.inflate_zlib(body, max_output: max)
    }
    return try inflate.inflate_raw(body, max_output: max)
}

// A gzip- or deflate-encoded body decoded, with the headers saying so removed;
// any other response as it is. A deflate body should be zlib data, but some
// servers send raw deflate, told apart by the zlib header.
func decode_content(anon resp: Response, anon limits: Limits) -> Response or Error {
    let coding = resp.headers.get("content-encoding")
    if coding is none or len(resp.body) == 0 {
        return resp
    }
    let name = (coding? or "").trim().lower()
    if name != "gzip" and name != "x-gzip" and name != "deflate" {
        return resp
    }
    let decoded = inflated(resp.body, coding: name, max: limits.max_body)
    if decoded is Err(e) {
        if e is IoError(io) {
            if io.detail == "output too large" {
                throw IoError(kind: .Protocol, op: "http", errno: 0, detail: "body too large")
            }
            mut what = "gzip"
            if name == "deflate" {
                what = "deflate"
            }
            throw IoError(kind: .Protocol, op: "http", errno: 0, detail: f"bad {what} body: {io.detail}")
        }
        throw e
    }
    let body = decoded
    let headers = without(resp.headers, ["content-encoding", "content-length"])
    headers.add("Content-Length", len(body).to_str())
    return Response(status: resp.status, reason: resp.reason, headers: headers, body: body, keep_alive: resp.keep_alive)
}

// Write `req` and read its response.
func attempt(anon link: Link, anon br: BufReader, anon req: Outgoing, cfg: Settings, keep_alive: bool, whole: bool) -> Response or Error {
    let sent = write_request(link, req, :keep_alive, accept_gzip: cfg.accept_gzip)
    if sent is Err(e) {
        // A server may answer without reading all of a body.
        let has_body = len(req.body) > 0 or req.body_from is not none
        if has_body and req.unsent is not none and gone(e) {
            let early = read_one(br, req.method, limits: cfg.limits, :whole)
            if early is Ok(resp) {
                resp.keep_alive = false
                return resp
            }
        }
        throw e
    }
    return try read_one(br, req.method, limits: cfg.limits, :whole)
}

// Whether `e` says that the other side reads no more.
func gone(anon e: Error) -> bool {
    if e is IoError(io) {
        return io.kind == .BrokenPipe or io.kind == .ConnectionReset
    }
    return false
}

// The body of an opened response: see docs/http.md.
type OpenBody = shared struct {
    frames: Frames
    // Its connection, until it has ended, and where that goes then.
    link: Link? = none
    client: Client? = none
    key: str = ""
    keep: bool = false
    failed: Error? = none
    closed: bool = false
    // How much has been read.
    total: int64 = 0

    func read(self, anon max: int64) -> bytes or Error {
        if self.failed is Some(e) {
            throw e
        }
        let got = self.frames.next(max)
        if got is Err(e) {
            self.failed = e
            self.end(keep: false)
            throw e
        }
        self.total += len(got)
        if self.frames.done {
            self.end(keep: self.keep)
        }
        return got
    }

    func close(self) -> none {
        if self.link is not none {
            self.closed = true
            self.failed = invalid("read", "the response is closed")
            self.end(keep: false)
        }
    }

    // Reads the rest, when there is little of it, so that the connection can be
    // used again, and closes it.
    func drop_rest(self) -> none {
        mut most = STREAM_PIECE
        for self.link is not none and most > 0 {
            let got = self.read(most)
            if got is Err(_) {
                return
            }
            most -= len(got)
        }
        self.close()
    }

    func end(self, keep: bool) -> none {
        let Some(link) = self.link else {
            return
        }
        self.link = none
        let br = self.frames.br
        if keep and br.pos >= len(br.buf) and self.client is Client(c) {
            c.keep(self.key, link)
        } else {
            discard(link)
        }
        self.client = none
    }
}

// The body of an opened response, decompressed.
type DecodedBody = shared struct {
    raw: OpenBody
    // `gzip` or `deflate`, for errors.
    coding: str
    inflater: inflate.InflateReader
    failed: Error? = none
    done: bool = false

    func read(self, anon max: int64) -> bytes or Error {
        if self.done {
            return kod_str_to_bytes("")
        }
        if self.failed is Some(e) {
            throw e
        }
        if self.raw.closed and self.raw.failed is Some(e) {
            throw e
        }
        let got = self.inflater.read(max)
        if got is Err(e) {
            if self.raw.failed is none and self.raw.total == 0 {
                // No body, so none that is compressed.
                self.done = true
                return kod_str_to_bytes("")
            }
            mut failed = e
            if self.raw.failed is none and e is IoError(io) {
                failed = protocol(f"bad {self.coding} body: {io.detail}")
            }
            self.failed = failed
            self.raw.end(keep: false)
            throw failed
        }
        if max > 0 and len(got) == 0 {
            // What may come after its end.
            self.raw.drop_rest()
            self.done = true
        }
        return got
    }
}

// Has the response's reader decode its body, when that is compressed.
func decode_opened(anon resp: Response, anon body: OpenBody) -> none {
    let name = (resp.headers.get("content-encoding")? or "").trim().lower()
    if name == "gzip" or name == "x-gzip" {
        resp.decoded = DecodedBody(raw: body, coding: "gzip", inflater: inflate.gunzip_reader(body))
    } else if name == "deflate" {
        resp.decoded = DecodedBody(raw: body, coding: name, inflater: inflate.deflate_reader(body))
    } else {
        return
    }
    resp.headers = without(resp.headers, ["content-encoding", "content-length"])
}

// Connections kept between requests. See docs/http.md.
type Client = shared struct {
    headers: Headers = Headers()
    trust_file: str = ""
    timeout: Duration = Duration(seconds: 30)
    deadline: Duration = Duration()
    max_redirects: int64 = 5
    accept_gzip: bool = true
    limits: Limits = Limits()
    max_idle_per_host: int64 = 2
    idle: Duration = Duration(seconds: 30)
    pool: [Idle] = []

    // The settings for a request with `options`.
    func settings(self, anon options: Options) -> Settings {
        return Settings(
            headers: merged(self.headers, options.headers),
            body: options.body,
            body_from: options.body_from,
            body_length: options.body_length,
            trust_file: options.trust_file? or self.trust_file,
            timeout: options.timeout? or self.timeout,
            max_redirects: options.max_redirects? or self.max_redirects,
            limits: options.limits? or self.limits,
            deadline: options.deadline? or self.deadline,
            accept_gzip: options.accept_gzip? or self.accept_gzip,
        )
    }

    // An idle connection for `key`, or none. Ones that are too old or that the
    // server has closed are closed on the way.
    func take(self, anon key: str) -> Idle? {
        let now = time.monotonic_ns()
        mut kept: [Idle] = []
        mut found: Idle? = none
        for entry in self.pool {
            if now - entry.since_ns > self.idle.ns or not entry.link.idle() {
                discard(entry.link)
            } else if entry.key == key and found is none {
                found = entry
            } else {
                kept += [entry]
            }
        }
        self.pool = kept
        return found
    }

    // Keep `link` for `key`, closing the oldest of that host's if there are too many.
    func keep(self, anon key: str, anon link: Link) -> none {
        if self.max_idle_per_host <= 0 {
            discard(link)
            return
        }
        mut count: int64 = 0
        for entry in self.pool {
            if entry.key == key {
                count = count + 1
            }
        }
        mut kept: [Idle] = []
        mut drop = count - self.max_idle_per_host + 1
        for entry in self.pool {
            if entry.key == key and drop > 0 {
                drop = drop - 1
                discard(entry.link)
            } else {
                kept += [entry]
            }
        }
        kept += [Idle(key: key, link: link, since_ns: time.monotonic_ns())]
        self.pool = kept
    }

    // Close every idle connection.
    func close(self) -> none {
        for entry in self.pool {
            discard(entry.link)
        }
        let empty: [Idle] = []
        self.pool = empty
    }

    func acquire(self, anon key: str, anon url: Url, cfg: Settings, deadline_ns: int64, fresh: bool) -> Acquired or Error {
        if not fresh {
            let kept = self.take(key)
            if kept is Some(entry) {
                return Acquired(link: entry.link, reused: true)
            }
        }
        let connect_ms = try wait_ms(timeout_ms: cfg.timeout.ceil_ms(), deadline_ns: deadline_ns)
        let link = try open_link(url, cfg: cfg, connect_ms: connect_ms)
        return Acquired(link: link, reused: false)
    }

    // One request, on a kept connection if there is one, else on a new one.
    // With `whole` false, its body is yet to be read.
    func exchange(self, anon req: Outgoing, cfg: Settings, deadline_ns: int64, whole: bool) -> Response or Error {
        let url = req.url
        let key = f"{url.scheme}://{url.host}:{url.port}"
        let reuse = self.max_idle_per_host > 0
        mut repeated = false
        for true {
            // What a Reader gave can't be sent again, should a reused connection be dead.
            let got = try self.acquire(key, url, cfg: cfg, deadline_ns: deadline_ns, fresh: req.body_from is not none)
            let link = got.link
            link.arm(cfg.timeout.ceil_ms(), deadline_ns)
            let br = BufReader(inner: link, limit: cfg.limits.max_header_bytes)
            let outcome = attempt(link, br, req, cfg: cfg, keep_alive: reuse, :whole)
            if outcome is Err(e) {
                discard(link)
                if got.reused and not repeated and link.received() == 0 and repeatable(req.method) {
                    repeated = true
                    continue
                }
                throw e
            }
            let response = outcome
            if response.stream is OpenBody(body) {
                body.link = link
                body.client = self
                body.key = key
                body.keep = reuse and response.keep_alive
                if body.frames.done {
                    body.end(keep: body.keep)
                } else {
                    decode_opened(response, body)
                }
                return response
            }
            if reuse and response.keep_alive and br.pos >= len(br.buf) {
                self.keep(key, link)
            } else {
                discard(link)
            }
            return try decode_content(response, cfg.limits)
        }
        throw invalid("fetch", "unreachable")
    }

    func fetch(self, anon method: str, anon url: str, options: Options = Options()) -> Response or Error {
        return try self.request(method, url, options, whole: true)
    }

    // As fetch, without reading the body: see Response.reader and close.
    func open(self, anon method: str, anon url: str, options: Options = Options()) -> Response or Error {
        return try self.request(method, url, options, whole: false)
    }

    func request(self, anon method: str, anon url: str, anon options: Options, whole: bool) -> Response or Error {
        let cfg = self.settings(options)
        if cfg.body_from is not none and len(cfg.body) > 0 {
            throw invalid("fetch", "both a body and body_from")
        }
        if cfg.deadline < Duration() {
            throw invalid("fetch", "deadline cannot be negative")
        }
        mut deadline_ns: int64 = 0
        if cfg.deadline > Duration() {
            deadline_ns = time.monotonic_ns() + cfg.deadline.ns
        }
        mut current = try parse_url(url)
        mut verb = method
        mut payload = cfg.body
        mut from = cfg.body_from
        mut headers = cfg.headers
        mut hops: int64 = 0
        for true {
            let req = Outgoing(method: verb, url: current, headers: headers, body: payload, body_from: from, body_length: cfg.body_length)
            let resp = try self.exchange(req, cfg: cfg, deadline_ns: deadline_ns, :whole)
            let location = resp.header("location")
            if not is_redirect(resp.status) or location is none or cfg.max_redirects <= 0 {
                return resp
            }
            if resp.stream is OpenBody(body) {
                body.drop_rest()
            }
            hops = hops + 1
            if hops > cfg.max_redirects {
                throw invalid("redirect", f"more than {cfg.max_redirects} redirects")
            }
            let next = try resolve(current, location? or "")
            if current.scheme == "https" and next.scheme == "http" {
                throw invalid("redirect", "refusing a redirect from https to http")
            }
            if resp.status != 307 and resp.status != 308 {
                if verb != "HEAD" {
                    verb = "GET"
                }
                payload = kod_str_to_bytes("")
                from = none
                headers = without(headers, ["content-type"])
            } else if from is not none {
                throw invalid("redirect", "a body from a Reader can't be sent again")
            }
            if next.host != current.host or next.port != current.port {
                headers = without(headers, ["authorization", "cookie", "proxy-authorization"])
            }
            current = next
        }
        throw invalid("redirect", "unreachable")
    }

    func get(self, anon url: str, options: Options = Options()) -> Response or Error {
        return try self.fetch("GET", url, options: options)
    }

    func delete(self, anon url: str, options: Options = Options()) -> Response or Error {
        return try self.fetch("DELETE", url, options: options)
    }

    func post(self, anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
        return try self.fetch("POST", url, options: with_body(options, body, content_type))
    }

    func put(self, anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
        return try self.fetch("PUT", url, options: with_body(options, body, content_type))
    }

    func patch(self, anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
        return try self.fetch("PATCH", url, options: with_body(options, body, content_type))
    }
}

// `options` with a body, and a `Content-Type` that replaces one of the same name.
func with_body(anon options: Options, anon body: bytes, anon content_type: str) -> Options {
    let headers = merged(options.headers, Headers())
    headers.set("Content-Type", content_type)
    return Options(
        headers: headers,
        body: body,
        body_from: options.body_from,
        body_length: options.body_length,
        trust_file: options.trust_file,
        timeout: options.timeout,
        max_redirects: options.max_redirects,
        limits: options.limits,
        deadline: options.deadline,
        accept_gzip: options.accept_gzip,
    )
}

func is_redirect(anon status: int64) -> bool {
    return status == 301 or status == 302 or status == 303 or status == 307 or status == 308
}

// `headers` without the named ones.
func without(anon headers: Headers, anon names: [str]) -> Headers {
    let out = Headers()
    for h in headers.items {
        mut drop = false
        for n in names {
            if h.name.lower() == n {
                drop = true
            }
        }
        if not drop {
            out.add(h.name, h.value)
        }
    }
    return out
}

// One request on its own connection, closed afterwards.
func fetch(anon method: str, anon url: str, options: Options = Options()) -> Response or Error {
    let client = Client(max_idle_per_host: 0)
    return try client.fetch(method, url, options: options)
}

func open(anon method: str, anon url: str, options: Options = Options()) -> Response or Error {
    let client = Client(max_idle_per_host: 0)
    return try client.open(method, url, options: options)
}

func get(anon url: str, options: Options = Options()) -> Response or Error {
    return try fetch("GET", url, options: options)
}

func delete(anon url: str, options: Options = Options()) -> Response or Error {
    return try fetch("DELETE", url, options: options)
}

func post(anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
    return try fetch("POST", url, options: with_body(options, body, content_type))
}

func put(anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
    return try fetch("PUT", url, options: with_body(options, body, content_type))
}

func patch(anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
    return try fetch("PATCH", url, options: with_body(options, body, content_type))
}

// ---- serving ----

// A request as a server reads it (read_request, Server).
type Request = shared struct {
    method: str
    // The path and query, as sent.
    target: str
    headers: Headers
    body: bytes
    // The client may send another request on the connection: HTTP/1.1 without
    // `Connection: close`, or 1.0 with `keep-alive`.
    keep_alive: bool = false
    // The client's address, as `127.0.0.1:50123`.
    remote: str = ""
    // What the names in its route's pattern stand for (Router.answer).
    params: [Header] = []
    // It speaks HTTP/1.`minor`.
    minor: int64 = 1
    // The route it fits, once that has been looked up (Router.find).
    found: Found? = none
    // Its body, when the handler is to read it.
    stream: BodyReader? = none

    // `target` up to its query; of a whole URL (a proxy may send one), its path.
    func path(self) -> str {
        mut path = self.target
        let q = path.find("?")
        if q is not none {
            path = path[0..q]
        }
        if path.starts_with("http://") {
            let rest = path[7..len(path)]
            let slash = rest.find("/")
            if slash is not none {
                return rest[slash..len(rest)]
            }
            return "/"
        }
        return path
    }

    func text(self) -> str {
        return kod_bytes_to_str(self.body)
    }

    // The body, as it comes when it is streamed (docs/http.md#streaming).
    func reader(self) -> Reader {
        if self.stream is BodyReader(b) {
            return b
        }
        return MemReader(data: self.body, pos: 0)
    }

    func header(self, anon name: str) -> str? {
        return self.headers.get(name)
    }

    // The part of the path that `{name}` in the route's pattern stands for.
    func param(self, anon name: str) -> str {
        for p in self.params {
            if p.name == name {
                return p.value
            }
        }
        panic(f"the route of {self.path()} has no parameter `{name}`")
    }

    // The first value of `name` in the query, or none.
    func query(self, anon name: str) -> str? {
        let all = self.queries(name)
        if len(all) == 0 {
            return none
        }
        return all[0]
    }

    // All the values of `name` in the query.
    func queries(self, anon name: str) -> [str] {
        mut out: [str] = []
        let q = self.target.find("?")
        if q is none {
            return out
        }
        for pair in self.target[q + 1..len(self.target)].split("&") {
            mut key = pair
            mut value = ""
            let eq = pair.find("=")
            if eq is not none {
                key = pair[0..eq]
                value = pair[eq + 1..len(pair)]
            }
            if query_text(key) == name {
                out += [query_text(value)]
            }
        }
        return out
    }
}

// Text of a query, decoded; as it is when it can't be.
func query_text(anon s: str) -> str {
    let spaced = s.replace("+", to: " ")
    let decoded = percent_decode(spaced)
    if decoded is Ok(t) {
        return t
    }
    return spaced
}

// A response with `body`, for a handler to give back.
func respond(anon status: int64, anon body: str, content_type: str = "text/plain; charset=utf-8") -> Response {
    let headers = Headers()
    headers.add("Content-Type", content_type)
    return Response(:status, reason: "", :headers, body: kod_str_to_bytes(body))
}

func text(anon body: str, status: int64 = 200) -> Response {
    return respond(status, body)
}

func html(anon body: str, status: int64 = 200) -> Response {
    return respond(status, body, content_type: "text/html; charset=utf-8")
}

// A response whose body `write` writes: see docs/http.md#streaming.
func stream(anon write: func(BodyWriter) -> none or Error, status: int64 = 200, content_type: str = "application/octet-stream", length: int64? = none) -> Response {
    let headers = Headers()
    headers.add("Content-Type", content_type)
    return Response(:status, reason: "", :headers, body: kod_str_to_bytes(""), writer: write, :length)
}

// The file's content, streamed.
func file(anon path: str, content_type: str? = none) -> Response or Error {
    let length = file_size(path)
    if length is none {
        throw HttpError(status: 404)
    }
    let size = length
    return stream(func(anon w: BodyWriter) -> none or Error {
        let f = try posix.open_read(path)
        let copied = copy_file(f, w, size)
        try f.close()
        try copied
    }, content_type: content_type? or type_of_file(path), :length)
}

// Its first `size` bytes: no more, when it has grown since its size was asked for.
func copy_file(anon f: Fd, anon w: BodyWriter, anon size: int64) -> none or Error {
    mut left = size
    for left > 0 {
        mut want = left
        if want > STREAM_PIECE {
            want = STREAM_PIECE
        }
        let data = try f.read(want)
        if len(data) == 0 {
            return
        }
        try w.write_all(data)
        left -= len(data)
    }
}

// The type that the ending of a file's name says it is.
func type_of_file(anon path: str) -> str {
    let parts = path.split(".")
    match parts[len(parts) - 1].lower() {
        "html" | "htm" -> return "text/html; charset=utf-8"
        "css" -> return "text/css; charset=utf-8"
        "js" | "mjs" -> return "text/javascript; charset=utf-8"
        "json" -> return "application/json"
        "txt" | "md" -> return "text/plain; charset=utf-8"
        "csv" -> return "text/csv; charset=utf-8"
        "xml" -> return "application/xml"
        "svg" -> return "image/svg+xml"
        "png" -> return "image/png"
        "jpg" | "jpeg" -> return "image/jpeg"
        "gif" -> return "image/gif"
        "webp" -> return "image/webp"
        "ico" -> return "image/x-icon"
        "woff2" -> return "font/woff2"
        "wasm" -> return "application/wasm"
        "pdf" -> return "application/pdf"
        "zip" -> return "application/zip"
        "gz" -> return "application/gzip"
        "mp3" -> return "audio/mpeg"
        "mp4" -> return "video/mp4"
        else -> return "application/octet-stream"
    }
}

// `body` is the JSON's text.
func json(anon body: str, status: int64 = 200) -> Response {
    return respond(status, body, content_type: "application/json")
}

func redirect(anon to: str, status: int64 = 302) -> Response {
    return Response(:status, reason: "", headers: Headers(), body: kod_str_to_bytes("")).with_header("Location", to)
}

// Only a status, with its reason as the body.
func status(anon code: int64) -> Response {
    if code < 200 or code == 204 or code == 304 {
        return Response(status: code, reason: "", headers: Headers(), body: kod_str_to_bytes(""))
    }
    return respond(code, f"{reason_phrase(code)}\n")
}

// What a handler throws for a response of that status.
type HttpError = struct {
    status: int64
    message: str = ""

    func to_str(self) -> str {
        return f"{self.status} {self.message}"
    }
}

// The usual reason phrase for `status`, or "".
func reason_phrase(anon status: int64) -> str {
    match status {
        200 -> return "OK"
        201 -> return "Created"
        204 -> return "No Content"
        301 -> return "Moved Permanently"
        302 -> return "Found"
        303 -> return "See Other"
        304 -> return "Not Modified"
        307 -> return "Temporary Redirect"
        308 -> return "Permanent Redirect"
        400 -> return "Bad Request"
        401 -> return "Unauthorized"
        403 -> return "Forbidden"
        404 -> return "Not Found"
        405 -> return "Method Not Allowed"
        408 -> return "Request Timeout"
        413 -> return "Content Too Large"
        417 -> return "Expectation Failed"
        431 -> return "Request Header Fields Too Large"
        500 -> return "Internal Server Error"
        501 -> return "Not Implemented"
        503 -> return "Service Unavailable"
        else -> return ""
    }
}

type RequestLine = struct {
    method: str
    target: str
    minor: int64
}

// `METHOD target HTTP/1.x`.
func parse_request_line(anon line: str) -> RequestLine or Error {
    let parts = line.split(" ")
    if len(parts) != 3 or not is_token(parts[0]) {
        throw protocol("bad request line")
    }
    let target = parts[1]
    if len(target) == 0 or not is_clean(target, tab_ok: false) {
        throw protocol("bad request target")
    }
    let version = parts[2]
    if len(version) != 8 or not version.starts_with("HTTP/1.") or not is_digit(version[7]) {
        throw protocol("bad HTTP version")
    }
    return RequestLine(method: parts[0], :target, minor: version[7] - 48)
}

// The next request up to its body, or none when the connection ends before one
// begins.
func read_head(anon br: BufReader, anon limits: Limits) -> Request? or Error {
    let budget = Budget(left: limits.max_header_bytes, headers: 0)
    // Empty lines before a request are allowed (RFC 9112, 2.2).
    mut line = ""
    for len(line) == 0 {
        let got = try br.read_line()
        if got is none {
            return none
        }
        line = got
        budget.left = budget.left - len(line) - 2
        if budget.left < 0 {
            throw protocol("headers too large")
        }
    }
    if br.ended {
        throw truncated("connection closed in the middle of a line")
    }
    let start = try parse_request_line(line)
    let headers = Headers()
    try read_headers(br, budget, headers, max_headers: limits.max_headers)
    mut keep_alive = has_token(headers, "connection", "keep-alive")
    if start.minor >= 1 {
        keep_alive = true
    }
    if has_token(headers, "connection", "close") {
        keep_alive = false
    }
    return Request(method: start.method, target: start.target, :headers, body: kod_str_to_bytes(""), :keep_alive, minor: start.minor)
}

// Whether the body of `req` is sent in chunks.
func sent_in_chunks(anon req: Request) -> bool or Error {
    let codings = req.headers.all("transfer-encoding")
    if len(codings) > 0 {
        for v in codings {
            if v.trim().lower() != "chunked" {
                throw protocol(f"unsupported Transfer-Encoding {v}")
            }
        }
        // Two lengths: whoever is in front of this server may have taken the other.
        if req.headers.has("content-length") {
            throw protocol("both Transfer-Encoding and Content-Length")
        }
    }
    return len(codings) > 0
}

// The body of `req`, which read_head gave: none when nothing frames one.
func read_request_body(anon br: BufReader, anon req: Request, anon limits: Limits) -> none or Error {
    if try sent_in_chunks(req) {
        req.body = try read_chunked(br, Budget(left: limits.max_header_bytes, headers: 0), limits: limits)
        return
    }
    let n = try read_length(req.headers, limits)
    if n > 0 {
        req.body = try br.read_exact(n)
    }
}

func read_incoming(anon br: BufReader, anon limits: Limits) -> Request? or Error {
    let got = try read_head(br, limits)
    if got is Request(req) {
        try read_request_body(br, req, limits)
    }
    return got
}

// The next request from `br`, or none when the connection ends before one
// begins. A request without a body framed by Content-Length or chunks has
// none.
func read_request(anon br: BufReader, limits: Limits = Limits()) -> Request? or Error {
    let old = br.limit
    br.limit = limits.max_header_bytes
    let r = read_incoming(br, limits)
    br.limit = old
    return r
}

// The longest body written in one piece with its headers.
let JOINED_BODY: int64 = 65536

// Whether a response may have a body, and a length for one.
func may_have_body(anon status: int64) -> bool {
    return status >= 200 and status != 204 and status != 304
}

// The status line and headers of `resp`, with `framing` (what says where the
// body ends) and, unless `keep_alive`, `Connection: close`. An empty `reason`
// is the status's usual one.
func response_head(anon resp: Response, framing: str, keep_alive: bool) -> StrBuilder or Error {
    let op = "write response"
    if resp.status < 100 or resp.status > 599 {
        throw invalid(op, "bad status")
    }
    for h in resp.headers.items {
        if not is_token(h.name) {
            throw invalid(op, f"bad header name {h.name}")
        }
        if not is_clean(h.value, tab_ok: true) {
            throw invalid(op, f"bad value for header {h.name}")
        }
    }
    mut reason = resp.reason
    if len(reason) == 0 {
        reason = reason_phrase(resp.status)
    }
    if not is_clean(reason, tab_ok: true) {
        throw invalid(op, "bad reason")
    }
    let out = StrBuilder()
    out.append(f"HTTP/1.1 {resp.status} {reason}\r\n")
    for h in resp.headers.items {
        if not own_header(h.name) {
            out.append(h.name + ": " + h.value + "\r\n")
        }
    }
    if may_have_body(resp.status) {
        out.append(framing)
    }
    if not keep_alive {
        out.append("Connection: close\r\n")
    }
    out.append("\r\n")
    return out
}

func length_header(anon length: int64) -> str {
    return "Content-Length: " + length.to_str() + "\r\n"
}

// Writes `resp`. `head` leaves out the body, whose length it still gives where
// it is known: the answer to a HEAD.
func write_response(anon w: Writer, anon resp: Response, keep_alive: bool = false, head: bool = false) -> none or Error {
    if resp.writer is Some(write) {
        if head or not may_have_body(resp.status) {
            mut framing = ""
            if resp.length is int64(n) {
                framing = length_header(n)
            }
            try w.write_all((try response_head(resp, :framing, :keep_alive)).to_bytes())
            return
        }
        let body = BodyWriter(to: w, :resp, :keep_alive, length: resp.length)
        try write(body)
        try body.finish()
        return
    }
    let out = try response_head(resp, framing: length_header(len(resp.body)), :keep_alive)
    if head or not may_have_body(resp.status) or len(resp.body) == 0 {
        try w.write_all(out.to_bytes())
        return
    }
    if len(resp.body) <= JOINED_BODY {
        out.append_bytes(resp.body)
        try w.write_all(out.to_bytes())
        return
    }
    // Not copied again to go out together with the headers.
    try w.write_all(out.to_bytes())
    try w.write_all(resp.body)
}

// The shortest body that is compressed.
let COMPRESS_FROM: int64 = 1024

// Whether the client takes gzip.
func takes_gzip(anon req: Request) -> bool {
    mut any = false
    for line in req.headers.all("accept-encoding") {
        for item in line.lower().split(",") {
            let parts = item.split(";")
            let name = parts[0].trim()
            if name != "gzip" and name != "x-gzip" and name != "*" {
                continue
            }
            mut refused = false
            for p in parts[1..len(parts)] {
                let value = p.trim()
                // 0, 0., 0.0 and so on.
                if value.starts_with("q=") and value[2..len(value)].replace("0", to: "").replace(".", to: "") == "" {
                    refused = true
                }
            }
            if name != "*" {
                return not refused
            }
            any = not refused
        }
    }
    return any
}

// A copy of `resp` that says it depends on what encodings the client takes.
func with_vary(anon resp: Response) -> Response {
    let headers = merged(resp.headers, Headers())
    if not has_token(headers, "vary", "accept-encoding") and not has_token(headers, "vary", "*") {
        headers.add("Vary", "Accept-Encoding")
    }
    return Response(status: resp.status, reason: resp.reason, :headers, body: resp.body, writer: resp.writer, length: resp.length)
}

// Whether a response is one to compress for clients that take that.
func compressible(anon resp: Response) -> bool {
    if not may_have_body(resp.status) or resp.status == 206 or resp.headers.has("content-encoding") or resp.headers.has("etag") or has_token(resp.headers, "cache-control", "no-transform") {
        return false
    }
    let kind = (resp.headers.get("content-type")? or "").split(";")[0].trim().lower()
    if kind.starts_with("text/") or kind.ends_with("+json") or kind.ends_with("+xml") {
        return true
    }
    match kind {
        "application/json" | "application/x-ndjson" | "application/javascript" | "application/xml" | "application/wasm" -> return true
        else -> return false
    }
}

// How much of a streamed body is sent, and of a file read, at a time.
let STREAM_PIECE: int64 = 65536

// Writes a body piece by piece: see docs/http.md#streaming.
type BodyWriter = shared struct {
    to: Writer
    resp: Response
    keep_alive: bool
    // How long it is to be, when that is known.
    length: int64?
    // The client takes chunks (HTTP/1.1).
    chunks: bool = true
    // Whose connection it is: for the time it may take.
    conn: ServerConn? = none
    // What is yet to be sent.
    buf: StrBuilder = StrBuilder()
    // The headers have been sent, and say the body comes in chunks.
    begun: bool = false
    chunked: bool = false
    // How much has been written to it, and how much of a body has been sent.
    total: int64 = 0
    sent: int64 = 0
    // The level to compress it at, -1 for not at all; and, once it goes on past
    // its first piece, what does so, and where that puts it.
    level: int64 = -1
    packer: deflate.DeflateWriter? = none
    packed: MemWriter = MemWriter(buf: StrBuilder())
    // Something has been written since the last flush.
    unflushed: bool = false
    // Why nothing more can be sent.
    failed: Error? = none

    func write(self, anon data: bytes) -> int64 or Error {
        if self.length is int64(n) and self.total + len(data) > n {
            throw self.wrong_length(self.total + len(data), n)
        }
        mut at: int64 = 0
        for at < len(data) {
            mut end = at + STREAM_PIECE - self.buf.len()
            if end >= len(data) {
                end = len(data)
            }
            if at == 0 and end == len(data) {
                self.buf.append_bytes(data)
            } else {
                self.buf.append_bytes(data[at..end])
            }
            self.total += end - at
            at = end
            if self.buf.len() >= STREAM_PIECE {
                try self.send(last: false, all: false)
            }
        }
        self.unflushed = self.unflushed or len(data) > 0
        return len(data)
    }

    // Sends what has been written.
    func flush(self) -> none or Error {
        if self.unflushed or not self.begun {
            try self.send(last: false, all: true)
            self.unflushed = false
        }
    }

    // Ends the body.
    func finish(self) -> none or Error {
        if self.length is int64(n) and self.total != n {
            throw self.wrong_length(self.total, n)
        }
        try self.send(last: true, all: true)
    }

    func wrong_length(self, anon got: int64, anon want: int64) -> IoError {
        return invalid("write", f"{got} bytes of a body of {want}")
    }

    // Sends what waits; with `all`, what is still being compressed too.
    func send(self, last: bool, all: bool) -> none or Error {
        if self.failed is Some(e) {
            throw e
        }
        mut out = StrBuilder()
        if not self.begun {
            out = try self.head(:last)
        }
        let body = try self.take(:last, :all)
        // A chunk of no bytes would be the last.
        if self.chunked and len(body) > 0 {
            add_chunk(out, body)
        } else {
            out.append_bytes(body)
        }
        if self.chunked and last {
            add_chunk(out, kod_str_to_bytes(""))
        }
        self.begun = true
        self.sent += len(body)
        if out.len() == 0 {
            return
        }
        if self.conn is ServerConn(c) {
            c.sending_until(c.server.write_timeout)
        }
        let sent = self.to.write_all(out.to_bytes())
        if self.conn is ServerConn(c) {
            c.send_by_ns = 0
        }
        if sent is Err(e) {
            self.failed = e
            throw e
        }
    }

    // What waits, compressed if it is to be.
    func take(self, last: bool, all: bool) -> bytes or Error {
        let data = self.buf.to_bytes()
        self.buf.clear()
        let Some(packer) = self.packer else {
            return data
        }
        try packer.write_all(data)
        if last {
            try packer.finish()
        } else if all {
            try packer.flush()
        }
        let packed = self.packed.to_bytes()
        self.packed.buf.clear()
        return packed
    }

    // Compresses the first piece, which is the only one, if that makes it shorter;
    // or sees to it that all of them are.
    func begin_packing(self, last: bool) -> none {
        if self.level < 0 or (last and self.buf.len() < COMPRESS_FROM) {
            return
        }
        if last {
            let packed = deflate.gzip(self.buf.to_bytes(), level: self.level)
            if len(packed) >= self.buf.len() {
                return
            }
            self.buf.clear()
            self.buf.append_bytes(packed)
        } else {
            self.packer = deflate.gzip_writer(self.packed, level: self.level)
        }
        self.resp.headers.add("Content-Encoding", "gzip")
    }

    // The headers, now that the first piece goes out, which may be the last.
    func head(self, last: bool) -> StrBuilder or Error {
        mut framing = ""
        self.begin_packing(:last)
        if last {
            framing = length_header(self.buf.len())
        } else if self.length is int64(n) and self.packer is none {
            framing = length_header(n)
        } else if self.chunks {
            self.chunked = true
            framing = CHUNKED
        } else {
            self.keep_alive = false
        }
        if self.conn is ServerConn(c) {
            c.replying = true
            if c.body is BodyReader(b) and not b.done() {
                self.keep_alive = false
            }
        }
        return try response_head(self.resp, :framing, keep_alive: self.keep_alive)
    }
}

// A request's body, as it comes: see docs/http.md#streaming.
type BodyReader = shared struct {
    frames: Frames
    conn: ServerConn
    // The client waits to be told to go on.
    expected: bool = false
    failed: IoError? = none

    func done(self) -> bool {
        return self.frames.done
    }

    func read(self, anon max: int64) -> bytes or Error {
        if self.failed is IoError(e) {
            throw e
        }
        if self.done() or max <= 0 {
            return kod_str_to_bytes("")
        }
        let conn = self.conn
        conn.enter(.Body, conn.server.body_timeout)
        let got = self.next(max)
        conn.enter(.Handling, Duration())
        if got is Err(e) {
            mut failed = io_error(e)? or protocol("bad body")
            if conn.expired {
                failed = IoError(kind: .TimedOut, op: "http", errno: 0, detail: "the request took too long")
            }
            self.failed = failed
            throw failed
        }
        return got
    }

    func next(self, anon max: int64) -> bytes or Error {
        if self.expected {
            self.expected = false
            if not self.conn.replying {
                try self.conn.write_all(kod_str_to_bytes("HTTP/1.1 100 Continue\r\n\r\n"))
            }
        }
        return try self.frames.next(max)
    }

    // Reads the rest, when there is little of it, so that the connection can go on.
    func drop_rest(self) -> none {
        if self.failed is not none or self.expected or (not self.frames.chunked and self.frames.left > STREAM_PIECE) {
            return
        }
        mut most = STREAM_PIECE
        for not self.done() and most > 0 {
            let got = self.read(most)
            if got is Err(_) {
                return
            }
            most -= len(got)
        }
    }

    // What to answer when the handler gives up because of `e`: none when that
    // isn't the body's failure. When nobody is left to answer, the connection is `gone`.
    func refusal(self, anon e: Error) -> Response? {
        if self.failed is IoError(f) and e is IoError(io) and io.kind == f.kind and io.detail == f.detail {
            if f.kind == .TimedOut {
                return respond(408, f"{f.detail}\n")
            }
            if f.kind == .Protocol {
                return respond(refusal(f.detail), f"{f.detail}\n")
            }
            self.conn.gone = true
            return status(400)
        }
        return none
    }
}

// ---- routes ----

type Route = shared struct {
    stream_body: bool
    method: str
    // The names in its pattern, in order.
    names: [str]
    handler: func(Request) -> Response or Error
}

// Where the patterns that go on alike part: after each part of a path, the
// written parts that may come, a `{name}` and a `{name...}`.
type RouteNode = shared struct {
    parts: Map[str, RouteNode] = Map[str, RouteNode]()
    one: RouteNode? = none
    rest: RouteNode? = none
    // Those whose patterns end here.
    routes: [Route] = []
}

// A search for the route of a path: what the names stand for so far, and the
// methods of the routes that fit but for theirs.
type RouteSearch = shared struct {
    method: str
    parts: [str]
    values: [str] = []
    allowed: [str] = []

    // The route from `node` on that fits the parts from `i` on.
    func find(self, anon node: RouteNode, i: int64) -> Route? {
        if i == len(self.parts) {
            for r in node.routes {
                if r.method == self.method {
                    return r
                }
                if not arrays.contains(self.allowed, r.method) {
                    self.allowed += [r.method]
                }
            }
            return none
        }
        let part = self.parts[i]
        if node.parts.get(part) is RouteNode(next) {
            if self.find(next, i: i + 1) is Route(r) {
                return r
            }
        }
        if len(part) > 0 and node.one is RouteNode(next) {
            self.values += [part]
            if self.find(next, i: i + 1) is Route(r) {
                return r
            }
            self.values = self.values[0..len(self.values) - 1]
        }
        if len(part) > 0 and node.rest is RouteNode(next) {
            self.values += ["/".join(self.parts[i..])]
            if self.find(next, i: len(self.parts)) is Route(r) {
                return r
            }
            self.values = self.values[0..len(self.values) - 1]
        }
        return none
    }
}

// The parts of a path or a pattern, which starts with a slash: what is between
// its slashes.
func path_parts(anon path: str) -> [str] {
    return path[1..len(path)].split("/")
}

// Which handler answers which requests: see docs/http.md#routes.
type Router = shared struct {
    root: RouteNode = RouteNode()

    func get(self, anon pattern: str, anon handler: func(Request) -> Response or Error) -> none {
        self.add("GET", pattern, handler)
    }

    func post(self, anon pattern: str, anon handler: func(Request) -> Response or Error, stream_body: bool = false) -> none {
        self.add("POST", pattern, handler, :stream_body)
    }

    func put(self, anon pattern: str, anon handler: func(Request) -> Response or Error, stream_body: bool = false) -> none {
        self.add("PUT", pattern, handler, :stream_body)
    }

    func patch(self, anon pattern: str, anon handler: func(Request) -> Response or Error, stream_body: bool = false) -> none {
        self.add("PATCH", pattern, handler, :stream_body)
    }

    func delete(self, anon pattern: str, anon handler: func(Request) -> Response or Error) -> none {
        self.add("DELETE", pattern, handler)
    }

    func add(self, anon method: str, anon pattern: str, anon handler: func(Request) -> Response or Error, stream_body: bool = false) -> none {
        if not pattern.starts_with("/") {
            panic(f"a route's pattern starts with `/`: `{pattern}`")
        }
        let parts = path_parts(pattern)
        mut names: [str] = []
        mut node = self.root
        for i, part in parts {
            if not part.contains("{") and not part.contains("}") {
                let next = node.parts.get(part)? or RouteNode()
                node.parts[part] = next
                node = next
                continue
            }
            mut name = ""
            if len(part) > 2 and part.starts_with("{") and part.ends_with("}") {
                name = part[1..len(part) - 1]
            }
            let is_rest = name.ends_with("...")
            if is_rest {
                name = name[0..len(name) - 3]
            }
            if len(name) == 0 or name.contains("{") or name.contains("}") or arrays.contains(names, name) or (is_rest and i < len(parts) - 1) {
                panic(f"bad part `{part}` in the route `{pattern}`")
            }
            names += [name]
            if is_rest {
                let next = node.rest? or RouteNode()
                node.rest = next
                node = next
            } else {
                let next = node.one? or RouteNode()
                node.one = next
                node = next
            }
        }
        for r in node.routes {
            if r.method == method {
                panic(f"two routes for {method} `{pattern}`")
            }
        }
        node.routes += [Route(:stream_body, :method, :names, :handler)]
    }

    // Looks up the route `req` fits, which is kept with it.
    func find(self, anon req: Request) -> Found {
        if req.found is Found(f) {
            return f
        }
        let found = self.look_up(req)
        req.found = found
        return found
    }

    func look_up(self, anon req: Request) -> Found {
        let path = req.path()
        let search = RouteSearch(method: req.method, parts: [])
        if not path.starts_with("/") {
            return Found(:search)
        }
        for part in path_parts(path) {
            let decoded = percent_decode(part)
            if decoded is Err(_) {
                return Found(:search, bad: true)
            }
            search.parts += [decoded]
        }
        mut route = search.find(self.root, i: 0)
        if route is none and req.method == "HEAD" {
            search.method = "GET"
            search.allowed = []
            route = search.find(self.root, i: 0)
        }
        return Found(:search, :route)
    }

    // The response of the route `req` fits, or a 404 or 405.
    func answer(self, anon req: Request) -> Response or Error {
        let found = self.find(req)
        if found.bad {
            throw HttpError(status: 400, message: "bad path")
        }
        let search = found.search
        if found.route is Route(r) {
            for i, name in r.names {
                req.params += [Header(:name, value: search.values[i])]
            }
            let handler = r.handler
            return try handler(req)
        }
        if len(search.allowed) == 0 {
            return status(404)
        }
        if arrays.contains(search.allowed, "GET") and not arrays.contains(search.allowed, "HEAD") {
            search.allowed += ["HEAD"]
        }
        return status(405).with_header("Allow", ", ".join(sort.sorted(search.allowed)))
    }
}

// What looking up a request's route gave.
type Found = shared struct {
    search: RouteSearch
    route: Route? = none
    // Its path can't be decoded.
    bad: bool = false
}

// What a server's connection is doing, which decides how long it may take.
type Phase = enum {
    // Waiting for a request's first byte.
    Waiting
    Head
    Body
    Handling
    Writing
    // Reading what the client still sends, so that it reads the answer.
    Ending
}

// A connection of a Server. Nothing it reads or writes has a limit of its own:
// Server.reap ends what goes on past `deadline_ns`.
type ServerConn = shared struct {
    fd: Fd
    server: Server
    phase: Phase = .Waiting
    // When its phase is to end (a monotonic time), 0 for no such time.
    deadline_ns: int64 = 0
    served: int64 = 0
    expired: bool = false
    // Until when the piece of a streamed body that is being sent may take, or 0.
    send_by_ns: int64 = 0
    // The body its handler reads, and whether the response has begun.
    body: BodyReader? = none
    replying: bool = false
    // The client went away in the middle of the body its handler reads.
    gone: bool = false
    // What the response was: its status, and how long its body.
    status: int64 = 0
    sent: int64 = 0

    func sending_until(self, anon limit: Duration) -> none {
        if limit.ns > 0 {
            self.send_by_ns = time.monotonic_ns() + limit.ns
        }
    }

    func enter(self, anon phase: Phase, anon limit: Duration) -> none {
        self.phase = phase
        self.deadline_ns = 0
        if limit.ns > 0 {
            self.deadline_ns = time.monotonic_ns() + limit.ns
        }
    }

    func read(self, anon max: int64) -> bytes or Error {
        let data = try self.fd.read(max)
        if self.phase is .Waiting and len(data) > 0 and not self.expired {
            // A first request's headers have had their time since it connected.
            self.phase = .Head
            if self.served > 0 {
                self.enter(.Head, self.server.header_timeout)
            }
        }
        return data
    }

    func write(self, anon data: bytes) -> int64 or Error {
        return try self.fd.write(data)
    }

    // Ends what it waits for: a read gives the end of the stream.
    func expire(self) -> none {
        let sending = self.phase is .Writing or self.send_by_ns != 0
        self.expired = true
        self.deadline_ns = 0
        self.send_by_ns = 0
        tcp.shutdown(self.fd, read: true, write: sending)
    }

    // Answers its requests until it is to end.
    func converse(self) -> none or Error {
        let server = self.server
        let br = BufReader(inner: self, limit: server.limits.max_header_bytes)
        let remote = tcp.peer(self.fd)
        for true {
            self.wait_for_request(br)
            let got = read_head(br, server.limits)
            if got is Err(e) {
                self.refuse(e)
                return
            }
            let req = got
            if req is none {
                return
            }
            req.remote = remote
            if self.receive(br, req) is Err(e) {
                self.refuse(e)
                return
            }
            self.enter(.Handling, Duration())
            let began = time.monotonic_ns()
            let resp = server.answer(req)
            if self.gone {
                return
            }
            if self.body is BodyReader(b) and not b.done() and resp.writer is none {
                b.drop_rest()
            }
            let keep_alive = req.keep_alive and not server.stopping and not server.full
            let replied = self.reply(req, resp, :keep_alive)
            if server.access_log {
                server.log_access(req, self, began)
            }
            if not try replied {
                if self.body is BodyReader(b) and not b.done() {
                    self.end_gently()
                }
                return
            }
            self.served += 1
            self.forget_body()
        }
    }

    // The request is over: whoever still holds its body can't read on.
    func forget_body(self) -> none {
        if self.body is BodyReader(b) {
            b.failed = invalid("read", "the request is over")
        }
        self.body = none
        self.replying = false
    }

    func wait_for_request(self, anon br: BufReader) -> none {
        mut limit = self.server.idle_timeout
        if self.served == 0 {
            limit = self.server.header_timeout
        }
        self.enter(.Waiting, limit)
        // The next request came along with the last one.
        if br.pos < len(br.buf) {
            self.enter(.Head, self.server.header_timeout)
        } else if self.server.stopping {
            self.expire()
        }
    }

    // Reads the request's body, unless the handler is to.
    func receive(self, anon br: BufReader, anon req: Request) -> none or Error {
        if self.server.streams(req) {
            try self.open_body(br, req)
            return
        }
        self.enter(.Body, self.server.body_timeout)
        if req.headers.get("expect") is str(expect) {
            if expect.lower() != "100-continue" {
                throw protocol("unknown Expect")
            }
            // Before it is told to go on, so that it needn't send too much.
            let _ = try read_length(req.headers, self.server.limits)
            try self.write_all(kod_str_to_bytes("HTTP/1.1 100 Continue\r\n\r\n"))
        }
        try read_request_body(br, req, self.server.limits)
    }

    func open_body(self, anon br: BufReader, anon req: Request) -> none or Error {
        mut expected = false
        if req.headers.get("expect") is str(expect) {
            if expect.lower() != "100-continue" {
                throw protocol("unknown Expect")
            }
            expected = true
        }
        let chunked = try sent_in_chunks(req)
        mut limits = self.server.limits
        // The handler's to limit.
        limits.max_body = MAX_LENGTH
        mut left: int64 = 0
        if not chunked {
            left = try read_length(req.headers, limits)
            if left < 0 {
                left = 0
            }
        }
        let frames = Frames(:br, :limits, :chunked, :left, done: not chunked and left == 0)
        let body = BodyReader(:frames, conn: self, :expected)
        self.body = body
        req.stream = body
    }

    // Sends the response; whether the connection can go on after it.
    func reply(self, anon req: Request, anon resp: Response, keep_alive: bool) -> bool or Error {
        let head = req.method == "HEAD"
        mut resp = resp
        mut level: int64 = -1
        // A short body is the same for every client.
        let long = len(resp.body) >= COMPRESS_FROM or resp.writer is not none
        if self.server.compress and long and compressible(resp) {
            resp = with_vary(resp)
            if takes_gzip(req) {
                level = self.server.compress_level
            }
        }
        if resp.writer is Some(write) {
            // Not without chunks, its length then not being known.
            let length = resp.length? or COMPRESS_FROM
            if req.minor == 0 or length < COMPRESS_FROM {
                level = -1
            }
            if not head and may_have_body(resp.status) {
                return try self.reply_stream(req, resp, write, :keep_alive, :level)
            }
            if level >= 0 and resp.length is not none {
                resp.length = none
                resp.headers.add("Content-Encoding", "gzip")
            }
        } else if level >= 0 and len(resp.body) >= COMPRESS_FROM {
            let packed = deflate.gzip(resp.body, :level)
            if len(packed) < len(resp.body) {
                resp.body = packed
                resp.headers.add("Content-Encoding", "gzip")
            }
        }
        mut goes_on = keep_alive
        if self.body is BodyReader(b) and not b.done() {
            goes_on = false
        }
        self.replying = true
        self.enter(.Writing, self.server.write_timeout)
        self.status = resp.status
        self.sent = 0
        if not head and may_have_body(resp.status) {
            self.sent = len(resp.body)
        }
        let wrote = write_response(self, resp, keep_alive: goes_on, :head)
        if wrote is Err(IoError(e)) and e.kind == .InvalidInput {
            // Not a response: nothing has been written.
            let log = self.server.log
            log(f"{req.method} {req.target}: {e.to_str()}")
            self.status = 500
            try write_response(self, status(500), keep_alive: goes_on, :head)
            return goes_on
        }
        try wrote
        return goes_on
    }

    func reply_stream(self, anon req: Request, anon resp: Response, anon write: func(BodyWriter) -> none or Error, keep_alive: bool, level: int64) -> bool or Error {
        let body = BodyWriter(to: self, :resp, :keep_alive, length: resp.length, chunks: req.minor >= 1, conn: self, :level)
        self.status = resp.status
        let got = panics.catch(func() -> bool or Error {
            try write(body)
            try body.finish()
            return true
        })
        self.sent = body.sent
        if got is Err(e) {
            if body.failed is not none {
                throw e
            }
            if not body.begun {
                let instead = self.server.response_to(req, e)
                if self.gone {
                    throw e
                }
                return try self.reply(req, instead, :keep_alive)
            }
            if self.body is BodyReader(b) and b.refusal(e) is Response(_) {
                // The client's doing: too late to say what.
                throw e
            }
            self.server.log_failure(req, e, after: f" (after {body.total} bytes of the body)")
            throw e
        }
        return body.keep_alive
    }

    // Answers a request that couldn't be read, where it was a client's doing.
    func refuse(self, anon e: Error) -> none {
        let Some(io) = io_error(e) else {
            return
        }
        mut status: int64 = 0
        mut detail = io.detail
        if self.expired {
            // One that was only waiting is closed without a word.
            if self.phase is .Waiting {
                return
            }
            status = 408
            detail = "the request took too long"
        } else if io.kind == .Protocol {
            status = refusal(io.detail)
        }
        if status == 0 {
            return
        }
        self.enter(.Writing, self.server.write_timeout)
        if write_response(self, respond(status, f"{detail}\n")) is Err(_) {
            return
        }
        self.end_gently()
    }

    func end_gently(self) -> none {
        // Closing while the client still sends would reset the connection, and
        // the client might lose the answer.
        if self.expired {
            // Its reads are at an end: what comes now is dropped, as long as
            // the connection is open both ways.
            self.enter(.Ending, Duration())
            time.sleep(Duration(ms: 250))
            return
        }
        tcp.shutdown(self.fd, write: true)
        self.enter(.Ending, Duration(seconds: 1))
        mut left: int64 = 1048576
        for left > 0 and not self.expired {
            let data = self.fd.read(65536)
            if data is Err(_) {
                return
            }
            if len(data) == 0 {
                return
            }
            left -= len(data)
        }
    }
}

func io_error(anon e: Error) -> IoError? {
    if e is IoError(io) {
        return io
    }
    return none
}

// The status that says what is wrong with a request.
func refusal(anon detail: str) -> int64 {
    if detail == "body too large" {
        return 413
    }
    if detail == "headers too large" or detail == "too many headers" {
        return 431
    }
    if detail == "unknown Expect" {
        return 417
    }
    if detail.starts_with("unsupported Transfer-Encoding") {
        return 501
    }
    return 400
}

// More than any body: no limit.
let MAX_LENGTH: int64 = 9223372036854775807

// Server.log's default.
func log_to_stderr(anon line: str) -> none {
    kod_eprint(line)
}

// Server.handler's default.
func answer_404(anon _req: Request) -> Response or Error {
    return status(404)
}

// Answers requests: see docs/http.md#serving.
type Server = shared struct {
    routes: Router? = none
    // Answers the requests when there are no routes.
    handler: func(Request) -> Response or Error = answer_404
    host: str = "127.0.0.1"
    port: int64 = 8080
    header_timeout: Duration = Duration(seconds: 10)
    body_timeout: Duration = Duration(seconds: 60)
    write_timeout: Duration = Duration(seconds: 60)
    idle_timeout: Duration = Duration(seconds: 60)
    stop_timeout: Duration = Duration(seconds: 10)
    max_connections: int64 = 10000
    limits: Limits = Limits()
    log: func(str) -> none = log_to_stderr
    access_log: bool = false
    stop_on_signals: bool = true
    stream_bodies: bool = false
    compress: bool = false
    compress_level: int64 = 4
    // The open connections, by a number of their own.
    conns: Map[int64, ServerConn] = Map[int64, ServerConn]()
    last_conn: int64 = 0
    // Whether `serve` runs; whether `stop` has been called, and until when
    // requests may go on (a monotonic time).
    open: bool = false
    stopping: bool = false
    stop_ns: int64 = 0
    // The task that accepts connections.
    acceptor: tasks.Task[int64 or Error]? = none
    // A connection waits for another to end, which sends on `room`.
    full: bool = false
    room: tasks.Channel[bool] = tasks.Channel[bool](capacity: 1)
    // Closed once the last connection has ended after `stop`.
    quiet: tasks.Channel[bool] = tasks.Channel[bool]()

    // Listens on `host` and `port`, and answers requests until `stop` or a signal.
    func run(self) -> none or Error {
        let l = try tcp.listen(self.host, port: self.port, backlog: 1024)
        let served = self.serve_until_signal(l)
        let _ = l.close()
        try served
    }

    func serve_until_signal(self, anon l: tcp.Listener) -> none or Error {
        if not self.stop_on_signals {
            try self.serve(l)
            return
        }
        let sigs = try signals.listen([.Int, .Term])
        let waiting = spawn self.stop_at_signal(sigs)
        let served = self.serve(l)
        waiting.cancel()
        try served
    }

    // Stops at a signal; those that come after it do what they would without this.
    func stop_at_signal(self, anon sigs: signals.Signals) -> bool {
        let came = sigs.channel.receive() is not none
        sigs.stop()
        if came {
            self.stop()
        }
        return came
    }

    // Answers the requests that come to `l`, until `stop`.
    func serve(self, anon l: tcp.Listener) -> none or Error {
        if self.stopping {
            return
        }
        self.open = true
        let reaper = spawn self.reap()
        let served = self.serve_all(l)
        self.open = false
        self.acceptor = none
        reaper.cancel()
        try served
    }

    func serve_all(self, anon l: tcp.Listener) -> none or Error {
        let accepted = tasks.Channel[Fd]()
        let acceptor = spawn self.accept(l, accepted)
        self.acceptor = acceptor
        for fd in accepted {
            self.last_conn += 1
            let conn = ServerConn(:fd, server: self)
            self.conns[self.last_conn] = conn
            spawn self.attend(conn, id: self.last_conn)
        }
        if not self.stopping {
            // Accepting failed, or this task is cancelled.
            acceptor.cancel()
            let _ = try acceptor.wait()
            return
        }
        if len(self.conns) == 0 {
            return
        }
        let left = self.stop_ns - time.monotonic_ns()
        select {
            receive(self.quiet) -> none
            after(Duration(ns: left)) -> none
        }
        if len(self.conns) > 0 {
            throw IoError(kind: .TimedOut, op: "serve", errno: 0, detail: f"stopped with {len(self.conns)} connections still busy")
        }
    }

    // Accepts connections and sends them on `accepted`, until that fails.
    func accept(self, anon l: tcp.Listener, anon accepted: tasks.Channel[Fd]) -> int64 or Error {
        let ended = self.accept_all(l, accepted)
        accepted.close()
        return ended
    }

    func accept_all(self, anon l: tcp.Listener, anon accepted: tasks.Channel[Fd]) -> int64 or Error {
        for true {
            if len(self.conns) >= self.max_connections {
                try self.wait_for_room(l)
            }
            let got = l.accept()
            if got is Err(e) {
                // Too many open files, here or in the system: some may be closed.
                if e is IoError(io) and (io.errno == 24 or io.errno == 23) {
                    self.make_room()
                    time.sleep(Duration(ms: 20))
                    continue
                }
                throw e
            }
            let fd = got
            if tasks.cancelled() {
                let _ = fd.close()
                throw IoError(kind: .Cancelled, op: "accept", errno: 0, detail: "cancelled")
            }
            accepted.send(fd)
        }
        return 0
    }

    // With all the connections there may be, waits for another to come, and for
    // one of those to end.
    func wait_for_room(self, anon l: tcp.Listener) -> none or Error {
        try l.wait()
        for len(self.conns) >= self.max_connections and not tasks.cancelled() {
            self.make_room()
            self.full = true
            let _ = self.room.receive()
            self.full = false
        }
    }

    // Closes the connection that has waited longest for its next request.
    func make_room(self) -> none {
        mut oldest: ServerConn? = none
        mut oldest_ns: int64 = 0
        for id in self.conns {
            // Gone meanwhile, when this loop was preempted.
            let Some(conn) = self.conns[id] else { continue }
            if conn.phase is .Waiting and conn.served > 0 and not conn.expired {
                if oldest is none or conn.deadline_ns < oldest_ns {
                    oldest = conn
                    oldest_ns = conn.deadline_ns
                }
            }
        }
        if oldest is ServerConn(conn) {
            conn.expire()
        }
    }

    // Answers the requests of one connection, then forgets it.
    func attend(self, anon conn: ServerConn, id: int64) -> none {
        let log = self.log
        if panics.run(func() { let _ = conn.converse() }) is panics.Panic(p) {
            log(f"{p.to_str()}\n{p.backtrace}")
        }
        conn.forget_body()
        let _ = self.conns.remove(id)
        let _ = conn.fd.close()
        if self.full and len(self.room.items) == self.room.head {
            self.room.send(true)
        }
        if self.stopping and len(self.conns) == 0 and not self.quiet.closed {
            self.quiet.close()
        }
    }

    // Whether the handler of `req` reads its body.
    func streams(self, anon req: Request) -> bool {
        if self.routes is Router(r) {
            if r.find(req).route is Route(route) {
                return route.stream_body
            }
            return false
        }
        return self.stream_bodies
    }

    // The handler's response to `req`, or what its error or panic makes one.
    func answer(self, anon req: Request) -> Response {
        let handler = self.handler
        let routes = self.routes
        let got = panics.catch(func() -> Response or Error {
            if routes is Router(r) {
                return try r.answer(req)
            }
            return try handler(req)
        })
        match got {
            Ok(resp) -> return resp
            Err(e) -> return self.response_to(req, e)
        }
    }

    // The response for a request that failed with `e`.
    func response_to(self, anon req: Request, anon e: Error) -> Response {
        if e is HttpError(h) {
            if len(h.message) == 0 {
                return status(h.status)
            }
            return respond(h.status, f"{h.message}\n")
        }
        if req.stream is BodyReader(b) and b.refusal(e) is Response(r) {
            return r
        }
        self.log_failure(req, e, after: "")
        return status(500)
    }

    func log_failure(self, anon req: Request, anon e: Error, after: str) -> none {
        let log = self.log
        if e is panics.Panic(p) {
            log(f"{req.method} {req.target}: {p.to_str()}{after}\n{p.backtrace}")
        } else if not tasks.cancelled() {
            log(f"{req.method} {req.target}: {e.to_str()}{after}")
        }
    }

    func log_access(self, anon req: Request, anon conn: ServerConn, anon began_ns: int64) -> none {
        let log = self.log
        let us = (time.monotonic_ns() - began_ns) / 1000
        log(f"{req.remote} {req.method} {req.target} {conn.status} {conn.sent} B {us.to_float64() / 1000.0:.2f} ms")
    }

    // Ends the connections that have taken too long for what they are doing.
    func reap(self) -> int64 {
        mut shortest = self.header_timeout.ns
        for limit in [self.body_timeout, self.write_timeout, self.idle_timeout] {
            if limit.ns < shortest {
                shortest = limit.ns
            }
        }
        mut tick = shortest / 8
        if tick < 5000000 {
            tick = 5000000
        }
        if tick > 500000000 {
            tick = 500000000
        }
        for self.open {
            time.sleep(Duration(ns: tick))
            if tasks.cancelled() {
                return 0
            }
            let now = time.monotonic_ns()
            for id in self.conns {
                let Some(conn) = self.conns[id] else { continue }
                if (conn.deadline_ns != 0 and now >= conn.deadline_ns) or (conn.send_by_ns != 0 and now >= conn.send_by_ns) {
                    conn.expire()
                }
            }
        }
        return 0
    }

    // Ends `serve`, once the requests being read or answered are done or `within`
    // (`stop_timeout` when left out) has passed.
    func stop(self, within: Duration? = none) -> none {
        if self.stopping {
            return
        }
        self.stopping = true
        let limit = within? or self.stop_timeout
        self.stop_ns = time.monotonic_ns() + limit.ns
        for id in self.conns {
            let Some(conn) = self.conns[id] else { continue }
            if conn.phase is .Waiting {
                conn.expire()
            }
        }
        if self.acceptor is Some(task) {
            task.cancel()
        }
    }
}

// Answers the requests that come to `l` by `handler`, with a Server's settings
// left as they are.
func serve(anon l: tcp.Listener, anon handler: func(Request) -> Response or Error, limits: Limits = Limits()) -> none or Error {
    try Server(:handler, :limits).serve(l)
}
