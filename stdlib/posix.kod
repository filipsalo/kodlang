// File descriptors as streams, with the POSIX calls behind them. See docs/io.md.
import "stream" { IoError, os_error }
import "time" { Duration }
import "unsafe"

extern func kod_io_errno() -> int64
// open is variadic, which an extern can't call, so this stays C.
extern func kod_fd_open(anon path: str, anon mode: int64) -> int64
extern func kod_poll(anon fds: [int64], anon events: [int64], anon ready: [int64], anon timeout_ms: int64) -> int64
extern func read(anon fd: int64, anon buf: int64, anon n: int64) -> int64
extern func write(anon fd: int64, anon buf: int64, anon n: int64) -> int64
extern func close(anon fd: int64) -> int64
extern func isatty(anon fd: int64) -> int64

let EINTR: int64 = 4
// The most one `read` takes in.
let READ_MAX: int64 = 65536

// Where every `read` lands before it is copied out: allocated once, on the
// first read, and kept.
mut _read_buf: int64 = 0

type Fd = struct {
    fd: int64

    func read(self, anon max: int64) -> bytes or Error {
        if max <= 0 {
            return kod_str_to_bytes("")
        }
        mut want = max
        if want > READ_MAX {
            want = READ_MAX
        }
        if _read_buf == 0 {
            _read_buf = unsafe.alloc(READ_MAX)
        }
        for true {
            let n = read(self.fd, _read_buf, want)
            if n >= 0 {
                return unsafe.copy_out(_read_buf, n)
            }
            let err = unsafe.errno()
            if err != EINTR {
                throw os_error("read", errno: err)
            }
        }
        return kod_str_to_bytes("")
    }

    func write(self, anon data: bytes) -> int64 or Error {
        if len(data) == 0 {
            return 0
        }
        for true {
            let n = write(self.fd, unsafe.data(data), len(data))
            if n >= 0 {
                return n
            }
            let err = unsafe.errno()
            if err != EINTR {
                throw os_error("write", errno: err)
            }
        }
        return 0
    }

    // Closes it and sets `fd` to -1, so a second close fails instead of
    // closing whatever file reused the number.
    func close(self) -> none or Error {
        if unsafe.c_int(close(self.fd)) < 0 {
            throw os_error("close", errno: unsafe.errno())
        }
        self.fd = -1
    }

    // Whether it is a terminal, rather than a file or a pipe.
    func is_terminal(self) -> bool {
        return unsafe.c_int(isatty(self.fd)) != 0
    }
}

func open_with(anon path: str, anon mode: int64) -> Fd or Error {
    let fd = kod_fd_open(path, mode)
    if fd < 0 {
        throw os_error(f"open {path}", errno: kod_io_errno())
    }
    return Fd(fd: fd)
}

func open_read(anon path: str) -> Fd or Error {
    return try open_with(path, 0)
}

func create(anon path: str) -> Fd or Error {
    return try open_with(path, 1)
}

func append(anon path: str) -> Fd or Error {
    return try open_with(path, 2)
}

func stdin() -> Fd {
    return Fd(fd: 0)
}

func stdout() -> Fd {
    return Fd(fd: 1)
}

func stderr() -> Fd {
    return Fd(fd: 2)
}

// Which descriptors `poll` found ready, in the order it was given them.
type Ready = struct {
    read: [bool]
    write: [bool]
}

// Wait until a descriptor in `read` can be read or one in `write` written
// without waiting, or until `timeout` passes. See docs/io.md.
func poll(read: [Fd], write: [Fd] = [], timeout: Duration? = none) -> Ready or Error {
    mut fds: [int64] = []
    mut events: [int64] = []
    mut codes: [int64] = []
    mut live = 0
    for f in read {
        fds += [f.fd]
        events += [1]
        codes += [0]
        if f.fd >= 0 {
            live += 1
        }
    }
    for f in write {
        fds += [f.fd]
        events += [2]
        codes += [0]
        if f.fd >= 0 {
            live += 1
        }
    }
    if live == 0 {
        throw IoError(kind: .InvalidInput, op: "poll", errno: 0, detail: "nothing to wait for")
    }
    mut ms = -1
    if timeout is Duration(t) {
        ms = t.ceil_ms()
        if ms < 0 {
            ms = 0
        }
    }
    if kod_poll(fds, events, codes, ms) < 0 {
        throw os_error("poll", errno: kod_io_errno())
    }
    mut out = Ready(read: [], write: [])
    for i, code in codes {
        if i < len(read) {
            out.read += [code != 0]
        } else {
            out.write += [code != 0]
        }
    }
    return out
}
