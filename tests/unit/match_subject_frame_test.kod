// Each match keeps its subject in its own stack slot, so a later match on a
// str still sees its subject after the calls that compare it to each arm.
type Color = enum { Red  Green  Blue }

mut log: [str] = []

func describe(anon c: Color, anon s: str) -> str {
    match c {
        .Red -> log += ["red"]
        else -> log += ["not red"]
    }
    match c {
        .Green -> log += ["green"]
        else -> log += ["not green"]
    }
    let n = match c {
        .Blue -> 3
        else -> 0
    }
    let .Red = c else {
        log += [f"blue is {n}"]
        match s {
            "aa" -> return "is aa"
            "bb" -> return "is bb"
            else -> return "other"
        }
    }
    match s {
        "aa" -> return "is aa"
        "bb" -> return "is bb"
        "cc" -> return "is cc"
        else -> return "other"
    }
}

test "each match keeps its own subject" {
    assert describe(.Red, "cc") == "is cc"
    assert log == ["red", "not green"]
    assert describe(.Blue, "bb") == "is bb"
    assert log == ["red", "not green", "not red", "not green", "blue is 3"]
}
