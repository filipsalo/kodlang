// A module whose variables tests/module_vars.kod reads and changes through functions.

mut hits: int64 = 0
mut names: [str] = []
mut _secret: str = "hidden"

// Worked out at first use, so this prints when the importer first reads `greeting`.
mut greeting: str = announce()

func announce() -> str {
    print("greeting worked out")
    return "hello"
}

mut transform: func(int64) -> int64 = twice

func twice(anon n: int64) -> int64 {
    return n * 2
}

func use_square() -> none {
    transform = func(n: int64) -> int64 { return n * n }
}

func hit(anon name: str) -> int64 {
    hits += 1
    names += [name]
    return hits
}

func secret() -> str {
    return _secret
}

func set_secret(anon s: str) -> none {
    _secret = s
}

// expected mode:
// skip
