// `.Variant(...)` takes its enum from where the value goes.
type Message = enum {
    Quit
    Text(content: str)
}

type Holder = struct {
    m: Message
}

func show(anon m: Message) -> none {
    match m {
        .Quit -> print("quit")
        .Text(content) -> print(content)
    }
}

func make() -> Message {
    return .Text(content: "return")
}

func main() -> int64 {
    let a: Message = .Text(content: "let")
    show(a)
    show(.Text(content: "argument"))
    show(make())
    let h = Holder(m: .Text(content: "field"))
    show(h.m)
    h.m = .Text(content: "field assignment")
    show(h.m)
    mut b: Message = .Quit
    b = .Text(content: "assignment")
    show(b)
    let ms: [Message] = [.Text(content: "element"), .Quit]
    for m in ms {
        show(m)
    }
    let k = 1
    let c: Message = match k {
        1 -> .Text(content: "match arm")
        else -> .Quit
    }
    show(c)
    let u = .Text(content: "unannotated")
    show(u)
    return 0
}

// expected output:
// let
// argument
// return
// field
// field assignment
// assignment
// element
// quit
// match arm
// unannotated
