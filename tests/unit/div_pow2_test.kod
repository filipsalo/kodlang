// `/` and `%` by a power of two literal round toward zero, as by any other number.

// x / d and x % d for d = 2, 4, 1024 and 2**62.
func divs(anon x: int64) -> [int64] {
    return [
        x / 2, x % 2,
        x / 4, x % 4,
        x / 1024, x % 1024,
        x / 4611686018427387904, x % 4611686018427387904,
    ]
}

test "/ and % by a power of two round toward zero" {
    assert divs(0) == [0, 0, 0, 0, 0, 0, 0, 0]
    assert divs(1) == [0, 1, 0, 1, 0, 1, 0, 1]
    assert divs(-1) == [0, -1, 0, -1, 0, -1, 0, -1]
    assert divs(5) == [2, 1, 1, 1, 0, 5, 0, 5]
    assert divs(-5) == [-2, -1, -1, -1, 0, -5, 0, -5]
    assert divs(7) == [3, 1, 1, 3, 0, 7, 0, 7]
    assert divs(-7) == [-3, -1, -1, -3, 0, -7, 0, -7]
    assert divs(1023) == [511, 1, 255, 3, 0, 1023, 0, 1023]
    assert divs(-1023) == [-511, -1, -255, -3, 0, -1023, 0, -1023]
    assert divs(1024) == [512, 0, 256, 0, 1, 0, 0, 1024]
    assert divs(-1024) == [-512, 0, -256, 0, -1, 0, 0, -1024]
    assert divs(9223372036854775807) == [4611686018427387903, 1, 2305843009213693951, 3, 9007199254740991, 1023, 1, 4611686018427387903]
    assert divs(-9223372036854775807) == [-4611686018427387903, -1, -2305843009213693951, -3, -9007199254740991, -1023, -1, -4611686018427387903]
    assert divs(-9223372036854775807 - 1) == [-4611686018427387904, 0, -2305843009213693952, 0, -9007199254740992, 0, -2, 0]
}
