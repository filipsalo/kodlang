// A prefix `-` takes the whole call, so the smallest int64 can't be its receiver.
func main() -> int64 {
    print(-9223372036854775808.to_str())
    return 0
}

// expected errors:
// 3:12: error: integer literal `9223372036854775808` doesn't fit in `int64`, whose largest value is 9223372036854775807; the `-` negates the whole expression after it, so write `(-9223372036854775808)` for the smallest `int64`
