// A match statement written on one line.
type Dir = enum {
    North
    South
}

func name(anon n: int64) -> str {
    match n { 1 -> return "one" 2 -> return "two" else -> return "many" }
}

test "match statements on one line" {
    let d: Dir = .North
    mut seen: [str] = []
    match d { .North -> seen += ["north"] else none }
    match d { .South -> seen += ["south"] else -> seen += ["not south"] }
    assert seen == ["north", "not south"]
}

test "a one-line match with returns" {
    assert name(1) == "one"
    assert name(2) == "two"
    assert name(7) == "many"
}
