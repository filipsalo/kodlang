import "io"
import "net/tcp"
import "net/tls" { Identity, PemBlock, TlsStream, accept, connect, key_data, load_identity, parse_pem }
import "process"
import "stream" { IoError, IoKind, BufReader }
import "time" { Duration }
import "time"

// These tests run `openssl s_server` from macOS's own /usr/bin/openssl, on a
// throwaway self-signed certificate for `localhost`.

func cert_path() -> str {
    return "build/tls_test_cert.pem"
}

func key_path() -> str {
    return "build/tls_test_key.pem"
}

func s(anon x: bytes) -> str {
    return kod_bytes_to_str(x)
}

func make_certificate() -> none {
    if io.is_file(cert_path()) and io.is_file(key_path()) {
        return
    }
    let r = process.run(["/usr/bin/openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout", key_path(), "-out", cert_path(), "-subj", "/CN=localhost", "-days", "30", "-addext", "subjectAltName=DNS:localhost", "-addext", "extendedKeyUsage=serverAuth"])
    assert r.status == 0
}

type Server = shared struct {
    pid: int64
    port: int64
}

// The command line of `openssl s_server -www` on `port`; the perl wrapper stops
// it after two minutes if a test dies.
func s_server(anon port: int64, version: str) -> [str] {
    return ["perl", "-e", "alarm 120; exec @ARGV", "/usr/bin/openssl", "s_server", "-accept", f"{port}", "-cert", cert_path(), "-key", key_path(), "-www", "-quiet", version]
}

// Starts `s_server -www` on a free port, with `version` ("-tls1_2" or
// "-tls1_3").
func start_server(anon version: str) -> Server {
    make_certificate()
    let l = must tcp.listen("127.0.0.1", port: 0)
    let port = l.port()
    must l.close()
    let pid = (must process.start(s_server(port, version: version), stdin: .Null, stdout: .Null, stderr: .Null)).pid
    mut tries: int64 = 0
    for tries < 100 {
        let c = tcp.connect("127.0.0.1", port: port)
        if c is Ok(conn) {
            must conn.close()
            return Server(pid: pid, port: port)
        }
        time.sleep(Duration(ms: 50))
        tries = tries + 1
    }
    assert false
    return Server(pid: pid, port: port)
}

func stop(anon sv: Server) -> none {
    process.kill(sv.pid)
}

func kind_of(anon r: TlsStream or Error) -> IoKind? {
    if r is Err(e) {
        if e is IoError(io_err) {
            return io_err.kind
        }
        return .Other
    }
    return none
}

func is_kind(anon r: TlsStream or Error, anon want: IoKind) -> bool {
    let k = kind_of(r)
    if k is none {
        return false
    }
    return k == want
}

test "a request over TLS gets the server's answer" {
    let sv = start_server("-tls1_2")
    let conn = must connect("localhost", port: sv.port, trust_file: cert_path())
    must conn.write_str("GET / HTTP/1.0\r\n\r\n")
    let answer = s(must conn.read_all())
    assert answer.starts_with("HTTP/1.0 200 ok")
    assert answer.contains("</HTML>")
    must conn.close()
    stop(sv)
}

test "a BufReader reads lines over TLS" {
    let sv = start_server("-tls1_2")
    let conn = must connect("localhost", port: sv.port, trust_file: cert_path())
    must conn.write_str("GET / HTTP/1.0\r\n\r\n")
    let br = BufReader(inner: conn)
    assert ((must br.read_line())? or "!") == "HTTP/1.0 200 ok"
    must conn.close()
    stop(sv)
}

test "a certificate that is not trusted fails with a Tls error" {
    let sv = start_server("-tls1_2")
    let r = connect("localhost", port: sv.port)
    assert is_kind(r, .Tls)
    stop(sv)
}

test "a certificate for another name fails with a Tls error" {
    let sv = start_server("-tls1_2")
    let r = connect("127.0.0.1", port: sv.port, trust_file: cert_path())
    assert is_kind(r, .Tls)
    stop(sv)
}

test "a trust_file that is missing or holds no certificate is an error" {
    let sv = start_server("-tls1_2")
    assert connect("localhost", port: sv.port, trust_file: "build/no_such_file.pem") is Err(_)
    assert connect("localhost", port: sv.port, trust_file: key_path()) is Err(_)
    stop(sv)
}

test "a server that only speaks TLS 1.3 fails with a Tls error" {
    let sv = start_server("-tls1_3")
    let r = connect("localhost", port: sv.port, trust_file: cert_path())
    assert is_kind(r, .Tls)
    stop(sv)
}

test "a server that does not speak TLS fails" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let r = connect("127.0.0.1", port: l.port(), trust_file: "", timeout: Duration(ms: 300))
    assert r is Err(_)
    must l.close()
}

test "a silent server times the handshake out" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let r = connect("127.0.0.1", port: l.port(), trust_file: "", timeout: Duration(ms: 200))
    assert is_kind(r, .TimedOut)
    must l.close()
}

test "a refused connection is ConnectionRefused" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let port = l.port()
    must l.close()
    assert is_kind(connect("localhost", port: port), .ConnectionRefused)
}

test "a read times out after set_timeout" {
    let sv = start_server("-tls1_2")
    let conn = must connect("localhost", port: sv.port, trust_file: cert_path())
    must conn.set_timeout(timeout: Duration(ms: 150))
    let r = conn.read(10)
    assert r is Err(_)
    if r is Err(e) {
        if e is IoError(io_err) {
            assert io_err.kind == .TimedOut
        }
    }
    must conn.close()
    stop(sv)
}

test "closing twice or writing after close is an error, not a crash" {
    let sv = start_server("-tls1_2")
    let conn = must connect("localhost", port: sv.port, trust_file: cert_path())
    must conn.close()
    assert conn.close() is Err(_)
    assert conn.write(kod_str_to_bytes("x")) is Err(_)
    assert conn.read(10) is Err(_)
    stop(sv)
}

// ---- the server's side ----

func run_openssl(anon args: [str]) -> none {
    let r = process.run(["/usr/bin/openssl"] + args)
    assert r.status == 0
}

func write(anon path: str, anon content: str) -> none {
    assert io.write_file(path, content) == 0
}

// Why `load_identity` fails, or "ok".
func loading(anon cert: str, anon key: str) -> str {
    let got = load_identity(cert, key)
    if got is Err(e) {
        if e is IoError(io_err) {
            return io_err.detail
        }
        return e.to_str()
    }
    got.close()
    got.close()
    return "ok"
}

test "load_identity: the forms a key comes in, and what isn't one" {
    make_certificate()
    let dir = "build/tls_identity"
    let _ = process.run(["mkdir", "-p", dir])
    run_openssl(["rsa", "-in", key_path(), "-out", f"{dir}/pkcs1.pem"])
    run_openssl(["rsa", "-in", key_path(), "-aes128", "-passout", "pass:abcd", "-out", f"{dir}/locked1.pem"])
    run_openssl(["pkcs8", "-topk8", "-in", key_path(), "-passout", "pass:abcd", "-out", f"{dir}/locked8.pem"])
    for curve in ["prime256v1", "secp384r1", "secp521r1"] {
        run_openssl(["ecparam", "-name", curve, "-genkey", "-noout", "-out", f"{dir}/{curve}.sec1"])
        run_openssl(["pkcs8", "-topk8", "-nocrypt", "-in", f"{dir}/{curve}.sec1", "-out", f"{dir}/{curve}.key"])
        run_openssl(["req", "-x509", "-new", "-key", f"{dir}/{curve}.key", "-out", f"{dir}/{curve}.crt", "-subj", "/CN=localhost", "-days", "30"])
        assert loading(f"{dir}/{curve}.crt", f"{dir}/{curve}.sec1") == "ok"
        assert loading(f"{dir}/{curve}.crt", f"{dir}/{curve}.key") == "ok"
        assert loading(f"{dir}/{curve}.crt", key_path()) == "isn't the key of the certificate"
    }
    assert loading(cert_path(), key_path()) == "ok"
    assert loading(cert_path(), f"{dir}/pkcs1.pem") == "ok"
    assert loading(cert_path(), f"{dir}/prime256v1.key") == "isn't the key of the certificate"
    assert loading(cert_path(), f"{dir}/locked8.pem") == "is encrypted"
    assert loading(cert_path(), f"{dir}/locked1.pem") != "ok"
    assert loading(cert_path(), cert_path()) == "holds no private key"
    assert loading(key_path(), key_path()) == "holds no certificate"
    assert loading("build/none.pem", key_path()).contains("No such file")
    // One file with it all, among other text.
    write(f"{dir}/all.pem", "some words\n" + (must io.read_file(key_path())) + "\nmore\n" + (must io.read_file(cert_path())).replace("\n", to: "\r\n"))
    assert loading(f"{dir}/all.pem", f"{dir}/all.pem") == "ok"
    write(f"{dir}/cut.pem", (must io.read_file(key_path()))[0..200])
    assert loading(cert_path(), f"{dir}/cut.pem") == "the PRIVATE KEY has no end"
    write(f"{dir}/bad64.pem", "-----BEGIN CERTIFICATE-----\n!!!\n-----END CERTIFICATE-----\n")
    assert loading(f"{dir}/bad64.pem", key_path()) == "the CERTIFICATE isn't base64"
    write(f"{dir}/notx509.pem", "-----BEGIN CERTIFICATE-----\naGVsbG8=\n-----END CERTIFICATE-----\n")
    assert loading(f"{dir}/notx509.pem", key_path()) == "isn't an X.509 certificate"
    write(f"{dir}/notkey.pem", "-----BEGIN PRIVATE KEY-----\naGVsbG8=\n-----END PRIVATE KEY-----\n")
    assert loading(cert_path(), f"{dir}/notkey.pem") == "isn't an RSA or EC private key"
    write(f"{dir}/notrsa.pem", "-----BEGIN RSA PRIVATE KEY-----\naGVsbG8=\n-----END RSA PRIVATE KEY-----\n")
    assert loading(cert_path(), f"{dir}/notrsa.pem") == "isn't a valid key"
}

test "keys that are cut short or changed are refused, not trusted" {
    make_certificate()
    let _ = process.run(["mkdir", "-p", "build/tls_identity"])
    run_openssl(["ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", "build/tls_identity/f.sec1"])
    run_openssl(["pkcs8", "-topk8", "-nocrypt", "-in", "build/tls_identity/f.sec1", "-out", "build/tls_identity/f.key"])
    mut seed: int64 = 3
    for path in [key_path(), "build/tls_identity/f.sec1", "build/tls_identity/f.key"] {
        for block in must parse_pem((must io.read_file(path)), op: "test") {
            let whole = key_data(block)
            assert block.label == "EC PARAMETERS" or whole is not none
            for n in 0..len(block.data) {
                if n < 80 or n % 37 == 0 {
                    let _ = key_data(PemBlock(label: block.label, data: block.data[0..n]))
                }
            }
            for _i in 0..2000 {
                seed = (seed * 1103515245 + 12345) % 2147483648
                let at = (seed / 65536) % len(block.data)
                seed = (seed * 1103515245 + 12345) % 2147483648
                let changed = block.data[0..at] + kod_bytes_from_array([(seed / 65536) % 256]) + block.data[at + 1..len(block.data)]
                let _ = key_data(PemBlock(label: block.label, data: changed))
            }
        }
    }
}

func echo_once(anon l: tcp.Listener, anon identity: Identity, nonblocking: bool = false) -> str {
    let got = accept(must l.accept(:nonblocking), identity)
    if got is Err(e) {
        return e.to_str()
    }
    mut n = 0
    for true {
        let data = must got.read(65536)
        if len(data) == 0 {
            break
        }
        n += len(data)
        must got.write_all(data)
    }
    must got.close()
    return f"{n}"
}

func read_so_many(anon c: TlsStream, anon want: int64) -> int64 {
    mut n: int64 = 0
    for n < want {
        n += len(must c.read(65536))
    }
    return n
}

test "accept and connect, reading and writing at the same time" {
    make_certificate()
    let identity = must load_identity(cert_path(), key_path())
    let l = must tcp.listen("127.0.0.1", port: 0)
    mut piece = "0123456789"
    for len(piece) < 100000 {
        piece += piece
    }
    for nonblocking in [false, true] {
        let serving = spawn echo_once(l, identity, :nonblocking)
        let c = must connect("localhost", port: l.port(), trust_file: cert_path())
        let reading = spawn read_so_many(c, 30 * len(piece))
        for _i in 0..30 {
            must c.write_str(piece)
        }
        assert reading.wait() == 30 * len(piece)
        must c.close()
        assert serving.wait() == f"{30 * len(piece)}"
    }
    identity.close()
    must l.close()
}

func accept_and_close(anon l: tcp.Listener, anon identity: Identity) -> str {
    let conn = must l.accept(nonblocking: true)
    let s = must accept(conn, identity)
    must s.close()
    // The connection was the stream's: its number may be another's now.
    let again = conn.close()
    if again is Err(e) {
        return e.to_str()
    }
    return "closed twice"
}

test "a stream closes its connection, once" {
    make_certificate()
    let identity = must load_identity(cert_path(), key_path())
    let l = must tcp.listen("127.0.0.1", port: 0)
    let serving = spawn accept_and_close(l, identity)
    let c = must connect("localhost", port: l.port(), trust_file: cert_path())
    assert len(must c.read(10)) == 0
    must c.close()
    assert c.close() is Err(_)
    assert serving.wait() == "close: Bad file descriptor"
    identity.close()
    must l.close()
}

func read_error(anon c: TlsStream) -> str {
    let got = c.read(100)
    if got is Err(e) {
        return e.to_str()
    }
    return "read"
}

test "a stream closed by another task while it is read" {
    make_certificate()
    let identity = must load_identity(cert_path(), key_path())
    let l = must tcp.listen("127.0.0.1", port: 0)
    let serving = spawn echo_once(l, identity)
    let c = must connect("localhost", port: l.port(), trust_file: cert_path())
    let reading = spawn read_error(c)
    time.sleep(Duration(ms: 30))
    must c.close()
    assert reading.wait() == "read: connection is closed"
    assert serving.wait() == "0"
    identity.close()
    must l.close()
}

test "accept without an identity, or with one that is closed" {
    make_certificate()
    let identity = must load_identity(cert_path(), key_path())
    identity.close()
    let l = must tcp.listen("127.0.0.1", port: 0)
    let serving = spawn echo_once(l, identity)
    assert connect("localhost", port: l.port(), trust_file: cert_path()) is Err(_)
    assert serving.wait() == "tls accept: connection is closed"
    must l.close()
}
