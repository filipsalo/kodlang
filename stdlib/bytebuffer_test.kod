import "bytebuffer" { ByteBuffer }
import "testing"

test "push and push_bytes add bytes, at reads them back" {
    let out = ByteBuffer()
    assert out.len() == 0
    out.push(0x41)
    out.push(0x1ff)
    out.push(-1)
    out.push_bytes(b"xyz")
    out.push_bytes(b"")
    assert out.len() == 6
    assert out.at(0) == 0x41
    assert out.at(1) == 0xff
    assert out.at(2) == 0xff
    assert out.at(5) == 0x7a
    assert out.to_bytes() == kod_bytes_from_array([0x41, 0xff, 0xff, 0x78, 0x79, 0x7a])
}

test "the buffer grows past its first capacity and keeps what it held" {
    let out = ByteBuffer()
    for i in 0..100000 {
        out.push(i)
    }
    assert out.len() == 100000
    for i in [0, 31, 32, 33, 4095, 65536, 99999] {
        assert out.at(i) == (i & 0xff)
    }
}

test "copy_back repeats the last `distance` bytes, at every distance and length" {
    // Distances under 8 and from 8 up, lengths that end inside a word.
    for distance in 1..20 {
        for length in [0, 1, 7, 8, 9, 15, 16, 17, 258] {
            let out = ByteBuffer()
            mut want: [int64] = []
            for i in 0..distance + 3 {
                out.push(i * 7 + distance)
                want += [(i * 7 + distance) & 0xff]
            }
            out.copy_back(:distance, :length)
            for _ in 0..length {
                want += [want[len(want) - distance]]
            }
            // A byte after the copy lands after it, not on bytes it wrote past its end.
            out.push(0xee)
            want += [0xee]
            if out.to_bytes() != kod_bytes_from_array(want) {
                fail(f"distance {distance}, length {length}")
            }
        }
    }
}

test "copy_back across a growth of the buffer" {
    let out = ByteBuffer()
    out.push_bytes(b"0123456789")
    for _ in 0..1000 {
        out.copy_back(distance: 10, length: 258)
    }
    assert out.len() == 10 + 258000
    assert out.at(258009) == 0x39
    assert kod_bytes_to_str(out.to_bytes()).starts_with("01234567890123")
}

test "to_bytes is a copy; the buffer stays usable" {
    let out = ByteBuffer()
    out.push_bytes(b"ab")
    let first = out.to_bytes()
    out.push_bytes(b"cd")
    assert first == b"ab"
    assert out.to_bytes() == b"abcd"
}

test "copies of a ByteBuffer share one buffer" {
    let a = ByteBuffer()
    let b = a
    b.push(1)
    assert a.len() == 1
}

test "at outside 0..len() panics" {
    for i in [-1, 3] {
        let r = testing.run(func() {
            let out = ByteBuffer()
            out.push_bytes(b"abc")
            print_int(out.at(i))
        })
        assert r.status == 1
        assert r.stderr.contains(f"panic: index {i} out of bounds for buffer of length 3")
    }
}

test "copy_back panics for a distance outside 1..len() or a negative length" {
    for distance in [0, 4, -1] {
        let r = testing.run(func() {
            let out = ByteBuffer()
            out.push_bytes(b"abc")
            out.copy_back(:distance, length: 2)
        })
        assert r.status == 1
        assert r.stderr.contains(f"panic: copy_back distance {distance} out of range for buffer of length 3")
    }
    let r = testing.run(func() {
        let out = ByteBuffer()
        out.push_bytes(b"abc")
        out.copy_back(distance: 1, length: -1)
    })
    assert r.status == 1
    assert r.stderr.contains("panic: copy_back length -1 is negative")
}

test "push_le adds the low bytes of a value, lowest first" {
    let out = ByteBuffer()
    out.push_le(0x0807060504030201, size: 8)
    out.push_le(0x1234, size: 2)
    out.push_le(-1, size: 3)
    out.push_le(0x55, size: 0)
    out.push(0x99)
    assert out.to_bytes() == kod_bytes_from_array([1, 2, 3, 4, 5, 6, 7, 8, 0x34, 0x12, 0xff, 0xff, 0xff, 0x99])
    for size in [1, 4, 8] {
        let grown = ByteBuffer()
        for i in 0..10000 {
            grown.push_le(i, :size)
        }
        assert grown.len() == 10000 * size
        assert grown.at(9999 * size) == (9999 & 0xff)
    }
}

test "push_buffer adds another buffer's bytes, itself too" {
    let a = ByteBuffer()
    a.push_bytes(b"ab")
    let b = ByteBuffer()
    b.push_bytes(b"cd")
    a.push_buffer(b)
    a.push_buffer(ByteBuffer())
    assert a.to_bytes() == b"abcd"
    assert b.to_bytes() == b"cd"
    a.push_buffer(a)
    assert a.to_bytes() == b"abcdabcd"
}

test "set replaces a byte" {
    let out = ByteBuffer()
    out.push_bytes(b"abc")
    out.set(1, 0x158)
    assert out.to_bytes() == b"aXc"
}

test "set outside 0..len() and push_le outside 0..8 panic" {
    for i in [-1, 3] {
        let r = testing.run(func() {
            let out = ByteBuffer()
            out.push_bytes(b"abc")
            out.set(i, 0)
        })
        assert r.status == 1
        assert r.stderr.contains(f"panic: index {i} out of bounds for buffer of length 3")
    }
    for size in [-1, 9] {
        let r = testing.run(func() {
            ByteBuffer().push_le(1, :size)
        })
        assert r.status == 1
        assert r.stderr.contains(f"panic: push_le size {size} out of range 0..8")
    }
}

test "drop_front and slice" {
    let b = ByteBuffer()
    b.push_bytes(b"abcdefghij")
    assert b.slice(2, 5) == b"cde"
    assert b.slice(0, 10) == b"abcdefghij"
    assert b.slice(10, 10) == b""
    b.drop_front(0)
    b.drop_front(3)
    assert b.to_bytes() == b"defghij"
    b.copy_back(distance: 7, length: 3)
    assert b.to_bytes() == b"defghijdef"
    b.drop_front(10)
    assert b.len() == 0
    b.push('x')
    assert b.to_bytes() == b"x"
}

test "drop_front and slice outside the buffer panic" {
    for bad in [-1, 4] {
        let r = testing.run(func() {
            let b = ByteBuffer()
            b.push_bytes(b"abc")
            b.drop_front(bad)
        })
        assert r.status == 1
    }
    for bad in [[-1, 2], [2, 1], [0, 4]] {
        let r = testing.run(func() {
            let b = ByteBuffer()
            b.push_bytes(b"abc")
            let _ = b.slice(bad[0], bad[1])
        })
        assert r.status == 1
    }
}
