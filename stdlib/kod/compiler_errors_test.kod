test "conditions must be bool" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n = 7
            let o: int64? = 5
            if n {
                print("n")
            }
            for o {
                break
            }
            assert n
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "an `if` condition must be a `bool`, got `int64`")
    assert test_support.any_message_contains(errs, needle: "a `for` condition must be a `bool`, got `int64?`; test it with `is not none`")
    assert test_support.any_message_contains(errs, needle: "`assert` needs a `bool`, got `int64`")
}

test "bool and int64 don't mix" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let b = true
            if b == 1 {
                print("b")
            }
            let z = true + 1
            let q = b < true
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool` with `int64`")
    assert test_support.any_message_contains(errs, needle: "`+` doesn't take `bool` operands")
    assert test_support.any_message_contains(errs, needle: "`<` doesn't take `bool` operands")
}

test "a bit test without parentheses explains the precedence" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let flags = 5
            if flags & 1 != 0 {
                print("odd")
            }
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "`&` doesn't take `bool` operands; `!=` binds tighter than `&`, so write `(a & b) != c`")
}

test "operators need operands of one type they take" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum { Red Green }
        func main() -> int64 {
            let s = "abc"
            let t = "x"
            let b = b"xy"
            let xs: [int64] = [1, 2]
            let c = Color.Red
            let d = Color.Green
            let m = Map[str, int64]()
            mut n = 1
            let a1 = "a" + 5
            let a2 = 5 + "a"
            let a3 = s - t
            let a4 = xs * 2
            let a5 = -s
            let a6 = s + b
            let a7 = c < d
            let a8 = s < 3
            n += "a"
            let a9 = xs["a"]
            let a10 = xs[true]
            let a11 = xs[m.get("k")]
            let a12 = s[0.."a"]
            xs["b"] = 3
            let a13 = 5 + xs
            let a14 = 1 < s < 3
            return 0
        }
        """)
    assert len(errs) == 16
    assert errs[0].message == "error: cannot add `str` and `int64`; convert with `str(...)` or use an f-string"
    assert errs[0].line == 11
    assert errs[0].col == 20
    assert errs[1].message == "error: cannot add `int64` and `str`; convert with `str(...)` or use an f-string"
    assert errs[1].col == 14
    assert errs[2].message == "error: `-` needs `int64` operands, got `str`"
    assert errs[2].col == 14
    assert errs[3].message == "error: `*` needs `int64` operands, got `[int64]`"
    assert errs[4].message == "error: `-` needs `int64` operands, got `str`"
    assert errs[4].col == 15
    assert errs[5].message == "error: cannot add `str` and `bytes`"
    assert errs[6].message == "error: `<` doesn't take `Color` operands"
    assert errs[7].message == "error: cannot compare `str` with `int64`"
    assert errs[8].message == "error: cannot add `int64` and `str`"
    assert errs[8].col == 10
    assert errs[9].message == "error: an index must be `int64`, got `str`"
    assert errs[10].message == "error: an index must be `int64`, got `bool`"
    assert errs[11].message == "error: an index must be `int64`, got `int64?`; unwrap it first with `?` or `? or default`"
    assert errs[12].message == "error: a slice bound must be `int64`, got `str`"
    assert errs[13].message == "error: an index must be `int64`, got `str`"
    assert errs[13].line == 24
    assert errs[14].message == "error: cannot add `int64` and `[int64]`"
    assert errs[15].message == "error: cannot compare `int64` with `str`"
    assert errs[15].col == 19
}

test "a prefix `-` on a call of an int64's method suggests parentheses" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type P = struct {
            x: int64
            name: str
            func get(self) -> int64 { return self.x }
        }
        func main() -> int64 {
            let n = 5
            let p = P(x: 1, name: "a")
            let xs = [1, 2]
            print(-n.to_str())
            print(-xs[0].to_str())
            let s = -p.get().to_str()
            print(s + "!")
            let ys = -xs
            print_int(len(ys))
            print(-p.name)
            return 0
        }
        """)
    assert len(errs) == 5
    assert errs[0].message == "error: `-` needs `int64` operands, got `str`; write `(-n).to_str()` to negate `n` first"
    assert errs[0].line == 10
    assert errs[0].col == 12
    assert errs[1].message == "error: `-` needs `int64` operands, got `str`; write `(-xs[0]).to_str()` to negate `xs[0]` first"
    assert errs[2].message == "error: `-` needs `int64` operands, got `str`; write `(-p.get()).to_str()` to negate `p.get()` first"
    assert errs[3].message == "error: `-` needs `int64` operands, got `[int64]`"
    assert errs[3].line == 14
    assert errs[4].message == "error: `-` needs `int64` operands, got `str`"
    assert errs[4].line == 16
}

test "operators on operands of one type they take compile cleanly" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let a = 1
            let b = 2
            let c = 3
            let s = "m"
            let x = 4
            mut n = 10
            let k = 2
            let xs = [1, 2, 3]
            let bs = b"ab" + b"cd"
            mut out = ""
            out += s
            let ok1 = a < b < c
            let ok2 = "a" < s < "z"
            let ok3 = bs < b"zz"
            n -= 1
            let sh = (1 << k) | (n >> 1) ^ (n & 3)
            let neg = -x
            let last = xs[-1]
            let sub = xs[1..]
            let pre = s[..1]
            let mid = bs[a..len(bs)]
            xs[0] = n * 2 / 3 % 5
            return neg + last + sh + len(sub) + len(pre) + len(mid) + bs[0] + s[0]
        }
        """)
    assert len(errs) == 0
}

test "`==` compares only values of one type that has an `==`" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Tag = enum { A B }
        type Shape = enum { Circle(r: int64) Dot }
        type Maybe = enum { Just(value: int64) Nothing }
        type Pt = struct { x: int64 }
        type Qt = struct { y: int64 }
        interface Area { func area(self) -> int64 }
        type Sq = struct { s: int64  func area(self) -> int64 { return self.s } }
        func f() -> none { }
        func pick(anon n: int64) -> Maybe { return .Just(value: n) }
        func main() -> int64 {
            let tag = Tag.A
            let shape = Shape.Dot
            let xs = [1]
            let ys = [2]
            let p = Pt(x: 1)
            let q = Qt(y: 1)
            let a: Area = Sq(s: 1)
            let b: Area = Sq(s: 2)
            let r1 = tag == shape
            let r2 = tag == .Nope
            let r3 = xs == []
            let r4 = xs != ys
            let r5 = p == q
            let r6 = p == p
            let r7 = f() == 0
            let r8 = a == b
            let r9 = pick(1) == .Just(value: 2)
            let r10 = shape == shape
            let r11 = main == main
            let r12 = "a" == 1
            let r13 = .Dot != tag
            let r14 = Maybe.Just(value: 1) != pick(2)
            return 0
        }
        """)
    assert len(errs) == 14
    assert errs[0].message == "error: cannot compare `Tag` with `Shape`"
    assert errs[0].line == 19
    assert errs[0].col == 21
    assert errs[1].message == "error: enum `Tag` has no variant `Nope`"
    assert errs[1].col == 21
    assert errs[2].message == "error: `==` doesn't compare arrays; compare `len(...)` and the elements"
    assert errs[3].message == "error: `!=` doesn't compare arrays; compare `len(...)` and the elements"
    assert errs[4].message == "error: `==` doesn't compare structs; compare their fields"
    assert errs[5].message == "error: `==` doesn't compare structs; compare their fields"
    assert errs[6].message == "error: cannot compare `none` with `int64`"
    assert errs[6].col == 14
    assert errs[7].message == "error: `==` doesn't compare interface values"
    assert errs[8].message == "error: cannot compare with `.Just(...)`, which has a payload; test it with `is .Just(value)`"
    assert errs[8].col == 25
    assert errs[9].message == "error: cannot compare two `Shape` values; some of its variants have payloads, so test the variant with `is` or `match`"
    assert errs[10].message == "error: `==` doesn't compare function values"
    assert errs[11].message == "error: cannot compare `str` with `int64`"
    assert errs[12].message == "error: enum `Tag` has no variant `Dot`"
    assert errs[12].col == 15
    assert errs[13].message == "error: cannot compare with `.Just(...)`, which has a payload; test it with `is .Just(value)`"
    assert errs[13].col == 15
}

test "`==` on values of one type that has an `==` compiles cleanly" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Dir = enum { Up Down }
        type Move = enum { Step(d: Dir) Stay }
        type Maybe[T] = enum { Just(value: T) Nothing }
        func main() -> int64 {
            let d = Dir.Up
            let e = Dir.Down
            let m = Move.Stay
            let n: Maybe[int64] = .Nothing
            let s = "x"
            let b = true
            let by = b"ab"
            let opt: int64? = 3
            let counts = Map[str, int64]()
            counts["a"] = 1
            mut hits = 0
            if d == e or d != .Down or .Up == d or Dir.Up == e {
                hits += 1
            }
            if m == .Stay or m != Move.Stay or n == .Nothing or .Nothing != n {
                hits += 1
            }
            if s == "x" and b == true and by != b"zz" and opt != none and none == opt and hits == 2 {
                hits += 1
            }
            return hits + counts["a"]? + len(counts)
        }
        """)
    assert len(errs) == 0
}

test "a Map key and a hashed value must be hashable" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum { Circle(r: int64) Dot }
        type Sq = struct { s: int64 }
        type Holder = struct { m: Map[Sq, int64] }
        type ByShape = Map[Shape, str]
        func main() -> int64 {
            let a = Map[[int64], int64]()
            let b: Map[int64?, str] = Map[int64?, str]()
            let c = Map[str, Map[[str], int64]]()
            let again = Map[[int64], str]()
            let h = Holder(m: Map[Sq, int64]())
            let xs = [1]
            let h1 = hash(xs)
            let h2 = hash(Shape.Dot)
            return hash(h)
        }
        """)
    assert len(errs) == 8
    assert errs[0].message == "error: `Sq` can't be a `Map` key; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[0].line == 3
    assert errs[0].col == 31
    assert errs[1].message == "error: `Shape` can't be a `Map` key; some of its variants have payloads; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[1].line == 4
    assert errs[1].col == 20
    assert errs[2].message == "error: `[int64]` can't be a `Map` key; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[2].line == 6
    assert errs[2].col == 17
    assert errs[3].message == "error: `int64?` can't be a `Map` key; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[3].line == 7
    assert errs[3].col == 16
    assert errs[4].message == "error: `[str]` can't be a `Map` key; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[4].line == 8
    assert errs[5].message == "error: cannot hash a value of type `[int64]`; hashable values are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[5].line == 12
    assert errs[5].col == 19
    assert errs[6].message == "error: cannot hash a value of type `Shape`; some of its variants have payloads; hashable values are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[7].message == "error: cannot hash a value of type `Holder`; hashable values are `int64`, `str`, `bytes`, `bool` or enums without payloads"
}

test "a Set element must be hashable" {
    let r: process.ProcessResult = test_support.compile_source("""
        import "set"
        interface Area {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        type AreaSet = Set[Area]
        type Words = Set[str]
        func main() -> int64 {
            let s = AreaSet(items: Map[Area, bool]())
            s.add(Sq(s: 1))
            let w = Words(items: Map[str, bool]())
            w.add("a")
            return len(s) + len(w)
        }
        """)
    assert r.status != 0
    assert r.stderr.contains(".kod_compile_test.kod:9:20: error: `Area` can't be a `Set` element; elements are `int64`, `str`, `bytes`, `bool` or enums without payloads")
    assert r.stderr.contains("can't be a `Map` key") == false
    assert r.stderr.contains("builtins.kod") == false
}

