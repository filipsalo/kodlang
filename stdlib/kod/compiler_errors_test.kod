// Unit tests for the codegen's user-facing error messages. Each test
// builds a minimal snippet that triggers the diagnostic and asserts on
// the .message field of the captured Error. New error messages should
// add a test here.

import "fs"
import "kod/codegen"
import "process"
import "time"
import "./test_support"

test "unknown function" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            does_not_exist()
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown function `does_not_exist`")
}

test "unknown method on a struct receiver" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Foo = struct { x: int64 }
        func main() -> int64 {
            let f: Foo = Foo(x: 5)
            f.does_not_exist()
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown method `does_not_exist`")
}

test "unknown implicit variant in call position" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            .NoSuchVariant()
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown implicit variant `.NoSuchVariant`")
}

test "struct constructor with wrong field name" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Foo = struct { x: int64 }
        func main() -> int64 {
            let f: Foo = Foo(y: 5)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "struct `Foo` has no field `y`")
}

test "passing label to an anon parameter" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func greet(anon name: str) -> none { print(name) }
        func main() -> int64 {
            greet(name: "alice")
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "remove label `name`")
}

test "wrong label at call site" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func greet(name: str) -> none { print(name) }
        func main() -> int64 {
            greet(person: "alice")
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "expected label `name`, got `person`")
}

test "anon parameter cannot follow a labeled parameter" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func bad(label: int64, anon other: int64) -> int64 {
            return label + other
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "anon parameter `other` cannot follow a labeled parameter")
}

test "`is none` on a non-optional value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n: int64 = 5
            if n is none {
                return 1
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "requires an optional value")
}

test "len() on a struct without a len method" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Foo = struct { x: int64 }
        func main() -> int64 {
            let f: Foo = Foo(x: 5)
            return len(f)
        }
        """)
    assert test_support.any_message_contains(errs, needle: "len() not defined for struct `Foo`")
}

test "function call missing a required label" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func greet(name: str) -> none { print(name) }
        func main() -> int64 {
            greet("alice")
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "requires label `name`")
}

test "function call with too few arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func greet(name: str) -> none { print(name) }
        func main() -> int64 {
            greet()
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`greet` missing argument `name`")
}

test "function call with too many arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func greet(name: str) -> none { print(name) }
        func main() -> int64 {
            greet(name: "alice", "extra")
            pair(1, 2, 3)
            return 0
        }
        func pair(anon a: int64, anon b: int64) -> none {}
        """)
    assert test_support.any_message_contains(errs, needle: "`greet` takes 1 argument, got 2")
    assert test_support.any_message_contains(errs, needle: "`pair` takes 2 arguments, got 3")
}

test "match with none/Some on a non-optional subject" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n: int64 = 5
            match n {
                Some(v) -> print(v.to_str())
                none -> print("nope")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "none/Some requires an optional value")
}

test "comparing a non-optional value with `none`" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n: int64 = 5
            if n == none {
                return 1
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "cannot compare non-optional value with `none`")
}

test "len() on a primitive" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let b: bool = true
            return len(b)
        }
        """)
    assert test_support.any_message_contains(errs, needle: "len() not defined for this type")
}

test "unknown identifier in expression" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let x: int64 = 0
            return xy
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown name `xy`")
}

test "parse error: missing close paren in call" {
    // `expect(.CloseParen)` after the call args now reports its mismatch
    // instead of advancing silently and feeding a garbage AST to codegen.
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            print("hi"
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "expected `)`")
}

test "error inside an f-string points at the interpolation" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let x: int64 = 1
            print(f"x={nope}")
            return x
        }
        """)
    mut found: bool = false
    for e in errs {
        if e.message.contains("unknown name `nope`") {
            assert e.line == 3
            assert e.col == 16
            found = true
        }
    }
    assert found
}

test "parse error inside an f-string reports on its own line" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let x: int64 = 1
            print(f"x={1 +}")
            return x
        }
        """)
    mut found: bool = false
    for e in errs {
        if e.message.contains("expected identifier") {
            assert e.line == 3
            assert e.col == 19
            found = true
        }
    }
    assert found
}

test "parse error: missing `=` after let binding" {
    // The colon and type annotation are optional in `let`, so `let x int64`
    // is read as `let x` with `int64` as the next token — and the
    // subsequent `expect(.Equal)` fires.
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let x int64 = 0
            return x
        }
        """)
    assert test_support.any_message_contains(errs, needle: "expected `=`")
}

test "unknown function suggests a near-match" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func helper() -> int64 { return 0 }
        func main() -> int64 {
            return helprr()
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown function `helprr`")
    assert test_support.any_message_contains(errs, needle: "did you mean `helper`")
}

test "unknown name suggests a near-match" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let count: int64 = 0
            return coutn
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown name `coutn`")
    assert test_support.any_message_contains(errs, needle: "did you mean `count`")
}

test "unknown method suggests a near-match" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let s: str = "hi"
            return s.to_strr().hash()
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown method `to_strr`")
    assert test_support.any_message_contains(errs, needle: "did you mean `to_str`")
}

test "unknown struct field suggests a near-match" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Point = struct { x: int64; y: int64 }
        func main() -> int64 {
            let p: Point = Point(xx: 1, y: 2)
            return p.x
        }
        """)
    assert test_support.any_message_contains(errs, needle: "has no field `xx`")
    assert test_support.any_message_contains(errs, needle: "did you mean `x`")
}

test "unknown implicit variant suggests a near-match" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum {
            Red
            Green
            Blue
            Custom(r: int64, g: int64, b: int64)
        }
        func main() -> int64 {
            let c: Color = .Greeen
            return 0
        }
        """)
    // `.Greeen` triggers either the call-position branch or the
    // construct-without-args branch depending on shape. Either way
    // the diagnostic should mention the typo, and the close match
    // `Green` should appear in the suggestion.
    assert test_support.any_message_contains(errs, needle: "Greeen")
    assert test_support.any_message_contains(errs, needle: "did you mean `Green`")
}

test "no suggestion when nothing is close" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func helper() -> int64 { return 0 }
        func main() -> int64 {
            return xyzzy()
        }
        """)
    // Identifier far enough from `helper` that no suggestion should appear.
    assert test_support.any_message_contains(errs, needle: "unknown function `xyzzy`")
    assert not test_support.any_message_contains(errs, needle: "did you mean")
}

test "caret squiggly spans the full offending token" {
    // Before the widening fix, the caret was a single `^` at the
    // token's start column. Now it spans the whole token, so a typo
    // like `helprr` (6 chars) gets `^^^^^^` underneath.
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            helprr()
            return 0
        }
        """)
    assert len(errs) > 0
    // Find the error for the typo'd call.
    mut i: int64 = 0
    mut found: bool = false
    for i < len(errs) {
        if errs[i].caret.contains("^^^^^^") {
            found = true
        }
        i = i + 1
    }
    assert found
}

test "parse error: comma-separated struct fields terminate cleanly" {
    // Struct fields are newline-separated, not comma-separated. Putting
    // a comma between them used to send the parser into an infinite
    // loop because error recovery advanced past the EOF token and
    // peek_kind started reading OOB tokens. Now peek/advance clamp at
    // EOF, so the parser records errors and returns.
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { x: int64, y: int64 }
        func main() -> int64 {
            return 0
        }
        """)
    // The exact error message comes from the recovery cascade; what
    // matters here is "at least one parse error was reported."
    assert len(errs) > 0
}

test "constructing a struct without a non-default field is an error" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type P = struct {
            x: int64
            y: int64
        }
        func main() -> int64 {
            let p: P = P(x: 5)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "requires field `y`")
}

test "a constructor value without a label is an error at each value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Point = struct {
            x: int64
            y: int64
        }
        func main() -> int64 {
            let p = Point(10, 20)
            let q = Point(1, y: 2)
            let r = Point(y: 1, 2)
            let s = Point(1, 2, nosuch)
            return p.x + q.x + r.x + s.x
        }
        """)
    assert len(errs) == 8
    assert errs[0].message == "error: argument 1 of `Point` needs a field label (`x:`)"
    assert errs[0].line == 6
    assert errs[0].col == 19
    assert errs[1].message == "error: argument 2 of `Point` needs a field label (`y:`)"
    assert errs[1].col == 23
    assert errs[2].message == "error: argument 1 of `Point` needs a field label (`x:`)"
    assert errs[3].message == "error: argument 2 of `Point` needs a field label (`x:`)"
    assert errs[3].line == 8
    assert errs[4].message == "error: argument 1 of `Point` needs a field label (`x:`)"
    assert errs[5].message == "error: argument 2 of `Point` needs a field label (`y:`)"
    assert errs[6].message == "error: argument 3 of `Point` needs a field label"
    assert errs[7].message == "error: unknown name `nosuch`"
}

test "omitting a defaulted field is not an error" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Q = struct {
            x: int64
            y: int64 = 0
        }
        func main() -> int64 {
            let q: Q = Q(x: 5)
            return 0
        }
        """)
    assert len(errs) == 0
}

test "generic constructor with the wrong number of type arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Pair[A, B] = struct {
            first: A
            second: B
        }
        func main() -> int64 {
            let p = Pair[str](first: "a", second: 1)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`Pair` expects 2 type arguments, got 1")
}

test "generic struct constructed without type arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Pair[A, B] = struct {
            first: A
            second: B
        }
        func main() -> int64 {
            let p = Pair(first: "a", second: 1)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "generic struct `Pair` needs type arguments: write `Pair[A, B](...)`")
}

test "type arguments on a struct that isn't generic" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Point = struct {
            x: int64
        }
        func main() -> int64 {
            let p = Point[int64](x: 1)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`Point` is not generic")
}

test "unsupported generic type argument" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Cell[T] = struct {
            v: T
        }
        func main() -> int64 {
            let c = Cell[1 + 2](v: 3)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unsupported type argument")
}

test "generic type arguments must be followed by a call" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let xs: [int64] = [1, 2]
            let y = xs[0, 1]
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "expected `(` after generic type arguments")
}

test "a long chain of unknown methods is reported without blowing up" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Thing = struct { n: int64 }
        func main() -> int64 {
            let t = Thing(n: 1)
            let v = t.a().b().c().d().e().f().g().h().i().j().k().l().m().o().p().q().r().s().u().w().x().y().z().aa().bb().cc().dd().ee().ff().gg().hh().ii().jj().kk().ll().mm()
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown method `a` on `t`")
}

test "returning an optional from a function with a plain return type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Thing = struct { s: str }
        func name_of(anon t: Thing?) -> str {
            return t?.s
        }
        func main() -> int64 {
            print(name_of(Thing(s: "x")))
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "error: expected `str`, got `str?`; unwrap it first with `?` or `? or default`")
}

test "returning an optional as the value of a fallible function" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Thing = struct { s: str }
        func name_of(anon t: Thing?) -> str or Error {
            return t?.s
        }
        func maybe_name(anon t: Thing?) -> str? or Error {
            return t?.s
        }
        func main() -> int64 {
            print(must name_of(Thing(s: "x")))
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "error: expected `str`, got `str?`")
}

test "returning an optional from an optional function is not an error" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Thing = struct { s: str }
        func name_of(anon t: Thing?) -> str? {
            return t?.s
        }
        func plain(anon t: Thing?) -> str {
            return t?.s? or ""
        }
        func main() -> int64 {
            print(name_of(Thing(s: "x"))? or plain(none))
            return 0
        }
        """)
    assert len(errs) == 0
}

test "type arguments on a generic enum variant are rejected" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Either[L, R] = enum {
            Left(value: L)
            Right(value: R)
        }
        func main() -> int64 {
            let e = Either[int64, str].Left(value: 1)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "expected `(` after generic type arguments, got `.`")
}

test "reading a misspelled field" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { name: str }
        func main() -> int64 {
            let b = Box(name: "x")
            print(b.nme)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "struct `Box` has no field `nme`; did you mean `name`?")
}

test "assigning a misspelled field" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { name: str }
        func main() -> int64 {
            let b = Box(name: "x")
            b.nmae = "y"
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "struct `Box` has no field `nmae`; did you mean `name`?")
}

test "optional chaining on a misspelled field" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { name: str }
        func main() -> int64 {
            let b: Box? = Box(name: "x")
            let n = b?.nme
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "struct `Box` has no field `nme`; did you mean `name`?")
}

test "a field on an interface value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Greet {
            func hi(self) -> str
        }
        type Dog = struct {
            name: str
            func hi(self) -> str { return "woof" }
        }
        func main() -> int64 {
            let g: Greet = Dog(name: "rex")
            print(g.name)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "cannot access field `name` on a value of type `Greet`")
}

test "a field on an optional suggests ?." {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { name: str }
        func main() -> int64 {
            let b: Box? = Box(name: "x")
            print(b.name)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "cannot access field `name` on a value of type `Box?`; did you mean `?.name`?")
}

test "assigning a field of an optional suggests unwrapping it" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { name: str }
        func main() -> int64 {
            let b: Box? = Box(name: "x")
            b.name = "y"
            return 0
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: cannot access field `name` on a value of type `Box?`; unwrap it first, as in `if b is Some(v) { v.name = ... }`"
}

test "a bad field in a param default is reported once" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { name: str }
        func label(anon b: Box, s: str = Box(name: "d").nme) -> str {
            return s
        }
        func main() -> int64 {
            let b = Box(name: "x")
            print(label(b))
            print(label(b))
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "struct `Box` has no field `nme`")
}

test "a pattern naming an unknown enum" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(r: int64)
            Square(side: int64)
        }
        func main() -> int64 {
            let s = Shape.Circle(r: 1)
            match s {
                Shap.Circle(r) -> print(r)
                else -> {}
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown enum `Shap`; did you mean `Shape`?")
}

test "a pattern naming an unknown variant" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(r: int64)
            Square(side: int64)
        }
        func main() -> int64 {
            let s = Shape.Circle(r: 1)
            let n = match s {
                .Circel(r) -> r
                else -> 0
            }
            return n
        }
        """)
    assert test_support.any_message_contains(errs, needle: "enum `Shape` has no variant `Circel`; did you mean `Circle`?")
}

test "an implicit variant pattern on a value that isn't an enum" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n: int64 = 3
            match n {
                .Nope -> print("no")
                else -> {}
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`.Nope` needs an enum value, got `int64`")
}

test "a pattern binding more names than the variant has fields" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(r: int64)
            Square(side: int64)
        }
        func main() -> int64 {
            let s = Shape.Circle(r: 1)
            match s {
                .Circle(r, extra) -> print(r)
                else -> {}
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`Shape.Circle` has 1 payload field, pattern binds 2")
}

test "a let-else pattern naming an unknown variant" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(r: int64)
            Square(side: int64)
        }
        func main() -> int64 {
            let s = Shape.Circle(r: 1)
            let .Circel(r) = s else { return 1 }
            return r
        }
        """)
    assert test_support.any_message_contains(errs, needle: "enum `Shape` has no variant `Circel`; did you mean `Circle`?")
}

test "a let-else pattern that isn't a variant is a parse error" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let x: int64 = 3
            let 3 = x else { return 1 }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "expected identifier, got integer literal")
}

test "a statement ends its line unless a block ends it" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let bad: int64 = 1 23 456
            let x = 5 print_int(x)
            return bad
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "expected the end of the line after this statement, got integer literal")
    assert test_support.any_message_contains(errs, needle: "expected the end of the line after this statement, got identifier")
    let ok: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let pop: int64 = 1 000 000 // a comment
            if pop > 0 { print_int(pop) } print_int(1)
            return 0
        }
        """)
    assert len(ok) == 0
    let block_errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let x = 5 if x > 0 {
                print_int(x)
            }
            return 0
        }
        """)
    assert len(block_errs) == 1
    assert block_errs[0].line == 2
}

func constant_errors(anon decls: str) -> [codegen.Diagnostic] {
    return test_support.try_compile(decls + "\nfunc main() -> int64 {\n    return 0\n}\n")
}

test "module-level constants compile, with their uses" {
    let errs = constant_errors("""
        type Mode = enum {
            Fast
            Safe
        }
        let A: int64 = 1
        let B: int64 = A + 2 * 3
        let S: str = "a" + "b"
        let L: [int64] = [A, B]
        let M: Mode = Mode.Safe
        let T: bool = A < B and B != 3
        func use() -> int64 {
            let x: int64 = A + B + len(L)
            return x
        }
        """)
    assert len(errs) == 0
}

test "a module-level constant is checked against its type" {
    let errs = constant_errors("""
        let A: int64 = "text"
        let B: str = 3
        let C: [int64] = ["x"]
        """)
    assert len(errs) == 3
    assert errs[0].message == "error: expected `int64`, got `str`"
}

test "a module-level constant can only use literals, operators, enum variants and constants" {
    let errs = constant_errors("""
        func five() -> int64 { return 5 }
        type P = struct {
            x: int64
        }
        let A: int64 = five()
        let B: P = P(x: 1)
        let C: str = f"{1}"
        let D: int64 = 1 + five()
        """)
    assert len(errs) == 4
    for e in errs {
        assert e.message == "error: this can't be part of a module-level constant; use literals, operators, other constants and enum variants"
    }
    assert errs[0].line == 5
}

test "a constant that refers to itself is an error, however far round" {
    let errs = constant_errors("""
        let A: int64 = A + 1
        let B: int64 = C
        let C: int64 = B
        let D: int64 = 1
        let E: int64 = D + D
        """)
    assert len(errs) == 3
    assert errs[0].message == "error: constant `A` refers to itself"
    assert errs[1].message == "error: constant `B` refers to itself"
    assert errs[2].message == "error: constant `C` refers to itself"
}

test "a constant needs a type, cannot be mut, and cannot be assigned" {
    let missing = constant_errors("let A = 1")
    assert len(missing) == 1
    assert missing[0].message == "error: a module-level constant needs a type: `let NAME: T = ...`"
    let m = constant_errors("mut A: int64 = 1")
    assert len(m) == 1
    assert m[0].message == "error: a top-level `mut` isn't supported; use `let NAME: T = ...` for a constant"
    let assigned = test_support.try_compile("""
        let A: int64 = 1
        func main() -> int64 {
            A = 2
            return 0
        }
        """)
    assert len(assigned) > 0
}

test "a constant and a function cannot share a name" {
    let errs = constant_errors("""
        let A: int64 = 1
        func A() -> int64 { return 2 }
        """)
    assert len(errs) > 0
}

test "a module's top level holds only declarations" {
    let let_errs: [codegen.Diagnostic] = test_support.try_compile("""
        let LIMIT = 10
        func main() -> int64 {
            return 0
        }
        """)
    assert len(let_errs) == 1
    assert let_errs[0].message == "error: a module-level constant needs a type: `let NAME: T = ...`"
    let stmt_errs: [codegen.Diagnostic] = test_support.try_compile("""
        print("top")
        fucn helper(anon x: int64) -> int64 {
            let y = x + 1
            return y
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(stmt_errs) == 2
    assert stmt_errs[0].message == "error: expected a declaration (`func`, `type`, `interface`, `import`, `extern` or `test`), got identifier"
    assert stmt_errs[1].line == 2
    let next_line_errs: [codegen.Diagnostic] = test_support.try_compile("""
        fucn helper(anon x: int64) -> int64
        {
            let y = x * 2
            return y
        }
        {
            print("block at top level")
        }
        func main() -> int64 {
            return 0
        }
        oops }
        """)
    assert len(next_line_errs) == 3
    assert next_line_errs[0].line == 1
    assert next_line_errs[1].line == 6
    assert next_line_errs[2].line == 12
    let kept_errs: [codegen.Diagnostic] = test_support.try_compile("""
        pub pub func g() -> int64 {
            return 2
        }
        func main() -> int64 {
            return g()
        }
        """)
    assert len(kept_errs) == 1
}

test "a block missing its `{` doesn't swallow what follows" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let x = 1
            if x = 1 {
                print("one")
            }
            return x
        }
        func other() -> int64 {
            return 2
        }
        """)
    for e in errs {
        assert e.line == 3
    }
    assert len(errs) > 0
}

test "an unknown unit variant" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Dir = enum {
            North
            South
        }
        func main() -> int64 {
            let d = Dir.Nroth
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "enum `Dir` has no variant `Nroth`; did you mean `North`?")
}

test "an unknown payload variant constructor" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(r: int64)
            Square(side: int64)
        }
        func main() -> int64 {
            let s = Shape.Circl(r: 1)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "enum `Shape` has no variant `Circl`; did you mean `Circle`?")
}

test "a variant constructor with a wrong payload label" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(r: int64)
            Square(side: int64)
        }
        func main() -> int64 {
            let s = Shape.Circle(radius: 2)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`Shape.Circle` has no payload field `radius`")
}

test "a variant constructor with payload labels out of order" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Msg = enum {
            Move(x: int64, y: int64)
        }
        func main() -> int64 {
            let m = Msg.Move(y: 1, x: 2)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`Msg.Move` takes its payload in declaration order: expected `x`, got `y`")
}

test "a variant constructor with too few or too many payload values" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(r: int64)
            Square(side: int64)
        }
        func main() -> int64 {
            let a = Shape.Circle()
            let b = Shape.Circle(1, 2)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`Shape.Circle` has 1 payload field, got 0")
    assert test_support.any_message_contains(errs, needle: "`Shape.Circle` has 1 payload field, got 2")
}

test "an unknown method on an interface value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Greet {
            func hi(self) -> str
        }
        type Dog = struct {
            name: str
            func hi(self) -> str { return "woof" }
        }
        func main() -> int64 {
            let g: Greet = Dog(name: "rex")
            print(g.hello())
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "interface `Greet` has no method `hello`")
}

test "an interface method call with the wrong arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Greet {
            func hi(self, anon times: int64) -> str
        }
        type Dog = struct {
            name: str
            func hi(self, anon times: int64) -> str { return "woof" }
        }
        func main() -> int64 {
            let g: Greet = Dog(name: "rex")
            print(g.hi())
            print(g.hi(1, 2))
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`Greet.hi` missing argument at position 0")
    assert test_support.any_message_contains(errs, needle: "`Greet.hi` takes 1 argument, got 2")
}

test "an indirect call with too few or too many arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func dbl(anon x: int64) -> int64 {
            return x * 2
        }
        func main() -> int64 {
            let f = dbl
            let a = f()
            let b = f(1, 2)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`f` takes 1 argument, got 0")
    assert test_support.any_message_contains(errs, needle: "`f` takes 1 argument, got 2")
}

test "assigning to an undeclared name" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            mut total = 0
            zz = 5
            totl = 6
            return total
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown name `zz`; declare it with `mut zz = ...`")
    assert test_support.any_message_contains(errs, needle: "unknown name `totl`; declare it with `mut totl = ...`; did you mean `total`?")
}

test "assigning to a call" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func one() -> int64 {
            return 1
        }
        func main() -> int64 {
            one() = 2
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "cannot assign to this expression")
}

test "calling a function an imported module doesn't declare" {
    let r: process.ProcessResult = test_support.compile_source("""
        import "io"
        import "time"
        func main() -> int64 {
            let text = io.raed_file("x.txt")
            time.nope()
            return 0
        }
        """)
    assert r.status != 0
    assert r.stderr.contains("module `io` has no function `raed_file`; did you mean `read_file`?")
    assert r.stderr.contains("module `time` has no function `nope`")
}

test "`or` with a type other than Error" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type MyErr = struct { msg: str }
        func f() -> int64 or MyErr {
            return 1
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "only `T or Error` is supported, got `or MyErr`")
}

test "an unknown type in a let annotation" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let x: Strr = "a"
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown type `Strr`; did you mean `str`?")
    assert errs[0].line == 2
    assert errs[0].col == 12
}

test "an unknown module-qualified type points at the type name" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f(anon x: time.Nope) -> none {
        }
        func g(anon y: time.Nope?) -> none {
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 2
    for e in errs {
        assert e.message == "error: unknown type `time.Nope`"
        assert e.col == 21
    }
}

test "unknown parameter and return types" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f(anon a: Intt) -> Strg {
            return a
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown type `Intt`")
    assert test_support.any_message_contains(errs, needle: "unknown type `Strg`")
}

test "unknown field and payload types" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct {
            kids: [Nodee]
        }
        type Shape = enum {
            Circle(r: Floaty)
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown type `Nodee`")
    assert test_support.any_message_contains(errs, needle: "unknown type `Floaty`")
}

test "type arguments on a non-generic struct type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Foo = struct { x: int64 }
        func main() -> int64 {
            let y: Foo[int64] = Foo(x: 1)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`Foo` is not generic")
}

test "a generic type with too few or no type arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let m: Map[str] = Map[str, int64]()
            let n: Map = Map[str, int64]()
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`Map` expects 2 type arguments, got 1")
    assert test_support.any_message_contains(errs, needle: "generic struct `Map` needs type arguments: write `Map[K, V]`")
}

test "an alias to an unknown type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type A = Nope
        func main() -> int64 {
            let a: A = 1
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown type `Nope`")
}

test "a cycle of type aliases" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type A = B
        type B = A
        func main() -> int64 {
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "type alias `A` refers to itself")
    assert test_support.any_message_contains(errs, needle: "type alias `B` refers to itself")
}

test "an unknown type argument in a generic constructor" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Pair[A, B] = struct {
            first: A
            second: B
        }
        func main() -> int64 {
            let p = Pair[Strr, int64](first: "a", second: 2)
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown type `Strr`; did you mean `str`?")
}

test "a value from an unknown method doesn't cascade" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { x: int64 }
        func main() -> int64 {
            let b = Box(x: 1)
            let w = b.nope()
            print(w.x)
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown method `nope` on `b`")
}

test "a bare generic constructor doesn't cascade" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Pair[A, B] = struct {
            first: A
            second: B
        }
        func main() -> int64 {
            let p = Pair(first: 1, second: 2)
            print(p.first)
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "generic struct `Pair` needs type arguments")
}

test "an unknown function in an f-string doesn't cascade" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            print(f"{mystery()}")
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown function `mystery`")
}

test "a misspelled field doesn't cascade" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { name: str }
        func main() -> int64 {
            let b = Box(name: "x")
            print(f"{b.nme.len()}")
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "struct `Box` has no field `nme`")
}

test "a binding of an unknown type doesn't cascade" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let x: Strng = "a"
            print(f"{x}")
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown type `Strng`")
}

test "an unknown implicit variant argument doesn't cascade" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func take(anon s: str) -> none {
            print(s)
        }
        func main() -> int64 {
            take(.Nope)
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown implicit variant `.Nope`")
}

test "indexing an int64 is reported once" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n: int64 = 5
            let k = n[0]
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "cannot index a value of type `int64`")
}

test "indexing a struct without op_index" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Foo = struct { x: int64 }
        func main() -> int64 {
            let f = Foo(x: 1)
            let v = f[0]
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "cannot index a value of type `Foo`; it has no `op_index` method")
}

test "slicing a struct" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Foo = struct { x: int64 }
        func main() -> int64 {
            let f = Foo(x: 1)
            let v = f[0..1]
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "cannot slice a value of type `Foo`")
}

test "assigning to an element of a str" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            mut s = "abc"
            s[0] = 1
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "cannot assign to an element of a value of type `str`; `str` values are immutable")
}

test "assigning to an element of a struct without op_index_set" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Foo = struct { x: int64 }
        func main() -> int64 {
            let f = Foo(x: 1)
            f[0] = 2
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "cannot assign to an element of a value of type `Foo`; it has no `op_index_set` method")
}

test "iterating over a str suggests code_points" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let s = "abc"
            for c in s {
                print(f"{c}")
            }
            for c in "xyz" {
                print(f"{c}")
            }
            return 0
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "cannot iterate over a value of type `str`; iterate over `s.code_points()` instead")
    assert test_support.any_message_contains(errs, needle: "cannot iterate over a value of type `str`; iterate over its `.code_points()` instead")
}

test "iterating over a Map suggests keys" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let m = Map[str, int64]()
            for k in m {
                print(k)
            }
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "cannot iterate over a value of type `Map[str, int64]`; iterate over `m.keys` instead")
}

test "iterating over an int64" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            for x in 5 {
                print(f"{x}")
            }
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "cannot iterate over a value of type `int64`")
}

test "`and` and `or` operands must be bool" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let v = 7 or 0
            let w = "a" and true
            return 0
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "`or` needs `bool` operands, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`and` needs `bool` operands, got `str`")
}

test "`or` on an optional suggests a default" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let o: int64? = 5
            let w = o or 5
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`or` needs `bool` operands, got `int64?`; did you mean `o? or default`?")
}

test "conditions must be bool" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n = 7
            let o: int64? = 5
            if n {
                print("n")
            }
            for o {
                break
            }
            assert n
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "an `if` condition must be a `bool`, got `int64`")
    assert test_support.any_message_contains(errs, needle: "a `for` condition must be a `bool`, got `int64?`; test it with `is not none`")
    assert test_support.any_message_contains(errs, needle: "`assert` needs a `bool`, got `int64`")
}

test "bool and int64 don't mix" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let b = true
            if b == 1 {
                print("b")
            }
            let z = true + 1
            let q = b < true
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool` with `int64`")
    assert test_support.any_message_contains(errs, needle: "`+` doesn't take `bool` operands")
    assert test_support.any_message_contains(errs, needle: "`<` doesn't take `bool` operands")
}

test "a bit test without parentheses explains the precedence" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let flags = 5
            if flags & 1 != 0 {
                print("odd")
            }
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "`&` doesn't take `bool` operands; `!=` binds tighter than `&`, so write `(a & b) != c`")
}

test "operators need operands of one type they take" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum { Red Green }
        func main() -> int64 {
            let s = "abc"
            let t = "x"
            let b = b"xy"
            let xs: [int64] = [1, 2]
            let c = Color.Red
            let d = Color.Green
            let m = Map[str, int64]()
            mut n = 1
            let a1 = "a" + 5
            let a2 = 5 + "a"
            let a3 = s - t
            let a4 = xs * 2
            let a5 = -s
            let a6 = s + b
            let a7 = c < d
            let a8 = s < 3
            n += "a"
            let a9 = xs["a"]
            let a10 = xs[true]
            let a11 = xs[m.get("k")]
            let a12 = s[0.."a"]
            xs["b"] = 3
            let a13 = 5 + xs
            let a14 = 1 < s < 3
            return 0
        }
        """)
    assert len(errs) == 16
    assert errs[0].message == "error: cannot add `str` and `int64`; convert with `str(...)` or use an f-string"
    assert errs[0].line == 11
    assert errs[0].col == 20
    assert errs[1].message == "error: cannot add `int64` and `str`; convert with `str(...)` or use an f-string"
    assert errs[1].col == 14
    assert errs[2].message == "error: `-` needs `int64` operands, got `str`"
    assert errs[2].col == 14
    assert errs[3].message == "error: `*` needs `int64` operands, got `[int64]`"
    assert errs[4].message == "error: `-` needs `int64` operands, got `str`"
    assert errs[4].col == 15
    assert errs[5].message == "error: cannot add `str` and `bytes`"
    assert errs[6].message == "error: `<` doesn't take `Color` operands"
    assert errs[7].message == "error: cannot compare `str` with `int64`"
    assert errs[8].message == "error: cannot add `int64` and `str`"
    assert errs[8].col == 10
    assert errs[9].message == "error: an index must be `int64`, got `str`"
    assert errs[10].message == "error: an index must be `int64`, got `bool`"
    assert errs[11].message == "error: an index must be `int64`, got `int64?`; unwrap it first with `?` or `? or default`"
    assert errs[12].message == "error: a slice bound must be `int64`, got `str`"
    assert errs[13].message == "error: an index must be `int64`, got `str`"
    assert errs[13].line == 24
    assert errs[14].message == "error: cannot add `int64` and `[int64]`"
    assert errs[15].message == "error: cannot compare `int64` with `str`"
    assert errs[15].col == 19
}

test "a prefix `-` on a call of an int64's method suggests parentheses" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type P = struct {
            x: int64
            name: str
            func get(self) -> int64 { return self.x }
        }
        func main() -> int64 {
            let n = 5
            let p = P(x: 1, name: "a")
            let xs = [1, 2]
            print(-n.to_str())
            print(-xs[0].to_str())
            let s = -p.get().to_str()
            print(s + "!")
            let ys = -xs
            print_int(len(ys))
            print(-p.name)
            return 0
        }
        """)
    assert len(errs) == 5
    assert errs[0].message == "error: `-` needs `int64` operands, got `str`; write `(-n).to_str()` to negate `n` first"
    assert errs[0].line == 10
    assert errs[0].col == 12
    assert errs[1].message == "error: `-` needs `int64` operands, got `str`; write `(-xs[0]).to_str()` to negate `xs[0]` first"
    assert errs[2].message == "error: `-` needs `int64` operands, got `str`; write `(-p.get()).to_str()` to negate `p.get()` first"
    assert errs[3].message == "error: `-` needs `int64` operands, got `[int64]`"
    assert errs[3].line == 14
    assert errs[4].message == "error: `-` needs `int64` operands, got `str`"
    assert errs[4].line == 16
}

test "operators on operands of one type they take compile cleanly" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let a = 1
            let b = 2
            let c = 3
            let s = "m"
            let x = 4
            mut n = 10
            let k = 2
            let xs = [1, 2, 3]
            let bs = b"ab" + b"cd"
            mut out = ""
            out += s
            let ok1 = a < b < c
            let ok2 = "a" < s < "z"
            let ok3 = bs < b"zz"
            n -= 1
            let sh = (1 << k) | (n >> 1) ^ (n & 3)
            let neg = -x
            let last = xs[-1]
            let sub = xs[1..]
            let pre = s[..1]
            let mid = bs[a..len(bs)]
            xs[0] = n * 2 / 3 % 5
            return neg + last + sh + len(sub) + len(pre) + len(mid) + bs[0] + s[0]
        }
        """)
    assert len(errs) == 0
}

test "`==` compares only values of one type that has an `==`" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Tag = enum { A B }
        type Shape = enum { Circle(r: int64) Dot }
        type Maybe = enum { Just(value: int64) Nothing }
        type Pt = struct { x: int64 }
        type Qt = struct { y: int64 }
        interface Area { func area(self) -> int64 }
        type Sq = struct { s: int64  func area(self) -> int64 { return self.s } }
        func f() -> none { }
        func pick(anon n: int64) -> Maybe { return .Just(value: n) }
        func main() -> int64 {
            let tag = Tag.A
            let shape = Shape.Dot
            let xs = [1]
            let ys = [2]
            let p = Pt(x: 1)
            let q = Qt(y: 1)
            let a: Area = Sq(s: 1)
            let b: Area = Sq(s: 2)
            let r1 = tag == shape
            let r2 = tag == .Nope
            let r3 = xs == []
            let r4 = xs != ys
            let r5 = p == q
            let r6 = p == p
            let r7 = f() == 0
            let r8 = a == b
            let r9 = pick(1) == .Just(value: 2)
            let r10 = shape == shape
            let r11 = main == main
            let r12 = "a" == 1
            let r13 = .Dot != tag
            let r14 = Maybe.Just(value: 1) != pick(2)
            return 0
        }
        """)
    assert len(errs) == 14
    assert errs[0].message == "error: cannot compare `Tag` with `Shape`"
    assert errs[0].line == 19
    assert errs[0].col == 21
    assert errs[1].message == "error: enum `Tag` has no variant `Nope`"
    assert errs[1].col == 21
    assert errs[2].message == "error: `==` doesn't compare arrays; compare `len(...)` and the elements"
    assert errs[3].message == "error: `!=` doesn't compare arrays; compare `len(...)` and the elements"
    assert errs[4].message == "error: `==` doesn't compare structs; compare their fields, or declare `op_eq`"
    assert errs[5].message == "error: `==` doesn't compare structs; compare their fields, or declare `op_eq`"
    assert errs[6].message == "error: cannot compare `none` with `int64`"
    assert errs[6].col == 14
    assert errs[7].message == "error: `==` doesn't compare interface values"
    assert errs[8].message == "error: cannot compare with `.Just(...)`, which has a payload; test it with `is .Just(value)`"
    assert errs[8].col == 25
    assert errs[9].message == "error: cannot compare two `Shape` values; some of its variants have payloads, so test the variant with `is` or `match`"
    assert errs[10].message == "error: `==` doesn't compare function values"
    assert errs[11].message == "error: cannot compare `str` with `int64`"
    assert errs[12].message == "error: enum `Tag` has no variant `Dot`"
    assert errs[12].col == 15
    assert errs[13].message == "error: cannot compare with `.Just(...)`, which has a payload; test it with `is .Just(value)`"
    assert errs[13].col == 15
}

test "`==` on values of one type that has an `==` compiles cleanly" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Dir = enum { Up Down }
        type Move = enum { Step(d: Dir) Stay }
        type Maybe[T] = enum { Just(value: T) Nothing }
        func main() -> int64 {
            let d = Dir.Up
            let e = Dir.Down
            let m = Move.Stay
            let n: Maybe[int64] = .Nothing
            let s = "x"
            let b = true
            let by = b"ab"
            let opt: int64? = 3
            let counts = Map[str, int64]()
            counts["a"] = 1
            mut hits = 0
            if d == e or d != .Down or .Up == d or Dir.Up == e {
                hits += 1
            }
            if m == .Stay or m != Move.Stay or n == .Nothing or .Nothing != n {
                hits += 1
            }
            if s == "x" and b == true and by != b"zz" and opt != none and none == opt and hits == 2 {
                hits += 1
            }
            return hits + counts["a"]? + len(counts)
        }
        """)
    assert len(errs) == 0
}

test "a Map key and a hashed value must be hashable" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum { Circle(r: int64) Dot }
        type Sq = struct { s: int64 }
        type Holder = struct { m: Map[Sq, int64] }
        type ByShape = Map[Shape, str]
        func main() -> int64 {
            let a = Map[[int64], int64]()
            let b: Map[int64?, str] = Map[int64?, str]()
            let c = Map[str, Map[[str], int64]]()
            let again = Map[[int64], str]()
            let h = Holder(m: Map[Sq, int64]())
            let xs = [1]
            let h1 = hash(xs)
            let h2 = hash(Shape.Dot)
            return hash(h)
        }
        """)
    assert len(errs) == 8
    assert errs[0].message == "error: `Sq` can't be a `Map` key; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[0].line == 3
    assert errs[0].col == 31
    assert errs[1].message == "error: `Shape` can't be a `Map` key; some of its variants have payloads; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[1].line == 4
    assert errs[1].col == 20
    assert errs[2].message == "error: `[int64]` can't be a `Map` key; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[2].line == 6
    assert errs[2].col == 17
    assert errs[3].message == "error: `int64?` can't be a `Map` key; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[3].line == 7
    assert errs[3].col == 16
    assert errs[4].message == "error: `[str]` can't be a `Map` key; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[4].line == 8
    assert errs[5].message == "error: cannot hash a value of type `[int64]`; hashable values are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[5].line == 12
    assert errs[5].col == 19
    assert errs[6].message == "error: cannot hash a value of type `Shape`; some of its variants have payloads; hashable values are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[7].message == "error: cannot hash a value of type `Holder`; hashable values are `int64`, `str`, `bytes`, `bool` or enums without payloads"
}

test "a Set element must be hashable" {
    let r: process.ProcessResult = test_support.compile_source("""
        import "sets" { Set }
        interface Area {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        type AreaSet = Set[Area]
        type Words = Set[str]
        func main() -> int64 {
            let s = AreaSet(items: Map[Area, bool]())
            s.add(Sq(s: 1))
            let w = Words(items: Map[str, bool]())
            w.add("a")
            return len(s) + len(w)
        }
        """)
    assert r.status != 0
    assert r.stderr.contains(".kod_compile_test.kod:9:20: error: `Area` can't be a `Set` element; elements are `int64`, `str`, `bytes`, `bool` or enums without payloads")
    assert not r.stderr.contains("can't be a `Map` key")
    assert not r.stderr.contains("builtins.kod")
}

test "a bad Map key in an imported module is reported there" {
