// A loop counter stepped by 1 toward its condition's bound skips the overflow
// check; any other step keeps it.
import "panics"

let MAX: int64 = 9223372036854775807
let MIN: int64 = -9223372036854775808

func up_to_max() -> int64 {
    mut i = MAX - 3
    mut n = 0
    for i < MAX {
        n += 1
        i += 1
    }
    return n
}

func down_to_min() -> int64 {
    mut i = MIN + 3
    mut n = 0
    for i > MIN {
        i -= 1
        n += 1
    }
    return n
}

test "steps toward the bound reach it" {
    assert up_to_max() == 3
    assert down_to_min() == 3
    mut n = 0
    for _ in MAX - 2..MAX {
        n += 1
    }
    assert n == 2
    mut pos = 0
    let s = "123x"
    for pos < len(s) and s[pos] != 'x' {
        pos += 1
    }
    assert pos == 3
}

test "a second step, or one in an inner loop, is still checked" {
    let twice = panics.run(func() -> none {
        mut i = MAX - 1
        for i < MAX {
            i += 1
            i += 1
        }
    })
    assert (twice?.message? or "") == "integer overflow"
    let inner = panics.run(func() -> none {
        mut i = MAX - 1
        for i < MAX {
            for _ in 0..2 {
                i += 1
            }
        }
    })
    assert (inner?.message? or "") == "integer overflow"
    let inclusive = panics.run(func() -> none {
        for _ in MAX - 1..=MAX {
        }
    })
    assert (inclusive?.message? or "") == "integer overflow"
}
