// Calls of small functions and methods are compiled in place; each argument
// must still be worked out once and in order, before the body.

import "./inline_small_dep" { Box, make_box, twice, scaled }

mut calls: int64 = 0

type P = struct {
    x: int64
    y: int64

    func sum(self) -> int64 {
        return self.x + self.y
    }

    func is_origin(self) -> bool {
        return self.x == 0 and self.y == 0
    }
}

func sq(anon n: int64) -> int64 {
    return n * n
}

func between(anon lo: int64, anon n: int64, hi: int64) -> bool {
    return lo <= n and n < hi
}

func ratio(anon a: int64, anon b: int64) -> int64 {
    return a / b
}

func half(anon x: float64) -> float64 {
    return x * 0.5
}

func next(anon tag: str) -> int64 {
    calls += 1
    print(f"next {tag}")
    return calls
}

func make_p() -> P {
    print("make_p")
    return P(x: 3, y: 4)
}

func main() -> int64 {
    // An argument with a side effect runs once, even though `sq` uses it twice.
    print(sq(next("a")))
    // In order, left to right.
    print(between(next("lo"), next("n"), hi: next("hi")))
    // A caller's local with the name of a parameter.
    let n: int64 = 5
    print(sq(n + 1))
    let lo: int64 = 10
    print(between(1, lo, hi: 11))
    let p = P(x: 1, y: 2)
    print(f"{p.sum()} {p.is_origin()} {P(x: 0, y: 0).is_origin()} {make_p().sum()}")
    // Another module's function and methods, including a private field.
    let b = make_box(w: 3, h: 4)
    print(f"{b.area()} {b.wider_than(2)} {b.wider_than(3)} {twice(21)} {twice(sq(3))}")
    print(f"{half(3.0)} {scaled(1.5)} {scaled(1.5, by: 3.0)}")
    mut total: int64 = 0
    for i in 0..10 {
        total += sq(i) + p.sum()
    }
    print(total)
    print(ratio(7, 2))
    print(ratio(7, calls - calls))
    return 0
}

// expected output:
// next a
// 1
// next lo
// next n
// next hi
// true
// 36
// true
// make_p
// 3 false true 7
// 12 true false 42 18
// 1.5 3.0 4.5
// 315
// 3
// expected stderr:
// panic: integer division by zero
// expected status:
// 1
