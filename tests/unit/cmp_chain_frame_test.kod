// Every chain's middle operands keep their own stack slot, so several chains
// in one function survive the calls that compare str values.

// The values `noisy` was called with, in order.
mut calls: [int64] = []

func bucket(anon w: str) -> int64 {
    if "a" <= w <= "c" { return 1 }
    if "d" <= w <= "f" { return 2 }
    if "g" <= w < "m" <= "n" { return 3 }
    return 0
}

func noisy(anon n: int64) -> int64 {
    calls += [n]
    return n
}

func word(anon s: str) -> str {
    return s
}

test "str chains" {
    let a = "apple"
    let b = "apples"
    let z = "zebra"
    assert f"{a < b < z} {z < b < a} {a < z < b} {a < b < word("pear") < z}" == "true false false true"
    assert a < b < z
    assert z > b > a
    assert a <= word(a) < b < z
    if a < word("banana") < word("cherry") < "apex" {
        fail("str chain 4 taken")
    }
    assert f"{bucket("b")} {bucket("e")} {bucket("h")} {bucket("x")} {bucket("")}" == "1 2 3 0 0"
}

test "int chains with calls" {
    let lo: int64 = 1
    let hi: int64 = 9
    let in1 = lo < noisy(5) < hi
    let in2 = lo < noisy(2) < noisy(3) < hi
    let in3 = hi < noisy(4) < lo
    assert calls == [5, 2, 3, 4]
    assert f"{in1} {in2} {in3}" == "true true false"
    calls = []
    mut taken = false
    if lo <= noisy(1) < noisy(6) <= hi { taken = true }
    assert taken
    assert calls == [1, 6]
    calls = []
    taken = false
    if 0 < noisy(7) < 8 < noisy(10) { taken = true }
    assert taken
    assert calls == [7, 10]
}
