import "crypto/ecdsa" { Curve, PublicKey }
import "crypto/ecdsa"
import "crypto/sha2" { Algo }
import "encoding/hex"

func h(anon s: str) -> bytes {
    return must hex.decode(s)
}

func flip(anon b: bytes, anon at: int64) -> bytes {
    mut xs = [x for x in b]
    xs[at] = xs[at] ^ 1
    return kod_bytes_from_array(xs)
}

func check(anon curve: Curve, anon point: str, anon algo: Algo, anon sig: str) -> none {
    let key = must PublicKey(curve, point: h(point))
    let message = b"The quick brown fox jumps over the lazy dog"
    let signature = h(sig)
    assert key.verify(algo: algo, message: message, signature: signature)
    assert not key.verify(algo: algo, message: b"The quick brown fox jumps over the lazy cat", signature: signature)
    assert not key.verify(algo: algo, message: message, signature: flip(signature, len(signature) - 1))
    assert not key.verify(algo: algo, message: message, signature: flip(signature, 5 + signature[3]))
    let wrong = if algo is .Sha256 { Algo.Sha512 } else { Algo.Sha256 }
    assert not key.verify(algo: wrong, message: message, signature: signature)
    let Some((r, s)) = ecdsa.parse_signature(signature) else { panic("not DER") }
    assert key.verify_rs(algo: algo, message: message, r: r, s: s)
    assert not key.verify_rs(algo: algo, message: message, r: s, s: r)
}

