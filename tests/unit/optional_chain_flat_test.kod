// `x?.field` on a field that is itself optional, and `x?.method()` returning an
// optional, give that optional back as it is (`T??` is `T?`), so a chain of
// them reads through every level.
type C = shared struct {
    n: int64?
    label: str?
    func get(self) -> int64? {
        return self.n
    }
    func name(self) -> str? {
        return self.label
    }
}

type B = shared struct {
    c: C?
}

type A = shared struct {
    b: B?
}

test "a chain through optional fields and methods" {
    let a: A? = A(b: B(c: C(n: 5, label: "five")))
    assert f"{a?.b?.c?.n? or -1}" == "5"
    assert f"{a?.b?.c?.label? or "-"}" == "five"
    assert f"{a?.b?.c?.get()? or -1}" == "5"
    assert f"{a?.b?.c?.name()? or "-"}" == "five"
    let gone: A? = none
    assert f"{gone?.b?.c?.n? or -1}" == "-1"
    assert f"{gone?.b?.c?.name()? or "-"}" == "-"
    let empty: A? = A(b: B(c: C(n: none, label: none)))
    assert f"{empty?.b?.c?.n? or -1}" == "-1"
    assert f"{empty?.b?.c?.name()? or "-"}" == "-"
    let no_c: A? = A(b: B(c: none))
    assert f"{(no_c?.b?.c?.n) is none}" == "true"
}
