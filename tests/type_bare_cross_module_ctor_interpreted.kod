// The interpreter reports a constructor naming a struct only another module
// declares, with the compiler's hint.
import "./type_bare_cross_module_dep"

func main() -> int64 {
    let p = Pt(x: 1)
    return p.x
}

// expected status:
// 1
// expected stderr:
// 6:13: error: unknown type `Pt`; tests/type_bare_cross_module_dep.kod declares `Pt`: write `type_bare_cross_module_dep.Pt` or list it in the import (`{ Pt }`)
