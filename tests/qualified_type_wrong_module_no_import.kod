// The compiler reports `is x.T` where `x` names no module, rather than
// matching any module's `T`.
import "./qualified_type_wrong_module_ka"

func main() -> int64 {
    let err: Error = qualified_type_wrong_module_ka.NotFound(key: "x")
    let held = err is _: nosuch.NotFound
    if held {
        return 2
    }
    return 0
}

// expected status:
// 1
// expected stderr:
// 7:16: error: unknown type `nosuch.NotFound`
