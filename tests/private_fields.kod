// Private fields: the struct's own functions read, assign and construct them; defaults fill them in outside.

type Duration = struct {
    _ns: int64
    label: str = ""

    func init(seconds: int64 = 0, ms: int64 = 0) -> Duration {
        return Duration(_ns: seconds * 1 000 000 000 + ms * 1 000 000)
    }

    func as_ms(self) -> int64 {
        return self._ns / 1 000 000
    }

    func add_ms(self, ms: int64) -> none {
        self._ns += ms * 1 000 000
    }

    func op_add(self, other: Duration) -> Duration {
        return Duration(_ns: self._ns + other._ns)
    }
}

type Counter = struct {
    _count: int64 = 0
    name: str

    func hit(self) -> int64 {
        self._count = self._count + 1
        return self._count
    }
}

func main() -> int64 {
    let d = Duration(seconds: 5)
    print_int(d.as_ms())
    d.add_ms(ms: 250)
    print_int(d.as_ms())
    print_int((d + Duration(ms: 750)).as_ms())
    d.label = "timeout"
    print(d.label)

    let c = Counter(name: "hits")
    print_int(c.hit())
    print_int(c.hit())
    return 0
}

// expected output:
// 5000
// 5250
// 6000
// timeout
// 1
// 2

// expected status:
// 0
