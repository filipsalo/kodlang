// A pattern naming a generic enum binds the subject instance's payload types.
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}
type Oops = struct {
    message: str
    func to_str(self) -> str { return self.message }
}
func half(anon n: int64) -> int64 or Error {
    if n % 2 == 1 {
        throw Oops(message: "odd")
    }
    return n / 2
}
func main() -> int64 {
    let m: Maybe[int64] = .Just(value: 41)
    match m {
        Maybe.Just(v) -> print(f"match {v + 1}")
        Maybe.Nothing -> print("nothing")
    }
    let k = match m {
        Maybe.Just(v) -> v + 10
        Maybe.Nothing -> 0
    }
    print_int(k)
    if m is Maybe.Just(w) {
        print_int(w * 2)
    }
    let s: Maybe[str] = .Just(value: "hi")
    match s {
        Maybe.Just(t) -> print(t + "!")
        Maybe.Nothing -> print("nothing")
    }
    if s is Maybe.Just(u) {
        print(u + "?")
    }
    let o: int64? = 4
    match o {
        Option.Some(v) -> print_int(v + 1)
        Option.None -> print("none")
    }
    let r: int64 = match o {
        Option.Some(v) -> v + 10
        Option.None -> 0
    }
    print_int(r)
    if o is Option.Some(z) {
        print_int(z + 20)
    }
    let e = half(4)
    match e {
        Result.Ok(v) -> print_int(v + 1)
        Result.Err(x) -> print(x.to_str())
    }
    let q = match half(3) {
        Result.Ok(v) -> f"ok {v}"
        Result.Err(x) -> f"err {x.to_str()}"
    }
    print(q)
    if e is Result.Ok(y) {
        print_int(y + 30)
    }
    let n: int64? = none
    print(f"{m is Maybe.Just} {o is Option.Some} {n is Option.None} {e is Result.Ok} {e is Result.Err}")
    return 0
}

// expected output:
// match 42
// 51
// 82
// hi!
// hi?
// 5
// 14
// 24
// 3
// err odd
// 32
// true true true true false
