// Imported sigs whose return type comes from a transitive import.
import "./../xmod_method_sig_a"

func via_iface(anon g: xmod_method_sig_a.Getter) -> str {
    let w = g.get()
    return w.s
}

test "method return type from a transitive import" {
    let v: xmod_method_sig_a.A = xmod_method_sig_a.A(s: "from b")
    let w = v.get()
    assert w.s == "from b"
    assert via_iface(v) == "from b"
}
