// The other module declaring types of the same names as type_names_pa.
interface Sized {
    func size(self) -> int64
}

type Pt = struct {
    x: int64
    y: int64

    func size(self) -> int64 {
        return self.x + self.y
    }
}

type Shape = enum {
    Circle(r: int64)
    Square(s: int64)
}

type Mode = enum {
    On
    Off
    Dim
}

type Box[T] = struct {
    v: T
    n: int64 = 2

    func size(self) -> int64 {
        return self.n
    }
}

type IntBox = Box[int64]

type Label = struct {
    text: str
}

type Score = int64

type Maybe[T] = enum {
    Just(v: T)
    Nothing
}

type Oops = struct {
    code: int64

    func to_str(self) -> str {
        return f"pb oops {self.code}"
    }
}

func make(anon x: int64, anon y: int64) -> Pt {
    return Pt(:x, :y)
}

func boxed(anon x: int64) -> Sized {
    return IntBox(v: x)
}

func is_int_box(anon s: Sized) -> bool {
    return s is IntBox
}

func is_pt(anon s: Sized) -> bool {
    return s is Pt
}

func fail(anon n: int64) -> int64 or Error {
    throw Oops(code: n)
}

func just(anon n: int64) -> Maybe[int64] {
    return .Just(v: n + 1)
}

func area(anon s: Shape) -> int64 {
    match s {
        .Circle(r) -> return r * 4
        .Square(side) -> return side * side
    }
}

