// One passing and one failing `test` block. tests/examples_test.py runs
// this through `kod test` and expects a failed run, so a regression that
// makes the test runner pass everything can't go unnoticed. Not named
// `*_test.kod`, so directory-mode `kod test` skips it.

test "canary: this test passes" {
    assert 1 + 1 == 2
}

test "canary: this test fails" {
    assert 1 + 1 == 3
}

// expected mode:
// skip
