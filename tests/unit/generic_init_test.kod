// A generic struct may declare `init`; it is called on the spelled instance.

type Backwards = shared struct {
    func to_str(self) -> str {
        return "hi < lo"
    }
}

type Range[T] = shared struct {
    lo: T
    hi: T

    func init(lo: T, hi: T) -> Range[T] or Error {
        if hi < lo {
            throw Backwards()
        }
        return Range[T](:lo, :hi)
    }

    func width(self) -> T {
        return self.hi - self.lo
    }
}

type Stack[T] = shared struct {
    items: [T]

    func init() -> Stack[T] {
        return Stack[T](items: [])
    }

    func push(self, anon x: T) -> none {
        self.items += [x]
    }
}

// The notes `Pair.init` was given, in order.
mut notes: [str] = []

// Inside its own functions, any instance is built from its fields.
type Pair[A, B] = shared struct {
    first: A
    second: B

    func init(first: A, second: B, note: str) -> Pair[A, B] {
        notes += [note]
        return Pair[A, B](:first, :second)
    }

    func swap(self) -> Pair[B, A] {
        return Pair[B, A](first: self.second, second: self.first)
    }
}

test "init on a generic struct with a fallible result" {
    let r = must Range[int64](lo: 2, hi: 9)
    assert r.width() == 7
    let f = must Range[float64](lo: 0.5, hi: 2.0)
    assert f"{f.width()}" == "1.5"
    if Range[int64](lo: 5, hi: 1) is Error(e) {
        assert e.to_str() == "hi < lo"
    } else {
        fail("no error")
    }
}

test "init with no arguments" {
    let s = Stack[str]()
    s.push("a")
    s.push("b")
    assert len(s.items) == 2
    let n = Stack[int64]()
    n.push(1)
    assert len(n.items) == 1
}

test "init builds another instance inside its own functions" {
    let p = Pair[str, int64](first: "a", second: 1, note: "made")
    assert notes == ["made"]
    let q = p.swap()
    assert q.first == 1
    assert q.second == "a"
}
