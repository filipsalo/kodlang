// An implicit variant in an array literal belongs to the array's element enum.
type A = enum {
    Up
    Hit(n: int64)
}
type B = enum {
    Miss
    Hit(n: int64)
    Up
}
type Maybe[T] = enum {
    Nothing
    Just(value: T)
}
type Holder = shared struct {
    bs: [B]
}
func show(anon b: B) -> str {
    return match b {
        .Miss -> "miss"
        .Hit(n) -> f"hit {n}"
        .Up -> "up"
    }
}
func shows(anon bs: [B]) -> str {
    mut parts = ""
    for b in bs {
        parts = parts + show(b) + ";"
    }
    return parts
}
func just(anon m: Maybe[str]) -> str {
    return match m {
        .Just(v) -> v
        .Nothing -> "nothing"
    }
}
func make() -> [B] {
    return [.Up, .Hit(n: 2)]
}
func grid() -> [[B]] {
    return [[.Hit(n: 3)], [.Up]]
}
test "variants in literals of every slot belong to B" {
    let bs: [B] = [.Hit(n: 1), .Miss, .Up]
    assert shows(bs) == "hit 1;miss;up;"
    assert shows([.Up, .Hit(n: 4)]) == "up;hit 4;"
    mut acc: [B] = []
    acc += [.Up]
    acc += [.Hit(n: 5)]
    assert shows(acc) == "up;hit 5;"
    acc[0] = .Hit(n: 6)
    assert shows(acc) == "hit 6;hit 5;"
    assert shows(make()) == "up;hit 2;"
    let g = grid()
    assert shows(g[0]) == "hit 3;"
    assert shows(g[1]) == "up;"
    let nested: [[B]] = [[.Up], [.Hit(n: 7)]]
    assert shows(nested[1]) == "hit 7;"
    mut h = Holder(bs: [.Hit(n: 8)])
    assert shows(h.bs) == "hit 8;"
    h.bs = [.Up, .Miss]
    assert shows(h.bs) == "up;miss;"
    mut m = Map[str, [B]]()
    m["x"] = [.Up]
    assert shows(must m["x"]) == "up;"
}

test "variants in literals belong to a generic element enum" {
    let ms: [Maybe[str]] = [.Nothing, .Just(value: "j")]
    assert just(ms[0]) == "nothing"
    assert just(ms[1]) == "j"
    mut mm: [Maybe[str]] = []
    mm += [.Just(value: "pe")]
    mm[0] = .Just(value: "set")
    assert just(mm[0]) == "set"
}
