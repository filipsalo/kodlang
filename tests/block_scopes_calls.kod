// A call in a block whose binding hides an outer one: a binding that holds
// no function leaves the call to the module's function or the builtin of
// its name, and a function value hides an outer one only inside
// the block, so the outer one is called again after it.
type Pt = struct {
    x: int64
}

func double(anon n: int64) -> int64 {
    return n * 2
}

func triple(anon n: int64) -> int64 {
    return n * 3
}

func fail(anon msg: str) -> none {
    kod_panic(msg)
}

func intrinsics(anon len: int64, anon hash: int64) -> str {
    mut out = f"{len + hash}"
    if len > 0 {
        let len = "abc"
        let hash = "ab"
        out += f" {len(len)} {hash(hash) == "ab".hash()}"
    }
    return out
}

func module_fn(anon double: int64) -> int64 {
    if double > 0 {
        let double = double + 1
        return double(double)
    }
    return double
}

func builtin(anon print_int: str) -> none {
    if len(print_int) > 0 {
        let print_int = len(print_int)
        print_int(print_int)
    }
}

func values(anon n: int64) -> none {
    let f = double
    print_int(f(n))
    if n > 0 {
        let f = triple
        print_int(f(n))
        if n > 1 {
            let f = 7
            print_int(f)
        }
        print_int(f(n))
    }
    print_int(f(n))
}

func arm_value(anon o: int64?, anon kod_panic: str) -> int64 {
    if len(kod_panic) > 0 {
        let kod_panic = 1
        let v = match o {
            Some(v) -> v + kod_panic
            none -> kod_panic("none")
        }
        return v + (o? or kod_panic("none"))
    }
    return 0
}

func arm_fail(anon o: int64?, anon fail: int64) -> int64 {
    if fail > 0 {
        let fail = 2
        return match o {
            Some(v) -> v * fail
            none -> fail("none")
        }
    }
    return 0
}

func panics(anon kod_panic: int64) -> none {
    if kod_panic > 0 {
        let kod_panic = "boom"
        kod_panic(kod_panic)
    }
}

func main() -> int64 {
    print(intrinsics(1, 3))
    print_int(module_fn(4))
    builtin("abcd")
    values(2)
    print_int(arm_value(4, "x"))
    print_int(arm_fail(4, 1))
    panics(1)
    return 0
}

// expected output:
// 4 3 true
// 10
// 4
// 4
// 6
// 7
// 6
// 4
// 9
// 8
// expected stderr:
// panic: boom
// expected status:
// 1
