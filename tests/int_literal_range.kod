// An integer literal must fit in int64; 2^63 only right after a prefix `-`.
func main() -> int64 {
    let ok = -9223372036854775808 + 9223372036854775807
    let big = 9223372036854775808
    return ok + big
}

// expected errors:
// 4:15: error: integer literal `9223372036854775808` doesn't fit in `int64`, whose largest value is 9223372036854775807
