// The interpreter names a struct in its construction errors as the compiler
// does: through the module when another module declares a type of that name.
import "./type_names_pa"
import "./type_names_pb"

func main() -> int64 {
    let p = type_names_pa.Pt(z: 3)
    return 0
}

// expected status:
// 1
// expected stderr:
// 7:30: error: struct `type_names_pa.Pt` has no field `z`
// expected mode:
// interpret
