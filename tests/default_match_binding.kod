// A match binding inside a parameter or field default gets its own slot:
// the default's value comes out right, a caller with no `v` compiles, and
// a caller's own `v` is untouched. The interpreter still evaluates
// defaults in the caller's frame, so this runs compiled only for now.

func pick(anon n: int64) -> int64? {
    if n > 0 {
        return n
    }
    return none
}

func amount(by: int64 = match pick(7) { Some(v) -> v + 1  none -> 0 }) -> int64 {
    return by
}

type Box = struct {
    size: int64 = match pick(3) { Some(v) -> v * 2  none -> 0 }

    func grow(self, by: int64 = match pick(5) { Some(v) -> v  none -> 0 }) -> int64 {
        return self.size + by
    }
}

func no_local() -> int64 {
    return amount()
}

func main() -> int64 {
    print_int(no_local())
    let v = 100
    print_int(amount())
    print_int(v)
    let b = Box()
    print_int(b.size)
    print_int(v)
    print_int(b.grow())
    print_int(v)
    return 0
}

// expected output:
// 8
// 8
// 100
// 6
// 100
// 11
// 100

// expected mode:
// run
