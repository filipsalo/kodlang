// A growable string buffer. `s += piece` copies all of `s` every time, which
// is quadratic over a loop; a StrBuilder appends in amortised constant time
// (stdlib/runtime.c). Copies of a StrBuilder share one buffer.
//
//   let out = StrBuilder()
//   out.append("GET ")
//   out.append(path)
//   let request = out.to_str()
type StrBuilder = struct {
    handle: int64 = kod_sb_new()

    func append(self, anon s: str) -> none {
        kod_sb_append(self.handle, s)
    }

    func append_bytes(self, anon b: bytes) -> none {
        kod_sb_append(self.handle, kod_bytes_to_str(b))
    }

    // Only the low 8 bits of `b` are used.
    func append_byte(self, anon b: int64) -> none {
        kod_sb_append_byte(self.handle, b)
    }

    func len(self) -> int64 {
        return kod_sb_len(self.handle)
    }

    func clear(self) -> none {
        kod_sb_clear(self.handle)
    }

    // A copy of the content so far; the builder stays usable.
    func to_str(self) -> str {
        return kod_sb_to_str(self.handle)
    }

    func to_bytes(self) -> bytes {
        return kod_str_to_bytes(kod_sb_to_str(self.handle))
    }
}
