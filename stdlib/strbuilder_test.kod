import "strbuilder" { StrBuilder }

test "a new builder is empty" {
    let b = StrBuilder()
    assert b.len() == 0
    assert b.to_str() == ""
}

test "append in order" {
    let b = StrBuilder()
    b.append("HTTP/1.1")
    b.append(" ")
    b.append("200")
    b.append("")
    assert b.len() == 12
    assert b.to_str() == "HTTP/1.1 200"
}

test "append_byte keeps the low 8 bits and NUL bytes" {
    let b = StrBuilder()
    b.append_byte(104)
    b.append_byte(0)
    b.append_byte(256 + 105)
    b.append_byte(-1)
    let s = b.to_str()
    assert len(s) == 4
    assert s[0] == 104 and s[1] == 0 and s[2] == 105 and s[3] == 255
}

test "append_bytes and to_bytes" {
    let raw = kod_bytes_from_array([0, 255, 10, 13])
    let b = StrBuilder()
    b.append("x")
    b.append_bytes(raw)
    let out = b.to_bytes()
    assert len(out) == 5
    assert out == kod_bytes_from_array([120, 0, 255, 10, 13])
}

test "growth across many sizes" {
    let b = StrBuilder()
    mut i: int64 = 0
    for i < 20000 {
        b.append("ab")
        b.append_byte(99)
        i = i + 1
    }
    assert b.len() == 60000
    let s = b.to_str()
    assert len(s) == 60000
    assert s[0..3] == "abc" and s[59997..60000] == "abc"
    assert s[30000] == 'a' or s[30000] == 'b' or s[30000] == 'c'
}

test "one append larger than the buffer" {
    let b = StrBuilder()
    b.append("x")
    b.append("y".repeat(100000))
    assert b.len() == 100001
    assert b.to_str()[100000] == 'y'
}

test "to_str is a copy and the builder stays usable" {
    let b = StrBuilder()
    b.append("one")
    let first = b.to_str()
    b.append("two")
    assert first == "one"
    assert b.to_str() == "onetwo"
}

test "clear starts over" {
    let b = StrBuilder()
    b.append("some content")
    b.clear()
    assert b.len() == 0 and b.to_str() == ""
    b.append("new")
    assert b.to_str() == "new"
}

test "copies of a builder share one buffer" {
    let a = StrBuilder()
    let b = a
    a.append("x")
    b.append("y")
    assert a.to_str() == "xy" and b.len() == 2
}

test "builders are independent" {
    let a = StrBuilder()
    let b = StrBuilder()
    a.append("a")
    b.append("b")
    assert a.to_str() == "a" and b.to_str() == "b"
}

test "usable in an f-string" {
    let b = StrBuilder()
    b.append("inner")
    assert f"<{b}>" == "<inner>"
}
