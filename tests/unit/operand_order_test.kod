// F-string interpolations and the operands of string `+`, string
// comparisons and array `+` are evaluated left to right, so a call's side
// effects are seen by the parts after it.

type Counter = shared struct {
    n: int64
}

func bump(c: Counter) -> int64 {
    c.n = c.n + 10
    return c.n
}

type Log = shared struct {
    text: str = ""

    func add(self, anon s: str) -> str {
        self.text = self.text + s
        return s
    }

    func one(self, anon s: str) -> [str] {
        self.text = self.text + s
        return [s]
    }
}

test "f-string interpolations left to right" {
    let c = Counter(n: 1)
    assert f"{bump(:c)} then {c.n}" == "11 then 11"
}

test "string and array operands left to right" {
    let log = Log()
    assert log.add("a") + log.add("b") + log.add("c") == "abc"
    assert log.text == "abc"
    assert f"[{log.add("d")}{log.add("e")}]" == "[de]"
    assert log.text == "abcde"
    if log.add("x") < log.add("y") {
        assert log.text == "abcdexy"
    } else {
        fail("x is not less than y")
    }
    let xs = log.one("1") + log.one("2") + log.one("3")
    assert len(xs) == 3
    assert log.text == "abcdexy123"
}
