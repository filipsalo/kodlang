// Programs in tests/ that must fail to compile, checked through
// test_support.file_errors. They import helper files next to them, so they
// stay files there; each is marked `mode: skip` for the example runner.

import "kod/test_support"
import "process"

// The type of a local that is no function is written as a type argument
// list too, each name qualified when another module declares it: a generic
// instance, its type arguments, a `T or Error`.
test "a local that is no function: generic instances and `T or Error`, qualified" {
    let errs = test_support.file_errors("tests/call_local_nonfunc_generic.kod")
    assert errs != ""
    assert errs.contains("tests/call_local_nonfunc_generic.kod:30:15: error: `a` is a local of type `generic_names_pa.Box[int64]`, not a function")
    assert errs.contains("tests/call_local_nonfunc_generic.kod:30:22: error: `b` is a local of type `generic_names_pb.Box[[generic_names_pb.Pt]]`, not a function")
    assert errs.contains("tests/call_local_nonfunc_generic.kod:30:29: error: `c` is a local of type `generic_names_pb.Box[generic_names_pb.Box[generic_names_pb.Pt]]`, not a function")
    assert errs.contains("tests/call_local_nonfunc_generic.kod:30:36: error: `d` is a local of type `generic_names_pa.Maybe[generic_names_pa.Pt]`, not a function")
    assert errs.contains("tests/call_local_nonfunc_generic.kod:30:43: error: `e` is a local of type `[generic_names_pb.Pt]`, not a function")
    assert errs.contains("tests/call_local_nonfunc_generic.kod:30:50: error: `f` is a local of type `int64 or Error`, not a function")
}

// The local's type is written the way the module would write it when two
// modules declare a type of that name.
test "a local that is no function: its type qualified as the module writes it" {
    let errs = test_support.file_errors("tests/call_local_nonfunc_modules.kod")
    assert errs != ""
    assert errs.contains("tests/call_local_nonfunc_modules.kod:10:15: error: `g` is a local of type `type_names_pb.Pt`, not a function")
    assert errs.contains("tests/call_local_nonfunc_modules.kod:11:12: error: `k` is a local of type `type_names_pa.Pt`, not a function")
}

// An imported module whose import names no file and whose signatures name
// an unknown type: building this module shows those errors, not only the
// cascades of its calls into it.
test "an imported module's own errors are reported, not only the cascades" {
    let errs = test_support.file_errors("tests/dep_signature_error.kod")
    assert errs != ""
    assert errs.contains("tests/dep_signature_error_dep.kod:1:8: error: no such module `./no_such_dep_module` (looked for tests/no_such_dep_module.kod)")
}

// The compiler reports a match of an enum's variant on an interface value.
test "an enum variant matched on an interface value" {
    let errs = test_support.file_errors("tests/downcast_enum.kod")
    assert errs != ""
    assert errs.contains("11:11: error: `Kind.NotFound` needs an enum value, got `Error`")
}

// A local can't take an import's name, so a downcast through the module can't be hidden.
test "a local can't take an import's name used in a downcast" {
    let errs = test_support.file_errors("tests/downcast_hidden.kod")
    assert errs != ""
    assert errs.contains("6:9: error: `downcast_qualified_dep` is the name of an import; give the local another name")
}

// A downcast through a module binds one name.
test "a downcast through a module binds one name" {
    let errs = test_support.file_errors("tests/downcast_qualified_two_bindings.kod")
    assert errs != ""
    assert errs.contains("tests/downcast_qualified_two_bindings.kod:6:8: error: a downcast to `downcast_qualified_dep.BadInput` binds one name, got 2; bind the value and read its fields")
}

// A downcast through a module's name still needs a struct of that name.
test "a downcast through a module needs a type of that name" {
    let errs = test_support.file_errors("tests/downcast_qualified_unknown.kod")
    assert errs != ""
    assert errs.contains("tests/downcast_qualified_unknown.kod:6:8: error: module `downcast_qualified_dep` has no type `Nope`")
    assert errs.contains("tests/downcast_qualified_unknown.kod:9:12: error: module `downcast_qualified_dep` has no type `Nope`")
}

// A downcast to a generic type written through a module is reported as written.
test "a downcast to a generic type through a module" {
    let errs = test_support.file_errors("tests/downcast_template_qualified.kod")
    assert errs != ""
    assert errs.contains("tests/downcast_template_qualified.kod:7:16: error: `downcast_generic_xmod_dep.Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = downcast_generic_xmod_dep.Box[int64]`")
    assert errs.contains("tests/downcast_template_qualified.kod:8:8: error: `downcast_generic_xmod_dep.Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = downcast_generic_xmod_dep.Box[int64]`")
    assert errs.contains("tests/downcast_template_qualified.kod:11:11: error: `downcast_generic_xmod_dep.Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = downcast_generic_xmod_dep.Box[int64]`")
}

// What a qualified generic constructor reports.
test "qualified generic constructor errors" {
    let errs = test_support.file_errors("tests/generic_ctor_qualified_errors.kod")
    assert errs != ""
    assert errs.contains("tests/generic_ctor_qualified_errors.kod:6:13: error: module `generic_qual_dep` has no function or type `Bax`; did you mean `Box`?")
    assert errs.contains("tests/generic_ctor_qualified_errors.kod:7:13: error: `generic_qual_dep.Pt` is not generic")
    assert errs.contains("tests/generic_ctor_qualified_errors.kod:8:13: error: `generic_qual_dep.Box` expects 1 type argument, got 2")
    assert errs.contains("tests/generic_ctor_qualified_errors.kod:9:34: error: unknown type `Nope`; did you mean `none`?")
    assert errs.contains("tests/generic_ctor_qualified_errors.kod:10:51: error: module `generic_qual_dep` has no type `Nope`")
    assert errs.contains("tests/generic_ctor_qualified_errors.kod:11:34: error: module `generic_qual_dep` has no type `Bax`; did you mean `Box`?")
    assert errs.contains("tests/generic_ctor_qualified_errors.kod:12:42: error: expected `str`, got `int64`")
    assert errs.contains("tests/generic_ctor_qualified_errors.kod:13:13: error: `_Hidden` is private to module `generic_qual_dep`")
}

// A hint names the file of a call it follows into another module.
test "a hint names the file of a call into another module" {
    let errs = test_support.file_errors("tests/hint_xmod_line.kod")
    assert errs != ""
    assert errs.contains("tests/hint_xmod_line.kod:9:12: error: expected `int64`, got `none`; the call is taken to return, as `die` ends in `x.fail(msg)` (line 15 of tests/hint_xmod_line_dep.kod), a method called through an interface value, which is taken to return; if that one never returns, add a `panic(...)` after it")
}

// `.Circle` is ambiguous when this module's enum and an imported module's
// enum both declare it.
test "an implicit variant two modules' enums declare is ambiguous" {
    let errs = test_support.file_errors("tests/implicit_variant_ambiguous.kod")
    assert errs != ""
    assert errs.contains("tests/implicit_variant_ambiguous.kod:19:13: error: `.Circle` is ambiguous: `implicit_variant_ambiguous_dep.Figure` and `Shape` both declare it; write `Shape.Circle` or give the value a type")
}

// A module can't both declare a name and list it in an import, and two
// imports can't list the same name, whether it names a type or a function.
// "./import_name_twice_pb" is loaded twice, which is fine. An import that
// lists names binds no alias, so line 6's other `import_name_twice_pa` is too.
test "a name declared and imported, or listed by two imports" {
    let errs = test_support.file_errors("tests/import_name_twice.kod")
    assert errs != ""
    assert errs.contains("tests/import_name_twice.kod:8:35: error: `Num` is already imported on line 7")
    assert errs.contains("tests/import_name_twice.kod:8:40: error: `scale` is already imported on line 7")
    assert errs.contains("tests/import_name_twice.kod:9:35: error: `scale` is already imported on line 7")
    assert errs.contains("tests/import_name_twice.kod:11:6: error: `Num` is already imported on line 7")
    assert errs.contains("tests/import_name_twice.kod:13:6: error: `shift` is already imported on line 8")
}

// The compiler reports two imports that share a name but load different files.
test "two imports with one name loading different files" {
    let errs = test_support.file_errors("tests/import_name_twice_alias.kod")
    assert errs != ""
    assert errs.contains("4:8: error: `import_name_twice_pa` is already imported on line 3")
}

// The compiler reports a name two imports list.
test "a name two imports list" {
    let errs = test_support.file_errors("tests/import_name_twice_items.kod")
    assert errs != ""
    assert errs.contains("4:35: error: `scale` is already imported on line 3")
}

// Importing a file that doesn't exist is an error, not a silently empty
// module.
test "importing a file that doesn't exist" {
    let errs = test_support.file_errors("tests/missing_import.kod")
    assert errs != ""
    assert errs.contains("tests/missing_import.kod:4:8: error: no such module `./no_such_module` (looked for tests/no_such_module.kod)")
}

// Only the module that declares a variable assigns it.
test "only the declaring module assigns a module variable" {
    let errs = test_support.file_errors("tests/module_vars_assign.kod")
    assert errs != ""
    assert errs.contains("tests/module_vars_assign.kod:7:5: error: `count` can only be assigned in tests/module_vars_assign_dep.kod")
    assert errs.contains("tests/module_vars_assign.kod:8:5: error: `count` can only be assigned in tests/module_vars_assign_dep.kod")
    assert errs.contains("tests/module_vars_assign.kod:9:5: error: `words` can only be assigned in tests/module_vars_assign_dep.kod")
    assert errs.contains("tests/module_vars_assign.kod:10:5: error: `words` can only be changed in tests/module_vars_assign_dep.kod")
}

// A call through a function value whose type another module writes is
// reported at the call, whatever this module reports itself.
test "the parameter limit through another module's function type" {
    let errs = test_support.file_errors("tests/param_limit_xmod.kod")
    assert errs != ""
    assert errs.contains("tests/param_limit_xmod.kod:6:6: error: `own` takes 9 parameters, but a function can take at most 8")
    assert errs.contains("tests/param_limit_xmod.kod:15:16: error: `g` takes 9 parameters, but a function can take at most 8 (in `Holder[func(int64, int64, int64, int64, int64, int64, int64, int64, int64) -> int64]`)")
    assert errs.contains("tests/param_limit_xmod.kod:22:12: error: `h` takes 9 parameters, but a function can take at most 8")
}

// `kb.T` names only a type the module imported as `kb` declares, though
// another module of the program declares a `T`.
test "`kb.T` names only a type of the module imported as `kb`" {
    let errs = test_support.file_errors("tests/qualified_type_wrong_module.kod")
    assert errs != ""
    assert errs.contains("tests/qualified_type_wrong_module.kod:7:52: error: module `qualified_type_wrong_module_kb` has no type `NotFound`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:11:51: error: module `qualified_type_wrong_module_kb` has no type `Fuond`; did you mean `Found`?")
    assert errs.contains("tests/qualified_type_wrong_module.kod:16:45: error: module `qualified_type_wrong_module_kb` has no function or type `NotFound`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:17:53: error: module `qualified_type_wrong_module_kb` has no type `NotFound`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:19:16: error: module `qualified_type_wrong_module_kb` has no type `NotFound`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:20:8: error: module `qualified_type_wrong_module_kb` has no type `NotFound`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:23:44: error: module `qualified_type_wrong_module_kb` has no type `E`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:24:44: error: module `qualified_type_wrong_module_kb` has no type `E`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:25:11: error: module `qualified_type_wrong_module_kb` has no type `E`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:29:17: error: unknown type `time.Clock`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:31:19: error: unknown type `nosuch.NotFound`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:32:8: error: unknown type `nosuch.NotFound`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:36:25: error: module `qualified_type_wrong_module_kb` has no type `Nope`")
    assert errs.contains("tests/qualified_type_wrong_module.kod:37:11: error: unknown type `nosuch.E`")
}

// The compiler reports `is kb.T` for a `T` only another module declares,
// rather than matching the other module's `T`.
test "`is kb.T` for a `T` only another module declares" {
    let errs = test_support.file_errors("tests/qualified_type_wrong_module_is.kod")
    assert errs != ""
    assert errs.contains("9:8: error: module `qualified_type_wrong_module_kb` has no type `NotFound`")
}

// The compiler reports `is m.E.V` where the module imported as `m`
// declares no `E`, rather than testing the variant alone.
test "`is m.E.V` where `m` declares no `E`" {
    let errs = test_support.file_errors("tests/qualified_type_wrong_module_is_three.kod")
    assert errs != ""
    assert errs.contains("9:24: error: module `qualified_type_wrong_module_kb` has no type `Nope`")
}

// The compiler reports `is x.T` where `x` names no module, rather than
// matching any module's `T`.
test "`is x.T` where `x` names no module" {
    let errs = test_support.file_errors("tests/qualified_type_wrong_module_no_import.kod")
    assert errs != ""
    assert errs.contains("8:16: error: unknown type `nosuch.NotFound`")
}

// The compiler reports a three-part pattern written through a name that
// is no module, rather than matching by the variant alone.
test "a three-part pattern through a name that is no module" {
    let errs = test_support.file_errors("tests/qualified_type_wrong_module_pattern.kod")
    assert errs != ""
    assert errs.contains("8:11: error: unknown type `nosuch.E`")
}

// A name that is a local only elsewhere, after its block or before its
// `let`, means what it would without the local: a type that only another
// module declares gets the hint to write or import it.
test "a local only elsewhere doesn't hide the hint for a type of another module" {
    let errs = test_support.file_errors("tests/scoped_reads_type.kod")
    assert errs != ""
    assert errs.contains("tests/scoped_reads_type.kod:13:13: error: unknown type `Pt`; tests/scoped_reads_type_dep.kod declares `Pt`: write `scoped_reads_type_dep.Pt` or list it in the import (`{ Pt }`)")
    assert errs.contains("tests/scoped_reads_type.kod:14:13: error: unknown type `Mode`; tests/scoped_reads_type_dep.kod declares `Mode`: write `scoped_reads_type_dep.Mode` or list it in the import (`{ Mode }`)")
    assert errs.contains("tests/scoped_reads_type.kod:19:13: error: unknown type `Pt`; tests/scoped_reads_type_dep.kod declares `Pt`: write `scoped_reads_type_dep.Pt` or list it in the import (`{ Pt }`)")
    assert errs.contains("tests/scoped_reads_type.kod:20:13: error: unknown type `Mode`; tests/scoped_reads_type_dep.kod declares `Mode`: write `scoped_reads_type_dep.Mode` or list it in the import (`{ Mode }`)")
}

// A bare type name means a type of this module, one an import lists or a
// builtin, not one of a module imported without listing it or loaded only
// because another module imports it.
test "a bare type name means only a type this module can see" {
    let errs = test_support.file_errors("tests/type_bare_cross_module.kod")
    assert errs != ""
    assert errs.contains("tests/type_bare_cross_module.kod:7:18: error: unknown type `Pt`; tests/type_bare_cross_module_dep.kod declares `Pt`: write `type_bare_cross_module_dep.Pt` or list it in the import (`{ Pt }`)")
    assert errs.contains("tests/type_bare_cross_module.kod:11:20: error: unknown type `Gear`; tests/type_bare_cross_module_base.kod declares `Gear`: import it to use it here")
    assert errs.contains("tests/type_bare_cross_module.kod:16:12: error: unknown type `Pt`; tests/type_bare_cross_module_dep.kod declares `Pt`: write `type_bare_cross_module_dep.Pt` or list it in the import (`{ Pt }`)")
    assert errs.contains("tests/type_bare_cross_module.kod:27:12: error: `Mode` doesn't implement `Error`, so a `Error` is never a `Mode`")
    assert errs.contains("tests/type_bare_cross_module.kod:30:20: error: unknown type `Pnt`; did you mean `Pnx`?")
    assert errs.contains("tests/type_bare_cross_module.kod:36:13: error: unknown type `Mood`; tests/type_bare_cross_module_dep.kod declares `Mood`: write `type_bare_cross_module_dep.Mood` or list it in the import (`{ Mood }`)")
    assert errs.contains("tests/type_bare_cross_module.kod:37:46: error: unknown type `Mood`; tests/type_bare_cross_module_dep.kod declares `Mood`: write `type_bare_cross_module_dep.Mood` or list it in the import (`{ Mood }`)")
    assert errs.contains("tests/type_bare_cross_module.kod:38:8: error: unknown type `Mood`; tests/type_bare_cross_module_dep.kod declares `Mood`: write `type_bare_cross_module_dep.Mood` or list it in the import (`{ Mood }`)")
    assert errs.contains("tests/type_bare_cross_module.kod:41:11: error: unknown type `Mood`; tests/type_bare_cross_module_dep.kod declares `Mood`: write `type_bare_cross_module_dep.Mood` or list it in the import (`{ Mood }`)")
    assert errs.contains("tests/type_bare_cross_module.kod:43:29: error: unknown type `Mood`; tests/type_bare_cross_module_dep.kod declares `Mood`: write `type_bare_cross_module_dep.Mood` or list it in the import (`{ Mood }`)")
    assert errs.contains("tests/type_bare_cross_module.kod:48:13: error: unknown type `Pt`; tests/type_bare_cross_module_dep.kod declares `Pt`: write `type_bare_cross_module_dep.Pt` or list it in the import (`{ Pt }`)")
}

// The compiler reports a constructor naming a struct only another module
// declares, with a hint.
test "a constructor of a struct only another module declares" {
    let errs = test_support.file_errors("tests/type_bare_cross_module_ctor.kod")
    assert errs != ""
    assert errs.contains("7:13: error: unknown type `Pt`; tests/type_bare_cross_module_dep.kod declares `Pt`: write `type_bare_cross_module_dep.Pt` or list it in the import (`{ Pt }`)")
}

// The compiler reports `is T` for a `T` only another module declares,
// rather than matching that module's `T`.
test "`is T` for a `T` only another module declares" {
    let errs = test_support.file_errors("tests/type_bare_cross_module_is.kod")
    assert errs != ""
    assert errs.contains("8:8: error: unknown type `Pt`; tests/type_bare_cross_module_dep.kod declares `Pt`: write `type_bare_cross_module_dep.Pt` or list it in the import (`{ Pt }`)")
}

// A bare type name in a dep is an error there even when the entry declares
// that type, and the hint says where it is.
test "a bare type name in a dep that only the entry declares" {
    // The hint needs the whole program, which only the `kod` driver
    // gives a module it compiles; file_errors compiles the entry alone.
    let r = process.run(["./build/apps/kod/kod", "check", "tests/type_bare_cross_module_late.kod"])
    assert r.status == 1
    let errs = r.stderr
    assert errs != ""
    assert errs.contains("tests/type_bare_cross_module_late_dep.kod:1:19: error: unknown type `Late`; tests/type_bare_cross_module_late.kod declares `Late`: import it to use it here")
}

// The compiler reports a pattern naming an enum only another module
// declares, rather than matching by the variant alone.
test "a pattern naming an enum only another module declares" {
    let errs = test_support.file_errors("tests/type_bare_cross_module_pattern.kod")
    assert errs != ""
    assert errs.contains("8:11: error: unknown type `Mood`; tests/type_bare_cross_module_dep.kod declares `Mood`: write `type_bare_cross_module_dep.Mood` or list it in the import (`{ Mood }`)")
}

// The compiler reports a bare type name in a return type that only
// another module declares, as it does in a parameter.
test "a return type only another module declares" {
    let errs = test_support.file_errors("tests/type_bare_cross_module_return.kod")
    assert errs != ""
    assert errs.contains("6:18: error: unknown type `Pt`; tests/type_bare_cross_module_dep.kod declares `Pt`: write `type_bare_cross_module_dep.Pt` or list it in the import (`{ Pt }`)")
}

// The hint names a module only another module of the program imports.
test "the hint names a module only a sibling imports" {
    // The hint needs the whole program, which only the `kod` driver
    // gives a module it compiles; file_errors compiles the entry alone.
    let r = process.run(["./build/apps/kod/kod", "check", "tests/type_bare_cross_module_sibling.kod"])
    assert r.status == 1
    let errs = r.stderr
    assert errs != ""
    assert errs.contains("tests/type_bare_cross_module_sibling_dep.kod:1:19: error: unknown type `OnlyB`; tests/type_bare_cross_module_sibling_base.kod declares `OnlyB`: import it to use it here")
}

// The compiler reports an enum named bare in a value expression when only
// another module declares it, with a hint.
test "an enum named bare in a value that only another module declares" {
    let errs = test_support.file_errors("tests/type_bare_cross_module_value.kod")
    assert errs != ""
    assert errs.contains("7:13: error: unknown type `Mood`; tests/type_bare_cross_module_dep.kod declares `Mood`: write `type_bare_cross_module_dep.Mood` or list it in the import (`{ Mood }`)")
}

// A generic constructor `Box[int64](...)` of a type that only another module
