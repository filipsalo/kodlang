// The compiler reports two imports that share a name but load different files.
import "./import_name_twice_pa"
import "./import_name_twice_dup/import_name_twice_pa"

func main() -> int64 {
    print(f"{import_name_twice_pa.scale(1)}")
    return 0
}

// expected status:
// 1
// expected stderr:
// 3:8: error: `import_name_twice_pa` is already imported on line 2
