// A fallible main that returns normally exits with the returned value.
type Oops = struct {
    message: str
    func to_str(self) -> str { return self.message }
}

func half(anon n: int64) -> int64 or Error {
    if n % 2 != 0 {
        throw Oops(message: f"{n} is odd")
    }
    return n / 2
}

func main() -> int64 or Error {
    let h = try half(6)
    print(f"half {h}")
    return h
}

// expected output:
// half 3
// expected status:
// 3
