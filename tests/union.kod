// `A | B`: values go in where a union is declared, and `match` / `is` take them out.
type Id = int64 | str
type Point = struct {
    x: int64
}
type Color = enum {
    Red
    Green
}
interface Named {
    func name(self) -> str
}
type Dog = struct {
    func name(self) -> str {
        return "dog"
    }
}

type Holder = struct {
    id: Id
    many: [int64 | str] = []
}

func show(anon id: Id) -> str {
    match id {
        n: int64 -> return f"#{n}"
        s: str -> return s
    }
}

func make(anon n: int64) -> str | int64 {
    if n == 0 {
        return "zero"
    }
    return n
}

func fallible(anon n: int64) -> int64 | str or Error {
    if n == 0 {
        return "zero"
    }
    return n
}

func wide(anon v: Point | Color | [int64] | Named | float64 | bool) -> str {
    return match v {
        p: Point -> f"point {p.x}"
        c: Color -> match c {
            .Red -> "red"
            .Green -> "green"
        }
        xs: [int64] -> f"array of {len(xs)}"
        n: Named -> n.name()
        _: float64 -> "float"
        b: bool -> f"bool {b}"
    }
}

func with_default(id: Id = "fallback") -> str {
    return show(id)
}

func main() -> int64 or Error {
    // Order doesn't matter: this is the type `show` takes.
    let flipped: str | int64 = 7
    print(show(flipped))
    print(show(make(0)))
    print(show(make(3)))
    print(show(try fallible(0)))
    print(with_default())
    print(with_default(id: 5))

    // Reassigning and storing convert too.
    mut id: Id = 1
    id = "two"
    print(show(id))
    let h = Holder(id: 9, many: [1, "b"])
    print(show(h.id))
    h.id = "field"
    print(show(h.id))
    for v in h.many {
        print(show(v))
    }
    mut grown: [Id] = []
    grown += [4]
    grown += ["five"]
    print(f"{len(grown)}")
    print(show(grown[1]))

    let m = Map[str, Id]()
    m.set("a", 1)
    m.set("b", "bee")
    print(show(m.get("b")? or 0))

    // Every kind of member.
    print(wide(Point(x: 2)))
    print(wide(.Green))
    print(wide([1, 2, 3]))
    print(wide([]))
    print(wide(Dog()))
    print(wide(1.5))
    print(wide(true))

    // `is`, with and without a binding, negated, and chained.
    if id is s: str {
        print(s)
    }
    if id is _: int64 {
        print("not reached")
    }
    if id is not _: int64 {
        print("not an int")
    }
    let holds_str = id is _: str
    print(f"{holds_str}")
    if id is s: str and len(s) == 3 {
        print("three")
    }

    // Guards, alternatives and match expressions.
    let picked: Id = 12
    match picked {
        n: int64 if n > 100 -> print("big")
        n: int64 -> print_int(n)
        _: str -> print("text")
    }
    match picked {
        _: int64 | _: str -> print("either")
    }
    let answer: Id = match picked {
        _: int64 -> "was an int"
        s: str -> s.char_count()
    }
    print(show(answer))

    // A union is passed through generics and closures like any value.
    let frozen = id
    let f = func() -> str {
        return show(frozen)
    }
    print(f())
    print(show(same(id)))

    // `T | none` is `T?`, and a union with `none` is optional.
    let o: int64 | none = none
    let plain: int64? = o
    print_int(plain? or 8)
    let maybe: int64 | str | none = "here"
    match maybe {
        Some(n: int64) -> print_int(n)
        Some(s: str) -> print(s)
        none -> print("nothing")
    }
    let nothing: Id? = none
    print(f"{nothing is none}")
    let one: Id | none = 5
    print(show(one? or "other"))

    // Nested unions flatten into one.
    let nested: Id | bool = true
    let flat: bool | str | int64 = nested
    if flat is b: bool {
        print(f"{b}")
    }
    return 0
}

func same[T](anon x: T) -> T {
    return x
}

// expected output:
// #7
// zero
// #3
// zero
// fallback
// #5
// two
// #9
// field
// #1
// b
// 2
// five
// bee
// point 2
// green
// array of 3
// array of 0
// dog
// float
// bool true
// two
// not an int
// true
// three
// 12
// either
// was an int
// two
// two
// 8
// here
// true
// #5
// true
