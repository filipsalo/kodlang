// Writes 203 MiB (213 MB) to stdout in 1 MiB blocks. `kod run` used to
// hold all of it in memory before printing it; tests/stdio_test.py checks
// that it streams.
import "io"

func main() -> int64 {
    // 16 bytes doubled 16 times is 1 MiB.
    mut block: str = "0123456789abcde\n"
    mut i: int64 = 0
    for i < 16 {
        block = block + block
        i = i + 1
    }
    mut n: int64 = 0
    for n < 203 {
        io.write_stdout(block)
        n = n + 1
    }
    return 0
}

// expected mode:
// skip
