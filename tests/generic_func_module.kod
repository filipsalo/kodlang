// A generic function from another module: its body and defaults resolve names where they were written.

import "./generic_func_dep"
import "./generic_func_dep" { wrap }
import "./generic_func_dep2"

func secret() -> str {
    return "the caller's"
}

func main() -> int64 {
    print(generic_func_dep.tag("a"))
    print(generic_func_dep.tag(1))
    print(generic_func_dep.tag[str]("b"))
    print(wrap(2).v)
    print(generic_func_dep.with_default(xs: ["x"]))
    print(len(generic_func_dep.empty[int64]()))
    print(secret())
    print(generic_func_dep.literal_inside("l"))
    print(generic_func_dep2.tags())
    return 0
}

// expected output:
// the module's:a
// the module's:1
// the module's:b
// 2
// 2
// 0
// the caller's
// 2
// the module's:twothe module's:2
