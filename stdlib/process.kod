// Subprocesses: `start` a child with pipes, run one to the end with
// `output`, or turn this process into another with `exec`. See
// docs/builtins.md.

import "libc"
import "posix" { Fd, poll, signal }
import "stream" { IoError, IoKind, os_error }
import "strbuilder" { StrBuilder }
import "unsafe"

type ProcessResult = struct {
    status: int64
    stdout: str
    stderr: str
}

// fcntl is variadic, which an extern can't call, so it goes through C.
extern func _NSGetEnviron() -> int64

// macOS values of the C constants used here.
let EINTR: int64 = 4
let F_SETFD: int64 = 2
let F_GETFL: int64 = 3
let F_SETFL: int64 = 4
let F_SETNOSIGPIPE: int64 = 73
let FD_CLOEXEC: int64 = 1
let O_RDONLY: int64 = 0
let O_WRONLY: int64 = 1
let O_NONBLOCK: int64 = 4
let WNOHANG: int64 = 1
let SIGTERM: int64 = 15

// What a child's stdin, stdout or stderr is connected to.
type Stdio = enum {
    // This process's stream.
    Inherit
    // A pipe to this process, a `posix.Fd` on the `Child`.
    Pipe
    // /dev/null.
    Null

    func code(self) -> int64 {
        match self {
            .Inherit -> return 0
            .Pipe -> return 1
            .Null -> return 2
        }
    }
}

// A signal for `Child.kill`.
type Signal = enum {
    Hup
    Int
    Quit
    Kill
    Term
    Usr1
    Usr2

    func number(self) -> int64 {
        match self {
            .Hup -> return 1
            .Int -> return 2
            .Quit -> return 3
            .Kill -> return 9
            .Term -> return 15
            .Usr1 -> return 30
            .Usr2 -> return 31
        }
    }
}

// What `output` collected from a program that ran to the end.
type Output = struct {
    status: int64
    stdout: str
    stderr: str
}

// A child that ended other than by exiting, or another failure of a child.
type ProcessError = struct {
    message: str

    func to_str(self) -> str {
        return self.message
    }
}

// A program that `start` started. A stream that isn't piped has the `Fd` -1.
type Child = struct {
    pid: int64
    // `argv[0]`, for errors.
    name: str
    stdin: Fd
    stdout: Fd
    stderr: Fd

    // Close a piped stdin, wait for the child to end, and return its exit
    // code. A child ended by a signal is a ProcessError.
    func wait(self) -> int64 or Error {
        if self.stdin.fd >= 0 {
            try self.stdin.close()
        }
        return try self.exit_code(try wait_status(self.pid, name: self.name, hang: true))
    }

    // The exit code if the child has ended, none while it runs.
    func try_wait(self) -> int64? or Error {
        let status = try wait_status(self.pid, name: self.name, hang: false)
        if status < 0 {
            return none
        }
        return try self.exit_code(status)
    }

    func exit_code(self, anon status: int64) -> int64 or Error {
        let sig = status & 127
        if sig == 0 {
            return (status >> 8) & 255
        }
        throw ProcessError(message: f"{self.name} was killed by {signal_name(sig)}")
    }

    // Send the child a signal, SIGTERM unless told otherwise, without
    // waiting for it.
    func kill(self, signal: Signal = .Term) -> none or Error {
        if send_signal(self.pid, signal.number()) is Err(IoError(e)) {
            throw os_error(f"kill {self.name}", errno: e.errno)
        }
    }
}

func signal_name(anon sig: int64) -> str {
    match sig {
        1 -> return "SIGHUP"
        2 -> return "SIGINT"
        3 -> return "SIGQUIT"
        4 -> return "SIGILL"
        5 -> return "SIGTRAP"
        6 -> return "SIGABRT"
        8 -> return "SIGFPE"
        9 -> return "SIGKILL"
        10 -> return "SIGBUS"
        11 -> return "SIGSEGV"
        13 -> return "SIGPIPE"
        14 -> return "SIGALRM"
        15 -> return "SIGTERM"
        30 -> return "SIGUSR1"
        31 -> return "SIGUSR2"
        else return f"signal {sig}"
    }
}

// A child's raw wait status, or -1 if `hang` is false and it is still running.
func wait_status(anon pid: int64, name: str, hang: bool) -> int64 or Error {
    mut options = WNOHANG
    if hang {
        options = 0
    }
    let slot = unsafe.alloc(4)
    for true {
        let got = unsafe.c_int(libc.waitpid(pid, slot, options))
        if got > 0 {
            let status = unsafe.load32(slot)
            unsafe.free(slot)
            return status
        }
        if got == 0 {
            unsafe.free(slot)
            return -1
        }
        let err = unsafe.errno()
        if err != EINTR {
            unsafe.free(slot)
            throw os_error(f"wait {name}", errno: err)
        }
    }
    return -1
}

// posix.signal, by a name the `signal:` parameter of Child.kill doesn't hide.
func send_signal(anon pid: int64, anon sig: int64) -> none or Error {
    try signal(pid, sig)
}

// A C `char **` of `strs`, ending in a 0, for as long as `strs` lives. Free it.
func c_array(anon strs: [str]) -> int64 {
    let out = unsafe.alloc(8 * (len(strs) + 1))
    for i, s in strs {
        unsafe.store64(out + 8 * i, unsafe.c_str(s))
    }
    return out
}

// Start `argv[0]` (found via PATH) without waiting for it. See docs/builtins.md.
func start(anon argv: [str], stdin: Stdio = .Inherit, stdout: Stdio = .Inherit, stderr: Stdio = .Inherit, dir: str = "", env: [str]? = none) -> Child or Error {
    if len(argv) == 0 {
        throw ProcessError(message: "start: no program to run")
    }
    let modes = [stdin, stdout, stderr]
    // Three pipes of two C ints, -1 until made, then the child's pid.
    let block = unsafe.alloc(32)
    for i in 0..6 {
        unsafe.store32(block + 4 * i, -1)
    }
    let actions = unsafe.alloc(8)
    let init_err = unsafe.c_int(libc.posix_spawn_file_actions_init(actions))
    mut r: int64 or Error = 0
    if init_err != 0 {
        r = .Err(error: os_error(f"start {argv[0]}", errno: init_err))
    } else {
        r = spawn_with(actions, block: block, argv: argv, modes: modes, dir: dir, env: env)
        libc.posix_spawn_file_actions_destroy(actions)
    }
    unsafe.free(actions)
    // The child has its ends now; this process keeps the others if it started.
    mut kept = [-1, -1, -1]
    for fd in 0..3 {
        let read_end = unsafe.load32(block + 8 * fd)
        let write_end = unsafe.load32(block + 8 * fd + 4)
        if read_end >= 0 {
            mut theirs = write_end
            mut mine = read_end
            if fd == 0 {
                theirs = read_end
                mine = write_end
            }
            libc.close(theirs)
            if r is Err(_) {
                libc.close(mine)
            } else {
                kept[fd] = mine
            }
        }
    }
    unsafe.free(block)
    let pid = try r
    return Child(:pid, name: argv[0], stdin: Fd(fd: kept[0]), stdout: Fd(fd: kept[1]), stderr: Fd(fd: kept[2]))
}

// Fill `actions` for `modes`, making the pipes in `block`, and spawn: the pid.
func spawn_with(anon actions: int64, block: int64, argv: [str], modes: [Stdio], dir: str, env: [str]?) -> int64 or Error {
    let what = f"start {argv[0]}"
    let null = "/dev/null"
    for fd, mode in modes {
        match mode {
            .Inherit -> none
            .Pipe -> {
                let pair = block + 8 * fd
                if unsafe.c_int(libc.pipe(pair)) != 0 {
                    throw os_error(what, errno: unsafe.errno())
                }
                let read_end = unsafe.load32(pair)
                let write_end = unsafe.load32(pair + 4)
                libc.kod_fcntl(read_end, F_SETFD, FD_CLOEXEC)
                libc.kod_fcntl(write_end, F_SETFD, FD_CLOEXEC)
                // A write to a child that has gone fails with EPIPE instead
                // of raising SIGPIPE.
                mut theirs = write_end
                mut mine = read_end
                if fd == 0 {
                    theirs = read_end
                    mine = write_end
                }
                libc.kod_fcntl(mine, F_SETNOSIGPIPE, 1)
                try spawn_check(libc.posix_spawn_file_actions_adddup2(actions, theirs, fd), what: what)
            }
            .Null -> {
                mut flags = O_WRONLY
                if fd == 0 {
                    flags = O_RDONLY
                }
                try spawn_check(libc.posix_spawn_file_actions_addopen(actions, fd, unsafe.c_str(null), flags, 0), what: what)
            }
        }
    }
    if len(dir) > 0 {
        try spawn_check(libc.posix_spawn_file_actions_addchdir(actions, unsafe.c_str(dir)), what: what)
    }
    let c_argv = c_array(argv)
    let none_set: [str] = []
    let env_list = env? or none_set
    mut envp = unsafe.load64(_NSGetEnviron())
    mut c_env = 0
    if env is not none {
        c_env = c_array(env_list)
        envp = c_env
    }
    let pid_slot = block + 24
    let err = unsafe.c_int(libc.posix_spawnp(pid_slot, unsafe.c_str(argv[0]), actions, 0, c_argv, envp))
    unsafe.free(c_argv)
    unsafe.free(c_env)
    if err != 0 {
        throw os_error(what, errno: err)
    }
    return unsafe.load32(pid_slot)
}

// A posix_spawn call's result: 0, or the errno it failed with.
func spawn_check(anon result: int64, what: str) -> none or Error {
    let err = unsafe.c_int(result)
    if err != 0 {
        throw os_error(what, errno: err)
    }
}

// Run `argv[0]` (found via PATH) to the end, with `input` on its stdin, and
// collect what it writes to stdout and stderr. See docs/builtins.md.
func output(anon argv: [str], input: str = "", dir: str = "", env: [str]? = none) -> Output or Error {
    let child = try start(argv, stdin: .Pipe, stdout: .Pipe, stderr: .Pipe, :dir, :env)
    let out = try gather(child, input: kod_str_to_bytes(input))
    out.status = try child.wait()
    return out
}

// What `child` writes to stdout and stderr while it is given `input`, until
// both end; status is left at -1. On a failure the child is killed and
// collected and its pipes closed.
func gather(anon child: Child, input: bytes) -> Output or Error {
    let r = collect(child, :input)
    if r is Err(e) {
        // Don't leave a child or its pipes behind.
        for f in [child.stdin, child.stdout, child.stderr] {
            if f.fd >= 0 {
                let _ = f.close()
            }
        }
        let _ = child.kill(signal: .Kill)
        let _ = child.wait()
        throw e
    }
    return r
}

// Write `input` and read stdout and stderr, whichever is ready, until both end.
func collect(anon child: Child, input: bytes) -> Output or Error {
    let out = StrBuilder()
    let err = StrBuilder()
    mut sent = 0
    if child.stdin.fd < 0 {
        // Not a pipe: nothing to write or close.
    } else if len(input) == 0 {
        try child.stdin.close()
    } else {
        let flags = libc.kod_fcntl(child.stdin.fd, F_GETFL, 0)
        if flags < 0 or libc.kod_fcntl(child.stdin.fd, F_SETFL, flags | O_NONBLOCK) < 0 {
            throw os_error(f"start {child.name}", errno: unsafe.errno())
        }
    }
    for child.stdout.fd >= 0 or child.stderr.fd >= 0 {
        let ready = try poll(read: [child.stdout, child.stderr], write: [child.stdin])
        if ready.read[0] {
            try take(child.stdout, into: out)
        }
        if ready.read[1] {
            try take(child.stderr, into: err)
        }
        if ready.write[0] {
            let w = child.stdin.write(input[sent..len(input)])
            if w is Err(IoError(e)) and e.kind is .BrokenPipe {
                // It stopped reading; what it wrote still counts.
                sent = len(input)
            } else if w is Err(IoError(e)) and e.kind is .TimedOut {
                // The pipe filled up after all; wait for room again.
            } else {
                sent += try w
            }
            if sent >= len(input) {
                try child.stdin.close()
            }
        }
    }
    if child.stdin.fd >= 0 {
        try child.stdin.close()
    }
    return Output(status: -1, stdout: out.to_str(), stderr: err.to_str())
}

// One read from `f` into `into`; closes `f` at the end of the stream.
func take(anon f: Fd, into: StrBuilder) -> none or Error {
    let piece = try f.read(65536)
    if len(piece) == 0 {
        try f.close()
    } else {
        into.append_bytes(piece)
    }
}

// Run `argv[0]` (found via PATH) to the end and capture its stdout and
// stderr. It can't fail: a program that can't be run, or that a signal
// ends, has the status -1.
func run(anon argv: [str]) -> ProcessResult {
    let failed = ProcessResult(status: -1, stdout: "", stderr: "")
    let started = start(argv, stdout: .Pipe, stderr: .Pipe)
    if started is Err(_) {
        return failed
    }
    let child = started
    let none_given: bytes = kod_str_to_bytes("")
    let got = gather(child, input: none_given)
    if got is Err(_) {
        return failed
    }
    let out = got
    mut status = -1
    if child.wait() is Ok(code) {
        status = code
    }
    return ProcessResult(:status, stdout: out.stdout, stderr: out.stderr)
}

// Start `argv[0]` (found via PATH) without waiting for it, its stdin, stdout
// and stderr on /dev/null. Returns its process id, or -1 when it could not be
// started. End it with `kill`; until then, or until this process exits, it
// is a child that has not been waited for.
func spawn(anon argv: [str]) -> int64 {
    let started = start(argv, stdin: .Null, stdout: .Null, stderr: .Null)
    if started is Err(_) {
        return -1
    }
    return started.pid
}

// Send SIGTERM to a child that `spawn` started and wait for it. Returns
// whether the signal was delivered: false for a pid that is not a child of
// this process, such as one already killed.
func kill(anon pid: int64) -> bool {
    if pid <= 0 or signal(pid, SIGTERM) is Err(_) {
        return false
    }
    let _ = wait_status(pid, name: "", hang: true)
    return true
}

// Replace the calling process with `argv[0]` (found via PATH), which has
// this process's terminal, stdin and process id; stdout is flushed first.
// Input already read from a piped stdin into the buffer is not handed on.
// Returns -1, and only then, when `argv[0]` could not be run.
func exec(anon argv: [str]) -> int64 {
    if len(argv) == 0 {
        return -1
    }
    let c_argv = c_array(argv)
    libc.fflush(0)
    libc.execvp(unsafe.c_str(argv[0]), c_argv)
    unsafe.free(c_argv)
    return -1
}
