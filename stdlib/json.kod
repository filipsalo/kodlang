// JSON parse and emit, strict RFC 8259. See docs/json.md.
//
// `parse` returns `Value or Error` and never panics: a malformed input throws
// a `JsonError` that says where. Numbers that don't fit an int64 (or that have
// a fraction or an exponent) are kept as their text in `Decimal`, since Kod has
// no floating-point type.
type Value = enum {
    Null
    Bool(value: bool)
    Number(value: int64)
    Str(value: str)
    Array(items: [Value])
    // Parallel arrays — `keys[i]` is the key for `values[i]`. Stored
    // this way (rather than as a separate `Entry` struct) so the type
    // doesn't need a mutual-recursive definition.
    Object(keys: [str], values: [Value])
    // A number as written, when it isn't an int64.
    Decimal(text: str)
}

// The elements of an array value.
type Items = [Value]

type JsonError = struct {
    message: str
    offset: int64
    line: int64
    column: int64

    func to_str(self) -> str {
        return f"json: {self.message} at line {self.line}, column {self.column}"
    }
}

// ── Accessors ─────────────────────────────────────────────────────────────────

// Object lookup. Returns Null if the key is missing or `v` isn't an
// Object — lets callers chain `get(get(v, "a"), "b")` without
// intermediate destructuring. Free function rather than a method
// because Kod doesn't yet support methods on enums.
func get(anon v: Value, key: str) -> Value {
    match v {
        .Object(keys, values) -> {
            mut i: int64 = 0
            for i < len(keys) {
                if keys[i] == key {
                    return values[i]
                }
                i = i + 1
            }
            return .Null
        }
        else return .Null
    }
}

func at(anon v: Value, anon index: int64) -> Value {
    match v {
        .Array(items) -> {
            if index < 0 or index >= len(items) {
                return .Null
            }
            return items[index]
        }
        else return .Null
    }
}

func as_str(anon v: Value) -> str? {
    match v {
        .Str(s) -> return s
        else return none
    }
}

func as_int(anon v: Value) -> int64? {
    match v {
        .Number(n) -> return n
        else return none
    }
}

func as_bool(anon v: Value) -> bool? {
    match v {
        .Bool(b) -> return b
        else return none
    }
}

func as_array(anon v: Value) -> Items? {
    match v {
        .Array(items) -> return items
        else return none
    }
}

// The text of a `Number` or a `Decimal`.
func as_number_text(anon v: Value) -> str? {
    match v {
        .Number(n) -> return n.to_str()
        .Decimal(text) -> return text
        else return none
    }
}

func is_null(anon v: Value) -> bool {
    match v {
        .Null -> return true
        else return false
    }
}

// A growing byte buffer. Appending to an array is amortised constant time.
type Out = struct {
    bytes: [int64] = []

    func put(self, anon b: int64) -> none {
        self.bytes += [b]
    }

    func text(self, anon s: str) -> none {
        let n = len(s)
        mut i: int64 = 0
        for i < n {
            self.bytes += [s[i]]
            i = i + 1
        }
    }

    func spaces(self, anon n: int64) -> none {
        mut i: int64 = 0
        for i < n {
            self.bytes += [32]
            i = i + 1
        }
    }

    func to_str(self) -> str {
        return kod_bytes_to_str(kod_bytes_from_array(self.bytes))
    }
}

// ── Builders ──────────────────────────────────────────────────────────────────

func str_value(anon s: str) -> Value {
    return .Str(value: s)
}

func int_value(anon n: int64) -> Value {
    return .Number(value: n)
}

func bool_value(anon b: bool) -> Value {
    return .Bool(value: b)
}

func array_of(anon items: Items) -> Value {
    return .Array(items: items[0..len(items)])
}

// Collects the entries of an object, in order, for `build`.
type ObjectBuilder = struct {
    keys: [str] = []
    values: [Value] = []

    func put(self, anon key: str, anon value: Value) -> none {
        self.keys += [key]
        self.values += [value]
    }

    func put_str(self, anon key: str, anon s: str) -> none {
        self.put(key, .Str(value: s))
    }

    func put_int(self, anon key: str, anon n: int64) -> none {
        self.put(key, .Number(value: n))
    }

    func put_bool(self, anon key: str, anon b: bool) -> none {
        self.put(key, .Bool(value: b))
    }

    func put_null(self, anon key: str) -> none {
        self.put(key, .Null)
    }

    // The arrays are copied, so adding more entries later leaves a value
    // built earlier as it was.
    func build(self) -> Value {
        return .Object(keys: self.keys[0..len(self.keys)], values: self.values[0..len(self.values)])
    }
}

// ── Parser ────────────────────────────────────────────────────────────────────
//
// Recursive-descent. `pos` advances through `src`; each parse_* leaves
// pos pointing at the character after the value it consumed.

func make_error(anon src: str, anon offset: int64, anon message: str) -> JsonError {
    mut line: int64 = 1
    mut line_start: int64 = 0
    mut i: int64 = 0
    let stop = offset
    for i < stop and i < len(src) {
        if src[i] == 10 {
            line = line + 1
            line_start = i + 1
        }
        i = i + 1
    }
    return JsonError(message: message, offset: offset, line: line, column: offset - line_start + 1)
}

func is_digit(anon c: int64) -> bool {
    return c >= 48 and c <= 57
}

func hex_value(anon c: int64) -> int64 {
    if is_digit(c) {
        return c - 48
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    return -1
}

// Append the UTF-8 encoding of code point `cp`.
func append_code_point(anon out: Out, anon cp: int64) -> none {
    if cp < 128 {
        out.put(cp)
    } else if cp < 2048 {
        out.put(192 + (cp >> 6))
        out.put(128 + (cp & 63))
    } else if cp < 65536 {
        out.put(224 + (cp >> 12))
        out.put(128 + ((cp >> 6) & 63))
        out.put(128 + (cp & 63))
    } else {
        out.put(240 + (cp >> 18))
        out.put(128 + ((cp >> 12) & 63))
        out.put(128 + ((cp >> 6) & 63))
        out.put(128 + (cp & 63))
    }
}

type JsonParser = struct {
    src: str
    pos: int64
    depth: int64
    max_depth: int64

    func fail(self, anon message: str) -> JsonError {
        return make_error(self.src, self.pos, message)
    }

    // The byte at `pos`, or -1 at the end.
    func peek(self) -> int64 {
        if self.pos >= len(self.src) {
            return -1
        }
        return self.src[self.pos]
    }

    func skip_ws(self) -> none {
        for self.pos < len(self.src) {
            let c: int64 = self.src[self.pos]
            if c == 32 or c == 9 or c == 10 or c == 13 {
                self.pos = self.pos + 1
            } else {
                return none
            }
        }
    }

    // Consume `lit` if it is next.
    func consume_literal(self, anon lit: str) -> bool {
        if self.pos + len(lit) > len(self.src) {
            return false
        }
        mut i: int64 = 0
        for i < len(lit) {
            if self.src[self.pos + i] != lit[i] {
                return false
            }
            i = i + 1
        }
        self.pos = self.pos + len(lit)
        return true
    }

    func enter(self) -> none or Error {
        self.depth = self.depth + 1
        if self.depth > self.max_depth {
            throw self.fail("nesting too deep")
        }
    }

    func parse_value(self) -> Value or Error {
        self.skip_ws()
        let c: int64 = self.peek()
        if c < 0 {
            throw self.fail("unexpected end of input")
        }
        if c == 34 {
            return .Str(value: try self.parse_string())
        }
        if c == 123 {
            return try self.parse_object()
        }
        if c == 91 {
            return try self.parse_array()
        }
        if c == 116 {
            if self.consume_literal("true") {
                return .Bool(value: true)
            }
            throw self.fail("invalid literal")
        }
        if c == 102 {
            if self.consume_literal("false") {
                return .Bool(value: false)
            }
            throw self.fail("invalid literal")
        }
        if c == 110 {
            if self.consume_literal("null") {
                return .Null
            }
            throw self.fail("invalid literal")
        }
        if c == 45 or is_digit(c) {
            return try self.parse_number()
        }
        throw self.fail("unexpected character")
    }

    // Four hex digits at `pos`.
    func parse_hex4(self) -> int64 or Error {
        if self.pos + 4 > len(self.src) {
            throw self.fail("bad \\u escape")
        }
        mut n: int64 = 0
        mut i: int64 = 0
        for i < 4 {
            let d = hex_value(self.src[self.pos + i])
            if d < 0 {
                self.pos = self.pos + i
                throw self.fail("bad \\u escape")
            }
            n = n * 16 + d
            i = i + 1
        }
        self.pos = self.pos + 4
        return n
    }

    // After `\u`: one code point, joining a surrogate pair into one.
    func parse_unicode_escape(self, anon out: Out) -> none or Error {
        let start = self.pos - 2
        let first = try self.parse_hex4()
        if first >= 55296 and first <= 56319 {
            if self.pos + 1 < len(self.src) and self.src[self.pos] == 92 and self.src[self.pos + 1] == 117 {
                self.pos = self.pos + 2
                let second = try self.parse_hex4()
                if second < 56320 or second > 57343 {
                    self.pos = start
                    throw self.fail("unpaired surrogate")
                }
                append_code_point(out, 65536 + ((first - 55296) << 10) + (second - 56320))
                return
            }
            self.pos = start
            throw self.fail("unpaired surrogate")
        }
        if first >= 56320 and first <= 57343 {
            self.pos = start
            throw self.fail("unpaired surrogate")
        }
        append_code_point(out, first)
    }

    func parse_string(self) -> str or Error {
        self.pos = self.pos + 1
        let out = Out()
        let n = len(self.src)
        for true {
            let start = self.pos
            for self.pos < n {
                let c = self.src[self.pos]
                if c == 34 or c == 92 or c < 32 {
                    break
                }
                self.pos = self.pos + 1
            }
            out.text(self.src[start..self.pos])
            if self.pos >= n {
                throw self.fail("unterminated string")
            }
            let c = self.src[self.pos]
            if c == 34 {
                self.pos = self.pos + 1
                return out.to_str()
            }
            if c < 32 {
                throw self.fail("control character in string")
            }
            self.pos = self.pos + 1
            if self.pos >= n {
                throw self.fail("unterminated string")
            }
            let e = self.src[self.pos]
            self.pos = self.pos + 1
            if e == 34 or e == 92 or e == 47 {
                out.put(e)
            } else if e == 98 {
                out.put(8)
            } else if e == 102 {
                out.put(12)
            } else if e == 110 {
                out.put(10)
            } else if e == 114 {
                out.put(13)
            } else if e == 116 {
                out.put(9)
            } else if e == 117 {
                let unicode = try self.parse_unicode_escape(out)
            } else {
                self.pos = self.pos - 2
                throw self.fail("invalid escape")
            }
        }
        throw self.fail("unterminated string")
    }

    func skip_digits(self) -> int64 {
        let start = self.pos
        for self.pos < len(self.src) and is_digit(self.src[self.pos]) {
            self.pos = self.pos + 1
        }
        return self.pos - start
    }

    func parse_number(self) -> Value or Error {
        let start = self.pos
        if self.peek() == 45 {
            self.pos = self.pos + 1
        }
        let first = self.peek()
        if first == 48 {
            self.pos = self.pos + 1
        } else if first >= 49 and first <= 57 {
            self.skip_digits()
        } else {
            throw self.fail("expected a digit")
        }
        mut integer = true
        if self.peek() == 46 {
            integer = false
            self.pos = self.pos + 1
            if self.skip_digits() == 0 {
                throw self.fail("expected a digit after the decimal point")
            }
        }
        if self.peek() == 101 or self.peek() == 69 {
            integer = false
            self.pos = self.pos + 1
            if self.peek() == 43 or self.peek() == 45 {
                self.pos = self.pos + 1
            }
            if self.skip_digits() == 0 {
                throw self.fail("expected a digit in the exponent")
            }
        }
        let text = self.src[start..self.pos]
        if integer {
            let n = text.parse_int()
            if n is not none {
                return .Number(value: n? or 0)
            }
        }
        return .Decimal(text: text)
    }

    func parse_array(self) -> Value or Error {
        let entered = try self.enter()
        self.pos = self.pos + 1
        mut items: [Value] = []
        self.skip_ws()
        if self.peek() == 93 {
            self.pos = self.pos + 1
            self.depth = self.depth - 1
            return .Array(:items)
        }
        for true {
            items += [try self.parse_value()]
            self.skip_ws()
            let c = self.peek()
            if c == 44 {
                self.pos = self.pos + 1
            } else if c == 93 {
                self.pos = self.pos + 1
                self.depth = self.depth - 1
                return .Array(:items)
            } else {
                throw self.fail("expected `,` or `]`")
            }
        }
        return .Array(:items)
    }

    func parse_object(self) -> Value or Error {
        let entered = try self.enter()
        self.pos = self.pos + 1
        mut keys: [str] = []
        mut values: [Value] = []
        self.skip_ws()
        if self.peek() == 125 {
            self.pos = self.pos + 1
            self.depth = self.depth - 1
            return .Object(:keys, :values)
        }
        for true {
            self.skip_ws()
            if self.peek() != 34 {
                throw self.fail("expected a string key")
            }
            let key = try self.parse_string()
            self.skip_ws()
            if self.peek() != 58 {
                throw self.fail("expected `:`")
            }
            self.pos = self.pos + 1
            let v = try self.parse_value()
            keys += [key]
            values += [v]
            self.skip_ws()
            let c = self.peek()
            if c == 44 {
                self.pos = self.pos + 1
            } else if c == 125 {
                self.pos = self.pos + 1
                self.depth = self.depth - 1
                return .Object(:keys, :values)
            } else {
                throw self.fail("expected `,` or `}`")
            }
        }
        return .Object(:keys, :values)
    }
}

func parse(anon src: str, max_depth: int64 = 512) -> Value or Error {
    mut start: int64 = 0
    if len(src) >= 3 and src[0] == 239 and src[1] == 187 and src[2] == 191 {
        start = 3
    }
    let p = JsonParser(src: src, pos: start, depth: 0, max_depth: max_depth)
    let v = try p.parse_value()
    p.skip_ws()
    if p.pos < len(src) {
        throw p.fail("unexpected text after the value")
    }
    return v
}

// ── Emitter ───────────────────────────────────────────────────────────────────

func hex_digit(anon n: int64) -> int64 {
    if n < 10 {
        return 48 + n
    }
    return 87 + n
}

func write_string(anon out: Out, anon s: str) -> none {
    out.put(34)
    let n = len(s)
    mut i: int64 = 0
    mut run: int64 = 0
    for i < n {
        let c = s[i]
        if c == 34 or c == 92 or c < 32 {
            out.text(s[run..i])
            run = i + 1
            if c == 34 {
                out.text("\\\"")
            } else if c == 92 {
                out.text("\\\\")
            } else if c == 10 {
                out.text("\\n")
            } else if c == 13 {
                out.text("\\r")
            } else if c == 9 {
                out.text("\\t")
            } else if c == 8 {
                out.text("\\b")
            } else if c == 12 {
                out.text("\\f")
            } else {
                out.text("\\u00")
                out.put(hex_digit(c >> 4))
                out.put(hex_digit(c & 15))
            }
        }
        i = i + 1
    }
    out.text(s[run..n])
    out.put(34)
}

// Is `text` a JSON number: -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
func is_number_text(anon text: str) -> bool {
    let n = len(text)
    mut i: int64 = 0
    if i < n and text[i] == 45 {
        i = i + 1
    }
    if i >= n {
        return false
    }
    if text[i] == 48 {
        i = i + 1
    } else if text[i] >= 49 and text[i] <= 57 {
        for i < n and is_digit(text[i]) {
            i = i + 1
        }
    } else {
        return false
    }
    if i < n and text[i] == 46 {
        i = i + 1
        let frac = i
        for i < n and is_digit(text[i]) {
            i = i + 1
        }
        if i == frac {
            return false
        }
    }
    if i < n and (text[i] == 101 or text[i] == 69) {
        i = i + 1
        if i < n and (text[i] == 43 or text[i] == 45) {
            i = i + 1
        }
        let digits = i
        for i < n and is_digit(text[i]) {
            i = i + 1
        }
        if i == digits {
            return false
        }
    }
    return i == n
}

// A line break and `level * indent` spaces; nothing when `indent` is negative.
func write_break(anon out: Out, indent: int64, level: int64) -> none {
    if indent < 0 {
        return
    }
    out.put(10)
    out.spaces(indent * level)
}

// `indent < 0` writes compact JSON.
func write_value(anon out: Out, anon v: Value, indent: int64, level: int64) -> none {
    match v {
        .Null -> out.text("null")
        .Bool(b) -> {
            if b {
                out.text("true")
            } else {
                out.text("false")
            }
        }
        .Number(n) -> out.text(n.to_str())
        .Decimal(text) -> {
            if is_number_text(text) {
                out.text(text)
            } else {
                out.text("null")
            }
        }
        .Str(s) -> write_string(out, s)
        .Array(items) -> {
            if len(items) == 0 {
                out.text("[]")
                return
            }
            out.put(91)
            mut i: int64 = 0
            for i < len(items) {
                if i > 0 {
                    out.put(44)
                }
                write_break(out, indent: indent, level: level + 1)
                write_value(out, items[i], indent: indent, level: level + 1)
                i = i + 1
            }
            write_break(out, indent: indent, level: level)
            out.put(93)
        }
        .Object(keys, values) -> {
            if len(keys) == 0 {
                out.text("{}")
                return
            }
            out.put(123)
            mut i: int64 = 0
            for i < len(keys) {
                if i > 0 {
                    out.put(44)
                }
                write_break(out, indent: indent, level: level + 1)
                write_string(out, keys[i])
                out.put(58)
                if indent >= 0 {
                    out.put(32)
                }
                write_value(out, values[i], indent: indent, level: level + 1)
                i = i + 1
            }
            write_break(out, indent: indent, level: level)
            out.put(125)
        }
    }
}

func escape_string(anon s: str) -> str {
    let out = Out()
    write_string(out, s)
    return out.to_str()
}

func emit(anon v: Value) -> str {
    let out = Out()
    write_value(out, v, indent: -1, level: 0)
    return out.to_str()
}

func emit_pretty(anon v: Value, indent: int64 = 2) -> str {
    let out = Out()
    write_value(out, v, indent: indent, level: 0)
    return out.to_str()
}
