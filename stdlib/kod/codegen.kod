import "kod/ast"
import "kod/parsing"
import "kod/lexing"
import "kod/regalloc"

// Concrete instantiation of the builtin Map used for string interning.
// Declared here so resolve_type registers the monomorphised entry early,
// before any field of Codegen references it.
type StrMap = Map[str, str]

// ── Type kind (must precede uses in FieldInfo/VarSlot) ───────────────────────

type TypeKind = enum {
    KVoid
    KInt64
    KBool
    KStr
    // Raw byte sequence — same runtime layout as `KStr` (length +
    // buffer) but typed distinctly so the type system can keep
    // "text" and "binary" apart ahead of the unicode upgrade to
    // `str`. Indexing returns an int64 byte, slicing is byte-
    // positional, concatenation is byte append.
    KBytes
    KArray
    // The inner type of an optional. KVoid means "unknown" (e.g. a bare
    // `none` literal — its inner is fixed up by the surrounding context).
    KOptional(inner: TypeKind)
    KEnum(idx: int64)
    // type_args carries the concrete type parameters when the struct is a
    // generic instantiation (e.g. `Map[str, str]`). Empty for non-generic
    // structs and for the template struct itself.
    KStruct(idx: int64, type_args: [TypeKind])
    KArrayStruct(elem_idx: int64)
    KArrayEnum(elem_idx: int64)
    KArrayStr
    KArrayBytes
    KArrayInterface(elem_idx: int64)
    KArrayOptional(inner: TypeKind)
    KInterface(idx: int64)
    // Function-typed value: an 8-byte pointer to a top-level
    // function. `param_kinds` and `return_kind` carry the signature
    // for call-site type checks.
    KFunc(param_kinds: [TypeKind], return_kind: TypeKind)
    // Array of function pointers — captures the element signature
    // so `arr[i](x)` can dispatch indirectly with correct arg
    // expectations.
    KArrayFunc(param_kinds: [TypeKind], return_kind: TypeKind)
    // An inference miss: reported once, so its consumers stay quiet.
    KUnknown
    KArrayBool
    // `[[T]]`: `inner` is the kind of the element arrays.
    KArrayArray(inner: TypeKind)
}

// ── Type layout structures ────────────────────────────────────────────────────

// Pre-resolved function signature. Filled in once at registration time
// against the owning module's parser, so call sites never need to look at
// raw type_expr arena ids again. `param_labels[i]` is the call-site
// label for parameter i, or empty string when the parameter is anon.
// `param_names[i]` is the parameter's binding name (used by the LSP to
// render a hover signature with a useful name even for anon params —
// `anon path: str` instead of just `anon: str`).
type SigInfo = struct {
    param_kinds: [TypeKind]
    param_labels: [str]
    param_names: [str]
    return_kind: TypeKind
    // Parallel to the other arrays. `param_default_exprs[i] == 0`
    // means parameter i has no default; otherwise it's an *Expr id
    // into `src_p.exprs`. Cross-module call sites swap `self.p` to
    // `src_p` to evaluate the default, then swap back — same dance
    // as `compile_struct_construct` uses for field defaults.
    param_default_exprs: [int64]
    src_p: parsing.Parser
    // The declaration in `src_p.func_decls`; 0 for an extern.
    decl_id: int64 = 0
}

// Whether control can run off the end of a block, and leave the loop around it by `break`.
type Flow = struct {
    completes: bool
    breaks: bool
}

// Name → entry-index map for the parallel `func_names` / `func_labels`
// / `func_sigs` arrays. Keys are function names, values are indices
// into those arrays. Using a primitive int64 value keeps the type
// resolvable during early registration (no forward reference to a
// local struct).
type FuncIdx = Map[str, int64]

type VariantInfo = struct {
    name: str
    discriminant: int64
    field_names: [str]
    field_offsets: [int64]
    field_kinds: [TypeKind]
    // Raw AST type-expression ids for each field, parallel to
    // `field_kinds`. Kept so resolve_variant_field_kinds can re-resolve
    // after all imports are registered — captures the self-recursive
    // case where a variant field refers to its own enum, which isn't
    // in the registry yet at register_enum time.
    field_type_exprs: [int64]
}

type EnumInfo = struct {
    name: str
    variants: [VariantInfo]
    data_width: int64
    // Module prefix used to mangle this enum's method/value labels.
    // Local enums use the current module's prefix; imported ones use
    // the source module's prefix (e.g. "builtins").
    module_prefix: str
    // Parser that owns the variant field type_exprs. Same role as
    // StructInfo.src_p: needed so resolve_variant_field_kinds can swap
    // in the right parser when re-resolving the type ids.
    src_p: parsing.Parser
    // Source path + name-identifier span — see StructInfo.def_path.
    def_path: str
    def_span: ast.Span
    // Template type parameter names (e.g. ["T"] for Option[T]). Empty
    // for non-generic enums and for monomorphised instantiations.
    type_param_names: [str]
    // -1 if this enum is the template (or non-generic); otherwise the
    // index of the template enum this entry was monomorphised from.
    template_idx: int64
    // Concrete type arguments used to monomorphise this enum.
    template_args: [TypeKind]
}

type FieldInfo = struct {
    name: str
    offset: int64
    kind: TypeKind
    // Raw AST type-expression id for this field. Preserved alongside
    // the resolved `kind` so generic instantiations can re-resolve the
    // expression in a substitution context (e.g. `K` → `str`).
    type_expr: int64
    // *Expr id of the field's default value (in the defining module's
    // parser, `src_p`), or 0 if the field has no default. Used by
    // compile_struct_construct to fill fields a construction omits.
    default_expr: int64
}

// One method on a struct (or interface — `decl_id` is -1 for interfaces,
// which don't carry the source FuncDecl id).
type MethodInfo = struct {
    name: str
    decl_id: int64
    sig: SigInfo
}

type StructInfo = struct {
    name: str
    fields: [FieldInfo]
    methods: [MethodInfo]
    // Side index: method name → position in `methods`. Built alongside
    // it so dispatch lookups don't have to scan ~100 entries for every
    // `obj.method()` call (Codegen has ~100). Iteration sites use
    // `methods` directly.
    method_idx: FuncIdx
    data_width: int64
    // See EnumInfo.module_prefix.
    module_prefix: str
    // Parser that owns this struct's method func_decls. Needed to
    // monomorphise the methods into the consuming module's object file
    // when a type alias instantiates a generic struct.
    src_p: parsing.Parser
    // Template type parameter names (e.g. ["K", "V"] for Map[K, V]).
    // Empty for non-generic structs and for monomorphised instantiations.
    type_param_names: [str]
    // -1 if this struct is the template (or non-generic); otherwise the
    // index of the template struct this entry was monomorphised from.
    template_idx: int64
    // The concrete type arguments used to monomorphise this struct.
    // Empty for templates and non-generic structs.
    template_args: [TypeKind]
    // Source path + name-identifier span for go-to-definition / hover.
    // Empty path for monomorphised instances (the template carries the
    // original location).
    def_path: str
    def_span: ast.Span
}

// Interface metadata. Interface values are an 8-byte pointer to an arena
// cell {data_ptr, vtable_ptr}.
type IfaceInfo = struct {
    name: str
    methods: [MethodInfo]
    module_prefix: str
    def_path: str
    def_span: ast.Span
    // Let resolve_method_sigs redo the sigs once every type is registered.
    src_p: parsing.Parser
    method_decl_ids: [int64]
}

// One method on a primitive type (int64.to_str, str.hash, etc.).
// Held in a single `prim_methods: [PrimMethodInfo]` keyed by (kind, name);
// the lookup is a short linear scan (N ≈ 20), so a map would lose to
// the strcmp / cache-locality of the array.
type PrimMethodInfo = struct {
    kind: TypeKind
    name: str
    label: str
    sig: SigInfo
}

// One function exported by an imported module. `module` is the local
// alias the call site uses (`json` in `json.parse(...)`). `label` is the
// mangled symbol the call lowers to. `def_path`/`def_span` point at the
// function's name in its source file — used by go-to-definition.
type ImportFn = struct {
    module: str
    name: str
    label: str
    sig: SigInfo
    def_path: str
    def_span: ast.Span
}

// Names as an imported module sees them, for its code compiled in another module.
type ModuleScope = struct {
    path: str
    prefix: str
    module: ast.Module
    p: parsing.Parser
    built: bool = false
    // Into Codegen.scope_fns, filled on lookup.
    funcs: FuncIdx = FuncIdx()
    own: FuncIdx = FuncIdx()
    // Decl id as text → `__lambda_k` number.
    lambdas: FuncIdx = FuncIdx()
    names: [str] = []
    alias_names: [str] = []
    alias_paths: [str] = []
    item_names: [str] = []
    item_aliases: [str] = []
}

// ── Per-variable stack slot ───────────────────────────────────────────────────

type VarSlot = struct {
    name: str
    offset: int64
    kind: TypeKind
    // Whether bare reassignment (`name = …`) is allowed. Defaults to true so
    // params, pattern/loop bindings, and synthesized slots stay mutable; only
    // an immutable `let` binding flips this to false (set in compile_let).
    mutable: bool = true
    // Whether the code being compiled is in the binding's scope.
    bound: bool = false
    // Bound at some point before, so a block that bound it may have ended.
    seen: bool = false
    // The block depth and source offset of the binding in scope.
    depth: int64 = 0
    bind_off: int64 = 0
}

// ── Expression result (what compile_expr returns) ─────────────────────────────

type Val = enum {
    VReg(name: str)
    VImm(value: int64)
    VStack(offset: int64)
    VStrLbl(page: str)
}

// ── Loop label stack entry ────────────────────────────────────────────────────

type LoopLbl = struct {
    start_lbl: str
    end_lbl: str
    incr_lbl: str
}

// A single compiler diagnostic. `path`/`line`/`col`/`message` is the
// structural part — tests assert on these directly. `source_line` and
// `caret` are pre-rendered at report time (tabs already expanded) so
// they can survive past changes to the parser's current source pointer
// and so print_errors stays a straight write-loop.
type Diagnostic = struct {
    path: str
    line: int64
    col: int64
    // Column AFTER the last char of the offending token. Same line as
    // `col` unless the token straddles a newline (which we don't try to
    // detect — most diagnostics target identifiers or single tokens).
    // `end_col == col + 1` means we couldn't widen past one character;
    // the LSP server still shows a squiggly, just narrower.
    end_col: int64
    message: str
    source_line: str
    caret: str

    func to_str(self) -> str {
        return f"{self.path}:{self.line}:{self.col}: {self.message}"
    }
}

// ── Instruction buffer ────────────────────────────────────────────────────────
//
// `out_buf` holds typed instruction records instead of pre-formatted text
// lines. The motivation is the register-allocation pass between emission
// and final asm-formatting: once operands are structured (rather than
// baked into strings) it can rewrite registers and drop dead moves.
// `emit`/`println`/`emit_globl` etc. push `regalloc.Insn.Raw(text)` lines
// that the asm formatter prints verbatim. Only labels travel as a
// structured variant (`Insn.Label`), to pay down the format-prefix
// string ("L:") at the typed boundary.

// ── Codegen struct ────────────────────────────────────────────────────────────

type Codegen = struct {
    // Only `p` and `path_prefix` are required at construction; every
    // other field starts empty/zero via its default, so `make_codegen`
    // is just `Codegen(:p, :path_prefix)`.
    p: parsing.Parser
    path_prefix: str

    enums: [EnumInfo] = []
    structs: [StructInfo] = []
    interfaces: [IfaceInfo] = []

    // Pending vtables to emit at end of compile_module. Each (s, i) pair
    // means "struct s conforms to interface i and has been observed in an
    // upcast"; we emit one vtable per unique pair.
    vtable_struct_idx: [int64] = []
    vtable_iface_idx: [int64] = []
    // Same idea for primitives: each (kind, iface) means "kind conforms
    // to iface and was observed in an upcast". One vtable per unique pair.
    prim_vtable_kinds: [TypeKind] = []
    prim_vtable_iface_idx: [int64] = []

    // Type-alias maps: `type X = Y` adds an entry pointing X's name to
    // Y's struct/enum index. find_struct_idx / find_enum_idx consult
    // these before searching the main lists.
    // Name → position in `structs` / `enums` / `interfaces`. Includes
    // alias names (each maps to its target's real index) and generic
    // monomorphisation canonical names. Built alongside the arrays
    // themselves; lookups go through these instead of scanning.
    struct_idx: FuncIdx = FuncIdx()
    enum_idx: FuncIdx = FuncIdx()
    iface_idx: FuncIdx = FuncIdx()

    import_local: [str] = []

    // Functions exported by imported modules. Used to resolve `mod.func()`
    // calls to their exact labels (externs get `_name`, regular functions
    // get `$prefix$name`). `sig` is pre-resolved at registration time.
    import_fns: [ImportFn] = []

    vars: [VarSlot] = []
    frame_slots: int64 = 0
    ret_lbl: str = ""
    return_kind: TypeKind = .KVoid

    // The register pool: free list, vreg→phys mapping, and
    // callee-saved high-water tracking. See `regalloc.RegPool`.
    pool: regalloc.RegPool = regalloc.RegPool()

    // Per-function (label, line) pairs for the backtrace line table.
    // `compile_stmt` emits a fresh label and records `(label, line)`
    // before delegating to the per-variant compiler; `compile_func`
    // drains the list at the end into __DATA,__kod_lines and stamps
    // the symtab entry with start/end pointers. The last-recorded
    // line is kept around so we can skip duplicate markers when a
    // statement maps to the same source line as its predecessor.
    func_lines_labels: [str] = []
    func_lines_values: [int64] = []
    last_marked_line: int64 = 0

    loop_stack: [LoopLbl] = []

    str_labels: [str] = []
    str_values: [str] = []
    // Map from string value to its already-emitted label, mirroring the
    // parallel str_values / str_labels arrays for O(1) intern lookups.
    interned: StrMap = StrMap()

    label_count: int64 = 0

    func_names: [str] = []
    func_labels: [str] = []
    // Parallel to func_names: pre-resolved param + return kinds. Empty
    // SigInfo (zero-length param_kinds, .KVoid return_kind) for externs
    // that haven't been registered with full signature info.
    func_sigs: [SigInfo] = []
    // Parallel to func_names: the source path and span of the function's
    // name identifier in its declaration. Used by go-to-definition.
    // Extern functions, primitives, and other registrations without a
    // user-visible source location get an empty path; the LSP filters
    // those out before responding.
    func_def_paths: [str] = []
    func_def_spans: [ast.Span] = []
    // Parallel to func_names: the function's leading `//` doc comment
    // text. Empty for declarations without docs (externs are usually
    // documented, free functions sometimes; methods on structs carry
    // their doc on the FuncDecl itself and are looked up there).
    func_docs: [str] = []
    // Name → index into the parallel func_* arrays. Replaces what would
    // otherwise be an O(n) linear scan per call-site lookup.
    func_idx: FuncIdx = FuncIdx()

    // Methods registered against primitive types via stdlib/primitives/
    // modules. Parallel arrays: kind, name, label, sig. Method dispatch
    // on a primitive receiver finds the entry whose kind + name match.
    // Methods on primitive types, one entry per (kind, name). See
    // PrimMethodInfo. Was four parallel arrays.
    prim_methods: [PrimMethodInfo] = []

    // Active type-parameter substitution. While compiling a specialised
    // method (e.g. Map[str, str].get) `subst_names` holds the template's
    // type-parameter names and `subst_args` the concrete types. `resolve_type`
    // consults these on `.Named` to substitute K→str, V→str, etc. Both
    // are empty outside specialised contexts.
    subst_names: [str] = []
    subst_args: [TypeKind] = []

    // User-facing errors accumulated during compile_module. Reported via
    // `report_error` at sites that used to `kod_panic`. Callers check
    // `had_errors()` after compile_module to decide whether to fail the
    // build; the errors themselves are written to stderr at that point.
    errors: [Diagnostic] = []

    // True while compiling the body of a `test "..." { ... }` block. The
    // codegen for `assert` switches on this: inside a test, a failed
    // assertion calls `_kod_test_fail` (flag the test, keep going);
    // outside a test, it calls `_kod_panic` (print + exit 1).
    in_test: bool = false

    // When true, codegen runs all its checks but skips actually emitting
    // assembly. Used by test_support.try_compile so test code can run
    // typechecking on a source string and inspect errors in-process
    // without polluting stdout with .s output.
    dry_run: bool = false

    // Accumulated output instructions. `println` appends here instead of
    // writing to stdout directly; `flush_out` (called at the end of
    // compile_module) formats and prints them in one pass. Buffering —
    // rather than streaming — is the foundation for the IR + regalloc
    // passes that sit between emission and final asm-formatting.
    out_buf: [regalloc.Insn] = []

    // Lhs of the `+=` being compiled: an array `+` on it appends in place.
    // Expr ids are per parser, and codegen swaps `self.p` for defaults.
    append_lhs_id: int64 = 0
    append_lhs_path: str = ""

    // Non-nominal aliases (`type Ids = [int64]`): name → index into alias_kinds.
    alias_idx: FuncIdx = FuncIdx()
    alias_kinds: [TypeKind] = []

    // Keys of the errors report_error has already emitted.
    reported: FuncIdx = FuncIdx()

    // The module being compiled; only its type expressions are checked.
    entry_path: str = ""
    // Already reported, so uses of these aliases aren't reported again.
    unresolved_aliases: [str] = []
    unresolved_alias_targets: [int64] = []

    // Reports so far, repeats included, and the count when the statement began.
    report_attempts: int64 = 0
    stmt_error_mark: int64 = 0
    // The generic instance whose method bodies are being compiled, or -1.
    body_instance: int64 = -1
    // A default checked at its declaration isn't compiled, so only its type is.
    checking_default: bool = false

    scopes: [ModuleScope] = []
    scope_idx: FuncIdx = FuncIdx()
    scope_fns: [ImportFn] = []
    // The builtins' functions back every scope's own names.
    builtins_path: str = ""
    entry_import_paths: [str] = []
    bad_hash_keys: [str] = []
    inst_depth: int64 = 0
    // Bad-key instances, reported at the outermost instantiation's site.
    pending_bad_keys: [int64] = []
    // 1 never, 0 may return, 2 deciding, -2 may while what it rests on does, -1 decide again.
    returns_memo: FuncIdx = FuncIdx()
    deciding_depth: int64 = 0
    // Typing another function's locals could instantiate generics early.
    naming_locals: bool = false
    returns_pending: [str] = []
    // Calls past the limit, reported unless the function type they go through was.
    limit_call_msgs: [str] = []
    limit_call_spans: [ast.Span] = []
    // Indices into `vars` bound in the scopes entered so far, innermost last.
    bound_log: [int64] = []
    // Type name → the file that first declared it.
    type_paths: StrMap = StrMap()
    limit_call_insts: [int64] = []
    limit_call_kinds: [str] = []
    // Function types and literals past the limit that this module reported.
    limit_kinds: [str] = []
    // Locals bound to one of this module's functions past the limit.
    limit_fn_locals: [str] = []
    // Imports of other modules that name no file, shown only if this module fails.
    dep_import_ps: [parsing.Parser] = []
    dep_import_msgs: [str] = []
    dep_import_spans: [ast.Span] = []
    checking_dep: bool = false
    // The function being decided, and whether its answer rests on one not yet decided.
    deciding_key: str = ""
    deciding_rests: bool = false
    // Per key, where its list of the keys resting on it starts in `dependent_keys`.
    dependent_heads: FuncIdx = FuncIdx()
    dependent_keys: [str] = []
    dependent_next: [int64] = []
    // Parameters of the function walked that no binding in its body reuses.
    fixed_names: [str] = []
    // Alias name → the type the first module's alias of that name stands for.
    alias_shapes: StrMap = StrMap()
    // Type names two modules declare, already reported.
    clashed_types: [str] = []
    // A call through a local of no known type in a body being decided counts as never returning.
    trust_locals: bool = false
    // In a walk only fixed parameters keep their kinds; others have the ones the walk gives them.
    untyped_walk: bool = false
    walk_slots: [int64] = []
    walk_kinds: [TypeKind] = []
    // Slots a walk bound for the first time, to unmark when it ends.
    seen_log: [int64] = []
    block_depth: int64 = 0
    // Set once a body's locals are collected, so a read goes by where its name is bound.
    reads_scoped: bool = false
    // never_returns' verdicts with locals trusted, decided once per compilation for hints.
    trusted_memo: FuncIdx = FuncIdx()
    // Per function decided with locals trusted, the last call that ended a path in it.
    trust_ends: FuncIdx = FuncIdx()
    trust_end_exprs: [int64] = []
    trust_end_ps: [parsing.Parser] = []
    trust_end_fns: [str] = []
    trust_end_whys: [str] = []
    trust_end_vias: [str] = []
    // Per function, the record its chain of ending calls leads to.
    trust_sites: FuncIdx = FuncIdx()
    // Why the call being decided was trusted not to return, if it was.
    trust_why: str = ""
    // The function never_returns last answered for.
    last_nr_key: str = ""
    walking_fn: str = ""
    // The value in a place that takes a call that never returns.
    diverge_ok_id: int64 = 0

    // Quiet for a cascade: an earlier error in the statement or a KUnknown variable.
    func report_cannot_infer(self, anon expr_id: int64, what: str, typed_slot: bool = false) -> none {
        if self.report_attempts > self.stmt_error_mark or self.unknown_var_root(expr_id) or self.checking_default {
            return
        }
        mut hint = "; add a type annotation"
        if typed_slot {
            hint = ""
        } else if what == "this expression" {
            hint = "; bind it to an annotated `let` first"
        }
        self.report_error(f"error: cannot infer the type of {what}{hint}", span: self.p.expr_spans[expr_id])
    }

    // The parser has reported this literal.
    func is_bad_lit(self, anon expr_id: int64) -> bool {
        for id in self.p.bad_lits {
            if id == expr_id {
                return true
            }
        }
        return false
    }

    // A KUnknown variable's cause was reported where it got that kind.
    func unknown_var_root(self, anon expr_id: int64) -> bool {
        if expr_id == 0 {
            return false
        }
        match self.p.exprs[expr_id] {
            .IntLit(_value) -> return self.is_bad_lit(expr_id)
            .Ident(name) -> {
                if self.var_declared(name) {
                    if self.find_var_kind(name) is .KUnknown {
                        return true
                    }
                }
            }
            .Binary(lhs, op, rhs) -> {
                if op is .Dot {
                    return self.unknown_var_root(lhs)
                }
                return self.unknown_var_root(lhs) or self.unknown_var_root(rhs)
            }
            .Chain(exprs, _ops) -> return self.any_unknown_var_root(exprs)
            .Call(callee, args) -> {
                if self.unknown_var_root(callee) {
                    return true
                }
                for arg in args {
                    if self.unknown_var_root(arg.value) {
                        return true
                    }
                }
            }
            .ArrayLit(elements) -> return self.any_unknown_var_root(elements)
            .MatchExpr(subject, _arms) -> return self.unknown_var_root(subject)
            .Slice(subject, lo, hi) -> return self.unknown_var_root(subject) or self.unknown_var_root(lo) or self.unknown_var_root(hi)
            .UnwrapOpt(value, default) -> return self.unknown_var_root(value) or self.unknown_var_root(default)
            .OptionalDot(value, _field) -> return self.unknown_var_root(value)
            .OptionalMethodCall(value, _method, args) -> {
                if self.unknown_var_root(value) {
                    return true
                }
                for arg in args {
                    if self.unknown_var_root(arg.value) {
                        return true
                    }
                }
            }
            .Try(inner) -> return self.unknown_var_root(inner)
            .Must(inner) -> return self.unknown_var_root(inner)
            else none
        }
        return false
    }

    func any_unknown_var_root(self, anon expr_ids: [int64]) -> bool {
        for e in expr_ids {
            if self.unknown_var_root(e) {
                return true
            }
        }
        return false
    }

    func report_if_unknown(self, anon expr_id: int64, typed_slot: bool = false) -> bool {
        if self.infer_kind(expr_id) is .KUnknown {
            self.report_cannot_infer(expr_id, what: "this expression", :typed_slot)
            return true
        }
        return false
    }

    // Conditions and `and`/`or` operands must be bool; there's no truthiness.
    func check_bool(self, anon expr_id: int64, need: str, optional_hint: str) -> none {
        let k = self.infer_kind(expr_id)
        if k is .KBool {
            return
        }
        if k is .KUnknown {
            self.report_cannot_infer(expr_id, what: "this expression")
            return
        }
        if self.kind_has_unknown(k) {
            return
        }
        // An error inside the expression usually explains its kind.
        if self.report_attempts > self.stmt_error_mark {
            return
        }
        mut msg = f"error: {need}, got `{self.kind_display(k)}`"
        if k is .KOptional(_inner) {
            msg = msg + optional_hint
        }
        self.report_error(msg, span: self.p.expr_spans[expr_id])
    }

    func op_symbol(self, anon op: ast.Op) -> str {
        match op {
            .Add -> return "+"
            .Sub -> return "-"
            .Mul -> return "*"
            .Div -> return "/"
            .Mod -> return "%"
            .Eq -> return "=="
            .Ne -> return "!="
            .Lt -> return "<"
            .Le -> return "<="
            .Gt -> return ">"
            .Ge -> return ">="
            .And -> return "and"
            .Or -> return "or"
            .BitAnd -> return "&"
            .BitOr -> return "|"
            .BitXor -> return "^"
            .Shl -> return "<<"
            .Shr -> return ">>"
            else return "?"
        }
    }

    func check_bool_operands(self, lhs_id: int64, op: ast.Op, rhs_id: int64, lhs_kind: TypeKind) -> none {
        let rhs_kind = self.infer_kind(rhs_id)
        if self.either_unknown(lhs_kind, rhs_kind) {
            return
        }
        mut lhs_bool = false
        if lhs_kind is .KBool {
            lhs_bool = true
        }
        mut rhs_bool = false
        if rhs_kind is .KBool {
            rhs_bool = true
        }
        if lhs_bool == false and rhs_bool == false {
            return
        }
        mut equality = false
        if op is .Eq {
            equality = true
        }
        if op is .Ne {
            equality = true
        }
        if equality {
            if lhs_bool and rhs_bool {
                return
            }
            // check_optional_operands reports an optional side.
            if lhs_kind is .KOptional(_inner) {
                return
            }
            if rhs_kind is .KOptional(_inner) {
                return
            }
            self.report_error(f"error: cannot compare `{self.kind_display(lhs_kind)}` with `{self.kind_display(rhs_kind)}`", span: self.p.expr_spans[lhs_id])
            return
        }
        mut bad = lhs_id
        if lhs_bool == false {
            bad = rhs_id
        }
        let sym = self.op_symbol(op)
        mut msg = f"error: `{sym}` doesn't take `bool` operands"
        if self.p.exprs[bad] is .Binary(_l, inner_op, _r) {
            if self.is_comparison_op(inner_op) {
                let cmp = self.op_symbol(inner_op)
                msg = f"{msg}; `{cmp}` binds tighter than `{sym}`, so write `(a {sym} b) {cmp} c`"
            }
        }
        self.report_error(msg, span: self.p.expr_spans[bad])
    }

    // The operator would act on the optional's cell, not its value.
    func check_optional_operands(self, lhs_id: int64, op: ast.Op, rhs_id: int64, lhs_kind: TypeKind) -> none {
        let rhs_kind = self.infer_kind(rhs_id)
        if self.either_unknown(lhs_kind, rhs_kind) {
            return
        }
        mut bad = -1
        if self.is_some_optional(rhs_kind) {
            bad = rhs_id
        }
        if self.is_some_optional(lhs_kind) {
            bad = lhs_id
        }
        if bad < 0 {
            return
        }
        mut equality = false
        if op is .Eq {
            equality = true
        }
        if op is .Ne {
            equality = true
        }
        if equality {
            if self.is_none_kind(lhs_kind) or self.is_none_kind(rhs_kind) {
                return
            }
        }
        let hint = self.unwrap_hint(bad)
        if equality {
            self.report_error(f"error: cannot compare `{self.kind_display(lhs_kind)}` with `{self.kind_display(rhs_kind)}`{hint}", span: self.p.expr_spans[bad])
            return
        }
        self.report_error(f"error: `{self.op_symbol(op)}` doesn't take an optional operand{hint}", span: self.p.expr_spans[bad])
    }

    func check_operand_kinds(self, lhs_id: int64, op: ast.Op, rhs_id: int64, lhs_kind: TypeKind, rhs_kind: TypeKind) -> none {
        if self.report_attempts > self.stmt_error_mark or self.either_unknown(lhs_kind, rhs_kind) {
            return
        }
        if op is .Eq or op is .Ne {
            self.check_equality_operands(:lhs_id, :op, :rhs_id, :lhs_kind, :rhs_kind)
            return
        }
        let sym = self.op_symbol(op)
        let lhs_name = self.operand_scalar(lhs_kind)
        let rhs_name = self.operand_scalar(rhs_kind)
        let lhs_shown = self.kind_display(lhs_kind)
        let rhs_shown = self.kind_display(rhs_kind)
        let ordering = self.is_comparison_op(op)
        if op is .Add or ordering {
            if op is .Add and self.is_array_kind(lhs_kind) {
                return
            }
            if lhs_name == "" {
                self.report_error(f"error: `{sym}` doesn't take `{lhs_shown}` operands", span: self.p.expr_spans[lhs_id])
                return
            }
            if lhs_name == rhs_name {
                return
            }
            if ordering {
                self.report_error(f"error: cannot compare `{lhs_shown}` with `{rhs_shown}`", span: self.p.expr_spans[rhs_id])
                return
            }
            mut bad = rhs_id
            mut hint = ""
            let convert = "; convert with `str(...)` or use an f-string"
            if lhs_name == "str" and self.prints_as_str(rhs_kind) {
                hint = convert
            }
            let appending = lhs_id == self.append_lhs_id and self.p.path == self.append_lhs_path
            if rhs_name == "str" and self.prints_as_str(lhs_kind) and appending == false {
                hint = convert
                bad = lhs_id
            }
            self.report_error(f"error: cannot add `{lhs_shown}` and `{rhs_shown}`{hint}", span: self.p.expr_spans[bad])
            return
        }
        mut bad = 0
        mut bad_shown = lhs_shown
        if lhs_name != "int64" {
            bad = lhs_id
        } else if rhs_name != "int64" {
            bad = rhs_id
            bad_shown = rhs_shown
        }
        if bad != 0 {
            mut hint = ""
            if bad == rhs_id and self.is_unary_minus(lhs_id) {
                hint = self.negate_base_hint(rhs_id, minus: self.p.expr_spans[lhs_id].start)
            }
            self.report_error(f"error: `{sym}` needs `int64` operands, got `{bad_shown}`{hint}", span: self.p.expr_spans[bad])
        }
    }

    // The parser writes a prefix `-x` as `0 - x`, its `0` spanning the `-`.
    func is_unary_minus(self, anon lhs_id: int64) -> bool {
        let .IntLit(value) = self.p.exprs[lhs_id] else { return false }
        let pos = self.p.expr_spans[lhs_id].start
        return value == 0 and pos < len(self.p.source) and self.p.source[pos] == '-'
    }

    // `-n.to_str()` negates the str; point at `(-n).to_str()`.
    func negate_base_hint(self, anon operand: int64, minus: int64) -> str {
        mut e = operand
        for true {
            mut recv = 0
            mut piece = 0
            match self.p.exprs[e] {
                .Call(callee, _args) -> {
                    let .Binary(lhs, op, rhs) = self.p.exprs[callee] else { return "" }
                    let .Dot = op else { return "" }
                    recv = lhs
                    piece = rhs
                }
                .Binary(lhs, op, rhs) -> {
                    match op {
                        .Dot -> piece = rhs
                        .Index -> piece = rhs
                        else return ""
                    }
                    recv = lhs
                }
                else return ""
            }
            if self.infer_kind(recv) is .KInt64 {
                return self.negate_prefix_hint(:minus, :piece)
            }
            e = recv
        }
        return ""
    }

    // Splits the operand's tokens before the `.` or `[` that `piece` follows.
    func negate_prefix_hint(self, minus: int64, piece: int64) -> str {
        let toks = self.p.tokens
        let first = self.token_at(minus) + 1
        mut cut = self.token_at(self.p.expr_spans[piece].start) - 1
        for cut > 0 and toks[cut].kind is .OpenParen {
            cut -= 1
        }
        if first <= 0 or cut <= first or (toks[cut].kind is .Dot or toks[cut].kind is .OpenBracket) == false {
            return ""
        }
        mut t = cut
        for t < len(toks) {
            match toks[t].kind {
                .Dot -> t += 2
                .OpenParen -> t = self.closing_token(t) + 1
                .OpenBracket -> t = self.closing_token(t) + 1
                else break
            }
        }
        if t > len(toks) or t <= cut {
            return ""
        }
        let src = self.p.source
        let base = src[toks[first].start..toks[cut - 1].end]
        let rest = src[toks[cut].start..toks[t - 1].end]
        return f"; write `(-{base}){rest}` to negate `{base}` first"
    }

    // -1 for a position no token starts at, such as inside an f-string.
    func token_at(self, anon pos: int64) -> int64 {
        let toks = self.p.tokens
        mut lo = 0
        mut hi = len(toks)
        for lo < hi {
            let mid = (lo + hi) / 2
            if toks[mid].start < pos {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        if lo < len(toks) and toks[lo].start == pos {
            return lo
        }
        return -1
    }

    func closing_token(self, anon open: int64) -> int64 {
        let toks = self.p.tokens
        mut depth = 0
        mut t = open
        for t < len(toks) {
            match toks[t].kind {
                .OpenParen -> depth += 1
                .OpenBracket -> depth += 1
                .OpenCurly -> depth += 1
                .CloseParen -> depth -= 1
                .CloseBracket -> depth -= 1
                .CloseCurly -> depth -= 1
                else none
            }
            if depth == 0 {
                return t
            }
            t += 1
        }
        return len(toks)
    }

    // `==` compares a word, or str/bytes content, so only those kinds have one.
    func check_equality_operands(self, lhs_id: int64, op: ast.Op, rhs_id: int64, lhs_kind: TypeKind, rhs_kind: TypeKind) -> none {
        // `none` and optional operands are reported elsewhere.
        if lhs_kind is .KOptional(_l) or rhs_kind is .KOptional(_r) {
            return
        }
        let sym = self.op_symbol(op)
        let lhs_shown = self.kind_display(lhs_kind)
        let rhs_shown = self.kind_display(rhs_kind)
        let lhs_note = self.no_equality_note(lhs_kind)
        if len(lhs_note) > 0 {
            self.report_error(f"error: `{sym}` doesn't compare {lhs_note}", span: self.p.expr_spans[lhs_id])
            return
        }
        if lhs_kind is .KEnum(idx) {
            if rhs_kind is .KEnum(rhs_idx) {
                if self.enums_compatible(idx, a_idx: rhs_idx) {
                    self.check_enum_equality(:lhs_id, :rhs_id, enum_idx: idx)
                    return
                }
            }
        } else {
            let lhs_name = self.equality_scalar(lhs_kind)
            if len(lhs_name) > 0 and lhs_name == self.equality_scalar(rhs_kind) {
                return
            }
        }
        mut bad = rhs_id
        if lhs_kind is .KVoid {
            bad = lhs_id
        }
        self.report_error(f"error: cannot compare `{lhs_shown}` with `{rhs_shown}`", span: self.p.expr_spans[bad])
    }

    func equality_scalar(self, anon kind: TypeKind) -> str {
        if kind is .KBool {
            return "bool"
        }
        return self.operand_scalar(kind)
    }

    func no_equality_note(self, anon kind: TypeKind) -> str {
        if self.is_array_kind(kind) {
            return "arrays; compare `len(...)` and the elements"
        }
        match kind {
            .KStruct(_idx, _type_args) -> return "structs; compare their fields"
            .KInterface(_idx) -> return "interface values"
            .KFunc(_params, _ret) -> return "function values"
            else return ""
        }
    }

    // Only the variant is compared, so a payload could only be ignored.
    func check_enum_equality(self, lhs_id: int64, rhs_id: int64, enum_idx: int64) -> none {
        let info = self.enums[enum_idx]
        if self.enum_has_payload(enum_idx) == false {
            return
        }
        mut unit_side = false
        for side in [lhs_id, rhs_id] {
            let vi = self.ctor_variant_idx(side, :enum_idx)
            if vi >= 0 {
                let variant = info.variants[vi]
                if len(variant.field_names) > 0 {
                    mut fields = ""
                    for name in variant.field_names {
                        if len(fields) > 0 {
                            fields = fields + ", "
                        }
                        fields = fields + name
                    }
                    let pattern = f".{variant.name}({fields})"
                    self.report_error(f"error: cannot compare with `.{variant.name}(...)`, which has a payload; test it with `is {pattern}`", span: self.p.expr_spans[side])
                    return
                }
                unit_side = true
            }
        }
        if unit_side == false {
            let shown = self.enum_display_name(enum_idx)
            self.report_error(f"error: cannot compare two `{shown}` values; some of its variants have payloads, so test the variant with `is` or `match`", span: self.p.expr_spans[lhs_id])
        }
    }

    func enum_has_payload(self, anon enum_idx: int64) -> bool {
        for v in self.enums[enum_idx].variants {
            if len(v.field_names) > 0 {
                return true
            }
        }
        return false
    }

    // `hash` must agree with `==`, which compares only these by value.
    func is_hashable(self, anon kind: TypeKind) -> bool {
        match kind {
            .KInt64 -> return true
            .KBool -> return true
            .KStr -> return true
            .KBytes -> return true
            .KEnum(idx) -> return self.enum_has_payload(idx) == false
            else return false
        }
    }

    func unhashable_note(self, anon kind: TypeKind) -> str {
        if kind is .KEnum(_idx) {
            return "; some of its variants have payloads"
        }
        return ""
    }

    // "key" for builtins' `Map`, "element" for the `set` module's `Set`, else "".
    func hashed_arg_noun(self, anon template_idx: int64) -> str {
        let t = self.structs[template_idx]
        if t.name == "Map" and t.def_path == self.builtins_path {
            return "key"
        }
        if t.name == "Set" and t.def_path == set_module_path() {
            return "element"
        }
        return ""
    }

    // Once per key type; the bodies aren't compiled, as they'd only repeat it.
    func note_bad_key(self, anon inst_idx: int64) -> none {
        if self.has_bad_key(self.structs[inst_idx]) == false {
            return
        }
        let name = self.canonical_kind_name(self.structs[inst_idx].template_args[0])
        if regalloc.str_in(self.bad_hash_keys, p: name) {
            return
        }
        self.bad_hash_keys += [name]
        self.pending_bad_keys += [inst_idx]
    }

    // `outer` is the outermost instance, or -1 for an enum.
    func report_bad_keys(self, anon outer: int64, shown: str, args: [TypeKind], arg_spans: [ast.Span], whole: ast.Span) -> none {
        for inst_idx in self.pending_bad_keys {
            let key = self.structs[inst_idx].template_args[0]
            let template_idx = self.structs[inst_idx].template_idx
            let noun = self.hashed_arg_noun(template_idx)
            mut where = ""
            mut suffix = ""
            if inst_idx != outer {
                where = f" in `{shown}`"
            }
            if self.body_instance >= 0 {
                let body = self.struct_display_name(self.body_instance)
                if inst_idx == outer and self.key_names_param(args, :arg_spans, :key) {
                    where = f" in `{body}`"
                } else if outer != self.body_instance {
                    suffix = f" (in `{body}`)"
                }
            }
            mut site = whole
            mut i = 0
            for arg in args {
                if self.kind_holds(arg, :key) {
                    site = arg_spans[i]
                    break
                }
                i += 1
            }
            self.report_message(f"error: `{self.kind_display(key)}` can't be a `{self.structs[template_idx].name}` {noun}{where}{self.unhashable_note(key)}; {noun}s are `int64`, `str`, `bytes`, `bool` or enums without payloads{suffix}", span: site)
        }
        let none_pending: [int64] = []
        self.pending_bad_keys = none_pending
    }

    // Whether the argument that is the key is written as one of the body's type parameters.
    func key_names_param(self, anon args: [TypeKind], arg_spans: [ast.Span], key: TypeKind) -> bool {
        let names = self.structs[self.structs[self.body_instance].template_idx].type_param_names
        let src = self.p.source
        mut i = 0
        for arg in args {
            if self.kind_holds(arg, :key) and i < len(arg_spans) {
                let start = arg_spans[i].start
                mut end = start
                for end < len(src) and ident_char(src[end]) {
                    end += 1
                }
                return end > start and regalloc.str_in(names, p: src[start..end])
            }
            i += 1
        }
        return false
    }

    func kind_holds(self, anon kind: TypeKind, key: TypeKind) -> bool {
        if self.canonical_kind_name(kind) == self.canonical_kind_name(key) {
            return true
        }
        match kind {
            .KOptional(inner) -> return self.kind_holds(inner, :key)
            .KArrayOptional(inner) -> return self.kind_holds(inner, :key)
            .KArrayArray(inner) -> return self.kind_holds(inner, :key)
            .KArrayStruct(elem_idx) -> return self.kind_holds(.KStruct(idx: elem_idx, type_args: []), :key)
            .KArrayEnum(elem_idx) -> return self.kind_holds(.KEnum(idx: elem_idx), :key)
            .KStruct(idx, _type_args) -> {
                for ta in self.structs[idx].template_args {
                    if self.kind_holds(ta, :key) {
                        return true
                    }
                }
            }
            .KEnum(idx) -> {
                for ta in self.enums[idx].template_args {
                    if self.kind_holds(ta, :key) {
                        return true
                    }
                }
            }
            else none
        }
        return false
    }

    func has_bad_key(self, anon instance: StructInfo) -> bool {
        if len(instance.template_args) == 0 or len(self.hashed_arg_noun(instance.template_idx)) == 0 {
            return false
        }
        let key = instance.template_args[0]
        return self.kind_has_unknown(key) == false and self.is_hashable(key) == false
    }

    // The kinds `+` and the ordering operators take, by name; "" for the rest.
    func operand_scalar(self, anon kind: TypeKind) -> str {
        match kind {
            .KInt64 -> return "int64"
            .KStr -> return "str"
            .KBytes -> return "bytes"
            else return ""
        }
    }

    func prints_as_str(self, anon kind: TypeKind) -> bool {
        match kind {
            .KInt64 -> return true
            .KBool -> return true
            else return false
        }
    }

    // An index or slice bound, compiled already, so its own errors come first.
    func check_int_operand(self, anon expr_id: int64, what: str) -> none {
        let k = self.infer_kind(expr_id)
        if k is .KInt64 {
            return
        }
        if k is .KUnknown {
            self.report_cannot_infer(expr_id, what: "this expression")
            return
        }
        if self.kind_has_unknown(k) or self.report_attempts > self.stmt_error_mark {
            return
        }
        mut hint = ""
        if self.is_some_optional(k) {
            hint = self.unwrap_hint(expr_id)
        }
        self.report_error(f"error: {what} must be `int64`, got `{self.kind_display(k)}`{hint}", span: self.p.expr_spans[expr_id])
    }

    func is_some_optional(self, anon kind: TypeKind) -> bool {
        if kind is .KOptional(_inner) {
            return self.is_none_kind(kind) == false
        }
        return false
    }

    func is_comparison_op(self, anon op: ast.Op) -> bool {
        match op {
            .Eq -> return true
            .Ne -> return true
            .Lt -> return true
            .Le -> return true
            .Gt -> return true
            .Ge -> return true
            else return false
        }
    }

    func fn_address(self, anon slot: int64) -> Val {
        let lbl: str = self.fn_label(slot)
        let reg: str = self.pool.alloc_reg()
        self.emit(f"adrp {reg}, {lbl}@PAGE")
        self.emit(f"add {reg}, {reg}, {lbl}@PAGEOFF")
        return .VReg(name: reg)
    }

    func unbound_msg(self, anon name: str, verb: str) -> str {
        if self.var_seen(name) {
            return f"error: `{name}` is declared in a block that has ended; declare it outside the block to use it here"
        }
        return f"error: `{name}` is {verb} before its `let`"
    }

    // Compile an expression only for the errors it reports.
    func compile_discard(self, anon expr_id: int64) -> none {
        let val = self.compile_expr(expr_id)
        self.free_val(val)
    }

    func is_array_kind(self, anon kind: TypeKind) -> bool {
        match kind {
            .KArray -> return true
            .KArrayStruct(_elem_idx) -> return true
            .KArrayEnum(_elem_idx) -> return true
            .KArrayStr -> return true
            .KArrayBytes -> return true
            .KArrayInterface(_elem_idx) -> return true
            .KArrayOptional(_inner) -> return true
            .KArrayFunc(_pk, _rk) -> return true
            .KArrayBool -> return true
            .KArrayArray(_inner) -> return true
            else return false
        }
    }

    func is_str_or_bytes(self, anon kind: TypeKind) -> bool {
        match kind {
            .KStr -> return true
            .KBytes -> return true
            else return false
        }
    }

    // The tail of a "cannot index / slice / assign an element of" error.
    func index_error_note(self, anon kind: TypeKind, method: str, value_id: int64) -> str {
        match kind {
            .KStruct(_idx, _type_args) -> {
                if len(method) > 0 {
                    return f"; it has no `{method}` method"
                }
            }
            .KOptional(_inner) -> return self.unwrap_hint(value_id)
            else none
        }
        return ""
    }

    // "" for a non-name, so the hint shows just the `?`.
    func unwrap_name(self, anon expr_id: int64) -> str {
        if self.p.exprs[expr_id] is .Ident(name) {
            // A `$` name is a compiler temporary the user can't write.
            if name.contains("$") == false {
                return name
            }
        }
        return ""
    }

    func unwrap_hint(self, anon expr_id: int64) -> str {
        let name = self.unwrap_name(expr_id)
        return f"; unwrap it first with `{name}?` or `{name}? or default`"
    }

    // Unwrapping would panic on `none`, which the optional slot can hold.
    func rewrap_hint(self, anon expr_id: int64) -> str {
        let name = self.unwrap_name(expr_id)
        if len(name) == 0 {
            return "; rewrap it instead with a `match` whose arms are `Some(v) -> v` and `none -> none`"
        }
        return "; rewrap it instead, as in `match " + name + " { Some(v) -> v none -> none }`"
    }

    func either_unknown(self, anon a: TypeKind, anon b: TypeKind) -> bool {
        return self.kind_has_unknown(a) or self.kind_has_unknown(b)
    }

    func kind_has_unknown(self, anon kind: TypeKind) -> bool {
        match kind {
            .KUnknown -> return true
            .KOptional(inner) -> return self.kind_has_unknown(inner)
            .KArrayOptional(inner) -> return self.kind_has_unknown(inner)
            .KArrayArray(inner) -> return self.kind_has_unknown(inner)
            .KStruct(_idx, type_args) -> {
                for ta in type_args {
                    if self.kind_has_unknown(ta) {
                        return true
                    }
                }
            }
            .KFunc(param_kinds, return_kind) -> {
                for pk in param_kinds {
                    if self.kind_has_unknown(pk) {
                        return true
                    }
                }
                return self.kind_has_unknown(return_kind)
            }
            .KArrayFunc(param_kinds, return_kind) -> {
                for pk in param_kinds {
                    if self.kind_has_unknown(pk) {
                        return true
                    }
                }
                return self.kind_has_unknown(return_kind)
            }
            else none
        }
        return false
    }

    // Accumulate a user-facing error. Unlike `kod_panic`, this does not
    // abort — the rest of the module is still walked so a single run
    // surfaces every error rather than stopping at the first.
    //
    // Formats as `path:L:C: msg`, followed by the offending source line
    // and a caret pointing at the column. Walks the source once per call
    // to compute line, column, and the surrounding line text — cheap
    // enough for the handful of errors we'd ever report in a single
    // compile.
    func report_error(self, anon text: str, span: ast.Span) -> none {
        // A generic body is template code, so name the instance that has the error.
        if self.body_instance >= 0 {
            self.report_message(f"{text} (in `{self.struct_display_name(self.body_instance)}`)", :span)
            return
        }
        self.report_message(text, :span)
    }

    func report_message(self, anon msg: str, span: ast.Span) -> none {
        if self.is_repeat_report(msg, :span) {
            self.report_attempts = self.report_attempts + 1
            return
        }
        let source: str = self.p.source
        mut offset: int64 = span.start
        mut line: int64 = 1
        mut col: int64 = 1
        mut line_start: int64 = 0
        mut i: int64 = 0
        for i < offset and i < len(source) {
            if source[i] == '\n' {
                line = line + 1
                col = 1
                line_start = i + 1
            } else {
                col = col + 1
            }
            i = i + 1
        }
        mut line_end: int64 = line_start
        for line_end < len(source) and source[line_end] != '\n' {
            line_end = line_end + 1
        }
        // Normalise tabs to four spaces in both the source line and the
        // pre-caret indent so the caret aligns visually with the column
        // we report.
        let raw_line: str = source[line_start..line_end]
        mut line_text: str = ""
        mut li: int64 = 0
        for li < len(raw_line) {
            if raw_line[li] == '\t' {
                line_text = line_text + "    "
            } else {
                line_text = line_text + raw_line[li..li+1]
            }
            li = li + 1
        }
        // Widen the squiggly: if the start offset lands on an identifier
        // char (letter / digit / underscore), scan forward through more
        // identifier chars to get the token's end. Otherwise fall back
        // to a one-character range. Doesn't handle multi-line tokens —
        // those aren't a thing in Kod outside triple-quoted strings,
        // which we don't tend to report errors on anyway.
        mut end_col: int64 = col + 1
        if offset < len(source) and ident_char(source[offset]) {
            mut scan: int64 = offset
            for scan < len(source) and ident_char(source[scan]) {
                scan = scan + 1
            }
            end_col = col + (scan - offset)
        }
        // Pre-caret indent mirrors the tab expansion: any tab among the
        // bytes before the column counts as four spaces; everything else
        // counts as one. Then `^^^…^` spans the full token width so the
        // squiggly visually covers the offending range rather than
        // pointing at a single column.
        mut caret: str = ""
        mut s: int64 = 0
        for s < col - 1 {
            if line_start + s < len(source) and source[line_start + s] == '\t' {
                caret = caret + "    "
            } else {
                caret = caret + " "
            }
            s = s + 1
        }
        mut span_width: int64 = end_col - col
        if span_width < 1 {
            span_width = 1
        }
        mut k: int64 = 0
        for k < span_width {
            caret = caret + "^"
            k = k + 1
        }
        self.errors += [Diagnostic(path: self.p.path, :line, :col, :end_col, message: msg, source_line: line_text, :caret)]
        self.report_attempts = self.report_attempts + 1
    }

    // Default args compile per call site and generic bodies per instance.
    func is_repeat_report(self, anon msg: str, span: ast.Span) -> bool {
        let seen = self.reported
        let key = f"{self.p.path}:{span.start}:{msg}"
        if seen.contains(key) {
            return true
        }
        seen.set(key, 1)
        if self.body_instance >= 0 {
            let pos_key = f"{self.p.path}:{span.start}"
            if seen.get(pos_key) is Some(owner) {
                return owner != self.body_instance
            }
            seen.set(pos_key, self.body_instance)
        }
        return false
    }

    func had_errors(self) -> bool {
        return len(self.errors) > 0
    }

    // Write every accumulated error to stderr. Three lines per error:
    // `path:line:col: message`, the source line, and a caret pointing
    // at the column.
    func print_errors(self) -> none {
        for e in self.errors {
            if len(e.source_line) > 0 {
                kod_eprint(f"{e}\n{e.source_line}\n{e.caret}")
            } else {
                kod_eprint(f"{e}")
            }
        }
    }

    // Verify call-site arguments line up with a declared parameter list.
    // `param_labels[i]` is "" for an anon parameter, otherwise the
    // expected label. Reports one error per mismatch and keeps going so
    // a wrong call produces all its errors in a single compile.
    //
    // `skip` is the number of leading param_labels entries to ignore —
    // 1 for method calls (skip self), 0 for free functions.
    func check_call_args(self, anon args: [ast.CallArg], param_labels: [str], param_defaults: [int64], skip: int64, call_name: str, call_span: ast.Span) -> none {
        let expected_count: int64 = len(param_labels) - skip
        let n_args: int64 = len(args)
        // Too many: always an error. Too few: only an error if a
        // missing trailing param doesn't have a default. Args fill
        // params left-to-right; partial calls require the trailing
        // omitted ones to all carry defaults.
        if n_args > expected_count {
            self.report_error(f"error: `{call_name}` takes {self.arg_noun(expected_count)}, got {n_args}", span: call_span)
            return none
        }
        if n_args < expected_count {
            mut j: int64 = n_args
            for j < expected_count {
                if len(param_defaults) <= j + skip or param_defaults[j + skip] == 0 {
                    let missing: str = param_labels[j + skip]
                    if len(missing) == 0 {
                        self.report_error(f"error: `{call_name}` missing argument at position {j}", span: call_span)
                    } else {
                        self.report_error(f"error: `{call_name}` missing argument `{missing}`", span: call_span)
                    }
                    return none
                }
                j = j + 1
            }
        }
        mut i: int64 = 0
        for i < n_args {
            let arg = args[i]
            let expected = param_labels[i + skip]
            if len(expected) == 0 {
                if len(arg.label) > 0 {
                    self.report_error(f"error: parameter {i} of `{call_name}` is anon; remove label `{arg.label}`", span: arg.label_span)
                }
            } else {
                if len(arg.label) == 0 {
                    self.report_error(f"error: parameter {i} of `{call_name}` requires label `{expected}` (use `{expected}:` or `:{expected}` shorthand)", span: self.p.expr_spans[arg.value])
                } else if arg.label != expected {
                    self.report_error(f"error: parameter {i} of `{call_name}` expected label `{expected}`, got `{arg.label}`", span: arg.label_span)
                }
            }
            i = i + 1
        }
    }

    // If any arm of a match statement uses NonePat or SomePat, the
    // subject must have an optional type — `none`/`Some` aren't
    // meaningful patterns on a non-optional value. Same intent as
    // the Python typechecker's "Cannot use 'is' on non-optional" rule,
    // since `if x is none {...}` lowers to a MatchStmt.
    func check_match_subject(self, anon subject_id: int64, pattern_ids: [int64]) -> none {
        mut needs_optional: bool = false
        mut needs_result: bool = false
        mut needs_interface: bool = false
        for pid in pattern_ids {
            let pat = self.subject_pattern(self.p.patterns[pid], subject_kind: self.infer_kind(subject_id))
            match pat {
                .NonePat -> needs_optional = true
                .SomePat(_binding) -> needs_optional = true
                .OkPat(_b) -> needs_result = true
                .ErrPat(_b) -> needs_result = true
                .TypePat(_t, _b) -> needs_interface = true
                else self.check_pattern_subject(pat, :subject_id)
            }
        }
        let subj_kind = self.infer_kind(subject_id)
        if needs_interface {
            mut is_iface: bool = false
            if subj_kind is .KInterface(_idx) {
                is_iface = true
            }
            if is_iface == false {
                self.report_error("error: `is` / `match` with a type pattern requires an interface value", span: self.p.expr_spans[subject_id])
            }
        }
        if needs_optional {
            mut is_optional: bool = false
            if subj_kind is .KOptional(_inner) {
                is_optional = true
            }
            if is_optional == false {
                self.report_error("error: `is` / `match` with none/Some requires an optional value", span: self.p.expr_spans[subject_id])
            }
        }
        if needs_result {
            if self.is_result_kind(subj_kind) == false {
                self.report_error("error: `is` / `match` with Ok/Err requires a `T or Error` value", span: self.p.expr_spans[subject_id])
            }
        }
    }

    // False after reporting a pattern the subject's type can't match.
    func check_pattern_subject(self, anon pat: ast.Pattern, subject_id: int64) -> bool {
        let kind = self.infer_kind(subject_id)
        if self.kind_has_unknown(kind) {
            return true
        }
        mut target = ""
        mut variant = ""
        match pat {
            .IntPat(_value) -> return self.check_literal_pattern(.KInt64, :subject_id)
            .StrPat(_value) -> return self.check_literal_pattern(.KStr, :subject_id)
            .BoolPat(_value) -> return self.check_literal_pattern(.KBool, :subject_id)
            .EnumPat(enum_name, variant_name, _bindings) -> {
                target = f"`{enum_name}.{variant_name}`"
                variant = variant_name
            }
            .ImplicitEnumPat(variant_name, _bindings) -> {
                target = f"`.{variant_name}`"
                variant = variant_name
            }
            else return true
        }
        if kind is .KEnum(_idx) {
            return true
        }
        let span = self.p.expr_spans[subject_id]
        let shown = self.kind_display(kind)
        let inner = self.optional_inner(kind)
        if inner is .KEnum(_inner_idx) {
            if kind is .KOptional(_k) {
                self.report_error(f"error: {target} matches a `{self.kind_display(inner)}`, not a `{shown}`{self.unwrap_hint(subject_id)}, or match `.Some(v)`", :span)
                return false
            }
        }
        if variant == "Some" or variant == "None" {
            self.report_error(f"error: {target} needs an optional value, got `{shown}`", :span)
            return false
        }
        if variant == "Ok" or variant == "Err" {
            self.report_error(f"error: {target} needs a `T or Error` value, got `{shown}`", :span)
            return false
        }
        self.report_error(f"error: {target} needs an enum value, got `{shown}`", :span)
        return false
    }

    func check_literal_pattern(self, anon want: TypeKind, subject_id: int64) -> bool {
        let kind = self.infer_kind(subject_id)
        if self.same_kind(kind, want) {
            return true
        }
        mut hint = ""
        if self.same_kind(self.optional_inner(kind), want) {
            hint = self.unwrap_hint(subject_id)
        }
        self.report_error(f"error: cannot match a `{self.kind_display(kind)}` value against a `{self.kind_display(want)}` literal{hint}", span: self.p.expr_spans[subject_id])
        return false
    }

    // Exhaustiveness check for matches whose subject is an enum,
    // optional, or bool. A wildcard arm satisfies coverage; otherwise
    // every variant (or both `Some` and `none` for optionals, or both
    // `true` and `false` for bool) must appear in at least one arm.
    // Reports one error per uncovered variant so a partial match
    // surfaces every gap in a single pass. Matches on int64 and str
    // require an explicit `else` arm.
    func check_match_exhaustive(self, anon subject_id: int64, pattern_ids: [int64]) -> none {
        mut has_wildcard: bool = false
        for pid in pattern_ids {
            if self.p.patterns[pid] is .Wildcard {
                has_wildcard = true
            }
        }
        if has_wildcard {
            return none
        }
        let subj_kind = self.infer_kind(subject_id)
        // Result-shaped subjects use the OkPat/ErrPat parser shorthand
        // (in addition to .Ok(_) / .Err(_) implicit-variant arms), so
        // handle them before the generic KEnum check would mistake the
        // bespoke patterns for missing coverage.
        if self.is_result_kind(subj_kind) {
            mut has_ok: bool = false
            mut has_err: bool = false
            for pid in pattern_ids {
                let pat = self.p.patterns[pid]
                if pat is .OkPat(_b) {
                    has_ok = true
                }
                if pat is .ErrPat(_b) {
                    has_err = true
                }
                let name = self.pattern_variant_name(pat)
                if name == "Ok" {
                    has_ok = true
                }
                if name == "Err" {
                    has_err = true
                }
            }
            if has_ok == false {
                self.report_error("error: match on `T or Error` doesn't cover `Ok(_)`", span: self.p.expr_spans[subject_id])
            }
            if has_err == false {
                self.report_error("error: match on `T or Error` doesn't cover `Err(_)`", span: self.p.expr_spans[subject_id])
            }
            return none
        }
        if subj_kind is .KEnum(enum_idx) {
            // An arm naming an undeclared variant reports that instead.
            for pid in pattern_ids {
                let name = self.pattern_variant_name(self.p.patterns[pid])
                if len(name) > 0 and self.find_variant_idx(name, :enum_idx) < 0 {
                    return none
                }
            }
            let enum_info = self.enums[enum_idx]
            for variant in enum_info.variants {
                mut covered: bool = false
                for pid in pattern_ids {
                    match self.p.patterns[pid] {
                        .EnumPat(_enum_name, variant_name, _bindings) -> {
                            if variant_name == variant.name {
                                covered = true
                            }
                        }
                        .ImplicitEnumPat(variant_name, _bindings) -> {
                            if variant_name == variant.name {
                                covered = true
                            }
                        }
                        else none
                    }
                }
                if covered == false {
                    self.report_error(f"error: match on `{self.enum_display_name(enum_idx)}` doesn't cover variant `{variant.name}`", span: self.p.expr_spans[subject_id])
                }
            }
        }
        if subj_kind is .KOptional(_inner) {
            mut has_some: bool = false
            mut has_none: bool = false
            for pid in pattern_ids {
                let pat = self.subject_pattern(self.p.patterns[pid], subject_kind: subj_kind)
                if pat is .SomePat(_b) {
                    has_some = true
                }
                if pat is .NonePat {
                    has_none = true
                }
            }
            if has_some == false {
                self.report_error("error: match on optional doesn't cover `Some(_)`", span: self.p.expr_spans[subject_id])
            }
            if has_none == false {
                self.report_error("error: match on optional doesn't cover `none`", span: self.p.expr_spans[subject_id])
            }
        }
        // An interface's set of implementors isn't enumerable, so a match on
        // one is only exhaustive with an `else` (handled by the early return).
        if subj_kind is .KInterface(_idx) {
            self.report_error("error: match on an interface requires an `else` arm", span: self.p.expr_spans[subject_id])
        }
        if subj_kind is .KBool {
            mut has_true: bool = false
            mut has_false: bool = false
            for pid in pattern_ids {
                if self.p.patterns[pid] is .BoolPat(value) {
                    if value {
                        has_true = true
                    } else {
                        has_false = true
                    }
                }
            }
            if has_true == false {
                self.report_error("error: match on bool doesn't cover `true`", span: self.p.expr_spans[subject_id])
            }
            if has_false == false {
                self.report_error("error: match on bool doesn't cover `false`", span: self.p.expr_spans[subject_id])
            }
        }
        // int64 and str matches can't be enumerated exhaustively, so
        // we require an `else` catch-all to make the fall-through explicit.
        if subj_kind is .KInt64 {
            self.report_error("error: match on int64 must include an `else` arm", span: self.p.expr_spans[subject_id])
        }
        if subj_kind is .KStr {
            self.report_error("error: match on str must include an `else` arm", span: self.p.expr_spans[subject_id])
        }
    }

    // Every argument travels in one of x0-x7, `self` included.
    func check_param_count(self, anon params: [ast.Param], what: str, span: ast.Span) -> none {
        let count = len(params)
        if count <= 8 {
            return
        }
        if params[0].name == "self" {
            self.report_error(f"error: {what} takes {count - 1} parameters besides `self`, but a method can take at most 7", :span)
            return
        }
        self.report_error(f"error: {what} takes {count} parameters, but a function can take at most 8", :span)
    }

    func is_lambda_name(self, anon name: str) -> bool {
        return len(name) > 9 and name[0..9] == "__lambda_"
    }

    // Check that a function declaration's parameter list places anon
    // parameters before any labeled ones. Reports one error per
    // out-of-order anon param. The implicit `self` receiver of a method
    // doesn't count as a labeled parameter for ordering purposes.
    func check_param_order(self, anon func_decl: ast.FuncDecl, anon name: str) -> none {
        mut seen_labeled: bool = false
        for param in func_decl.params {
            if param.name == "self" {
                continue
            }
            if param.anonymous {
                if seen_labeled {
                    self.report_error(f"error: in `{name}`, anon parameter `{param.name}` cannot follow a labeled parameter", span: param.span)
                }
            } else {
                seen_labeled = true
            }
        }
    }


    // Load an integer constant into a register. ARM64's `mov xN, #imm`
    // accepts only encodings the assembler can prove are 16-bit-immediate
    // shaped (and a few special forms); anything else gets a real
    // assemble-time error. For values outside that range we build the
    // 64-bit constant explicitly via `mov` + three `movk`s, with the
    // assembler doing the bit math at each 16-bit chunk. ARM64 `movk` is
    // "move with keep" — sets one 16-bit lane, leaves the others intact.
    //
    // We could fall back to `ldr xN, =N` (which parks the constant in a
    // literal pool) instead, but with `.subsections_via_symbols` +
    // `-dead_strip` the pool entry can be reaped by the linker — see
    // project_ldr_literal_dce_bug. The explicit movz/movk sequence
    // routes around that entirely.
    func emit_load_imm(self, anon dest: str, value: int64) -> none {
        if value >= -65535 and value <= 65535 {
            self.emit(f"mov {dest}, #{value}")
        } else {
            self.emit(f"mov {dest}, #({value} & 0xffff)")
            self.emit(f"movk {dest}, #(({value} >> 16) & 0xffff), lsl #16")
            self.emit(f"movk {dest}, #(({value} >> 32) & 0xffff), lsl #32")
            self.emit(f"movk {dest}, #(({value} >> 48) & 0xffff), lsl #48")
        }
    }

    // `cmp` takes only a 12-bit immediate, so a larger one goes through a register.
    func emit_cmp_imm(self, anon reg: str, value: int64) -> none {
        if value >= 0 and value <= 4095 {
            self.emit(f"cmp {reg}, #{value}")
            return none
        }
        let tmp = self.pool.alloc_reg()
        self.emit_load_imm(tmp, :value)
        self.emit(f"cmp {reg}, {tmp}")
        self.pool.free_reg(tmp)
    }

    func fresh(self, anon prefix: str) -> str {
        self.label_count = self.label_count + 1
        return f"{prefix}${self.label_count}"
    }

    // Single output gate. In dry-run mode (test_support.try_compile),
    // this becomes a no-op so codegen can run all its checks without
    // polluting stdout with the generated .s. Otherwise the line is
    // buffered into `out_buf` and formatted by `flush_out`. This wraps
    // the line in `Insn.Raw`; emitters that produce a structured `Insn`
    // value (currently just `emit_label`) push directly to `out_buf`.
    func println(self, anon line: str) -> none {
        if self.dry_run {
            return none
        }
        self.out_buf += [regalloc.Insn.Raw(text: line)]
    }

    // Drain the buffered output to stdout, one `print` per line.
    // Skips self-`mov`s left behind when coalescing collapses two
    // vregs onto one phys — substitution turns those into `mov xN, xN`
    // no-ops that the assembler would happily encode if we let them
    // through.
    func flush_out(self) -> none {
        for insn in self.out_buf {
            let s: str = self.format_insn(insn)
            if self.is_self_mov(s) == false {
                print(s)
            }
        }
        self.out_buf = []
    }

    // Format an `Insn` to its asm text.
    func format_insn(self, anon insn: regalloc.Insn) -> str {
        match insn {
            .Raw(text) -> return self.subst_vregs(text)
            .Label(name) -> return name + ":"
        }
    }

    // True if `s` is `\tmov xN, xN` for some register N — the no-op
    // pattern coalescing leaves behind once vDst and vSrc share a phys.
    func is_self_mov(self, anon s: str) -> bool {
        let n: int64 = len(s)
        if n < 8 or s[0] != '\t' or s[1] != 'm' or s[2] != 'o' or s[3] != 'v' or s[4] != ' ' {
            return false
        }
        mut i: int64 = 5
        // First operand: `xN` or `wN`.
        if i >= n or (s[i] != 'x' and s[i] != 'w') {
            return false
        }
        let start_a: int64 = i
        i = i + 1
        for i < n and lexing.is_digit(s[i]) {
            i = i + 1
        }
        let end_a: int64 = i
        if i >= n or s[i] != ',' {
            return false
        }
        i = i + 1
        for i < n and s[i] == ' ' {
            i = i + 1
        }
        // Second operand: same prefix + digits, exact match.
        if i >= n or (s[i] != 'x' and s[i] != 'w') {
            return false
        }
        let start_b: int64 = i
        i = i + 1
        for i < n and lexing.is_digit(s[i]) {
            i = i + 1
        }
        let end_b: int64 = i
        if i != n {
            return false
        }
        return s[start_a..end_a] == s[start_b..end_b]
    }

    // Walk `text` and replace every `v<digits>` (or `w<digits>`) token
    // with the physical register recorded in `vreg_phys`. A token is a
    // `v`/`w` followed by one or more digits, with no symbol character
    // (`regalloc.is_sym_char`) on either side; runs that land inside a
    // longer identifier or mangled label (`Lv1_end`, `$main$v2`) are
    // left alone, and so is anything inside double quotes (`.asciz`
    // string data).
    //
    // The output is built by concatenating verbatim chunks of `text`
    // around the substitution sites — O(n) per line, vs the char-by-char
    // accumulator pattern's O(n²). `flush_start` marks the beginning of
    // the next pending chunk; whenever we replace a vreg, we append
    // `text[flush_start..vreg_start]` followed by the substitution and
    // advance `flush_start` past the vreg. Lines with no substitutions
    // return the original `text` unchanged.
    func subst_vregs(self, anon text: str) -> str {
        let n: int64 = len(text)
        mut out: str = ""
        mut flush_start: int64 = 0
        mut i: int64 = 0
        for i < n {
            let c: int64 = text[i]
            if c == '"' {
                i = regalloc.skip_quoted(text, start: i)
            } else if (c == 'v' or c == 'w') and i + 1 < n and lexing.is_digit(text[i + 1]) {
                mut boundary: bool = true
                if i > 0 and regalloc.is_sym_char(text[i - 1]) {
                    boundary = false
                }
                if boundary == false {
                    i = i + 1
                    continue
                }
                mut j: int64 = i + 1
                mut id: int64 = 0
                for j < n and lexing.is_digit(text[j]) {
                    id = id * 10 + text[j] - '0'
                    j = j + 1
                }
                if j < n and regalloc.is_sym_char(text[j]) {
                    i = j
                    continue
                }
                if id >= len(self.pool.vreg_phys) {
                    i = j
                    continue
                }
                let phys: str = self.pool.vreg_phys[id]
                out = out + text[flush_start..i]
                if c == 'w' {
                    // x-form → w-form: same number, different prefix.
                    out = out + "w" + phys[1..len(phys)]
                } else {
                    out = out + phys
                }
                flush_start = j
                i = j
            } else {
                i = i + 1
            }
        }
        if flush_start == 0 {
            return text
        }
        return out + text[flush_start..n]
    }

    func emit(self, anon line: str) -> none {
        self.println(f"\t{line}")
    }

    func emit_label(self, anon lbl: str) -> none {
        if self.dry_run {
            return none
        }
        self.out_buf += [regalloc.Insn.Label(name: lbl)]
    }

    func emit_globl(self, anon lbl: str) -> none {
        self.println(f"\t.globl {lbl}")
    }

    // Record a line marker for the current statement's source line.
    // Emits `Lline_N:` into the buffered text section so the linker
    // assigns it the address of the next instruction the statement
    // emits, and stashes (label, line) for `emit_func_lines_table`
    // to drain into __DATA,__kod_lines at the end of compile_func.
    // Skips when the line hasn't changed since the previous marker
    // (the bounds-check arm and other intra-statement asm can
    // synthesise repeated entries that the runtime lookup doesn't
    // need).
    func mark_stmt_line(self, anon stmt_id: int64) -> none {
        if self.dry_run {
            return none
        }
        let off: int64 = self.stmt_offset(stmt_id)
        if off == 0 {
            return none
        }
        let line: int64 = self.line_of_offset(off)
        if line == self.last_marked_line {
            return none
        }
        let lbl: str = self.fresh("Lline")
        self.emit_label(lbl)
        self.func_lines_labels += [lbl]
        self.func_lines_values += [line]
        self.last_marked_line = line
    }

    // Best-guess source offset of a statement's first token. Used by
    // per-statement backtrace markers to attach a line to the
    // instructions a statement emits. Statements without a useful
    // embedded span (Break, Continue) return 0; the line falls back
    // to whatever the previous marker recorded, which is the right
    // behaviour for a panic inside a Break/Continue (it points at
    // the immediately preceding statement).
    func stmt_offset(self, anon stmt_id: int64) -> int64 {
        match self.p.stmts[stmt_id] {
            .Let(_n, _t, value, _m) -> {
                if value != 0 {
                    return self.p.expr_spans[value].start
                }
                return 0
            }
            .Assign(lhs, _r) -> return self.p.expr_spans[lhs].start
            .PlusAssign(lhs, _r) -> return self.p.expr_spans[lhs].start
            .MinusAssign(lhs, _r) -> return self.p.expr_spans[lhs].start
            .Return(value) -> {
                if value != 0 {
                    return self.p.expr_spans[value].start
                }
                return 0
            }
            .If(cond, _t, _e) -> return self.p.expr_spans[cond].start
            .For(cond, _b) -> {
                if cond != 0 {
                    return self.p.expr_spans[cond].start
                }
                return 0
            }
            .ForEach(_n, iter, _b) -> return self.p.expr_spans[iter].start
            .ExprStmt(expr) -> return self.p.expr_spans[expr].start
            .MatchStmt(subject, _a) -> return self.p.expr_spans[subject].start
            .LetElse(_p, value, _e) -> return self.p.expr_spans[value].start
            .Throw(value) -> return self.p.expr_spans[value].start
            .Assert(expr, _s, _sp) -> return self.p.expr_spans[expr].start
            else return 0
        }
    }

    // Convert a byte offset into the current parser's source into a
    // 1-indexed line number. The parser caches a `line_starts` array
    // (byte offsets of each line's first character) on first call;
    // subsequent calls are an O(log n) binary search. Important for
    // per-statement backtrace emission, which hits this on every
    // compile_stmt — was O(n) per call before the cache.
    func line_of_offset(self, anon offset: int64) -> int64 {
        let p: parsing.Parser = self.p
        if len(p.line_starts) == 0 {
            let source: str = p.source
            p.line_starts += [0]
            mut i: int64 = 0
            for i < len(source) {
                if source[i] == '\n' {
                    p.line_starts += [i + 1]
                }
                i = i + 1
            }
        }
        // Binary search for the largest line_starts[k] ≤ offset.
        // line number is k + 1 (1-indexed).
        let starts: [int64] = p.line_starts
        mut lo: int64 = 0
        mut hi: int64 = len(starts) - 1
        for lo < hi {
            let mid: int64 = (lo + hi + 1) / 2
            if starts[mid] <= offset {
                lo = mid
            } else {
                hi = mid - 1
            }
        }
        return lo + 1
    }

    // Emit a symtab row for `func_lbl` so the runtime panic handler
    // can map a return address back to a function name + source
    // location, plus a per-function lines sub-table for resolving
    // the precise call-site line within the function.
    //
    //   __TEXT,__cstring : Lkodsym_N_name: .asciz "Codegen.compile_func"
    //                       Lkodsym_N_file: .asciz "stdlib/kod/codegen.kod"
    //   __DATA,__kod_lines  : Lkodlines_N_start: <function's (pc, line) rows>
    //                          Lkodlines_N_end:
    //   __DATA,__kod_symtab :
    //     .quad <func_lbl>          -- addr (function entry)
    //     .quad Lkodsym_N_name      -- display name
    //     .quad Lkodsym_N_file      -- source path
    //     .long <decl_line>         -- 1-indexed line of `func name` ident
    //     .long 0                   -- padding to keep entry 8-aligned
    //     .quad Lkodlines_N_start   -- start of per-function (pc, line) rows
    //     .quad Lkodlines_N_end     -- end of per-function (pc, line) rows
    //
    // The runtime in stdlib/runtime.c queries
    // `section$start$__DATA$__kod_symtab` / `section$end$...` (the
    // Mach-O linker-synthesised bounds) and linear-scans for the
    // entry whose address is the largest one ≤ the return address;
    // then walks the linked lines table for the precise stmt-level
    // line covering that lr.
    //
    // Lines rows are { void *pc; int32 line; int32 _pad; } = 16 bytes.
    func emit_symtab_entry(self, anon func_lbl: str, name: str, file: str, line: int64) -> none {
        if self.dry_run {
            self.func_lines_labels = []
            self.func_lines_values = []
            return none
        }
        let name_lbl: str = self.fresh("Lkodsym")
        let file_lbl: str = self.fresh("Lkodsym")
        let lines_start: str = self.fresh("Lkodlines_start")
        let lines_end: str = self.fresh("Lkodlines_end")
        self.println("\t.section __TEXT,__cstring,cstring_literals")
        self.emit_label(name_lbl)
        self.emit_asciz(name)
        self.emit_label(file_lbl)
        self.emit_asciz(file)
        self.println("\t.section __DATA,__kod_lines,regular,no_dead_strip")
        self.println("\t.p2align 3")
        self.emit_label(lines_start)
        mut i: int64 = 0
        for i < len(self.func_lines_labels) {
            self.println(f"\t.quad {self.func_lines_labels[i]}")
            self.println(f"\t.long {self.func_lines_values[i]}")
            self.println("\t.long 0")
            i = i + 1
        }
        self.emit_label(lines_end)
        self.println("\t.section __DATA,__kod_symtab,regular,no_dead_strip")
        self.println("\t.p2align 3")
        self.println(f"\t.quad {func_lbl}")
        self.println(f"\t.quad {name_lbl}")
        self.println(f"\t.quad {file_lbl}")
        self.println(f"\t.long {line}")
        self.println("\t.long 0")
        self.println(f"\t.quad {lines_start}")
        self.println(f"\t.quad {lines_end}")
        self.println("\t.text")
        self.func_lines_labels = []
        self.func_lines_values = []
    }

    func emit_asciz(self, anon value: str) -> none {
        if self.dry_run {
            return none
        }
        // Build the escaped body byte-by-byte (value[j..j+1] is a 1-byte
        // slice), then emit one `\t.asciz "..."` line through println so
        // it lands in `out_buf` in order with the surrounding directives.
        mut body = ""
        mut j = 0
        for j < len(value) {
            let char = value[j]
            mut escaped = false
            if char == '\n' {
                body = body + "\\n"
                escaped = true
            }
            if char == '\t' {
                body = body + "\\t"
                escaped = true
            }
            if char == '\r' {
                body = body + "\\r"
                escaped = true
            }
            if char == '\\' {
                body = body + "\\\\"
                escaped = true
            }
            if char == '"' {
                body = body + "\\\""
                escaped = true
            }
            // NUL byte must be escaped or the embedded NUL prematurely
            // terminates the `.asciz "..."` line under any libc-puts-style
            // emitter (e.g. the Python interpreter's print backend),
            // truncating the trailing `"` and breaking the assembler.
            if char == '\0' {
                body = body + "\\0"
                escaped = true
            }
            if escaped == false {
                body = body + value[j..j+1]
            }
            j = j + 1
        }
        self.println(f"\t.asciz \"{body}\"")
    }


    // ARM64 callee-saved general registers we draw from the pool. A value
    // parked in one of these survives any `bl` we emit — the callee (our
    // own functions and the C runtime alike) restores them per AAPCS — so
    // it needs no spill around a call. compile_func saves the ones a
    // function uses in its prologue. x28 is never pool-allocated; it only
    // appears as the pad register when an odd number of callee-saved regs
    // is saved (stp works in pairs). The actual pool + alloc/free + the
    // "is callee-saved" predicate live in `regalloc.RegPool`, accessed
    // via `self.pool`.

    // Stash `reg` to a fresh 16-byte stack slot so its value survives a
    // call-bearing sub-expression — UNLESS reg is callee-saved, in which
    // case it's preserved for free and we emit nothing. Returns true iff a
    // spill was emitted; pass that to the matching `restore_across`.
    func spill_across(self, anon reg: str) -> bool {
        if self.pool.is_callee_saved(reg) {
            return false
        }
        self.emit("sub sp, sp, #16")
        self.emit(f"str {reg}, [sp]")
        return true
    }

    func restore_across(self, anon reg: str, spilled: bool) -> none {
        if spilled {
            self.emit(f"ldr {reg}, [sp]")
            self.emit("add sp, sp, #16")
        }
    }

    // Like spill_across, but for the "stash a value, recycle its register
    // across a call, then reload into a fresh register" idiom (boxing into
    // an arena cell, field/index stores). If `reg` is callee-saved the
    // value survives the call on its own: emit nothing and keep reg
    // allocated. Otherwise stash to a fresh slot and free reg so the
    // intervening code can reuse it. Returns whether a spill was emitted;
    // `preserve_end` then yields the register the value lives in afterward.
    func preserve_begin(self, anon reg: str) -> bool {
        if self.pool.is_callee_saved(reg) {
            return false
        }
        self.emit("sub sp, sp, #16")
        self.emit(f"str {reg}, [sp]")
        self.pool.free_reg(reg)
        return true
    }

    func preserve_end(self, anon reg: str, spilled: bool) -> str {
        if spilled == false {
            return reg
        }
        let r2 = self.pool.alloc_reg()
        self.emit(f"ldr {r2}, [sp]")
        self.emit("add sp, sp, #16")
        return r2
    }

    func free_val(self, anon val: Val) -> none {
        if val is .VReg(name) {
            self.pool.free_reg(name)
        }
    }


    func load(self, anon val: Val) -> str {
        match val {
            .VReg(name) -> return name
            .VImm(value) -> {
                mut reg = self.pool.alloc_reg()
                self.emit_load_imm(reg, :value)
                return reg
            }
            .VStack(offset) -> {
                mut reg = self.pool.alloc_reg()
                self.emit_ldr(offset, :reg)
                return reg
            }
            .VStrLbl(page) -> {
                mut reg = self.pool.alloc_reg()
                self.emit(f"adrp {reg}, {page}@PAGE")
                self.emit(f"add {reg}, {reg}, {page}@PAGEOFF")
                return reg
            }
        }
    }

    func mov_to(self, anon val: Val, dest: str) -> str {
        match val {
            .VReg(name) -> {
                if name != dest {
                    self.emit(f"mov {dest}, {name}")
                    self.pool.free_reg(name)
                }
                return dest
            }
            .VImm(value) -> {
                self.emit_load_imm(dest, :value)
                return dest
            }
            .VStack(offset) -> {
                self.emit_ldr(offset, reg: dest)
                return dest
            }
            .VStrLbl(page) -> {
                self.emit(f"adrp {dest}, {page}@PAGE")
                self.emit(f"add {dest}, {dest}, {page}@PAGEOFF")
                return dest
            }
        }
    }


    func intern_str(self, anon value: str) -> str {
        // Bind `interned` to a local so method calls go through a single
        // dotted callee (`m.get(...)`) — the codegen does not currently
        // support three-part dotted call syntax like `self.interned.get`.
        // Map is a reference type so `m` shares state with `self.interned`.
        let m = self.interned
        if m.get(value) is Some(existing) {
            return existing
        }
        let lbl = self.fresh("Lstr")
        m.set(value, lbl)
        self.str_labels += [lbl]
        self.str_values += [value]
        return lbl
    }


    func alloc_var(self, name: str, kind: TypeKind) -> int64 {
        self.frame_slots = self.frame_slots + 1
        mut offset = 0 - self.frame_slots * 8
        self.vars += [VarSlot(:name, :offset, :kind)]
        return offset
    }

    func find_var_offset(self, anon name: str) -> int64 {
        mut i = len(self.vars) - 1
        for i >= 0 {
            if self.vars[i].name == name {
                return self.vars[i].offset
            }
            i = i - 1
        }
        return -9999
    }

    func find_var_kind(self, anon name: str) -> TypeKind {
        mut i = len(self.vars) - 1
        for i >= 0 {
            if self.vars[i].name == name {
                return self.slot_kind(i)
            }
            i = i - 1
        }
        return .KUnknown
    }

    // A call through a local other than a fixed parameter is taken to return.
    func slot_kind(self, anon i: int64) -> TypeKind {
        if self.untyped_walk == false {
            return self.vars[i].kind
        }
        mut j = len(self.walk_slots) - 1
        for j >= 0 {
            if self.walk_slots[j] == i {
                return self.walk_kinds[j]
            }
            j -= 1
        }
        if regalloc.str_in(self.fixed_names, p: self.vars[i].name) {
            return self.vars[i].kind
        }
        return .KUnknown
    }

    // Overwrite the most-recently-allocated slot for `name` with a new
    // kind. Used by foreach element re-binding when the same name is
    // reused across loops with differently-typed iterators.
    func update_var_kind(self, name: str, kind: TypeKind) -> none {
        mut i = len(self.vars) - 1
        for i >= 0 {
            if self.vars[i].name == name {
                if self.untyped_walk {
                    self.walk_slots += [i]
                    self.walk_kinds += [kind]
                } else {
                    self.vars[i].kind = kind
                }
                return none
            }
            i = i - 1
        }
    }

    func var_declared(self, anon name: str) -> bool {
        mut i = 0
        for i < len(self.vars) {
            if self.vars[i].name == name {
                return true
            }
            i = i + 1
        }
        return false
    }

    func var_bound(self, anon name: str) -> bool {
        mut i = len(self.vars) - 1
        for i >= 0 {
            if self.vars[i].name == name {
                return self.vars[i].bound
            }
            i = i - 1
        }
        return false
    }

    func var_seen(self, anon name: str) -> bool {
        mut i = len(self.vars) - 1
        for i >= 0 {
            if self.vars[i].name == name {
                return self.vars[i].seen
            }
            i = i - 1
        }
        return false
    }

    // Only a local holding a function value hides a function of its name.
    func calls_local(self, anon name: str) -> bool {
        mut i = len(self.vars) - 1
        for i >= 0 {
            if self.vars[i].name == name {
                if self.vars[i].bound == false {
                    return false
                }
                match self.slot_kind(i) {
                    .KFunc(_params, _ret) -> return true
                    .KUnknown -> return true
                    else return false
                }
            }
            i = i - 1
        }
        return false
    }

    func bind_var(self, anon name: str) -> none {
        mut i = len(self.vars) - 1
        for i >= 0 {
            if self.vars[i].name == name {
                if self.vars[i].bound == false {
                    self.vars[i].bound = true
                    if self.untyped_walk and self.vars[i].seen == false {
                        self.seen_log += [i]
                    }
                    self.vars[i].seen = true
                    self.bound_log += [i]
                }
                return
            }
            i = i - 1
        }
    }

    func bind_pattern(self, anon pattern: ast.Pattern) -> none {
        for name in self.pattern_binding_names(pattern) {
            self.bind_var(name)
        }
    }

    // Ends the scope of every binding made since `mark`.
    func unbind_to(self, anon mark: int64) -> none {
        if len(self.bound_log) == mark {
            return
        }
        for idx in self.bound_log[mark..] {
            self.vars[idx].bound = false
        }
        self.bound_log = self.bound_log[0..mark]
    }

    func compile_block(self, anon stmts: [int64]) -> none {
        let mark = len(self.bound_log)
        self.block_depth += 1
        for stmt_id in stmts {
            self.compile_stmt(stmt_id)
        }
        self.block_depth -= 1
        self.unbind_to(mark)
    }

    func var_index(self, anon name: str) -> int64 {
        mut i = len(self.vars) - 1
        for i >= 0 {
            if self.vars[i].name == name {
                return i
            }
            i = i - 1
        }
        return -1
    }

    // Until blocks get scopes, a nested binding would share the outer one's slot.
    func rebinds_outer(self, anon name: str, off: int64, depth: int64) -> bool {
        let i = self.var_index(name)
        if i < 0 or self.vars[i].bound == false or self.vars[i].depth >= depth {
            return false
        }
        let line = self.line_of_offset(self.vars[i].bind_off)
        self.report_error(f"error: `{name}` is already a local here (line {line}); blocks don't have their own scopes yet, so give this one another name", span: ast.Span(start: off))
        return true
    }

    func bind_at(self, anon name: str, off: int64, depth: int64) -> none {
        let i = self.var_index(name)
        if i < 0 or (self.vars[i].bound and self.vars[i].depth < depth) {
            return
        }
        self.bind_var(name)
        self.vars[i].depth = depth
        self.vars[i].bind_off = off
    }

    func pattern_rebinds_outer(self, anon pattern_id: int64, depth: int64) -> bool {
        let end = self.p.pattern_ends[pattern_id]
        mut clash = false
        for name in self.pattern_binding_names(self.p.patterns[pattern_id]) {
            if self.rebinds_outer(name, off: self.name_before(name, off: end), :depth) {
                clash = true
            }
        }
        return clash
    }

    func bind_pattern_at(self, anon pattern_id: int64, depth: int64) -> none {
        let end = self.p.pattern_ends[pattern_id]
        for name in self.pattern_binding_names(self.p.patterns[pattern_id]) {
            self.bind_at(name, off: self.name_before(name, off: end), :depth)
        }
    }

    // Where `name` last occurs as a whole word shortly before `off`.
    func name_before(self, anon name: str, off: int64) -> int64 {
        let source = self.p.source
        let n = len(name)
        mut i = off - n
        for i >= 0 and i > off - 256 {
            if source[i] == name[0] and source[i..i + n] == name {
                let clear_before = i == 0 or lexing.is_alnum(source[i - 1]) == false
                let clear_after = i + n >= len(source) or lexing.is_alnum(source[i + n]) == false
                if clear_before and clear_after {
                    return i
                }
            }
            i = i - 1
        }
        return off
    }

    // Whether the most-recently-declared slot for `name` permits bare
    // reassignment. Returns true when not found so missing-variable
    // diagnostics stay the responsibility of the offset lookup.
    func find_var_mutable(self, anon name: str) -> bool {
        mut i = len(self.vars) - 1
        for i >= 0 {
            if self.vars[i].name == name {
                return self.vars[i].mutable
            }
            i = i - 1
        }
        return true
    }

    // Master switch for immutable-binding enforcement. Flipped to true in
    // the enforcement phase once the codebase has been migrated to `mut`;
    // while false, codegen output is unchanged.
    func enforce_immutability(self) -> bool {
        return true
    }


    func find_enum_idx(self, anon name: str) -> int64 {
        if self.enum_idx.get(name) is Some(i) {
            return i
        }
        return -1
    }

    // True if `idx` names the stdlib Result enum — either the template
    // itself (e.g. when ImplicitEnumVariant resolution falls back to it
    // for `.Ok` / `.Err`) or any monomorphised instance Result[T, E].
    func is_result_enum_idx(self, anon idx: int64) -> bool {
        if idx < 0 or idx >= len(self.enums) {
            return false
        }
        let e = self.enums[idx]
        if e.template_idx >= 0 {
            return self.enums[e.template_idx].name == "Result"
        }
        return e.name == "Result"
    }

    // True if `k` represents a fallible result — i.e. an instantiation
    // of the stdlib Result enum, which is what `T or Error` desugars to.
    func is_result_kind(self, anon k: TypeKind) -> bool {
        if k is .KEnum(idx) {
            return self.is_result_enum_idx(idx)
        }
        return false
    }

    // Extract the Ok-payload kind from a Result-shaped TypeKind, or
    // KVoid if `k` isn't Result-shaped.
    func result_inner_kind(self, anon k: TypeKind) -> TypeKind {
        if k is .KEnum(idx) {
            if self.is_result_enum_idx(idx) {
                return self.enums[idx].variants[0].field_kinds[0]
            }
        }
        return .KVoid
    }

    func result_err_kind(self, anon k: TypeKind) -> TypeKind {
        let .KEnum(idx) = k else { return .KUnknown }
        let err_kinds = self.enums[idx].variants[1].field_kinds
        if len(err_kinds) != 1 {
            return .KUnknown
        }
        return err_kinds[0]
    }

    // Runtime discriminant for Result's Ok variant. Looked up dynamically
    // rather than hardcoded so the disc-shift (variants start at 1) stays
    // localised in register_enum; callers that emit `cmp disc, #N` against
    // an Ok/Err result cell use this instead of literal 0/1.
    func result_ok_disc(self) -> int64 {
        let idx = self.find_enum_idx("Result")
        if idx >= 0 {
            return self.enums[idx].variants[0].discriminant
        }
        return 1
    }

    // Runtime discriminant for Result's Err variant.
    func result_err_disc(self) -> int64 {
        let idx = self.find_enum_idx("Result")
        if idx >= 0 {
            return self.enums[idx].variants[1].discriminant
        }
        return 2
    }

    func find_struct_idx(self, anon name: str) -> int64 {
        if self.struct_idx.get(name) is Some(i) {
            return i
        }
        return -1
    }

    func find_iface_idx(self, anon name: str) -> int64 {
        if self.iface_idx.get(name) is Some(i) {
            return i
        }
        return -1
    }

    // The label of the vtable for a struct acting as an interface.
    func vtable_label(self, anon struct_idx: int64, anon iface_idx: int64) -> str {
        let struct_info = self.structs[struct_idx]
        let iface_info = self.interfaces[iface_idx]
        return f"${iface_info.module_prefix}${iface_info.name}$for${struct_info.module_prefix}${struct_info.name}$vtable"
    }

    // Register a (struct, interface) pair so its vtable is emitted at the
    // end of compile_module. Idempotent: subsequent calls for the same
    // pair do nothing. Returns the vtable label.
    func register_vtable(self, anon struct_idx: int64, anon iface_idx: int64) -> str {
        mut k = 0
        for k < len(self.vtable_struct_idx) {
            if self.same_struct(self.vtable_struct_idx[k], struct_idx) and self.same_iface(self.vtable_iface_idx[k], iface_idx) {
                return self.vtable_label(struct_idx, iface_idx)
            }
            k = k + 1
        }
        self.vtable_struct_idx += [struct_idx]
        self.vtable_iface_idx += [iface_idx]
        return self.vtable_label(struct_idx, iface_idx)
    }

    // Hardcoded module prefix for each primitive type. Used to compose
    // primitive vtable labels and to mangle primitive method symbols.
    func prim_module_prefix(self, kind: TypeKind) -> str {
        match kind {
            .KInt64 -> return "primitives$int64"
            .KStr -> return "primitives$str"
            .KBool -> return "primitives$bool"
            else return ""
        }
    }

    // The label of the vtable for a primitive type acting as an interface.
    func prim_vtable_label(self, anon iface_idx: int64, kind: TypeKind) -> str {
        let iface_info = self.interfaces[iface_idx]
        let prim_prefix = self.prim_module_prefix(:kind)
        return f"${iface_info.module_prefix}${iface_info.name}$for${prim_prefix}$vtable"
    }

    // Register a (primitive_kind, interface) pair so its vtable is emitted
    // at the end of compile_module. Returns the vtable label.
    func register_prim_vtable(self, anon iface_idx: int64, kind: TypeKind) -> str {
        mut k = 0
        for k < len(self.prim_vtable_kinds) {
            if self.same_iface(self.prim_vtable_iface_idx[k], iface_idx) {
                let stored = self.prim_vtable_kinds[k]
                mut matches = false
                match kind {
                    .KInt64 -> if stored is .KInt64 { matches = true }
                    .KStr -> if stored is .KStr { matches = true }
                    .KBool -> if stored is .KBool { matches = true }
                    else none
                }
                if matches {
                    return self.prim_vtable_label(iface_idx, :kind)
                }
            }
            k = k + 1
        }
        self.prim_vtable_kinds += [kind]
        self.prim_vtable_iface_idx += [iface_idx]
        return self.prim_vtable_label(iface_idx, :kind)
    }

    // Return the closest name in `candidates` to `typo` within
    // `max_distance` Levenshtein edits, or "" if none qualifies.
    // Used to attach "did you mean X?" hints to unknown-identifier
    // diagnostics — small candidate lists (a few hundred entries at
    // most), tiny inputs (identifier-length), so the O(n*m) DP cost
    // is irrelevant for the handful of errors a single compile reports.
    func find_closest(self, anon typo: str, candidates: [str], max_distance: int64) -> str {
        mut best: str = ""
        mut best_dist: int64 = max_distance + 1
        mut i: int64 = 0
        for i < len(candidates) {
            let d: int64 = typo.distance(candidates[i])
            if d < best_dist {
                best_dist = d
                best = candidates[i]
            }
            i = i + 1
        }
        return best
    }

    // Build an `error: <msg>; did you mean `<X>`?` message when a
    // near-match exists in `candidates`, or just `error: <msg>` when
    // it doesn't. Centralises the suggestion-or-not branch so each
    // call site stays a one-liner.
    func with_suggestion(self, anon msg: str, typo: str, candidates: [str]) -> str {
        mut s: str = self.find_closest(typo, :candidates, max_distance: 2)
        if len(s) > 0 {
            return f"{msg}; did you mean `{s}`?"
        }
        return msg
    }

    func find_import_fn_idx(self, anon local_mod: str, anon name: str) -> int64 {
        mut i = 0
        for i < len(self.import_fns) {
            let f = self.import_fns[i]
            if f.module == local_mod and f.name == name {
                return i
            }
            i = i + 1
        }
        return -1
    }

    // The current expression's module scope; -1 for the entry.
    func cur_scope(self) -> int64 {
        if self.p.path == self.entry_path {
            return -1
        }
        if self.scope_idx.get(self.p.path) is Some(si) {
            if self.scopes[si].built == false {
                self.build_scope(si)
            }
            return si
        }
        return -1
    }

    func note_import(self, importer: str, local_name: str, target: str) -> none {
        if self.scope_idx.get(importer) is Some(si) {
            self.scopes[si].alias_names += [local_name]
            self.scopes[si].alias_paths += [target]
        }
    }

    func scope_alias_target(self, anon si: int64, anon alias: str) -> int64 {
        mut i = 0
        for i < len(self.scopes[si].alias_names) {
            if self.scopes[si].alias_names[i] == alias {
                if self.scope_idx.get(self.scopes[si].alias_paths[i]) is Some(ti) {
                    if self.scopes[ti].built == false {
                        self.build_scope(ti)
                    }
                    return ti
                }
                return -1
            }
            i += 1
        }
        return -1
    }

    func add_scope(self, anon module: ast.Module, prefix: str, p: parsing.Parser) -> none {
        if self.scope_idx.contains(p.path) {
            return
        }
        let m = self.scope_idx
        m.set(p.path, len(self.scopes))
        self.scopes += [ModuleScope(path: p.path, :prefix, :module, :p)]
    }

    // Sigs resolve on first use, so unused generics aren't instantiated.
    func build_scope(self, anon si: int64) -> none {
        self.scopes[si].built = true
        let s = self.scopes[si]
        let own = s.own
        mut di = 0
        for decl in s.module.decls {
            match decl {
                .Func(decl_id) -> {
                    own.set(s.p.func_decls[decl_id].name, di)
                    self.scopes[si].names += [s.p.func_decls[decl_id].name]
                }
                .Extern(name, _name_span, _params, _return_typ) -> {
                    own.set(name, di)
                    self.scopes[si].names += [name]
                }
                .Import(_module_name, local_name, items) -> {
                    for want in items {
                        self.scopes[si].item_names += [want]
                        self.scopes[si].item_aliases += [local_name]
                    }
                }
                else none
            }
            di += 1
        }
        // Numbered the way compile_module names them in their own module.
        let lambdas = s.lambdas
        mut k = 0
        mut li = 1
        for li < len(s.p.func_decls) {
            if len(s.p.func_decls[li].name) == 0 {
                lambdas.set(f"{li}", k)
                k += 1
            }
            li += 1
        }
    }

    // `decl_idx` into module.decls, or -1 for the function literal `lambda_id`.
    func add_scope_fn(self, anon si: int64, anon key: str, decl_idx: int64, lambda_id: int64) -> int64 {
        let s = self.scopes[si]
        // Resolved outside any generic body that happens to look it up first.
        let saved_names = self.subst_names
        let saved_args = self.subst_args
        let no_names: [str] = []
        let no_args: [TypeKind] = []
        self.subst_names = no_names
        self.subst_args = no_args
        mut fd_id = lambda_id
        mut k = -1
        if decl_idx >= 0 {
            match s.module.decls[decl_idx] {
                .Func(decl_id) -> fd_id = decl_id
                .Extern(_name, name_span, params, return_typ) -> {
                    k = self.push_scope_fn(si, f: ImportFn(module: s.path, name: key, label: f"_{key}", sig: self.resolve_extern_sig(params, :return_typ, p: s.p), def_path: s.path, def_span: name_span))
                }
                else none
            }
        }
        if fd_id > 0 {
            let fd = s.p.func_decls[fd_id]
            k = self.push_scope_fn(si, f: ImportFn(module: s.path, name: key, label: f"${s.prefix}${key}", sig: self.resolve_sig(fd_id, p: s.p), def_path: s.path, def_span: fd.name_span))
        }
        self.subst_names = saved_names
        self.subst_args = saved_args
        return k
    }

    func push_scope_fn(self, anon si: int64, f: ImportFn) -> int64 {
        let funcs = self.scopes[si].funcs
        funcs.set(f.name, len(self.scope_fns))
        self.scope_fns += [f]
        return len(self.scope_fns) - 1
    }

    func scope_own_fn(self, anon si: int64, anon name: str) -> int64 {
        let s = self.scopes[si]
        if s.funcs.get(name) is Some(k) {
            return k
        }
        if s.own.get(name) is Some(di) {
            return self.add_scope_fn(si, name, decl_idx: di, lambda_id: 0)
        }
        return -1
    }

    // A `{ name }` import item; the last import wins.
    func scope_item_fn(self, anon si: int64, anon name: str) -> int64 {
        mut k = -1
        mut i = 0
        for i < len(self.scopes[si].item_names) {
            if self.scopes[si].item_names[i] == name {
                let ti = self.scope_alias_target(si, self.scopes[si].item_aliases[i])
                if ti >= 0 {
                    let tk = self.scope_own_fn(ti, name)
                    if tk >= 0 {
                        k = tk
                    }
                }
            }
            i += 1
        }
        return k
    }

    // A local function value, then the module's own function or import item, come first.
    func is_builtin_call(self, anon name: str) -> bool {
        if self.calls_local(name) {
            return false
        }
        let slot = self.lookup_func(name)
        return slot == -1 or self.fn_sig(slot).src_p.path == self.builtins_path
    }

    // In the current module: a func_* index, scope_fns[k] as -2 - k, or -1.
    func lookup_func(self, anon name: str) -> int64 {
        let si = self.cur_scope()
        if si < 0 {
            if self.func_idx.get(name) is Some(idx) {
                return idx
            }
            return -1
        }
        let k = self.scope_own_fn(si, name)
        if k >= 0 {
            return -2 - k
        }
        let ik = self.scope_item_fn(si, name)
        if ik >= 0 {
            return -2 - ik
        }
        if self.scopes[si].path != self.builtins_path {
            if self.scope_idx.get(self.builtins_path) is Some(bi) {
                if self.scopes[bi].built == false {
                    self.build_scope(bi)
                }
                let bk = self.scope_own_fn(bi, name)
                if bk >= 0 {
                    return -2 - bk
                }
            }
        }
        return -1
    }

    // By synthesised name in the entry, by decl id in another module.
    func lookup_lambda(self, anon decl_id: int64) -> int64 {
        let si = self.cur_scope()
        if si < 0 {
            return self.lookup_func(self.p.func_decls[decl_id].name)
        }
        let s = self.scopes[si]
        if s.lambdas.get(f"{decl_id}") is Some(n) {
            let name = f"__lambda_{n}"
            if s.funcs.get(name) is Some(k) {
                return -2 - k
            }
            return -2 - self.add_scope_fn(si, name, decl_idx: -1, lambda_id: decl_id)
        }
        return -1
    }

    // For typo hints, in the current module.
    func visible_func_names(self) -> [str] {
        let si = self.cur_scope()
        if si < 0 {
            return self.func_names
        }
        mut names: [str] = []
        for n in self.scopes[si].names {
            names += [n]
        }
        if self.scope_idx.get(self.builtins_path) is Some(bi) {
            if bi != si {
                if self.scopes[bi].built == false {
                    self.build_scope(bi)
                }
                for n in self.scopes[bi].names {
                    names += [n]
                }
            }
        }
        return names
    }

    // In the current module: an import_fns index, scope_fns[k] as -2 - k, or -1.
    func lookup_import_fn(self, anon local_mod: str, anon name: str) -> int64 {
        let si = self.cur_scope()
        if si < 0 {
            return self.find_import_fn_idx(local_mod, name)
        }
        let ti = self.scope_alias_target(si, local_mod)
        if ti < 0 {
            return -1
        }
        let k = self.scope_own_fn(ti, name)
        if k >= 0 {
            return -2 - k
        }
        return -1
    }

    func import_fn_at(self, anon slot: int64) -> ImportFn {
        if slot >= 0 {
            return self.import_fns[slot]
        }
        return self.scope_fns[-2 - slot]
    }

    // For typo hints, in the current module.
    func import_fn_names(self, anon local_mod: str) -> [str] {
        mut names: [str] = []
        let si = self.cur_scope()
        if si < 0 {
            for f in self.import_fns {
                if f.module == local_mod {
                    names += [f.name]
                }
            }
            return names
        }
        let ti = self.scope_alias_target(si, local_mod)
        if ti >= 0 {
            for n in self.scopes[ti].names {
                names += [n]
            }
        }
        return names
    }

    func fn_label(self, anon slot: int64) -> str {
        if slot >= 0 {
            return self.func_labels[slot]
        }
        return self.scope_fns[-2 - slot].label
    }

    func fn_sig(self, anon slot: int64) -> SigInfo {
        if slot >= 0 {
            return self.func_sigs[slot]
        }
        return self.scope_fns[-2 - slot].sig
    }

    // -1 when no enum declares the variant, -2 when several do.
    func find_enum_with_variant(self, anon variant_name: str) -> int64 {
        let found = self.enums_with_variant(variant_name)
        if len(found) == 0 {
            return -1
        }
        if len(found) > 1 {
            return -2
        }
        return found[0]
    }

    // Templates only; the last copy of a twice-registered enum, as in find_enum_idx.
    func enums_with_variant(self, anon variant_name: str) -> [int64] {
        mut found: [int64] = []
        mut i = 0
        for i < len(self.enums) {
            if self.enums[i].template_idx < 0 and self.find_variant_idx(variant_name, enum_idx: i) >= 0 {
                mut seen = false
                mut k = 0
                for f in found {
                    if self.same_enum_decl(f, i) {
                        found[k] = i
                        seen = true
                    }
                    k += 1
                }
                if seen == false {
                    found += [i]
                }
            }
            i += 1
        }
        mut visible: [int64] = []
        for f in found {
            if self.enum_visible(f) {
                visible += [f]
            }
        }
        if len(visible) > 0 {
            return visible
        }
        return found
    }

    func same_enum_decl(self, anon a: int64, anon b: int64) -> bool {
        return self.enums[a].name == self.enums[b].name and self.enums[a].def_path == self.enums[b].def_path
    }

    // A module in an import cycle registers its types twice.
    func same_struct(self, anon a: int64, anon b: int64) -> bool {
        if a == b {
            return true
        }
        let sa = self.structs[a]
        let sb = self.structs[b]
        return len(sa.def_path) > 0 and sa.name == sb.name and sa.def_path == sb.def_path
    }

    func same_iface(self, anon a: int64, anon b: int64) -> bool {
        return a == b or (self.interfaces[a].name == self.interfaces[b].name and self.interfaces[a].def_path == self.interfaces[b].def_path)
    }

    // Declared by the module being compiled, a module it imports or the builtins.
    func enum_visible(self, anon idx: int64) -> bool {
        let path = self.enums[idx].def_path
        if path == self.p.path or path == self.builtins_path {
            return true
        }
        if self.p.path == self.entry_path {
            return regalloc.str_in(self.entry_import_paths, p: path)
        }
        let si = self.cur_scope()
        if si < 0 {
            return true
        }
        return regalloc.str_in(self.scopes[si].alias_paths, p: path)
    }

    // Once per statement: both sides of `.A(..) == .A(..)` would report it.
    func report_ambiguous_variant(self, anon variant_name: str, args: [ast.CallArg], span: ast.Span) -> none {
        if self.report_attempts > self.stmt_error_mark {
            return
        }
        let found = self.enums_with_variant(variant_name)
        // A cascade of a type clash: still an attempt, so the statement stays quiet.
        for f in found {
            if regalloc.str_in(self.clashed_types, p: self.enums[f].name) {
                self.report_attempts = self.report_attempts + 1
                return
            }
        }
        mut fitting: [int64] = []
        for f in found {
            if self.args_fit(args, enum_idx: f, variant_idx: self.find_variant_idx(variant_name, enum_idx: f)) {
                fitting += [f]
            }
        }
        if len(fitting) == 0 {
            fitting = found
        }
        mut pick = fitting[len(fitting) - 1]
        for f in fitting {
            if self.enums[f].def_path == self.p.path {
                pick = f
            }
        }
        let last = self.enum_written_name(found[len(found) - 1])
        mut names = f"`{self.enum_written_name(found[0])}`"
        mut i = 1
        for i < len(found) - 1 {
            names = f"{names}, `{self.enum_written_name(found[i])}`"
            i += 1
        }
        mut all = "all"
        if len(found) == 2 {
            all = "both"
        }
        mut advice = f"write `{self.enum_written_name(pick)}.{variant_name}` or give the value a type"
        if self.enum_visible(pick) == false {
            advice = "give the value a type"
        }
        self.report_error(f"error: `.{variant_name}` is ambiguous: {names} and `{last}` {all} declare it; {advice}", :span)
    }

    func enum_written_name(self, anon idx: int64) -> str {
        return self.written_type_name(self.enums[idx].name, def_path: self.enums[idx].def_path)
    }

    func written_type_name(self, anon name: str, def_path: str) -> str {
        if def_path == self.p.path or def_path == self.builtins_path {
            return name
        }
        let alias = self.import_alias_of(def_path)
        if len(alias) == 0 {
            return name
        }
        return f"{alias}.{name}"
    }

    func import_alias_of(self, anon path: str) -> str {
        mut aliases = self.import_local
        mut paths = self.entry_import_paths
        if self.p.path != self.entry_path {
            let si = self.cur_scope()
            if si < 0 {
                return ""
            }
            aliases = self.scopes[si].alias_names
            paths = self.scopes[si].alias_paths
        }
        mut i = 0
        for imported in paths {
            if imported == path {
                return aliases[i]
            }
            i += 1
        }
        return ""
    }

    // Extract the enum index from a TypeKind, or -1 if not an enum.
    func enum_idx_of_kind(self, anon kind: TypeKind) -> int64 {
        if kind is .KEnum(idx) {
            return idx
        }
        return -1
    }

    func find_variant_idx(self, anon variant_name: str, enum_idx: int64) -> int64 {
        mut j = 0
        for j < len(self.enums[enum_idx].variants) {
            if self.enums[enum_idx].variants[j].name == variant_name {
                return j
            }
            j = j + 1
        }
        return -1
    }

    // find_variant_idx, reporting an unknown variant at `span`.
    func check_variant(self, anon variant_name: str, enum_idx: int64, span: ast.Span) -> int64 {
        let variant_idx = self.find_variant_idx(variant_name, :enum_idx)
        if variant_idx < 0 {
            mut names: [str] = []
            for v in self.enums[enum_idx].variants {
                names += [v.name]
            }
            let msg: str = self.with_suggestion(f"error: enum `{self.enum_display_name(enum_idx)}` has no variant `{variant_name}`", typo: variant_name, candidates: names)
            self.report_error(msg, :span)
        }
        return variant_idx
    }

    func arg_noun(self, anon count: int64) -> str {
        if count == 1 {
            return "1 argument"
        }
        return f"{count} arguments"
    }

    func payload_noun(self, anon count: int64) -> str {
        if count == 1 {
            return "1 payload field"
        }
        return f"{count} payload fields"
    }

    // -1 after reporting, or for a subject that isn't an enum (check_pattern_subject reports it).
    func pattern_enum_idx(self, enum_name: str, variant_name: str, subj_enum_idx: int64, span: ast.Span) -> int64 {
        if subj_enum_idx < 0 {
            return -1
        }
        if len(enum_name) > 0 {
            let enum_idx = self.find_enum_idx(enum_name)
            if enum_idx < 0 {
                mut names: [str] = []
                for e in self.enums {
                    if e.template_idx < 0 {
                        names += [e.name]
                    }
                }
                self.report_error(self.with_suggestion(f"error: unknown enum `{enum_name}`", typo: enum_name, candidates: names), :span)
                return -1
            }
            if self.enums_compatible(subj_enum_idx, a_idx: enum_idx) == false {
                self.report_error(f"error: `{enum_name}.{variant_name}` is not a variant of `{self.enum_display_name(subj_enum_idx)}`", :span)
                return -1
            }
        }
        return subj_enum_idx
    }

    // -1 after reporting an unknown variant or too many bindings.
    func pattern_variant_idx(self, anon enum_idx: int64, variant_name: str, binding_count: int64, span: ast.Span) -> int64 {
        let variant_idx = self.check_variant(variant_name, :enum_idx, :span)
        if variant_idx < 0 {
            return -1
        }
        let field_count = len(self.enums[enum_idx].variants[variant_idx].field_offsets)
        if binding_count > field_count {
            self.report_error(f"error: `{self.enum_base_name(enum_idx)}.{variant_name}` has {self.payload_noun(field_count)}, pattern binds {binding_count}", :span)
            return -1
        }
        return variant_idx
    }

    // Labels are optional, but one must name the field in its position.
    func check_payload_args(self, anon args: [ast.CallArg], enum_idx: int64, variant_idx: int64, span: ast.Span) -> none {
        let vinfo = self.enums[enum_idx].variants[variant_idx]
        let shown: str = f"{self.enum_base_name(enum_idx)}.{vinfo.name}"
        let field_count = len(vinfo.field_names)
        if len(args) != field_count {
            self.report_error(f"error: `{shown}` has {self.payload_noun(field_count)}, got {len(args)}", :span)
        }
        mut i = 0
        for arg in args {
            if len(arg.label) > 0 and i < field_count {
                if arg.label != vinfo.field_names[i] {
                    mut known = false
                    for name in vinfo.field_names {
                        if name == arg.label {
                            known = true
                        }
                    }
                    if known {
                        self.report_error(f"error: `{shown}` takes its payload in declaration order: expected `{vinfo.field_names[i]}`, got `{arg.label}`", span: arg.label_span)
                    } else {
                        self.report_error(self.with_suggestion(f"error: `{shown}` has no payload field `{arg.label}`", typo: arg.label, candidates: vinfo.field_names), span: arg.label_span)
                    }
                }
            }
            i = i + 1
        }
    }

    func find_field_offset(self, anon field_name: str, struct_idx: int64) -> int64 {
        mut j = 0
        for j < len(self.structs[struct_idx].fields) {
            if self.structs[struct_idx].fields[j].name == field_name {
                return self.structs[struct_idx].fields[j].offset
            }
            j = j + 1
        }
        return 0
    }

    func has_field(self, anon field_name: str, struct_idx: int64) -> bool {
        for f in self.structs[struct_idx].fields {
            if f.name == field_name {
                return true
            }
        }
        return false
    }

    // has_field, reporting an unknown field at `span`.
    func check_field(self, anon field_name: str, struct_idx: int64, span: ast.Span) -> bool {
        if self.has_field(field_name, :struct_idx) {
            return true
        }
        mut field_names: [str] = []
        for f in self.structs[struct_idx].fields {
            field_names += [f.name]
        }
        let msg: str = self.with_suggestion(f"error: struct `{self.struct_display_name(struct_idx)}` has no field `{field_name}`", typo: field_name, candidates: field_names)
        self.report_error(msg, :span)
        return false
    }

    func report_field_on_non_struct(self, anon field_name: str, kind: TypeKind, span: ast.Span, optional_hint: str) -> none {
        if self.kind_has_unknown(kind) {
            return
        }
        mut msg: str = f"error: cannot access field `{field_name}` on a value of type `{self.kind_display(kind)}`"
        if kind is .KOptional(_inner) {
            msg = msg + optional_hint
        }
        self.report_error(msg, :span)
    }


    // Canonical, label-safe string representation of a TypeKind. Used to
    // build mangled names for monomorphised structs and their methods so
    // that e.g. Map[str, str] becomes the struct/label suffix `Map$str$str`.
    // Human-readable rendering of a TypeKind for user-facing output
    // (hover, error messages). Inverse of how the source-side syntax
    // declares the type — `[str]` for KArrayStr, `T?` for KOptional, etc.
    // Distinct from `canonical_kind_name`, which uses `$`-separated
    // mangled forms for assembly symbol names.
    func kind_display(self, anon kind: TypeKind) -> str {
        if self.is_none_kind(kind) {
            return "none"
        }
        match kind {
            .KVoid -> return "none"
            .KInt64 -> return "int64"
            .KBool -> return "bool"
            .KStr -> return "str"
            .KBytes -> return "bytes"
            .KArray -> return "[int64]"
            .KArrayStr -> return "[str]"
            .KArrayBytes -> return "[bytes]"
            .KArrayStruct(elem_idx) -> return f"[{self.struct_display_name(elem_idx)}]"
            .KArrayEnum(elem_idx) -> return f"[{self.enum_display_name(elem_idx)}]"
            .KArrayInterface(elem_idx) -> return f"[{self.interfaces[elem_idx].name}]"
            .KArrayOptional(inner_kind) -> return f"[{self.kind_display(inner_kind)}?]"
            .KEnum(idx) -> return self.enum_display_name(idx)
            .KInterface(idx) -> return self.interfaces[idx].name
            .KOptional(inner) -> return f"{self.kind_display(inner)}?"
            .KStruct(idx, type_args) -> {
                let base: str = self.structs[idx].name
                if len(type_args) == 0 {
                    return self.struct_display_name(idx)
                }
                mut result: str = f"{base}["
                mut i: int64 = 0
                for i < len(type_args) {
                    if i > 0 {
                        result = result + ", "
                    }
                    result = result + self.kind_display(type_args[i])
                    i = i + 1
                }
                return f"{result}]"
            }
            .KFunc(param_kinds, return_kind) -> {
                mut result: str = "func("
                mut i: int64 = 0
                for i < len(param_kinds) {
                    if i > 0 {
                        result = result + ", "
                    }
                    result = result + self.kind_display(param_kinds[i])
                    i = i + 1
                }
                return f"{result}) -> {self.kind_display(return_kind)}"
            }
            .KArrayFunc(param_kinds, return_kind) -> {
                return f"[{self.kind_display(.KFunc(:param_kinds, :return_kind))}]"
            }
            .KUnknown -> return "<unknown>"
            .KArrayBool -> return "[bool]"
            .KArrayArray(inner) -> return f"[{self.kind_display(inner)}]"
        }
    }

    // A generic instance reads as `Map[str, int64]`, not its mangled name.
    func struct_display_name(self, anon idx: int64) -> str {
        let info = self.structs[idx]
        if info.template_idx < 0 {
            return info.name
        }
        return self.instance_display(self.structs[info.template_idx].name, args: info.template_args)
    }

    func enum_display_name(self, anon idx: int64) -> str {
        let info = self.enums[idx]
        if info.template_idx < 0 {
            return info.name
        }
        if self.is_result_enum_idx(idx) and len(info.template_args) == 2 {
            if self.kind_display(info.template_args[1]) == "Error" {
                return f"{self.kind_display(info.template_args[0])} or Error"
            }
        }
        return self.instance_display(self.enums[info.template_idx].name, args: info.template_args)
    }

    // `Maybe` for `Maybe[int64]`: how a variant is spelled in source.
    func enum_base_name(self, anon idx: int64) -> str {
        let info = self.enums[idx]
        if info.template_idx < 0 {
            return info.name
        }
        return self.enums[info.template_idx].name
    }

    func instance_display(self, anon base: str, args: [TypeKind]) -> str {
        mut result: str = f"{base}["
        mut first = true
        for a in args {
            if first == false {
                result = result + ", "
            }
            result = result + self.kind_display(a)
            first = false
        }
        return f"{result}]"
    }

    // `type Name = struct { field: kind, ... }` — for hover on a
    // struct type name. Methods are intentionally elided to keep the
    // tooltip short; users can jump to the source for the full body.
    func struct_display(self, anon idx: int64) -> str {
        mut s: StructInfo = self.structs[idx]
        // Concatenate the `{` rather than embed in an f-string —
        // Kod's f-string parser has no brace escape today.
        mut result: str = f"type {s.name} = struct " + "{"
        mut i: int64 = 0
        for i < len(s.fields) {
            if i == 0 {
                result = result + " "
            } else {
                result = result + ", "
            }
            result = result + f"{s.fields[i].name}: {self.kind_display(s.fields[i].kind)}"
            i = i + 1
        }
        if len(s.fields) > 0 {
            result = result + " "
        }
        return result + "}"
    }

    // `type Name = enum { Variant, Variant(field: kind), ... }`.
    func enum_display(self, anon idx: int64) -> str {
        mut e: EnumInfo = self.enums[idx]
        mut result: str = f"type {e.name} = enum " + "{"
        mut i: int64 = 0
        for i < len(e.variants) {
            let v: VariantInfo = e.variants[i]
            if i == 0 {
                result = result + " "
            } else {
                result = result + ", "
            }
            result = result + v.name
            if len(v.field_names) > 0 {
                result = result + "("
                mut j: int64 = 0
                for j < len(v.field_names) {
                    if j > 0 {
                        result = result + ", "
                    }
                    result = result + f"{v.field_names[j]}: {self.kind_display(v.field_kinds[j])}"
                    j = j + 1
                }
                result = result + ")"
            }
            i = i + 1
        }
        if len(e.variants) > 0 {
            result = result + " "
        }
        return result + "}"
    }

    // `func name(label: T, anon name: T, ...) -> Ret` — for hover.
    // Mirrors the Kod source syntax so an `anon` param shows its
    // binding name (`anon path: str`), not just its position.
    func func_signature_display(self, name: str, sig: SigInfo) -> str {
        mut result: str = f"func {name}("
        mut i: int64 = 0
        for i < len(sig.param_labels) {
            if i > 0 {
                result = result + ", "
            }
            let label: str = sig.param_labels[i]
            mut pname: str = ""
            if i < len(sig.param_names) {
                pname = sig.param_names[i]
            }
            if len(label) == 0 {
                if len(pname) > 0 {
                    result = result + f"anon {pname}: {self.kind_display(sig.param_kinds[i])}"
                } else {
                    result = result + f"anon: {self.kind_display(sig.param_kinds[i])}"
                }
            } else {
                result = result + f"{label}: {self.kind_display(sig.param_kinds[i])}"
            }
            i = i + 1
        }
        return f"{result}) -> {self.kind_display(sig.return_kind)}"
    }

    func canonical_kind_name(self, anon kind: TypeKind) -> str {
        match kind {
            .KVoid -> return "void"
            .KInt64 -> return "int64"
            .KBool -> return "bool"
            .KStr -> return "str"
            .KBytes -> return "bytes"
            .KArray -> return "arr"
            .KArrayStr -> return "arrstr"
            .KArrayBytes -> return "arrbytes"
            .KArrayStruct(elem_idx) -> return f"arrstruct${self.structs[elem_idx].name}"
            .KArrayEnum(elem_idx) -> return f"arrenum${self.enums[elem_idx].name}"
            .KArrayInterface(elem_idx) -> return f"arriface${self.interfaces[elem_idx].name}"
            .KArrayOptional(inner_kind) -> return f"arropt${self.canonical_kind_name(inner_kind)}"
            .KEnum(idx) -> return self.enums[idx].name
            .KInterface(idx) -> return self.interfaces[idx].name
            .KOptional(inner) -> return f"opt${self.canonical_kind_name(inner)}"
            .KStruct(idx, type_args) -> {
                mut name = self.structs[idx].name
                for ta in type_args {
                    name = f"{name}${self.canonical_kind_name(ta)}"
                }
                return name
            }
            .KFunc(param_kinds, return_kind) -> {
                mut name: str = "func"
                for pk in param_kinds {
                    name = f"{name}${self.canonical_kind_name(pk)}"
                }
                return f"{name}$ret${self.canonical_kind_name(return_kind)}"
            }
            .KArrayFunc(param_kinds, return_kind) -> {
                return f"arr${self.canonical_kind_name(.KFunc(:param_kinds, :return_kind))}"
            }
            .KUnknown -> return "unknown"
            .KArrayBool -> return "arrbool"
            .KArrayArray(inner) -> return f"arrarr${self.canonical_kind_name(inner)}"
        }
    }

    // Return the struct_idx for a concrete instantiation of `template_idx`
    // with `type_args`, creating a new monomorphised struct entry if it
    // doesn't already exist. The new entry shares the template's method
    // func_decls but has substituted field kinds and method sigs.
    func instantiate_struct(self, anon type_args: [TypeKind], template_idx: int64, arg_spans: [ast.Span], whole: ast.Span) -> int64 {
        for ta in type_args {
            if self.kind_has_unknown(ta) {
                return template_idx
            }
        }
        let template = self.structs[template_idx]
        mut canonical = template.name
        for ta in type_args {
            canonical = f"{canonical}${self.canonical_kind_name(ta)}"
        }
        let existing = self.find_struct_idx(canonical)
        if existing >= 0 {
            return existing
        }
        let empty_params: [str] = []
        // Registered before its fields and sigs resolve, so a self-reference finds it.
        self.structs += [StructInfo(name: canonical, fields: template.fields, methods: template.methods, method_idx: template.method_idx, data_width: template.data_width, module_prefix: self.path_prefix, src_p: template.src_p, type_param_names: empty_params, :template_idx, template_args: type_args, def_path: "", def_span: ast.Span(start: 0))]
        let new_idx: int64 = len(self.structs) - 1
        self.struct_idx.set(canonical, new_idx)
        self.note_bad_key(new_idx)
        let saved_names = self.subst_names
        let saved_args = self.subst_args
        let saved_p = self.p
        self.subst_names = template.type_param_names
        self.subst_args = type_args
        self.p = template.src_p
        self.inst_depth += 1
        mut cloned_fields: [FieldInfo] = []
        for field in template.fields {
            let new_kind = self.resolve_type(field.type_expr)
            cloned_fields += [FieldInfo(name: field.name, offset: field.offset, kind: new_kind, type_expr: field.type_expr, default_expr: field.default_expr)]
        }
        self.structs[new_idx].fields = cloned_fields
        // Re-resolve each method's sig with the new substitution context.
        self.structs[new_idx].methods = self.resolve_method_infos(template.methods, p: template.src_p)
        self.inst_depth -= 1
        self.p = saved_p
        self.subst_names = saved_names
        self.subst_args = saved_args
        if self.inst_depth == 0 {
            self.report_bad_keys(new_idx, shown: self.struct_display_name(new_idx), args: type_args, :arg_spans, :whole)
        }
        return new_idx
    }


    // Inside a specialised method, type params map through the substitution context.
    func resolve_type_name(self, anon name: str) -> TypeKind {
        mut si = 0
        for si < len(self.subst_names) {
            if self.subst_names[si] == name {
                return self.subst_args[si]
            }
            si = si + 1
        }
        if name == "int64" {
            return .KInt64
        }
        if name == "bool" {
            return .KBool
        }
        if name == "str" {
            return .KStr
        }
        if name == "bytes" {
            return .KBytes
        }
        if name == "none" {
            return .KVoid
        }
        if self.alias_idx.get(name) is Some(alias_i) {
            if alias_i >= 0 {
                return self.alias_kinds[alias_i]
            }
        }
        let enum_idx = self.find_enum_idx(name)
        if enum_idx >= 0 {
            return .KEnum(idx: enum_idx)
        }
        let struct_idx = self.find_struct_idx(name)
        if struct_idx >= 0 {
            return .KStruct(idx: struct_idx, type_args: [])
        }
        let iface_idx = self.find_iface_idx(name)
        if iface_idx >= 0 {
            return .KInterface(idx: iface_idx)
        }
        return .KUnknown
    }

    // The kind of an array whose elements have kind `elem`.
    func array_kind_of(self, anon elem: TypeKind) -> TypeKind {
        if self.is_array_kind(elem) {
            return .KArrayArray(inner: elem)
        }
        match elem {
            .KBool -> return .KArrayBool
            .KStruct(struct_idx, _struct_type_args) -> return .KArrayStruct(elem_idx: struct_idx)
            .KEnum(enum_idx) -> return .KArrayEnum(elem_idx: enum_idx)
            .KStr -> return .KArrayStr
            .KBytes -> return .KArrayBytes
            .KInterface(iface_idx) -> return .KArrayInterface(elem_idx: iface_idx)
            .KOptional(inner_kind) -> return .KArrayOptional(inner: inner_kind)
            .KFunc(param_kinds, return_kind) -> return .KArrayFunc(:param_kinds, :return_kind)
            .KUnknown -> return .KUnknown
            else return .KArray
        }
    }

    func type_arg_spans(self, anon arg_ids: [int64]) -> [ast.Span] {
        mut spans: [ast.Span] = []
        for arg_id in arg_ids {
            spans += [self.p.type_spans[arg_id]]
        }
        return spans
    }

    func resolve_type(self, anon type_id: int64) -> TypeKind {
        if type_id == 0 {
            return .KVoid
        }
        match self.p.type_exprs[type_id] {
            .Named(name) -> return self.resolve_type_name(name)
            .Array(inner) -> return self.array_kind_of(self.resolve_type(inner))
            .Optional(inner) -> {
                let inner_kind = self.resolve_type(inner)
                if inner_kind is .KUnknown {
                    return .KUnknown
                }
                return .KOptional(inner: inner_kind)
            }
            .Func(params, return_typ) -> {
                mut pkinds: [TypeKind] = []
                for p in params {
                    pkinds += [self.resolve_type(p)]
                }
                return .KFunc(param_kinds: pkinds, return_kind: self.resolve_type(return_typ))
            }
            .Generic(name, args) -> {
                // Generic instantiation. Monomorphise the template struct
                // into a fresh concrete entry (Map[str, str] → struct
                // `Map$str$str`) so all downstream lookups read substituted
                // types directly from the new entry.
                // A wrong type-argument count is reported by check_type_expr.
                let struct_idx = self.find_struct_idx(name)
                if struct_idx >= 0 {
                    let param_count = len(self.structs[struct_idx].type_param_names)
                    if param_count == 0 {
                        return .KStruct(idx: struct_idx, type_args: [])
                    }
                    if param_count != len(args) {
                        return .KUnknown
                    }
                    mut resolved: [TypeKind] = []
                    for arg in args {
                        let arg_kind = self.resolve_type(arg)
                        if self.kind_has_unknown(arg_kind) {
                            return .KUnknown
                        }
                        resolved += [arg_kind]
                    }
                    let inst_idx = self.instantiate_struct(resolved, template_idx: struct_idx, arg_spans: self.type_arg_spans(args), whole: self.p.type_spans[type_id])
                    return .KStruct(idx: inst_idx, type_args: [])
                }
                let enum_idx = self.find_enum_idx(name)
                if enum_idx >= 0 {
                    let param_count = len(self.enums[enum_idx].type_param_names)
                    if param_count == 0 {
                        return .KEnum(idx: enum_idx)
                    }
                    if param_count != len(args) {
                        return .KUnknown
                    }
                    mut resolved: [TypeKind] = []
                    for arg in args {
                        let arg_kind = self.resolve_type(arg)
                        if self.kind_has_unknown(arg_kind) {
                            return .KUnknown
                        }
                        resolved += [arg_kind]
                    }
                    let inst_idx = self.instantiate_enum(resolved, template_idx: enum_idx, arg_spans: self.type_arg_spans(args), whole: self.p.type_spans[type_id])
                    return .KEnum(idx: inst_idx)
                }
                return .KUnknown
            }
        }
    }

    // Instantiate a generic enum template with `type_args`, creating a new
    // monomorphised enum entry if it doesn't already exist. Mirrors
    // instantiate_struct: variant field type_exprs are re-resolved under the
    // template's substitution context so K/V in `Some(T)` become the concrete
    // kinds. Canonical name is `Template$arg1$arg2` to match struct mangling.
    func instantiate_enum(self, anon type_args: [TypeKind], template_idx: int64, arg_spans: [ast.Span], whole: ast.Span) -> int64 {
        for ta in type_args {
            if self.kind_has_unknown(ta) {
                return template_idx
            }
        }
        let template = self.enums[template_idx]
        mut canonical = template.name
        for ta in type_args {
            canonical = f"{canonical}${self.canonical_kind_name(ta)}"
        }
        let existing = self.find_enum_idx(canonical)
        if existing >= 0 {
            return existing
        }
        let empty_params: [str] = []
        self.enums += [EnumInfo(name: canonical, variants: template.variants, data_width: template.data_width, module_prefix: self.path_prefix, src_p: template.src_p, def_path: "", def_span: ast.Span(start: 0), type_param_names: empty_params, :template_idx, template_args: type_args)]
        let new_idx: int64 = len(self.enums) - 1
        self.enum_idx.set(canonical, new_idx)
        let saved_names = self.subst_names
        let saved_args = self.subst_args
        let saved_p = self.p
        self.subst_names = template.type_param_names
        self.subst_args = type_args
        self.p = template.src_p
        self.inst_depth += 1
        mut new_variants: [VariantInfo] = []
        for v in template.variants {
            mut new_kinds: [TypeKind] = []
            mut j: int64 = 0
            for j < len(v.field_type_exprs) {
                new_kinds += [self.resolve_type(v.field_type_exprs[j])]
                j = j + 1
            }
            new_variants += [VariantInfo(name: v.name, discriminant: v.discriminant, field_names: v.field_names, field_offsets: v.field_offsets, field_kinds: new_kinds, field_type_exprs: v.field_type_exprs)]
        }
        self.enums[new_idx].variants = new_variants
        self.inst_depth -= 1
        self.p = saved_p
        self.subst_names = saved_names
        self.subst_args = saved_args
        if self.inst_depth == 0 {
            self.report_bad_keys(-1, shown: self.enum_display_name(new_idx), args: type_args, :arg_spans, :whole)
        }
        return new_idx
    }


    func resolve_method_infos(self, anon methods: [MethodInfo], p: parsing.Parser) -> [MethodInfo] {
        mut out: [MethodInfo] = []
        for m in methods {
            out += [MethodInfo(name: m.name, decl_id: m.decl_id, sig: self.resolve_sig(m.decl_id, :p))]
        }
        return out
    }

    // Resolve the params and return type of `p.func_decls[decl_id]` into a
    // SigInfo, using p as the owning parser (the type_expr arena ids in the
    // FuncDecl point into p.type_exprs). Type *names* are still looked up in
    // self's own registered tables — they must have been registered via
    // register_module_types beforehand.
    func resolve_sig(self, anon decl_id: int64, p: parsing.Parser) -> SigInfo {
        let func_decl = p.func_decls[decl_id]
        let saved_p = self.p
        self.p = p
        mut param_kinds: [TypeKind] = []
        mut param_labels: [str] = []
        mut param_names: [str] = []
        mut param_default_exprs: [int64] = []
        for param in func_decl.params {
            param_kinds += [self.resolve_type(param.typ)]
            if param.anonymous {
                param_labels += [""]
            } else {
                param_labels += [param.label]
            }
            param_names += [param.name]
            param_default_exprs += [param.default_expr]
        }
        let return_kind = self.resolve_type(func_decl.return_typ)
        self.p = saved_p
        return SigInfo(:param_kinds, :param_labels, :param_names, :return_kind, :param_default_exprs, src_p: p, :decl_id)
    }

    // Dead code after a `return` doesn't count.
    func block_completes(self, anon stmts: [int64]) -> bool {
        return self.block_flow(stmts).completes
    }

    // Both answers in one walk, so a nested `for true` body is walked once per level.
    func block_flow(self, anon stmts: [int64]) -> Flow {
        let mark = len(self.bound_log)
        let flow = Flow(completes: true, breaks: false)
        for stmt_id in stmts {
            let f = self.stmt_flow(stmt_id)
            if f.breaks {
                flow.breaks = true
            }
            if f.completes == false {
                flow.completes = false
                break
            }
            self.bind_stmt_names(stmt_id)
        }
        self.unbind_to(mark)
        return flow
    }

    // What a statement binds for the rest of its block.
    func bind_stmt_names(self, anon stmt_id: int64) -> none {
        match self.p.stmts[stmt_id] {
            .Let(name, _typ, _value, _mutable) -> self.bind_var(name)
            .LetElse(pattern, _value, _else_body) -> self.bind_pattern(self.p.patterns[pattern])
            else none
        }
    }

    func arm_flow(self, anon arm_id: int64) -> Flow {
        let arm = self.p.match_arms[arm_id]
        let mark = len(self.bound_log)
        self.bind_pattern(self.p.patterns[arm.pattern])
        let flow = self.block_flow(arm.body)
        self.unbind_to(mark)
        return flow
    }

    // `breaks` is for a `break` that leaves the enclosing loop, not one nested here.
    func stmt_flow(self, anon stmt_id: int64) -> Flow {
        match self.p.stmts[stmt_id] {
            .Return(_value) -> return Flow(completes: false, breaks: false)
            .Throw(_value) -> return Flow(completes: false, breaks: false)
            .Break -> return Flow(completes: false, breaks: true)
            .Continue -> return Flow(completes: false, breaks: false)
            .ExprStmt(expr) -> {
                self.trust_why = ""
                self.last_nr_key = ""
                let diverges = self.is_diverging_call(expr)
                if diverges and self.trust_locals and self.deciding_depth > 0 {
                    self.note_trust_end(expr)
                }
                return Flow(completes: diverges == false, breaks: false)
            }
            .If(_cond, then_body, else_body) -> return either_flow(self.block_flow(then_body), self.block_flow(else_body))
            // A match statement is exhaustive, so it completes only through an arm.
            .MatchStmt(_subject, arms) -> {
                mut flow = Flow(completes: len(arms) == 0, breaks: false)
                for arm_id in arms {
                    flow = either_flow(flow, self.arm_flow(arm_id))
                }
                return flow
            }
            .For(cond, body) -> {
                mut forever = cond == 0
                if cond != 0 {
                    if self.p.exprs[cond] is .BoolLit(value) {
                        forever = value
                    }
                }
                return Flow(completes: forever == false or self.block_flow(body).breaks, breaks: false)
            }
            .LetElse(_pattern, _value, else_body) -> return Flow(completes: true, breaks: self.block_flow(else_body).breaks)
            else return Flow(completes: true, breaks: false)
        }
    }

    // Running off the end returns 0, which is only right as an optional's `none`.
    func check_reaches_end(self, anon func_decl: ast.FuncDecl, struct_name: str) -> none {
        let kind = self.return_kind
        if self.is_void_kind(kind) or self.kind_has_unknown(kind) or self.walk_completes(func_decl.body) == false {
            return
        }
        if self.is_result_kind(kind) and self.is_void_kind(self.result_inner_kind(kind)) {
            return
        }
        mut name = f"`{func_decl.name}`"
        if len(struct_name) > 0 {
            mut owner = struct_name
            let idx = self.find_struct_idx(struct_name)
            if idx >= 0 and self.structs[idx].template_idx >= 0 {
                owner = self.structs[self.structs[idx].template_idx].name
            }
            name = f"`{owner}.{func_decl.name}`"
        } else if func_decl.name.contains("__lambda_") {
            name = "this function literal"
        }
        mut fix = "(or a `kod_panic(...)`)"
        if kind is .KOptional(_inner) {
            fix = "(`return none` for no value)"
        }
        self.report_error(f"error: {name} can reach its end without returning a value; it returns `{self.kind_display(kind)}`, so add a `return` {fix} at the end{self.end_hint(func_decl.body)}", span: func_decl.name_span)
    }

    // Why a body that ends in a call that may not return is taken to finish.
    func end_hint(self, anon body: [int64]) -> str {
        if len(body) == 0 {
            return ""
        }
        let .ExprStmt(expr) = self.p.stmts[body[-1]] else { return "" }
        if (self.p.exprs[expr] is .Call(_callee, _args)) == false {
            return ""
        }
        let mark = len(self.bound_log)
        for stmt_id in body[0..len(body) - 1] {
            self.bind_stmt_names(stmt_id)
        }
        let hint = self.end_call_hint(expr)
        self.unbind_to(mark)
        return hint
    }

    func end_call_hint(self, anon expr: int64) -> str {
        let at = f"`{call_text(self.p, expr)}` (line {self.line_of_offset(self.p.expr_spans[expr].start)})"
        if self.is_iface_method_call(expr) {
            return f"; {at} is a method called through an interface value, which is taken to return"
        }
        if self.is_diverging_call(expr) {
            return f"; {at} is a call through a local, which counts as returning until blocks get scopes"
        }
        let site = self.trusted_site(expr)
        if len(site) == 0 {
            return ""
        }
        return f"; {at} is taken to return, as {site}"
    }

    func block_has_return(self, anon stmts: [int64]) -> bool {
        for stmt_id in stmts {
            match self.p.stmts[stmt_id] {
                .Return(_value) -> return true
                .If(_cond, then_body, else_body) -> {
                    if self.block_has_return(then_body) or self.block_has_return(else_body) {
                        return true
                    }
                }
                .For(_cond, body) -> {
                    if self.block_has_return(body) {
                        return true
                    }
                }
                .ForEach(_name, _iter, body) -> {
                    if self.block_has_return(body) {
                        return true
                    }
                }
                .MatchStmt(_subject, arms) -> {
                    for arm_id in arms {
                        if self.block_has_return(self.p.match_arms[arm_id].body) {
                            return true
                        }
                    }
                }
                .LetElse(_pattern, _value, else_body) -> {
                    if self.block_has_return(else_body) {
                        return true
                    }
                }
                else none
            }
        }
        return false
    }

    // Same as resolve_sig but for an Extern decl, whose params/return_typ
    // are inlined in the Decl variant rather than wrapped in a FuncDecl.
    func resolve_extern_sig(self, anon params: [ast.Param], return_typ: int64, p: parsing.Parser) -> SigInfo {
        let saved_p = self.p
        self.p = p
        mut param_kinds: [TypeKind] = []
        mut param_labels: [str] = []
        mut param_names: [str] = []
        mut param_default_exprs: [int64] = []
        for param in params {
            param_kinds += [self.resolve_type(param.typ)]
            if param.anonymous {
                param_labels += [""]
            } else {
                param_labels += [param.label]
            }
            param_names += [param.name]
            param_default_exprs += [param.default_expr]
        }
        let return_kind = self.resolve_type(return_typ)
        self.p = saved_p
        return SigInfo(:param_kinds, :param_labels, :param_names, :return_kind, :param_default_exprs, src_p: p)
    }


    func emit_ldr(self, anon offset: int64, reg: str) -> none {
        if offset >= 0 {
            self.emit(f"ldr {reg}, [fp]")
            return
        }
        if offset >= -256 {
            self.emit(f"ldr {reg}, [fp, #{offset}]")
            return
        }
        // Out of immediate range — materialise the negative offset first.
        self.emit_load_imm("x16", value: 0 - offset)
        self.emit(f"sub x16, fp, x16")
        self.emit(f"ldr {reg}, [x16]")
    }

    func emit_str(self, anon offset: int64, reg: str) -> none {
        if offset >= 0 {
            self.emit(f"str {reg}, [fp]")
            return
        }
        if offset >= -256 {
            self.emit(f"str {reg}, [fp, #{offset}]")
            return
        }
        self.emit_load_imm("x16", value: 0 - offset)
        self.emit(f"sub x16, fp, x16")
        self.emit(f"str {reg}, [x16]")
    }


    // Types are found by name alone, so two modules can't both declare one yet.
    func note_type_decl(self, anon name: str, p: parsing.Parser, span: ast.Span, alias_of: str = "") -> none {
        if self.type_paths.get(name) is Some(first) {
            if first == p.path {
                return
            }
            // Aliases of one type resolve alike wherever the name is looked up.
            if len(alias_of) > 0 {
                if self.alias_shapes.get(name) is Some(shape) {
                    if shape == alias_of {
                        return
                    }
                }
            }
            self.clashed_types += [name]
            mut hint = "so rename one of them"
            if is_test_file(first) and is_test_file(p.path) {
                hint = "and `kod test` on a directory builds its test files into one program, so rename one or test the files one at a time"
            }
            let saved_p = self.p
            self.p = p
            self.report_error(f"error: type `{name}` is also declared in {first}; the modules of a program share type names for now, {hint}", :span)
            self.p = saved_p
            return
        }
        self.type_paths.set(name, p.path)
        if len(alias_of) > 0 {
            self.alias_shapes.set(name, alias_of)
        }
    }

    func register_enum(self, anon decl: ast.Decl, prefix: str, p: parsing.Parser) -> none {
        match decl {
            .Enum(name, name_span, type_params, variants) -> {
                self.note_type_decl(name, :p, span: name_span)
                let saved_p = self.p
                self.p = p
                let saved_names = self.subst_names
                let saved_args = self.subst_args
                self.bind_type_params_unknown(type_params)
                mut variant_infos: [VariantInfo] = []
                // Discriminants start at 1, not 0. Disc 0 is reserved
                // globally as the "None" sentinel for nullable contexts
                // (`T?` where T is an enum can reuse T's cell layout with
                // disc 0 meaning none). See union-design memory.
                mut disc = 1
                mut max_payload = 0
                for variant in variants {
                    mut field_names: [str] = []
                    mut field_offsets: [int64] = []
                    mut field_kinds: [TypeKind] = []
                    mut field_type_exprs: [int64] = []
                    mut j = 0
                    for j < len(variant.fields) {
                        field_names += [variant.fields[j].name]
                        field_offsets += [j * 8]
                        field_kinds += [self.resolve_type(variant.fields[j].typ)]
                        field_type_exprs += [variant.fields[j].typ]
                        j = j + 1
                    }
                    let payload = len(variant.fields) * 8
                    if payload > max_payload {
                        max_payload = payload
                    }
                    variant_infos += [VariantInfo(name: variant.name, discriminant: disc, :field_names, :field_offsets, :field_kinds, :field_type_exprs)]
                    disc = disc + 1
                }
                self.p = saved_p
                self.subst_names = saved_names
                self.subst_args = saved_args
                let data_width = 8 + max_payload
                let no_template_args: [TypeKind] = []
                self.enums += [EnumInfo(:name, variants: variant_infos, :data_width, module_prefix: prefix, src_p: p, def_path: p.path, def_span: name_span, type_param_names: type_params, template_idx: -1, template_args: no_template_args)]
                self.enum_idx.set(name, len(self.enums) - 1)
                self.drop_alias(name)
            }
            else none
        }
    }

    // A template's own type parameters have no kind until it's instantiated.
    func bind_type_params_unknown(self, anon type_params: [str]) -> none {
        if len(type_params) == 0 {
            return
        }
        mut args: [TypeKind] = []
        for _tp in type_params {
            args += [.KUnknown]
        }
        self.subst_names = type_params
        self.subst_args = args
    }

    func register_struct(self, anon decl: ast.Decl, prefix: str, p: parsing.Parser) -> none {
        match decl {
            .Struct(name, name_span, type_params, fields, methods) -> {
                self.note_type_decl(name, :p, span: name_span)
                mut field_infos: [FieldInfo] = []
                mut offset = 0
                // Temporarily swap parser so resolve_type reads field type
                // expressions from p (the source module's parser), not self.p.
                let saved_p = self.p
                self.p = p
                let saved_names = self.subst_names
                let saved_args = self.subst_args
                self.bind_type_params_unknown(type_params)
                for field in fields {
                    mut field_kind = self.resolve_type(field.typ)
                    field_infos += [FieldInfo(name: field.name, :offset, kind: field_kind, type_expr: field.typ, default_expr: field.default_expr)]
                    offset = offset + 8
                }
                // Restore parser before resolve_sig (which swaps to p
                // internally). One pass: append the fully-built MethodInfo
                // and record its position in method_idx in the same step.
                self.p = saved_p
                mut method_idx: FuncIdx = FuncIdx()
                mut method_infos: [MethodInfo] = []
                mut mi: int64 = 0
                for method_id in methods {
                    let func_decl = p.func_decls[method_id]
                    let sig = self.resolve_sig(method_id, :p)
                    method_infos += [MethodInfo(name: func_decl.name, decl_id: method_id, :sig)]
                    method_idx.set(func_decl.name, mi)
                    mi = mi + 1
                }
                self.subst_names = saved_names
                self.subst_args = saved_args
                let no_template_args: [TypeKind] = []
                self.structs += [StructInfo(:name, fields: field_infos, methods: method_infos, :method_idx, data_width: offset, module_prefix: prefix, src_p: p, type_param_names: type_params, template_idx: -1, template_args: no_template_args, def_path: p.path, def_span: name_span)]
                self.struct_idx.set(name, len(self.structs) - 1)
                self.drop_alias(name)
            }
            else none
        }
    }

    // First pass: register interface NAME so it's findable by name during
    // struct method sig resolution. Method sigs are left empty for now; a
    // second pass (resolve_interface_methods) fills them in once all types
    // are registered.
    func register_interface(self, anon decl: ast.Decl, prefix: str, p: parsing.Parser) -> none {
        match decl {
            .Interface(name, name_span, methods) -> {
                self.note_type_decl(name, :p, span: name_span)
                let empty_kinds: [TypeKind] = []
                let empty_strs: [str] = []
                let empty_defaults: [int64] = []
                let empty_sig: SigInfo = SigInfo(param_kinds: empty_kinds, param_labels: empty_strs, param_names: empty_strs, return_kind: .KVoid, param_default_exprs: empty_defaults, src_p: p)
                mut method_infos: [MethodInfo] = []
                for method_id in methods {
                    let func_decl = p.func_decls[method_id]
                    // decl_id is -1 for interface methods (they don't carry
                    // a concrete FuncDecl id beyond the parse). Sig is left
                    // empty here; resolve_interface_methods fills it in a
                    // second pass once all types are registered.
                    method_infos += [MethodInfo(name: func_decl.name, decl_id: -1, sig: empty_sig)]
                }
                self.interfaces += [IfaceInfo(:name, methods: method_infos, module_prefix: prefix, def_path: p.path, def_span: name_span, src_p: p, method_decl_ids: methods)]
                self.iface_idx.set(name, len(self.interfaces) - 1)
                self.drop_alias(name)
            }
            else none
        }
    }

    // Second pass: resolve method signatures for an interface declaration
    // once all types are registered, then write the fully-populated
    // MethodInfo array onto the existing IfaceInfo.
    func resolve_interface_methods(self, anon decl: ast.Decl, p: parsing.Parser) -> none {
        match decl {
            .Interface(name, name_span, methods) -> {
                let iface_idx = self.find_iface_idx(name)
                if iface_idx >= 0 {
                    mut new_methods: [MethodInfo] = []
                    for method_id in methods {
                        let sig = self.resolve_sig(method_id, :p)
                        new_methods += [MethodInfo(name: p.func_decls[method_id].name, decl_id: -1, :sig)]
                    }
                    self.interfaces[iface_idx].methods = new_methods
                }
            }
            else none
        }
    }

    // Repeats so an alias can name a later alias; `p` owns the target type_expr ids.
    func register_type_aliases(self, anon module: ast.Module, p: parsing.Parser) -> none {
        let saved_p = self.p
        self.p = p
        mut names: [str] = []
        mut targets: [int64] = []
        mut spans: [ast.Span] = []
        for decl in module.decls {
            if decl is .TypeAlias(name, target, name_span) {
                names += [name]
                targets += [target]
                spans += [name_span]
            }
        }
        mut done: [bool] = []
        for _n in names {
            done += [false]
        }
        mut progress: bool = true
        for progress {
            progress = false
            mut i: int64 = 0
            for i < len(names) {
                if done[i] == false and self.type_resolvable(targets[i]) {
                    let kind = self.register_type_alias(names[i], target: targets[i])
                    self.note_type_decl(names[i], :p, span: spans[i], alias_of: self.canonical_kind_name(kind))
                    done[i] = true
                    progress = true
                }
                i = i + 1
            }
        }
        self.p = saved_p
    }

    func register_type_alias(self, anon name: str, target: int64) -> TypeKind {
        let kind: TypeKind = self.resolve_type(target)
        match kind {
            .KStruct(idx, _struct_type_args) -> {
                self.struct_idx.set(name, idx)
                self.drop_alias(name)
            }
            .KEnum(idx) -> {
                self.enum_idx.set(name, idx)
                self.drop_alias(name)
            }
            .KInterface(idx) -> {
                self.iface_idx.set(name, idx)
                self.drop_alias(name)
            }
            else {
                mut slot: int64 = -1
                if self.alias_idx.get(name) is Some(i) {
                    slot = i
                }
                if slot >= 0 {
                    self.alias_kinds[slot] = kind
                } else {
                    self.alias_idx.set(name, len(self.alias_kinds))
                    self.alias_kinds += [kind]
                }
            }
        }
        return kind
    }

    // Map has no remove; -1 marks a shadowed alias.
    func drop_alias(self, anon name: str) -> none {
        if self.alias_idx.contains(name) {
            self.alias_idx.set(name, -1)
        }
    }

    // An alias whose target fails this stays unregistered and is reported.
    func type_resolvable(self, anon type_id: int64) -> bool {
        if type_id == 0 {
            return true
        }
        match self.p.type_exprs[type_id] {
            .Named(name) -> {
                if self.type_name_known(name) {
                    return len(self.bare_generic_error(name)) == 0
                }
                return false
            }
            .Array(inner) -> return self.type_resolvable(inner)
            .Optional(inner) -> return self.type_resolvable(inner)
            .Func(params, return_typ) -> {
                for param in params {
                    if self.type_resolvable(param) == false {
                        return false
                    }
                }
                return self.type_resolvable(return_typ)
            }
            .Generic(name, args) -> {
                mut param_count = -1
                let struct_idx = self.find_struct_idx(name)
                if struct_idx >= 0 {
                    param_count = len(self.structs[struct_idx].type_param_names)
                } else {
                    let enum_idx = self.find_enum_idx(name)
                    if enum_idx >= 0 {
                        param_count = len(self.enums[enum_idx].type_param_names)
                    }
                }
                if param_count < 0 {
                    return false
                }
                if len(self.type_arity_error(name, :param_count, got: len(args))) > 0 {
                    return false
                }
                for arg in args {
                    if self.type_resolvable(arg) == false {
                        return false
                    }
                }
                return true
            }
        }
    }

    func type_name_known(self, anon name: str) -> bool {
        for sn in self.subst_names {
            if sn == name {
                return true
            }
        }
        if name == "int64" or name == "bool" or name == "str" or name == "bytes" or name == "none" {
            return true
        }
        if self.alias_idx.get(name) is Some(alias_i) {
            if alias_i >= 0 {
                return true
            }
        }
        return self.find_enum_idx(name) >= 0 or self.find_struct_idx(name) >= 0 or self.find_iface_idx(name) >= 0
    }

    // Register all struct and enum declarations from another module under the
    // given prefix (e.g. "builtins"). Doesn't emit any code for them — just
    // makes their names and methods visible for label resolution. Interfaces
    // are registered before structs so struct method signatures can reference
    // interface types.
    func register_module_types(self, anon module: ast.Module, prefix: str, p: parsing.Parser) -> none {
        self.add_scope(module, :prefix, :p)
        // Phase 1: register interface NAMES (with empty sigs) so they're
        // findable when struct method signatures reference them.
        for decl in module.decls {
            self.register_interface(decl, :prefix, :p)
        }
        // Phase 2: aliases whose targets are already known, like an imported `Map[str, str]`.
        self.register_type_aliases(module, :p)
        // Phase 3: register enums and structs in source order. Order
        // matters here: ast.kod's `Decl` enum has a variant with a
        // `[StructField]` payload, and StructField is a struct defined
        // earlier — so we need the struct registered before the enum
        // that references it. Interleaving in source order preserves
        // that natural dependency.
        for decl in module.decls {
            self.register_enum(decl, :prefix, :p)
            self.register_struct(decl, :prefix, :p)
        }
        // Phase 3b: aliases naming this module's own enums and structs.
        self.register_type_aliases(module, :p)
        // Phase 4: now that structs are also registered, resolve the
        // interface method signatures (which may reference struct types).
        for decl in module.decls {
            self.resolve_interface_methods(decl, :p)
        }
    }

    // Re-resolve the field kinds of structs from index `start` on. Used after
    // all imported modules have been registered to fix up references to
    // types defined in modules that hadn't yet been loaded at the time
    // the holding struct was first registered. Without this, a field
    // like `[ast.FuncDecl]` ends up as a plain KArray (no element kind)
    // when `parsing` is registered before `ast`, and downstream chained
    // access like `p.func_decls[0].name` mis-infers as KInt64.
    func resolve_field_kinds(self, start: int64) -> none {
        mut i: int64 = start
        for i < len(self.structs) {
            mut s: StructInfo = self.structs[i]
            if len(s.type_param_names) > 0 {
                i = i + 1
                continue
            }
            let saved_p = self.p
            let saved_names = self.subst_names
            let saved_args = self.subst_args
            self.p = s.src_p
            // Monomorphised structs need the template's substitution context
            // restored before re-resolving — otherwise a field like `[K]`
            // sees K as an unbound name, falls back to KArray (no element
            // kind), and downstream `self.keys[i]` mis-infers as KInt64.
            // That in turn makes `K == K` inside the method lower to a
            // bit-identical pointer compare instead of the kind-specific
            // path (e.g. `$primitives$str$equals` for K = str).
            if s.template_idx >= 0 {
                let template = self.structs[s.template_idx]
                self.subst_names = template.type_param_names
                self.subst_args = s.template_args
            }
            mut new_fields: [FieldInfo] = []
            for f in s.fields {
                let new_kind: TypeKind = self.resolve_type(f.type_expr)
                new_fields += [FieldInfo(name: f.name, offset: f.offset, kind: new_kind, type_expr: f.type_expr, default_expr: f.default_expr)]
            }
            self.structs[i].fields = new_fields
            self.p = saved_p
            self.subst_names = saved_names
            self.subst_args = saved_args
            i = i + 1
        }
    }

    // Mirror of resolve_field_kinds for enum variant fields. Self-
    // recursive enums (e.g. `Value = enum { Array(items: [Value]) }`)
    // capture plain KArray at register_enum time because Value isn't
    // in self.enums yet. Re-resolving once every type is registered
    // pins the right kind (KArrayEnum) so downstream `items[i]` infers
    // correctly instead of falling back to KInt64. Only enums at or after
    // `start` are revisited.
    func resolve_variant_field_kinds(self, start: int64) -> none {
        mut i: int64 = start
        for i < len(self.enums) {
            if len(self.enums[i].type_param_names) > 0 {
                i = i + 1
                continue
            }
            let saved_p = self.p
            let saved_names = self.subst_names
            let saved_args = self.subst_args
            self.p = self.enums[i].src_p
            // Monomorphised enums need the template's substitution context
            // restored — same reason as resolve_field_kinds for structs.
            if self.enums[i].template_idx >= 0 {
                let template = self.enums[self.enums[i].template_idx]
                self.subst_names = template.type_param_names
                self.subst_args = self.enums[i].template_args
            }
            mut new_variants: [VariantInfo] = []
            for v in self.enums[i].variants {
                mut new_kinds: [TypeKind] = []
                mut j: int64 = 0
                for j < len(v.field_type_exprs) {
                    new_kinds += [self.resolve_type(v.field_type_exprs[j])]
                    j = j + 1
                }
                new_variants += [VariantInfo(name: v.name, discriminant: v.discriminant, field_names: v.field_names, field_offsets: v.field_offsets, field_kinds: new_kinds, field_type_exprs: v.field_type_exprs)]
            }
            self.enums[i].variants = new_variants
            self.p = saved_p
            self.subst_names = saved_names
            self.subst_args = saved_args
            i = i + 1
        }
    }

    // Sigs first resolve at registration, before later types and imports are known.
    func resolve_method_sigs(self, struct_start: int64, iface_start: int64) -> none {
        mut i: int64 = struct_start
        for i < len(self.structs) {
            let s: StructInfo = self.structs[i]
            if len(s.type_param_names) > 0 {
                i = i + 1
                continue
            }
            let saved_names = self.subst_names
            let saved_args = self.subst_args
            if s.template_idx >= 0 {
                let template = self.structs[s.template_idx]
                self.subst_names = template.type_param_names
                self.subst_args = s.template_args
            }
            self.structs[i].methods = self.resolve_method_infos(s.methods, p: s.src_p)
            self.subst_names = saved_names
            self.subst_args = saved_args
            i = i + 1
        }
        mut j: int64 = iface_start
        for j < len(self.interfaces) {
            let iface: IfaceInfo = self.interfaces[j]
            mut new_methods: [MethodInfo] = []
            for decl_id in iface.method_decl_ids {
                let fd: ast.FuncDecl = iface.src_p.func_decls[decl_id]
                new_methods += [MethodInfo(name: fd.name, decl_id: -1, sig: self.resolve_sig(decl_id, p: iface.src_p))]
            }
            self.interfaces[j].methods = new_methods
            j = j + 1
        }
    }


    // Names a pattern binds, in payload order.
    func pattern_binding_names(self, anon pattern: ast.Pattern) -> [str] {
        mut names: [str] = []
        match pattern {
            .SomePat(binding) -> names += [binding]
            .OkPat(binding) -> names += [binding]
            .ErrPat(binding) -> names += [binding]
            .TypePat(_type_name, binding) -> names += [binding]
            .EnumPat(_enum_name, _variant_name, bindings) -> return bindings
            .ImplicitEnumPat(_variant_name, bindings) -> return bindings
            else none
        }
        if len(names) == 1 and len(names[0]) == 0 {
            return []
        }
        return names
    }

    // A pattern that doesn't resolve reports it, so its bindings are KUnknown.
    func pattern_binding_kinds(self, anon subject_pat: ast.Pattern, subject_kind: TypeKind) -> [TypeKind] {
        let pattern = self.subject_pattern(subject_pat, :subject_kind)
        let count = len(self.pattern_binding_names(pattern))
        mut kinds: [TypeKind] = []
        if count == 0 {
            return kinds
        }
        mut kind: TypeKind = .KInt64
        match pattern {
            .SomePat(_binding) -> {
                if subject_kind is .KOptional(inner) {
                    kind = inner
                }
            }
            .OkPat(_binding) -> {
                if self.is_result_kind(subject_kind) {
                    kind = self.result_inner_kind(subject_kind)
                }
            }
            .ErrPat(_binding) -> {
                kind = .KInterface(idx: self.find_iface_idx("Error"))
                if self.is_result_kind(subject_kind) {
                    kind = self.result_err_kind(subject_kind)
                }
            }
            .TypePat(type_name, _binding) -> {
                let struct_idx = self.find_struct_idx(type_name)
                if struct_idx >= 0 {
                    kind = .KStruct(idx: struct_idx, type_args: [])
                } else {
                    kind = .KUnknown
                }
            }
            .EnumPat(enum_name, variant_name, _bindings) -> {
                return self.variant_binding_kinds(self.named_pattern_enum_idx(enum_name, :subject_kind), :variant_name, :count)
            }
            .ImplicitEnumPat(variant_name, _bindings) -> {
                return self.variant_binding_kinds(self.enum_idx_of_kind(subject_kind), :variant_name, :count)
            }
            else none
        }
        kinds += [kind]
        return kinds
    }

    // A generic enum's pattern names the template; the subject's instance has the payload kinds.
    func named_pattern_enum_idx(self, anon enum_name: str, subject_kind: TypeKind) -> int64 {
        let named = self.find_enum_idx(enum_name)
        let subj = self.enum_idx_of_kind(subject_kind)
        if named < 0 or subj < 0 {
            return -1
        }
        if self.enums_compatible(subj, a_idx: named) {
            return subj
        }
        return -1
    }

    func pattern_variant_name(self, anon pattern: ast.Pattern) -> str {
        match pattern {
            .EnumPat(_enum_name, variant_name, _bindings) -> return variant_name
            .ImplicitEnumPat(variant_name, _bindings) -> return variant_name
            else return ""
        }
    }

    func variant_binding_kinds(self, anon enum_idx: int64, variant_name: str, count: int64) -> [TypeKind] {
        mut field_kinds: [TypeKind] = []
        if enum_idx >= 0 {
            let variant_idx = self.find_variant_idx(variant_name, :enum_idx)
            if variant_idx >= 0 {
                field_kinds = self.enums[enum_idx].variants[variant_idx].field_kinds
            }
        }
        mut kinds: [TypeKind] = []
        mut j = 0
        for j < count {
            mut kind: TypeKind = .KUnknown
            if j < len(field_kinds) {
                kind = field_kinds[j]
            }
            kinds += [kind]
            j = j + 1
        }
        return kinds
    }

    // A first guess; compile time retypes them from the subject's final kind.
    func alloc_pattern_bindings(self, anon pattern: ast.Pattern, subject_kind: TypeKind) -> none {
        let names = self.pattern_binding_names(pattern)
        let kinds = self.pattern_binding_kinds(pattern, :subject_kind)
        mut i = 0
        for i < len(names) {
            if self.var_declared(names[i]) == false {
                self.alloc_var(name: names[i], kind: kinds[i])
            }
            i = i + 1
        }
    }

    // Returns the previous kinds for restore_pattern_bindings.
    func retype_pattern_bindings(self, anon pattern: ast.Pattern, subject_kind: TypeKind) -> [TypeKind] {
        let names = self.pattern_binding_names(pattern)
        let kinds = self.pattern_binding_kinds(pattern, :subject_kind)
        mut saved: [TypeKind] = []
        mut i = 0
        for i < len(names) {
            saved += [self.find_var_kind(names[i])]
            self.update_var_kind(name: names[i], kind: kinds[i])
            i = i + 1
        }
        return saved
    }

    func restore_pattern_bindings(self, anon pattern: ast.Pattern, kinds: [TypeKind]) -> none {
        let names = self.pattern_binding_names(pattern)
        mut i = len(names) - 1
        for i >= 0 {
            self.update_var_kind(name: names[i], kind: kinds[i])
            i = i - 1
        }
    }

    // The collect pass may have typed the bindings from a placeholder subject.
    func compile_arm_stmts(self, anon body: [int64], pattern_id: int64, subject_kind: TypeKind) -> none {
        let pattern = self.p.patterns[pattern_id]
        let saved = self.retype_pattern_bindings(pattern, :subject_kind)
        let mark = len(self.bound_log)
        self.pattern_rebinds_outer(pattern_id, depth: self.block_depth + 1)
        self.bind_pattern_at(pattern_id, depth: self.block_depth + 1)
        self.compile_block(body)
        self.unbind_to(mark)
        self.restore_pattern_bindings(pattern, kinds: saved)
    }

    // A none or optional arm makes the whole match optional.
    func match_expr_kind(self, anon arms: [int64], subject_kind: TypeKind) -> TypeKind {
        mut kind: TypeKind = .KInt64
        mut found = false
        mut widen = false
        for arm_id in arms {
            let arm = self.p.match_expr_arms[arm_id]
            let pattern = self.p.patterns[arm.pattern]
            let saved = self.retype_pattern_bindings(pattern, :subject_kind)
            let mark = len(self.bound_log)
            self.bind_pattern(pattern)
            let k = self.infer_kind(arm.body)
            self.unbind_to(mark)
            self.restore_pattern_bindings(pattern, kinds: saved)
            if self.is_none_kind(k) or self.is_some_optional(k) {
                widen = true
            }
            if found == false and self.is_void_kind(k) == false and self.is_none_kind(k) == false {
                kind = k
                found = true
            }
        }
        if found == false {
            if widen {
                return .KOptional(inner: .KVoid)
            }
            return .KInt64
        }
        if widen and self.is_some_optional(kind) == false and self.kind_has_unknown(kind) == false {
            return .KOptional(inner: kind)
        }
        return kind
    }

    // With `ok_wrap`, an arm that isn't already a result becomes its Ok.
    func compile_arm_value(self, anon body: int64, pattern_id: int64, subject_kind: TypeKind, expected: TypeKind, ok_wrap: bool, result_r: str) -> none {
        let pattern = self.p.patterns[pattern_id]
        let saved = self.retype_pattern_bindings(pattern, :subject_kind)
        let mark = len(self.bound_log)
        self.block_depth += 1
        self.pattern_rebinds_outer(pattern_id, depth: self.block_depth)
        self.bind_pattern_at(pattern_id, depth: self.block_depth)
        let body_kind = self.infer_kind(body)
        mut target = expected
        if ok_wrap {
            target = self.result_inner_kind(expected)
        }
        if self.is_void_kind(body_kind) and self.is_void_kind(target) == false and self.is_diverging_call(body) == false {
            self.report_error(f"error: this arm has no value, but the match is used as a value; give the arm a value or use a match statement{self.diverge_hint(body)}", span: self.p.expr_spans[body])
        }
        mut wrap = false
        if ok_wrap and self.is_ctor_for(body, kind: expected) == false and self.is_result_kind(body_kind) == false {
            wrap = true
        }
        if wrap {
            self.compile_wrap_ok(body)
            self.mov_to(.VReg(name: "x0"), dest: result_r)
            if self.is_void_kind(body_kind) == false {
                self.check_value_kind(body, expected: self.result_inner_kind(expected))
            }
        } else {
            if self.converts_for(body, kind: expected) {
                let reg = self.compile_value_for_kind(body, :expected)
                self.mov_to(.VReg(name: reg), dest: result_r)
            } else {
                let val = self.compile_expr(body)
                self.mov_to(val, dest: result_r)
                self.report_if_unknown(body)
            }
            if self.is_void_kind(body_kind) == false {
                self.check_value_kind(body, :expected)
            }
        }
        self.block_depth -= 1
        self.unbind_to(mark)
        self.restore_pattern_bindings(pattern, kinds: saved)
    }

    // `kod_panic(...)`, or a call to a function that never returns.
    func is_diverging_call(self, anon expr_id: int64) -> bool {
        if self.is_panic_call(expr_id) {
            return true
        }
        let .Call(callee, _args) = self.p.exprs[expr_id] else { return false }
        if self.p.exprs[callee] is .Binary(lhs, op, rhs) {
            if op is .Dot {
                return self.is_diverging_dot_callee(lhs, rhs)
            }
            return false
        }
        let .Ident(name) = self.p.exprs[callee] else { return false }
        if self.calls_local(name) {
            return self.trusts(self.find_var_kind(name))
        }
        let slot = self.lookup_func(name)
        if slot != -1 {
            return self.never_returns(self.fn_sig(slot), owner: -1)
        }
        return false
    }

    func trusts(self, anon kind: TypeKind) -> bool {
        if self.trust_locals == false or self.deciding_depth == 0 {
            return false
        }
        match kind {
            .KUnknown -> self.trust_why = "a call through a local, which counts as returning until blocks get scopes"
            .KInterface(_idx) -> self.trust_why = "a method called through an interface value, which is taken to return"
            else return false
        }
        return true
    }

    // `alias.f` or a struct method, resolved as try_two_part_call does.
    func is_diverging_dot_callee(self, anon lhs: int64, anon rhs: int64) -> bool {
        let .Ident(name) = self.p.exprs[rhs] else { return false }
        if self.p.exprs[lhs] is .Ident(alias) {
            if self.is_import_alias(alias) {
                let slot = self.lookup_import_fn(alias, name)
                if slot == -1 {
                    return false
                }
                return self.never_returns(self.import_fn_at(slot).sig, owner: -1)
            }
        }
        let recv = self.infer_kind(lhs)
        if recv is .KStruct(sidx, _ta) {
            if self.has_field(name, struct_idx: sidx) and self.find_field_kind(name, struct_idx: sidx) is .KFunc(_p, _r) {
                return false
            }
            if self.structs[sidx].method_idx.get(name) is Some(mi) {
                return self.never_returns(self.structs[sidx].methods[mi].sig, owner: sidx)
            }
        }
        return self.trusts(recv)
    }

    func is_panic_call(self, anon expr_id: int64) -> bool {
        if self.p.exprs[expr_id] is .Call(callee, _args) {
            if self.p.exprs[callee] is .Ident(name) {
                return name == "kod_panic" and self.is_builtin_call(name)
            }
        }
        return false
    }

    // A `false` resting on functions still being decided holds until one of them never returns.
    func never_returns(self, anon sig: SigInfo, owner: int64) -> bool {
        if sig.decl_id <= 0 or self.is_void_kind(sig.return_kind) == false {
            return false
        }
        let key = f"{sig.src_p.path}:{sig.decl_id}:{owner}"
        self.last_nr_key = key
        let memo = self.returns_memo
        if memo.get(key) is Some(v) {
            if v == 0 or v == 1 {
                return v == 1
            }
            if v != -1 {
                self.rest_on(key)
                return false
            }
        }
        let depth = self.deciding_depth
        let outer_key = self.deciding_key
        let outer_rests = self.deciding_rests
        memo.set(key, 2)
        let heads = self.dependent_heads
        heads.set(key, -1)
        self.deciding_depth = depth + 1
        self.deciding_key = key
        self.deciding_rests = false
        let outer_why = self.trust_why
        let never = self.body_never_returns(sig, :owner)
        self.trust_why = outer_why
        self.last_nr_key = key
        let rests = self.deciding_rests
        self.deciding_depth = depth
        self.deciding_key = outer_key
        self.deciding_rests = outer_rests
        if never {
            memo.set(key, 1)
            self.drop_resting_on(key)
        } else if rests {
            memo.set(key, -2)
            self.returns_pending += [key]
            self.rest_on(key)
        } else {
            memo.set(key, 0)
        }
        if depth == 0 {
            self.settle_pending_returns()
        }
        return never
    }

    // The function being decided takes `key` to return for now.
    func rest_on(self, anon key: str) -> none {
        let caller = self.deciding_key
        if len(caller) == 0 or caller == key {
            return
        }
        self.deciding_rests = true
        let heads = self.dependent_heads
        mut head = -1
        if heads.get(key) is Some(h) {
            head = h
        }
        heads.set(key, len(self.dependent_keys))
        self.dependent_keys += [caller]
        self.dependent_next += [head]
    }

    // What rested on `key` returning has to be decided again.
    func drop_resting_on(self, anon key: str) -> none {
        let memo = self.returns_memo
        let heads = self.dependent_heads
        mut todo = [key]
        mut i = 0
        for i < len(todo) {
            mut e = -1
            if heads.get(todo[i]) is Some(h) {
                e = h
            }
            for e >= 0 {
                let dependent = self.dependent_keys[e]
                if memo.get(dependent) is Some(v) {
                    if v == -2 {
                        memo.set(dependent, -1)
                        todo += [dependent]
                    }
                }
                e = self.dependent_next[e]
            }
            i += 1
        }
    }

    // The callers these assumed to return have all done so.
    func settle_pending_returns(self) -> none {
        let memo = self.returns_memo
        for key in self.returns_pending {
            if memo.get(key) is Some(v) {
                if v == -2 {
                    memo.set(key, 0)
                }
            }
        }
        let none_pending: [str] = []
        self.returns_pending = none_pending
        self.dependent_heads = FuncIdx()
        let no_keys: [str] = []
        self.dependent_keys = no_keys
        let no_next: [int64] = []
        self.dependent_next = no_next
    }

    // Locals are named so a call of one isn't taken for a same-named function.
    func body_never_returns(self, anon sig: SigInfo, owner: int64) -> bool {
        let saved_p = self.p
        let saved_vars = self.vars
        let saved_slots = self.frame_slots
        let saved_names = self.subst_names
        let saved_args = self.subst_args
        let saved_log = self.bound_log
        let saved_fixed = self.fixed_names
        let saved_walk = self.untyped_walk
        let saved_walk_slots = self.walk_slots
        let saved_walk_kinds = self.walk_kinds
        let saved_seen = self.seen_log
        self.untyped_walk = false
        let no_slots: [int64] = []
        let no_kinds: [TypeKind] = []
        let no_seen: [int64] = []
        self.walk_slots = no_slots
        self.walk_kinds = no_kinds
        self.seen_log = no_seen
        self.p = sig.src_p
        let fd = self.p.func_decls[sig.decl_id]
        let saved_fn = self.walking_fn
        self.walking_fn = fd.name
        if owner >= 0 {
            self.walking_fn = f"{self.struct_display_name(owner)}.{fd.name}"
        }
        self.fixed_names = self.fixed_params(fd)
        let no_vars: [VarSlot] = []
        self.vars = no_vars
        let no_log: [int64] = []
        self.bound_log = no_log
        mut i = 0
        for param in fd.params {
            mut kind = sig.param_kinds[i]
            if param.name == "self" and owner >= 0 {
                kind = .KStruct(idx: owner, type_args: [])
            }
            self.alloc_var(name: param.name, :kind)
            self.vars[-1].bound = true
            i += 1
        }
        let no_names: [str] = []
        let no_args: [TypeKind] = []
        self.subst_names = no_names
        self.subst_args = no_args
        if owner >= 0 and self.structs[owner].template_idx >= 0 {
            self.subst_names = self.structs[self.structs[owner].template_idx].type_param_names
            self.subst_args = self.structs[owner].template_args
        }
        self.naming_locals = true
        for stmt_id in fd.body {
            self.collect_stmt_vars(:stmt_id)
        }
        self.naming_locals = false
        let never = self.block_has_return(fd.body) == false and self.walk_completes(fd.body) == false
        self.p = saved_p
        self.vars = saved_vars
        self.frame_slots = saved_slots
        self.subst_names = saved_names
        self.subst_args = saved_args
        self.bound_log = saved_log
        self.fixed_names = saved_fixed
        self.untyped_walk = saved_walk
        self.walk_slots = saved_walk_slots
        self.walk_kinds = saved_walk_kinds
        self.seen_log = saved_seen
        self.walking_fn = saved_fn
        return never
    }

    // Until blocks get scopes, only these keep one kind throughout the body.
    func fixed_params(self, anon fd: ast.FuncDecl) -> [str] {
        let saved_vars = self.vars
        let saved_slots = self.frame_slots
        let saved_naming = self.naming_locals
        let no_vars: [VarSlot] = []
        self.vars = no_vars
        self.naming_locals = true
        for stmt_id in fd.body {
            self.collect_stmt_vars(:stmt_id)
        }
        self.naming_locals = saved_naming
        mut fixed: [str] = []
        for param in fd.params {
            if self.var_declared(param.name) == false {
                fixed += [param.name]
            }
        }
        self.vars = saved_vars
        self.frame_slots = saved_slots
        return fixed
    }

    func walk_completes(self, anon stmts: [int64]) -> bool {
        let outer = self.untyped_walk
        let kinds_mark = len(self.walk_slots)
        let seen_mark = len(self.seen_log)
        self.untyped_walk = true
        let completes = self.block_completes(stmts)
        self.untyped_walk = outer
        if len(self.walk_slots) > kinds_mark {
            self.walk_slots = self.walk_slots[0..kinds_mark]
            self.walk_kinds = self.walk_kinds[0..kinds_mark]
        }
        if len(self.seen_log) > seen_mark {
            for idx in self.seen_log[seen_mark..] {
                self.vars[idx].seen = false
            }
            self.seen_log = self.seen_log[0..seen_mark]
        }
        return completes
    }

    // So a hint can name the call in a chain that was taken not to return.
    func note_trust_end(self, anon expr_id: int64) -> none {
        let ends = self.trust_ends
        if len(self.trust_why) == 0 and (ends.get(self.last_nr_key) is Some(_i)) == false {
            return
        }
        ends.set(self.deciding_key, len(self.trust_end_exprs))
        self.trust_end_exprs += [expr_id]
        self.trust_end_ps += [self.p]
        self.trust_end_fns += [self.walking_fn]
        self.trust_end_whys += [self.trust_why]
        self.trust_end_vias += [self.last_nr_key]
    }

    // In a place that takes a call that never returns: why this one is taken to return.
    func diverge_hint(self, anon expr_id: int64) -> str {
        if self.is_iface_method_call(expr_id) {
            return "; a method called through an interface value is taken to return, so call it as a statement and end the path with `kod_panic(...)`"
        }
        let site = self.trusted_site(expr_id)
        if len(site) == 0 {
            return ""
        }
        return f"; the call is taken to return, as {site}; if that one never returns, add a `kod_panic(...)` after it"
    }

    func is_iface_method_call(self, anon expr_id: int64) -> bool {
        let .Call(callee, _args) = self.p.exprs[expr_id] else { return false }
        let .Binary(lhs, op, _rhs) = self.p.exprs[callee] else { return false }
        if op is .Dot {
            return self.infer_kind(lhs) is .KInterface(_idx)
        }
        return false
    }

    // Names the call taken on trust when only trusting locals makes this one never return.
    func trusted_site(self, anon expr_id: int64) -> str {
        if self.deciding_depth > 0 or self.is_diverging_call(expr_id) {
            return ""
        }
        if (self.p.exprs[expr_id] is .Call(_callee, _args)) == false {
            return ""
        }
        let saved = self.returns_memo
        self.returns_memo = self.trusted_memo
        self.trust_locals = true
        self.last_nr_key = ""
        let never = self.is_diverging_call(expr_id)
        let key = self.last_nr_key
        self.trust_locals = false
        self.returns_memo = saved
        if never == false {
            return ""
        }
        let i = self.trust_site(key)
        if i < 0 {
            return ""
        }
        let p = self.trust_end_ps[i]
        let e = self.trust_end_exprs[i]
        return f"`{self.trust_end_fns[i]}` ends in `{call_text(p, e)}` (line {self.line_in(p, offset: p.expr_spans[e].start)}), {self.trust_end_whys[i]}"
    }

    // Follows the calls functions end in to the one taken on trust, remembering the answer.
    func trust_site(self, anon start: str) -> int64 {
        let sites = self.trust_sites
        let ends = self.trust_ends
        mut path: [str] = []
        mut key = start
        mut found = -1
        for len(path) <= len(self.trust_end_exprs) {
            if sites.get(key) is Some(known) {
                found = known
                break
            }
            let .Some(i) = ends.get(key) else { break }
            path += [key]
            if len(self.trust_end_whys[i]) > 0 {
                found = i
                break
            }
            key = self.trust_end_vias[i]
        }
        for k in path {
            sites.set(k, found)
        }
        return found
    }

    func line_in(self, anon p: parsing.Parser, offset: int64) -> int64 {
        let saved = self.p
        self.p = p
        let line = self.line_of_offset(offset)
        self.p = saved
        return line
    }

    func converts_for(self, anon value_id: int64, kind: TypeKind) -> bool {
        if self.p.exprs[value_id] is .MatchExpr(_subject, _arms) {
            return true
        }
        if self.builds_array_for(value_id, :kind) {
            return true
        }
        match kind {
            .KOptional(_inner) -> return true
            .KInterface(_idx) -> return true
            else return self.is_ctor_for(value_id, :kind)
        }
    }

    // Walk an expression and allocate stack slots for any bindings that
    // appear in nested match expressions. Without this, 'Some(x) -> x'
    // inside a match expression returns 'x' as an unknown var.
    func collect_expr_vars(self, anon expr_id: int64) -> none {
        match self.p.exprs[expr_id] {
            .Binary(lhs, op, rhs) -> {
                self.collect_expr_vars(lhs)
                self.collect_expr_vars(rhs)
            }
            .Chain(exprs, ops) -> {
                for e in exprs {
                    self.collect_expr_vars(e)
                }
            }
            .Call(callee, args) -> {
                self.collect_expr_vars(callee)
                mut i = 0
                for i < len(args) {
                    self.collect_expr_vars(args[i].value)
                    i = i + 1
                }
            }
            .ArrayLit(elements) -> {
                mut i = 0
                for i < len(elements) {
                    self.collect_expr_vars(elements[i])
                    i = i + 1
                }
            }
            .Slice(s, lo, hi) -> {
                self.collect_expr_vars(s)
                self.collect_expr_vars(lo)
                if hi != 0 {
                    self.collect_expr_vars(hi)
                }
            }
            .Try(inner) -> self.collect_expr_vars(inner)
            .Must(inner) -> self.collect_expr_vars(inner)
            .UnwrapOpt(value, default) -> {
                self.collect_expr_vars(value)
                if default != 0 {
                    self.collect_expr_vars(default)
                }
            }
            .OptionalDot(value, _field) -> self.collect_expr_vars(value)
            .OptionalMethodCall(value, _method, args) -> {
                self.collect_expr_vars(value)
                for arg in args {
                    self.collect_expr_vars(arg.value)
                }
            }
            .FuncLit(_decl_id) -> {
                // Lambda bodies get their own var scope when
                // compiled separately; nothing to collect into the
                // enclosing function's frame.
            }
            .MatchExpr(subject, arms) -> {
                self.collect_expr_vars(subject)
                let subj_kind = self.collected_kind(subject)
                for arm_id in arms {
                    let arm = self.p.match_expr_arms[arm_id]
                    self.alloc_pattern_bindings(self.p.patterns[arm.pattern], subject_kind: subj_kind)
                    self.collect_expr_vars(arm.body)
                }
            }
            else none
        }
    }

    func collected_kind(self, anon expr_id: int64) -> TypeKind {
        if self.naming_locals {
            return .KUnknown
        }
        return self.infer_kind(expr_id)
    }

    func collect_stmt_vars(self, stmt_id: int64) -> none {
        match self.p.stmts[stmt_id] {
            .Let(name, typ, value, _mutable) -> {
                if self.var_declared(name) == false {
                    mut kind: TypeKind = .KUnknown
                    if self.naming_locals == false {
                        kind = self.resolve_type(typ)
                    }
                    // No annotation: infer the kind now so downstream
                    // collect calls (e.g. a foreach over `name.field`) can
                    // resolve correctly. compile_let does this too, but
                    // that only runs after collection.
                    if typ == 0 {
                        kind = self.collected_kind(value)
                    }
                    self.alloc_var(:name, :kind)
                }
                self.collect_expr_vars(value)
            }
            .Assign(lhs, rhs) -> self.collect_expr_vars(rhs)
            .PlusAssign(lhs, rhs) -> self.collect_expr_vars(rhs)
            .MinusAssign(lhs, rhs) -> self.collect_expr_vars(rhs)
            .Return(value) -> {
                if value != 0 {
                    self.collect_expr_vars(value)
                }
            }
            .Throw(value) -> self.collect_expr_vars(value)
            .Assert(expr, _source_text, _span) -> self.collect_expr_vars(expr)
            .ExprStmt(expr) -> self.collect_expr_vars(expr)
            .If(cond, then_body, else_body) -> {
                self.collect_expr_vars(cond)
                mut i = 0
                for i < len(then_body) {
                    self.collect_stmt_vars(stmt_id: then_body[i])
                    i = i + 1
                }
                mut j = 0
                for j < len(else_body) {
                    self.collect_stmt_vars(stmt_id: else_body[j])
                    j = j + 1
                }
            }
            .For(cond, body) -> {
                mut i = 0
                for i < len(body) {
                    self.collect_stmt_vars(stmt_id: body[i])
                    i = i + 1
                }
            }
            .ForEach(name, iter, body) -> {
                if self.var_declared(name) == false {
                    // Only the slot is pre-reserved here; the actual kind
                    // is set per-iteration at compile time (compile_foreach)
                    // because two loops sharing an element name (e.g. `for f
                    // in xs` … `for f in ys`) want *different* element kinds
                    // even though they share one stack slot.
                    self.alloc_var(:name, kind: .KInt64)
                }
                let idx_name = f"__fi_{name}"
                if self.var_declared(idx_name) == false {
                    self.alloc_var(name: idx_name, kind: .KInt64)
                }
                // Persistent slot for the array header pointer so we can
                // reload it each iteration (bl calls in the body would
                // clobber a register-resident copy).
                let hdr_name = f"__fh_{name}"
                if self.var_declared(hdr_name) == false {
                    self.alloc_var(name: hdr_name, kind: .KInt64)
                }
                mut i = 0
                for i < len(body) {
                    self.collect_stmt_vars(stmt_id: body[i])
                    i = i + 1
                }
            }
            .MatchStmt(subject, arms) -> {
                let subj_kind = self.collected_kind(subject)
                for arm_id in arms {
                    let arm = self.p.match_arms[arm_id]
                    self.alloc_pattern_bindings(self.p.patterns[arm.pattern], subject_kind: subj_kind)
                    for arm_stmt in arm.body {
                        self.collect_stmt_vars(stmt_id: arm_stmt)
                    }
                }
            }
            .LetElse(pattern, value, else_body) -> {
                // Allocate bindings introduced by the pattern (same shape as
                // a match arm) so the rest of the surrounding block can use
                // them.
                let subj_kind = self.collected_kind(value)
                self.alloc_pattern_bindings(self.subject_pattern(self.p.patterns[pattern], subject_kind: subj_kind), subject_kind: subj_kind)
                self.collect_expr_vars(value)
                mut e = 0
                for e < len(else_body) {
                    self.collect_stmt_vars(stmt_id: else_body[e])
                    e = e + 1
                }
            }
            else none
        }
    }


    func compile_expr(self, anon expr_id: int64) -> Val {
        match self.p.exprs[expr_id] {
            .IntLit(value) -> return .VImm(:value)
            .BoolLit(value) -> {
                if value {
                    return .VImm(value: 1)
                }
                return .VImm(value: 0)
            }
            .NoneLit -> return .VImm(value: 0)
            .BytesLit(value) -> {
                // Identical runtime to a StrLit — same intern table,
                // same KodStr cell layout. The only difference is
                // the static kind (`KBytes` vs `KStr`), pinned in
                // `infer_kind` so type-checking stays sharp.
                let lbl = self.intern_str(value)
                return .VStrLbl(page: lbl)
            }
            .StrLit(value) -> {
                let lbl = self.intern_str(value)
                return .VStrLbl(page: lbl)
            }
            .Ident(name) -> {
                let i = self.var_index(name)
                if i < 0 {
                    // Not a variable — see if it's a function name in
                    // value position (function-pointer reference, not a
                    // call). Direct calls go through compile_call's
                    // Ident path; landing here with a function name
                    // means the user wrote `let f = foo` or passed
                    // `foo` as a callback.
                    let slot = self.lookup_func(name)
                    if slot != -1 {
                        return self.fn_address(slot)
                    }
                    // Candidates for the typo hint: in-scope variables
                    // plus visible function names. Type and import
                    // names also live in the global namespace but
                    // can't appear in a value position, so leaving
                    // them out keeps the suggestions relevant.
                    mut cands: [str] = []
                    for v in self.vars {
                        cands += [v.name]
                    }
                    for n in self.visible_func_names() {
                        cands += [n]
                    }
                    let msg: str = self.with_suggestion(f"error: unknown name `{name}`", typo: name, candidates: cands)
                    self.report_error(msg, span: self.p.expr_spans[expr_id])
                    return .VImm(value: 0)
                }
                if self.reads_scoped and self.vars[i].bound == false {
                    // Outside where it's bound, a name means what it would without the local.
                    let slot = self.lookup_func(name)
                    if slot != -1 {
                        return self.fn_address(slot)
                    }
                    self.report_error(self.unbound_msg(name, verb: "read"), span: self.p.expr_spans[expr_id])
                }
                return .VStack(offset: self.vars[i].offset)
            }
            .ImplicitVariant(name) -> {
                let enum_idx = self.find_enum_with_variant(name)
                if enum_idx == -2 {
                    let unit: [ast.CallArg] = []
                    self.report_ambiguous_variant(name, args: unit, span: self.p.expr_spans[expr_id])
                    return .VImm(value: 0)
                }
                if enum_idx < 0 {
                    mut variant_names: [str] = []
                    for e in self.enums {
                        for v in e.variants {
                            variant_names += [v.name]
                        }
                    }
                    let msg: str = self.with_suggestion(f"error: unknown implicit variant `.{name}`", typo: name, candidates: variant_names)
                    self.report_error(msg, span: self.p.expr_spans[expr_id])
                    return .VImm(value: 0)
                }
                mut variant_idx = self.find_variant_idx(name, :enum_idx)
                let empty: [ast.CallArg] = []
                return self.compile_enum_construct(empty, :enum_idx, :variant_idx, span: self.p.expr_spans[expr_id])
            }
            .Binary(lhs, op, rhs) -> return self.compile_binary(:lhs, :op, :rhs)
            .Chain(exprs, ops) -> return self.compile_chain(:exprs, :ops)
            .Call(callee, args) -> return self.compile_call(args, callee_id: callee)
            .ArrayLit(elements) -> return self.compile_array_lit(elements)
            .MatchExpr(subject, arms) -> return self.compile_match_expr(arms, subject_id: subject)
            .Slice(s, lo, hi) -> return self.compile_slice(s_id: s, lo_id: lo, hi_id: hi)
            .Try(inner) -> return self.compile_try(inner)
            .Must(inner) -> return self.compile_must(inner)
            .UnwrapOpt(value, default) -> return self.compile_unwrap_opt(value_id: value, default_id: default)
            .OptionalDot(value, field) -> return self.compile_optional_dot(value_id: value, :field)
            .OptionalMethodCall(value, method, args) -> return self.compile_optional_method_call(value_id: value, :method, :args)
            .FuncLit(decl_id) -> {
                // The lambda was registered with a synthesised name
                // and label during compile_module; emit its address
                // as a function-pointer value, same shape as a bare
                // named-function reference.
                let slot = self.lookup_lambda(decl_id)
                if slot != -1 {
                    let lbl: str = self.fn_label(slot)
                    let reg: str = self.pool.alloc_reg()
                    self.emit(f"adrp {reg}, {lbl}@PAGE")
                    self.emit(f"add {reg}, {reg}, {lbl}@PAGEOFF")
                    return .VReg(name: reg)
                }
                self.report_error("internal error: function literal was never registered", span: self.p.expr_spans[expr_id])
                return .VImm(value: 0)
            }
        }
    }

    func compile_binary(self, lhs: int64, op: ast.Op, rhs: int64) -> Val {
        match op {
            .Dot -> return self.compile_dot(:lhs, :rhs)
            .Index -> return self.compile_index(:lhs, :rhs)
            .And -> return self.compile_and(:lhs, :rhs)
            .Or -> return self.compile_or(:lhs, :rhs)
            .Is -> return self.compile_is(:lhs, :rhs, negate: false)
            .IsNot -> return self.compile_is(:lhs, :rhs, negate: true)
            else return self.compile_arith_cmp(lhs_id: lhs, :op, rhs_id: rhs)
        }
    }

    // Try `module.Enum.Variant` — bare three-part unit-variant access.
    // Drops the module qualifier (types are global in the codegen).
    func try_three_part_unit_variant(self, dot_lhs: int64, dot_rhs: int64) -> Val? {
        let .Binary(inner_lhs, inner_op, inner_rhs) = self.p.exprs[dot_lhs] else { return none }
        let .Dot = inner_op else { return none }
        let .Ident(enum_name) = self.p.exprs[inner_rhs] else { return none }
        let .Ident(variant_name) = self.p.exprs[dot_rhs] else { return none }
        let ei3 = self.find_enum_idx(enum_name)
        if ei3 < 0 { return none }
        let vi3 = self.find_variant_idx(variant_name, enum_idx: ei3)
        if vi3 < 0 {
            if self.p.exprs[inner_lhs] is .Ident(mod_name) {
                if self.is_import_alias(mod_name) {
                    self.check_variant(variant_name, enum_idx: ei3, span: self.p.expr_spans[dot_rhs])
                    return .VImm(value: 0)
                }
            }
            return none
        }
        let empty: [ast.CallArg] = []
        return self.compile_enum_construct(empty, enum_idx: ei3, variant_idx: vi3, span: self.p.expr_spans[dot_rhs])
    }

    // `a < b < c` is `(a < b) and (b < c)` with `b` computed once, left to right.
    func compile_chain(self, exprs: [int64], ops: [ast.Op]) -> Val {
        let span: ast.Span = self.p.expr_spans[exprs[0]]
        let false_lbl: str = self.fresh("Lchain_false")
        let done_lbl: str = self.fresh("Lchain_done")
        mut lhs = exprs[0]
        let first_kind = self.chain_stash_kind(lhs, other: exprs[1], op: ops[0])
        if self.chain_operand_moves(lhs, kind: first_kind) {
            lhs = self.stash_operand_as(lhs, kind: first_kind)
        }
        mut k: int64 = 0
        for k < len(ops) {
            mut rhs = exprs[k + 1]
            if k + 1 < len(ops) {
                let kind = self.chain_stash_kind(rhs, other: lhs, op: ops[k])
                if self.chain_operand_moves(rhs, :kind) {
                    rhs = self.stash_operand_as(rhs, :kind)
                }
            }
            let pair: int64 = self.p.alloc_expr(ast.Expr.Binary(:lhs, op: ops[k], :rhs), :span)
            let r: str = self.load(self.compile_expr(pair))
            self.emit(f"cmp {r}, #0")
            self.emit(f"beq {false_lbl}")
            self.pool.free_reg(r)
            lhs = rhs
            k = k + 1
        }
        mut result: str = self.pool.alloc_reg()
        self.emit(f"mov {result}, #1")
        self.emit(f"b {done_lbl}")
        self.emit_label(false_lbl)
        self.emit(f"mov {result}, #0")
        self.emit_label(done_lbl)
        return .VReg(name: result)
    }

    // A `match` beside `==` takes its enum from the operand next to it.
    func chain_stash_kind(self, anon expr_id: int64, other: int64, op: ast.Op) -> TypeKind {
        if self.p.exprs[expr_id] is .MatchExpr(_subject, _arms) {
            let other_kind = self.infer_kind(other)
            if self.is_eq_ctor_operand(expr_id, :op, :other_kind) {
                return other_kind
            }
        }
        return self.infer_kind(expr_id)
    }

    // Whether computing a chain operand late or twice could change its value.
    func chain_operand_moves(self, anon expr_id: int64, kind: TypeKind) -> bool {
        if self.emits_nothing(expr_id) or self.kind_has_unknown(kind) {
            return false
        }
        match self.p.exprs[expr_id] {
            .BoolLit(_value) -> return false
            .NoneLit -> return false
            .ImplicitVariant(_name) -> return false
            else return true
        }
    }

    func stash_chain_operand(self, anon expr_id: int64) -> int64 {
        return self.stash_operand_as(expr_id, kind: self.infer_kind(expr_id))
    }

    func stash_operand_as(self, anon expr_id: int64, kind: TypeKind) -> int64 {
        let name: str = self.fresh("__chain")
        let off: int64 = self.alloc_var(:name, :kind)
        self.vars[-1].bound = true
        self.compile_store(dest_off: off, :kind, value_id: expr_id)
        return self.p.alloc_expr(ast.Expr.Ident(:name), span: self.p.expr_spans[expr_id])
    }

    // Try `EnumName.Variant` — bare two-part unit-variant access.
    func try_two_part_unit_variant(self, dot_lhs: int64, dot_rhs: int64) -> Val? {
        let .Ident(type_name) = self.p.exprs[dot_lhs] else { return none }
        let enum_idx = self.find_enum_idx(type_name)
        if enum_idx < 0 { return none }
        let .Ident(variant_name) = self.p.exprs[dot_rhs] else { return none }
        let variant_idx = self.check_variant(variant_name, :enum_idx, span: self.p.expr_spans[dot_rhs])
        if variant_idx < 0 {
            return .VImm(value: 0)
        }
        let empty: [ast.CallArg] = []
        return self.compile_enum_construct(empty, :enum_idx, :variant_idx, span: self.p.expr_spans[dot_rhs])
    }

    func compile_dot(self, lhs: int64, rhs: int64) -> Val {
        if self.try_three_part_unit_variant(dot_lhs: lhs, dot_rhs: rhs) is Some(val) {
            return val
        }
        if self.try_two_part_unit_variant(dot_lhs: lhs, dot_rhs: rhs) is Some(val) {
            return val
        }
        let attempts_before = self.report_attempts
        let ptr_v = self.compile_expr(lhs)
        let ptr_r = self.load(ptr_v)
        match self.p.exprs[rhs] {
            .Ident(field_name) -> {
                // Resolve the struct via infer_kind so chained accesses
                // (e.g. obj.field, arr[i].field) work, not just Ident lhs.
                mut field_off = 0
                let lhs_kind: TypeKind = self.infer_kind(lhs)
                if lhs_kind is .KStruct(struct_idx, _struct_type_args) {
                    if self.check_field(field_name, :struct_idx, span: self.p.expr_spans[rhs]) {
                        field_off = self.find_field_offset(field_name, :struct_idx)
                    }
                } else {
                    if lhs_kind is .KUnknown {
                        self.report_cannot_infer(lhs, what: "this expression")
                    } else {
                        if self.report_attempts == attempts_before {
                            self.report_field_on_non_struct(field_name, kind: lhs_kind, span: self.p.expr_spans[rhs], optional_hint: f"; did you mean `?.{field_name}`?")
                        }
                    }
                }
                mut result = self.pool.alloc_reg()
                self.emit(f"ldr {result}, [{ptr_r}, #{field_off}]")
                self.pool.free_reg(ptr_r)
                return .VReg(name: result)
            }
            else none
        }
        self.pool.free_reg(ptr_r)
        return .VImm(value: 0)
    }

    func find_var_offset_by_lhs(self, anon expr_id: int64) -> int64 {
        match self.p.exprs[expr_id] {
            .Ident(name) -> return self.find_var_offset(name)
            else return -8
        }
    }

    func compile_index(self, lhs: int64, rhs: int64) -> Val {
        let lhs_kind = self.infer_kind(lhs)
        if lhs_kind is .KUnknown {
            self.compile_discard(lhs)
            self.report_cannot_infer(lhs, what: "this expression")
            self.compile_discard(rhs)
            return .VImm(value: 0)
        }
        // Struct with op_index — dispatch as a method call.
        match lhs_kind {
            .KStruct(idx, _struct_type_args) -> {
                if self.structs[idx].method_idx.get("op_index") is Some(mi) {
                    let sig = self.structs[idx].methods[mi].sig
                    if self.takes_self_and(sig, count: 1) == false {
                        self.compile_discard(lhs)
                        self.compile_discard(rhs)
                        self.report_error(f"error: `{self.struct_display_name(idx)}.op_index` must take one key", span: self.p.expr_spans[lhs])
                        return .VImm(value: 0)
                    }
                    if self.emits_nothing(lhs) or self.emits_nothing(rhs) {
                        let key_reg = self.compile_key(rhs, kind: sig.param_kinds[1])
                        let key_spilled = self.preserve_begin(key_reg)
                        self.mov_to(self.compile_expr(lhs), dest: "x0")
                        let key_r = self.preserve_end(key_reg, spilled: key_spilled)
                        self.emit(f"mov x1, {key_r}")
                        self.pool.free_reg(key_r)
                    } else {
                        let parked = self.park_value(self.compile_expr(lhs))
                        let key_r = self.compile_key(rhs, kind: sig.param_kinds[1])
                        self.mov_to(.VReg(name: self.unpark_value(parked)), dest: "x0")
                        self.emit(f"mov x1, {key_r}")
                        self.pool.free_reg(key_r)
                    }
                    mut method_lbl = f"${self.structs[idx].module_prefix}${self.structs[idx].name}$op_index"
                    self.emit(f"bl {method_lbl}")
                    return .VReg(name: "x0")
                }
            }
            else none
        }
        let array_like = self.is_array_kind(lhs_kind)
        if array_like == false {
            if self.is_str_or_bytes(lhs_kind) == false {
                self.compile_discard(lhs)
                self.compile_discard(rhs)
                if self.kind_has_unknown(lhs_kind) == false {
                    self.report_error(f"error: cannot index a value of type `{self.kind_display(lhs_kind)}`{self.index_error_note(lhs_kind, method: "op_index", value_id: lhs)}", span: self.p.expr_spans[lhs])
                }
                return .VImm(value: 0)
            }
        }
        let ptr_v = self.compile_expr(lhs)
        mut ptr_r = ""
        mut idx_r = ""
        if self.emits_nothing(lhs) or self.emits_nothing(rhs) {
            let idx_v = self.compile_expr(rhs)
            self.check_int_operand(rhs, what: "an index")
            ptr_r = self.load(ptr_v)
            idx_r = self.load(idx_v)
        } else {
            let parked = self.park_value(ptr_v)
            let idx_v = self.compile_expr(rhs)
            self.check_int_operand(rhs, what: "an index")
            idx_r = self.load(idx_v)
            ptr_r = self.unpark_value(parked)
        }
        mut result = self.pool.alloc_reg()
        if array_like {
            // Normalise negative index: if idx < 0, idx += len.
            let pos_lbl = self.fresh("Lidx_pos")
            let len_r = self.pool.alloc_reg()
            self.emit(f"ldr {len_r}, [{ptr_r}, #8]")
            self.emit(f"cmp {idx_r}, #0")
            self.emit(f"bge {pos_lbl}")
            self.emit(f"add {idx_r}, {idx_r}, {len_r}")
            self.emit_label(pos_lbl)
            // Bounds check via unsigned compare: catches both idx >= len
            // and idx < 0 (negative signed → huge unsigned), and skips
            // ahead to load on success. Forward branch to the panic
            // call to keep the hot path (no panic) straight-line.
            let ok_lbl = self.fresh("Lidx_ok")
            let oob_lbl = self.fresh("Lidx_oob")
            self.emit(f"cmp {idx_r}, {len_r}")
            self.emit(f"b.hs {oob_lbl}")
            self.emit(f"b {ok_lbl}")
            self.emit_label(oob_lbl)
            self.emit(f"mov x0, {idx_r}")
            self.emit(f"mov x1, {len_r}")
            self.emit("bl _kod_index_oob")
            self.emit_label(ok_lbl)
            self.pool.free_reg(len_r)

            let hdr = self.pool.alloc_reg()
            self.emit(f"ldr {hdr}, [{ptr_r}]")
            self.emit(f"lsl {idx_r}, {idx_r}, #3")
            self.emit(f"ldr {result}, [{hdr}, {idx_r}]")
            self.pool.free_reg(hdr)
        } else {
            // KStr indexing. ptr_r is the `{ buf, len }` struct pointer.
            // Load buf and len, normalise negative, bounds-check, then
            // a one-byte read from buf — same shape as the array path.
            let len_r = self.pool.alloc_reg()
            self.emit(f"ldr {len_r}, [{ptr_r}, #8]")
            let buf_r = self.pool.alloc_reg()
            self.emit(f"ldr {buf_r}, [{ptr_r}]")
            let pos_lbl = self.fresh("Lidx_pos")
            self.emit(f"cmp {idx_r}, #0")
            self.emit(f"bge {pos_lbl}")
            self.emit(f"add {idx_r}, {idx_r}, {len_r}")
            self.emit_label(pos_lbl)
            let ok_lbl = self.fresh("Lidx_ok")
            let oob_lbl = self.fresh("Lidx_oob")
            self.emit(f"cmp {idx_r}, {len_r}")
            self.emit(f"b.hs {oob_lbl}")
            self.emit(f"b {ok_lbl}")
            self.emit_label(oob_lbl)
            self.emit(f"mov x0, {idx_r}")
            self.emit(f"mov x1, {len_r}")
            self.emit("bl _kod_index_oob")
            self.emit_label(ok_lbl)
            self.pool.free_reg(len_r)
            self.emit(f"ldrb w{result[1..len(result)]}, [{buf_r}, {idx_r}]")
            self.pool.free_reg(buf_r)
        }
        self.pool.free_reg(ptr_r)
        self.pool.free_reg(idx_r)
        return .VReg(name: result)
    }

    func compile_and(self, lhs: int64, rhs: int64) -> Val {
        let done = self.fresh("Land")
        mut result = self.pool.alloc_reg()
        let lhs_val = self.compile_expr(lhs)
        self.check_bool(lhs, need: "`and` needs `bool` operands", optional_hint: "; test it with `is not none`")
        self.mov_to(lhs_val, dest: result)
        self.emit(f"cmp {result}, #0")
        self.emit(f"cset {result}, ne")
        self.emit(f"beq {done}")
        let rhs_val = self.compile_expr(rhs)
        self.check_bool(rhs, need: "`and` needs `bool` operands", optional_hint: "; test it with `is not none`")
        self.mov_to(rhs_val, dest: result)
        self.emit(f"cmp {result}, #0")
        self.emit(f"cset {result}, ne")
        self.emit_label(done)
        return .VReg(name: result)
    }

    func compile_or(self, lhs: int64, rhs: int64) -> Val {
        let done = self.fresh("Lor")
        mut result = self.pool.alloc_reg()
        let lhs_val = self.compile_expr(lhs)
        let default_hint = f"; did you mean `{self.unwrap_name(lhs)}? or default`?"
        self.check_bool(lhs, need: "`or` needs `bool` operands", optional_hint: default_hint)
        self.mov_to(lhs_val, dest: result)
        self.emit(f"cmp {result}, #0")
        self.emit(f"cset {result}, ne")
        self.emit(f"bne {done}")
        let rhs_val = self.compile_expr(rhs)
        self.check_bool(rhs, need: "`or` needs `bool` operands", optional_hint: "; test it with `is not none`")
        self.mov_to(rhs_val, dest: result)
        self.emit(f"cmp {result}, #0")
        self.emit(f"cset {result}, ne")
        self.emit_label(done)
        return .VReg(name: result)
    }

    // The callee/identifier name of an `is` right-hand side, e.g. "Ok" for
    // `is Ok(v)` or `is Ok`, "" if it isn't a bare name / simple call.
    func is_pattern_name(self, anon expr_id: int64) -> str {
        match self.p.exprs[expr_id] {
            .Ident(name) -> return name
            .ImplicitVariant(name) -> return name
            .Call(callee, _args) -> return self.is_pattern_name(callee)
            else none
        }
        return ""
    }

    // `T`, `T(b)`, `alias.T` or `alias.T(b)`: the struct an interface downcast names.
    func downcast_name(self, anon expr_id: int64) -> str {
        mut callee = expr_id
        if self.p.exprs[expr_id] is .Call(call_callee, _args) {
            callee = call_callee
        }
        if self.p.exprs[callee] is .Binary(lhs, op, rhs) {
            if op is .Dot {
                if self.p.exprs[lhs] is .Ident(alias) {
                    if self.is_import_alias(alias) {
                        if self.p.exprs[rhs] is .Ident(name) {
                            return name
                        }
                    }
                }
            }
        }
        return self.is_pattern_name(expr_id)
    }

    // `Option.Some` and `Result.Ok` name the variants `T?` and `T or Error` test.
    func std_pattern_name(self, anon expr_id: int64, std_enum: str) -> str {
        mut callee = expr_id
        if self.p.exprs[expr_id] is .Call(call_callee, _args) {
            callee = call_callee
        }
        if self.p.exprs[callee] is .Binary(lhs, op, rhs) {
            if op is .Dot {
                if self.p.exprs[lhs] is .Ident(enum_name) {
                    if enum_name == std_enum and self.var_bound(enum_name) == false {
                        if self.p.exprs[rhs] is .Ident(name) {
                            return name
                        }
                    }
                }
            }
        }
        return self.is_pattern_name(expr_id)
    }

    func compile_is(self, lhs: int64, rhs: int64, negate: bool) -> Val {
        // Each branch below picks one of two ARM64 condition codes per
        // emit site: `cond_match` (the original "match" condition) and
        // `cond_no_match`. Negation just swaps the pair, since `is not`
        // means "give the opposite boolean".
        mut cond_match: str = "eq"
        mut cond_no_match: str = "ne"
        if negate {
            cond_match = "ne"
            cond_no_match = "eq"
        }
        let lhs_kind = self.infer_kind(lhs)
        if lhs_kind is .KUnknown {
            self.compile_discard(lhs)
            self.report_cannot_infer(lhs, what: "this expression")
            return .VImm(value: 0)
        }
        let binding = self.is_rhs_binding(rhs)
        if len(binding) > 0 {
            self.compile_discard(lhs)
            self.report_error(f"error: `is` can't bind `{binding}` here; a pattern binds names only as the whole condition of an `if`", span: self.p.expr_spans[rhs])
            return .VImm(value: 0)
        }
        // Interface downcast: `e is StructType` — compare the value's vtable
        // (cell offset 8) against the (StructType, iface) vtable's address.
        if lhs_kind is .KInterface(iface_idx) {
            let type_name = self.downcast_name(rhs)
            let struct_idx = self.find_struct_idx(type_name)
            if struct_idx < 0 {
                self.report_error(f"error: `is {type_name}` — `{type_name}` is not a struct type", span: self.p.expr_spans[rhs])
                return .VImm(value: 0)
            }
            let vt_lbl = self.register_vtable(struct_idx, iface_idx)
            let ptr_v = self.compile_expr(lhs)
            mut reg = self.load(ptr_v)
            self.emit(f"ldr {reg}, [{reg}, #8]")
            let exp = self.pool.alloc_reg()
            self.emit(f"adrp {exp}, {vt_lbl}@PAGE")
            self.emit(f"add {exp}, {exp}, {vt_lbl}@PAGEOFF")
            self.emit(f"cmp {reg}, {exp}")
            self.emit(f"cset {reg}, {cond_match}")
            self.pool.free_reg(exp)
            return .VReg(name: reg)
        }
        // `T or Error` result: test the discriminant against Ok's disc.
        if self.is_result_kind(lhs_kind) {
            let name = self.std_pattern_name(rhs, std_enum: "Result")
            if name != "Ok" and name != "Err" {
                self.compile_discard(lhs)
                self.report_error("error: `is` on a `T or Error` value takes `Ok` or `Err`", span: self.p.expr_spans[rhs])
                return .VImm(value: 0)
            }
            let ptr_v = self.compile_expr(lhs)
            mut reg = self.load(ptr_v)
            self.emit(f"ldr {reg}, [{reg}]")
            self.emit(f"cmp {reg}, #{self.result_ok_disc()}")
            if name == "Ok" {
                self.emit(f"cset {reg}, {cond_match}")
            } else {
                self.emit(f"cset {reg}, {cond_no_match}")
            }
            return .VReg(name: reg)
        }
        if lhs_kind is .KEnum(enum_idx) {
            let variant_idx = self.ctor_variant_idx(rhs, :enum_idx)
            if variant_idx < 0 {
                self.compile_discard(lhs)
                let name = self.is_pattern_name(rhs)
                if len(name) > 0 {
                    self.check_variant(name, :enum_idx, span: self.p.expr_spans[rhs])
                } else {
                    self.report_error(f"error: `is` on a `{self.enum_display_name(enum_idx)}` value takes one of its variants", span: self.p.expr_spans[rhs])
                }
                return .VImm(value: 0)
            }
            let ptr_v = self.compile_expr(lhs)
            mut reg = self.load(ptr_v)
            self.emit(f"ldr {reg}, [{reg}]")
            self.emit(f"cmp {reg}, #{self.enums[enum_idx].variants[variant_idx].discriminant}")
            self.emit(f"cset {reg}, {cond_match}")
            return .VReg(name: reg)
        }
        mut is_optional: bool = false
        if lhs_kind is .KOptional(_inner) {
            is_optional = true
        }
        if is_optional == false {
            self.report_error("error: `is` requires an optional, `T or Error`, enum or interface value", span: self.p.expr_spans[lhs])
        }
        let opt_name = self.std_pattern_name(rhs, std_enum: "Option")
        mut tests_none = opt_name == "None"
        if self.p.exprs[rhs] is .NoneLit {
            tests_none = true
        }
        if is_optional and tests_none == false and opt_name != "Some" {
            self.report_error("error: `is` on an optional takes `none` or `Some`", span: self.p.expr_spans[rhs])
        }
        let ptr_v = self.compile_expr(lhs)
        mut reg = self.load(ptr_v)
        self.emit(f"cmp {reg}, #0")
        if tests_none {
            self.emit(f"cset {reg}, {cond_match}")
        } else {
            self.emit(f"cset {reg}, {cond_no_match}")
        }
        return .VReg(name: reg)
    }

    // `_` and `_name` bind nothing.
    func is_rhs_binding(self, anon rhs: int64) -> str {
        if self.p.exprs[rhs] is .Call(_callee, args) {
            for arg in args {
                if self.p.exprs[arg.value] is .Ident(name) {
                    if name[0] != '_' {
                        return name
                    }
                }
            }
        }
        return ""
    }

    func compile_arith_cmp(self, lhs_id: int64, op: ast.Op, rhs_id: int64) -> Val {
        mut lhs_kind = self.infer_kind(lhs_id)
        let rhs_kind0 = self.infer_kind(rhs_id)
        let build_rhs = self.is_eq_ctor_operand(rhs_id, :op, other_kind: lhs_kind)
        mut build_lhs = false
        if build_rhs == false {
            build_lhs = self.is_eq_ctor_operand(lhs_id, :op, other_kind: rhs_kind0)
        }
        if build_lhs {
            lhs_kind = rhs_kind0
        }
        if build_rhs == false and build_lhs == false {
            mut variant_side = -1
            if self.reports_missing_eq_variant(rhs_id, :op, other_kind: lhs_kind) {
                variant_side = rhs_id
            } else if self.reports_missing_eq_variant(lhs_id, :op, other_kind: rhs_kind0) {
                variant_side = lhs_id
            }
            if variant_side >= 0 {
                if variant_side == rhs_id {
                    self.compile_discard(lhs_id)
                } else {
                    self.compile_discard(rhs_id)
                }
                return .VImm(value: 0)
            }
        }
        if op is .Add {
            let chain_kind = self.concat_kind(lhs_id, :rhs_id)
            if self.is_array_kind(chain_kind) {
                lhs_kind = chain_kind
            }
        }
        mut lhs_unknown = false
        if lhs_kind is .KUnknown {
            lhs_unknown = true
        }
        mut rhs_unknown = false
        if rhs_kind0 is .KUnknown {
            rhs_unknown = build_rhs == false and self.builds_for_operand(rhs_id, op: op, other_kind: lhs_kind) == false
        }
        if lhs_unknown or rhs_unknown {
            self.compile_discard(lhs_id)
            if lhs_unknown {
                self.report_cannot_infer(lhs_id, what: "this expression")
            }
            self.compile_discard(rhs_id)
            if rhs_unknown {
                self.report_cannot_infer(rhs_id, what: "this expression")
            }
            return .VImm(value: 0)
        }
        let attempts_before = self.report_attempts
        self.check_bool_operands(:lhs_id, :op, :rhs_id, :lhs_kind)
        if self.report_attempts == attempts_before {
            self.check_optional_operands(:lhs_id, :op, :rhs_id, :lhs_kind)
        }
        if self.report_attempts == attempts_before {
            mut rhs_kind = rhs_kind0
            if build_rhs {
                rhs_kind = lhs_kind
            }
            self.check_operand_kinds(:lhs_id, :op, :rhs_id, :lhs_kind, :rhs_kind)
        }
        // Comparing against `none` only makes sense for optional types;
        // for other kinds it would silently compile to `x == 0`.
        mut is_eq_or_ne: bool = false
        if op is .Eq {
            is_eq_or_ne = true
        }
        if op is .Ne {
            is_eq_or_ne = true
        }
        if is_eq_or_ne {
            mut lhs_is_none: bool = false
            if self.p.exprs[lhs_id] is .NoneLit {
                lhs_is_none = true
            }
            mut rhs_is_none: bool = false
            if self.p.exprs[rhs_id] is .NoneLit {
                rhs_is_none = true
            }
            if lhs_is_none and rhs_is_none == false {
                let rhs_kind = self.infer_kind(rhs_id)
                mut rhs_is_opt: bool = false
                if rhs_kind is .KOptional(_inner) {
                    rhs_is_opt = true
                }
                if rhs_is_opt == false {
                    self.report_error("error: cannot compare non-optional value with `none`", span: self.p.expr_spans[rhs_id])
                }
            }
            if rhs_is_none and lhs_is_none == false {
                mut lhs_is_opt: bool = false
                if lhs_kind is .KOptional(_inner) {
                    lhs_is_opt = true
                }
                if lhs_is_opt == false {
                    self.report_error("error: cannot compare non-optional value with `none`", span: self.p.expr_spans[lhs_id])
                }
            }
        }
        if self.is_str_or_bytes(lhs_kind) {
            let cond = self.str_cmp_cond(op)
            if len(cond) > 0 {
                return self.compile_str_cmp(:lhs_id, :rhs_id, :cond)
            }
        }
        match op {
            .Add -> {
                match lhs_kind {
                    .KStr -> return self.compile_str_concat(:lhs_id, :rhs_id)
                    .KBytes -> return self.compile_str_concat(:lhs_id, :rhs_id)
                    else none
                }
                if self.is_array_kind(lhs_kind) {
                    return self.compile_concat(:lhs_id, :rhs_id, kind: lhs_kind, typed_anchor: 0)
                }
            }
            else none
        }

        // Compile both sides, stashing the lhs on the stack across the rhs
        // compilation so its value survives any bl calls in rhs.
        mut lv_r = ""
        if build_lhs {
            lv_r = self.compile_value_for_kind(lhs_id, expected: lhs_kind)
            self.emit(f"ldr {lv_r}, [{lv_r}]")
        } else {
            let lhs_val = self.compile_expr(lhs_id)
            lv_r = self.load_enum_or_val(lhs_val, expr_id: lhs_id)
        }
        // Past the callee-saved registers a right-nested chain parks each lhs on the stack.
        mut parked = ""
        if self.pool.next_is_callee_saved() {
            parked = self.pool.alloc_reg()
            if lv_r != parked {
                self.emit(f"mov {parked}, {lv_r}")
            }
            self.pool.free_reg(lv_r)
        } else {
            parked = self.park_value(.VReg(name: lv_r))
        }
        mut rhs_reg = ""
        if build_rhs {
            rhs_reg = self.compile_value_for_kind(rhs_id, expected: lhs_kind)
            self.emit(f"ldr {rhs_reg}, [{rhs_reg}]")
        } else {
            let rhs_val = self.compile_expr(rhs_id)
            rhs_reg = self.load_enum_or_val(rhs_val, expr_id: rhs_id)
        }
        let lhs_reg = self.unpark_value(parked)
        mut result = self.pool.alloc_reg()
        match op {
            .Eq -> {
                self.emit(f"cmp {lhs_reg}, {rhs_reg}")
                self.emit(f"cset {result}, eq")
            }
            .Ne -> {
                self.emit(f"cmp {lhs_reg}, {rhs_reg}")
                self.emit(f"cset {result}, ne")
            }
            .Lt -> {
                self.emit(f"cmp {lhs_reg}, {rhs_reg}")
                self.emit(f"cset {result}, lt")
            }
            .Le -> {
                self.emit(f"cmp {lhs_reg}, {rhs_reg}")
                self.emit(f"cset {result}, le")
            }
            .Gt -> {
                self.emit(f"cmp {lhs_reg}, {rhs_reg}")
                self.emit(f"cset {result}, gt")
            }
            .Ge -> {
                self.emit(f"cmp {lhs_reg}, {rhs_reg}")
                self.emit(f"cset {result}, ge")
            }
            .Add -> {
                self.emit(f"add {result}, {lhs_reg}, {rhs_reg}")
            }
            .Sub -> {
                self.emit(f"sub {result}, {lhs_reg}, {rhs_reg}")
            }
            .Mul -> {
                self.emit(f"mul {result}, {lhs_reg}, {rhs_reg}")
            }
            .Div -> {
                self.emit(f"sdiv {result}, {lhs_reg}, {rhs_reg}")
            }
            .Mod -> {
                let tmp2 = self.pool.alloc_reg()
                self.emit(f"sdiv {result}, {lhs_reg}, {rhs_reg}")
                self.emit(f"mul {tmp2}, {result}, {rhs_reg}")
                self.emit(f"sub {result}, {lhs_reg}, {tmp2}")
                self.pool.free_reg(tmp2)
            }
            .BitAnd -> {
                self.emit(f"and {result}, {lhs_reg}, {rhs_reg}")
            }
            .BitOr -> {
                self.emit(f"orr {result}, {lhs_reg}, {rhs_reg}")
            }
            .BitXor -> {
                self.emit(f"eor {result}, {lhs_reg}, {rhs_reg}")
            }
            .Shl -> {
                self.emit(f"lsl {result}, {lhs_reg}, {rhs_reg}")
            }
            .Shr -> {
                // Logical (unsigned) right shift — treats int64 as a
                // raw bit pattern, fills with zeros. Matches the
                // bit-twiddling idioms (CRC32, Huffman, …) where the
                // operand is conceptually an unsigned integer.
                self.emit(f"lsr {result}, {lhs_reg}, {rhs_reg}")
            }
            else {
                self.emit(f"cmp {lhs_reg}, {rhs_reg}")
                self.emit(f"cset {result}, eq")
            }
        }
        self.pool.free_reg(lhs_reg)
        self.pool.free_reg(rhs_reg)
        return .VReg(name: result)
    }

    // So `e == .V` with a `.V` missing from `e`'s enum names `e`'s enum.
    func reports_missing_eq_variant(self, anon value_id: int64, op: ast.Op, other_kind: TypeKind) -> bool {
        if op is .Eq or op is .Ne {
            let .KEnum(idx) = other_kind else { return false }
            mut callee = value_id
            if self.p.exprs[value_id] is .Call(call_callee, _args) {
                callee = call_callee
            }
            let .ImplicitVariant(name) = self.p.exprs[callee] else { return false }
            if self.find_variant_idx(name, enum_idx: idx) >= 0 {
                return false
            }
            self.check_variant(name, enum_idx: idx, span: self.p.expr_spans[value_id])
            return true
        }
        return false
    }

    // In `e == .V` the variant, or each arm of a `match`, belongs to `e`'s enum.
    func is_eq_ctor_operand(self, anon value_id: int64, op: ast.Op, other_kind: TypeKind) -> bool {
        mut equality = false
        if op is .Eq {
            equality = true
        }
        if op is .Ne {
            equality = true
        }
        if equality {
            if other_kind is .KEnum(_idx) {
                if self.p.exprs[value_id] is .MatchExpr(_subject, _arms) {
                    return true
                }
                return self.is_ctor_for(value_id, kind: other_kind)
            }
        }
        return false
    }

    // An appended literal or match is built as the array's element kind.
    func builds_for_operand(self, anon value_id: int64, op: ast.Op, other_kind: TypeKind) -> bool {
        if op is .Add {
            if self.is_array_kind(other_kind) {
                return self.converts_for(value_id, kind: other_kind)
            }
        }
        return false
    }

    // Literals and matches take a chain's kind, so its other operands decide it.
    func concat_kind(self, anon lhs_id: int64, rhs_id: int64) -> TypeKind {
        mut anchor = self.first_concat_anchor(lhs_id)
        if anchor == 0 {
            anchor = self.first_concat_anchor(rhs_id)
        }
        if anchor != 0 {
            return self.infer_kind(anchor)
        }
        let k = self.first_inferred_kind(lhs_id)
        if k is .KUnknown {
            return self.first_inferred_kind(rhs_id)
        }
        return k
    }

    func first_concat_anchor(self, anon value_id: int64) -> int64 {
        if self.p.exprs[value_id] is .Binary(lhs, op, rhs) {
            if op is .Add {
                let found = self.first_concat_anchor(lhs)
                if found != 0 {
                    return found
                }
                return self.first_concat_anchor(rhs)
            }
        }
        if self.is_literal_or_match(value_id) {
            return 0
        }
        return value_id
    }

    func first_inferred_kind(self, anon value_id: int64) -> TypeKind {
        if self.p.exprs[value_id] is .Binary(lhs, op, rhs) {
            if op is .Add {
                let k = self.first_inferred_kind(lhs)
                if k is .KUnknown {
                    return self.first_inferred_kind(rhs)
                }
                return k
            }
        }
        return self.infer_kind(value_id)
    }

    func load_enum_or_val(self, anon val: Val, expr_id: int64) -> str {
        match self.infer_kind(expr_id) {
            .KEnum(idx) -> {
                mut reg = self.load(val)
                self.emit(f"ldr {reg}, [{reg}]")
                return reg
            }
            else return self.load(val)
        }
    }

    // Bind an `Ok(x)` / `Err(e)` pattern's payload into `binding`'s slot.
    // The Result cell pointer is reloaded from subj_slot; the payload lives
    // at offset 8 (offset 0 is the discriminant). No-op for an empty binding.
    func bind_result_payload(self, anon binding: str, subj_slot: int64) -> none {
        if len(binding) > 0 {
            let boff = self.find_var_offset(binding)
            let ptr_r = self.pool.alloc_reg()
            self.emit_ldr(subj_slot, reg: ptr_r)
            let val_r = self.pool.alloc_reg()
            self.emit(f"ldr {val_r}, [{ptr_r}, #8]")
            self.emit_str(boff, reg: val_r)
            self.pool.free_reg(val_r)
            self.pool.free_reg(ptr_r)
        }
    }

    // Variant arm test + payload binding, shared by match stmts and exprs.
    func emit_variant_test(self, anon pattern: ast.Pattern, subj_enum_idx: int64, disc_r: str, subj_slot: int64, skip_lbl: str, span: ast.Span) -> none {
        mut enum_name = ""
        mut variant_name = ""
        mut bindings: [str] = []
        match pattern {
            .EnumPat(e, v, b) -> {
                enum_name = e
                variant_name = v
                bindings = b
            }
            .ImplicitEnumPat(v, b) -> {
                variant_name = v
                bindings = b
            }
            else none
        }
        let enum_idx = self.pattern_enum_idx(:enum_name, :variant_name, :subj_enum_idx, :span)
        mut variant_idx = -1
        if enum_idx >= 0 {
            variant_idx = self.pattern_variant_idx(enum_idx, :variant_name, binding_count: len(bindings), :span)
        }
        if variant_idx < 0 {
            self.emit(f"b {skip_lbl}")
            return
        }
        let vinfo = self.enums[enum_idx].variants[variant_idx]
        self.emit(f"cmp {disc_r}, #{vinfo.discriminant}")
        self.emit(f"bne {skip_lbl}")
        mut key_idx = 0
        for binding in bindings {
            let foff = vinfo.field_offsets[key_idx]
            let binding_off = self.find_var_offset(binding)
            let ptr_r = self.pool.alloc_reg()
            self.emit_ldr(subj_slot, reg: ptr_r)
            let fv_r = self.pool.alloc_reg()
            self.emit(f"ldr {fv_r}, [{ptr_r}, #{8 + foff}]")
            self.emit_str(binding_off, reg: fv_r)
            self.pool.free_reg(fv_r)
            self.pool.free_reg(ptr_r)
            key_idx = key_idx + 1
        }
    }

    // Emit a `TypePat` arm's test: compare the interface value's vtable
    // (cell offset 8) against the (type_name, iface) vtable; branch to
    // skip_lbl on mismatch. On match, bind the concrete pointer (offset 0)
    // — typed `KStruct` — into `binding`'s slot.
    func emit_typepat_test(self, type_name: str, binding: str, subject_id: int64, subj_slot: int64, skip_lbl: str) -> none {
        let struct_idx = self.find_struct_idx(type_name)
        if struct_idx < 0 {
            self.report_error(f"error: `{type_name}` is not a struct type", span: self.p.expr_spans[subject_id])
            return none
        }
        mut iface_idx = -1
        if self.infer_kind(subject_id) is .KInterface(ii) {
            iface_idx = ii
        }
        let vt_lbl = self.register_vtable(struct_idx, iface_idx)
        let ptr_r = self.pool.alloc_reg()
        self.emit_ldr(subj_slot, reg: ptr_r)
        let vt_r = self.pool.alloc_reg()
        self.emit(f"ldr {vt_r}, [{ptr_r}, #8]")
        let exp_r = self.pool.alloc_reg()
        self.emit(f"adrp {exp_r}, {vt_lbl}@PAGE")
        self.emit(f"add {exp_r}, {exp_r}, {vt_lbl}@PAGEOFF")
        self.emit(f"cmp {vt_r}, {exp_r}")
        self.emit(f"bne {skip_lbl}")
        self.pool.free_reg(vt_r)
        self.pool.free_reg(exp_r)
        if len(binding) > 0 {
            let boff = self.find_var_offset(binding)
            let dv_r = self.pool.alloc_reg()
            self.emit(f"ldr {dv_r}, [{ptr_r}]")
            self.emit_str(boff, reg: dv_r)
            self.pool.free_reg(dv_r)
        }
        self.pool.free_reg(ptr_r)
    }

    // The `cset` condition for comparing two str or bytes values, or "" for other ops.
    func str_cmp_cond(self, anon op: ast.Op) -> str {
        match op {
            .Eq -> return "eq"
            .Ne -> return "ne"
            .Lt -> return "lt"
            .Le -> return "le"
            .Gt -> return "gt"
            .Ge -> return "ge"
            else return ""
        }
    }

    func compile_str_cmp(self, lhs_id: int64, rhs_id: int64, cond: str) -> Val {
        self.compile_str_operands(lhs_id, :rhs_id)
        // `kod_str_cmp` takes two KodStr pointers and returns 0 / ±n
        // like memcmp. Replaces the previous `_strcmp` call, which
        // would have compared struct headers byte-by-byte (and stopped
        // at the first 0 in the embedded len field).
        self.emit("bl _kod_str_cmp")
        mut result = self.pool.alloc_reg()
        self.emit("cmp x0, #0")
        self.emit(f"cset {result}, {cond}")
        return .VReg(name: result)
    }

    // Compile `expr_id` and coerce the result to a `str` value. Used for
    // f-string interpolations and `str + X` concatenation so that non-string
    // values are rendered before being passed to _kod_str_concat. Lowering
    // matches the Stringable interface from stdlib/builtins.kod:
    //   - KStr        : already a string, pass through
    //   - KInt64      : bl $primitives$int64$to_str
    //   - KBool       : bl $primitives$bool$to_str
    //   - KStruct(si) : if the struct defines a `to_str` method, call it
    //   - anything else: best-effort pass-through (likely garbage, but
    //                    we don't have a string representation for it yet)
    func compile_as_str(self, anon expr_id: int64) -> Val {
        mut k = self.infer_kind(expr_id)
        mut bad_to_str = false
        match k {
            .KStr -> return self.compile_expr(expr_id)
            .KInt64 -> {
                let val = self.compile_expr(expr_id)
                self.mov_to(val, dest: "x0")
                self.emit("bl $primitives$int64$to_str")
                return .VReg(name: "x0")
            }
            .KBool -> {
                let val = self.compile_expr(expr_id)
                self.mov_to(val, dest: "x0")
                self.emit("bl $primitives$bool$to_str")
                return .VReg(name: "x0")
            }
            .KBytes -> return self.compile_expr(expr_id)
            .KStruct(struct_idx, _struct_type_args) -> {
                if self.structs[struct_idx].method_idx.get("to_str") is Some(mi) {
                    bad_to_str = self.is_to_str_sig(self.structs[struct_idx].methods[mi].sig) == false
                    if bad_to_str == false {
                        let val = self.compile_expr(expr_id)
                        self.mov_to(val, dest: "x0")
                        let struct_info = self.structs[struct_idx]
                        self.emit(f"bl ${struct_info.module_prefix}${struct_info.name}$to_str")
                        return .VReg(name: "x0")
                    }
                }
            }
            .KInterface(iface_idx) -> {
                for m in self.interfaces[iface_idx].methods {
                    if m.name == "to_str" {
                        bad_to_str = self.is_to_str_sig(m.sig) == false
                        if bad_to_str == false {
                            let no_args: [ast.CallArg] = []
                            return self.compile_iface_method_call(no_args, receiver_id: expr_id, :iface_idx, method_name: "to_str", span: self.p.expr_spans[expr_id])
                        }
                    }
                }
            }
            .KUnknown -> {
                let val = self.compile_expr(expr_id)
                self.report_cannot_infer(expr_id, what: "this expression")
                return val
            }
            else none
        }
        self.compile_discard(expr_id)
        if self.kind_has_unknown(k) {
            return .VImm(value: 0)
        }
        let shown = self.kind_display(k)
        mut note = ""
        match k {
            .KOptional(_inner) -> {
                if self.is_none_kind(k) == false {
                    note = self.unwrap_hint(expr_id)
                }
            }
            .KStruct(_idx, _type_args) -> note = f"; `{shown}` has no `to_str` method"
            .KInterface(_idx) -> note = f"; `{shown}` doesn't declare `to_str`"
            else none
        }
        if bad_to_str {
            note = f"; `{shown}.to_str` isn't `func to_str(self) -> str`"
        }
        self.report_error(f"error: cannot convert a value of type `{shown}` to `str`{note}", span: self.p.expr_spans[expr_id])
        return .VImm(value: 0)
    }

    func compile_str_concat(self, lhs_id: int64, rhs_id: int64) -> Val {
        // Both operands must already be `str`. Non-string operands need an
        // explicit conversion (`one + str(other)` or, equivalently, an
        // f-string `f"{one}{other}"`).
        self.compile_str_operands(lhs_id, :rhs_id)
        self.emit("bl _kod_str_concat")
        return .VReg(name: "x0")
    }

    // Left to right: the lhs may come back in x0 and the rhs may call.
    func compile_str_operands(self, anon lhs_id: int64, rhs_id: int64) -> none {
        let lhs_val = self.compile_expr(lhs_id)
        if self.emits_nothing(lhs_id) or self.emits_nothing(rhs_id) {
            self.mov_to(self.compile_expr(rhs_id), dest: "x1")
            self.mov_to(lhs_val, dest: "x0")
            return
        }
        let parked = self.park_lhs(lhs_val)
        self.mov_to(self.compile_expr(rhs_id), dest: "x1")
        self.unpark_lhs(parked)
    }

    // Right-nested chains park one per level, so past x19-x27 they use the stack.
    func park_lhs(self, anon val: Val) -> str {
        if self.pool.next_is_callee_saved() {
            let reg = self.pool.alloc_reg()
            self.mov_to(val, dest: reg)
            return reg
        }
        self.mov_to(val, dest: "x0")
        self.emit("sub sp, sp, #16")
        self.emit("str x0, [sp]")
        return ""
    }

    func unpark_lhs(self, anon reg: str) -> none {
        if len(reg) == 0 {
            self.emit("ldr x0, [sp]")
            self.emit("add sp, sp, #16")
            return
        }
        self.emit(f"mov x0, {reg}")
        self.pool.free_reg(reg)
    }

    // A callee-saved register for the value, or "" when it's on the stack.
    func park_value(self, anon val: Val) -> str {
        if val is .VReg(name) {
            if self.pool.is_callee_saved(name) {
                return name
            }
        }
        if self.pool.next_is_callee_saved() {
            let reg = self.pool.alloc_reg()
            self.mov_to(val, dest: reg)
            return reg
        }
        let reg = self.load(val)
        self.emit("sub sp, sp, #16")
        self.emit(f"str {reg}, [sp]")
        self.pool.free_reg(reg)
        return ""
    }

    func unpark_value(self, anon parked: str) -> str {
        if len(parked) > 0 {
            return parked
        }
        let reg = self.pool.alloc_reg()
        self.emit(f"ldr {reg}, [sp]")
        self.emit("add sp, sp, #16")
        return reg
    }

    // Read only where it's moved, so neither operand needs parking across it.
    func emits_nothing(self, anon expr_id: int64) -> bool {
        match self.p.exprs[expr_id] {
            .IntLit(_value) -> return true
            .StrLit(_value) -> return true
            .BytesLit(_value) -> return true
            .Ident(name) -> return self.var_declared(name)
            else return false
        }
    }

    // `typed_anchor` is the first operand of a chain typed by where it goes, or 0.
    func compile_concat(self, lhs_id: int64, rhs_id: int64, kind: TypeKind, typed_anchor: int64) -> Val {
        let lhs_val = self.compile_concat_operand(lhs_id, :kind, :typed_anchor)
        if self.emits_nothing(lhs_id) or self.emits_nothing(rhs_id) {
            self.mov_to(self.compile_concat_operand(rhs_id, :kind, :typed_anchor), dest: "x1")
            self.mov_to(lhs_val, dest: "x0")
        } else {
            let parked = self.park_lhs(lhs_val)
            self.mov_to(self.compile_concat_operand(rhs_id, :kind, :typed_anchor), dest: "x1")
            self.unpark_lhs(parked)
        }
        if lhs_id == self.append_lhs_id and self.p.path == self.append_lhs_path {
            self.emit("bl _kod_array_concat")
        } else {
            self.emit("bl _kod_array_concat_new")
        }
        return .VReg(name: "x0")
    }

    func compile_concat_operand(self, anon value_id: int64, kind: TypeKind, typed_anchor: int64) -> Val {
        if self.p.exprs[value_id] is .Binary(lhs, op, rhs) {
            if op is .Add {
                return self.compile_concat(lhs_id: lhs, rhs_id: rhs, :kind, :typed_anchor)
            }
        }
        if self.is_literal_or_match(value_id) {
            if self.converts_for(value_id, :kind) {
                return .VReg(name: self.compile_into(value_id, expected: kind))
            }
            // Built as the chain's element type, so checked against that.
            let val = self.compile_typed_array_value(value_id, expected_elem: self.array_elem_kind(kind))
            self.check_value_kind(value_id, expected: kind)
            return val
        }
        let val = self.compile_expr(value_id)
        let actual = self.infer_kind(value_id)
        if actual is .KUnknown {
            self.report_cannot_infer(value_id, what: "this expression")
            return val
        }
        if self.kinds_compatible(kind, :actual) == false {
            mut msg = f"error: cannot concatenate `{self.kind_display(kind)}` and `{self.kind_display(actual)}`"
            if value_id == typed_anchor {
                msg = f"error: expected `{self.kind_display(kind)}`, got `{self.kind_display(actual)}`"
            }
            self.report_error(msg, span: self.p.expr_spans[value_id])
        }
        return val
    }

    func compile_slice(self, s_id: int64, lo_id: int64, hi_id: int64) -> Val {
        let s_kind = self.infer_kind(s_id)
        if self.is_array_kind(s_kind) == false {
            mut sliceable = self.is_str_or_bytes(s_kind)
            if s_kind is .KUnknown {
                sliceable = true
            }
            if sliceable == false {
                self.compile_discard(s_id)
                self.compile_discard(lo_id)
                if hi_id != 0 {
                    self.compile_discard(hi_id)
                }
                if self.kind_has_unknown(s_kind) == false {
                    self.report_error(f"error: cannot slice a value of type `{self.kind_display(s_kind)}`{self.index_error_note(s_kind, method: "", value_id: s_id)}", span: self.p.expr_spans[s_id])
                }
                return .VImm(value: 0)
            }
        }
        // Each part waits on the stack while the later ones, which may call, are computed.
        self.emit("sub sp, sp, #32")
        let s_r = self.load(self.compile_expr(s_id))
        self.emit(f"str {s_r}, [sp]")
        self.pool.free_reg(s_r)
        let lo_v = self.compile_expr(lo_id)
        self.check_int_operand(lo_id, what: "a slice bound")
        let lo_r = self.load(lo_v)
        self.emit(f"str {lo_r}, [sp, #8]")
        self.pool.free_reg(lo_r)
        // The parser stores hi=0 for `s[lo..]`, which runs to the end.
        if hi_id != 0 {
            let hi_v = self.compile_expr(hi_id)
            self.check_int_operand(hi_id, what: "a slice bound")
            let hi_r = self.load(hi_v)
            self.emit(f"str {hi_r}, [sp, #16]")
            self.pool.free_reg(hi_r)
        }
        self.emit("ldr x0, [sp]")
        self.emit("ldr x1, [sp, #8]")
        if hi_id == 0 {
            self.emit("ldr x2, [x0, #8]")
        } else {
            self.emit("ldr x2, [sp, #16]")
        }
        self.emit("add sp, sp, #32")
        // Dispatch to the runtime that matches the subject. Strings and
        // arrays have different cell layouts; the str routine returns
        // a KodStr while the array routine returns a KodArray.
        match self.infer_kind(s_id) {
            .KStr -> self.emit("bl _kod_str_slice")
            .KBytes -> self.emit("bl _kod_str_slice")
            .KUnknown -> self.report_cannot_infer(s_id, what: "this expression")
            else self.emit("bl _kod_array_slice")
        }
        return .VReg(name: "x0")
    }

    func compile_array_lit(self, anon elements: [int64]) -> Val {
        return self.compile_array_lit_typed(elements, expected_elem: .KVoid)
    }

    func elem_needs_conversion(self, anon kind: TypeKind) -> bool {
        match kind {
            .KEnum(_idx) -> return true
            .KInterface(_idx) -> return true
            .KOptional(_inner) -> return true
            else return self.array_needs_conversion(kind)
        }
    }

    // KVoid when the first element is `none`, `[]` or of unknown type.
    func first_elem_kind(self, anon elements: [int64]) -> TypeKind {
        if len(elements) < 2 or self.is_untyped_literal(elements[0]) {
            return .KVoid
        }
        let kind = self.infer_kind(elements[0])
        if self.kind_has_unknown(kind) or self.is_none_kind(kind) {
            return .KVoid
        }
        return kind
    }

    func array_needs_conversion(self, anon kind: TypeKind) -> bool {
        match kind {
            .KArrayEnum(_idx) -> return true
            .KArrayInterface(_idx) -> return true
            .KArrayOptional(_inner) -> return true
            .KArrayArray(inner) -> return self.array_needs_conversion(inner)
            else return false
        }
    }

    func is_literal_or_match(self, anon value_id: int64) -> bool {
        match self.p.exprs[value_id] {
            .ArrayLit(_elements) -> return true
            .MatchExpr(_subject, _arms) -> return true
            else return false
        }
    }

    func builds_array_for(self, anon value_id: int64, kind: TypeKind) -> bool {
        match self.p.exprs[value_id] {
            .ArrayLit(_elements) -> return self.array_needs_conversion(kind)
            .Binary(_lhs, op, _rhs) -> {
                if op is .Add {
                    return self.array_needs_conversion(kind)
                }
            }
            else none
        }
        return false
    }

    // Compile `value_id` into an array Val whose elements are guaranteed
    // wrapped/boxed for `expected_elem`. If the value is an array literal
    // we build it element-by-element through compile_array_lit_typed; if
    // it's anything else (variable, call, etc.) we trust the producer
    // already laid it out correctly and just compile in the usual way.
    func compile_typed_array_value(self, anon value_id: int64, expected_elem: TypeKind) -> Val {
        match self.p.exprs[value_id] {
            .ArrayLit(elements) -> return self.compile_array_lit_typed(elements, :expected_elem)
            .Binary(lhs, op, rhs) -> {
                if op is .Add {
                    return self.compile_concat(lhs_id: lhs, rhs_id: rhs, kind: self.array_kind_of(expected_elem), typed_anchor: self.first_concat_anchor(value_id))
                }
            }
            else none
        }
        return self.compile_expr(value_id)
    }

    // Build an arena-allocated array from `elements`. When `expected_elem`
    // is KInterface or KOptional, each element is boxed / wrapped to
    // match before storing — so `let xs: [Greet] = [Cat(), Dog()]`
    // populates the buf with iface cells, not raw struct pointers.
    // Pass `.KVoid` for `expected_elem` when there's no contextual
    // type (the element store is then a plain compile_expr + load).
    func compile_array_lit_typed(self, anon elements: [int64], expected_elem: TypeKind) -> Val {
        let n = len(elements)
        let item_sz = 8
        // Allocate header (24 bytes) and buf, saving both pointers on
        // the stack so element compilation (which may bl) doesn't
        // clobber them via pool-register reuse.
        self.emit("sub sp, sp, #16")
        self.emit("mov x0, #24")
        self.emit("bl _arena_alloc")
        self.emit("str x0, [sp]")
        mut buf_sz = n * item_sz
        if buf_sz < 8 {
            buf_sz = 8
        }
        self.emit_load_imm("x0", value: buf_sz)
        self.emit("bl _arena_alloc")
        self.emit("str x0, [sp, #8]")
        let typed = self.elem_needs_conversion(expected_elem)
        // With no type to go to, the literal takes its first element's.
        mut rest_kind: TypeKind = .KVoid
        if self.is_void_kind(expected_elem) {
            rest_kind = self.first_elem_kind(elements)
        }
        let check_rest = self.is_void_kind(rest_kind) == false
        let rest_typed = self.elem_needs_conversion(rest_kind)
        mut i = 0
        for i < n {
            mut elem_reg = ""
            if typed {
                elem_reg = self.compile_value_for_kind(elements[i], expected: expected_elem)
            } else if i > 0 and rest_typed {
                elem_reg = self.compile_into(elements[i], expected: rest_kind)
            } else {
                let elem_val = self.compile_expr(elements[i])
                self.report_if_unknown(elements[i])
                elem_reg = self.load(elem_val)
                if i > 0 and check_rest {
                    self.check_rest_elem(elements[i], first: rest_kind)
                }
            }
            // Reload buf from stack — any bl in compile_expr above would
            // have clobbered a pool-register copy.
            let buf_r = self.pool.alloc_reg()
            self.emit(f"ldr {buf_r}, [sp, #8]")
            self.emit(f"str {elem_reg}, [{buf_r}, #{i * item_sz}]")
            self.pool.free_reg(buf_r)
            self.pool.free_reg(elem_reg)
            i = i + 1
        }
        let hdr_r = self.pool.alloc_reg()
        let buf_r = self.pool.alloc_reg()
        self.emit(f"ldr {hdr_r}, [sp]")
        self.emit(f"ldr {buf_r}, [sp, #8]")
        self.emit("add sp, sp, #16")
        self.emit(f"str {buf_r}, [{hdr_r}]")
        let len_r = self.pool.alloc_reg()
        self.emit_load_imm(len_r, value: n)
        self.emit(f"str {len_r}, [{hdr_r}, #8]")
        self.emit(f"str {len_r}, [{hdr_r}, #16]")
        self.pool.free_reg(len_r)
        self.pool.free_reg(buf_r)
        return .VReg(name: hdr_r)
    }

    // `[Sq(..), Circle(..)]` is an `[Sq]`, so a shared interface was likely meant.
    func check_rest_elem(self, anon elem_id: int64, first: TypeKind) -> none {
        let actual = self.infer_kind(elem_id)
        let iface = self.shared_iface(first, actual)
        if iface < 0 or self.report_attempts > self.stmt_error_mark {
            self.check_value_kind(elem_id, expected: first)
            return
        }
        let shown = self.written_type_name(self.interfaces[iface].name, def_path: self.interfaces[iface].def_path)
        self.report_error(f"error: expected `{self.kind_display(first)}`, got `{self.kind_display(actual)}`; annotate the array to mix them, as in `let xs: [{shown}] = ...`", span: self.p.expr_spans[elem_id])
    }

    // A user interface with methods that both structs implement, or -1.
    func shared_iface(self, anon a: TypeKind, anon b: TypeKind) -> int64 {
        let .KStruct(a_idx, _a_args) = a else { return -1 }
        let .KStruct(b_idx, _b_args) = b else { return -1 }
        if self.same_struct(a_idx, b_idx) {
            return -1
        }
        mut i = 0
        for iface in self.interfaces {
            let reachable = iface.def_path == self.p.path or len(self.import_alias_of(iface.def_path)) > 0
            if reachable and len(iface.methods) > 0 and len(self.iface_gap(a, iface_idx: i)) == 0 and len(self.iface_gap(b, iface_idx: i)) == 0 {
                return i
            }
            i += 1
        }
        return -1
    }

    // Try `mod.Enum.Variant(args)` — succeed iff the callee shape is
    // Binary(Binary(Ident(mod), Dot, Ident(enum)), Dot, Ident(variant))
    // and Enum/Variant resolve.
    func try_three_part_construct(self, anon args: [ast.CallArg], callee_lhs: int64, callee_rhs: int64) -> Val? {
        let .Ident(variant_name) = self.p.exprs[callee_rhs] else { return none }
        let enum_idx = self.three_part_ctor_enum(callee_lhs, :variant_name)
        if enum_idx < 0 {
            let .Binary(inner_lhs, inner_op, inner_rhs) = self.p.exprs[callee_lhs] else { return none }
            let .Dot = inner_op else { return none }
            let .Ident(mod_name) = self.p.exprs[inner_lhs] else { return none }
            let .Ident(enum_name) = self.p.exprs[inner_rhs] else { return none }
            let named_enum = self.find_enum_idx(enum_name)
            if named_enum < 0 or self.is_import_alias(mod_name) == false {
                return none
            }
            self.check_variant(variant_name, enum_idx: named_enum, span: self.p.expr_spans[callee_rhs])
            return .VImm(value: 0)
        }
        return self.compile_enum_construct(args, :enum_idx, variant_idx: self.find_variant_idx(variant_name, :enum_idx), span: self.p.expr_spans[callee_rhs])
    }

    // The enum that a `mod.Enum.Variant(...)` callee constructs, or -1.
    func three_part_ctor_enum(self, anon callee_lhs: int64, variant_name: str) -> int64 {
        let .Binary(inner_lhs, inner_op, inner_rhs) = self.p.exprs[callee_lhs] else { return -1 }
        let .Dot = inner_op else { return -1 }
        let .Ident(_mod_name) = self.p.exprs[inner_lhs] else { return -1 }
        let .Ident(enum_name) = self.p.exprs[inner_rhs] else { return -1 }
        let enum_idx = self.find_enum_idx(enum_name)
        if enum_idx < 0 or self.find_variant_idx(variant_name, :enum_idx) < 0 {
            return -1
        }
        return enum_idx
    }

    // The enum that an `Enum.Variant(...)` callee constructs, or -1.
    func two_part_ctor_enum(self, anon callee_lhs: int64, variant_name: str) -> int64 {
        let .Ident(enum_name) = self.p.exprs[callee_lhs] else { return -1 }
        let enum_idx = self.find_enum_idx(enum_name)
        if enum_idx < 0 or self.find_variant_idx(variant_name, :enum_idx) < 0 {
            return -1
        }
        return enum_idx
    }

    func is_import_alias(self, anon name: str) -> bool {
        if self.var_bound(name) {
            return false
        }
        let si = self.cur_scope()
        if si >= 0 {
            return regalloc.str_in(self.scopes[si].alias_names, p: name)
        }
        return regalloc.str_in(self.import_local, p: name)
    }

    // `Type[A, B]` parses to the left-nested chain Index(Index(Type, A), B).
    func index_chain_root(self, anon chain_id: int64) -> int64 {
        let .Binary(lhs, op, _rhs) = self.p.exprs[chain_id] else { return chain_id }
        let .Index = op else { return chain_id }
        return self.index_chain_root(lhs)
    }

    func index_chain_args(self, anon chain_id: int64) -> [int64] {
        let no_args: [int64] = []
        let .Binary(lhs, op, rhs) = self.p.exprs[chain_id] else { return no_args }
        let .Index = op else { return no_args }
        mut args: [int64] = self.index_chain_args(lhs)
        args += [rhs]
        return args
    }

    func expr_arg_spans(self, anon chain_id: int64) -> [ast.Span] {
        mut spans: [ast.Span] = []
        for arg_id in self.index_chain_args(chain_id) {
            spans += [self.p.expr_spans[arg_id]]
        }
        return spans
    }

    // Returns the template for bad type arguments, reporting them only when `report`.
    func generic_ctor_instance(self, anon callee_id: int64, report: bool) -> int64 {
        let .Ident(name) = self.p.exprs[self.index_chain_root(callee_id)] else { return -1 }
        let template_idx = self.find_struct_idx(name)
        if template_idx < 0 {
            return -1
        }
        let kinds = self.generic_type_args(callee_id, :name, param_count: len(self.structs[template_idx].type_param_names), :report)
        if len(kinds) == 0 {
            return template_idx
        }
        return self.instantiate_struct(kinds, :template_idx, arg_spans: self.expr_arg_spans(callee_id), whole: self.p.expr_spans[callee_id])
    }

    // Empty on an error, reported only when `report` is set.
    func generic_type_args(self, anon chain_id: int64, name: str, param_count: int64, report: bool) -> [TypeKind] {
        let failed: [TypeKind] = []
        let arg_ids = self.index_chain_args(chain_id)
        let arity_msg = self.type_arity_error(name, :param_count, got: len(arg_ids))
        if len(arity_msg) > 0 {
            if report {
                self.report_error(arity_msg, span: self.p.expr_spans[chain_id])
            }
            return failed
        }
        mut kinds: [TypeKind] = []
        for arg_id in arg_ids {
            match self.type_kind_of_expr(arg_id, :report) {
                Some(k) -> kinds += [k]
                none -> return failed
            }
        }
        return kinds
    }

    // none for anything but a type spelling, reported when `report` is set.
    func type_kind_of_expr(self, anon expr_id: int64, report: bool) -> TypeKind? {
        match self.p.exprs[expr_id] {
            .Ident(name) -> return self.type_arg_name_kind(name, span: self.p.expr_spans[expr_id], :report)
            .ArrayLit(elements) -> {
                if len(elements) == 1 {
                    if self.type_kind_of_expr(elements[0], :report) is Some(elem) {
                        return self.array_kind_of(elem)
                    }
                    return none
                }
            }
            .UnwrapOpt(value, default) -> {
                if default == 0 {
                    if self.type_kind_of_expr(value, :report) is Some(inner) {
                        return .KOptional(:inner)
                    }
                    return none
                }
            }
            .Binary(lhs, op, rhs) -> {
                match op {
                    .Dot -> {
                        if self.p.exprs[lhs] is .Ident(_mod) {
                            if self.p.exprs[rhs] is .Ident(name) {
                                return self.type_arg_name_kind(name, span: self.p.expr_spans[rhs], :report)
                            }
                        }
                    }
                    .Index -> {
                        if self.p.exprs[self.index_chain_root(expr_id)] is .Ident(name) {
                            let struct_idx = self.find_struct_idx(name)
                            if struct_idx >= 0 {
                                let kinds = self.generic_type_args(expr_id, :name, param_count: len(self.structs[struct_idx].type_param_names), :report)
                                if len(kinds) == 0 {
                                    return none
                                }
                                return .KStruct(idx: self.instantiate_struct(kinds, template_idx: struct_idx, arg_spans: self.expr_arg_spans(expr_id), whole: self.p.expr_spans[expr_id]), type_args: [])
                            }
                            let enum_idx = self.find_enum_idx(name)
                            if enum_idx >= 0 {
                                let kinds = self.generic_type_args(expr_id, :name, param_count: len(self.enums[enum_idx].type_param_names), :report)
                                if len(kinds) == 0 {
                                    return none
                                }
                                return .KEnum(idx: self.instantiate_enum(kinds, template_idx: enum_idx, arg_spans: self.expr_arg_spans(expr_id), whole: self.p.expr_spans[expr_id]))
                            }
                        }
                    }
                    else none
                }
            }
            else none
        }
        if report {
            self.report_error("error: unsupported type argument", span: self.p.expr_spans[expr_id])
        }
        return none
    }

    // none for a non-type or a generic missing its type arguments.
    func type_arg_name_kind(self, anon name: str, span: ast.Span, report: bool) -> TypeKind? {
        mut msg = ""
        if self.type_name_known(name) {
            msg = self.bare_generic_error(name)
        } else {
            if self.is_unresolved_alias(name) {
                if report {
                    self.report_attempts = self.report_attempts + 1
                }
                return none
            }
            msg = self.unknown_type_error(name)
        }
        if len(msg) > 0 {
            if report {
                self.report_error(msg, :span)
            }
            return none
        }
        return self.resolve_type_name(name)
    }

    // "" when `name` takes `got` type arguments, otherwise the error.
    func type_arity_error(self, anon name: str, param_count: int64, got: int64) -> str {
        if param_count == 0 {
            return f"error: `{name}` is not generic"
        }
        if got != param_count {
            mut noun = "type arguments"
            if param_count == 1 {
                noun = "type argument"
            }
            return f"error: `{name}` expects {param_count} {noun}, got {got}"
        }
        return ""
    }

    func unknown_type_error(self, anon name: str) -> str {
        mut names: [str] = ["int64", "bool", "str", "bytes", "none"]
        for n in self.subst_names {
            names += [n]
        }
        for n in self.struct_idx.keys {
            names += [n]
        }
        for n in self.enum_idx.keys {
            names += [n]
        }
        for n in self.iface_idx.keys {
            names += [n]
        }
        for n in self.alias_idx.keys {
            if self.type_name_known(n) {
                names += [n]
            }
        }
        return self.with_suggestion(f"error: unknown type `{name}`", typo: name, candidates: names)
    }

    // "" unless `name` is a generic struct or enum missing its type arguments.
    func bare_generic_error(self, anon name: str) -> str {
        for sn in self.subst_names {
            if sn == name {
                return ""
            }
        }
        if self.alias_idx.get(name) is Some(alias_i) {
            if alias_i >= 0 {
                return ""
            }
        }
        mut params: [str] = []
        mut what = "struct"
        let enum_idx = self.find_enum_idx(name)
        if enum_idx >= 0 {
            params = self.enums[enum_idx].type_param_names
            what = "enum"
        } else {
            let struct_idx = self.find_struct_idx(name)
            if struct_idx >= 0 {
                params = self.structs[struct_idx].type_param_names
            }
        }
        if len(params) == 0 {
            return ""
        }
        mut spelled = ""
        for param in params {
            if len(spelled) > 0 {
                spelled = spelled + ", "
            }
            spelled = spelled + param
        }
        return f"error: generic {what} `{name}` needs type arguments: write `{name}[{spelled}]`"
    }

    // Only the module being compiled is checked, unless report_dep_errors checks another.
    func check_type_expr(self, anon type_id: int64) -> none {
        if type_id == 0 or (self.p.path != self.entry_path and self.checking_dep == false) {
            return
        }
        let span = self.p.type_spans[type_id]
        match self.p.type_exprs[type_id] {
            .Named(name) -> {
                mut msg = ""
                if self.type_name_known(name) {
                    msg = self.bare_generic_error(name)
                } else {
                    if self.is_unresolved_alias(name) == false {
                        msg = self.unknown_type_error(name)
                    }
                }
                if len(msg) > 0 {
                    self.report_error(msg, :span)
                }
            }
            .Array(inner) -> self.check_type_expr(inner)
            .Optional(inner) -> self.check_type_expr(inner)
            .Func(params, return_typ) -> {
                if len(params) > 8 and self.checking_dep == false {
                    self.limit_kinds += [self.canonical_kind_name(self.resolve_type(type_id))]
                    self.report_error(f"error: this function type takes {len(params)} parameters, but a function can take at most 8", :span)
                }
                for param in params {
                    self.check_type_expr(param)
                }
                self.check_type_expr(return_typ)
            }
            .Generic(name, args) -> {
                mut msg = ""
                let struct_idx = self.find_struct_idx(name)
                let enum_idx = self.find_enum_idx(name)
                if struct_idx >= 0 {
                    msg = self.type_arity_error(name, param_count: len(self.structs[struct_idx].type_param_names), got: len(args))
                } else {
                    if enum_idx >= 0 {
                        msg = self.type_arity_error(name, param_count: len(self.enums[enum_idx].type_param_names), got: len(args))
                    } else {
                        if self.type_name_known(name) {
                            msg = self.type_arity_error(name, param_count: 0, got: len(args))
                        } else {
                            if self.is_unresolved_alias(name) == false {
                                msg = self.unknown_type_error(name)
                            }
                        }
                    }
                }
                if len(msg) > 0 {
                    self.report_error(msg, :span)
                }
                for arg in args {
                    self.check_type_expr(arg)
                }
            }
        }
    }

    func is_unresolved_alias(self, anon name: str) -> bool {
        for n in self.unresolved_aliases {
            if n == name {
                return true
            }
        }
        return false
    }

    func note_dep_import_error(self, anon msg: str, p: parsing.Parser, span: ast.Span) -> none {
        self.dep_import_ps += [p]
        self.dep_import_msgs += [msg]
        self.dep_import_spans += [span]
    }

    // Another module's broken declaration shows here only as its cascades.
    func report_dep_errors(self) -> none {
        let own_errors = self.errors
        let no_errors: [Diagnostic] = []
        self.errors = no_errors
        let saved_p = self.p
        let saved_aliases = self.unresolved_aliases
        mut i = 0
        for msg in self.dep_import_msgs {
            self.p = self.dep_import_ps[i]
            self.report_message(msg, span: self.dep_import_spans[i])
            i += 1
        }
        self.checking_dep = true
        for scope in self.scopes {
            if scope.path != saved_p.path and scope.path != self.builtins_path {
                self.p = scope.p
                // A file that's missing is reported at its import instead.
                if len(scope.p.source) > 0 {
                    for pe in scope.p.errors {
                        self.errors += [Diagnostic(path: pe.path, line: pe.line, col: pe.col, end_col: pe.end_col, message: pe.message, source_line: pe.source_line, caret: pe.caret)]
                    }
                }
                self.check_duplicate_decls(scope.module)
                self.check_dep_signatures(scope.module)
            }
        }
        self.checking_dep = false
        self.p = saved_p
        self.unresolved_aliases = saved_aliases
        self.errors += own_errors
    }

    func check_dep_signatures(self, anon module: ast.Module) -> none {
        let saved_names = self.subst_names
        mut aliases: [str] = []
        for decl in module.decls {
            if decl is .TypeAlias(name, _target, _name_span) {
                if self.type_name_known(name) == false {
                    aliases += [name]
                }
            }
        }
        self.unresolved_aliases = aliases
        for decl in module.decls {
            match decl {
                .Func(decl_id) -> {
                    let fd = self.p.func_decls[decl_id]
                    self.check_sig_types(fd.params, return_typ: fd.return_typ)
                }
                .Extern(_name, _name_span, params, return_typ) -> self.check_sig_types(params, :return_typ)
                .Struct(_name, _name_span, type_params, fields, methods) -> {
                    self.subst_names = type_params
                    for field in fields {
                        self.check_type_expr(field.typ)
                    }
                    self.check_method_sigs(methods)
                    self.subst_names = saved_names
                }
                .Enum(_name, _name_span, type_params, variants) -> {
                    self.subst_names = type_params
                    for variant in variants {
                        self.check_sig_types(variant.fields, return_typ: 0)
                    }
                    self.subst_names = saved_names
                }
                .Interface(_name, _name_span, methods) -> self.check_method_sigs(methods)
                .TypeAlias(name, target, _name_span) -> {
                    if self.is_unresolved_alias(name) {
                        self.check_type_expr(target)
                    }
                }
                else none
            }
        }
    }

    func check_method_sigs(self, anon methods: [int64]) -> none {
        for method_id in methods {
            let fd = self.p.func_decls[method_id]
            self.check_sig_types(fd.params, return_typ: fd.return_typ)
        }
    }

    func check_sig_types(self, anon params: [ast.Param], return_typ: int64) -> none {
        for param in params {
            self.check_type_expr(param.typ)
        }
        self.check_type_expr(return_typ)
    }

    // Runs after registration, so forward references resolve.
    func check_module_types(self, anon module: ast.Module) -> none {
        self.check_duplicate_decls(module)
        self.check_type_aliases(module)
        let saved_names = self.subst_names
        for decl in module.decls {
            match decl {
                .Struct(struct_name, _name_span, type_params, fields, methods) -> {
                    self.subst_names = type_params
                    for field in fields {
                        self.check_type_expr(field.typ)
                    }
                    // Non-generic methods are checked when compile_func runs.
                    if len(type_params) > 0 {
                        for method_id in methods {
                            let fd = self.p.func_decls[method_id]
                            self.check_sig_types(fd.params, return_typ: fd.return_typ)
                            self.check_param_count(fd.params, what: f"`{struct_name}.{fd.name}`", span: fd.name_span)
                        }
                    }
                    self.subst_names = saved_names
                }
                .Enum(_name, _name_span, type_params, variants) -> {
                    self.subst_names = type_params
                    for variant in variants {
                        for field in variant.fields {
                            self.check_type_expr(field.typ)
                        }
                    }
                    self.subst_names = saved_names
                }
                .Interface(iface_name, _name_span, methods) -> {
                    for method_id in methods {
                        let fd = self.p.func_decls[method_id]
                        self.check_sig_types(fd.params, return_typ: fd.return_typ)
                        self.check_param_count(fd.params, what: f"`{iface_name}.{fd.name}`", span: fd.name_span)
                    }
                }
                .Extern(name, name_span, params, return_typ) -> {
                    self.check_sig_types(params, :return_typ)
                    self.check_param_count(params, what: f"`{name}`", span: name_span)
                }
                else none
            }
        }
    }

    // A second declaration would replace the first or only fail in the assembler.
    func check_duplicate_decls(self, anon module: ast.Module) -> none {
        let seen = FuncIdx()
        for decl in module.decls {
            match decl {
                .Func(decl_id) -> {
                    let fd = self.p.func_decls[decl_id]
                    self.check_first_decl(seen, name: fd.name, shown: fd.name, span: fd.name_span)
                }
                .Struct(name, name_span, _type_params, fields, methods) -> {
                    self.check_first_decl(seen, :name, shown: name, span: name_span)
                    let seen_fields = FuncIdx()
                    for field in fields {
                        self.check_first_member(seen_fields, name: f"{name}.{field.name}", span: field.name_span)
                    }
                    for method_id in methods {
                        let md = self.p.func_decls[method_id]
                        if seen_fields.get(f"{name}.{md.name}") is Some(field_at) {
                            self.report_error(f"error: `{name}.{md.name}` is already declared on line {self.line_of_offset(field_at)}", span: md.name_span)
                        }
                    }
                    self.check_duplicate_methods(name, :methods)
                }
                .Enum(name, name_span, _type_params, variants) -> {
                    self.check_first_decl(seen, :name, shown: name, span: name_span)
                    let seen_variants = FuncIdx()
                    for variant in variants {
                        self.check_first_member(seen_variants, name: f"{name}.{variant.name}", span: variant.name_span)
                    }
                }
                .Interface(name, name_span, methods) -> {
                    self.check_first_decl(seen, :name, shown: name, span: name_span)
                    self.check_duplicate_methods(name, :methods)
                }
                .Extern(name, name_span, _params, _return_typ) -> self.check_first_decl(seen, :name, shown: name, span: name_span)
                .TypeAlias(name, _target, name_span) -> self.check_first_decl(seen, :name, shown: name, span: name_span)
                else none
            }
        }
    }

    func check_duplicate_methods(self, anon owner: str, methods: [int64]) -> none {
        let seen = FuncIdx()
        for method_id in methods {
            let fd = self.p.func_decls[method_id]
            self.check_first_decl(seen, name: fd.name, shown: f"{owner}.{fd.name}", span: fd.name_span)
        }
    }

    // A parse error can leave a member named by the token it stopped at.
    func check_first_member(self, anon seen: FuncIdx, name: str, span: ast.Span) -> none {
        if len(self.p.errors) == 0 {
            self.check_first_decl(seen, :name, shown: name, :span)
        }
    }

    func check_first_decl(self, anon seen: FuncIdx, name: str, shown: str, span: ast.Span) -> none {
        if seen.get(name) is Some(first) {
            self.report_error(f"error: `{shown}` is already declared on line {self.line_of_offset(first)}", :span)
            return
        }
        seen.set(name, span.start)
    }

    // An alias that never registered has an unknown target or is a cycle.
    func check_type_aliases(self, anon module: ast.Module) -> none {
        mut names: [str] = []
        mut targets: [int64] = []
        for decl in module.decls {
            if decl is .TypeAlias(name, target, _name_span) {
                if self.type_name_known(name) == false {
                    names += [name]
                    targets += [target]
                }
            }
        }
        self.unresolved_aliases = names
        self.unresolved_alias_targets = targets
        for decl in module.decls {
            if decl is .TypeAlias(name, target, _name_span) {
                if self.is_unresolved_alias(name) and self.alias_reaches(name, type_id: target, depth: 0) {
                    self.report_error(f"error: type alias `{name}` refers to itself", span: self.p.type_spans[target])
                } else {
                    self.check_type_expr(target)
                }
            }
        }
    }

    // Whether `type_id`, following unresolved aliases, names `alias`.
    func alias_reaches(self, anon alias: str, type_id: int64, depth: int64) -> bool {
        if depth > len(self.unresolved_aliases) {
            return false
        }
        for name in self.type_expr_names(type_id) {
            if name == alias {
                return true
            }
            mut i = 0
            for i < len(self.unresolved_aliases) {
                if self.unresolved_aliases[i] == name {
                    if self.alias_reaches(alias, type_id: self.unresolved_alias_targets[i], depth: depth + 1) {
                        return true
                    }
                }
                i = i + 1
            }
        }
        return false
    }

    // Every type name a type expression mentions.
    func type_expr_names(self, anon type_id: int64) -> [str] {
        mut names: [str] = []
        if type_id == 0 {
            return names
        }
        match self.p.type_exprs[type_id] {
            .Named(name) -> names += [name]
            .Array(inner) -> names = self.type_expr_names(inner)
            .Optional(inner) -> names = self.type_expr_names(inner)
            .Func(params, return_typ) -> {
                for param in params {
                    names += self.type_expr_names(param)
                }
                names += self.type_expr_names(return_typ)
            }
            .Generic(name, args) -> {
                names += [name]
                for arg in args {
                    names += self.type_expr_names(arg)
                }
            }
        }
        return names
    }

    // Try `EnumName.Variant(args)` or `module.thing(args)` two-part forms.
    func try_two_part_call(self, anon args: [ast.CallArg], callee_lhs: int64, callee_rhs: int64) -> Val? {
        let .Ident(mod_or_obj) = self.p.exprs[callee_lhs] else { return none }
        let .Ident(method_name) = self.p.exprs[callee_rhs] else { return none }
        let enum_idx = self.two_part_ctor_enum(callee_lhs, variant_name: method_name)
        if enum_idx >= 0 {
            return self.compile_enum_construct(args, :enum_idx, variant_idx: self.find_variant_idx(method_name, :enum_idx), span: self.p.expr_spans[callee_rhs])
        }
        let named_enum = self.find_enum_idx(mod_or_obj)
        if named_enum >= 0 {
            self.check_variant(method_name, enum_idx: named_enum, span: self.p.expr_spans[callee_rhs])
            return .VImm(value: 0)
        }
        if self.is_import_alias(mod_or_obj) {
            let s_idx = self.find_struct_idx(method_name)
            if s_idx >= 0 {
                return self.compile_struct_construct(args, struct_idx: s_idx, span: self.p.expr_spans[callee_lhs])
            }
            let fn_idx = self.lookup_import_fn(mod_or_obj, method_name)
            if fn_idx == -1 {
                self.report_error(self.with_suggestion(f"error: module `{mod_or_obj}` has no function `{method_name}`", typo: method_name, candidates: self.import_fn_names(mod_or_obj)), span: self.p.expr_spans[callee_rhs])
                return .VImm(value: 0)
            }
            let ifn = self.import_fn_at(fn_idx)
            let sig = ifn.sig
            self.check_call_args(args, param_labels: sig.param_labels, param_defaults: sig.param_default_exprs, skip: 0, call_name: f"{mod_or_obj}.{method_name}", call_span: self.p.expr_spans[callee_lhs])
            self.prepare_args_with_kinds(args, expected_kinds: sig.param_kinds, default_exprs: sig.param_default_exprs, src_p: sig.src_p)
            self.emit(f"bl {ifn.label}")
            return .VReg(name: "x0")
        }
        // `obj.fn(args)` where `fn` is a struct FIELD of function-
        // pointer type (not a method). Load the field, then indirect
        // call. Checked before falling through to method dispatch so
        // the user can call a func-typed field with the same syntax
        // they'd use for a method.
        let lhs_kind: TypeKind = self.infer_kind(callee_lhs)
        if lhs_kind is .KStruct(sidx, _ta) {
            if self.has_field(method_name, struct_idx: sidx) {
                if self.find_field_kind(method_name, struct_idx: sidx) is .KFunc(_p, _r) {
                    return none
                }
            }
        }
        return self.compile_method_call(args, receiver_id: callee_lhs, :method_name, span: self.p.expr_spans[callee_lhs])
    }

    // `let h = f` with `f` one of this module's functions past the limit, reported at `f`.
    func note_wide_fn_local(self, anon name: str, value: int64) -> none {
        let wide = self.holds_wide_fn(value)
        if wide == regalloc.str_in(self.limit_fn_locals, p: name) {
            return
        }
        if wide {
            self.limit_fn_locals += [name]
            return
        }
        mut kept: [str] = []
        for local in self.limit_fn_locals {
            if local != name {
                kept += [local]
            }
        }
        self.limit_fn_locals = kept
    }

    // One of this module's functions past the limit, or an array literal holding one.
    func holds_wide_fn(self, anon value: int64) -> bool {
        match self.p.exprs[value] {
            .Ident(fn_name) -> {
                if self.var_bound(fn_name) {
                    return regalloc.str_in(self.limit_fn_locals, p: fn_name)
                }
                let slot = self.lookup_func(fn_name)
                return slot >= 0 and self.func_def_paths[slot] == self.p.path and len(self.fn_sig(slot).param_kinds) > 8
            }
            .ArrayLit(elements) -> {
                for element in elements {
                    if self.holds_wide_fn(element) {
                        return true
                    }
                }
                return false
            }
            else return false
        }
    }

    func holds_own_wide_fn(self, anon callee_id: int64) -> bool {
        match self.p.exprs[callee_id] {
            .Ident(name) -> return regalloc.str_in(self.limit_fn_locals, p: name)
            .Binary(lhs, op, _rhs) -> {
                if op is .Index {
                    return self.holds_own_wide_fn(lhs)
                }
                return false
            }
            else return false
        }
    }

    // Indirect call on any expression of `KFunc` type. The callee
    // expression may itself be a Call (`getfn()(x)`), a field load
    // (`obj.handler(x)` where handler is a field, not a method), an
    // index (`arr[i](x)`), or any other shape that evaluates to a
    // function pointer. Compile the callee first, spill it across
    // arg eval (so any `bl`s during argument compilation don't
    // clobber it), then `blr`.
    func callee_desc(self, anon callee_id: int64) -> str {
        if self.p.exprs[callee_id] is .Ident(callee_name) {
            return f"`{callee_name}`"
        }
        return "this function value"
    }

    func compile_indirect_call(self, callee_id: int64, args: [ast.CallArg]) -> Val {
        let callee_kind: TypeKind = self.infer_kind(callee_id)
        if callee_kind is .KFunc(param_kinds, _return_kind) {
            // Function-pointer types don't carry parameter labels —
            // there's no expected-label list to validate against. A
            // labelled arg at an indirect call site is almost
            // certainly a typo on the user's part (the named-call
            // form silently dropped a wrong label before this
            // check). Reject any label so the mistake surfaces
            // instead of getting positionally dropped.
            for arg in args {
                if len(arg.label) > 0 {
                    self.report_error(f"error: indirect call through a function-pointer value can't take labelled arguments (drop `{arg.label}:`); the function-type syntax `func(T) -> R` doesn't carry parameter names", span: arg.label_span)
                }
            }
            if len(args) != len(param_kinds) {
                self.report_error(f"error: {self.callee_desc(callee_id)} takes {self.arg_noun(len(param_kinds))}, got {len(args)}", span: self.p.expr_spans[callee_id])
                return .VImm(value: 0)
            }
            if len(args) > 8 {
                for arg in args {
                    self.compile_discard(arg.value)
                }
                if self.p.path == self.entry_path and self.holds_own_wide_fn(callee_id) == false {
                    self.limit_call_msgs += [f"error: {self.callee_desc(callee_id)} takes {len(args)} parameters, but a function can take at most 8"]
                    self.limit_call_spans += [self.p.expr_spans[callee_id]]
                    self.limit_call_insts += [self.body_instance]
                    self.limit_call_kinds += [self.canonical_kind_name(callee_kind)]
                }
                return .VImm(value: 0)
            }
            let callee_val: Val = self.compile_expr(callee_id)
            // Always move the function pointer into a fresh pool reg
            // (NOT the load's "x0" return slot when callee is a Call):
            // prepare_args_with_kinds will overwrite x0 with the first
            // argument, so a restore-across from sp would clobber it.
            // A pool reg either lands in a callee-saved slot
            // (`spill_across` no-ops, value survives the call directly)
            // or in caller-saved x8-x15 (spill works without colliding
            // with the arg registers x0-x7).
            let callee_reg: str = self.pool.alloc_reg()
            self.mov_to(callee_val, dest: callee_reg)
            let spilled: bool = self.spill_across(callee_reg)
            // Function-pointer types don't carry defaults — the
            // sig isn't accessible at the indirect-call site, only
            // the type. Pass empty default_exprs so prepare_args
            // walks just the supplied args.
            let no_defaults: [int64] = []
            self.prepare_args_with_kinds(args, expected_kinds: param_kinds, default_exprs: no_defaults, src_p: self.p)
            self.restore_across(callee_reg, :spilled)
            self.emit(f"blr {callee_reg}")
            self.pool.free_reg(callee_reg)
            return .VReg(name: "x0")
        }
        self.report_error("error: call with non-callable expression", span: self.p.expr_spans[callee_id])
        return .VImm(value: 0)
    }

    func compile_call(self, anon args: [ast.CallArg], callee_id: int64) -> Val {
        match self.p.exprs[callee_id] {
            .Ident(name) -> {
                let builtin = self.is_builtin_call(name)
                if name == "len" and len(args) == 1 and builtin {
                    return self.compile_len(args[0].value)
                }
                // `str(x)` — explicit conversion intrinsic. Dispatches by
                // kind to the appropriate to_str (int_to_str, bool_to_str,
                // struct.to_str). Used by f-strings and any explicit cast.
                if name == "$str" or (name == "str" and len(args) == 1 and builtin) {
                    return self.compile_as_str(args[0].value)
                }
                // Like `==`: str/bytes by content, enums by variant, else bits.
                if name == "hash" and len(args) == 1 and builtin {
                    let arg_kind = self.infer_kind(args[0].value)
                    if arg_kind is .KUnknown {
                        self.compile_discard(args[0].value)
                        self.report_cannot_infer(args[0].value, what: "this expression")
                        return .VImm(value: 0)
                    }
                    if self.is_hashable(arg_kind) == false {
                        self.compile_discard(args[0].value)
                        if self.kind_has_unknown(arg_kind) == false and self.report_attempts == self.stmt_error_mark {
                            self.report_error(f"error: cannot hash a value of type `{self.kind_display(arg_kind)}`{self.unhashable_note(arg_kind)}; hashable values are `int64`, `str`, `bytes`, `bool` or enums without payloads", span: self.p.expr_spans[args[0].value])
                        }
                        return .VImm(value: 0)
                    }
                    if self.is_str_or_bytes(arg_kind) {
                        let val = self.compile_expr(args[0].value)
                        self.mov_to(val, dest: "x0")
                        self.emit("bl $primitives$str$hash")
                        return .VReg(name: "x0")
                    }
                    if arg_kind is .KEnum(_enum_idx) {
                        let val = self.compile_expr(args[0].value)
                        return .VReg(name: self.load_enum_or_val(val, expr_id: args[0].value))
                    }
                    return self.compile_expr(args[0].value)
                }
                // Struct constructor: StructName(field1: v1, ...)
                let struct_idx = self.find_struct_idx(name)
                if struct_idx >= 0 {
                    return self.compile_struct_construct(args, :struct_idx, span: self.p.expr_spans[callee_id])
                }
                // Local var of function type — indirect call via the
                // stored function pointer (`let f = double; f(21)`).
                // Take this path BEFORE the func_idx lookup so a local
                // var shadowing a function name wins. Delegating to
                // compile_indirect_call also gives us its labelled-
                // argument rejection for free.
                if self.calls_local(name) {
                    if self.find_var_kind(name) is .KFunc(_pk, _rk) {
                        return self.compile_indirect_call(:callee_id, :args)
                    }
                    if self.find_var_kind(name) is .KUnknown {
                        for arg in args {
                            self.compile_discard(arg.value)
                        }
                        self.report_cannot_infer(callee_id, what: "this expression")
                        return .VImm(value: 0)
                    }
                }
                let slot = self.lookup_func(name)
                if slot != -1 {
                    let sig = self.fn_sig(slot)
                    self.check_call_args(args, param_labels: sig.param_labels, param_defaults: sig.param_default_exprs, skip: 0, call_name: name, call_span: self.p.expr_spans[callee_id])
                    self.prepare_args_with_kinds(args, expected_kinds: sig.param_kinds, default_exprs: sig.param_default_exprs, src_p: sig.src_p)
                    self.emit(f"bl {self.fn_label(slot)}")
                    return .VReg(name: "x0")
                }
                if self.var_bound(name) {
                    self.report_error(f"error: `{name}` is a local of type `{self.kind_display(self.find_var_kind(name))}`, not a function", span: self.p.expr_spans[callee_id])
                    return .VImm(value: 0)
                }
                if self.find_var_kind(name) is .KFunc(_pk, _rk) {
                    mut msg = f"error: `{name}` is called before its `let`"
                    if self.var_seen(name) {
                        msg = f"error: `{name}` is declared in a block that has ended; declare it outside the block to call it here"
                    }
                    self.report_error(msg, span: self.p.expr_spans[callee_id])
                    return .VImm(value: 0)
                }
                let msg: str = self.with_suggestion(f"error: unknown function `{name}`", typo: name, candidates: self.visible_func_names())
                self.report_error(msg, span: self.p.expr_spans[callee_id])
                return .VImm(value: 0)
            }
            .Binary(lhs, op, rhs) -> {
                match op {
                    .Index -> {
                        // `Type[A, B](args)` constructs that instance.
                        let ctor_idx = self.generic_ctor_instance(callee_id, report: true)
                        if ctor_idx >= 0 {
                            if len(self.structs[ctor_idx].type_param_names) > 0 {
                                return .VImm(value: 0)
                            }
                            return self.compile_struct_construct(args, struct_idx: ctor_idx, span: self.p.expr_spans[callee_id])
                        }
                    }
                    .Dot -> {
                        if self.try_three_part_construct(args, callee_lhs: lhs, callee_rhs: rhs) is Some(val) {
                            return val
                        }
                        if self.try_two_part_call(args, callee_lhs: lhs, callee_rhs: rhs) is Some(val) {
                            return val
                        }
                        if self.p.exprs[rhs] is .Ident(name) {
                            // `obj.fn(...)` where `fn` is a struct
                            // FIELD of function-pointer type — load
                            // the field, then indirect call. Checked
                            // before method dispatch so a field shadows
                            // a same-named method (unlikely but the
                            // dispatch needs to be deterministic).
                            let lhs_kind: TypeKind = self.infer_kind(lhs)
                            if lhs_kind is .KStruct(sidx, _ta) {
                                if self.has_field(name, struct_idx: sidx) {
                                    if self.find_field_kind(name, struct_idx: sidx) is .KFunc(_p, _r) {
                                        return self.compile_indirect_call(:callee_id, :args)
                                    }
                                }
                            }
                            return self.compile_method_call(args, receiver_id: lhs, method_name: name, span: self.p.expr_spans[lhs])
                        }
                    }
                    else none
                }
                // Non-Dot binary expressions (Index, ...) and any
                // unresolved Dot form fall through to the general
                // function-pointer call path: `arr[i](x)`, `(obj.f)(x)`
                // for a function-typed field, etc.
                return self.compile_indirect_call(:callee_id, :args)
            }
            .ImplicitVariant(variant_name) -> {
                // .Variant(args) constructor — payload form of implicit variant.
                let enum_idx = self.find_enum_with_variant(variant_name)
                if enum_idx == -2 {
                    self.report_ambiguous_variant(variant_name, :args, span: self.p.expr_spans[callee_id])
                    for arg in args {
                        self.compile_discard(arg.value)
                    }
                    return .VImm(value: 0)
                }
                if enum_idx >= 0 {
                    mut variant_idx = self.find_variant_idx(variant_name, :enum_idx)
                    if variant_idx >= 0 {
                        return self.compile_enum_construct(args, :enum_idx, :variant_idx, span: self.p.expr_spans[callee_id])
                    }
                }
                // Candidates for the typo hint: every variant of every
                // registered enum. An implicit `.X` has no enum context
                // to narrow against, so the suggestion pool is wide.
                mut variant_names: [str] = []
                for e in self.enums {
                    for v in e.variants {
                        variant_names += [v.name]
                    }
                }
                let msg: str = self.with_suggestion(f"error: unknown implicit variant `.{variant_name}` in call position", typo: variant_name, candidates: variant_names)
                self.report_error(msg, span: self.p.expr_spans[callee_id])
                return .VReg(name: "x0")
            }
            else {
                // Any other callee shape (Call, ArrayLit, Match, ...).
                // If the resulting value is a function pointer, do an
                // indirect call; otherwise report.
                return self.compile_indirect_call(:callee_id, :args)
            }
        }
    }

    func compile_len(self, anon arg_id: int64) -> Val {
        mut kind = self.infer_kind(arg_id)
        let arg_val = self.compile_expr(arg_id)
        if self.kind_has_unknown(kind) {
            self.free_val(arg_val)
            self.report_if_unknown(arg_id)
            return .VImm(value: 0)
        }
        // Every array (whatever its element kind) and `str` is a
        // length-prefixed header: the count lives at offset 8 of the
        // pointer. One load covers them all.
        mut header_len = self.is_array_kind(kind)
        match kind {
            .KStr -> header_len = true
            .KBytes -> header_len = true
            else none
        }
        if header_len {
            mut reg = self.load(arg_val)
            self.emit(f"ldr {reg}, [{reg}, #8]")
            return .VReg(name: reg)
        }
        // Look for a `len(self) -> int64` method on the struct; if one
        // exists, dispatch to it. Lets `len(map)` work the same way
        // `len(array)` and `len(str)` do.
        if kind is .KStruct(struct_idx, _struct_type_args) {
            mut s = self.structs[struct_idx]
            if s.method_idx.get("len") is Some(mi) {
                let sig = s.methods[mi].sig
                if self.takes_self_and(sig, count: 0) and self.same_kind(sig.return_kind, .KInt64) {
                    self.mov_to(arg_val, dest: "x0")
                    self.emit(f"bl ${s.module_prefix}${s.name}$len")
                    return .VReg(name: "x0")
                }
                let name = self.struct_display_name(struct_idx)
                self.free_val(arg_val)
                self.report_error(f"error: len() not defined for struct `{name}`; `{name}.len` isn't `func len(self) -> int64`", span: self.p.expr_spans[arg_id])
                return .VImm(value: 0)
            }
            self.report_error(f"error: len() not defined for struct `{self.struct_display_name(struct_idx)}` (no `len` method)", span: self.p.expr_spans[arg_id])
            return .VImm(value: 0)
        }
        self.report_error("error: len() not defined for this type", span: self.p.expr_spans[arg_id])
        return .VImm(value: 0)
    }

    // Dispatch on an interface value: the variable holds a pointer to an
    // arena cell {data_ptr at 0, vtable_ptr at 8}. The method index in the
    // vtable matches its order in the interface declaration.
    func compile_iface_method_call(self, anon args: [ast.CallArg], receiver_id: int64, iface_idx: int64, method_name: str, span: ast.Span) -> Val {
        let iface_name = self.interfaces[iface_idx].name
        mut i = 0
        mut method_idx = -1
        for i < len(self.interfaces[iface_idx].methods) {
            if self.interfaces[iface_idx].methods[i].name == method_name {
                method_idx = i
                i = len(self.interfaces[iface_idx].methods)
            } else {
                i = i + 1
            }
        }
        if method_idx < 0 {
            mut names: [str] = []
            for m in self.interfaces[iface_idx].methods {
                names += [m.name]
            }
            self.report_error(self.with_suggestion(f"error: interface `{iface_name}` has no method `{method_name}`", typo: method_name, candidates: names), :span)
            return .VImm(value: 0)
        }
        let sig = self.interfaces[iface_idx].methods[method_idx].sig
        let attempts_before = self.report_attempts
        self.check_call_args(args, param_labels: sig.param_labels, param_defaults: sig.param_default_exprs, skip: 1, call_name: f"{iface_name}.{method_name}", call_span: span)
        if self.report_attempts > attempts_before {
            return .VImm(value: 0)
        }
        let sig_params: [TypeKind] = sig.param_kinds
        // Stash self (data_ptr) and each compiled arg, plus the method ptr,
        // so arg compilation doesn't clobber x0..x7. Layout in the spill
        // area: [data_ptr, arg0, arg1, ..., method_ptr].
        let arg_regs: [str] = ["x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7"]
        mut n = len(args) + 1
        if len(sig_params) > n {
            n = len(sig_params)
        }
        mut padded = (n + 1) * 8
        if padded % 16 != 0 {
            padded = padded + 8
        }
        self.emit(f"sub sp, sp, #{padded}")
        // Load cell ptr -> x0; data_ptr -> sp[0]; vtable -> x1; method ptr -> sp[n*8].
        let recv_val = self.compile_expr(receiver_id)
        self.mov_to(recv_val, dest: "x0")
        let cell_r = self.pool.alloc_reg()
        let tmp_r = self.pool.alloc_reg()
        // Use two distinct pool regs: hard-coding x9 here would clobber
        // cell_r when alloc_reg happens to hand back x9.
        self.emit(f"mov {cell_r}, x0")
        self.emit(f"ldr {tmp_r}, [{cell_r}]")
        self.emit(f"str {tmp_r}, [sp]")
        self.emit(f"ldr {tmp_r}, [{cell_r}, #8]")
        self.emit(f"ldr {tmp_r}, [{tmp_r}, #{method_idx * 8}]")
        self.emit(f"str {tmp_r}, [sp, #{n * 8}]")
        self.pool.free_reg(tmp_r)
        self.pool.free_reg(cell_r)
        mut i = 0
        for i < n - 1 {
            mut arg_reg = ""
            // Method param 0 is self; caller arg i maps to param i+1.
            let param_idx = i + 1
            if i >= len(args) {
                arg_reg = self.compile_default(sig.param_default_exprs[param_idx], expected: sig_params[param_idx], src_p: sig.src_p)
            } else {
                if param_idx < len(sig_params) {
                    arg_reg = self.compile_into(args[i].value, expected: sig_params[param_idx])
                } else {
                    let arg_val = self.compile_expr(args[i].value)
                    arg_reg = self.load(arg_val)
                }
            }
            self.emit(f"str {arg_reg}, [sp, #{(i + 1) * 8}]")
            self.pool.free_reg(arg_reg)
            i = i + 1
        }
        mut k = 0
        for k < n and k < len(arg_regs) {
            self.emit(f"ldr {arg_regs[k]}, [sp, #{k * 8}]")
            k = k + 1
        }
        self.emit(f"ldr x9, [sp, #{n * 8}]")
        self.emit(f"add sp, sp, #{padded}")
        self.emit("blr x9")
        return .VReg(name: "x0")
    }

    // Find a primitive method registered via `register_primitive_module`.
    // Returns the entry index, or -1 if `kind` is not primitive or has no
    // method named `name`.
    func find_prim_method(self, anon name: str, kind: TypeKind) -> int64 {
        mut i = 0
        for i < len(self.prim_methods) {
            let pm = self.prim_methods[i]
            if pm.name == name {
                mut matches: bool = false
                match kind {
                    .KInt64 -> if pm.kind is .KInt64 { matches = true }
                    .KStr -> if pm.kind is .KStr { matches = true }
                    .KBool -> if pm.kind is .KBool { matches = true }
                    else none
                }
                if matches {
                    return i
                }
            }
            i = i + 1
        }
        return -1
    }

    func compile_method_call(self, anon args: [ast.CallArg], receiver_id: int64, method_name: str, span: ast.Span) -> Val {
        let recv_kind = self.infer_kind(receiver_id)
        if recv_kind is .KUnknown {
            self.compile_discard(receiver_id)
            self.report_cannot_infer(receiver_id, what: "this expression")
            for arg in args {
                self.compile_discard(arg.value)
            }
            return .VImm(value: 0)
        }

        // Interface dispatch: load vtable from the cell, then indirect call.
        if recv_kind is .KInterface(iface_idx) {
            return self.compile_iface_method_call(args, :receiver_id, :iface_idx, :method_name, :span)
        }

        mut method_lbl = ""
        mut sig_params: [TypeKind] = []
        mut sig_labels: [str] = []
        mut sig_defaults: [int64] = []
        mut sig_src_p: parsing.Parser = self.p
        match recv_kind {
            .KStruct(idx, _struct_type_args) -> {
                if self.structs[idx].method_idx.get(method_name) is Some(mi) {
                    method_lbl = f"${self.structs[idx].module_prefix}${self.structs[idx].name}${method_name}"
                    sig_params = self.structs[idx].methods[mi].sig.param_kinds
                    sig_labels = self.structs[idx].methods[mi].sig.param_labels
                    sig_defaults = self.structs[idx].methods[mi].sig.param_default_exprs
                    sig_src_p = self.structs[idx].methods[mi].sig.src_p
                }
            }
            else none
        }
        // Primitive method dispatch (int64.to_str etc.) for non-struct
        // receivers — looked up against stdlib/primitives/<kind>.kod.
        if len(method_lbl) == 0 {
            let prim_idx = self.find_prim_method(method_name, kind: recv_kind)
            if prim_idx >= 0 {
                let pm = self.prim_methods[prim_idx]
                method_lbl = pm.label
                sig_params = pm.sig.param_kinds
                sig_labels = pm.sig.param_labels
                sig_defaults = pm.sig.param_default_exprs
                sig_src_p = pm.sig.src_p
            }
        }
        if len(method_lbl) == 0 {
            mut recv_desc: str = "receiver"
            if self.p.exprs[receiver_id] is .Ident(recv_name) {
                recv_desc = recv_name
            }
            // Collect candidate method names for the typo hint: the
            // receiver's struct methods (if any) plus the primitive
            // methods registered for its kind.
            mut cands: [str] = []
            match recv_kind {
                .KStruct(idx, _ta) -> {
                    for m in self.structs[idx].methods {
                        cands += [m.name]
                    }
                }
                else none
            }
            // Inline the (kind, kind) match — TypeKind is an enum and
            // pairwise comparison needs a destructure of both sides.
            for pm in self.prim_methods {
                mut same: bool = false
                match recv_kind {
                    .KInt64 -> if pm.kind is .KInt64 { same = true }
                    .KStr -> if pm.kind is .KStr { same = true }
                    .KBool -> if pm.kind is .KBool { same = true }
                    else none
                }
                if same {
                    cands += [pm.name]
                }
            }
            let msg: str = self.with_suggestion(f"error: unknown method `{method_name}` on `{recv_desc}`", typo: method_name, candidates: cands)
            self.report_error(msg, :span)
            return .VImm(value: 0)
        }
        self.check_call_args(args, param_labels: sig_labels, param_defaults: sig_defaults, skip: 1, call_name: method_name, call_span: span)

        // Stash self and each compiled arg on the stack so that arg
        // expressions (which may issue bl calls) don't clobber preceding
        // values held in x0..x7. When the call supplies fewer args than
        // the method's param list, the trailing slots are filled from
        // each param's default expression — compiled in the method's
        // owning-module parser context so identifier scopes match.
        let arg_regs: [str] = ["x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7"]
        // Total slots = `self` + the larger of supplied-args and
        // sig-implied-params. sig_params[0] is `self`, so user-visible
        // params are sig_params[1..]; missing trailing user args are
        // filled from sig_defaults at the matching index.
        let n_args = len(args)
        mut n_params = 0
        if len(sig_params) > 1 {
            n_params = len(sig_params) - 1
        }
        mut total_user = n_args
        if n_params > total_user {
            total_user = n_params
        }
        let n = total_user + 1
        mut padded = n * 8
        if padded % 16 != 0 {
            padded = padded + 8
        }
        self.emit(f"sub sp, sp, #{padded}")
        let recv_val = self.compile_expr(receiver_id)
        self.mov_to(recv_val, dest: "x0")
        self.emit("str x0, [sp]")
        mut i = 0
        for i < total_user {
            mut arg_reg = ""
            // Method param 0 is self; caller arg i maps to param i+1.
            let param_idx = i + 1
            if i < n_args {
                if param_idx < len(sig_params) {
                    arg_reg = self.compile_into(args[i].value, expected: sig_params[param_idx])
                } else {
                    let arg_val = self.compile_expr(args[i].value)
                    arg_reg = self.load(arg_val)
                }
            } else {
                arg_reg = self.compile_default(sig_defaults[param_idx], expected: sig_params[param_idx], src_p: sig_src_p)
            }
            self.emit(f"str {arg_reg}, [sp, #{(i + 1) * 8}]")
            self.pool.free_reg(arg_reg)
            i = i + 1
        }
        mut k = 0
        for k < n and k < len(arg_regs) {
            self.emit(f"ldr {arg_regs[k]}, [sp, #{k * 8}]")
            k = k + 1
        }
        self.emit(f"add sp, sp, #{padded}")
        self.emit(f"bl {method_lbl}")
        return .VReg(name: "x0")
    }

    // Box `arg_reg` (an arena pointer to a struct of kind .KStruct(si, _struct_type_args))
    // into an arena-allocated {data_ptr, vtable_ptr} cell for interface
    // ii. Returns a fresh register holding the cell pointer. Frees the
    // input register.
    func emit_iface_box(self, anon arg_reg: str, struct_idx: int64, iface_idx: int64) -> str {
        let vt_lbl = self.register_vtable(struct_idx, iface_idx)
        let arg_spilled = self.preserve_begin(arg_reg)
        self.emit("mov x0, #16")
        self.emit("bl _arena_alloc")
        let data_r = self.preserve_end(arg_reg, spilled: arg_spilled)
        self.emit(f"str {data_r}, [x0]")
        self.pool.free_reg(data_r)
        let vt_r = self.pool.alloc_reg()
        self.emit(f"adrp {vt_r}, {vt_lbl}@PAGE")
        self.emit(f"add {vt_r}, {vt_r}, {vt_lbl}@PAGEOFF")
        self.emit(f"str {vt_r}, [x0, #8]")
        self.pool.free_reg(vt_r)
        let cell_r = self.pool.alloc_reg()
        self.emit(f"mov {cell_r}, x0")
        return cell_r
    }

    // If expected kind is KInterface and actual is KStruct, perform an
    // implicit upcast: box the struct pointer in a {data, vtable} cell
    // and return the new register. Otherwise returns the input register.
    func maybe_box_for_iface(self, anon arg_reg: str, actual: TypeKind, expected: TypeKind, span: ast.Span) -> str {
        let .KInterface(iface_idx) = expected else { return arg_reg }
        let gap = self.iface_gap(actual, :iface_idx)
        if len(gap) > 0 {
            mut what = f"`{self.kind_display(actual)}`"
            if actual is .KStruct(struct_idx, _type_args) {
                what = f"struct `{self.struct_display_name(struct_idx)}`"
            }
            self.report_error(f"error: {what} doesn't implement interface `{self.interfaces[iface_idx].name}`: {gap}", :span)
        }
        match actual {
            .KStruct(struct_idx, _struct_type_args) -> return self.emit_iface_box(arg_reg, :struct_idx, :iface_idx)
            .KInt64 -> return self.emit_prim_iface_box(arg_reg, kind: .KInt64, :iface_idx)
            .KStr -> return self.emit_prim_iface_box(arg_reg, kind: .KStr, :iface_idx)
            .KBool -> return self.emit_prim_iface_box(arg_reg, kind: .KBool, :iface_idx)
            else return arg_reg
        }
    }

    // Why a struct or primitive can't be a value of the interface; "" when it can.
    func iface_gap(self, anon actual: TypeKind, iface_idx: int64) -> str {
        mut boxable = false
        match actual {
            .KStruct(_idx, _type_args) -> boxable = true
            .KInt64 -> boxable = true
            .KStr -> boxable = true
            .KBool -> boxable = true
            else none
        }
        if boxable == false or self.kind_has_unknown(actual) {
            return ""
        }
        for m in self.interfaces[iface_idx].methods {
            mut found = false
            mut sig = m.sig
            if actual is .KStruct(struct_idx, _args) {
                if self.structs[struct_idx].method_idx.get(m.name) is Some(mi) {
                    found = true
                    sig = self.structs[struct_idx].methods[mi].sig
                }
            } else {
                let pm = self.find_prim_method(m.name, kind: actual)
                if pm >= 0 {
                    found = true
                    sig = self.prim_methods[pm].sig
                }
            }
            if found == false {
                return f"missing method `{m.name}`"
            }
            let want = self.method_kind(m.sig)
            let got = self.method_kind(sig)
            if self.same_kind(want, got) == false {
                return f"method `{m.name}` is `{self.kind_display(got)}`, not `{self.kind_display(want)}`"
            }
        }
        return ""
    }

    // A method's type without its `self` receiver.
    func method_kind(self, anon sig: SigInfo) -> TypeKind {
        mut params: [TypeKind] = []
        mut i = 0
        for pk in sig.param_kinds {
            if i > 0 or sig.param_names[0] != "self" {
                params += [pk]
            }
            i += 1
        }
        return .KFunc(param_kinds: params, return_kind: sig.return_kind)
    }

    func is_to_str_sig(self, anon sig: SigInfo) -> bool {
        let no_params: [TypeKind] = []
        return self.same_kind(self.method_kind(sig), .KFunc(param_kinds: no_params, return_kind: .KStr))
    }

    // Box a primitive value (int64 / str / bool) into a {data, vtable}
    // iface cell. The primitive value is stored *directly* in the data
    // slot — vtable methods receive it as `self` in x0. Mirrors
    // emit_iface_box but reaches a primitive's vtable.
    func emit_prim_iface_box(self, anon arg_reg: str, kind: TypeKind, iface_idx: int64) -> str {
        let vt_lbl = self.register_prim_vtable(iface_idx, :kind)
        let arg_spilled = self.preserve_begin(arg_reg)
        self.emit("mov x0, #16")
        self.emit("bl _arena_alloc")
        let data_r = self.preserve_end(arg_reg, spilled: arg_spilled)
        self.emit(f"str {data_r}, [x0]")
        self.pool.free_reg(data_r)
        let vt_r = self.pool.alloc_reg()
        self.emit(f"adrp {vt_r}, {vt_lbl}@PAGE")
        self.emit(f"add {vt_r}, {vt_r}, {vt_lbl}@PAGEOFF")
        self.emit(f"str {vt_r}, [x0, #8]")
        self.pool.free_reg(vt_r)
        let cell_r = self.pool.alloc_reg()
        self.emit(f"mov {cell_r}, x0")
        return cell_r
    }

    // A default compiles in its declaring module and can't see the caller's locals.
    func compile_default(self, anon default_id: int64, expected: TypeKind, src_p: parsing.Parser) -> str {
        let saved_p = self.p
        let saved_vars = self.vars
        let saved_log = self.bound_log
        self.p = src_p
        self.vars = []
        self.bound_log = []
        self.collect_expr_vars(default_id)
        let reg = self.compile_into(default_id, :expected)
        self.p = saved_p
        self.vars = saved_vars
        self.bound_log = saved_log
        return reg
    }

    // At the declaration, so a default no call omits is still checked.
    func check_default(self, anon default_id: int64, expected: TypeKind) -> none {
        let saved_vars = self.vars
        let saved_slots = self.frame_slots
        let saved_log = self.bound_log
        self.vars = []
        self.bound_log = []
        self.stmt_error_mark = self.report_attempts
        self.checking_default = true
        self.collect_expr_vars(default_id)
        self.check_value_kind(default_id, :expected)
        self.checking_default = false
        self.vars = saved_vars
        self.frame_slots = saved_slots
        self.bound_log = saved_log
    }

    func prepare_args_with_kinds(self, anon args: [ast.CallArg], expected_kinds: [TypeKind], default_exprs: [int64], src_p: parsing.Parser) -> none {
        let arg_regs: [str] = ["x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7"]
        // When the call has fewer args than the function declares,
        // missing slots fill from `default_exprs` (compiled in the
        // function's defining-module parser via `src_p`). Otherwise
        // `total` collapses to `n_args` and the loop matches the
        // pre-defaults behaviour exactly.
        let n_args = len(args)
        mut total = n_args
        if len(expected_kinds) > total {
            total = len(expected_kinds)
        }
        if total == 0 {
            return none
        }
        // Reserve 16-byte aligned stack space and stash each compiled arg
        // there. Compiling an arg may issue bl calls (e.g. into match
        // expressions, struct/enum construction, array concat) which would
        // clobber any earlier args we'd already placed into x0..x7.
        mut padded = total * 8
        if padded % 16 != 0 {
            padded = padded + 8
        }
        self.emit(f"sub sp, sp, #{padded}")
        mut i = 0
        for i < total {
            mut arg_reg = ""
            if i < n_args {
                if i < len(expected_kinds) {
                    arg_reg = self.compile_into(args[i].value, expected: expected_kinds[i])
                } else {
                    let arg_val = self.compile_expr(args[i].value)
                    arg_reg = self.load(arg_val)
                }
            } else {
                arg_reg = self.compile_default(default_exprs[i], expected: expected_kinds[i], :src_p)
            }
            self.emit(f"str {arg_reg}, [sp, #{i * 8}]")
            self.pool.free_reg(arg_reg)
            i = i + 1
        }
        mut k = 0
        for k < total and k < len(arg_regs) {
            self.emit(f"ldr {arg_regs[k]}, [sp, #{k * 8}]")
            k = k + 1
        }
        self.emit(f"add sp, sp, #{padded}")
    }

    func compile_match_expr(self, anon arms: [int64], subject_id: int64) -> Val {
        let kind = self.match_expr_kind(arms, subject_kind: self.infer_kind(subject_id))
        return self.compile_match_expr_for(arms, :subject_id, expected: kind, ok_wrap: false)
    }

    func compile_match_expr_for(self, anon arms: [int64], subject_id: int64, expected: TypeKind, ok_wrap: bool) -> Val {
        if self.infer_kind(subject_id) is .KUnknown {
            self.compile_discard(subject_id)
            self.report_cannot_infer(subject_id, what: "this expression")
            return .VImm(value: 0)
        }
        mut expr_patterns: [int64] = []
        for arm_id in arms {
            expr_patterns += [self.p.match_expr_arms[arm_id].pattern]
        }
        let attempts_before = self.report_attempts
        self.check_match_subject(subject_id, pattern_ids: expr_patterns)
        if self.report_attempts == attempts_before {
            self.check_match_exhaustive(subject_id, pattern_ids: expr_patterns)
        }
        // Static enum kind for `.Foo` pattern disambiguation. See
        // compile_match_stmt for the analogous reasoning.
        let subj_kind = self.infer_kind(subject_id)
        let subj_enum_idx: int64 = self.enum_idx_of_kind(subj_kind)
        let done_lbl = self.fresh("Lmexpr_done")
        let subj_val = self.compile_expr(subject_id)
        let sptr_r = self.load(subj_val)
        let subj_slot = self.alloc_var(name: self.fresh("__msubj"), kind: .KInt64)
        self.emit_str(subj_slot, reg: sptr_r)
        self.pool.free_reg(sptr_r)
        let disc_val = .VStack(offset: subj_slot)
        let disc_r = self.load_enum_or_val(disc_val, expr_id: subject_id)
        let result_r = self.pool.alloc_reg()
        mut i = 0
        for i < len(arms) {
            let arm = self.p.match_expr_arms[arms[i]]
            let skip_lbl = self.fresh("Lmexpr_skip")
            match self.subject_pattern(self.p.patterns[arm.pattern], subject_kind: subj_kind) {
                .Wildcard -> {
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                }
                .IntPat(value) -> {
                    self.emit_cmp_imm(disc_r, :value)
                    self.emit(f"bne {skip_lbl}")
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .BoolPat(value) -> {
                    mut lit = 0
                    if value {
                        lit = 1
                    }
                    self.emit(f"cmp {disc_r}, #{lit}")
                    self.emit(f"bne {skip_lbl}")
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .StrPat(value) -> {
                    let slbl = self.intern_str(value)
                    self.emit(f"adrp x0, {slbl}@PAGE")
                    self.emit(f"add x0, x0, {slbl}@PAGEOFF")
                    // Reload from subj_slot — disc_r may have been clobbered
                    // by a prior arm's `bl _kod_str_cmp`.
                    self.emit_ldr(subj_slot, reg: "x1")
                    self.emit("bl _kod_str_cmp")
                    self.emit("cmp x0, #0")
                    self.emit(f"bne {skip_lbl}")
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .EnumPat(_enum_name, _variant_name, _bindings) -> {
                    self.emit_variant_test(self.p.patterns[arm.pattern], :subj_enum_idx, :disc_r, :subj_slot, :skip_lbl, span: self.p.expr_spans[subject_id])
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .ImplicitEnumPat(_variant_name, _bindings) -> {
                    self.emit_variant_test(self.p.patterns[arm.pattern], :subj_enum_idx, :disc_r, :subj_slot, :skip_lbl, span: self.p.expr_spans[subject_id])
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .NonePat -> {
                    self.emit(f"cmp {disc_r}, #0")
                    self.emit(f"bne {skip_lbl}")
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .SomePat(binding) -> {
                    self.emit(f"cmp {disc_r}, #0")
                    self.emit(f"beq {skip_lbl}")
                    if len(binding) > 0 {
                        let boff = self.find_var_offset(binding)
                        let ptr_r = self.pool.alloc_reg()
                        self.emit_ldr(subj_slot, reg: ptr_r)
                        let val_r = self.pool.alloc_reg()
                        self.emit(f"ldr {val_r}, [{ptr_r}]")
                        self.emit_str(boff, reg: val_r)
                        self.pool.free_reg(val_r)
                        self.pool.free_reg(ptr_r)
                    }
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .OkPat(binding) -> {
                    self.emit(f"cmp {disc_r}, #{self.result_ok_disc()}")
                    self.emit(f"bne {skip_lbl}")
                    self.bind_result_payload(binding, :subj_slot)
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .ErrPat(binding) -> {
                    self.emit(f"cmp {disc_r}, #{self.result_ok_disc()}")
                    self.emit(f"beq {skip_lbl}")
                    self.bind_result_payload(binding, :subj_slot)
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .TypePat(type_name, binding) -> {
                    self.emit_typepat_test(:type_name, :binding, :subject_id, :subj_slot, :skip_lbl)
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                else {
                    self.compile_arm_value(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind, :expected, :ok_wrap, :result_r)
                    self.emit(f"b {done_lbl}")
                }
            }
            i = i + 1
        }
        self.emit_label(done_lbl)
        self.pool.free_reg(disc_r)
        return .VReg(name: result_r)
    }


    // For `obj.method()` where obj is a known struct, return the method's
    // recorded return kind. Returns none if anything about the shape doesn't
    // match (callee not Ident.Ident, obj not a struct, method not found).
    func method_call_return_kind(self, callee_lhs: int64, callee_rhs: int64) -> TypeKind? {
        let .Ident(method_name) = self.p.exprs[callee_rhs] else { return none }
        let enum3 = self.three_part_ctor_enum(callee_lhs, variant_name: method_name)
        if enum3 >= 0 {
            return self.ctor_kind(enum3)
        }
        let enum2 = self.two_part_ctor_enum(callee_lhs, variant_name: method_name)
        if enum2 >= 0 {
            return self.ctor_kind(enum2)
        }
        if self.p.exprs[callee_lhs] is .Ident(maybe_mod) {
            if self.is_import_alias(maybe_mod) {
                let struct_idx = self.find_struct_idx(method_name)
                if struct_idx >= 0 {
                    return .KStruct(idx: struct_idx, type_args: [])
                }
                let fn_idx = self.lookup_import_fn(maybe_mod, method_name)
                if fn_idx == -1 {
                    return .KUnknown
                }
                return self.import_fn_at(fn_idx).sig.return_kind
            }
        }
        // Recurse via infer_kind so receivers like `0.to_str()` (IntLit
        // receiver) or `p.field.to_str()` (Binary.Dot receiver) get the
        // right kind, not just bare `var.method()`.
        let obj_kind = self.infer_kind(callee_lhs)
        if obj_kind is .KInterface(iidx) {
            mut method_idx = 0
            for method_idx < len(self.interfaces[iidx].methods) {
                if self.interfaces[iidx].methods[method_idx].name == method_name {
                    return self.interfaces[iidx].methods[method_idx].sig.return_kind
                }
                method_idx = method_idx + 1
            }
            return none
        }
        if obj_kind is .KStruct(sidx, _struct_type_args) {
            // compile_call prefers a function-typed field over a method.
            if self.has_field(method_name, struct_idx: sidx) {
                if self.find_field_kind(method_name, struct_idx: sidx) is .KFunc(_params, field_ret) {
                    return field_ret
                }
            }
            if self.structs[sidx].method_idx.get(method_name) is Some(mi) {
                return self.structs[sidx].methods[mi].sig.return_kind
            }
            return none
        }
        // Primitive receivers (int64.to_str, str.hash, etc.) go through
        // the primitive method table.
        let prim_idx = self.find_prim_method(method_name, kind: obj_kind)
        if prim_idx >= 0 {
            return self.prim_methods[prim_idx].sig.return_kind
        }
        return none
    }

    // For an expression of shape `mod.Enum.Variant`, return KEnum(idx).
    func three_part_enum_kind(self, dot_lhs: int64) -> TypeKind? {
        let .Binary(inner_lhs, inner_op, inner_rhs) = self.p.exprs[dot_lhs] else { return none }
        let .Dot = inner_op else { return none }
        let .Ident(enum_name) = self.p.exprs[inner_rhs] else { return none }
        let enum_idx = self.find_enum_idx(enum_name)
        if enum_idx < 0 { return none }
        return self.ctor_kind(enum_idx)
    }

    // For `EnumName.X`, return KEnum(idx). (X is checked at the call site.)
    func two_part_enum_kind(self, dot_lhs: int64) -> TypeKind? {
        let .Ident(type_name) = self.p.exprs[dot_lhs] else { return none }
        let enum_idx = self.find_enum_idx(type_name)
        if enum_idx < 0 { return none }
        return self.ctor_kind(enum_idx)
    }

    // A generic enum's variant doesn't say which instance it builds.
    func ctor_kind(self, anon enum_idx: int64) -> TypeKind {
        if len(self.enums[enum_idx].type_param_names) > 0 {
            return .KUnknown
        }
        return .KEnum(idx: enum_idx)
    }

    // Look up a struct field's kind by name. Returns none if absent.
    func struct_field_kind(self, struct_idx: int64, field_name: str) -> TypeKind? {
        mut field_idx = 0
        for field_idx < len(self.structs[struct_idx].fields) {
            if self.structs[struct_idx].fields[field_idx].name == field_name {
                return self.structs[struct_idx].fields[field_idx].kind
            }
            field_idx = field_idx + 1
        }
        return none
    }

    func infer_kind(self, anon expr_id: int64) -> TypeKind {
        match self.p.exprs[expr_id] {
            .IntLit(value) -> {
                if len(self.p.bad_lits) > 0 and self.is_bad_lit(expr_id) {
                    return .KUnknown
                }
                return .KInt64
            }
            .BoolLit(value) -> return .KBool
            .StrLit(value) -> return .KStr
            .BytesLit(value) -> return .KBytes
            .NoneLit -> return .KOptional(inner: .KVoid)
            .Ident(name) -> {
                let i = self.var_index(name)
                if i >= 0 and (self.reads_scoped == false or self.vars[i].bound) {
                    return self.slot_kind(i)
                }
                // Function-as-value reference: synthesise a KFunc
                // from the function's pre-resolved signature so
                // `let f = foo` infers `f: func(...) -> R`.
                let slot = self.lookup_func(name)
                if i >= 0 and slot == -1 {
                    return self.slot_kind(i)
                }
                if slot != -1 {
                    let sig: SigInfo = self.fn_sig(slot)
                    return .KFunc(param_kinds: sig.param_kinds, return_kind: sig.return_kind)
                }
                return .KUnknown
            }
            .ArrayLit(elements) -> {
                // Peek at the first element so `for x in [s]` knows the
                // element type — otherwise the foreach falls back to
                // KInt64 and `x.field` reads from offset 0.
                if len(elements) == 0 {
                    return .KArray
                }
                return self.array_kind_of(self.infer_kind(elements[0]))
            }
            // Slice preserves the subject's kind — `str[lo..hi]` is `str`,
            // `[T][lo..hi]` is `[T]`.
            .Slice(s, lo, hi) -> {
                let k = self.infer_kind(s)
                if self.is_array_kind(k) {
                    return k
                }
                match k {
                    .KStr -> return .KStr
                    .KBytes -> return .KBytes
                    else return .KUnknown
                }
            }
            .ImplicitVariant(name) -> {
                let enum_idx = self.find_enum_with_variant(name)
                if enum_idx >= 0 {
                    return self.ctor_kind(enum_idx)
                }
                return .KUnknown
            }
            .Call(callee, args) -> {
                match self.p.exprs[callee] {
                    .Ident(name) -> {
                        if name == "$str" or (name == "str" and self.is_builtin_call(name)) {
                            return .KStr
                        }
                        if name == "hash" and self.is_builtin_call(name) {
                            return .KInt64
                        }
                        // Struct or enum constructor: TypeName(...)
                        let struct_idx = self.find_struct_idx(name)
                        if struct_idx >= 0 {
                            if len(self.structs[struct_idx].type_param_names) > 0 {
                                return .KUnknown
                            }
                            return .KStruct(idx: struct_idx, type_args: [])
                        }
                        // A local of function type shadows a function name.
                        if self.calls_local(name) {
                            if self.find_var_kind(name) is .KFunc(_var_params, var_ret) {
                                return var_ret
                            }
                        }
                        let enum_idx = self.find_enum_idx(name)
                        if enum_idx >= 0 {
                            return self.ctor_kind(enum_idx)
                        }
                        // Free function call: use the cached return kind.
                        let slot = self.lookup_func(name)
                        if slot != -1 {
                            return self.fn_sig(slot).return_kind
                        }
                    }
                    .Binary(call_lhs, call_op, call_rhs) -> {
                        match call_op {
                            .Dot -> {
                                if self.method_call_return_kind(callee_lhs: call_lhs, callee_rhs: call_rhs) is Some(k) {
                                    return k
                                }
                                // Re-inferring the callee would double the work per chained call.
                                return .KUnknown
                            }
                            .Index -> {
                                let ctor_idx = self.generic_ctor_instance(callee, report: false)
                                if ctor_idx >= 0 {
                                    if len(self.structs[ctor_idx].type_param_names) > 0 {
                                        return .KUnknown
                                    }
                                    return .KStruct(idx: ctor_idx, type_args: [])
                                }
                            }
                            else none
                        }
                    }
                    .ImplicitVariant(variant_name) -> {
                        // .Variant(args) — constructor for an enum.
                        let ei2 = self.find_enum_with_variant(variant_name)
                        if ei2 >= 0 {
                            return self.ctor_kind(ei2)
                        }
                    }
                    else none
                }
                // Indirect call through any function-valued callee.
                if self.infer_kind(callee) is .KFunc(_params, ret) {
                    return ret
                }
                return .KUnknown
            }
            .Chain(_exprs, _ops) -> return .KBool
            .MatchExpr(subject, arms) -> return self.match_expr_kind(arms, subject_kind: self.infer_kind(subject))
            .Binary(lhs, op, rhs) -> {
                match op {
                    .Dot -> {
                        // `mod.Enum.Variant` or `Enum.Variant` — unit-variant ref.
                        if self.three_part_enum_kind(dot_lhs: lhs) is Some(k) {
                            return k
                        }
                        if self.two_part_enum_kind(dot_lhs: lhs) is Some(k) {
                            return k
                        }
                        // Field access on any struct-valued expression.
                        let .KStruct(struct_idx, _struct_type_args) = self.infer_kind(lhs) else { return .KUnknown }
                        let .Ident(field_name) = self.p.exprs[rhs] else { return .KUnknown }
                        match self.struct_field_kind(:struct_idx, :field_name) {
                            Some(k) -> return k
                            none -> return .KUnknown
                        }
                    }
                    .Add -> return self.concat_kind(lhs, rhs_id: rhs)
                    .Sub -> {
                        if self.is_unary_minus(lhs) and (self.infer_kind(rhs) is .KInt64) == false {
                            return .KUnknown
                        }
                        return .KInt64
                    }
                    .Eq -> return .KBool
                    .Ne -> return .KBool
                    .Lt -> return .KBool
                    .Le -> return .KBool
                    .Gt -> return .KBool
                    .Ge -> return .KBool
                    .And -> return .KBool
                    .Or -> return .KBool
                    .Is -> return .KBool
                    .IsNot -> return .KBool
                    .Index -> {
                        match self.infer_kind(lhs) {
                            .KArrayStruct(elem_idx) -> return .KStruct(idx: elem_idx, type_args: [])
                            .KArrayEnum(elem_idx) -> return .KEnum(idx: elem_idx)
                            .KArrayStr -> return .KStr
                            .KArrayBytes -> return .KBytes
                            .KArrayInterface(elem_idx) -> return .KInterface(idx: elem_idx)
                            .KArrayOptional(inner_kind) -> return .KOptional(inner: inner_kind)
                            .KArrayFunc(param_kinds, return_kind) -> return .KFunc(:param_kinds, :return_kind)
                            .KArrayBool -> return .KBool
                            .KArrayArray(inner) -> return inner
                            .KStruct(sidx, _struct_type_args) -> {
                                // Struct with op_index — return its return kind.
                                if self.structs[sidx].method_idx.get("op_index") is Some(mi) {
                                    return self.structs[sidx].methods[mi].sig.return_kind
                                }
                                return .KUnknown
                            }
                            // A str or bytes element is a byte.
                            .KStr -> return .KInt64
                            .KBytes -> return .KInt64
                            .KArray -> return .KInt64
                            else return .KUnknown
                        }
                    }
                    else return .KInt64
                }
            }
            .Try(inner) -> {
                mut k = self.infer_kind(inner)
                if self.is_result_kind(k) {
                    return self.result_inner_kind(k)
                }
                return k
            }
            .Must(inner) -> {
                mut k = self.infer_kind(inner)
                if self.is_result_kind(k) {
                    return self.result_inner_kind(k)
                }
                return k
            }
            .UnwrapOpt(value, _default) -> {
                let k = self.infer_kind(value)
                if k is .KOptional(inner) {
                    return inner
                }
                return k
            }
            .OptionalDot(value, field) -> {
                // `x?.field` returns U?: look through the value's Optional
                // to its inner struct, find the field's kind, and re-wrap.
                let struct_idx = self.find_struct_idx_of_optional(value)
                if struct_idx >= 0 {
                    let field_kind = self.find_field_kind(field, struct_idx: struct_idx)
                    if field_kind is .KUnknown {
                        return .KUnknown
                    }
                    return .KOptional(inner: field_kind)
                }
                return .KUnknown
            }
            .OptionalMethodCall(value, method, _args) -> {
                // `x?.method(args)` returns U?: look up the method on the
                // value's inner struct and re-wrap its return type.
                let struct_idx = self.find_struct_idx_of_optional(value)
                if struct_idx >= 0 {
                    if self.structs[struct_idx].method_idx.get(method) is Some(mi) {
                        return .KOptional(inner: self.structs[struct_idx].methods[mi].sig.return_kind)
                    }
                }
                return .KUnknown
            }
            .FuncLit(decl_id) -> {
                // Same shape as a named function reference — return
                // a KFunc built from the synthesised entry's
                // pre-resolved signature.
                let slot = self.lookup_lambda(decl_id)
                if slot != -1 {
                    let sig: SigInfo = self.fn_sig(slot)
                    return .KFunc(param_kinds: sig.param_kinds, return_kind: sig.return_kind)
                }
                return .KUnknown
            }
            else return .KUnknown
        }
    }


    func compile_stmt(self, anon stmt_id: int64) -> none {
        self.mark_stmt_line(stmt_id)
        self.stmt_error_mark = self.report_attempts
        match self.p.stmts[stmt_id] {
            .Let(name, typ, value, mutable) -> {
                mut before = self.p.expr_spans[value].start
                if typ != 0 {
                    before = self.p.type_spans[typ].start
                }
                let off = self.name_before(name, off: before)
                if self.rebinds_outer(name, :off, depth: self.block_depth) {
                    self.compile_discard(value)
                    self.update_var_kind(:name, kind: .KUnknown)
                } else {
                    self.compile_let(:name, :typ, :value, :mutable)
                    self.bind_at(name, :off, depth: self.block_depth)
                }
            }
            .Assign(lhs, rhs) -> self.compile_assign(lhs_id: lhs, rhs_id: rhs)
            .PlusAssign(lhs, rhs) -> self.compile_plus_assign(lhs_id: lhs, rhs_id: rhs)
            .MinusAssign(lhs, rhs) -> self.compile_minus_assign(lhs_id: lhs, rhs_id: rhs)
            .Return(value) -> self.compile_return(value)
            .If(cond, then_body, else_body) -> self.compile_if(cond_id: cond, :then_body, :else_body)
            .For(cond, body) -> self.compile_for(body, cond_id: cond)
            .ForEach(name, iter, body) -> self.compile_foreach(body, :name, iter_id: iter)
            .Break -> self.compile_break()
            .Continue -> self.compile_continue()
            .ExprStmt(expr) -> {
                let val = self.compile_expr(expr)
                self.free_val(val)
            }
            .MatchStmt(subject, arms) -> self.compile_match_stmt(arms, subject_id: subject)
            .LetElse(pattern, value, else_body) -> {
                if self.pattern_rebinds_outer(pattern, depth: self.block_depth) {
                    self.compile_discard(value)
                    for name in self.pattern_binding_names(self.p.patterns[pattern]) {
                        self.update_var_kind(:name, kind: .KUnknown)
                    }
                } else {
                    self.compile_let_else(else_body, pattern_id: pattern, value_id: value)
                    self.bind_pattern_at(pattern, depth: self.block_depth)
                }
            }
            .Throw(value) -> self.compile_throw(value)
            .Assert(expr, source_text, span) -> self.compile_assert(expr, :source_text, :span)
        }
    }

    func compile_let(self, name: str, typ: int64, value: int64, mutable: bool) -> none {
        self.check_type_expr(typ)
        self.note_wide_fn_local(name, :value)
        let off = self.find_var_offset(name)
        mut kind = self.resolve_type(typ)
        if typ == 0 {
            kind = self.infer_kind(value)
            if self.is_untyped_literal(value) or self.is_none_kind(kind) {
                kind = .KUnknown
            }
        }
        let mark = self.report_attempts
        self.compile_store(dest_off: off, :kind, value_id: value)
        if typ == 0 {
            if kind is .KUnknown {
                self.report_cannot_infer(value, what: f"`{name}`")
            } else {
                self.check_unannotated_literal(value, :kind)
            }
        } else {
            self.check_value_kind(value, expected: kind)
        }
        // Only now: the value reads a binding of the same name with its old type.
        mut i = 0
        for i < len(self.vars) {
            if self.vars[i].name == name {
                self.vars[i].kind = kind
                self.vars[i].mutable = mutable
                i = len(self.vars)
            } else {
                i = i + 1
            }
        }
        if typ == 0 and self.report_attempts > mark {
            self.update_var_kind(:name, kind: .KUnknown)
        }
    }

    // Building it as its first element's type converts the rest unchecked.
    func check_unannotated_literal(self, anon value_id: int64, kind: TypeKind) -> none {
        if self.p.exprs[value_id] is .ArrayLit(elements) {
            if self.elem_needs_conversion(self.first_elem_kind(elements)) {
                self.check_value_kind(value_id, expected: kind)
            }
        }
    }

    func kinds_compatible(self, anon expected: TypeKind, actual: TypeKind) -> bool {
        if expected is .KUnknown {
            return true
        }
        if actual is .KUnknown {
            return true
        }
        match expected {
            .KOptional(inner) -> {
                if self.is_none_kind(actual) {
                    return true
                }
                if actual is .KOptional(actual_inner) {
                    if self.nests_into(actual, slot: expected) == false {
                        return self.payloads_compatible(inner, actual: actual_inner)
                    }
                }
                return self.kinds_compatible(inner, :actual)
            }
            .KInterface(idx) -> {
                match actual {
                    .KStruct(_a_idx, _a_args) -> return true
                    .KInt64 -> return true
                    .KBool -> return true
                    .KStr -> return true
                    .KInterface(a_idx) -> return self.same_iface(idx, a_idx)
                    else return false
                }
            }
            .KVoid -> return self.is_void_kind(actual) or self.is_none_kind(actual)
            .KStruct(idx, _type_args) -> {
                if actual is .KStruct(a_idx, _a_args) {
                    return self.same_struct(idx, a_idx)
                }
                return false
            }
            .KEnum(idx) -> {
                if actual is .KEnum(a_idx) {
                    return self.enums_compatible(idx, :a_idx)
                }
                return false
            }
            .KFunc(param_kinds, return_kind) -> {
                if actual is .KFunc(a_params, a_return) {
                    return self.sigs_compatible(param_kinds, :return_kind, :a_params, :a_return)
                }
                return false
            }
            else none
        }
        if self.is_array_kind(expected) {
            return self.array_kinds_compatible(expected, :actual)
        }
        return self.same_primitive(expected, :actual)
    }

    // An optional is passed on as it is, so its payload can't be boxed.
    func payloads_compatible(self, anon expected: TypeKind, actual: TypeKind) -> bool {
        if expected is .KInterface(idx) {
            match actual {
                .KInterface(a_idx) -> return self.same_iface(idx, a_idx)
                .KUnknown -> return true
                else return false
            }
        }
        return self.kinds_compatible(expected, :actual)
    }

    // A TypeKind param: the snapshot types payload bindings as int64.
    func is_none_kind(self, anon kind: TypeKind) -> bool {
        if kind is .KOptional(inner) {
            return self.is_void_kind(inner)
        }
        return false
    }

    func is_void_kind(self, anon kind: TypeKind) -> bool {
        match kind {
            .KVoid -> return true
            else return false
        }
    }

    // A `T?` going where an optional `T?` goes gets a Some cell, like a `T` into a `T?`.
    func nests_into(self, anon actual: TypeKind, slot: TypeKind) -> bool {
        return self.is_none_kind(actual) == false and self.optional_depth(actual) < self.optional_depth(slot)
    }

    func optional_depth(self, anon kind: TypeKind) -> int64 {
        if kind is .KOptional(inner) {
            return 1 + self.optional_depth(inner)
        }
        return 0
    }

    // An implicit variant infers the enum template, not the instance.
    func enums_compatible(self, anon idx: int64, a_idx: int64) -> bool {
        if idx == a_idx or self.same_enum_decl(idx, a_idx) {
            return true
        }
        if self.enums[idx].template_idx == a_idx {
            return true
        }
        return self.enums[a_idx].template_idx == idx
    }

    // A function value is never adapted, so its kinds must match exactly.
    func sigs_compatible(self, anon param_kinds: [TypeKind], return_kind: TypeKind, a_params: [TypeKind], a_return: TypeKind) -> bool {
        if len(param_kinds) != len(a_params) {
            return false
        }
        mut i = 0
        for pk in param_kinds {
            if self.same_kind(pk, a_params[i]) == false {
                return false
            }
            i += 1
        }
        return self.same_kind(return_kind, a_return)
    }

    func same_kind(self, anon a: TypeKind, anon b: TypeKind) -> bool {
        if self.either_unknown(a, b) {
            return true
        }
        return self.canonical_kind_name(a) == self.canonical_kind_name(b)
    }

    // A bare `none` or `[]`, whose type comes only from where it goes.
    func is_untyped_literal(self, anon value_id: int64) -> bool {
        match self.p.exprs[value_id] {
            .NoneLit -> return true
            .ArrayLit(elements) -> return len(elements) == 0
            else return false
        }
    }

    func array_kinds_compatible(self, anon expected: TypeKind, actual: TypeKind) -> bool {
        if self.is_array_kind(actual) == false {
            return false
        }
        match expected {
            .KArrayStruct(idx) -> {
                if actual is .KArrayStruct(a_idx) {
                    return self.same_struct(idx, a_idx)
                }
                return false
            }
            .KArrayEnum(idx) -> {
                if actual is .KArrayEnum(a_idx) {
                    return self.enums_compatible(idx, :a_idx)
                }
                return false
            }
            .KArrayInterface(idx) -> {
                if actual is .KArrayInterface(a_idx) {
                    return self.same_iface(idx, a_idx)
                }
                return false
            }
            .KArrayOptional(inner) -> {
                if actual is .KArrayOptional(a_inner) {
                    return self.payloads_compatible(inner, actual: a_inner)
                }
                return false
            }
            .KArrayFunc(param_kinds, return_kind) -> {
                if actual is .KArrayFunc(a_params, a_return) {
                    return self.sigs_compatible(param_kinds, :return_kind, :a_params, :a_return)
                }
                return false
            }
            .KArrayArray(inner) -> {
                if actual is .KArrayArray(a_inner) {
                    return self.kinds_compatible(inner, actual: a_inner)
                }
                return false
            }
            else none
        }
        return self.same_primitive(expected, :actual)
    }

    // Kinds without payloads compare by variant.
    func same_primitive(self, anon expected: TypeKind, actual: TypeKind) -> bool {
        return self.canonical_kind_name(expected) == self.canonical_kind_name(actual)
    }

    func array_elem_kind(self, anon kind: TypeKind) -> TypeKind {
        match kind {
            .KArray -> return .KInt64
            .KArrayStruct(idx) -> return .KStruct(:idx, type_args: [])
            .KArrayEnum(idx) -> return .KEnum(:idx)
            .KArrayStr -> return .KStr
            .KArrayBytes -> return .KBytes
            .KArrayInterface(idx) -> return .KInterface(:idx)
            .KArrayOptional(inner) -> return .KOptional(:inner)
            .KArrayFunc(param_kinds, return_kind) -> return .KFunc(:param_kinds, :return_kind)
            .KArrayBool -> return .KBool
            .KArrayArray(inner) -> return inner
            else return .KUnknown
        }
    }

    // These resolve against the declared enum, not by inference.
    func is_implicit_variant_value(self, anon value_id: int64) -> bool {
        match self.p.exprs[value_id] {
            .ImplicitVariant(_name) -> return true
            .Call(callee, _args) -> {
                if self.p.exprs[callee] is .ImplicitVariant(_name) {
                    return true
                }
            }
            else none
        }
        return false
    }

    func expected_enum_idx(self, anon kind: TypeKind) -> int64 {
        match kind {
            .KEnum(idx) -> return idx
            .KOptional(inner) -> return self.expected_enum_idx(inner)
            else return -1
        }
    }

    func implicit_variant_name(self, anon value_id: int64) -> str {
        mut callee = value_id
        if self.p.exprs[value_id] is .Call(call_callee, _args) {
            callee = call_callee
        }
        if self.p.exprs[callee] is .ImplicitVariant(name) {
            return name
        }
        return ""
    }

    // Quiet when the statement already reported an error.
    func check_value_kind(self, anon value_id: int64, expected: TypeKind) -> none {
        self.check_value_as(value_id, :expected, slot: expected)
    }

    // `slot` is what a mismatch names: the `T?` a value is checked for as a `T`.
    func check_value_as(self, anon value_id: int64, expected: TypeKind, slot: TypeKind) -> none {
        if self.report_attempts > self.stmt_error_mark {
            return
        }
        if self.is_ctor_for(value_id, kind: expected) {
            return
        }
        if self.wraps_into_optional(value_id, :expected) {
            self.check_value_as(value_id, expected: self.optional_inner(expected), :slot)
            return
        }
        if self.is_implicit_variant_value(value_id) {
            let enum_idx = self.expected_enum_idx(expected)
            if enum_idx >= 0 {
                if self.checking_default == false {
                    self.check_variant(self.implicit_variant_name(value_id), :enum_idx, span: self.p.expr_spans[value_id])
                }
                return
            }
        }
        if self.p.exprs[value_id] is .ArrayLit(elements) {
            if self.is_array_kind(expected) {
                let elem = self.array_elem_kind(expected)
                for e in elements {
                    self.check_value_kind(e, expected: elem)
                }
                return
            }
        }
        if self.p.exprs[value_id] is .Binary(lhs, op, rhs) {
            if op is .Add {
                if self.is_array_kind(expected) {
                    self.check_value_kind(lhs, :expected)
                    self.check_value_kind(rhs, :expected)
                    return
                }
            }
        }
        if self.p.exprs[value_id] is .MatchExpr(subject, arms) {
            let subject_kind = self.infer_kind(subject)
            for arm_id in arms {
                let arm = self.p.match_expr_arms[arm_id]
                let pattern = self.p.patterns[arm.pattern]
                let saved = self.retype_pattern_bindings(pattern, :subject_kind)
                let mark = len(self.bound_log)
                self.bind_pattern(pattern)
                if self.is_void_kind(self.infer_kind(arm.body)) == false {
                    self.check_value_as(arm.body, :expected, :slot)
                }
                self.unbind_to(mark)
                self.restore_pattern_bindings(pattern, kinds: saved)
            }
            return
        }
        let actual = self.infer_kind(value_id)
        if actual is .KUnknown {
            self.report_cannot_infer(value_id, what: "this expression", typed_slot: true)
            return
        }
        if self.kinds_compatible(expected, :actual) or self.either_unknown(expected, actual) {
            return
        }
        let shown = self.kind_display(actual)
        mut hint = ""
        if self.is_result_kind(expected) and self.kinds_compatible(self.result_inner_kind(expected), :actual) {
            hint = "; write `.Ok(value: ...)` for a successful result"
        } else if self.is_some_optional(actual) and self.kinds_compatible(expected, actual: self.optional_inner(actual)) {
            hint = self.unwrap_hint(value_id)
            if expected is .KOptional(_inner) {
                hint = self.rewrap_hint(value_id)
            }
        } else if self.is_void_kind(actual) and value_id == self.diverge_ok_id {
            hint = self.diverge_hint(value_id)
        }
        self.report_error(f"error: expected `{self.kind_display(slot)}`, got `{shown}`{hint}", span: self.p.expr_spans[value_id])
    }

    // As compile_value_for_kind wraps it, after building it as the inner type.
    func wraps_into_optional(self, anon value_id: int64, expected: TypeKind) -> bool {
        if expected is .KOptional(_inner) {
            if self.p.exprs[value_id] is .NoneLit {
                return false
            }
            let actual = self.infer_kind(value_id)
            match actual {
                .KOptional(_actual_inner) -> return self.nests_into(actual, slot: expected)
                .KUnknown -> return false
                else return true
            }
        }
        return false
    }

    // Compile `value_id` into a register, applying any kind-specific
    // wrapping/boxing needed before the result can be stored into a
    // slot of `expected` kind. The two cases that matter today:
    //
    //   - KOptional: a bare `int64?` field assigned `42` must round-trip
    //     as `Some(42)` — wrap in an arena cell unless the value is
    //     already as optional as the slot (a NoneLit, an inferred-Optional
    //     expr, or a Call return whose kind we don't track).
    //   - KInterface: assigning a struct value to an iface-typed slot
    //     needs the {data, vtable} box; storing the raw struct pointer
    //     would make the next method dispatch load garbage from offset 8.
    //
    // All other kinds pass through as plain compile_expr + load.
    // Returns the register holding the prepared value — the caller does
    // the actual store and is responsible for freeing the register.
    func compile_value_for_kind(self, anon value_id: int64, expected: TypeKind) -> str {
        if self.p.exprs[value_id] is .MatchExpr(subject, arms) {
            let val = self.compile_match_expr_for(arms, subject_id: subject, :expected, ok_wrap: false)
            return self.load(val)
        }
        match expected {
            .KEnum(idx) -> {
                let variant_idx = self.ctor_variant_idx(value_id, enum_idx: idx)
                if variant_idx >= 0 {
                    let val = self.compile_enum_construct(self.ctor_args(value_id), enum_idx: idx, :variant_idx, span: self.p.expr_spans[value_id])
                    return self.load(val)
                }
                let val = self.compile_expr(value_id)
                self.report_if_unknown(value_id, typed_slot: true)
                return self.load(val)
            }
            .KOptional(inner) -> {
                mut needs_wrap = true
                mut unknown = false
                match self.p.exprs[value_id] {
                    .NoneLit -> needs_wrap = false
                    else none
                }
                if self.is_ctor_for(value_id, kind: inner) == false and needs_wrap {
                    let actual = self.infer_kind(value_id)
                    match actual {
                        .KOptional(_inner2) -> needs_wrap = self.nests_into(actual, slot: expected)
                        .KUnknown -> {
                            needs_wrap = false
                            unknown = true
                        }
                        else none
                    }
                }
                if needs_wrap == false {
                    let val = self.compile_expr(value_id)
                    if unknown {
                        self.report_cannot_infer(value_id, what: "this expression", typed_slot: true)
                    }
                    return self.load(val)
                }
                let val_reg = self.compile_value_for_kind(value_id, expected: inner)
                let val_spilled = self.preserve_begin(val_reg)
                self.emit("mov x0, #8")
                self.emit("bl _arena_alloc")
                let ptr_reg = self.pool.alloc_reg()
                self.emit(f"mov {ptr_reg}, x0")
                let tmp = self.preserve_end(val_reg, spilled: val_spilled)
                self.emit(f"str {tmp}, [{ptr_reg}]")
                self.pool.free_reg(tmp)
                return ptr_reg
            }
            .KInterface(iface_idx) -> {
                let val = self.compile_expr(value_id)
                mut reg = self.load(val)
                let actual = self.infer_kind(value_id)
                if actual is .KUnknown {
                    self.report_cannot_infer(value_id, what: "this expression", typed_slot: true)
                    return reg
                }
                return self.maybe_box_for_iface(reg, :actual, expected: .KInterface(idx: iface_idx), span: self.p.expr_spans[value_id])
            }
            .KArrayEnum(elem_idx) -> return self.load(self.compile_typed_array_value(value_id, expected_elem: .KEnum(idx: elem_idx)))
            .KArrayInterface(elem_idx) -> return self.load(self.compile_typed_array_value(value_id, expected_elem: .KInterface(idx: elem_idx)))
            .KArrayOptional(inner_kind) -> return self.load(self.compile_typed_array_value(value_id, expected_elem: .KOptional(inner: inner_kind)))
            .KArrayArray(inner) -> {
                if self.array_needs_conversion(expected) {
                    return self.load(self.compile_typed_array_value(value_id, expected_elem: inner))
                }
                let val = self.compile_expr(value_id)
                return self.load(val)
            }
            else {
                let val = self.compile_expr(value_id)
                self.report_if_unknown(value_id, typed_slot: true)
                return self.load(val)
            }
        }
    }

    // A match expression checks its own arms while it compiles them.
    func compile_into(self, anon value_id: int64, expected: TypeKind) -> str {
        let reg = self.compile_value_for_kind(value_id, :expected)
        if self.is_match_expr(value_id) == false {
            self.check_value_kind(value_id, :expected)
        }
        return reg
    }

    func is_match_expr(self, anon value_id: int64) -> bool {
        match self.p.exprs[value_id] {
            .MatchExpr(_subject, _arms) -> return true
            else return false
        }
    }

    func compile_store(self, dest_off: int64, kind: TypeKind, value_id: int64) -> none {
        if self.p.exprs[value_id] is .MatchExpr(_subject, _arms) {
            let reg = self.compile_value_for_kind(value_id, expected: kind)
            self.emit_str(dest_off, :reg)
            self.pool.free_reg(reg)
            return
        }
        match kind {
            .KEnum(idx) -> {
                self.emit_enum_alloc(enum_idx: idx, :value_id, :dest_off)
            }
            .KStruct(_idx, _struct_type_args) -> {
                // A struct value is a pointer; storing it keeps reference semantics.
                let val = self.compile_expr(value_id)
                mut reg = self.load(val)
                self.emit_str(dest_off, :reg)
                self.pool.free_reg(reg)
            }
            .KArray -> {
                let val = self.compile_expr(value_id)
                mut reg = self.load(val)
                self.emit_str(dest_off, :reg)
                self.pool.free_reg(reg)
            }
            .KArrayStruct(elem_idx) -> {
                let val = self.compile_expr(value_id)
                mut reg = self.load(val)
                self.emit_str(dest_off, :reg)
                self.pool.free_reg(reg)
            }
            .KArrayEnum(elem_idx) -> {
                let val = self.compile_typed_array_value(value_id, expected_elem: .KEnum(idx: elem_idx))
                mut reg = self.load(val)
                self.emit_str(dest_off, :reg)
                self.pool.free_reg(reg)
            }
            .KArrayStr -> {
                let val = self.compile_expr(value_id)
                mut reg = self.load(val)
                self.emit_str(dest_off, :reg)
                self.pool.free_reg(reg)
            }
            .KArrayInterface(elem_idx) -> {
                // Array literal needs each element boxed into an iface
                // cell first; an already-typed array value (from a Call
                // or a variable) stores as-is.
                let val = self.compile_typed_array_value(value_id, expected_elem: .KInterface(idx: elem_idx))
                mut reg = self.load(val)
                self.emit_str(dest_off, :reg)
                self.pool.free_reg(reg)
            }
            .KArrayOptional(inner_kind) -> {
                let val = self.compile_typed_array_value(value_id, expected_elem: .KOptional(inner: inner_kind))
                mut reg = self.load(val)
                self.emit_str(dest_off, :reg)
                self.pool.free_reg(reg)
            }
            .KArrayArray(inner) -> {
                let reg = self.compile_value_for_kind(value_id, expected: kind)
                self.emit_str(dest_off, :reg)
                self.pool.free_reg(reg)
            }
            .KInterface(iface_idx) -> {
                // Box a struct into a {data, vtable} iface cell when the
                // declared type is an interface; passing a struct value to
                // an iface-typed binding otherwise stores the raw struct
                // pointer, and the next method call would treat it as a
                // cell and load garbage from offset 8.
                let val = self.compile_expr(value_id)
                mut reg = self.load(val)
                let actual = self.infer_kind(value_id)
                if actual is .KUnknown {
                    self.report_cannot_infer(value_id, what: "this expression", typed_slot: true)
                } else {
                    reg = self.maybe_box_for_iface(reg, :actual, expected: .KInterface(idx: iface_idx), span: self.p.expr_spans[value_id])
                }
                self.emit_str(dest_off, :reg)
                self.pool.free_reg(reg)
            }
            .KOptional(inner) -> {
                // Wrap into an Optional cell unless the value is already as
                // optional as the slot (NoneLit, Call return, or an inferred-Optional expr).
                mut needs_wrap = true
                mut unknown = false
                match self.p.exprs[value_id] {
                    .NoneLit -> needs_wrap = false
                    else none
                }
                if self.is_ctor_for(value_id, kind: inner) == false and needs_wrap {
                    let actual = self.infer_kind(value_id)
                    match actual {
                        .KOptional(_inner2) -> needs_wrap = self.nests_into(actual, slot: kind)
                        .KUnknown -> {
                            needs_wrap = false
                            unknown = true
                        }
                        else none
                    }
                }
                if needs_wrap == false {
                    let wrapped_val = self.compile_expr(value_id)
                    if unknown {
                        self.report_cannot_infer(value_id, what: "this expression", typed_slot: true)
                    }
                    let val_reg = self.load(wrapped_val)
                    self.emit_str(dest_off, reg: val_reg)
                    self.pool.free_reg(val_reg)
                } else {
                    let val_reg = self.compile_value_for_kind(value_id, expected: inner)
                    let val_spilled = self.preserve_begin(val_reg)
                    self.emit("mov x0, #8")
                    self.emit("bl _arena_alloc")
                    let ptr_reg = self.pool.alloc_reg()
                    self.emit(f"mov {ptr_reg}, x0")
                    self.emit_str(dest_off, reg: ptr_reg)
                    let tmp = self.preserve_end(val_reg, spilled: val_spilled)
                    self.emit(f"str {tmp}, [{ptr_reg}]")
                    self.pool.free_reg(tmp)
                    self.pool.free_reg(ptr_reg)
                }
            }
            else {
                let val = self.compile_expr(value_id)
                mut reg = self.load(val)
                self.emit_str(dest_off, :reg)
                self.pool.free_reg(reg)
            }
        }
    }

    // `Point(10, 20)`: offer each value the next field that no label names.
    func report_unlabelled_field(self, anon field_args: [ast.CallArg], struct_idx: int64, argn: int64, nth: int64, span: ast.Span) -> none {
        mut free = 0
        mut hint = ""
        for f in self.structs[struct_idx].fields {
            mut named = false
            for a in field_args {
                if a.label == f.name {
                    named = true
                }
            }
            if named == false {
                if free == nth {
                    hint = f" (`{f.name}:`)"
                }
                free += 1
            }
        }
        self.report_error(f"error: argument {argn} of `{self.struct_display_name(struct_idx)}` needs a field label{hint}", :span)
    }

    // Allocate a struct value on the arena and return its pointer in x0.
    // field_args supplies the labelled field values.
    func compile_struct_construct(self, anon field_args: [ast.CallArg], struct_idx: int64, span: ast.Span) -> Val {
        let params = self.structs[struct_idx].type_param_names
        if len(params) > 0 {
            let name = self.structs[struct_idx].name
            mut spelled = ""
            for param in params {
                if len(spelled) > 0 {
                    spelled = spelled + ", "
                }
                spelled = spelled + param
            }
            self.report_error(f"error: generic struct `{name}` needs type arguments: write `{name}[{spelled}](...)`", :span)
        }
        let data_width = self.structs[struct_idx].data_width
        self.emit_load_imm("x0", value: data_width)
        self.emit("bl _arena_alloc")
        let ptr_r = self.pool.alloc_reg()
        self.emit(f"mov {ptr_r}, x0")
        mut provided: [str] = []
        mut argn = 0
        mut unlabelled = 0
        for arg in field_args {
            argn += 1
            if arg.label == "" {
                self.report_unlabelled_field(field_args, :struct_idx, :argn, nth: unlabelled, span: arg.label_span)
                unlabelled += 1
                let spilled = self.spill_across(ptr_r)
                self.compile_discard(arg.value)
                self.restore_across(ptr_r, :spilled)
                continue
            }
            if self.check_field(arg.label, :struct_idx, span: arg.label_span) and regalloc.str_in(provided, p: arg.label) {
                self.report_error(f"error: field `{arg.label}` is given twice", span: arg.label_span)
            }
            provided += [arg.label]
            mut foff = self.find_field_offset(arg.label, :struct_idx)
            mut field_kind = self.find_field_kind(arg.label, :struct_idx)
            // Stash ptr_r across the call so it survives any bl in the
            // field expression (constructor calls, arena_alloc for
            // wrapping an optional, etc).
            let ptr_spilled = self.spill_across(ptr_r)
            let field_reg = self.compile_into(arg.value, expected: field_kind)
            self.restore_across(ptr_r, spilled: ptr_spilled)
            self.emit(f"str {field_reg}, [{ptr_r}, #{foff}]")
            self.pool.free_reg(field_reg)
        }
        // Completeness check, in the *consuming* module's context so
        // report_error's source line points at the construction site:
        // every field that has no default must be supplied, else the
        // field would read arena garbage.
        mut ci = 0
        for ci < len(self.structs[struct_idx].fields) {
            let cf = self.structs[struct_idx].fields[ci]
            if cf.default_expr == 0 {
                mut cf_provided = false
                for pname in provided {
                    if pname == cf.name {
                        cf_provided = true
                    }
                }
                if cf_provided == false and unlabelled == 0 {
                    self.report_error(f"error: struct `{self.struct_display_name(struct_idx)}` requires field `{cf.name}` (it has no default)", :span)
                }
            }
            ci = ci + 1
        }
        // Fill any omitted field that *does* have a default. Defaults
        // live in the struct's defining module (src_p) and, for a
        // monomorphised instance, resolve under the template's
        // type-parameter substitution — swap both in, then restore.
        let saved_p = self.p
        let saved_names = self.subst_names
        let saved_args = self.subst_args
        self.p = self.structs[struct_idx].src_p
        if self.structs[struct_idx].template_idx >= 0 {
            self.subst_names = self.structs[self.structs[struct_idx].template_idx].type_param_names
            self.subst_args = self.structs[struct_idx].template_args
        }
        mut fi = 0
        for fi < len(self.structs[struct_idx].fields) {
            let field = self.structs[struct_idx].fields[fi]
            if field.default_expr != 0 {
                mut was_provided = false
                for pname in provided {
                    if pname == field.name {
                        was_provided = true
                    }
                }
                if was_provided == false {
                    let dptr_spilled = self.spill_across(ptr_r)
                    let dreg = self.compile_default(field.default_expr, expected: field.kind, src_p: self.structs[struct_idx].src_p)
                    self.restore_across(ptr_r, spilled: dptr_spilled)
                    self.emit(f"str {dreg}, [{ptr_r}, #{field.offset}]")
                    self.pool.free_reg(dreg)
                }
            }
            fi = fi + 1
        }
        self.p = saved_p
        self.subst_names = saved_names
        self.subst_args = saved_args
        self.emit(f"mov x0, {ptr_r}")
        self.pool.free_reg(ptr_r)
        return .VReg(name: "x0")
    }

    // Allocate an enum value on the arena and return its pointer in x0.
    // field_args supplies payload values (empty for unit variants).
    func compile_enum_construct(self, anon field_args: [ast.CallArg], enum_idx: int64, variant_idx: int64, span: ast.Span) -> Val {
        self.check_payload_args(field_args, :enum_idx, :variant_idx, :span)
        let data_width = self.enums[enum_idx].data_width
        mut disc = self.enums[enum_idx].variants[variant_idx].discriminant
        self.emit_load_imm("x0", value: data_width)
        self.emit("bl _arena_alloc")
        let ptr_r = self.pool.alloc_reg()
        self.emit(f"mov {ptr_r}, x0")
        let disc_r = self.pool.alloc_reg()
        self.emit_load_imm(disc_r, value: disc)
        self.emit(f"str {disc_r}, [{ptr_r}]")
        self.pool.free_reg(disc_r)
        if len(field_args) > 0 {
            let vinfo = self.enums[enum_idx].variants[variant_idx]
            mut i = 0
            for i < len(field_args) and i < len(vinfo.field_offsets) {
                mut foff = vinfo.field_offsets[i]
                mut field_kind: TypeKind = .KInt64
                if i < len(vinfo.field_kinds) {
                    field_kind = vinfo.field_kinds[i]
                }
                // Stash ptr_r across the call so it survives any bl in the
                // field expression (constructor calls, optional wrap, etc).
                let eptr_spilled = self.spill_across(ptr_r)
                let field_reg = self.compile_into(field_args[i].value, expected: field_kind)
                self.restore_across(ptr_r, spilled: eptr_spilled)
                self.emit(f"str {field_reg}, [{ptr_r}, #{8 + foff}]")
                self.pool.free_reg(field_reg)
                i = i + 1
            }
        }
        self.emit(f"mov x0, {ptr_r}")
        self.pool.free_reg(ptr_r)
        return .VReg(name: "x0")
    }

    // E in `E.V` may be the expected enum's template.
    func ctor_variant_idx(self, anon value_id: int64, enum_idx: int64) -> int64 {
        mut callee = value_id
        if self.p.exprs[value_id] is .Call(call_callee, _args) {
            callee = call_callee
        }
        match self.p.exprs[callee] {
            .ImplicitVariant(name) -> return self.find_variant_idx(name, :enum_idx)
            .Binary(lhs, op, rhs) -> {
                if op is .Dot {
                    if self.p.exprs[rhs] is .Ident(name) {
                        let named = self.ctor_qualifier_enum(lhs)
                        if named >= 0 {
                            if self.enums_compatible(enum_idx, a_idx: named) {
                                return self.find_variant_idx(name, :enum_idx)
                            }
                        }
                    }
                }
            }
            else none
        }
        return -1
    }

    func ctor_qualifier_enum(self, anon expr_id: int64) -> int64 {
        match self.p.exprs[expr_id] {
            .Ident(name) -> {
                if self.var_bound(name) {
                    return -1
                }
                return self.find_enum_idx(name)
            }
            .Binary(lhs, op, rhs) -> {
                if op is .Dot {
                    if self.p.exprs[lhs] is .Ident(mod_name) {
                        if self.is_import_alias(mod_name) {
                            if self.p.exprs[rhs] is .Ident(name) {
                                return self.find_enum_idx(name)
                            }
                        }
                    }
                }
            }
            else none
        }
        return -1
    }

    // `.Ok` in a `Status or Error` slot is Status's own `Ok` when only its payload fits.
    func ok_enum_takes(self, anon value_id: int64, result_idx: int64, variant_idx: int64) -> bool {
        if self.is_result_enum_idx(result_idx) == false {
            return false
        }
        let .KEnum(ok_idx) = self.result_inner_kind(.KEnum(idx: result_idx)) else { return false }
        let own = self.ctor_variant_idx(value_id, enum_idx: ok_idx)
        if own < 0 or self.payload_fits(value_id, enum_idx: ok_idx, variant_idx: own) == false {
            return false
        }
        if self.payload_fits(value_id, enum_idx: result_idx, :variant_idx) == false {
            return true
        }
        let args = self.ctor_args(value_id)
        if len(args) != 1 {
            return false
        }
        // Both take it, so its type decides.
        let arg = args[0].value
        return self.arg_fits_kind(arg, kind: self.enums[ok_idx].variants[own].field_kinds[0]) and self.arg_fits_kind(arg, kind: self.enums[result_idx].variants[variant_idx].field_kinds[0]) == false
    }

    func arg_fits_kind(self, anon arg_id: int64, kind: TypeKind) -> bool {
        if self.is_ctor_for(arg_id, :kind) {
            return true
        }
        let actual = self.infer_kind(arg_id)
        if actual is .KUnknown {
            return false
        }
        return self.kinds_compatible(kind, :actual)
    }

    func payload_fits(self, anon value_id: int64, enum_idx: int64, variant_idx: int64) -> bool {
        return self.args_fit(self.ctor_args(value_id), :enum_idx, :variant_idx)
    }

    func args_fit(self, anon args: [ast.CallArg], enum_idx: int64, variant_idx: int64) -> bool {
        let names = self.enums[enum_idx].variants[variant_idx].field_names
        if len(args) != len(names) {
            return false
        }
        mut i = 0
        for arg in args {
            if len(arg.label) > 0 and arg.label != names[i] {
                return false
            }
            i += 1
        }
        return true
    }

    func ctor_args(self, anon value_id: int64) -> [ast.CallArg] {
        if self.p.exprs[value_id] is .Call(_callee, args) {
            return args
        }
        let none_args: [ast.CallArg] = []
        return none_args
    }

    func is_ctor_for(self, anon value_id: int64, kind: TypeKind) -> bool {
        match kind {
            .KEnum(idx) -> {
                let vi = self.ctor_variant_idx(value_id, enum_idx: idx)
                return vi >= 0 and self.ok_enum_takes(value_id, result_idx: idx, variant_idx: vi) == false
            }
            .KOptional(inner) -> return self.is_ctor_for(value_id, kind: inner)
            else return false
        }
    }

    func emit_enum_alloc(self, enum_idx: int64, value_id: int64, dest_off: int64) -> none {
        // Detect direct enum construction patterns and route through
        // compile_enum_construct; otherwise compile the expression and store
        // its (pointer) result.
        let variant_idx = self.ctor_variant_idx(value_id, :enum_idx)
        if variant_idx >= 0 {
            let val = self.compile_enum_construct(self.ctor_args(value_id), :enum_idx, :variant_idx, span: self.p.expr_spans[value_id])
            self.emit_str(dest_off, reg: "x0")
        } else {
            let val = self.compile_expr(value_id)
            mut reg = self.load(val)
            self.emit_str(dest_off, :reg)
            self.pool.free_reg(reg)
        }
    }

    // Compile `<lhs>.<field> = <rhs>` for any lhs expression that yields a
    // struct pointer.
    func compile_field_assign(self, lhs: int64, rhs: int64, rhs_id: int64) -> none {
        let .Ident(field_name) = self.p.exprs[rhs] else { return }
        mut foff = 0
        mut field_kind: TypeKind = .KInt64
        mut lhs_is_struct = false
        let lhs_kind: TypeKind = self.infer_kind(lhs)
        if lhs_kind is .KUnknown {
            self.compile_discard(rhs_id)
            self.compile_discard(lhs)
            self.report_cannot_infer(lhs, what: "this expression")
            return
        }
        if lhs_kind is .KStruct(struct_idx, _struct_type_args) {
            lhs_is_struct = true
            if self.check_field(field_name, :struct_idx, span: self.p.expr_spans[rhs]) {
                foff = self.find_field_offset(field_name, :struct_idx)
                field_kind = self.find_field_kind(field_name, :struct_idx)
            }
        }
        let recv_first = self.commutes(lhs, rhs_id) == false
        mut ptr_reg = ""
        mut ptr_spilled = false
        if recv_first {
            ptr_reg = self.compile_field_base(lhs, :field_name, :rhs, :lhs_kind, :lhs_is_struct)
            ptr_spilled = self.preserve_begin(ptr_reg)
        }
        // Kind-aware, so an int assigned to an optional field gets wrapped.
        let rhs_reg = self.compile_value_for_kind(rhs_id, expected: field_kind)
        let rhs_spilled = self.preserve_begin(rhs_reg)
        if recv_first == false {
            ptr_reg = self.compile_field_base(lhs, :field_name, :rhs, :lhs_kind, :lhs_is_struct)
        }
        if lhs_is_struct {
            self.check_value_kind(rhs_id, expected: field_kind)
        }
        let tmp_reg = self.preserve_end(rhs_reg, spilled: rhs_spilled)
        if recv_first {
            ptr_reg = self.preserve_end(ptr_reg, spilled: ptr_spilled)
        }
        self.emit(f"str {tmp_reg}, [{ptr_reg}, #{foff}]")
        self.pool.free_reg(tmp_reg)
        self.pool.free_reg(ptr_reg)
    }

    func compile_field_base(self, anon lhs: int64, field_name: str, rhs: int64, lhs_kind: TypeKind, lhs_is_struct: bool) -> str {
        let attempts_before = self.report_attempts
        let ptr_val = self.compile_expr(lhs)
        if self.report_attempts == attempts_before and lhs_is_struct == false {
            mut opt_name = "x"
            if self.p.exprs[lhs] is .Ident(lhs_name) {
                opt_name = lhs_name
            }
            let hint = f"; unwrap it first, as in `if {opt_name} is Some(v) " + "{" + f" v.{field_name} = ... " + "}`"
            self.report_field_on_non_struct(field_name, kind: lhs_kind, span: self.p.expr_spans[rhs], optional_hint: hint)
        }
        return self.load(ptr_val)
    }

    // Built from literals and variables only, so nothing computed around it can change it.
    func is_stable(self, anon expr_id: int64) -> bool {
        if self.emits_nothing(expr_id) {
            return true
        }
        match self.p.exprs[expr_id] {
            .BoolLit(_value) -> return true
            .NoneLit -> return true
            .ImplicitVariant(_name) -> return true
            .Binary(lhs, op, rhs) -> {
                match op {
                    .Dot -> return false
                    .Index -> return false
                    else return self.is_stable(lhs) and self.is_stable(rhs)
                }
            }
            else return false
        }
    }

    // Computing it calls nothing, so it has no effect but a possible panic.
    func is_pure(self, anon expr_id: int64) -> bool {
        if self.is_stable(expr_id) {
            return true
        }
        match self.p.exprs[expr_id] {
            .Ident(_name) -> return true
            .Binary(lhs, op, rhs) -> {
                match op {
                    .Dot -> return self.is_pure(lhs)
                    .Index -> return self.indexes_builtin(lhs) and self.is_pure(lhs) and self.is_pure(rhs)
                    else return self.is_pure(lhs) and self.is_pure(rhs)
                }
            }
            else return false
        }
    }

    // Any other struct's `op_index` is user code.
    func indexes_builtin(self, anon recv: int64) -> bool {
        let kind = self.infer_kind(recv)
        if self.is_array_kind(kind) or self.is_str_or_bytes(kind) {
            return true
        }
        if kind is .KStruct(idx, _type_args) {
            let template_idx = self.structs[idx].template_idx
            return template_idx >= 0 and len(self.hashed_arg_noun(template_idx)) > 0
        }
        return false
    }

    // Whether computing `a` and `b` in either order gives the same results.
    func commutes(self, anon a: int64, anon b: int64) -> bool {
        return self.is_stable(a) or self.is_stable(b) or (self.is_pure(a) and self.is_pure(b))
    }

    func struct_method_sig(self, anon struct_idx: int64, name: str) -> SigInfo {
        mut mi = 0
        if self.structs[struct_idx].method_idx.get(name) is Some(found) {
            mi = found
        }
        return self.structs[struct_idx].methods[mi].sig
    }

    func takes_self_and(self, anon sig: SigInfo, count: int64) -> bool {
        if len(sig.param_kinds) != count + 1 {
            return false
        }
        return sig.param_names[0] == "self"
    }

    // A key that needs no conversion keeps the plain lowering.
    func compile_key(self, anon key_id: int64, kind: TypeKind) -> str {
        if self.converts_for(key_id, :kind) {
            let converted = self.compile_into(key_id, expected: kind)
            let converted_reg = self.pool.alloc_reg()
            self.mov_to(.VReg(name: converted), dest: converted_reg)
            return converted_reg
        }
        let key_val = self.compile_expr(key_id)
        let key_reg = self.pool.alloc_reg()
        self.mov_to(key_val, dest: key_reg)
        self.check_value_kind(key_id, expected: kind)
        return key_reg
    }

    // Look up `op_index_set` on a struct, returning its mangled label.
    func struct_index_setter_label(self, struct_idx: int64) -> str? {
        if self.structs[struct_idx].method_idx.get("op_index_set") is Some(_mi) {
            return f"${self.structs[struct_idx].module_prefix}${self.structs[struct_idx].name}$op_index_set"
        }
        return none
    }

    // Compile `<arr>[<key>] = <rhs>`. `arr` can be any expression that
    // yields either a plain array header pointer (foo, self.slots,
    // obj.list[0].rows, …) or a struct value whose type defines
    // `op_index_set` (Map, Set, …). The op_index_set dispatch needs the
    // lhs's inferred struct kind; the plain-array path doesn't care.
    func compile_index_assign(self, lhs: int64, rhs: int64, rhs_id: int64) -> none {
        if self.infer_kind(lhs) is .KUnknown {
            self.compile_discard(lhs)
            self.report_cannot_infer(lhs, what: "this expression")
            self.compile_discard(rhs)
            self.compile_discard(rhs_id)
            return
        }
        let lhs_kind = self.infer_kind(lhs)
        mut setter: str? = none
        mut setter_struct = -1
        if lhs_kind is .KStruct(struct_idx, _struct_type_args) {
            setter = self.struct_index_setter_label(:struct_idx)
            setter_struct = struct_idx
        }
        if setter is none {
            if self.is_array_kind(lhs_kind) == false {
                let shown = self.kind_display(lhs_kind)
                mut note = self.index_error_note(lhs_kind, method: "op_index_set", value_id: lhs)
                if self.is_str_or_bytes(lhs_kind) {
                    note = f"; `{shown}` values are immutable"
                }
                self.compile_discard(lhs)
                self.compile_discard(rhs)
                self.compile_discard(rhs_id)
                if self.kind_has_unknown(lhs_kind) == false {
                    self.report_error(f"error: cannot assign to an element of a value of type `{shown}`{note}", span: self.p.expr_spans[lhs])
                }
                return
            }
        }
        match setter {
            Some(method_lbl) -> {
                let sig = self.struct_method_sig(setter_struct, name: "op_index_set")
                if self.takes_self_and(sig, count: 2) == false {
                    self.compile_discard(lhs)
                    self.compile_discard(rhs)
                    self.compile_discard(rhs_id)
                    self.report_error(f"error: `{self.struct_display_name(setter_struct)}.op_index_set` must take a key and a value", span: self.p.expr_spans[lhs])
                    return
                }
                let value_kind = sig.param_kinds[2]
                let recv_late = self.commutes(lhs, rhs) and self.commutes(lhs, rhs_id)
                if recv_late == false or self.commutes(rhs, rhs_id) == false {
                    self.compile_ordered_index_set(lhs, key: rhs, value: rhs_id, :sig, :method_lbl, :recv_late)
                    return
                }
                // No order can be told apart here, so the value goes first.
                let rhs_r = self.pool.alloc_reg()
                if self.converts_for(rhs_id, kind: value_kind) {
                    let converted = self.compile_value_for_kind(rhs_id, expected: value_kind)
                    self.mov_to(.VReg(name: converted), dest: rhs_r)
                } else {
                    let rhs_v = self.compile_expr(rhs_id)
                    self.mov_to(rhs_v, dest: rhs_r)
                }
                if self.is_match_expr(rhs_id) == false {
                    self.check_value_kind(rhs_id, expected: value_kind)
                }
                let rhs_spilled = self.preserve_begin(rhs_r)
                let key_reg = self.compile_key(rhs, kind: sig.param_kinds[1])
                let key_spilled = self.preserve_begin(key_reg)
                let lhs_val = self.compile_expr(lhs)
                self.mov_to(lhs_val, dest: "x0")
                let key_r = self.preserve_end(key_reg, spilled: key_spilled)
                self.emit(f"mov x1, {key_r}")
                self.pool.free_reg(key_r)
                // rhs is the third arg (x2). If it was spilled, reload from
                // the slot; if it rode through a callee-saved register, just
                // move it across.
                if rhs_spilled {
                    self.emit("ldr x2, [sp]")
                    self.emit("add sp, sp, #16")
                } else {
                    self.emit(f"mov x2, {rhs_r}")
                    self.pool.free_reg(rhs_r)
                }
                self.emit(f"bl {method_lbl}")
            }
            none -> {
                let recv_late = self.commutes(lhs, rhs) and self.commutes(lhs, rhs_id)
                mut early_r = ""
                mut early_spilled = false
                if recv_late == false {
                    early_r = self.pool.alloc_reg()
                    self.mov_to(self.compile_expr(lhs), dest: early_r)
                    early_spilled = self.preserve_begin(early_r)
                }
                let idx_v = self.compile_expr(rhs)
                self.check_int_operand(rhs, what: "an index")
                let idx_r = self.load(idx_v)
                // Preserve the index across the RHS *and* the lhs pointer
                // computation. If either includes a `bl` (e.g. a struct
                // constructor calling _arena_alloc) it would clobber a
                // caller-saved idx_r; preserve_begin stashes it then (and
                // keeps it in a callee-saved register for free otherwise).
                let idx_spilled = self.preserve_begin(idx_r)
                // Wrap/box the rhs to match the array's element kind, so
                // `xs[i] = 42` on a `[int64?]` stores a Some-cell and
                // `pets[i] = Cat()` on a `[Greet]` stores an iface cell —
                // mirroring the struct-field and call-arg store paths.
                let rhs_r = self.compile_into(rhs_id, expected: self.array_elem_kind(lhs_kind))
                // Preserve rhs across the lhs computation too.
                let rhs_spilled = self.preserve_begin(rhs_r)
                mut buf_r = ""
                mut len_r = ""
                if recv_late {
                    let arr_val = self.compile_expr(lhs)
                    let arr_ptr_r = self.pool.alloc_reg()
                    self.mov_to(arr_val, dest: arr_ptr_r)
                    buf_r = self.array_buf_len(arr_ptr_r, len_out: false)
                    len_r = self.array_buf_len(arr_ptr_r, len_out: true)
                    self.pool.free_reg(arr_ptr_r)
                }
                let reloaded_rhs_r = self.preserve_end(rhs_r, spilled: rhs_spilled)
                let reloaded_idx_r = self.preserve_end(idx_r, spilled: idx_spilled)
                if recv_late == false {
                    let arr_ptr_r = self.preserve_end(early_r, spilled: early_spilled)
                    buf_r = self.array_buf_len(arr_ptr_r, len_out: false)
                    len_r = self.array_buf_len(arr_ptr_r, len_out: true)
                    self.pool.free_reg(arr_ptr_r)
                }
                // Normalise negative index: if idx < 0, idx += len.
                // Then bounds-check via unsigned compare. Mirrors the
                // read path in compile_index — without the check a
                // `buf[oob_idx] = ...` silently wrote into whatever
                // memory followed the array's buf.
                let pos_lbl = self.fresh("Lidx_pos")
                self.emit(f"cmp {reloaded_idx_r}, #0")
                self.emit(f"bge {pos_lbl}")
                self.emit(f"add {reloaded_idx_r}, {reloaded_idx_r}, {len_r}")
                self.emit_label(pos_lbl)
                let ok_lbl = self.fresh("Lidx_ok")
                let oob_lbl = self.fresh("Lidx_oob")
                self.emit(f"cmp {reloaded_idx_r}, {len_r}")
                self.emit(f"b.hs {oob_lbl}")
                self.emit(f"b {ok_lbl}")
                self.emit_label(oob_lbl)
                self.emit(f"mov x0, {reloaded_idx_r}")
                self.emit(f"mov x1, {len_r}")
                self.emit("bl _kod_index_oob")
                self.emit_label(ok_lbl)
                self.pool.free_reg(len_r)
                self.emit(f"lsl {reloaded_idx_r}, {reloaded_idx_r}, #3")
                self.emit(f"str {reloaded_rhs_r}, [{buf_r}, {reloaded_idx_r}]")
                self.pool.free_reg(buf_r)
                self.pool.free_reg(reloaded_idx_r)
                self.pool.free_reg(reloaded_rhs_r)
            }
        }
    }

    func array_buf_len(self, anon arr_ptr_r: str, len_out: bool) -> str {
        let r = self.pool.alloc_reg()
        if len_out {
            self.emit(f"ldr {r}, [{arr_ptr_r}, #8]")
        } else {
            self.emit(f"ldr {r}, [{arr_ptr_r}]")
        }
        return r
    }

    // `op_index_set` with the receiver (unless `recv_late`), the key and the value in that order.
    func compile_ordered_index_set(self, anon lhs: int64, key: int64, value: int64, sig: SigInfo, method_lbl: str, recv_late: bool) -> none {
        mut recv_r = ""
        mut recv_spilled = false
        if recv_late == false {
            recv_r = self.pool.alloc_reg()
            self.mov_to(self.compile_expr(lhs), dest: recv_r)
            recv_spilled = self.preserve_begin(recv_r)
        }
        let key_reg = self.compile_key(key, kind: sig.param_kinds[1])
        let key_spilled = self.preserve_begin(key_reg)
        let value_kind = sig.param_kinds[2]
        let rhs_r = self.pool.alloc_reg()
        if self.converts_for(value, kind: value_kind) {
            let converted = self.compile_value_for_kind(value, expected: value_kind)
            self.mov_to(.VReg(name: converted), dest: rhs_r)
        } else {
            self.mov_to(self.compile_expr(value), dest: rhs_r)
        }
        if self.is_match_expr(value) == false {
            self.check_value_kind(value, expected: value_kind)
        }
        let key_r = self.preserve_end(key_reg, spilled: key_spilled)
        if recv_late {
            recv_r = self.pool.alloc_reg()
            self.mov_to(self.compile_expr(lhs), dest: recv_r)
        } else {
            recv_r = self.preserve_end(recv_r, spilled: recv_spilled)
        }
        self.emit(f"mov x0, {recv_r}")
        self.emit(f"mov x1, {key_r}")
        self.emit(f"mov x2, {rhs_r}")
        self.pool.free_reg(recv_r)
        self.pool.free_reg(key_r)
        self.pool.free_reg(rhs_r)
        self.emit(f"bl {method_lbl}")
    }

    // `f().x += 1` reads and stores through one receiver and one index.
    func stash_store_target(self, anon lhs_id: int64, value: int64) -> int64 {
        let .Binary(recv, op, rhs) = self.p.exprs[lhs_id] else { return lhs_id }
        mut index = false
        match op {
            .Dot -> index = false
            .Index -> index = true
            else return lhs_id
        }
        if self.is_pure(recv) and (index == false or self.is_pure(rhs)) and self.is_pure(value) {
            return lhs_id
        }
        if self.kind_has_unknown(self.infer_kind(recv)) or (index and self.kind_has_unknown(self.infer_kind(rhs))) {
            return lhs_id
        }
        mut new_recv = recv
        mut new_rhs = rhs
        if self.is_stable(recv) == false {
            new_recv = self.stash_chain_operand(recv)
        }
        if index and self.is_stable(rhs) == false {
            new_rhs = self.stash_chain_operand(rhs)
        }
        if new_recv == recv and new_rhs == rhs {
            return lhs_id
        }
        return self.p.alloc_expr(ast.Expr.Binary(lhs: new_recv, :op, rhs: new_rhs), span: self.p.expr_spans[lhs_id])
    }

    func compile_assign(self, lhs_id: int64, rhs_id: int64) -> none {
        match self.p.exprs[lhs_id] {
            .Ident(name) -> {
                if self.var_declared(name) == false {
                    mut cands: [str] = []
                    for v in self.vars {
                        cands += [v.name]
                    }
                    let msg: str = self.with_suggestion(f"error: unknown name `{name}`; declare it with `mut {name} = ...`", typo: name, candidates: cands)
                    self.report_error(msg, span: self.p.expr_spans[lhs_id])
                    return none
                }
                if self.var_bound(name) == false {
                    self.report_error(self.unbound_msg(name, verb: "assigned"), span: self.p.expr_spans[lhs_id])
                    return none
                }
                if self.enforce_immutability() and self.find_var_mutable(name) == false {
                    self.report_error("cannot reassign immutable binding `" + name + "`; declare it with `mut`", span: self.p.expr_spans[lhs_id])
                    return none
                }
                let off = self.find_var_offset(name)
                mut kind = self.find_var_kind(name)
                self.compile_store(dest_off: off, :kind, value_id: rhs_id)
                self.check_value_kind(rhs_id, expected: kind)
            }
            .Binary(lhs2, op, rhs2) -> {
                match op {
                    .Dot -> self.compile_field_assign(lhs: lhs2, rhs: rhs2, :rhs_id)
                    .Index -> self.compile_index_assign(lhs: lhs2, rhs: rhs2, :rhs_id)
                    else self.report_error("error: cannot assign to this expression", span: self.p.expr_spans[lhs_id])
                }
            }
            else self.report_error("error: cannot assign to this expression", span: self.p.expr_spans[lhs_id])
        }
    }

    func find_field_kind(self, anon field_name: str, struct_idx: int64) -> TypeKind {
        mut field_idx = 0
        for field_idx < len(self.structs[struct_idx].fields) {
            if self.structs[struct_idx].fields[field_idx].name == field_name {
                return self.structs[struct_idx].fields[field_idx].kind
            }
            field_idx = field_idx + 1
        }
        return .KUnknown
    }

    // Desugar `lhs += rhs` to `lhs = lhs + rhs` and dispatch through the
    // regular assign / Binary(.Add) machinery. That picks up every
    // lhs shape compile_assign supports (Ident, nested field, indexed)
    // and every type-specific .Add lowering compile_expr supports
    // (int add, str concat, array concat) without duplicating the
    // case-by-case wiring. A receiver or index with effects is computed
    // once beforehand, so the load and the store share it.
    func compile_plus_assign(self, lhs_id: int64, rhs_id: int64) -> none {
        let target = self.stash_store_target(lhs_id, value: rhs_id)
        let span = self.p.expr_spans[target]
        let sum_id = self.p.alloc_expr(ast.Expr.Binary(lhs: target, op: .Add, rhs: rhs_id), :span)
        let saved_append = self.append_lhs_id
        let saved_append_path = self.append_lhs_path
        self.append_lhs_id = target
        self.append_lhs_path = self.p.path
        self.compile_assign(lhs_id: target, rhs_id: sum_id)
        self.append_lhs_id = saved_append
        self.append_lhs_path = saved_append_path
    }

    // `lhs -= rhs` desugars to `lhs = lhs - rhs`. Same shape as
    // compile_plus_assign; `-` is int-only (no str/array form), so a
    // bad operand type surfaces as a normal binary-op error.
    func compile_minus_assign(self, lhs_id: int64, rhs_id: int64) -> none {
        let target = self.stash_store_target(lhs_id, value: rhs_id)
        let span = self.p.expr_spans[target]
        let diff_id = self.p.alloc_expr(ast.Expr.Binary(lhs: target, op: .Sub, rhs: rhs_id), :span)
        self.compile_assign(lhs_id: target, rhs_id: diff_id)
    }

    func compile_return(self, anon value_id: int64) -> none {
        if value_id == 0 {
            self.emit_no_value_return()
            self.emit(f"b {self.ret_lbl}")
            return
        }
        if self.is_ctor_for(value_id, kind: self.return_kind) {
            let reg = self.compile_value_for_kind(value_id, expected: self.return_kind)
            self.mov_to(.VReg(name: reg), dest: "x0")
            self.emit(f"b {self.ret_lbl}")
            return
        }
        if self.p.exprs[value_id] is .MatchExpr(subject, arms) {
            let is_result = self.is_result_kind(self.return_kind)
            if is_result == false {
                self.check_optional_return(value_id)
            }
            let val = self.compile_match_expr_for(arms, subject_id: subject, expected: self.return_kind, ok_wrap: is_result)
            self.mov_to(val, dest: "x0")
            self.emit(f"b {self.ret_lbl}")
            return
        }
        // If returning into a Result and the value isn't already a Result,
        // wrap it as .Ok(value) — a 16-byte arena cell {0, value}.
        if self.is_result_kind(self.return_kind) {
            mut already = false
            let ok_kind = self.result_inner_kind(self.return_kind)
            let value_kind = self.infer_kind(value_id)
            if self.is_result_kind(value_kind) {
                already = true
            }
            if self.is_ctor_for(value_id, kind: ok_kind) or self.builds_array_for(value_id, kind: ok_kind) {
                self.compile_wrap_ok(value_id)
                self.check_return_value(value_id, expected: ok_kind)
            } else if value_kind is .KUnknown {
                let val = self.compile_expr(value_id)
                self.mov_to(val, dest: "x0")
                self.report_cannot_infer(value_id, what: "this expression", typed_slot: true)
            } else {
                if already == false {
                    self.check_optional_return(value_id)
                }
                if already {
                    let val = self.compile_expr(value_id)
                    self.mov_to(val, dest: "x0")
                    self.check_return_value(value_id, expected: self.return_kind)
                } else {
                    self.compile_wrap_ok(value_id)
                    self.check_return_value(value_id, expected: ok_kind)
                }
            }
            self.emit(f"b {self.ret_lbl}")
            return
        }
        self.check_optional_return(value_id)
        // If returning into an optional and the value isn't already as optional,
        // wrap it in an arena allocation. NoneLit is always Optional. For Call,
        // trust free-function returns (we don't track free-fn return kinds);
        // for method calls, infer_kind looks up the method's return type.
        mut needs_wrap = false
        match self.return_kind {
            .KOptional(inner) -> {
                mut assume_optional = false
                if self.p.exprs[value_id] is .NoneLit {
                    assume_optional = true
                }
                if assume_optional == false {
                    let actual = self.infer_kind(value_id)
                    match actual {
                        .KOptional(_inner2) -> needs_wrap = self.nests_into(actual, slot: self.return_kind)
                        .KUnknown -> {
                            let val = self.compile_expr(value_id)
                            self.mov_to(val, dest: "x0")
                            self.report_cannot_infer(value_id, what: "this expression", typed_slot: true)
                            self.emit(f"b {self.ret_lbl}")
                            return
                        }
                        else needs_wrap = true
                    }
                }
            }
            else none
        }
        if needs_wrap {
            let ret_inner = self.optional_inner(self.return_kind)
            mut reg = ""
            if self.converts_for(value_id, kind: ret_inner) {
                reg = self.compile_value_for_kind(value_id, expected: ret_inner)
            } else {
                let val = self.compile_expr(value_id)
                reg = self.load(val)
            }
            let reg_spilled = self.preserve_begin(reg)
            self.emit("mov x0, #8")
            self.emit("bl _arena_alloc")
            let tmp = self.preserve_end(reg, spilled: reg_spilled)
            self.emit(f"str {tmp}, [x0]")
            self.pool.free_reg(tmp)
        } else {
            // Returning a concrete struct from an interface-returning
            // function needs the {data, vtable} box; mov_to would
            // otherwise place the raw struct pointer in x0 and the
            // caller's next method dispatch would walk into garbage.
            mut convert = self.builds_array_for(value_id, kind: self.return_kind)
            if self.return_kind is .KInterface(_idx) {
                convert = true
            }
            if convert {
                let reg = self.compile_value_for_kind(value_id, expected: self.return_kind)
                self.emit(f"mov x0, {reg}")
                self.pool.free_reg(reg)
            } else {
                let val = self.compile_expr(value_id)
                self.mov_to(val, dest: "x0")
                self.report_if_unknown(value_id, typed_slot: true)
            }
        }
        self.check_return_value(value_id, expected: self.return_kind)
        self.emit(f"b {self.ret_lbl}")
    }

    // A call that never returns has no value to check.
    func check_return_value(self, anon value_id: int64, expected: TypeKind) -> none {
        if self.is_diverging_call(value_id) == false {
            self.check_diverge_ok(value_id, :expected)
        }
    }

    func check_diverge_ok(self, anon value_id: int64, expected: TypeKind) -> none {
        let saved = self.diverge_ok_id
        self.diverge_ok_id = value_id
        self.check_value_kind(value_id, :expected)
        self.diverge_ok_id = saved
    }

    // A `none or Error` function returns an Ok(none) cell, not the none sentinel.
    func emit_no_value_return(self) -> none {
        if self.is_result_kind(self.return_kind) == false or self.is_void_kind(self.result_inner_kind(self.return_kind)) == false {
            self.emit("mov x0, #0")
            return
        }
        self.emit("mov x0, #16")
        self.emit("bl _arena_alloc")
        let disc_r = self.pool.alloc_reg()
        self.emit_load_imm(disc_r, value: self.result_ok_disc())
        self.emit(f"str {disc_r}, [x0]")
        self.pool.free_reg(disc_r)
        self.emit("str xzr, [x0, #8]")
    }

    func optional_inner(self, anon kind: TypeKind) -> TypeKind {
        if kind is .KOptional(inner) {
            return inner
        }
        return .KVoid
    }

    // The caller would get the optional's cell instead of the value.
    func check_optional_return(self, anon value_id: int64) -> none {
        mut target = self.return_kind
        if self.is_result_kind(self.return_kind) {
            target = self.result_inner_kind(self.return_kind)
        }
        match target {
            .KOptional(_ret_inner) -> return
            .KVoid -> return
            else none
        }
        let value_kind = self.infer_kind(value_id)
        if self.either_unknown(target, value_kind) {
            return
        }
        if self.is_some_optional(value_kind) {
            self.report_error(f"error: expected `{self.kind_display(target)}`, got `{self.kind_display(value_kind)}`{self.unwrap_hint(value_id)}", span: self.p.expr_spans[value_id])
        }
    }

    // Compile `value_id` and wrap the result in a Result.Ok cell. Leaves
    // the cell pointer in x0. Used for implicit `return v` in Result-typed
    // functions and for the Ok arm of try/must.
    func compile_wrap_ok(self, anon value_id: int64) -> none {
        let ok_kind = self.result_inner_kind(self.return_kind)
        mut reg = self.pool.alloc_reg()
        if self.converts_for(value_id, kind: ok_kind) {
            let converted = self.compile_value_for_kind(value_id, expected: ok_kind)
            self.mov_to(.VReg(name: converted), dest: reg)
        } else {
            let val = self.compile_expr(value_id)
            self.mov_to(val, dest: reg)
        }
        let reg_spilled = self.preserve_begin(reg)
        self.emit("mov x0, #16")
        self.emit("bl _arena_alloc")
        let payload = self.preserve_end(reg, spilled: reg_spilled)
        let disc_r = self.pool.alloc_reg()
        self.emit_load_imm(disc_r, value: self.result_ok_disc())
        self.emit(f"str {disc_r}, [x0]")
        self.pool.free_reg(disc_r)
        self.emit(f"str {payload}, [x0, #8]")   // payload
        self.pool.free_reg(payload)
    }

    // `throw expr` — box `expr` as an Error (fat pointer with vtable) and
    // return a Result.Err cell {1, error_ptr} from the enclosing function.
    // Compute `path:line:col` for an error message from a byte offset
    // into self.p.source.
    func format_position(self, anon offset: int64) -> str {
        let source = self.p.source
        mut line = 1
        mut col = 1
        mut i = 0
        for i < offset and i < len(source) {
            if source[i] == '\n' {
                line = line + 1
                col = 1
            } else {
                col = col + 1
            }
            i = i + 1
        }
        return f"{self.p.path}:{line}:{col}"
    }

    // `assert <expr>` — runtime check. When the expression evaluates to
    // false, emit a call carrying a message that pins down both the source
    // location and the original expression text (captured by the parser).
    // Inside a `test "..." {}` block: `_kod_test_fail` (flag the test and
    // keep going, so multiple asserts surface in one run). Outside: a
    // straight `_kod_panic` (print + exit 1). Same syntax, intent matches
    // the surrounding context.
    func compile_assert(self, anon expr_id: int64, source_text: str, span: ast.Span) -> none {
        let val = self.compile_expr(expr_id)
        self.check_bool(expr_id, need: "`assert` needs a `bool`", optional_hint: "; test it with `is not none`")
        mut reg = self.load(val)
        let ok_lbl = self.fresh("Lassert_ok")
        self.emit(f"cbnz {reg}, {ok_lbl}")
        self.pool.free_reg(reg)
        let pos = self.format_position(span.start)
        let msg = f"{pos}: assertion failed: {source_text}"
        let msg_lbl = self.intern_str(msg)
        self.emit(f"adrp x0, {msg_lbl}@PAGE")
        self.emit(f"add x0, x0, {msg_lbl}@PAGEOFF")
        if self.in_test {
            self.emit("bl _kod_test_fail")
        } else {
            self.emit("bl _kod_panic")
        }
        self.emit_label(ok_lbl)
    }

    func compile_throw(self, anon value_id: int64) -> none {
        let iface_idx = self.find_iface_idx("Error")
        let actual = self.infer_kind(value_id)
        let val = self.compile_expr(value_id)
        mut reg = self.pool.alloc_reg()
        self.mov_to(val, dest: reg)
        // Box into the Error interface if the source is a concrete struct.
        if iface_idx >= 0 {
            reg = self.maybe_box_for_iface(reg, :actual, expected: .KInterface(idx: iface_idx), span: self.p.expr_spans[value_id])
            self.check_value_kind(value_id, expected: .KInterface(idx: iface_idx))
        }
        // Build the Result.Err cell.
        let reg_spilled = self.preserve_begin(reg)
        self.emit("mov x0, #16")
        self.emit("bl _arena_alloc")
        let payload = self.preserve_end(reg, spilled: reg_spilled)
        self.emit(f"mov x9, #{self.result_err_disc()}")
        self.emit("str x9, [x0]")
        self.emit(f"str {payload}, [x0, #8]")   // error iface ptr
        self.pool.free_reg(payload)
        self.emit(f"b {self.ret_lbl}")
    }

    // `try expr` / `must expr` — evaluate `expr` (yielding a Result cell
    // pointer in x0), then branch on the discriminant. The Ok arm yields
    // the unwrapped inner value as this expression's value. The Err arm
    // either returns the same cell from the enclosing function (try) or
    // calls _kod_panic_error and aborts (must).
    func compile_try_or_must(self, anon inner_id: int64, is_must: bool) -> Val {
        let inner_kind = self.infer_kind(inner_id)
        if self.is_fallible_kind(inner_kind) == false {
            self.compile_discard(inner_id)
            if inner_kind is .KUnknown {
                self.report_cannot_infer(inner_id, what: "this expression")
            } else {
                if self.kind_has_unknown(inner_kind) == false {
                    self.report_error(f"error: `{self.try_word(is_must)}` needs a `T or Error` value, got `{self.kind_display(inner_kind)}`", span: self.p.expr_spans[inner_id])
                }
            }
            return .VImm(value: 0)
        }
        if is_must == false and self.is_fallible_kind(self.return_kind) == false {
            self.report_error("error: `try` only works in a function that returns `T or Error`; use `must` or match the result", span: self.p.expr_spans[inner_id])
        }
        let val = self.compile_expr(inner_id)
        self.mov_to(val, dest: "x0")
        mut disc = self.pool.alloc_reg()
        self.emit(f"ldr {disc}, [x0]")
        let ok_lbl = self.fresh("Lresult_ok")
        let done_lbl = self.fresh("Lresult_done")
        self.emit(f"cmp {disc}, #{self.result_ok_disc()}")
        self.pool.free_reg(disc)
        self.emit(f"beq {ok_lbl}")
        // Err path.
        if is_must {
            // Load the Error interface cell, then dispatch its to_str
            // method to render a panic message. Layout:
            //   result cell:    [disc, error_iface_ptr]
            //   error iface:    [data_ptr, vtable_ptr]
            //   vtable[0]:      to_str method (only entry on Error)
            self.emit("ldr x0, [x0, #8]")    // x0 = error iface cell ptr
            self.emit("ldr x1, [x0, #8]")    // x1 = vtable ptr
            self.emit("ldr x9, [x1, #0]")    // x9 = to_str method
            self.emit("ldr x0, [x0, #0]")    // x0 = self (data ptr)
            self.emit("blr x9")              // x0 = str
            self.emit("bl _kod_panic")
        } else {
            // Propagate: the cell ptr is already in x0; just return it.
            self.emit(f"b {self.ret_lbl}")
        }
        self.emit_label(ok_lbl)
        let result_r = self.pool.alloc_reg()
        self.emit(f"ldr {result_r}, [x0, #8]")
        self.emit_label(done_lbl)
        return .VReg(name: result_r)
    }

    // `must` and `try` report and pass on the error as an `Error`.
    func is_fallible_kind(self, anon kind: TypeKind) -> bool {
        if self.is_result_kind(kind) == false {
            return false
        }
        let .KEnum(idx) = kind else { return false }
        let err_kinds = self.enums[idx].variants[1].field_kinds
        if len(err_kinds) != 1 {
            return false
        }
        return self.same_kind(err_kinds[0], .KInterface(idx: self.find_iface_idx("Error")))
    }

    func try_word(self, anon is_must: bool) -> str {
        if is_must {
            return "must"
        }
        return "try"
    }

    func compile_try(self, anon inner_id: int64) -> Val {
        return self.compile_try_or_must(inner_id, is_must: false)
    }

    func compile_must(self, anon inner_id: int64) -> Val {
        return self.compile_try_or_must(inner_id, is_must: true)
    }

    // `expr?` on a `T?` value. Optional values are represented as nullable
    // pointers: `none` is the 0 word, `Some(v)` is a pointer to a one-slot
    // cell whose contents is `v`. We test the pointer against zero;
    // non-null dereferences to the payload, null either panics (no `or
    // default`) or evaluates `default_id`.
    func compile_unwrap_opt(self, value_id: int64, default_id: int64) -> Val {
        let value_kind = self.infer_kind(value_id)
        mut optional = false
        if value_kind is .KOptional(_inner) {
            optional = true
        }
        if optional == false {
            self.compile_discard(value_id)
            if default_id != 0 {
                self.compile_discard(default_id)
            }
            if value_kind is .KUnknown {
                self.report_cannot_infer(value_id, what: "this expression")
            } else {
                if self.kind_has_unknown(value_kind) == false {
                    self.report_error(f"error: `?` needs an optional value, got `{self.kind_display(value_kind)}`", span: self.p.expr_spans[value_id])
                }
            }
            return .VImm(value: 0)
        }
        let val = self.compile_expr(value_id)
        mut reg = self.load(val)
        let some_lbl = self.fresh("Lopt_some")
        let done_lbl = self.fresh("Lopt_done")
        self.emit(f"cbnz {reg}, {some_lbl}")
        // none path
        if default_id == 0 {
            let pos = self.format_position(self.p.expr_spans[value_id].start)
            let msg = f"{pos}: unwrap on none"
            let msg_lbl = self.intern_str(msg)
            self.emit(f"adrp x0, {msg_lbl}@PAGE")
            self.emit(f"add x0, x0, {msg_lbl}@PAGEOFF")
            self.emit("bl _kod_panic")
        } else {
            let inner = self.optional_inner(value_kind)
            let panics = self.is_diverging_call(default_id)
            if panics == false and self.converts_for(default_id, kind: inner) {
                let dreg = self.compile_value_for_kind(default_id, expected: inner)
                self.mov_to(.VReg(name: dreg), dest: reg)
            } else {
                let dval = self.compile_expr(default_id)
                self.mov_to(dval, dest: reg)
            }
            if panics == false {
                self.check_diverge_ok(default_id, expected: inner)
            }
            self.emit(f"b {done_lbl}")
        }
        self.emit_label(some_lbl)
        // Some(v) path: dereference the cell to get v.
        self.emit(f"ldr {reg}, [{reg}]")
        self.emit_label(done_lbl)
        return .VReg(name: reg)
    }

    // If `expr_id`'s inferred kind is `KOptional(KStruct(idx, _))`,
    // return idx; otherwise -1. Folded out of `compile_optional_dot` /
    // the `infer_kind` arm to keep both copies of the pattern in lockstep.
    func find_struct_idx_of_optional(self, anon expr_id: int64) -> int64 {
        mut inner_kind: TypeKind = .KVoid
        mut is_opt: bool = false
        if self.infer_kind(expr_id) is .KOptional(u) {
            inner_kind = u
            is_opt = true
        }
        if is_opt == false {
            return -1
        }
        if inner_kind is .KStruct(idx, _args) {
            return idx
        }
        return -1
    }

    // `x?.field` — short-circuit field access on a `T?` struct. If x is
    // none, the whole expression is none. Otherwise we dereference to get
    // the struct pointer, read .field, and wrap the value into a fresh
    // Some cell so the result is `U?` (U = field's type).
    func compile_optional_dot(self, value_id: int64, field: str) -> Val {
        let struct_idx: int64 = self.find_struct_idx_of_optional(value_id)
        if struct_idx < 0 {
            self.compile_discard(value_id)
            if self.kind_has_unknown(self.infer_kind(value_id)) {
                self.report_if_unknown(value_id)
                return .VImm(value: 0)
            }
            self.report_error(f"error: `?.{field}` requires a `T?` value where T is a struct", span: self.p.expr_spans[value_id])
            return .VImm(value: 0)
        }
        mut foff: int64 = 0
        if self.check_field(field, :struct_idx, span: self.p.expr_spans[value_id]) {
            foff = self.find_field_offset(field, :struct_idx)
        }
        let val = self.compile_expr(value_id)
        mut reg = self.load(val)
        let none_lbl = self.fresh("Lopt_dot_none")
        let done_lbl = self.fresh("Lopt_dot_done")
        self.emit(f"cbz {reg}, {none_lbl}")
        // Dereference the Optional cell to get the struct pointer, then
        // load the field at its known offset.
        self.emit(f"ldr {reg}, [{reg}]")
        self.emit(f"ldr {reg}, [{reg}, #{foff}]")
        // Wrap the field value into a fresh Some cell: arena_alloc 8 +
        // store the value. Preserves the field value across `bl`.
        let val_spilled = self.preserve_begin(reg)
        self.emit("mov x0, #8")
        self.emit("bl _arena_alloc")
        let ptr = self.pool.alloc_reg()
        self.emit(f"mov {ptr}, x0")
        let tmp = self.preserve_end(reg, spilled: val_spilled)
        self.emit(f"str {tmp}, [{ptr}]")
        self.pool.free_reg(tmp)
        self.emit(f"b {done_lbl}")
        self.emit_label(none_lbl)
        self.emit(f"mov {ptr}, #0")
        self.emit_label(done_lbl)
        return .VReg(name: ptr)
    }

    // `x?.method(args)` — short-circuit method call on a `T?` struct.
    // If x is none, the whole expression is none. Otherwise dereference
    // the Optional cell to get the struct pointer, dispatch the method,
    // and wrap the return value into a fresh Some cell.
    func compile_optional_method_call(self, value_id: int64, method: str, args: [ast.CallArg]) -> Val {
        let struct_idx: int64 = self.find_struct_idx_of_optional(value_id)
        if struct_idx < 0 {
            self.compile_discard(value_id)
            for arg in args {
                self.compile_discard(arg.value)
            }
            if self.kind_has_unknown(self.infer_kind(value_id)) {
                self.report_if_unknown(value_id)
                return .VImm(value: 0)
            }
            self.report_error(f"error: `?.{method}(...)` requires a `T?` value where T is a struct", span: self.p.expr_spans[value_id])
            return .VImm(value: 0)
        }
        mut method_lbl: str = ""
        mut sig_params: [TypeKind] = []
        mut sig_labels: [str] = []
        mut sig_defaults: [int64] = []
        mut sig_src_p: parsing.Parser = self.p
        if self.structs[struct_idx].method_idx.get(method) is Some(mi) {
            method_lbl = f"${self.structs[struct_idx].module_prefix}${self.structs[struct_idx].name}${method}"
            sig_params = self.structs[struct_idx].methods[mi].sig.param_kinds
            sig_labels = self.structs[struct_idx].methods[mi].sig.param_labels
            sig_defaults = self.structs[struct_idx].methods[mi].sig.param_default_exprs
            sig_src_p = self.structs[struct_idx].methods[mi].sig.src_p
        }
        if len(method_lbl) == 0 {
            self.report_error(f"error: struct `{self.struct_display_name(struct_idx)}` has no method `{method}`", span: self.p.expr_spans[value_id])
            return .VImm(value: 0)
        }
        self.check_call_args(args, param_labels: sig_labels, param_defaults: sig_defaults, skip: 1, call_name: method, call_span: self.p.expr_spans[value_id])
        let result = self.pool.alloc_reg()
        let val = self.compile_expr(value_id)
        mut reg = self.load(val)
        let some_lbl = self.fresh("Lopt_call_some")
        let done_lbl = self.fresh("Lopt_call_done")
        self.emit(f"cbnz {reg}, {some_lbl}")
        // none path: result stays 0.
        self.emit(f"mov {result}, #0")
        self.emit(f"b {done_lbl}")
        self.emit_label(some_lbl)
        // Dereference the Optional cell — reg now holds the struct pointer
        // (the method's `self`).
        self.emit(f"ldr {reg}, [{reg}]")
        // Park the struct pointer + each arg on the stack so the inner
        // bls (arg wrapping, method dispatch itself) can't clobber them.
        let arg_regs: [str] = ["x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7"]
        mut total_user: int64 = len(args)
        if len(sig_params) - 1 > total_user {
            total_user = len(sig_params) - 1
        }
        let n: int64 = total_user + 1
        mut padded: int64 = n * 8
        if padded % 16 != 0 {
            padded = padded + 8
        }
        self.emit(f"sub sp, sp, #{padded}")
        self.emit(f"str {reg}, [sp]")
        self.pool.free_reg(reg)
        mut i: int64 = 0
        for i < total_user {
            mut arg_reg: str = ""
            let param_idx: int64 = i + 1
            if i >= len(args) {
                arg_reg = self.compile_default(sig_defaults[param_idx], expected: sig_params[param_idx], src_p: sig_src_p)
            } else {
                if param_idx < len(sig_params) {
                    arg_reg = self.compile_into(args[i].value, expected: sig_params[param_idx])
                } else {
                    let arg_val = self.compile_expr(args[i].value)
                    arg_reg = self.load(arg_val)
                }
            }
            self.emit(f"str {arg_reg}, [sp, #{(i + 1) * 8}]")
            self.pool.free_reg(arg_reg)
            i = i + 1
        }
        mut k: int64 = 0
        for k < n and k < len(arg_regs) {
            self.emit(f"ldr {arg_regs[k]}, [sp, #{k * 8}]")
            k = k + 1
        }
        self.emit(f"add sp, sp, #{padded}")
        self.emit(f"bl {method_lbl}")
        // Wrap the return value (now in x0) into a fresh Some cell.
        let ret_reg = self.pool.alloc_reg()
        self.emit(f"mov {ret_reg}, x0")
        let val_spilled = self.preserve_begin(ret_reg)
        self.emit("mov x0, #8")
        self.emit("bl _arena_alloc")
        let ptr = self.pool.alloc_reg()
        self.emit(f"mov {ptr}, x0")
        let tmp = self.preserve_end(ret_reg, spilled: val_spilled)
        self.emit(f"str {tmp}, [{ptr}]")
        self.pool.free_reg(tmp)
        self.emit(f"mov {result}, {ptr}")
        self.pool.free_reg(ptr)
        self.emit_label(done_lbl)
        return .VReg(name: result)
    }

    func compile_if(self, cond_id: int64, then_body: [int64], else_body: [int64]) -> none {
        let lbl = self.fresh("Lif")
        let false_lbl = f"{lbl}_false"
        let end_lbl = f"{lbl}_end"
        let cond_val = self.compile_expr(cond_id)
        self.check_bool(cond_id, need: "an `if` condition must be a `bool`", optional_hint: "; test it with `is not none`")
        let cond_reg = self.load(cond_val)
        self.emit(f"cmp {cond_reg}, #0")
        self.pool.free_reg(cond_reg)
        self.emit(f"beq {false_lbl}")
        self.compile_block(then_body)
        self.emit(f"b {end_lbl}")
        self.emit_label(false_lbl)
        self.compile_block(else_body)
        self.emit_label(end_lbl)
    }

    func compile_for(self, anon body: [int64], cond_id: int64) -> none {
        let lbl = self.fresh("Lfor")
        let start_lbl = f"{lbl}_start"
        let end_lbl = f"{lbl}_end"
        // `continue` lands here — re-check the loop condition. Previously
        // pointed at end_lbl, which made `continue` behave as `break`.
        self.loop_stack += [LoopLbl(:start_lbl, :end_lbl, incr_lbl: start_lbl)]
        self.emit_label(start_lbl)
        let cond_val = self.compile_expr(cond_id)
        self.check_bool(cond_id, need: "a `for` condition must be a `bool`", optional_hint: "; test it with `is not none`")
        let cond_reg = self.load(cond_val)
        self.emit(f"cmp {cond_reg}, #0")
        self.pool.free_reg(cond_reg)
        self.emit(f"beq {end_lbl}")
        self.compile_block(body)
        self.emit(f"b {start_lbl}")
        self.emit_label(end_lbl)
        let n = len(self.loop_stack)
        mut new_stack: [LoopLbl] = []
        mut j = 0
        for j < n - 1 {
            new_stack += [self.loop_stack[j]]
            j = j + 1
        }
        self.loop_stack = new_stack
    }

    func compile_foreach(self, anon body: [int64], name: str, iter_id: int64) -> none {
        self.note_wide_fn_local(name, value: iter_id)
        let name_off = self.name_before(name, off: self.p.expr_spans[iter_id].start)
        let clash = self.rebinds_outer(name, off: name_off, depth: self.block_depth + 1)
        let outer_kind = self.find_var_kind(name)
        // Pin the element binding's kind for THIS loop. Collection only
        // pre-reserved a slot (with a placeholder kind) because two loops
        // can share an element name with different iterator types — the
        // body needs to see the kind of *this* iterator, not whichever
        // foreach ran last during collection.
        mut elem_kind: TypeKind = .KInt64
        let iter_kind = self.infer_kind(iter_id)
        match iter_kind {
            .KUnknown -> elem_kind = .KUnknown
            .KArrayStruct(elem_idx) -> elem_kind = .KStruct(idx: elem_idx, type_args: [])
            .KArrayEnum(elem_idx) -> elem_kind = .KEnum(idx: elem_idx)
            .KArrayStr -> elem_kind = .KStr
            .KArrayBytes -> elem_kind = .KBytes
            .KArrayInterface(elem_idx) -> elem_kind = .KInterface(idx: elem_idx)
            .KArrayOptional(inner_kind) -> elem_kind = .KOptional(inner: inner_kind)
            .KArrayFunc(param_kinds, return_kind) -> elem_kind = .KFunc(:param_kinds, :return_kind)
            .KArrayBool -> elem_kind = .KBool
            .KArrayArray(inner) -> elem_kind = inner
            else none
        }
        mut iterable = self.is_array_kind(iter_kind)
        if iter_kind is .KUnknown {
            iterable = true
        }
        if iterable == false {
            elem_kind = .KUnknown
        }
        self.update_var_kind(:name, kind: elem_kind)

        let lbl = self.fresh("Lfe")
        let start_lbl = f"{lbl}_start"
        let incr_lbl = f"{lbl}_incr"
        let end_lbl = f"{lbl}_end"
        self.loop_stack += [LoopLbl(start_lbl: incr_lbl, :end_lbl, :incr_lbl)]

        let idx_name = f"__fi_{name}"
        let idx_off = self.find_var_offset(idx_name)
        let elem_off = self.find_var_offset(name)
        // Pre-allocated by collect_stmt_vars: stash the array header here
        // so the body can issue `bl` calls without clobbering data/len regs.
        let hdr_name = f"__fh_{name}"
        let hdr_off = self.find_var_offset(hdr_name)

        let arr_val = self.compile_expr(iter_id)
        if iter_kind is .KUnknown {
            self.report_cannot_infer(iter_id, what: "this expression")
        }
        if iterable == false and self.kind_has_unknown(iter_kind) == false {
            self.report_error(self.foreach_error(iter_kind, iter_id: iter_id), span: self.p.expr_spans[iter_id])
        }
        let hdr_r = self.load(arr_val)
        self.emit_str(hdr_off, reg: hdr_r)
        self.pool.free_reg(hdr_r)

        let idx_r = self.pool.alloc_reg()
        self.emit(f"mov {idx_r}, #0")
        self.emit_str(idx_off, reg: idx_r)
        self.pool.free_reg(idx_r)

        self.emit_label(start_lbl)
        let hdr_reg = self.pool.alloc_reg()
        let len_reg = self.pool.alloc_reg()
        let idx_reg = self.pool.alloc_reg()
        self.emit_ldr(hdr_off, reg: hdr_reg)
        self.emit(f"ldr {len_reg}, [{hdr_reg}, #8]")
        self.emit_ldr(idx_off, reg: idx_reg)
        self.emit(f"cmp {idx_reg}, {len_reg}")
        self.emit(f"bge {end_lbl}")
        self.pool.free_reg(len_reg)

        mut elem_reg = self.pool.alloc_reg()
        self.emit(f"ldr {elem_reg}, [{hdr_reg}]")
        self.emit(f"lsl {idx_reg}, {idx_reg}, #3")
        self.emit(f"ldr {elem_reg}, [{elem_reg}, {idx_reg}]")
        self.emit_str(elem_off, reg: elem_reg)
        self.pool.free_reg(elem_reg)
        self.pool.free_reg(idx_reg)
        self.pool.free_reg(hdr_reg)

        let mark = len(self.bound_log)
        self.bind_at(name, off: name_off, depth: self.block_depth + 1)
        self.compile_block(body)
        self.unbind_to(mark)
        if clash {
            self.update_var_kind(:name, kind: outer_kind)
        }

        self.emit_label(incr_lbl)
        let bump_reg = self.pool.alloc_reg()
        self.emit_ldr(idx_off, reg: bump_reg)
        self.emit(f"add {bump_reg}, {bump_reg}, #1")
        self.emit_str(idx_off, reg: bump_reg)
        self.pool.free_reg(bump_reg)
        self.emit(f"b {start_lbl}")
        self.emit_label(end_lbl)

        let n = len(self.loop_stack)
        mut new_stack: [LoopLbl] = []
        mut j = 0
        for j < n - 1 {
            new_stack += [self.loop_stack[j]]
            j = j + 1
        }
        self.loop_stack = new_stack
    }

    func foreach_error(self, anon kind: TypeKind, iter_id: int64) -> str {
        let msg = f"error: cannot iterate over a value of type `{self.kind_display(kind)}`"
        mut hint = ""
        if kind is .KStr {
            hint = ".code_points()"
        }
        if kind is .KStruct(idx, _type_args) {
            let template_idx = self.structs[idx].template_idx
            if template_idx >= 0 {
                if self.structs[template_idx].name == "Map" {
                    hint = ".keys"
                }
            }
        }
        if len(hint) == 0 {
            return msg
        }
        if self.p.exprs[iter_id] is .Ident(name) {
            return f"{msg}; iterate over `{name}{hint}` instead"
        }
        return f"{msg}; iterate over its `{hint}` instead"
    }

    func compile_break(self) -> none {
        self.emit(f"b {self.loop_stack[-1].end_lbl}")
    }

    func compile_continue(self) -> none {
        self.emit(f"b {self.loop_stack[-1].incr_lbl}")
    }

    // `T?` is a nullable cell, not an Option enum cell: `.Some`/`.None` on it mean SomePat/NonePat.
    func let_else_pattern(self, anon pattern_id: int64, value_id: int64) -> ast.Pattern {
        return self.subject_pattern(self.p.patterns[pattern_id], subject_kind: self.infer_kind(value_id))
    }

    // On a `T?` subject, `.Some(v)` and `.None`, or `Option.` ones, are its Some and none patterns.
    func subject_pattern(self, anon pat: ast.Pattern, subject_kind: TypeKind) -> ast.Pattern {
        if subject_kind is .KInterface(_idx) {
            return self.downcast_pattern(pat)
        }
        let .KOptional(_inner) = subject_kind else { return pat }
        mut variant_name = ""
        mut bindings: [str] = []
        match pat {
            .ImplicitEnumPat(v, b) -> {
                variant_name = v
                bindings = b
            }
            .EnumPat(e, v, b) -> {
                if e != "Option" {
                    return pat
                }
                variant_name = v
                bindings = b
            }
            else return pat
        }
        if variant_name == "None" and len(bindings) == 0 {
            return ast.Pattern.NonePat
        }
        if variant_name == "Some" and len(bindings) <= 1 {
            mut binding = ""
            if len(bindings) == 1 {
                binding = bindings[0]
            }
            return ast.Pattern.SomePat(:binding)
        }
        return pat
    }

    // On an interface, `alias.T(b)` is the downcast to a struct `T` of an imported module.
    func downcast_pattern(self, anon pat: ast.Pattern) -> ast.Pattern {
        let .EnumPat(alias, type_name, bindings) = pat else { return pat }
        if len(bindings) > 1 or self.is_import_alias(alias) == false {
            return pat
        }
        mut binding = ""
        if len(bindings) == 1 {
            binding = bindings[0]
        }
        return .TypePat(:type_name, :binding)
    }

    // Refutable `let .Pat(...) = expr else { ... }`. On a successful pattern
    // match, the bindings receive the variant's payload fields and execution
    // falls through; on mismatch, the else-block runs (and must diverge).
    func compile_let_else(self, anon else_body: [int64], pattern_id: int64, value_id: int64) -> none {
        if self.walk_completes(else_body) {
            self.report_error("error: the else block of a let-else must leave the scope (return, throw, break, continue or panic)", span: self.p.expr_spans[value_id])
        }
        if self.infer_kind(value_id) is .KUnknown {
            self.compile_discard(value_id)
            self.report_cannot_infer(value_id, what: "this expression")
            for name in self.pattern_binding_names(self.let_else_pattern(pattern_id, :value_id)) {
                self.update_var_kind(:name, kind: .KUnknown)
            }
            return
        }
        if self.check_pattern_subject(self.let_else_pattern(pattern_id, :value_id), subject_id: value_id) == false {
            self.compile_discard(value_id)
            for name in self.pattern_binding_names(self.let_else_pattern(pattern_id, :value_id)) {
                self.update_var_kind(:name, kind: .KUnknown)
            }
            return
        }
        let else_lbl = self.fresh("Llet_else")
        let done_lbl = self.fresh("Llet_done")
        let subj_val = self.compile_expr(value_id)
        let sptr_r = self.load(subj_val)
        let subj_slot = self.alloc_var(name: self.fresh("__lsubj"), kind: .KInt64)
        self.emit_str(subj_slot, reg: sptr_r)
        self.pool.free_reg(sptr_r)
        let pattern = self.let_else_pattern(pattern_id, :value_id)
        let value_kind = self.infer_kind(value_id)
        self.retype_pattern_bindings(pattern, subject_kind: value_kind)
        match pattern {
            .EnumPat(enum_name, variant_name, bindings) -> {
                let enum_idx = self.pattern_enum_idx(:enum_name, :variant_name, subj_enum_idx: self.enum_idx_of_kind(value_kind), span: self.p.expr_spans[value_id])
                if enum_idx < 0 {
                    return
                }
                mut variant_idx = self.pattern_variant_idx(enum_idx, :variant_name, binding_count: len(bindings), span: self.p.expr_spans[value_id])
                if variant_idx < 0 {
                    return
                }
                mut disc = self.enums[enum_idx].variants[variant_idx].discriminant
                let disc_r = self.pool.alloc_reg()
                let ptr_r = self.pool.alloc_reg()
                self.emit_ldr(subj_slot, reg: ptr_r)
                self.emit(f"ldr {disc_r}, [{ptr_r}]")
                self.emit(f"cmp {disc_r}, #{disc}")
                self.emit(f"bne {else_lbl}")
                self.pool.free_reg(disc_r)
                self.pool.free_reg(ptr_r)
                let vinfo = self.enums[enum_idx].variants[variant_idx]
                mut key_idx = 0
                for key_idx < len(bindings) {
                    mut foff = vinfo.field_offsets[key_idx]
                    let binding_off = self.find_var_offset(bindings[key_idx])
                    let ptr_r2 = self.pool.alloc_reg()
                    self.emit_ldr(subj_slot, reg: ptr_r2)
                    let fv_r = self.pool.alloc_reg()
                    self.emit(f"ldr {fv_r}, [{ptr_r2}, #{8 + foff}]")
                    self.emit_str(binding_off, reg: fv_r)
                    self.pool.free_reg(fv_r)
                    self.pool.free_reg(ptr_r2)
                    key_idx = key_idx + 1
                }
            }
            .ImplicitEnumPat(variant_name, bindings) -> {
                let enum_idx = self.pattern_enum_idx(enum_name: "", :variant_name, subj_enum_idx: self.enum_idx_of_kind(value_kind), span: self.p.expr_spans[value_id])
                if enum_idx < 0 {
                    return
                }
                mut variant_idx = self.pattern_variant_idx(enum_idx, :variant_name, binding_count: len(bindings), span: self.p.expr_spans[value_id])
                if variant_idx < 0 {
                    return
                }
                mut disc = self.enums[enum_idx].variants[variant_idx].discriminant
                let disc_r = self.pool.alloc_reg()
                let ptr_r = self.pool.alloc_reg()
                self.emit_ldr(subj_slot, reg: ptr_r)
                self.emit(f"ldr {disc_r}, [{ptr_r}]")
                self.emit(f"cmp {disc_r}, #{disc}")
                self.emit(f"bne {else_lbl}")
                self.pool.free_reg(disc_r)
                self.pool.free_reg(ptr_r)
                let vinfo2 = self.enums[enum_idx].variants[variant_idx]
                mut key_idx = 0
                for key_idx < len(bindings) {
                    mut foff = vinfo2.field_offsets[key_idx]
                    let binding_off = self.find_var_offset(bindings[key_idx])
                    let ptr_r2 = self.pool.alloc_reg()
                    self.emit_ldr(subj_slot, reg: ptr_r2)
                    let fv_r = self.pool.alloc_reg()
                    self.emit(f"ldr {fv_r}, [{ptr_r2}, #{8 + foff}]")
                    self.emit_str(binding_off, reg: fv_r)
                    self.pool.free_reg(fv_r)
                    self.pool.free_reg(ptr_r2)
                    key_idx = key_idx + 1
                }
            }
            .SomePat(binding) -> {
                let disc_r = self.pool.alloc_reg()
                self.emit_ldr(subj_slot, reg: disc_r)
                self.emit(f"cmp {disc_r}, #0")
                self.emit(f"beq {else_lbl}")
                self.pool.free_reg(disc_r)
                if len(binding) > 0 {
                    let boff = self.find_var_offset(binding)
                    let ptr_r = self.pool.alloc_reg()
                    self.emit_ldr(subj_slot, reg: ptr_r)
                    let val_r = self.pool.alloc_reg()
                    self.emit(f"ldr {val_r}, [{ptr_r}]")
                    self.emit_str(boff, reg: val_r)
                    self.pool.free_reg(val_r)
                    self.pool.free_reg(ptr_r)
                }
            }
            .NonePat -> {
                let disc_r = self.pool.alloc_reg()
                self.emit_ldr(subj_slot, reg: disc_r)
                self.emit(f"cmp {disc_r}, #0")
                self.emit(f"bne {else_lbl}")
                self.pool.free_reg(disc_r)
            }
            else {
                self.report_error("error: pattern not supported in let-else", span: self.p.expr_spans[value_id])
                return
            }
        }
        self.emit(f"b {done_lbl}")
        self.emit_label(else_lbl)
        self.compile_block(else_body)
        self.emit_label(done_lbl)
    }

    func compile_match_stmt(self, anon arms: [int64], subject_id: int64) -> none {
        if self.infer_kind(subject_id) is .KUnknown {
            self.compile_discard(subject_id)
            self.report_cannot_infer(subject_id, what: "this expression")
            return
        }
        mut stmt_patterns: [int64] = []
        for arm_id in arms {
            stmt_patterns += [self.p.match_arms[arm_id].pattern]
        }
        let attempts_before = self.report_attempts
        self.check_match_subject(subject_id, pattern_ids: stmt_patterns)
        if self.report_attempts == attempts_before {
            self.check_match_exhaustive(subject_id, pattern_ids: stmt_patterns)
        }
        // Static enum kind of the subject, used to disambiguate
        // implicit `.Foo` patterns when multiple enums declare a
        // variant named `Foo`. -1 if the subject isn't an enum.
        let subj_kind = self.infer_kind(subject_id)
        let subj_enum_idx: int64 = self.enum_idx_of_kind(subj_kind)
        let done_lbl = self.fresh("Lmatch_done")
        // Evaluate subject once; stash its pointer on the stack so pattern
        // bindings can read fields off the subject after disc_r is consumed.
        let subj_val = self.compile_expr(subject_id)
        let sptr_r = self.load(subj_val)
        let subj_slot = self.alloc_var(name: self.fresh("__msubj"), kind: .KInt64)
        self.emit_str(subj_slot, reg: sptr_r)
        self.pool.free_reg(sptr_r)
        let disc_val = .VStack(offset: subj_slot)
        let disc_r = self.load_enum_or_val(disc_val, expr_id: subject_id)
        mut i = 0
        for i < len(arms) {
            let arm = self.p.match_arms[arms[i]]
            let skip_lbl = self.fresh("Lmatch_skip")
            match self.subject_pattern(self.p.patterns[arm.pattern], subject_kind: subj_kind) {
                .Wildcard -> {
                    self.compile_block(arm.body)
                    self.emit(f"b {done_lbl}")
                }
                .IntPat(value) -> {
                    self.emit_cmp_imm(disc_r, :value)
                    self.emit(f"bne {skip_lbl}")
                    self.compile_block(arm.body)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .BoolPat(value) -> {
                    mut lit = 0
                    if value {
                        lit = 1
                    }
                    self.emit(f"cmp {disc_r}, #{lit}")
                    self.emit(f"bne {skip_lbl}")
                    self.compile_block(arm.body)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .StrPat(value) -> {
                    let slbl = self.intern_str(value)
                    // Reload from subj_slot — disc_r may have been clobbered
                    // by a prior arm's `bl _kod_str_cmp`.
                    self.emit_ldr(subj_slot, reg: "x0")
                    self.emit(f"adrp x1, {slbl}@PAGE")
                    self.emit(f"add x1, x1, {slbl}@PAGEOFF")
                    self.emit("bl _kod_str_cmp")
                    self.emit("cmp x0, #0")
                    self.emit(f"bne {skip_lbl}")
                    self.compile_block(arm.body)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .EnumPat(_enum_name, _variant_name, _bindings) -> {
                    self.emit_variant_test(self.p.patterns[arm.pattern], :subj_enum_idx, :disc_r, :subj_slot, :skip_lbl, span: self.p.expr_spans[subject_id])
                    self.compile_arm_stmts(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .ImplicitEnumPat(_variant_name, _bindings) -> {
                    self.emit_variant_test(self.p.patterns[arm.pattern], :subj_enum_idx, :disc_r, :subj_slot, :skip_lbl, span: self.p.expr_spans[subject_id])
                    self.compile_arm_stmts(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .NonePat -> {
                    self.emit(f"cmp {disc_r}, #0")
                    self.emit(f"bne {skip_lbl}")
                    self.compile_block(arm.body)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .SomePat(binding) -> {
                    self.emit(f"cmp {disc_r}, #0")
                    self.emit(f"beq {skip_lbl}")
                    if len(binding) > 0 {
                        let boff = self.find_var_offset(binding)
                        let ptr_r = self.pool.alloc_reg()
                        self.emit_ldr(subj_slot, reg: ptr_r)
                        let val_r = self.pool.alloc_reg()
                        self.emit(f"ldr {val_r}, [{ptr_r}]")
                        self.emit_str(boff, reg: val_r)
                        self.pool.free_reg(val_r)
                        self.pool.free_reg(ptr_r)
                    }
                    self.compile_arm_stmts(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                // Result arms: payload at offset 8; disc looked up
                // dynamically since variant discs start at 1 (disc 0
                // reserved as None for nullable contexts).
                .OkPat(binding) -> {
                    self.emit(f"cmp {disc_r}, #{self.result_ok_disc()}")
                    self.emit(f"bne {skip_lbl}")
                    self.bind_result_payload(binding, :subj_slot)
                    self.compile_arm_stmts(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .ErrPat(binding) -> {
                    self.emit(f"cmp {disc_r}, #{self.result_ok_disc()}")
                    self.emit(f"beq {skip_lbl}")
                    self.bind_result_payload(binding, :subj_slot)
                    self.compile_arm_stmts(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
                .TypePat(type_name, binding) -> {
                    self.emit_typepat_test(:type_name, :binding, :subject_id, :subj_slot, :skip_lbl)
                    self.compile_arm_stmts(arm.body, pattern_id: arm.pattern, subject_kind: subj_kind)
                    self.emit(f"b {done_lbl}")
                    self.emit_label(skip_lbl)
                }
            }
            i = i + 1
        }
        self.emit_label(done_lbl)
        self.pool.free_reg(disc_r)
    }


    // Per-function regalloc lives in `kod/regalloc` — `compile_func`
    // calls `regalloc.run` once the body is buffered to refine the
    // alloc-time vreg→phys mapping via linear scan, then
    // `regalloc.pack` to collapse the chosen callee-saved set into a
    // dense `x19..` prefix.

    func compile_func(self, fd_id: int64, struct_name: str, override_lbl: str) -> none {
        let func_decl = self.p.func_decls[fd_id]
        self.check_param_order(func_decl, func_decl.name)
        // A generic template's methods are checked once, in check_module_types.
        if self.body_instance < 0 {
            mut what = f"`{func_decl.name}`"
            if len(struct_name) > 0 {
                what = f"`{struct_name}.{func_decl.name}`"
            } else if self.is_lambda_name(func_decl.name) {
                what = "this function literal"
                if len(func_decl.params) > 8 {
                    let slot = self.lookup_func(func_decl.name)
                    if slot != -1 {
                        let sig = self.fn_sig(slot)
                        self.limit_kinds += [self.canonical_kind_name(.KFunc(param_kinds: sig.param_kinds, return_kind: sig.return_kind))]
                    }
                }
            }
            self.check_param_count(func_decl.params, :what, span: func_decl.name_span)
        }
        self.vars = []
        self.limit_fn_locals = []
        self.bound_log = []
        self.block_depth = 0
        self.frame_slots = 0
        self.pool.reset()
        self.loop_stack = []
        self.func_lines_labels = []
        self.func_lines_values = []
        self.last_marked_line = 0

        self.check_sig_types(func_decl.params, return_typ: func_decl.return_typ)
        for param in func_decl.params {
            mut kind = self.resolve_type(param.typ)
            // The method receiver `self` has no type annotation; give it
            // the kind of the enclosing struct so field/method access works.
            if param.name == "self" and len(struct_name) > 0 {
                let struct_idx = self.find_struct_idx(struct_name)
                if struct_idx >= 0 {
                    kind = .KStruct(idx: struct_idx, type_args: [])
                }
            }
            if param.default_expr != 0 {
                self.check_default(param.default_expr, expected: kind)
            }
            self.alloc_var(name: param.name, :kind)
            // Parameters are immutable by default; `mut x` (or `mut self`)
            // opts the binding into reassignment. The slot otherwise defaults
            // mutable, so only params need this explicit set.
            self.vars[-1].mutable = param.mutable
            self.vars[-1].bound = true
            self.vars[-1].depth = 1
            self.vars[-1].bind_off = param.span.start
        }

        for stmt_id in func_decl.body {
            self.collect_stmt_vars(:stmt_id)
        }
        self.fixed_names = self.fixed_params(func_decl)

        mut func_lbl = f"${self.path_prefix}${func_decl.name}"
        if len(struct_name) > 0 {
            func_lbl = f"${self.path_prefix}${struct_name}${func_decl.name}"
        }
        if len(override_lbl) > 0 {
            func_lbl = override_lbl
        }
        // L-prefix the function-end label so the assembler keeps it
        // file-local and out of the symbol table. With
        // `.subsections_via_symbols` set, every symbol becomes a
        // subsection boundary — and our epilogue falls through from
        // the function body into `…$end:`, so if `$end` got its own
        // subsection the linker could place it anywhere, and `ret`
        // would end up in the wrong code.
        self.ret_lbl = f"L{func_lbl}$end"
        self.return_kind = self.resolve_type(func_decl.return_typ)

        self.emit_globl(func_lbl)
        self.emit_label(func_lbl)
        mut display_name: str = func_decl.name
        if len(struct_name) > 0 {
            display_name = f"{struct_name}.{func_decl.name}"
        }
        let decl_line: int64 = self.line_of_offset(func_decl.name_span.start)

        // Compile the body into a private buffer so the callee-saved
        // save/restore (whose count is only known once `cs_high_water` is
        // final) can be spliced in around it: pushes go between the label
        // and the frame prologue, pops go just before `ret`. The pushes
        // live *outside* the existing frame, so every fp-relative local
        // and sp-relative spill in the body keeps its exact offset.
        let saved_buf = self.out_buf
        let vreg_start: int64 = len(self.pool.vreg_phys)
        self.out_buf = []

        let arg_regs: [str] = ["x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7"]
        mut k = 0
        for param in func_decl.params {
            if k < len(arg_regs) {
                self.emit_str(self.find_var_offset(param.name), reg: arg_regs[k])
            }
            k = k + 1
        }

        let body_mark = self.report_attempts
        self.reads_scoped = true
        self.compile_block(func_decl.body)
        // An error in the body or a parse error may be what hides its `return`.
        if self.report_attempts == body_mark and len(self.p.errors) == 0 {
            self.check_reaches_end(func_decl, :struct_name)
        }
        self.reads_scoped = false

        self.emit_no_value_return()

        self.emit_label(self.ret_lbl)
        // From fp: a `try` inside a pushed region branches here with sp still lowered.
        self.emit("mov sp, fp")
        self.emit("ldp fp, lr, [sp], #16")

        let body_buf = self.out_buf
        self.out_buf = saved_buf

        // Run linear-scan regalloc over the function's vregs, reusing
        // the alloc-time pool. Updates `vreg_phys` for this function's
        // range; the substitution at flush_out time picks up the new
        // assignments. Then `regalloc.pack` collapses the chosen
        // callee-saved set into a dense `x19..` prefix and returns the
        // new high-water mark so the prologue saves exactly the
        // registers the body actually uses.
        regalloc.run(:body_buf, pool: self.pool, :vreg_start)
        self.pool.cs_high_water = regalloc.pack(pool: self.pool, :vreg_start)

        // Round the callee-saved count up to an even number of registers
        // (stp/ldp move pairs); the pad slot uses x28, which is never
        // pool-allocated, so saving/restoring it is a harmless no-op.
        mut cs = self.pool.cs_high_water
        if cs % 2 != 0 {
            cs = cs + 1
        }
        mut pi = 0
        for pi < cs {
            self.emit(f"stp {regalloc.cs_reg(pi)}, {regalloc.cs_reg(pi + 1)}, [sp, #-16]!")
            pi = pi + 2
        }
        // Sized only now: compiling the body allocates slots of its own (match subjects, chain operands).
        let raw_sz = self.frame_slots * 8
        let aligned = raw_sz + 16 - raw_sz % 16
        self.emit("stp fp, lr, [sp, #-16]!")
        self.emit("mov fp, sp")
        self.emit(f"sub sp, sp, #{aligned}")
        for line in body_buf {
            self.out_buf += [line]
        }
        mut qi = cs
        for qi > 0 {
            self.emit(f"ldp {regalloc.cs_reg(qi - 2)}, {regalloc.cs_reg(qi - 1)}, [sp], #16")
            qi = qi - 2
        }
        self.emit("ret")
        self.emit_symtab_entry(func_lbl, name: display_name, file: self.p.path, line: decl_line)
    }


    func compile_module(self, anon module: ast.Module) -> none {
        self.println("\t.text")
        self.entry_path = self.p.path
        let local_ifaces: int64 = len(self.interfaces)

        // Three-phase registration to handle struct ⇄ interface refs:
        // 1) interface names, 2) enums + structs, 3) interface method sigs.
        for decl in module.decls {
            self.register_interface(decl, prefix: self.path_prefix, p: self.p)
        }
        // Type aliases come before enum/struct registration so struct
        // fields and enum variant payload types can use them, and again
        // after it for aliases naming this module's own types.
        self.register_type_aliases(module, p: self.p)
        // Interleave enums and structs in source order: a later enum's
        // variant payload may reference an earlier struct (see ast.kod's
        // `Decl.Struct(... fields: [StructField] ...)`), and an earlier
        // struct's field/method sig can reference a later struct only
        // if that struct already exists as an import — which is fine.
        let local_structs: int64 = len(self.structs)
        let local_enums: int64 = len(self.enums)
        for decl in module.decls {
            self.register_enum(decl, prefix: self.path_prefix, p: self.p)
            self.register_struct(decl, prefix: self.path_prefix, p: self.p)
        }
        self.register_type_aliases(module, p: self.p)
        for decl in module.decls {
            self.resolve_interface_methods(decl, p: self.p)
        }
        // Self and forward references resolve once all local types are registered.
        self.resolve_field_kinds(start: local_structs)
        self.resolve_variant_field_kinds(start: local_enums)
        self.resolve_method_sigs(struct_start: local_structs, iface_start: local_ifaces)
        self.check_module_types(module)

        for decl in module.decls {
            let idx_m = self.func_idx
            match decl {
                .Func(decl_id) -> {
                    let func_decl = self.p.func_decls[decl_id]
                    idx_m.set(func_decl.name, len(self.func_names))
                    self.func_names += [func_decl.name]
                    self.func_labels += [f"${self.path_prefix}${func_decl.name}"]
                    self.func_sigs += [self.resolve_sig(decl_id, p: self.p)]
                    self.func_def_paths += [self.p.path]
                    self.func_def_spans += [func_decl.name_span]
                    self.func_docs += [func_decl.doc]
                }
                .Extern(name, name_span, params, return_typ) -> {
                    idx_m.set(name, len(self.func_names))
                    self.func_names += [name]
                    self.func_labels += [f"_{name}"]
                    self.func_sigs += [self.resolve_extern_sig(params, :return_typ, p: self.p)]
                    self.func_def_paths += [self.p.path]
                    self.func_def_spans += [name_span]
                    self.func_docs += [""]
                }
                else none
            }
        }

        // Lambdas — anonymous func expressions — were allocated into
        // `self.p.func_decls` with empty names. Synthesise a name
        // (`__lambda_N`) for each so they look like an ordinary
        // top-level function for registration + later compilation.
        // Has to run AFTER the named-function loop above so the
        // numeric idx into `func_names` doesn't collide with a real
        // function, and BEFORE the compile_func loop below so any
        // FuncLit reference in a function body resolves to the
        // registered label.
        mut lambda_decl_ids: [int64] = []
        mut li: int64 = 1
        for li < len(self.p.func_decls) {
            if len(self.p.func_decls[li].name) == 0 {
                let synthesized: str = f"__lambda_{len(lambda_decl_ids)}"
                self.p.func_decls[li].name = synthesized
                let idx_m = self.func_idx
                idx_m.set(synthesized, len(self.func_names))
                self.func_names += [synthesized]
                self.func_labels += [f"${self.path_prefix}${synthesized}"]
                self.func_sigs += [self.resolve_sig(li, p: self.p)]
                self.func_def_paths += [self.p.path]
                self.func_def_spans += [self.p.func_decls[li].name_span]
                self.func_docs += [""]
                lambda_decl_ids += [li]
            }
            li = li + 1
        }

        // Template fields have no kinds; instances check defaults when built.
        mut si = local_structs
        for si < len(self.structs) {
            let s = self.structs[si]
            if len(s.type_param_names) == 0 and s.template_idx < 0 {
                for field in s.fields {
                    if field.default_expr != 0 {
                        self.check_default(field.default_expr, expected: field.kind)
                    }
                }
            }
            si += 1
        }

        for decl in module.decls {
            match decl {
                .Func(decl_id) -> self.compile_func(fd_id: decl_id, struct_name: "", override_lbl: "")
                .Struct(name, _name_span, struct_type_params, fields, methods) -> {
                    // A generic template's methods only compile per instance.
                    if len(struct_type_params) == 0 {
                        for method_id in methods {
                            self.compile_func(fd_id: method_id, struct_name: name, override_lbl: "")
                        }
                    }
                }
                else none
            }
        }
        for ld_id in lambda_decl_ids {
            self.compile_func(fd_id: ld_id, struct_name: "", override_lbl: "")
        }

        // Compile any `test "..." { ... }` blocks. Each becomes a normal
        // function with a synthesized label `<prefix>$__test_N`, plus a
        // per-module dispatcher `<prefix>$__run_tests` that resets the
        // failure flag, calls each test, reports the outcome, and finally
        // prints a summary. The dispatcher is what `kod test` links its
        // runtime_main against.
        mut test_displays: [str] = []
        mut test_labels: [str] = []
        for decl in module.decls {
            if decl is .Test(display, test_decl_id) {
                let lbl: str = f"${self.path_prefix}$__test_{len(test_labels)}"
                self.in_test = true
                self.compile_func(fd_id: test_decl_id, struct_name: "", override_lbl: lbl)
                self.in_test = false
                test_displays += [display]
                test_labels += [lbl]
            }
        }
        if len(test_labels) > 0 {
            // Per-module dispatcher. Just runs this module's tests and
            // returns. The summary call is hoisted out into the runtime
            // _main so multiple modules' dispatchers can contribute to a
            // single aggregate result. A `kod_test_module_begin` call
            // at the top prints the module's source path so the test
            // runner's output reads as one group per file.
            let run_lbl: str = f"${self.path_prefix}$__run_tests"
            let path_lbl: str = self.intern_str(self.p.path)
            self.emit_globl(run_lbl)
            self.emit_label(run_lbl)
            self.emit("sub sp, sp, #16")
            self.emit("stp fp, lr, [sp]")
            self.emit("add fp, sp, #0")
            self.emit(f"adrp x0, {path_lbl}@PAGE")
            self.emit(f"add x0, x0, {path_lbl}@PAGEOFF")
            self.emit("bl _kod_test_module_begin")
            mut i: int64 = 0
            for i < len(test_labels) {
                let name_lbl: str = self.intern_str(test_displays[i])
                self.emit("bl _kod_test_reset")
                self.emit(f"bl {test_labels[i]}")
                self.emit(f"adrp x0, {name_lbl}@PAGE")
                self.emit(f"add x0, x0, {name_lbl}@PAGEOFF")
                self.emit("bl _kod_test_report")
                i = i + 1
            }
            self.emit("ldp fp, lr, [sp]")
            self.emit("add sp, sp, #16")
            self.emit("ret")
        }

        // Emit method bodies for every monomorphised struct instantiation
        // (e.g. Map[str, int64]). We walk the structs list with a cursor
        // that re-checks the length each step so any further instantiations
        // discovered while compiling a specialised body get picked up too.
        mut cursor = 0
        for cursor < len(self.structs) {
            mut s = self.structs[cursor]
            if s.template_idx >= 0 and self.has_bad_key(s) == false {
                let template = self.structs[s.template_idx]
                let saved_p = self.p
                let saved_names = self.subst_names
                let saved_args = self.subst_args
                self.p = s.src_p
                self.subst_names = template.type_param_names
                self.subst_args = s.template_args
                self.body_instance = cursor
                for m in s.methods {
                    self.compile_func(fd_id: m.decl_id, struct_name: s.name, override_lbl: "")
                }
                self.body_instance = -1
                self.p = saved_p
                self.subst_names = saved_names
                self.subst_args = saved_args
            }
            cursor = cursor + 1
        }
        let saved_instance = self.body_instance
        mut ci = 0
        for span in self.limit_call_spans {
            if regalloc.str_in(self.limit_kinds, p: self.limit_call_kinds[ci]) == false {
                self.body_instance = self.limit_call_insts[ci]
                self.report_error(self.limit_call_msgs[ci], :span)
            }
            ci += 1
        }
        self.body_instance = saved_instance

        if len(self.str_labels) > 0 or len(self.vtable_struct_idx) > 0 or len(self.prim_vtable_kinds) > 0 {
            self.println(".data")
            // Each `str` literal is a KodStr struct (`{ buf, len }`) plus
            // a byte buffer. The 8-aligned struct header is what the
            // label points at — adrp / add returns the struct pointer.
            mut i = 0
            for i < len(self.str_labels) {
                let lbl: str = self.str_labels[i]
                let value: str = self.str_values[i]
                self.println("\t.p2align 3")
                self.println(f"{lbl}:")
                self.println(f"\t.quad {lbl}$buf")
                self.println(f"\t.quad {len(value)}")
                self.println(f"{lbl}$buf:")
                self.emit_asciz(value)
                i = i + 1
            }
            self.emit_vtables()
        }
        // Tell the Mach-O linker that each labelled definition is its own
        // subsection — `ld -dead_strip` then drops any function/vtable
        // nothing reachable refers to. Without this directive, every .o
        // contributes its entire __text/__data wholesale.
        self.println(".subsections_via_symbols")
        self.flush_out()
    }

    // Emit one row per registered (struct, interface) pair. Methods are
    // listed in the order they appear in the interface declaration; for
    // each, look up the matching method on the struct and emit a .quad
    // pointing at its mangled label.
    func emit_vtables(self) -> none {
        mut i = 0
        for i < len(self.vtable_struct_idx) {
            let struct_idx = self.vtable_struct_idx[i]
            let iface_idx = self.vtable_iface_idx[i]
            let struct_info = self.structs[struct_idx]
            let iface_info = self.interfaces[iface_idx]
            let label = self.vtable_label(struct_idx, iface_idx)
            self.println("\t.p2align 3")
            // `is` compares vtable addresses, so all modules must share one copy.
            self.println(f"\t.globl {label}")
            self.println(f"\t.private_extern {label}")
            self.println(f"\t.weak_definition {label}")
            self.println(f"{label}:")
            for m in iface_info.methods {
                match struct_info.method_idx.get(m.name) {
                    Some(_mi) -> self.println(f"\t.quad ${struct_info.module_prefix}${struct_info.name}${m.name}")
                    none -> self.println(f"\t.quad 0")
                }
            }
            i = i + 1
        }
        // Primitive vtables: same layout, but methods come from the
        // primitive method table populated by register_primitive_module.
        mut pi = 0
        for pi < len(self.prim_vtable_kinds) {
            mut kind = self.prim_vtable_kinds[pi]
            let iface_idx = self.prim_vtable_iface_idx[pi]
            let iface_info = self.interfaces[iface_idx]
            self.println("\t.p2align 3")
            self.println(f"{self.prim_vtable_label(iface_idx, :kind)}:")
            for m in iface_info.methods {
                let pm_idx = self.find_prim_method(m.name, :kind)
                if pm_idx >= 0 {
                    self.println(f"\t.quad {self.prim_methods[pm_idx].label}")
                } else {
                    self.println(f"\t.quad 0")
                }
            }
            pi = pi + 1
        }
    }

    // Registers the builtins before compile_module and sets builtins_path.
    func register_module_funcs(self, anon module: ast.Module, prefix: str, p: parsing.Parser) -> none {
        self.builtins_path = p.path
        let idx_m = self.func_idx
        for decl in module.decls {
            match decl {
                .Func(decl_id) -> {
                    let func_decl = p.func_decls[decl_id]
                    idx_m.set(func_decl.name, len(self.func_names))
                    self.func_names += [func_decl.name]
                    self.func_labels += [f"${prefix}${func_decl.name}"]
                    self.func_sigs += [self.resolve_sig(decl_id, :p)]
                    self.func_def_paths += [p.path]
                    self.func_def_spans += [func_decl.name_span]
                    self.func_docs += [func_decl.doc]
                }
                .Extern(name, name_span, params, return_typ) -> {
                    idx_m.set(name, len(self.func_names))
                    self.func_names += [name]
                    self.func_labels += [f"_{name}"]
                    self.func_sigs += [self.resolve_extern_sig(params, :return_typ, :p)]
                    self.func_def_paths += [p.path]
                    self.func_def_spans += [name_span]
                    self.func_docs += [""]
                }
                else none
            }
        }
    }

    // Register every function in a primitive's module (e.g. stdlib/primitives/int64.kod)
    // as a method on that primitive `kind`. Method dispatch on a receiver
    // of this kind will look up `name` and emit `bl $prefix$name`.
    func register_primitive_module(self, anon module: ast.Module, kind: TypeKind, prefix: str, p: parsing.Parser) -> none {
        for decl in module.decls {
            match decl {
                .Func(decl_id) -> {
                    let func_decl = p.func_decls[decl_id]
                    let lbl = f"${prefix}${func_decl.name}"
                    let sig = self.resolve_sig(decl_id, :p)
                    self.prim_methods += [PrimMethodInfo(:kind, name: func_decl.name, label: lbl, :sig)]
                }
                else none
            }
        }
    }

    // Register selected items from an imported module into the local
    // namespace so they can be referenced without the module prefix.
    // For functions/externs this appends to func_names/func_labels/func_sigs.
    // Types (struct/enum) are already global-by-name, so they need no entry.
    func register_imported_items(self, anon items: [str], anon module: ast.Module, prefix: str, p: parsing.Parser) -> none {
        let idx_m = self.func_idx
        for want in items {
            for decl in module.decls {
                match decl {
                    .Func(decl_id) -> {
                        let func_decl = p.func_decls[decl_id]
                        if func_decl.name == want {
                            idx_m.set(func_decl.name, len(self.func_names))
                            self.func_names += [func_decl.name]
                            self.func_labels += [f"${prefix}${func_decl.name}"]
                            self.func_sigs += [self.resolve_sig(decl_id, :p)]
                            self.func_def_paths += [p.path]
                            self.func_def_spans += [func_decl.name_span]
                            self.func_docs += [func_decl.doc]
                        }
                    }
                    .Extern(name, name_span, params, return_typ) -> {
                        if name == want {
                            idx_m.set(name, len(self.func_names))
                            self.func_names += [name]
                            self.func_labels += [f"_{name}"]
                            self.func_sigs += [self.resolve_extern_sig(params, :return_typ, :p)]
                            self.func_def_paths += [p.path]
                            self.func_def_spans += [name_span]
                            self.func_docs += [""]
                        }
                    }
                    else none
                }
            }
        }
    }

    // Record an import alias only. Must run before any sig resolution
    // that might reference an enum or struct from this module, because
    // resolve_type's KEnum/KStruct lookup goes through self.struct_idx /
    // self.enum_idx, which are populated by register_module_types — not
    // by this. Call register_import_module_funcs in a second pass once
    // every imported module's types are registered.
    func register_import_module_alias(self, anon local_mod: str) -> none {
        self.import_local += [local_mod]
    }

    func note_entry_import(self, anon target: str) -> none {
        self.entry_import_paths += [target]
    }

    // Resolve and store sigs for each function / extern exported by
    // `module`. Run AFTER every imported module's types are registered
    // so a sig whose return type references an imported enum/struct
    // doesn't fall back to KInt64.
    func register_import_module_funcs(self, anon module: ast.Module, local_mod: str, prefix: str, p: parsing.Parser) -> none {
        for decl in module.decls {
            match decl {
                .Func(decl_id) -> {
                    let func_decl = p.func_decls[decl_id]
                    let sig = self.resolve_sig(decl_id, :p)
                    self.import_fns += [ImportFn(module: local_mod, name: func_decl.name, label: f"${prefix}${func_decl.name}", :sig, def_path: p.path, def_span: func_decl.name_span)]
                }
                .Extern(name, name_span, params, return_typ) -> {
                    let sig = self.resolve_extern_sig(params, :return_typ, :p)
                    self.import_fns += [ImportFn(module: local_mod, :name, label: f"_{name}", :sig, def_path: p.path, def_span: name_span)]
                }
                else none
            }
        }
    }

    // One-shot convenience for callers that don't need the two-step
    // ordering — used by code paths that register a module after the
    // full type registry already exists.
    func register_import_module(self, anon module: ast.Module, local_mod: str, prefix: str, p: parsing.Parser) -> none {
        self.register_import_module_alias(local_mod)
        self.register_import_module_funcs(module, :local_mod, :prefix, :p)
    }
}

// True if `c` (as a byte) is a Kod identifier char — used by
// report_error to widen the diagnostic span past the start of the
// offending token. Duplicates lexing.is_alnum so codegen doesn't have
// to import lexing just for one helper.
func ident_char(anon c: int64) -> bool {
    if c >= 'a' and c <= 'z' { return true }
    if c >= 'A' and c <= 'Z' { return true }
    if c >= '0' and c <= '9' { return true }
    if c == '_' { return true }
    return false
}

// What `kod test <dir>` gathers into one program.
func is_test_file(anon path: str) -> bool {
    return len(path) >= 9 and path[len(path) - 9..len(path)] == "_test.kod"
}

// A call's source, from its start through the closing bracket that ends its postfix chain.
func call_text(anon p: parsing.Parser, anon expr_id: int64) -> str {
    let source = p.source
    let start = p.expr_spans[expr_id].start
    mut depth = 0
    mut quote = 0
    mut i = start
    for i < len(source) and source[i] != '\n' {
        let c = source[i]
        if quote != 0 {
            if c == '\\' {
                i += 1
            } else if c == quote {
                quote = 0
            }
        } else if c == '"' or c == '\'' {
            quote = c
        } else if c == '(' or c == '[' {
            depth += 1
        } else if c == ')' or c == ']' {
            depth -= 1
            let next = i + 1
            if depth == 0 and (next >= len(source) or (source[next] != '.' and source[next] != '(' and source[next] != '[')) {
                return source[start..next]
            }
        }
        i += 1
    }
    return source[start..i]
}

func either_flow(anon a: Flow, anon b: Flow) -> Flow {
    return Flow(completes: a.completes or b.completes, breaks: a.breaks or b.breaks)
}

// Where `import "set"` loads from, as build.resolve_import spells it.
func set_module_path() -> str {
    return "stdlib/set.kod"
}

func make_codegen(p: parsing.Parser, path_prefix: str) -> Codegen {
    return Codegen(:p, :path_prefix)
}
