// Takes data in pieces; `finish` gives the digest of what it has seen so far.
type Hasher = struct {
    algo: Algo
    h: [int64]
    // The bytes of a block not yet full.
    pending: bytes
    total: int64

    func init(anon algo: Algo) -> Hasher {
        let h = match algo {
            .Sha256 -> H256
            .Sha384 -> H384
            .Sha512 -> H512
        }
        return Hasher(algo: algo, h: h, pending: b"", total: 0)
    }

    func update(mut self, anon data: bytes) -> none {
        let n = len(data)
        let block = self.algo.block_size()
        self.total += n
        mut at = 0
        if len(self.pending) > 0 {
            at = min(block - len(self.pending), n)
            self.pending = self.pending + data[..at]
            if len(self.pending) < block {
                return
            }
            self.compress(self.pending, at: 0, blocks: 1)
            self.pending = b""
        }
        let whole = (n - at) / block
        if whole > 0 {
            self.compress(data, at: at, blocks: whole)
            at += whole * block
        }
        if at < n {
            self.pending = data[at..]
        }
    }

    // The `blocks` whole blocks of `data` from `at`.
    func compress(mut self, anon data: bytes, at: int64, blocks: int64) -> none {
        if self.algo is .Sha256 {
            self.h = compress256(self.h, data, at: at, blocks: blocks)
        } else {
            self.h = compress512(self.h, data, at: at, blocks: blocks)
        }
    }

    // The digest of everything given to `update`; the hasher can go on.
    func finish(self) -> bytes {
        mut h = self
        let block = self.algo.block_size()
        // A 1 bit, zeros, and the length in bits, to end on a block boundary.
        let length_size = if block == 64 { 8 } else { 16 }
        mut pad = [0x80]
        for (len(self.pending) + len(pad) + length_size) % block != 0 {
            pad += [0]
        }
        let bits = self.total * 8
        for i in 0..length_size {
            let shift = (length_size - 1 - i) * 8
            pad += [if shift < 64 { (bits >> shift) & 255 } else { 0 }]
        }
        h.update(kod_bytes_from_array(pad))
        mut out: [int64] = []
        if self.algo is .Sha256 {
            for w in h.h {
                out += [w >> 24, (w >> 16) & 255, (w >> 8) & 255, w & 255]
            }
        } else {
            for w in h.h {
                for shift in 56..=0 step -8 {
                    out += [(w >> shift) & 255]
                }
            }
        }
        return kod_bytes_from_array(out[..self.algo.size()])
    }
}

func digest(anon algo: Algo, anon data: bytes) -> bytes {
    mut h = Hasher(algo)
    h.update(data)
    return h.finish()
}

func sha256(anon data: bytes) -> bytes {
    return digest(.Sha256, data)
}

func sha384(anon data: bytes) -> bytes {
    return digest(.Sha384, data)
}

func sha512(anon data: bytes) -> bytes {
    return digest(.Sha512, data)
}

// K256 as 32-bit little-endian words, made once.
mut K256_WORDS: bytes = k256_words()

func k256_words() -> bytes {
    mut out: [int64] = []
    for k in K256 {
        out += [k & 255, (k >> 8) & 255, (k >> 16) & 255, k >> 24]
    }
    return kod_bytes_from_array(out)
}

// The state after `blocks` 64-byte blocks of `data`, from `at`.
func compress256(anon state: [int64], anon data: bytes, at: int64, blocks: int64) -> [int64] {
    let ctx = unsafe.alloc(32 + 256)
    for i in 0..8 {
        unsafe.store32(ctx + 4 * i, state[i])
    }
    unsafe.copy_in(ctx + 32, K256_WORDS)
    let start = unsafe.data(data) + at
    for b in 0..blocks {
        kod_sha256_block(ctx, start + 64 * b)
    }
    let out = [unsafe.load32(ctx + 4 * i) & MASK32 for i in 0..8]
    unsafe.free(ctx)
    return out
}

// K512 as 64-bit little-endian words, made once.
mut K512_WORDS: bytes = k512_words()

func k512_words() -> bytes {
    mut out: [int64] = []
    for k in K512 {
        for shift in 0..8 {
            out += [(k >> (8 * shift)) & 255]
        }
    }
    return kod_bytes_from_array(out)
}

// The state after `blocks` 128-byte blocks of `data`, from `at`.
func compress512(anon state: [int64], anon data: bytes, at: int64, blocks: int64) -> [int64] {
    let ctx = unsafe.alloc(64 + 640)
    for i in 0..8 {
        unsafe.store64(ctx + 8 * i, state[i])
    }
    unsafe.copy_in(ctx + 64, K512_WORDS)
    let start = unsafe.data(data) + at
    for b in 0..blocks {
        kod_sha512_block(ctx, start + 128 * b)
    }
    let out = [unsafe.load64(ctx + 8 * i) for i in 0..8]
    unsafe.free(ctx)
    return out
}
