type Holder = shared struct {
    xs: [int64]
}

type Point = shared struct {
    x: int64
}

func total(anon xs: [int64]) -> int64 {
    mut sum = 0
    for x in xs {
        sum += x
    }
    return sum
}

func fill(anon n: int64, mut xs: [int64]) -> none {
    for i in 0..n {
        xs += [i]
    }
}

func main() -> int64 {
    // Assigning shares, changing copies.
    mut xs = [1, 2, 3]
    let a = xs
    xs[0] = 10
    xs += [4]
    print(f"{a} {xs}")

    // A field has its own array, both ways.
    let h = Holder(:xs)
    h.xs[1] = 20
    xs[2] = 30
    print(f"{h.xs} {xs}")

    // Elements are values too, at any depth.
    mut grid = [[0, 0], [0, 0]]
    let row = grid[0]
    mut copy = grid
    grid[0][1] = 5
    grid[1] += [7]
    print(f"{grid} {row} {copy}")
    copy[1][0] = 9
    print(f"{grid} {copy}")

    // Rows made by `*` are separate.
    mut rows = [[0] * 2] * 3
    rows[1][0] = 1
    print(rows)

    // A loop goes over the array as it was when it started.
    mut ys = [1, 2]
    for y in ys {
        ys += [y * 10]
        ys[0] = 0
    }
    print(ys)

    // A Map keeps the array it was given.
    mut m = Map[str, [int64]]()
    mut zs = [1]
    m.set("k", zs)
    zs += [2]
    print(f"{m.get("k")? or []} {zs}")

    // An array passed to a function can't change behind its back; a `mut`
    // parameter changes the caller's own.
    mut big: [int64] = []
    fill(5, xs: mut big)
    let before = big
    fill(2, xs: mut big)
    print(f"{total(before)} {total(big)} {len(before)} {len(big)}")

    // A loop that keeps the array each time round keeps each version.
    mut counts = [0, 0, 0]
    mut versions: [[int64]] = []
    for i in 0..3 {
        counts[i] = i + 1
        let now = counts
        versions += [now]
    }
    print(versions)
    mut marks = [false] * 4
    for k in 0..4 {
        marks[k] = true
    }
    print(marks)

    // A loop reading a field's array, while it changes other fields.
    let hold = Holder(xs: [3, 1, 4, 1, 5])
    let scan = Point(x: 0)
    mut at = 0
    for at < len(hold.xs) and hold.xs[at] != 4 {
        scan.x += hold.xs[at]
        at += 1
    }
    print(f"{at} {scan.x}")

    // Structs stay references: an array of them holds the same structs.
    let p = Point(x: 1)
    let ps = [p]
    p.x = 2
    print(ps[0].x)
    return 0
}

// expected output:
// [1, 2, 3] [10, 2, 3, 4]
// [10, 20, 3, 4] [10, 2, 30, 4]
// [[0, 5], [0, 0, 7]] [0, 0] [[0, 0], [0, 0]]
// [[0, 5], [0, 0, 7]] [[0, 0], [9, 0]]
// [[0, 0], [1, 0], [0, 0]]
// [0, 2, 10, 20]
// [1] [1, 2]
// 10 11 5 7
// [[1, 0, 0], [1, 2, 0], [1, 2, 3]]
// [true, true, true, true]
// 2 4
// 2
