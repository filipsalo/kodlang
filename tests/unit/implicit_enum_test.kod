type Direction = enum {
	North
	South
	East
	West
}

func classify(anon d: Direction) -> Direction {
	match d {
		.North -> return .South
		.South -> return .North
		.East -> return .West
		.West -> return .East
	}
	return .North
}

test "a context-free variant takes the enum from where it goes" {
	let d: Direction = .North
	assert d == .North

	let d2: Direction = classify(.East)
	assert d2 == .West
}
