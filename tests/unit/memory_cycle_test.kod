// A cycle keeps itself alive: what reference counting can't reclaim.
extern func rc_live_bytes() -> int64

type Node = shared struct {
    name: str
    other: Node?
}

func pair() -> none {
    let a = Node(name: "a" + "!", other: none)
    let b = Node(name: "b" + "!", other: a)
    a.other = b
}

func broken_pair() -> none {
    let a = Node(name: "a" + "!", other: none)
    let b = Node(name: "b" + "!", other: a)
    a.other = b
    a.other = none
}

type Weakly = shared struct {
    name: str
    other: Weakly?
    weak back: Weakly?
}

// The back reference is weak, so no cycle forms.
func weak_pair() -> none {
    let a = Weakly(name: "a" + "!", other: none)
    let b = Weakly(name: "b" + "!", other: a)
    a.back = b
}

func chain() -> none {
    let a = Node(name: "a" + "!", other: none)
    let _b = Node(name: "b" + "!", other: a)
}

func grows(anon f: func() -> none) -> bool {
    f()
    let start = rc_live_bytes()
    for _ in 0..1000 {
        f()
    }
    return (rc_live_bytes() - start) / 1000 > 0
}

test "a chain without a cycle is freed" {
    assert not grows(chain)
}

test "a cycle once broken is freed" {
    assert not grows(broken_pair)
}

test "a cycle keeps itself alive" {
    assert grows(pair)
}

test "a weak back reference forms no cycle" {
    assert not grows(weak_pair)
}
