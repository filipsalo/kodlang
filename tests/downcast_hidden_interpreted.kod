// The interpreter reports a downcast through a module name a local hides.
import "./downcast_qualified_dep"

func f(anon e: Error) -> str {
    let downcast_qualified_dep = 3
    if e is downcast_qualified_dep.NotFound(nf) {
        return nf.key
    }
    return f"{downcast_qualified_dep}"
}

func main() -> int64 {
    print(f(downcast_qualified_dep.failure("q")))
    return 0
}

// expected status:
// 1
// expected stderr:
// 6:8: error: `downcast_qualified_dep` is a local here, so `downcast_qualified_dep.NotFound` doesn't name a type of its module; give the local another name
// expected mode:
// interpret
