// `xs += [x]` appends in place without building a one-element array; the
// element converts to the array's element type as it would in the literal.
interface Shape {
    func area(self) -> int64
}

type Sq = shared struct {
    s: int64
    func area(self) -> int64 {
        return self.s * self.s
    }
}

type Op = enum {
    Nop
    Mov(dst: str, src: str)
    Add(a: int64, b: int64)
}

func op_text(anon op: Op) -> str {
    match op {
        .Nop -> return "nop"
        .Mov(dst, src) -> return f"mov {dst}, {src}"
        .Add(a, b) -> return f"add {a + b}"
    }
}

type Bag = shared struct {
    items: [str] = []
}

test "push grows the array and leaves an alias alone" {
    mut xs: [int64] = []
    let alias = xs
    for i in 0..100 {
        xs += [i * i]
    }
    assert len(xs) == 100
    assert xs[99] == 9801
    assert len(alias) == 0

    mut names: [str] = []
    for i in 0..1000 {
        names += [f"n{i}"]
    }
    assert names[999] == "n999"
}

test "the element converts to the array's element type" {
    mut opts: [int64?] = []
    opts += [5]
    opts += [none]
    assert (opts[0]? or -1) == 5
    assert opts[1] is none

    mut shapes: [Shape] = []
    shapes += [Sq(s: 3)]
    assert shapes[0].area() == 9

    mut mixed: [int64 | str] = []
    mixed += [7]
    mixed += ["seven"]
    assert f"{mixed[0]} {mixed[1]}" == "7 seven"

    mut grid: [[Shape]] = []
    grid += [[Sq(s: 2), Sq(s: 4)]]
    assert grid[0][1].area() == 16
}

test "push to a field and to an element" {
    let bag = Bag()
    for w in ["a", "b", "c"] {
        bag.items += [w + w]
    }
    assert bag.items == ["aa", "bb", "cc"]

    mut rows: [[int64]] = [[1], [2, 3]]
    rows[0] += [4]
    rows += [[5, 6]]
    assert len(rows) == 3
    assert rows[0][1] == 4
    assert rows[2][1] == 6
}

test "push enum variants" {
    mut ops: [Op] = []
    let ops_alias = ops
    for i in 0..3 {
        ops += [.Mov(dst: f"x{i}", src: "x9")]
    }
    ops += [.Nop]
    ops += [Op.Add(a: 2, b: 3)]
    mut texts: [str] = []
    for op in ops {
        texts += [op_text(op)]
    }
    assert texts == ["mov x0, x9", "mov x1, x9", "mov x2, x9", "nop", "add 5"]
    assert len(ops_alias) == 0
}
