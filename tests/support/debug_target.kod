// A program for tests/debug_info_test.kod to debug. The test names lines of
// this file by number: keep them where they are.

type Counter = struct {
    n: int64

    func bump(mut self, by: int64) -> none {
        self.n += by
    }
}

func triple(anon x: int64) -> int64 {
    let y = x * 3
    return y
}

func main() -> int64 {
    mut c = Counter(n: 1)
    c.bump(by: triple(2))
    print(f"{c.n}")
    return 0
}
