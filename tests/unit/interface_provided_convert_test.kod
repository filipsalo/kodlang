// Converting an interface value to one with provided methods.

interface Counter {
    func next(self) -> int64

    func sum(self, anon n: int64) -> int64 {
        mut total = 0
        for _ in 0..n {
            total += self.next()
        }
        return total
    }
}

// No `sum`: a Ticker converted to a Counter gets Counter's.
interface Ticker {
    func next(self) -> int64
    func name(self) -> str
}

// Provides a `sum` of its own.
interface Summer {
    func next(self) -> int64

    func sum(self, anon n: int64) -> int64 {
        return -self.next() * n
    }
}

type Steps = shared struct {
    by: int64
    at: int64 = 0

    func next(self) -> int64 {
        self.at += self.by
        return self.at
    }

    func name(self) -> str {
        return "steps"
    }
}

// Declares its own `sum`: a Counter made from a Ticker holding one must use it.
type Doubler = shared struct {
    at: int64 = 0

    func next(self) -> int64 {
        self.at += 2
        return self.at
    }

    func name(self) -> str {
        return "doubler"
    }

    func sum(self, anon n: int64) -> int64 {
        return 1000 * n
    }
}

// A `sum` of another type isn't Counter's: it doesn't stand in for it.
type Odd = shared struct {
    func next(self) -> int64 {
        return 7
    }

    func name(self) -> str {
        return "odd"
    }

    func sum(self, anon label: str) -> int64 {
        return len(label)
    }
}

// Two interfaces a str gets through its own methods.
interface Hashed {
    func hash(self) -> int64
}

interface Shown {
    func hash(self) -> int64

    func to_str(self) -> str {
        return "provided"
    }
}

func as_counter(anon t: Ticker) -> Counter {
    return t
}

test "a converted value gets the target's provided methods" {
    let t: Ticker = Steps(by: 1)
    let c: Counter = t
    assert c.sum(3) == 6                    // 1 + 2 + 3
    assert as_counter(Steps(by: 5)).sum(2) == 15

    // Counter's `sum` came with the conversion, so it becomes Summer's.
    let flipped: Summer = c
    assert flipped.sum(2) == -8             // -4 * 2

    // A Counter made from Steps itself keeps Counter's `sum`.
    let direct: Counter = Steps(by: 1)
    let kept: Summer = direct
    assert kept.sum(2) == 3                 // 1 + 2

    let counters: [Counter] = [t, direct]
    mut sums: [int64] = []
    for each in counters {
        sums += [each.sum(1)]
    }
    assert sums == [5, 3]
}

test "the type's own method, found through the conversion" {
    let dt: Ticker = Doubler()
    let dc: Counter = dt
    assert dc.sum(3) == 3000
    let ds: Summer = dc
    assert ds.sum(2) == 2000
    let ot: Ticker = Odd()
    let oc: Counter = ot
    assert oc.sum(2) == 14
}

test "a primitive's own method wins over a provided one" {
    let h: Hashed = "text"
    let shown: Shown = h
    assert shown.to_str() == "text"
}
