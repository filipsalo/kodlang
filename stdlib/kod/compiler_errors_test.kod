test "a constructor field or payload must have its declared type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Foo = struct {
            name: str
            x: int64 = 0
        }
        type Msg = enum {
            Text(content: str)
            Move(x: int64, y: int64)
            Quit
        }
        type Either[L, R] = enum {
            Left(value: L)
            Right(value: R)
        }
        func main() -> int64 {
            let a = Foo(name: 5)
            let b = Foo(name: "a", x: 1, x: 2)
            let m: Msg = .Text(content: 5)
            let n = Msg.Move(x: "a", y: 1)
            let e = Either.Left(value: 1)
            return 0
        }
        """)
    assert len(errs) == 5
    assert errs[0].message == "error: expected `str`, got `int64`"
    assert errs[0].line == 15
    assert errs[1].message == "error: field `x` is given twice"
    assert errs[1].col == 34
    assert errs[2].message == "error: expected `str`, got `int64`"
    assert errs[2].line == 17
    assert errs[3].message == "error: expected `int64`, got `str`"
    assert errs[3].line == 18
    assert errs[4].message == "error: cannot infer the type of `e`; add a type annotation"
}

