// A local named like an import alias is the local from its declaration on:
// `name.f()` calls its method there, and the module's function elsewhere.
import "./alias_local_dep"

type Thing = struct {
    n: int64

    func value(self) -> int64 {
        return self.n
    }

    func die(self) -> none {
        print("thing die")
    }
}

func dep_value() -> int64 {
    return alias_local_dep.value()
}

func shadowed(anon n: int64) -> int64 {
    let alias_local_dep = Thing(n: n)
    alias_local_dep.die()
    return alias_local_dep.value()
}

func param(anon alias_local_dep: Thing) -> int64 {
    return alias_local_dep.value() + 10
}

func from_module() -> int64 {
    let alias_local_dep = alias_local_dep.make(4)
    return alias_local_dep.value()
}

func from_ctor() -> int64 {
    let alias_local_dep = alias_local_dep.Box(n: 5)
    return alias_local_dep.value()
}

func before(anon n: int64) -> int64 {
    let v: alias_local_dep.Box = alias_local_dep.make(n)
    let first = alias_local_dep.value()
    let alias_local_dep = Thing(n: n)
    return first + v.value() + alias_local_dep.value()
}

func in_block(anon flag: bool) -> int64 {
    if flag {
        let alias_local_dep = Thing(n: 5)
        return alias_local_dep.value()
    }
    return alias_local_dep.value()
}

func main() -> int64 {
    print_int(dep_value())
    print_int(shadowed(2))
    print_int(param(Thing(n: 3)))
    print_int(from_module())
    print_int(from_ctor())
    print_int(before(7))
    print_int(in_block(true))
    print_int(in_block(false))
    for i in [1, 2] {
        let alias_local_dep = alias_local_dep.make(i)
        print_int(alias_local_dep.value())
    }
    return 0
}

// expected output:
// 1
// thing die
// 2
// 13
// 40
// 5
// 78
// 5
// 1
// 10
// 20
