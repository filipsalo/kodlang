import "kod/inspect"
import "kod/profiling"

func spin(anon n: int64) -> int64 {
    mut x = 0
    for i in 0..n {
        x = (x * 31 + i) % 1000003
    }
    return x
}

test "a busy loop is sampled where it runs" {
    profiling.start(interval_us: 500)
    mut sum = 0
    for _ in 0..60 {
        sum += spin(200000)
    }
    profiling.stop()
    assert sum >= 0
    let n = profiling.n_samples()
    assert n > 5
    // Stopped: no more come in.
    spin(2000000)
    assert profiling.n_samples() == n
    // Where it was is in this program's code, a function inspect can name
    // (spin may well be inlined into the test).
    mut named = 0
    for i in 0..n {
        assert profiling.depth(i) >= 2
        if inspect.resolve(addr: profiling.frame(i, at: 0)) is Some(_) {
            named += 1
        }
    }
    assert named * 2 > n
    assert profiling.frame(n, at: 0) == 0
    assert profiling.depth(-1) == 0
}

test "start empties what an earlier run captured" {
    profiling.start(interval_us: 500)
    spin(4000000)
    profiling.stop()
    profiling.start(interval_us: 1000000)
    profiling.stop()
    assert profiling.n_samples() == 0
}
