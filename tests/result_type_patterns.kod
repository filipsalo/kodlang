// Type patterns on a `T or Error` test the success value; `Error(e)` is `Err(e)`.

type NotFound = struct {
    path: str

    func to_str(self) -> str {
        return f"missing {self.path}"
    }
}

interface Shape {
    func area(self) -> int64
}

type Sq = struct {
    side: int64

    func area(self) -> int64 {
        return self.side * self.side
    }
}

type Id = int64 | str

func parse(anon s: str) -> int64 | str | bool or Error {
    if s == "" {
        throw NotFound(path: "empty")
    }
    if s == "yes" {
        return true
    }
    if s[0] >= '0' and s[0] <= '9' {
        return s.parse_int()? or 0
    }
    return s
}

func describe(anon s: str) -> str {
    match parse(s) {
        int64(n) -> return f"int {n}"
        str(t) -> return f"str {t}"
        bool(b) -> return f"bool {b}"
        Error(e) -> return f"error {e.to_str()}"
    }
}

func ids(anon s: str) -> str {
    match parse(s) {
        Id(id) -> return f"id {id}"
        Err(NotFound(nf)) -> return f"not found {nf.path}"
        else -> return "other"
    }
}

func shape(anon n: int64) -> Shape or Error {
    if n < 0 {
        throw NotFound(path: "shape")
    }
    return Sq(side: n)
}

func maybe(anon n: int64) -> int64? or Error {
    if n < 0 {
        throw NotFound(path: "maybe")
    }
    if n == 0 {
        return none
    }
    return n
}

func generic_ok[T](anon r: T or Error) -> bool {
    return r is T(_t)
}

func main() -> int64 {
    print(describe("42"))
    print(describe("abc"))
    print(describe("yes"))
    print(describe(""))
    print(ids("7"))
    print(ids("x"))
    print(ids("yes"))
    print(ids(""))

    match shape(3) {
        Sq(sq) -> print(f"square {sq.side}")
        Shape(other) -> print(f"shape {other.area()}")
        Error(e) -> print(e.to_str())
    }
    if shape(-1) is Error(e) {
        print(e.to_str())
    }

    match maybe(0) {
        none -> print("none")
        int64(n) -> print(f"int {n}")
        Err(e) -> print(e.to_str())
    }
    let m = maybe(5)
    if m is int64(n) {
        print(f"int {n}")
    }

    print(generic_ok(parse("1")))
    print(generic_ok(parse("")))
    print(parse("q") is str)
    print(parse("") is str)

    let r = parse("9")
    if r is Error(e) {
        print(e.to_str())
        return 1
    }
    if r is int64(n) {
        print(n + 1)
    }
    return 0
}

// expected output:
// int 42
// str abc
// bool true
// error missing empty
// id 7
// id x
// other
// not found empty
// square 3
// missing shape
// none
// int 5
// true
// false
// true
// false
// 10
