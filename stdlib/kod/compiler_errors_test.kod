    assert test_support.any_message_contains(errs, needle: "unknown type `Nope`")
}

test "operators don't take optional operands" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let seen = Map[str, bool]()
            seen.set("a", true)
            if seen.get("a") == true {
                print("seen")
            }
            let ob: bool? = true
            if ob != false {
                print("ne")
            }
            let flag = true
            let oi: int64? = 1
            if flag == oi {
                print("x")
            }
            let n: int64? = 3
            if n == 3 {
                print("three")
            }
            let m = n + 1
            if n < 4 {
                print("lt")
            }
            if n == none or none != n {
                print("none")
            }
            if n? == 3 and (n? or 0) + 1 == 4 {
                print("ok")
            }
            return 0
        }
        """)
    assert len(errs) == 6
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool?` with `bool`; unwrap it first with `?` or `? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool?` with `bool`; unwrap it first with `ob?` or `ob? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool` with `int64?`; unwrap it first with `oi?` or `oi? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot compare `int64?` with `int64`; unwrap it first with `n?` or `n? or default`")
    assert test_support.any_message_contains(errs, needle: "`+` doesn't take an optional operand; unwrap it first with `n?` or `n? or default`")
    assert test_support.any_message_contains(errs, needle: "`<` doesn't take an optional operand; unwrap it first with `n?` or `n? or default`")
}

test "an optional in a comparison chain gets the unwrap hint of a value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let m = Map[str, int64]()
            if 0 < m.get("a") < 5 {
                print("a")
            }
            if m.get("b") < 5 < 9 {
                print("b")
            }
            return 0
        }
        """)
    assert len(errs) == 2
    assert errs[0].message == "error: `<` doesn't take an optional operand; unwrap it first with `?` or `? or default`"
    assert errs[0].line == 3
    assert errs[1].message == "error: `<` doesn't take an optional operand; unwrap it first with `?` or `? or default`"
    assert errs[1].line == 6
}

test "a value of unknown type doesn't cascade wherever it's used" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct {
            x: int64
            func get(self) -> int64 { return self.x }
        }
        interface Shower {
            func show(self) -> str
        }
        func take(anon s: str) -> none {
            print(s)
        }
        func takei(anon s: Shower) -> none {
            print(s.show())
        }
        func main() -> int64 {
            let b = Box(x: 1)
            mut w = b.nope()
            let z0 = w + 1
            let z1 = 1 + w.x
            let z2 = [w, w]
            print(f"{w + 1}")
            w.x = 5
            print_int(len(w))
            let z4 = w?.x
            let z5 = w?.m(1)
            let z6 = w(1)
            let z8 = match w {
                1 -> 2
                else -> 3
            }
            if w is none {
                print("none")
            }
            let .Some(r) = w else { return 1 }
            print_int(r.x)
            for q in w {
                print(q.name)
            }
            let s = w[1..2]
            w[0] = 1
            take(w)
            takei(w)
            let z9: int64? = w
            let z10: Shower = w
            if w == true and w {
                print("t")
            }
            let z12 = w? or 0
            let z13 = w.get()
            let z14 = w.x.y.z
            let z20 = hash(w)
            let z21 = [1, 2][w]
            w += 1
            return w
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown method `nope` on `b`")
}

test "a parameter of unknown type doesn't cascade" {
