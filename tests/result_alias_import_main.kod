// main and helpers declared with an imported alias of `T or Error`.
import "./result_alias_dep"

func half(anon n: int64) -> result_alias_dep.Later {
    if n % 2 != 0 {
        throw result_alias_dep.Oops(message: f"{n} is odd")
    }
    return n / 2
}

func main() -> result_alias_dep.Outcome {
    let a = try half(4)
    print(f"half {a}")
    if half(3) is Err(e) {
        print(f"caught {e.to_str()}")
    }
    let b = try half(5)
    print(f"half {b}")
    return 0
}

// expected output:
// half 2
// caught 3 is odd
// expected status:
// 1
// expected stderr:
// panic: 5 is odd
