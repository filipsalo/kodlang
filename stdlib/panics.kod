// Catching a panic (docs/panics.md). The catch itself, and giving up what the
// abandoned functions hold, are in runtime.c (kod_catch, kod_unwind).

import "unsafe"

extern func kod_catch(anon fn: int64) -> int64
extern func kod_caught_message() -> str
extern func kod_caught_backtrace() -> str
extern func kod_catch_here() -> int64
extern func kod_panic_again(anon message: str, anon backtrace: str, anon target: int64) -> none

// A panic that was caught.
type Panic = struct {
    // What follows `panic: `.
    message: str
    // What would have been printed after it, `backtrace:` first.
    backtrace: str

    func to_str(self) -> str {
        return f"panic: {self.message}"
    }
}

// What _call is to run: run puts it here for kod_catch, whose C code calls it
// back at once. No other task runs in between: this module's functions aren't
// preempted (codegen, emit_poll).
mut _body: [func() -> none] = []

// Calls `body`: the panic that stopped it, or none.
func run(anon body: func() -> none) -> Panic? {
    _body = [body]
    if kod_catch(unsafe.c_function(_call)) == 0 {
        return none
    }
    return Panic(message: kod_caught_message(), backtrace: kod_caught_backtrace())
}

func _call() -> none {
    let body = _body[0]
    _body = []
    body()
}

// Calls `body`: what it gave back, or the Panic that stopped it.
func catch[T](anon body: func() -> T or Error) -> T or Error {
    mut results: [T or Error] = []
    if run(func() { results = [body()] }) is Panic(p) {
        throw p
    }
    return results[0]
}

// Panics with the message and the backtrace of `p`.
func again(anon p: Panic) -> none {
    again_at(p, catch: 0)
    panic("a panic came back")
}

// For tasks.kod: the innermost catch, 0 when there is none; and a panic that
// goes on to the catch `here` gave, past those inside it.
func here() -> int64 {
    return kod_catch_here()
}

func again_at(anon p: Panic, catch: int64) -> none {
    kod_panic_again(p.message, p.backtrace, catch)
}
