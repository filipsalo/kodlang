            let a: int64? = 3
            let sh: Shape = Sq(s: 1)
            let xs = [a, "s"]
            let cs = [Color.Red, 5]
            let ys = [sh, Color.Red]
            for q in [a, "t"] {
                print_int(q? or 0)
            }
            return 0
        }
