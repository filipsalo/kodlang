// `Err(e)` on an explicit `Result[T, E]` binds an `E`.
type Oops = shared struct {
    code: int64
}

test "Err binds a str error" {
    let r: Result[int64, str] = .Err(error: "bad")
    match r {
        Ok(v) -> fail("ok")
        Err(e) -> assert e + "!" == "bad!"
    }
    if r is Err(e2) {
        assert e2 + "?" == "bad?"
    } else {
        fail("not Err")
    }
    let s = match r {
        Ok(v) -> "ok"
        Err(e3) -> e3
    }
    assert s == "bad"
}

test "Err binds a struct error" {
    let q: Result[int64, Oops] = .Err(error: Oops(code: 7))
    match q {
        Ok(v) -> fail("ok")
        Err(o) -> assert o.code == 7
    }
}
