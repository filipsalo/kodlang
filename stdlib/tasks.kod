// kod:cc tasks.c

// Tasks: calls that run on stacks of their own and take turns on the one
// thread (docs/tasks.md). The stacks and the switch are in tasks.c; which
// task runs next is decided here.

import "stream" { IoError }
import "time" { Duration }

extern func kod_task_stack_new() -> int64
extern func kod_task_stack_free(anon base: int64) -> none
extern func kod_task_ctx_new() -> int64
extern func kod_task_ctx_free(anon ctx: int64) -> none
extern func kod_task_ctx_init(anon ctx: int64, anon base: int64) -> none
extern func kod_task_switch(anon from: int64, anon to: int64) -> none
extern func kod_task_kq_add(anon ident: int64, anon filter: int64, anon data: int64, anon key: int64) -> int64
extern func kod_task_kq_wait(anon block: int64) -> int64
extern func kod_task_kq_key(anon i: int64) -> int64
extern func kod_task_hook() -> none

// What a task runs: its Task, whatever its result's type.
interface Job {
    func run(self) -> none
}

// A task as the scheduler sees it: its saved registers, its stack (0 for the
// program's first one, which has the thread's own), what it runs, and the
// tasks waiting for it to end.
type Fiber = shared struct {
    ctx: int64
    stack: int64 = 0
    job: Job? = none
    done: bool = false
    waiters: [Fiber] = []
    // In the ready queue: made ready again, it isn't queued twice. A task woken
    // for nothing (a channel's list can name one that has gone on) finds what
    // it waits for not there yet and waits again: every wait is a loop.
    queued: bool = false
    // Cancelled (wait_group): its waits for I/O give `.Cancelled`, its sleeps
    // and channel waits give up.
    cancelled: bool = false
    // The key of the kevent registration it waits on, 0 for none.
    io_key: int64 = 0
}

// The task that is running, made for the program's first one when first
// asked for.
mut _current: Fiber? = none

// Tasks ready to run, from `_head` on, in the order they became ready.
mut _ready: [Fiber] = []
mut _head: int64 = 0

// Tasks that have ended, whose stacks the next task to run frees.
mut _dead: [Fiber] = []

// Tasks that haven't ended, the program's first one included: while it is the
// only one, a call that would block just blocks (_wait_event).
mut _live: int64 = 1
mut _hooked: bool = false

// Tasks waiting for a kevent event, by the key their registration carries.
mut _io: Map[int64, Fiber] = Map[int64, Fiber]()
mut _io_next: int64 = 0

// The registers of the switch a task that ends makes: no reference stays in
// its frame, which never returns.
mut _leave_from: int64 = 0
mut _leave_to: int64 = 0

// A task started by `start`, and what it gave back once it has ended.
type Task[T] = shared struct {
    fiber: Fiber
    body: func() -> T
    // Empty until the task ends; then what it gave back.
    results: [T] = []

    func run(self) -> none {
        self.results = [self.body()]
    }

    // What the task gave back; until it has ended, this task waits for it.
    func wait(self) -> T {
        _wait_for(self.fiber)
        return self.results[0]
    }
}

// Runs `body` as a new task, which first runs the next time this one waits
// or gives way. `spawn` calls it with the group of the function it is in
// (none for `spawn detached`).
func start[T](anon body: func() -> T, group: TaskGroup? = none) -> Task[T] {
    let fiber = _new_fiber()
    let task = Task[T](:fiber, :body)
    fiber.job = task
    _join(fiber, :group)
    _make_ready(fiber)
    return task
}

// A task started by `start_none`, whose body gives back nothing (`none` can't
// be a type argument, so it isn't a `Task[none]`).
type NoneTask = shared struct {
    fiber: Fiber
    body: func() -> none

    func run(self) -> none {
        self.body()
    }

    // Until the task has ended, this task waits for it.
    func wait(self) -> none {
        _wait_for(self.fiber)
    }
}

// As `start`, for a body that gives back nothing.
func start_none(anon body: func() -> none, group: TaskGroup? = none) -> NoneTask {
    let fiber = _new_fiber()
    let task = NoneTask(:fiber, :body)
    fiber.job = task
    _join(fiber, :group)
    _make_ready(fiber)
    return task
}

// The tasks a function has started with `spawn`: codegen keeps the group in a
// hidden local (`#group`), made by the first `spawn` that runs, and waits for
// it where the function returns.
type TaskGroup = shared struct {
    fibers: [Fiber] = []
}

// `group`, or a new one when there is none yet. Optional both ways, as the
// hidden local that holds it is, which is none until the first `spawn` runs.
func group_of(anon group: TaskGroup?) -> TaskGroup? {
    if group is none {
        return TaskGroup()
    }
    return group
}

// Waits for each task in `group` that hasn't ended, cancelling them first when
// `cancel` (codegen: when the function returns an error).
func wait_group(anon group: TaskGroup?, anon cancel: bool) -> none {
    let g = group? or TaskGroup()
    if cancel {
        for fiber in g.fibers {
            _cancel(fiber)
        }
    }
    for fiber in g.fibers {
        _wait_for(fiber)
    }
    g.fibers = []
}

// Marks `fiber` cancelled and wakes it if it waits, forgetting the event it
// waited for.
func _cancel(anon fiber: Fiber) -> none {
    if fiber.done or fiber.cancelled {
        return
    }
    fiber.cancelled = true
    if fiber.io_key != 0 {
        let _gone = _io.remove(fiber.io_key)
        fiber.io_key = 0
    }
    _make_ready(fiber)
}

func _join(anon fiber: Fiber, group: TaskGroup?) -> none {
    if group is TaskGroup(g) {
        g.fibers += [fiber]
    }
}

// Lets the tasks that are ready run, then goes on.
func give_way() -> none {
    // Tasks whose event has come are ready too, so I/O doesn't wait for a busy task.
    if _io.len() > 0 {
        _poll(false)
    }
    if _head == len(_ready) {
        return
    }
    let me = _running()
    _make_ready(me)
    _switch_from(me)
}

func _new_fiber() -> Fiber {
    if not _hooked {
        kod_task_hook()
        _hooked = true
    }
    _live += 1
    let stack = kod_task_stack_new()
    if stack == 0 {
        panic("tasks: no room for another task's stack")
    }
    let fiber = Fiber(ctx: kod_task_ctx_new(), :stack)
    kod_task_ctx_init(fiber.ctx, stack)
    return fiber
}

func _running() -> Fiber {
    if _current is none {
        _current = Fiber(ctx: kod_task_ctx_new())
    }
    return must _current
}

func _make_ready(anon fiber: Fiber) -> none {
    if fiber.queued or fiber.done {
        return
    }
    fiber.queued = true
    _ready += [fiber]
}

// The next ready task, taken off the queue. While there is none, it waits for
// the events tasks wait for; with none of those either, every task waits for
// another, and none can go on.
func _take_next() -> Fiber {
    for _head == len(_ready) {
        if _io.len() == 0 {
            panic("all tasks are asleep: deadlock")
        }
        _poll(true)
    }
    let next = _ready[_head]
    next.queued = false
    _head += 1
    // Drop what has been taken once it is most of the queue.
    if _head >= 64 and _head * 2 >= len(_ready) {
        _ready = _ready[_head..len(_ready)]
        _head = 0
    }
    return next
}

// Switches from `me`, the running task, to the next ready one, and comes
// back here when `me` runs again.
func _switch_from(anon me: Fiber) -> none {
    let next = _take_next()
    _current = next
    kod_task_switch(me.ctx, next.ctx)
    _reap()
}

// Frees the stacks of tasks that have ended; none of them is running.
func _reap() -> none {
    if len(_dead) == 0 {
        return
    }
    for fiber in _dead {
        kod_task_stack_free(fiber.stack)
        kod_task_ctx_free(fiber.ctx)
    }
    _dead = []
}

// Waits, as the running task, for `fiber` to end.
func _wait_for(anon fiber: Fiber) -> none {
    for not fiber.done {
        let me = _running()
        fiber.waiters += [me]
        _switch_from(me)
    }
}

// A new task's first turn (tasks.c calls it on the task's stack): runs it,
// readies those waiting for it, and switches away for good.
func _run_current() -> none {
    _reap()
    _finish()
    kod_task_switch(_leave_from, _leave_to)
}

func _finish() -> none {
    let fiber = must _current
    let job = must fiber.job
    // The Task holds the Fiber; the Fiber lets go of the Task, so neither
    // keeps the other.
    fiber.job = none
    job.run()
    _live -= 1
    fiber.done = true
    for waiter in fiber.waiters {
        _make_ready(waiter)
    }
    fiber.waiters = []
    _dead += [fiber]
    let next = _take_next()
    _current = next
    _leave_from = fiber.ctx
    _leave_to = next.ctx
}

// Carries values from tasks that send to tasks that receive, in order
// (docs/tasks.md). A sender adds its value and then waits until at most
// `capacity` of the values sent up to its own are still to be received: with
// 0, until its own is.
type Channel[T] = shared struct {
    capacity: int64 = 0
    // Sent and not received: `items` from `head` on.
    items: [T] = []
    head: int64 = 0
    sent: int64 = 0
    taken: int64 = 0
    closed: bool = false
    // Tasks waiting to receive, and to have what they sent received.
    receivers: [Fiber] = []
    senders: [Fiber] = []

    func send(self, anon value: T) -> none {
        if self.closed {
            panic("send on a closed channel")
        }
        // A cancelled task's send isn't made.
        if _running().cancelled {
            return
        }
        self.items += [value]
        self.sent += 1
        let ticket = self.sent
        self.receivers = _wake_all(self.receivers)
        for self.taken < ticket - self.capacity and not _running().cancelled {
            if self.closed {
                panic("send on a closed channel")
            }
            self.senders += [_running()]
            _park()
        }
    }

    // The next value, once there is one; none once the channel is closed and
    // every value has been received.
    func receive(self) -> T? {
        if self.has_next() {
            return self.take()
        }
        return none
    }

    // Waits until a value can be received, or the channel is closed and empty;
    // whether one can. `for v in ch` is `has_next` and `take`: nothing runs
    // between them, since a task gives way only where it waits.
    func has_next(self) -> bool {
        for self.head == len(self.items) and not self.closed and not _running().cancelled {
            self.receivers += [_running()]
            _park()
        }
        return self.head < len(self.items)
    }

    // The next value, which `has_next` said is there.
    func take(self) -> T {
        let value = self.items[self.head]
        self.head += 1
        self.taken += 1
        if self.head >= 64 and self.head * 2 >= len(self.items) {
            self.items = self.items[self.head..len(self.items)]
            self.head = 0
        }
        self.senders = _wake_all(self.senders)
        return value
    }

    func close(self) -> none {
        if self.closed {
            panic("close of a closed channel")
        }
        self.closed = true
        self.receivers = _wake_all(self.receivers)
        self.senders = _wake_all(self.senders)
    }
}

// Makes each of `fibers` ready; gives back the empty list to keep.
func _wake_all(anon fibers: [Fiber]) -> [Fiber] {
    for fiber in fibers {
        _make_ready(fiber)
    }
    return []
}

// Waits, as the running task, until something makes it ready again.
func _park() -> none {
    _switch_from(_running())
}

// kod_wait_event, once a task has been started (stdlib/runtime.c): makes the
// running task wait for the event while the others run, 1; or 0, and the
// caller blocks as it would without tasks, when this task is the only one or
// the event can't come (a child that has already exited, say); or 2 when the
// task is cancelled, and the caller gives up with `.Cancelled`.
func _wait_event(anon ident: int64, anon filter: int64, anon data: int64) -> int64 {
    let me = _running()
    if me.cancelled {
        return 2
    }
    if _live <= 1 {
        return 0
    }
    _io_next += 1
    let key = _io_next
    if kod_task_kq_add(ident, filter, data, key) != 0 {
        return 0
    }
    _io[key] = me
    me.io_key = key
    // _poll takes the key out when the event comes, _cancel when the task is.
    for _io.contains(key) {
        _switch_from(me)
    }
    me.io_key = 0
    if me.cancelled {
        return 2
    }
    return 1
}

// Makes ready the tasks whose events have come, waiting for one when `block`.
func _poll(anon block: bool) -> none {
    mut wait: int64 = 0
    if block {
        wait = 1
    }
    let n = kod_task_kq_wait(wait)
    for i in 0..n {
        if _io.remove(kod_task_kq_key(i)) is Fiber(fiber) {
            _make_ready(fiber)
        }
    }
}

// `body` as a task given at most `d`: what it gives back, or a `.TimedOut`
// error once `d` has passed, when the task is cancelled and waited for.
func within[T](anon d: Duration, anon body: func() -> T) -> T or Error {
    let task = start(body)
    if not _wait_until_done(task.fiber, ns: d.ns) {
        _cancel(task.fiber)
        _wait_for(task.fiber)
        throw IoError(kind: .TimedOut, op: "within", errno: 0, detail: "timed out")
    }
    return task.wait()
}

// Waits, as the running task, until `fiber` has ended or `ns` have passed:
// whether it has ended.
func _wait_until_done(anon fiber: Fiber, ns: int64) -> bool {
    if fiber.done {
        return true
    }
    let me = _running()
    _io_next += 1
    let key = _io_next
    if kod_task_kq_add(0, -7, ns, key) != 0 {
        _wait_for(fiber)
        return true
    }
    _io[key] = me
    for not fiber.done and _io.contains(key) {
        fiber.waiters += [me]
        _switch_from(me)
    }
    // Ended first: the timer's event, when it comes, finds no one waiting.
    let _gone = _io.remove(key)
    return fiber.done
}

// Runs `job` as a new task, belonging to no function: the helpers below wait
// for their tasks themselves.
func _start_job(anon job: Job) -> Fiber {
    let fiber = _new_fiber()
    fiber.job = job
    _make_ready(fiber)
    return fiber
}

// Waits, as the running task, until one of `fibers` has ended: its index.
func _wait_any(anon fibers: [Fiber]) -> int64 {
    for true {
        for i, fiber in fibers {
            if fiber.done {
                return i
            }
        }
        let me = _running()
        for fiber in fibers {
            fiber.waiters += [me]
        }
        _switch_from(me)
    }
    return -1
}

func _fibers_of[T](anon tasks: [Task[T]]) -> [Fiber] {
    mut out: [Fiber] = []
    for t in tasks {
        out += [t.fiber]
    }
    return out
}

// Cancels each of `fibers` and waits for them.
func _cancel_all(anon fibers: [Fiber]) -> none {
    for fiber in fibers {
        _cancel(fiber)
    }
    for fiber in fibers {
        _wait_for(fiber)
    }
}

// The indexes of `fibers` not in `seen`, in order.
func _unseen(anon seen: [bool]) -> [int64] {
    mut out: [int64] = []
    for i, s in seen {
        if not s {
            out += [i]
        }
    }
    return out
}

func _pick(anon fibers: [Fiber], anon at: [int64]) -> [Fiber] {
    mut out: [Fiber] = []
    for i in at {
        out += [fibers[i]]
    }
    return out
}

// Each of `fs` as a task: their results in order, or the first error to
// come, once the others are cancelled and have ended.
func all[T](anon fs: [func() -> T or Error]) -> [T] or Error {
    mut started: [Task[T or Error]] = []
    for f in fs {
        started += [start(f)]
    }
    let fibers = _fibers_of(started)
    mut seen = [false] * len(fibers)
    for _ in 0..len(fibers) {
        let open = _unseen(seen)
        let k = open[_wait_any(_pick(fibers, open))]
        seen[k] = true
        let result = started[k].wait()
        if result is Err(e) {
            _cancel_all(fibers)
            throw e
        }
    }
    mut out: [T] = []
    for t in started {
        out += [must t.wait()]
    }
    return out
}

// Each of `fs` as a task: the first result that isn't an error, once the
// others are cancelled and have ended, or the last error when all fail.
func first[T](anon fs: [func() -> T or Error]) -> T or Error {
    mut started: [Task[T or Error]] = []
    for f in fs {
        started += [start(f)]
    }
    let fibers = _fibers_of(started)
    mut seen = [false] * len(fibers)
    mut last: Error? = none
    for _ in 0..len(fibers) {
        let open = _unseen(seen)
        let k = open[_wait_any(_pick(fibers, open))]
        seen[k] = true
        let result = started[k].wait()
        if result is Err(e) {
            last = e
        } else {
            _cancel_all(fibers)
            return must result
        }
    }
    throw must last
}

// `f(x)` as a job: a generic literal can't capture `x`, a generic struct can
// hold it.
type _Apply[T, U] = shared struct {
    f: func(T) -> U
    x: T
    results: [U] = []

    func run(self) -> none {
        self.results = [self.f(self.x)]
    }
}

// `f` of each of `xs`, in order, with at most `limit` calls running at a time
// (at least one).
func map_concurrently[T, U](anon xs: [T], anon f: func(T) -> U, limit: int64) -> [U] {
    mut jobs: [_Apply[T, U]] = []
    for x in xs {
        jobs += [_Apply[T, U](:f, :x)]
    }
    mut most = limit
    if most < 1 {
        most = 1
    }
    mut running: [Fiber] = []
    mut all_fibers: [Fiber] = []
    for job in jobs {
        if len(running) == most {
            let k = _wait_any(running)
            running = running[0..k] + running[k + 1..len(running)]
        }
        let fiber = _start_job(job)
        running += [fiber]
        all_fibers += [fiber]
    }
    for fiber in all_fibers {
        _wait_for(fiber)
    }
    mut out: [U] = []
    for job in jobs {
        out += [job.results[0]]
    }
    return out
}

// For a value held across a wait (docs/tasks.md): `lock` waits until no other
// task holds it.
type Mutex = shared struct {
    held: bool = false
    waiters: [Fiber] = []

    func lock(self) -> none {
        for self.held {
            self.waiters += [_running()]
            _park()
        }
        self.held = true
    }

    func unlock(self) -> none {
        if not self.held {
            panic("unlock of a Mutex that isn't locked")
        }
        self.held = false
        self.waiters = _wake_all(self.waiters)
    }
}
