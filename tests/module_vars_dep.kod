// A module whose variables tests/unit/module_vars_test.kod reads and changes through functions.

mut hits: int64 = 0
mut names: [str] = []
mut _secret: str = "hidden"

// How many times `greeting` has been worked out.
mut announced: int64 = 0

// Worked out at first use, so `announced` goes up when the importer first reads `greeting`.
mut greeting: str = announce()

func announce() -> str {
    announced += 1
    return "hello"
}

mut transform: func(int64) -> int64 = twice

func twice(anon n: int64) -> int64 {
    return n * 2
}

func use_square() -> none {
    transform = func(n: int64) -> int64 { return n * n }
}

// Small enough to inline: called from another module, it still assigns this
// module's `hits`.
func reset_hits() -> int64 {
    hits = 0
    return hits
}

func hit(anon name: str) -> int64 {
    hits += 1
    names += [name]
    return hits
}

func secret() -> str {
    return _secret
}

func set_secret(anon s: str) -> none {
    _secret = s
}

// expected mode:
// skip
