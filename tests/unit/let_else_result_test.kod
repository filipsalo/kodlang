// `let .Variant(...) = value else` looks the variant up in the value's enum.

// What `run` made of each value it parsed, in order.
mut ran: [str] = []

type Oops = shared struct {
    func to_str(self) -> str {
        return "oops"
    }
}

type Shade = enum {
    Dark(level: int64)
}

type Paint = enum {
    Gloss(name: str)
    Dark(name: str)
}

func parse(anon s: str) -> str or Error {
    if s == "" {
        throw Oops()
    }
    return s + s
}

func run(anon s: str) -> int64 {
    let .Ok(v) = parse(s) else { return 1 }
    ran += [f"{v}!"]
    return 0
}

func paint_name(anon p: Paint) -> str {
    let .Dark(name) = p else { return "not dark" }
    return f"dark {name}"
}

test "let .Ok else on a result" {
    assert run("x") == 0
    assert ran == ["xx!"]
    assert run("") == 1
    assert ran == ["xx!"]
}

test "let .Variant else looks in the value's own enum" {
    assert paint_name(Paint.Dark(name: "ink")) == "dark ink"
    assert paint_name(Paint.Gloss(name: "wax")) == "not dark"
    let s: Shade = Shade.Dark(level: 3)
    let .Dark(level) = s else {
        fail("not dark")
        return
    }
    assert level == 3
}
