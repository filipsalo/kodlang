// An arm of a match expression may be a block whose last expression is its value.

// The block arms of `size` that ran, in order.
mut arms_run: [str] = []

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
    Dot
}

type Bad = shared struct {
    why: str

    func to_str(self) -> str {
        return self.why
    }
}

type Pair = shared struct {
    a: int64
    b: int64
}

func size(anon s: Shape) -> int64 {
    let x: int64 = match s {
        Shape.Circle(r) -> {
            let d = 2 * r
            arms_run += ["circle"]
            d * 3
        }
        Shape.Rect(w, h) -> w * h
        else {
            arms_run += ["dot"]
            0
        }
    }
    return x
}

func described(anon n: int64) -> str {
    return match n {
        1 -> "one"
        2 -> {
            let a = "tw"
            a + "o"
        }
        else -> {
            let a = n.to_str()
            "many " + a
        }
    }
}

func parse(anon s: str) -> int64 or Error {
    let n = match s {
        "x" -> {
            throw Bad(why: "bad x")
        }
        else -> {
            let v = s.parse_int()? or 0
            v + 1
        }
    }
    return n * 10
}

func early(anon n: int64) -> int64 {
    let r = match n {
        0 -> {
            return -1
        }
        else -> {
            let t = n + 1
            t
        }
    }
    return r * 2
}

func pair(anon n: int64) -> Pair {
    return match n {
        0 -> Pair(a: 0, b: 0)
        else -> {
            let h = n / 2
            Pair(a: h, b: n - h)
        }
    }
}

func nested(anon a: int64, anon b: int64) -> int64 {
    return match a {
        0 -> {
            let inner = match b {
                0 -> 100
                else -> {
                    let q = b * 2
                    q
                }
            }
            inner + 1
        }
        else -> a
    }
}

func maybe(anon n: int64) -> str? {
    return match n {
        0 -> none
        else -> {
            let s = n.to_str()
            s + "!"
        }
    }
}

test "block arms with statements before the value" {
    assert size(.Circle(r: 4)) == 24
    assert size(.Rect(w: 3, h: 5)) == 15
    assert size(.Dot) == 0
    assert arms_run == ["circle", "dot"]
    assert described(1) == "one"
    assert described(2) == "two"
    assert described(7) == "many 7"
}

test "block arms that throw or return" {
    assert must parse("4") == 50
    if parse("x") is Err(e) {
        assert e.to_str() == "bad x"
    } else {
        fail("no error")
    }
    assert early(0) == -1
    assert early(5) == 12
}

test "block arms of structs, nested matches and optionals" {
    let p = pair(9)
    assert p.a == 4
    assert p.b == 5
    assert nested(0, 0) == 101
    assert nested(0, 4) == 9
    assert nested(6, 4) == 6
    assert maybe(0) is none
    assert (maybe(3)? or "") == "3!"
}

test "bindings made in an arm are gone after it" {
    let k = 5
    let shadow = match k {
        5 -> {
            let k = 50
            k + 1
        }
        else -> 0
    }
    assert shadow == 51
    assert k == 5
}
