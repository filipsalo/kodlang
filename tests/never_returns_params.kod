// A helper that ends in a method of `self` or of a parameter never returns,
// and so does one whose receiver's type doesn't depend on its locals.
type Reporter = struct {
    tag: str

    func fail(self, anon msg: str) -> none {
        kod_panic(f"{self.tag}: {msg}")
    }

    func fail_loudly(self, anon msg: str) -> none {
        print(self.tag)
        self.fail(msg)
    }
}

type Desk = struct {
    reps: [Reporter]

    func die(self, anon msg: str) -> none {
        let i = len(self.reps) - 1
        self.reps[i].fail(msg)
    }

    func pick(self, anon n: int64) -> int64 {
        if n > 0 {
            return n
        }
        self.die("negative")
    }
}

func make(anon tag: str) -> Reporter {
    return Reporter(:tag)
}

func die_made(anon msg: str) -> none {
    let t = f"made {msg}"
    make(t).fail(msg)
}

func pick_made(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    die_made("negative")
}

func die(anon r: Reporter, anon msg: str) -> none {
    r.fail(msg)
}

func die_int_param(anon kod_panic: int64, anon msg: str) -> none {
    print_int(kod_panic)
    kod_panic(msg)
}

func pick(anon n: int64, r: Reporter) -> int64 {
    if n > 0 {
        return n
    }
    die(r, "negative")
}

func pick_self(anon n: int64, r: Reporter) -> int64 {
    if n > 0 {
        return n
    }
    r.fail_loudly("negative")
}

func pick_int(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    die_int_param(5, "negative")
}

func main() -> int64 {
    let r = Reporter(tag: "r")
    print_int(pick(1, :r) + pick_self(2, :r) + pick_int(3))
    print_int(Desk(reps: [r]).pick(4) + pick_made(5))
    print_int(pick_self(-1, :r))
    return 0
}

// expected output:
// 6
// 9
// r
// expected status:
// 1
// expected stderr:
// panic: r: negative
