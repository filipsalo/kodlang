// Prints a line without flushing, then replaces itself with the program
// named by the arguments (`exec_program <program> [args...]`). If that
// program can't be run, says what exec returned and exits 9.
// tests/stdio_test.py checks that the line comes out before the program's
// own output, and that a failed exec returns here.
import "process"

func main(argv: [str]) -> int64 {
    print("before")
    let status: int64 = process.exec(argv[1..len(argv)])
    print(f"exec returned {status}")
    return 9
}

// expected mode:
// skip
