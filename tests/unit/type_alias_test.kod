// Type aliases are transparent and can name any type, even a later one.

type Name = str
type Ids = [int64]
type MaybeBox = Box?
type Cb = func(int64) -> int64
type Fwd = Later
type Shown = Showable
type Far = Mid
type Mid = Distant
type FarDir = MidDir
type MidDir = Dir

type Box = shared struct {
    label: str
}

type Later = shared struct {
    n: int64
    s: str
}

type Distant = shared struct {
    tag: str
}

type Dir = enum {
    Up
    Down(steps: int64)
}

interface Showable {
    func show(self) -> str
}

type Dot = shared struct {
    c: str

    func show(self) -> str {
        return f"dot {self.c}"
    }
}

func greet(anon n: Name) -> str {
    return f"hi {n} ({n.char_count()})"
}

func total(anon ids: Ids) -> int64 {
    mut sum: int64 = 0
    for id in ids {
        sum = sum + id
    }
    return sum
}

func label_of(anon b: MaybeBox) -> str {
    let label: str? = b?.label
    return label? or "nothing"
}

func inc(anon x: int64) -> int64 {
    return x + 1
}

func twice(anon f: Cb, anon x: int64) -> int64 {
    return f(f(x))
}

func render(anon s: Shown) -> str {
    return s.show()
}

test "aliases of str, arrays and optionals" {
    let n: Name = "kod"
    assert greet(n) == "hi kod (3)"
    assert f"{n}!" == "kod!"

    let ids: Ids = [1, 2, 3]
    assert total(ids) == 6
    assert len(ids) == 3
    assert ids[0] == 1

    let some_box: MaybeBox = Box(label: "full")
    let no_box: MaybeBox = none
    assert label_of(some_box) == "full"
    assert label_of(no_box) == "nothing"
}

test "aliases of function types, later types and interfaces" {
    let cb: Cb = inc
    assert twice(cb, 5) == 7
    assert cb(1) == 2

    let fwd: Fwd = Later(n: 3, s: "later")
    assert fwd.s == "later"
    assert fwd.n == 3

    assert render(Dot(c: "x")) == "dot x"
    let shown: Shown = Dot(c: "y")
    assert shown.show() == "dot y"
}

test "chains of aliases" {
    let far = Far(tag: "far")
    assert far.tag == "far"
    let dir = FarDir.Down(steps: 2)
    match dir {
        .Up -> fail("up")
        .Down(steps) -> assert steps == 2
    }
}
