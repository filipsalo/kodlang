import "./alias_chain_base"

type Num2 = alias_chain_base.Num
type Name2 = alias_chain_base.Name
type Pt2 = alias_chain_base.Point
type Out2 = alias_chain_base.Outcome

type Tagged = struct {
    name: Name2
    at: Pt2
}

func tag(anon name: Name2) -> Tagged {
    return Tagged(:name, at: alias_chain_base.Point(x: 2, y: 5))
}

