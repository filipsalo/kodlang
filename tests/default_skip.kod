// A label can jump over parameters that have defaults.
import "./default_skip_dep"

func trace(anon label: str, anon value: int64) -> int64 {
    print(f"  {label}")
    return value
}

func three(a: int64 = 1, b: int64 = 2, c: int64 = 3) -> int64 {
    return a * 100 + b * 10 + c
}

func connect(anon host: str, port: int64 = 80, timeout_ms: int64 = 5000, tls: bool = false) -> str {
    return f"{host}:{port} {timeout_ms}ms tls={tls}"
}

func mixed(anon n: int64, delay: int64 = 100, tries: int64 = 3) -> int64 {
    return n * delay + tries
}

func ordered(a: int64, b: int64 = trace("default b", 2), c: int64 = trace("default c", 3)) -> int64 {
    return a * 100 + b * 10 + c
}

func anon_default(anon first: int64 = 7, second: int64 = 8) -> int64 {
    return first * 10 + second
}

type Counter = struct {
    value: int64

    func add(self, by: int64 = 1, times: int64 = 1, extra: int64 = 0) -> int64 {
        self.value = self.value + by * times + extra
        return self.value
    }
}

interface Greeter {
    func greet(self, anon name: str, times: int64 = 2, loud: bool = false) -> str
}

type Dog = struct {
    sound: str

    func greet(self, anon name: str, times: int64 = 2, loud: bool = false) -> str {
        mut out = ""
        mut i = 0
        for i < times {
            out = out + self.sound
            i = i + 1
        }
        if loud {
            return f"{out}! {name}"
        }
        return f"{out} {name}"
    }
}

func main() -> int64 {
    print("free functions:")
    print_int(three())                   // 123
    print_int(three(c: 9))               // 129
    print_int(three(b: 5))               // 153
    print_int(three(a: 7, c: 9))         // 729
    print_int(three(b: 5, c: 6))         // 156
    print_int(three(a: 4, b: 5, c: 6))   // 456
    print(connect("example.com"))
    print(connect("example.com", timeout_ms: 200))
    print(connect("example.com", tls: true))
    print(connect("example.com", port: 8443, tls: true))
    print(connect("h", timeout_ms: 1))

    print("anon first, labeled rest:")
    print_int(mixed(2))                  // 203
    print_int(mixed(2, tries: 9))        // 209
    print_int(mixed(2, delay: 5))        // 13
    let tries = 4
    print_int(mixed(2, :tries))          // 204

    print("an anon parameter with a default can be jumped over:")
    print_int(anon_default())            // 78
    print_int(anon_default(second: 1))   // 71
    print_int(anon_default(5))           // 58
    print_int(anon_default(5, second: 1))// 51

    print("methods:")
    mut c = Counter(value: 0)
    print_int(c.add())                   // 1
    print_int(c.add(times: 3))           // 4
    print_int(c.add(extra: 10))          // 15
    print_int(c.add(by: 2, extra: 1))    // 18

    print("interface methods:")
    let g: Greeter = Dog(sound: "woof")
    print(g.greet("cat"))
    print(g.greet("cat", loud: true))
    print(g.greet("cat", times: 1))
    print(g.greet("cat", times: 1, loud: true))

    print("another module:")
    print_int(default_skip_dep.scaled(3))
    print_int(default_skip_dep.scaled(3, offset: 5))
    print_int(default_skip_dep.scaled(3, factor: 2))
    let gauge = default_skip_dep.Gauge(base: 4)
    print_int(gauge.read())
    print_int(gauge.read(shift: 2))

    print("evaluation order, parameter by parameter:")
    print_int(ordered(a: trace("arg a", 1), c: trace("arg c", 4)))
    print_int(ordered(a: trace("arg a", 1), b: trace("arg b", 5)))
    print_int(ordered(a: trace("only a", 1)))

    return 0
}

// expected output:
// free functions:
// 123
// 129
// 153
// 729
// 156
// 456
// example.com:80 5000ms tls=false
// example.com:80 200ms tls=false
// example.com:80 5000ms tls=true
// example.com:8443 5000ms tls=true
// h:80 1ms tls=false
// anon first, labeled rest:
// 203
// 209
// 13
// 204
// an anon parameter with a default can be jumped over:
// 78
// 71
// 58
// 51
// methods:
// 1
// 4
// 15
// 18
// interface methods:
// woofwoof cat
// woofwoof! cat
// woof cat
// woof! cat
// another module:
//   dep offset default
// 31
// 35
//   dep offset default
// 7
// 40
// 42
// evaluation order, parameter by parameter:
//   arg a
//   default b
//   arg c
// 124
//   arg a
//   arg b
//   default c
// 153
//   only a
//   default b
//   default c
// 123

// expected status:
// 0

// expected mode:
// run
