// A Map shows as `{key: value, ...}` and a Set as `{a, b}`, in order.
import "sets" { Set }

type Bare = struct {
    n: int64
}

func main() -> int64 {
    let m = Map[str, int64]()
    m.set("a", 1)
    m.set("b", 2)
    m.set("c", 3)
    m.remove("b")
    print(m)
    print(f"map {m}")
    print(Map[int64, str]())
    let nested = Map[str, [int64]]()
    nested.set("xs", [1, 2])
    print(str(nested))
    let s = Set[str]()
    s.add("x")
    s.add("y")
    s.add("x")
    print(s)
    print([s])
    print(Set[int64]())
    return 0
}

// expected output:
// {a: 1, c: 3}
// map {a: 1, c: 3}
// {}
// {xs: [1, 2]}
// {x, y}
// [{x, y}]
// {}
// expected status:
// 0
