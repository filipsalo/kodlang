type Box = struct {
    items: [int64] = []
}

func grow(anon xs: [int64]) -> int64 {
    mut ys = xs
    ys += [100]
    return len(ys)
}

func main() -> int64 {
    mut xs: [int64] = [1, 2]
    let a = xs
    let copy = xs + []
    xs += [3]
    print(f"{len(a)} {len(copy)} {len(xs)}")

    let b = Box()
    let held = b.items
    b.items += [7]
    b.items += [8]
    print(f"{len(held)} {len(b.items)} {len(Box().items)}")

    mut rows: [[int64]] = [[1], [2, 3]]
    let first = rows[0]
    rows[0] += [4, 5]
    print(f"{len(first)} {len(rows[0])}")

    mut seen = 0
    for x in xs {
        if x < 3 {
            xs += [x + 10]
        }
        seen += 1
    }
    print(f"{seen} {len(xs)}")

    mut fresh: [[int64]] = []
    for i in [0, 1, 2] {
        mut acc: [int64] = []
        acc += [i]
        fresh += [acc]
    }
    print(f"{len(fresh[0])} {len(fresh[1])} {len(fresh[2])}")

    let zs: [int64] = [7]
    print(f"{grow(zs)} {len(zs)}")
    return 0
}

// expected output:
// 3 2 3
// 2 2 0
// 3 3
// 5 5
// 1 1 1
// 2 2
