// Integer division by zero panics instead of giving a number.
import "testing"

func ratio(anon a: int64, anon b: int64) -> int64 {
    return a / b
}

test "integer division by zero panics" {
    assert ratio(7, 2) == 3
    let r = testing.run(func() {
        print_int(ratio(7, 0))
        print("not reached")
    })
    assert r.status == 1
    assert r.stdout == ""
    assert r.stderr.contains("panic: integer division by zero")
}
