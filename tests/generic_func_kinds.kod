// Inference through `T or Error`, `Map[K, V]` and function types, and a generic call that never returns.

type Bad = struct {
    func to_str(self) -> str { return "bad" }
}
func unwrap_or[T](anon r: T or Error, fallback: T) -> T {
    match r {
        Ok(v) -> return v
        Err(_e) -> return fallback
    }
}
func parse(anon s: str) -> int64 or Error {
    throw Bad()
}
func wrap[T](anon x: T) -> T or Error { return x }
func lookup[K, V](m: Map[K, V], key: K, fallback: V) -> V {
    return m.get(key)? or fallback
}
func die[T](anon msg: str, x: T) -> none { panic(msg) }
func pick(anon k: int64) -> int64 {
    if k > 0 { return 1 }
    die("boom", x: 1)
}
func twice[T](anon x: T, f: func(T) -> T) -> T { return f(f(x)) }
func inc(anon n: int64) -> int64 { return n + 1 }
func try_it() -> int64 or Error {
    let v = try wrap(3)
    return v + 1
}
func main() -> int64 {
    print(unwrap_or(parse("x"), fallback: 9))
    print(must try_it())
    let m = Map[str, int64]()
    m.set("a", 1)
    print(lookup(:m, key: "a", fallback: 0))
    print(lookup(:m, key: "b", fallback: 7))
    print(pick(1))
    print(twice(1, f: inc))
    print(f"{twice("s", f: func(anon s: str) -> str { return s + "!" })}")
    let w = match twice(2, f: inc) {
        4 -> "four"
        else -> "other"
    }
    print(w)
    return 0
}

// expected output:
// 9
// 4
// 1
// 7
// 1
// 3
// s!!
// four
