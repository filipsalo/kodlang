// Comprehensions (docs/arrays.md#comprehensions).
import "arrays"
import "sets" { Set }

type Dir = enum {
    N
    S
}

func squares(anon n: int64) -> [int64] {
    return [i * i for i in 0..n]
}

func pairs[T](anon xs: [T], anon y: T) -> [(T, T)] {
    return [(x, y) for x in xs]
}

test "over arrays, ranges, text, maps and sets" {
    assert squares(5) == [0, 1, 4, 9, 16] and len(squares(0)) == 0
    assert [w.upper() for w in "a b".split(" ")] == ["A", "B"]
    assert [c - 'a' for c in "abc"] == [0, 1, 2]
    mut m = Map[str, int64]()
    m["a"] = 1
    m["b"] = 2
    assert [k for k in m] == ["a", "b"] and [f"{k}{v}" for k, v in m] == ["a1", "b2"]
    mut s = Set[int64]()
    s.add(4)
    assert [x + 1 for x in s] == [5]
    assert [i * x for i, x in [5, 6, 7]] == [0, 6, 14]
    assert [a + b for (a, b) in [(1, 2), (3, 4)]] == [3, 7]
    assert [i + a * b for i, (a, b) in [(1, 2), (3, 4)]] == [2, 13]
}

test "several loops and tests" {
    assert [i * 10 + j for i in 0..2 for j in 0..2] == [0, 1, 10, 11]
    assert [(i, j) for i in 0..3 for j in i + 1..3] == [(0, 1), (0, 2), (1, 2)]
    assert [i for i in 0..20 if i % 2 == 0 if i % 3 == 0] == [0, 6, 12, 18]
    assert [y for i in 0..3 if i != 1 for y in [i, i * 10] if y != 0] == [2, 20]
    let long = [
        i * 10
        for i in 0..5
        if i % 2 == 0
    ]
    assert long == [0, 20, 40]
    assert [[c for c in line] for line in ["ab", "c"]] == [[97, 98], [99]]
    assert [[0 for _ in 0..2] for _ in 0..2] == [[0, 0], [0, 0]]
}

test "tests bind and narrow" {
    assert [n for w in ["1", "x", "3"] if w.parse_int() is Some(n)] == [1, 3]
    let xs: [int64?] = [none, 3, none, 5]
    assert [x + 1 for x in xs if x is not none] == [4, 6]
    let us: [int64 | str] = [1, "a", 2]
    assert [u + 1 for u in us if u is int64] == [2, 3]
    assert [n + k for w in ["1", "2"] if w.parse_int() is Some(n) and n > 1 for k in 0..2] == [2, 3]
}

test "names are its own" {
    let x = 10
    assert [x for x in 0..2] == [0, 1] and x == 10
    assert [x + y for y in 0..2] == [10, 11]
    let ys = [x for x in [x, x + 1]]
    assert ys == [10, 11] and x == 10
    let fs = [func() -> int64 { return i * x } for i in 0..3]
    assert [f() for f in fs] == [0, 10, 20]
    mut sum = 0
    let seen = [func() -> int64 {
        sum += i
        return sum
    } () for i in 0..4]
    assert seen == [0, 1, 3, 6] and sum == 6
}

type Fields = struct {
    xs: [int64?]
    d: [str] = [f"{i}" for i in 0..2]
}

func opt() -> [int64]? {
    return [i for i in 0..2]
}

func res(anon n: int64) -> [int64?] or Error {
    return [none for _ in 0..n]
}

func count(anon xs: [int64?]) -> int64 {
    return len(xs)
}

test "elements convert to what the array goes to" {
    let a: [int64?] = [i for i in 0..2]
    assert (a[1]? or 9) == 1
    let t: [(int64?, str)] = [(none, "a") for _ in 0..2]
    assert len(t) == 2 and t[0].0 is none
    let d: [Dir] = [.S for _ in 0..2]
    assert d == [.S, .S]
    let f = Fields(xs: [none for _ in 0..3])
    assert len(f.xs) == 3 and f.d == ["0", "1"]
    assert (must opt()) == [0, 1] and len(must res(2)) == 2
    assert count([none for _ in 0..4]) == 4
    let g: [[str?]] = [[none for _ in 0..i] for i in 0..3]
    assert len(g[2]) == 2
    let o: [int64]? = [1 for _ in 0..2]
    assert (must o) == [1, 1]
    assert pairs(["p"], "q") == [("p", "q")]
    mut e = [i for i in 0..2]
    e += [i * 100 for i in 1..3]
    e += [7]
    assert e == [0, 1, 100, 200, 7]
    let sum: [int64?] = [none for _ in 0..2] + [1]
    assert len(sum) == 3
}

type Bad = struct {
    func to_str(self) -> str {
        return "bad"
    }
}

func below(anon i: int64, anon limit: int64) -> str or Error {
    if i >= limit {
        throw Bad()
    }
    return f"t{i}"
}

func tried(anon n: int64) -> [str] or Error {
    return [try below(i, 3) for i in 0..n]
}

func early(anon n: int64) -> int64 {
    let xs = [if i > 2 { return i } else { f"q{i}" } for i in 0..n]
    return len(xs) * 100
}

test "an element that leaves the function" {
    assert (must tried(2)) == ["t0", "t1"] and tried(5) is Err(_)
    assert early(2) == 200 and early(9) == 3
}

test "arrays: sum, min, max, any and all" {
    assert arrays.sum([i for i in 1..5]) == 10 and arrays.sum([]) == 0
    assert arrays.sum_floats([0.5 for _ in 0..3]) == 1.5
    let words = ["pear", "fig", "apple"]
    assert (arrays.max([len(w) for w in words])? or 0) == 5 and (arrays.min(words)? or "") == "apple"
    assert must arrays.max([(1, "a"), (1, "b")]) == (1, "b")
    assert arrays.min([i for i in 0..0]) is none
    assert arrays.any([w == "fig" for w in words]) and not arrays.any([])
    assert arrays.all([w != "" for w in words]) and arrays.all([]) and not arrays.all([true, false])
}

extern func rc_live_bytes() -> int64

func work(anon i: int64) -> int64 {
    let a = [f"a{k}" for k in 0..i]
    let b = [(s, [c for c in s]) for s in a if len(s) > 1]
    let d = [x.upper() + y for x in a for (y, z) in b if len(z) == len(x)]
    mut n = len(a) + len(b) + len(d) + early(i)
    if tried(i) is Ok(v) {
        n += len(v)
    }
    for f in [func() -> str { return s + "!" } for s in a] {
        n += len(f())
    }
    mut m = Map[str, [str]]()
    m["k"] = [s for s in a]
    n += len([p for _, vs in m for p in vs if p.find("1") is Some(_)])
    return n + len(", ".join([s + t for s in a for t in [x for x in a if x != s]]))
}

test "nothing is left behind" {
    mut n = 0
    for i in 0..8 {
        n += work(i)
    }
    let before = rc_live_bytes()
    for i in 0..400 {
        n += work(i % 8)
    }
    assert n > 0 and rc_live_bytes() - before < 1000
}

test "a comprehension's array is the only one that holds it" {
    // Appending to it copies nothing: many times, it would be slow.
    mut xs = [i for i in 0..1000]
    for i in 0..200000 {
        xs += [i]
    }
    assert len(xs) == 201000
}
