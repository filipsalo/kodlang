// After `x?.`, the rest of the chain runs on the unwrapped value: `none` as soon as `x` is.

type Oops = struct {
    func to_str(self) -> str {
        return "oops"
    }
}

type Inner = struct {
    n: int64
    label: str?

    func twice(self) -> int64 {
        return self.n * 2
    }
}

type User = struct {
    name: str
    tags: [str]
    inner: Inner
    maybe: Inner?

    func shout(self) -> str {
        return self.name.upper()
    }

    func get(self, anon key: str) -> Inner {
        return Inner(n: len(key), label: key)
    }
}

func make(anon id: int64) -> User? {
    if id < 0 {
        return none
    }
    mut maybe: Inner? = none
    if id > 0 {
        maybe = Inner(n: id, label: none)
    }
    return User(name: f"user{id}", tags: ["a", "bc"], inner: Inner(n: 10 + id, label: "in"), maybe: maybe)
}

func load(anon id: int64) -> User or Error {
    if id < 0 {
        throw Oops()
    }
    return make(id)?
}

func noisy(anon s: str) -> str {
    print(f"evaluated {s}")
    return s
}

func main() -> int64 {
    print(make(1)?.name.upper()? or "-")
    print(make(-1)?.name.upper()? or "-")
    print(make(2)?.tags[1]? or "-")
    print(make(-2)?.tags[1]? or "-")
    print(make(3)?.inner.twice()? or 0)
    print(make(-3)?.inner.twice()? or 0)
    print(make(4)?.shout().lower()? or "-")
    print(make(4)?.get(noisy("key")).n? or 0)
    print(make(-4)?.get(noisy("never")).n? or 0)

    // A step that gives an optional flattens: `label` is `str?`.
    print(make(5)?.inner.label? or "-")
    print(make(5)?.get("xy").label? or "-")
    // `?.` again where a step is itself optional.
    print(make(6)?.maybe?.twice()? or 0)
    print(make(0)?.maybe?.twice()? or 0)
    print(make(7)?.maybe?.label? or "no label")
    print(make(7)?.maybe?.n.to_str()? or "-")

    // On a result.
    print(load(8)?.name.upper()? or "-")
    print(load(-8)?.name.upper()? or "-")
    print(load(9)?.inner.label? or "-")

    // A chain as a statement, and kept in a binding.
    make(1)?.inner.twice()
    let n = make(11)?.inner.n
    print(n? or 0)
    let missing = make(-1)?.inner.n
    print(missing is none)
    return 0
}

// expected output:
// USER1
// -
// bc
// -
// 26
// 0
// user4
// evaluated key
// 3
// 0
// in
// xy
// 12
// 0
// no label
// 7
// USER8
// -
// in
// 21
// true
