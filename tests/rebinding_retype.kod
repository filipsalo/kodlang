// A `let` that binds a name again in its block reads the old binding,
// with its old type, in its value.
type A = struct {
    x: int64
}

func label(anon n: int64) -> str {
    let n = f"#{n}"
    return n
}

func main() -> int64 {
    let x = 5
    let x = f"v{x}"
    print(x)
    let a = A(x: 7)
    let a = a.x + 1
    print_int(a)
    let o: int64? = 4
    match o {
        Some(v) -> {
            let v = f"v{v}"
            print(v)
        }
        none -> print("none")
    }
    print(label(3))
    return 0
}

// expected output:
// v5
// 8
// v4
// #3
