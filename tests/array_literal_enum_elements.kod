// An implicit variant in an array literal belongs to the array's element enum.
type A = enum {
    Up
    Hit(n: int64)
}
type B = enum {
    Miss
    Hit(n: int64)
    Up
}
type Maybe[T] = enum {
    Nothing
    Just(value: T)
}
type Holder = struct {
    bs: [B]
}
func show(anon b: B) -> str {
    return match b {
        .Miss -> "miss"
        .Hit(n) -> f"hit {n}"
        .Up -> "up"
    }
}
func shows(anon bs: [B]) -> none {
    mut parts = ""
    for b in bs {
        parts = parts + show(b) + ";"
    }
    print(parts)
}
func just(anon m: Maybe[str]) -> str {
    return match m {
        .Just(v) -> v
        .Nothing -> "nothing"
    }
}
func make() -> [B] {
    return [.Up, .Hit(n: 2)]
}
func grid() -> [[B]] {
    return [[.Hit(n: 3)], [.Up]]
}
func main() -> int64 {
    let bs: [B] = [.Hit(n: 1), .Miss, .Up]
    shows(bs)
    shows([.Up, .Hit(n: 4)])
    mut acc: [B] = []
    acc += [.Up]
    acc += [.Hit(n: 5)]
    shows(acc)
    acc[0] = .Hit(n: 6)
    shows(acc)
    shows(make())
    let g = grid()
    shows(g[0])
    shows(g[1])
    let nested: [[B]] = [[.Up], [.Hit(n: 7)]]
    shows(nested[1])
    mut h = Holder(bs: [.Hit(n: 8)])
    shows(h.bs)
    h.bs = [.Up, .Miss]
    shows(h.bs)
    let m = Map[str, [B]]()
    m["x"] = [.Up]
    shows(m["x"]?)
    let ms: [Maybe[str]] = [.Nothing, .Just(value: "j")]
    print(just(ms[0]) + " " + just(ms[1]))
    mut mm: [Maybe[str]] = []
    mm += [.Just(value: "pe")]
    mm[0] = .Just(value: "set")
    print(just(mm[0]))
    return 0
}

// expected output:
// hit 1;miss;up;
// up;hit 4;
// up;hit 5;
// hit 6;hit 5;
// up;hit 2;
// hit 3;
// up;
// hit 7;
// hit 8;
// up;miss;
// up;
// nothing j
// set
