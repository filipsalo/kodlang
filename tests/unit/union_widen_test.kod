// A union widens into one with all of its members, and converts to a string
// as the member it holds.
type Pt = shared struct {
    x: int64
    func to_str(self) -> str { return f"Pt({self.x})" }
}
type Small = int64 | str
type Big = int64 | str | bool | Pt
type Holder = shared struct { v: Big }
type Box = enum {
    Full(v: Big)
    Empty
}

func show(anon b: Big) -> str {
    return match b {
        int64(n) -> f"int {n}"
        str(s) -> f"str {s}"
        bool(t) -> f"bool {t}"
        Pt(p) -> f"pt {p.x}"
    }
}

func up(anon s: Small) -> Big {
    return s
}

test "a union widens into a bigger one" {
    let s: Small = "hi"
    let b: Big = s
    assert show(b) == "str hi"
    assert show(up(7)) == "int 7"
    let h = Holder(v: s)
    assert show(h.v) == "str hi"
    let x = Box.Full(v: s)
    if x is .Full(v) {
        assert show(v) == "str hi"
    } else {
        fail("not Full")
    }
    let o: Big? = s
    assert not (o is none)
}

test "a union converts to a string as its member" {
    let s: Small = "hi"
    let b: Big = s
    let p: Big = Pt(x: 3)
    assert f"{s} {b} {p}" == "hi hi Pt(3)"
    assert str(s) == "hi"
    assert str(p) == "Pt(3)"
    let mixed: Big = true
    assert "v=" + str(mixed) == "v=true"
}
