// A constructor binds each value to the field its label names, in any
// order, and a field left out takes its default.
type Opts = shared struct {
    x: int64 = 1
    y: int64 = 2
    z: int64 = 3
}

type Pt = shared struct {
    x: int64
    y: int64
}

type Two[T] = shared struct {
    a: T
    b: T
}

type Mixed = shared struct {
    name: str
    count: int64 = 7
    tags: [str] = []
    on: bool
}

type Log = shared struct {
    text: str = ""

    func at(self, anon tag: str, anon v: int64) -> int64 {
        self.text = self.text + tag
        return v
    }
}

func show(anon o: Opts) -> [int64] {
    return [o.x, o.y, o.z]
}

test "left-out fields take their defaults" {
    assert show(Opts(y: 5)) == [1, 5, 3]
    assert show(Opts(z: 9, x: 4)) == [4, 2, 9]
    assert show(Opts()) == [1, 2, 3]
}

test "labels in any order" {
    let p = Pt(y: 2, x: 1)
    assert p.x == 1
    assert p.y == 2
    let t = Two[str](b: "b", a: "a")
    assert t.a + t.b == "ab"
    let m = Mixed(on: true, name: "m")
    assert m.name == "m"
    assert m.count == 7
    assert len(m.tags) == 0
    assert m.on
}

test "values are evaluated in source order" {
    let l = Log()
    let q = Pt(y: l.at("y", 4), x: l.at("x", 3))
    assert l.text == "yx"
    assert q.x == 3
    assert q.y == 4
}
