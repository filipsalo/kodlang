// A pattern that can't match `none` tests what an optional holds, without `Some`.
type Color = enum {
    Red
    Rgb(v: int64)
}

type Cell = enum {
    Paint(c: Color?)
    Count(n: int64?)
}

func color_name(anon c: Color?) -> str {
    return match c {
        .Red -> "red"
        .Rgb(0) -> "black"
        .Rgb(v) -> f"rgb {v}"
        none -> "none"
    }
}

func count_name(anon n: int64?) -> str {
    match n {
        0 -> return "zero"
        -1 -> return "minus one"
        none -> return "unknown"
        else -> return "some"
    }
}

func word(anon w: str?) -> str {
    return match w {
        "hi" -> "greeting"
        none -> "silence"
        else -> "words"
    }
}

func flag(anon b: bool?) -> str {
    return match b {
        true -> "yes"
        false -> "no"
        none -> "unset"
    }
}

func cell_name(anon c: Cell) -> str {
    return match c {
        .Paint(.Red) -> "red paint"
        .Paint(.Rgb(v)) -> f"paint {v}"
        .Paint(none) -> "no paint"
        .Count(7) -> "seven"
        .Count(_) -> "count"
    }
}

test "patterns on optional enums, ints, strs and bools" {
    assert color_name(.Red) == "red"
    assert color_name(.Rgb(v: 0)) == "black"
    assert color_name(.Rgb(v: 5)) == "rgb 5"
    assert color_name(none) == "none"
    assert count_name(0) == "zero"
    assert count_name(-1) == "minus one"
    assert count_name(3) == "some"
    assert count_name(none) == "unknown"
    assert word("hi") == "greeting"
    assert word("x") == "words"
    assert word(none) == "silence"
    assert flag(true) == "yes"
    assert flag(false) == "no"
    assert flag(none) == "unset"
}

test "optional patterns nested in a payload" {
    assert cell_name(.Paint(c: .Red)) == "red paint"
    assert cell_name(.Paint(c: .Rgb(v: 2))) == "paint 2"
    assert cell_name(.Paint(c: none)) == "no paint"
    assert cell_name(.Count(n: 7)) == "seven"
    assert cell_name(.Count(n: none)) == "count"
}

test "optional patterns in is and let-else" {
    let c: Color? = .Rgb(v: 1)
    if c is .Rgb(v) {
        assert v == 1
    } else {
        fail("c is not rgb")
    }
    assert f"{c is .Rgb(_)} {c is .Red} {c is not .Red}" == "true false true"
    let gone: Color? = none
    assert f"{gone is .Red}" == "false"
    let .Rgb(w) = c else {
        fail("c is not rgb")
        return
    }
    assert w == 1
}
