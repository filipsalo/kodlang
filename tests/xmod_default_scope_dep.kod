func helper() -> int64 {
    return 1
}

func f(x: int64 = helper()) -> int64 {
    return x
}

func run(cb: func() -> int64 = helper) -> int64 {
    return cb()
}

type Cfg = struct {
    n: int64 = helper()
}

type Counter = struct {
    base: int64

    func bump(self, by: int64 = helper()) -> int64 {
        return self.base + by
    }

    func step(self) -> int64 {
        return self.base + helper()
    }
}

type Box[T] = struct {
    v: T

    func tag(self) -> int64 {
        return helper()
    }
}

