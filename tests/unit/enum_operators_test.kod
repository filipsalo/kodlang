// Operator methods on enums, generic ones included.

type Amount = enum {
    Cents(n: int64)
    Free

    func op_eq(self, other: Amount) -> bool {
        return self.cents() == other.cents()
    }

    func op_lt(self, other: Amount) -> bool {
        return self.cents() < other.cents()
    }

    func op_add(self, other: Amount) -> Amount {
        return .Cents(n: self.cents() + other.cents())
    }

    func op_mul(self, times: int64) -> Amount {
        return .Cents(n: self.cents() * times)
    }

    func op_rmul(self, times: int64) -> Amount {
        return self * times
    }

    func op_rsub(self, from: int64) -> Amount {
        return .Cents(n: from - self.cents())
    }

    func cents(self) -> int64 {
        return match self {
            .Cents(n) -> n
            .Free -> 0
        }
    }
}

type Light = enum {
    Red
    Green

    func op_eq(self, other: Light) -> bool {
        return true
    }
}

type Pick[T] = enum {
    One(v: T)
    Nothing

    func op_eq(self, other: Pick[T]) -> bool {
        return match self {
            .One(a) -> match other {
                .One(b) -> a == b
                .Nothing -> false
            }
            .Nothing -> other is .Nothing
        }
    }
}

// What `note` was called with, in order.
mut notes: [str] = []

func note(anon s: str) -> int64 {
    notes += [s]
    return 1
}

test "comparison operators" {
    let a: Amount = .Cents(n: 0)
    let b: Amount = .Cents(n: 5)
    assert f"{a == .Free} {a != .Free} {b == .Free} {a == b}" == "true false false false"
    assert f"{a < b} {a > b} {a <= .Free} {b >= .Cents(n: 6)}" == "true false true false"
    assert (a < b < .Cents(n: 9)) == true
}

test "arithmetic operators" {
    let b: Amount = .Cents(n: 5)
    let sum = b + .Cents(n: 2) + Amount.Free
    assert sum.cents() == 7
    assert (sum * 2).cents() == 14
    assert (3 * b).cents() == 15
    assert (-b).cents() == -5
    mut total: Amount = .Free
    total += b
    total += b
    assert total.cents() == 10
}

test "op_eq on a payloadless and a generic enum" {
    let r: Light = .Red
    assert (r == .Green) == true

    let p: Pick[str] = .One(v: "x")
    let q: Pick[str] = .One(v: "x")
    let n: Pick[int64] = .Nothing
    assert f"{p == q} {p == .One(v: "y")} {p != .Nothing} {n == .Nothing}" == "true false true true"
}

test "operands evaluate left to right" {
    let left: Amount = .Cents(n: note("left"))
    let same = left == .Cents(n: note("right"))
    assert notes == ["left", "right"]
    assert same == true
}
