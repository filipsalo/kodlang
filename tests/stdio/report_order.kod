// Three test blocks that write to stderr and stdout between the reporter's
// lines: the first before anything of it is reported, the second then fails,
// the third waits for a line on stdin. tests/stdio_test.py runs it with
// `kod test`, stdout and stderr in one pipe, and expects every line where the
// calls put it.
import "io"

test "first" {
    io.write_stderr("stderr in first\n")
    print("printed in first")
    assert 1 + 1 == 2
}

test "second" {
    io.write_stderr("stderr in second\n")
    print("printed in second")
    assert 1 + 1 == 3
}

test "third" {
    let line: str = io.read_stdin_line()
    print(f"third read [{line}]")
}

// expected mode:
// skip
