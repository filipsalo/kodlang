// Parentheses group a type: an optional union, a function in a union, a nested result.

type Oops = struct {
    func to_str(self) -> str {
        return "oops"
    }
}

func show(anon x: (int64 | str)?) -> str {
    match x {
        int64(n) -> return f"int {n}"
        str(s) -> return f"str {s}"
        none -> return "none"
    }
}

type Thunk = func() -> int64

func run(anon f: (func() -> int64) | str) -> str {
    match f {
        str(s) -> return s
        Thunk(g) -> return f"ran {g()}"
    }
}

func seven() -> int64 {
    return 7
}

func nested(anon n: int64) -> (int64 or Error) or Error {
    if n < 0 {
        throw Oops()
    }
    if n == 0 {
        let inner: int64 or Error = .Err(error: Oops())
        return inner
    }
    return n
}

func flat(anon n: int64) -> int64 or Error or Error {
    return n
}

func describe(anon r: (int64 or Error) or Error) -> str {
    match r {
        Ok(Ok(n)) -> return f"ok ok {n}"
        Ok(Err(_e)) -> return "ok err"
        Err(_e) -> return "err"
    }
}

func main() -> int64 {
    print(show(3))
    print(show("a"))
    print(show(none))
    let xs: [(int64 | str)?] = [1, none, "b"]
    for x in xs {
        print(show(x))
    }
    print(run(seven))
    print(run("text"))
    print(describe(nested(4)))
    print(describe(nested(0)))
    print(describe(nested(-1)))
    let plain: int64 or Error = flat(5)
    print(plain? or 0)
    let p: ((int64)) = 8
    print(p)
    return 0
}

// expected output:
// int 3
// str a
// none
// int 1
// none
// str b
// ran 7
// text
// ok ok 4
// ok err
// err
// 5
// 8
