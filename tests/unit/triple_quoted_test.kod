// Triple-quoted strings: dedent, f-string interpolation, inner indent and escapes.

test "dedent" {
    let preamble: str = """
        .text
        .globl _main
        _main:
        """
    assert preamble == ".text\n.globl _main\n_main:\n"
}

test "f-string interpolation" {
    let label: str = "$user$main"
    let asm: str = f"""
        bl {label}
        ret
        """
    assert asm == "bl $user$main\nret\n"
}

test "inner indent preserved" {
    // Inner indent (beyond the closing-quote anchor) is preserved.
    let nested: str = """
        outer
            inner
        outer
        """
    assert nested == "outer\n    inner\nouter\n"
}

test "escapes" {
    // Escape sequences still work inside the body.
    let escapes: str = """
        a\tb
        """
    assert escapes == "a\tb\n"
}
