// `is` binds tighter than and/or, and a bare `is` tests enum variants.
import "./infer_ctor_kinds_dep"

type Color = enum {
    Red
    Green
}
type Form = enum {
    Circle(radius: int64)
    Rect(w: int64, h: int64)
}
func main() -> int64 {
    let f = true
    let o: int64? = none
    if f and o is none {
        print("f and none")
    }
    let p: int64? = 3
    if o is not none or p is not none {
        print("one is set")
    }
    let both = o is none and p is not none
    print(f"{both}")
    let c: Color = .Green
    if c is .Green and f {
        print("green")
    }
    let s: Form = .Rect(w: 2, h: 3)
    print(f"{s is .Circle(_)} {s is Form.Rect(_, _)} {c is Color.Red} {c is not .Red}")
    let maybe_c: Color? = .Red
    print(f"{maybe_c is .Some} {maybe_c is .None}")
    if p is Some(v) {
        print_int(v)
    }
    if o is none == true {
        print("none == true")
    }
    if s is Form.Rect(w, h) {
        print_int(w * h)
    }
    if s is not Form.Circle(r) {
        print("not a circle")
    } else {
        print_int(r)
    }
    let d: infer_ctor_kinds_dep.Shape = .Square(side: 4)
    if d is infer_ctor_kinds_dep.Shape.Square(side) {
        print_int(side)
    }
    return 0
}

// expected output:
// f and none
// one is set
// true
// green
// false true false true
// true false
// 3
// none == true
// 6
// not a circle
// 4
