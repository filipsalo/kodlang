import "json"

type Point = shared struct {
    x: int64
    y: int64
}

func show_int(anon opt: int64?) -> str {
    let .Some(n) = opt else { return "no int" }
    return f"int {n}"
}

func show_str(anon opt: str?) -> str {
    let .Some(s) = opt else { return "no str" }
    return f"str '{s}' len {len(s)}"
}

func show_point(anon opt: Point?) -> str {
    let .Some(p) = opt else { return "no point" }
    return f"point {p.x},{p.y}"
}

func is_none(anon opt: int64?) -> bool {
    let .None = opt else { return false }
    return true
}

func lookup(anon key: str) -> int64? {
    if key == "two" {
        return 2
    }
    return none
}

func sum_present(anon keys: [str]) -> int64 {
    mut total = 0
    for key in keys {
        let .Some(n) = lookup(key) else { continue }
        total += n
    }
    return total
}

func handle(anon req: json.Value) -> str {
    let .Some(method) = req.get("method").as_str() else {
        return "no method"
    }
    let .Some(id) = req.get("id").as_int() else {
        return f"{method}: no id"
    }
    return f"{method} #{id}"
}

test "let else on optionals of each kind" {
    assert show_int(0) == "int 0"
    assert show_int(2) == "int 2"
    assert show_int(42) == "int 42"
    assert show_int(none) == "no int"
    assert show_str("hi") == "str 'hi' len 2"
    assert show_str("") == "str '' len 0"
    assert show_str(none) == "no str"
    assert show_point(Point(x: 3, y: 4)) == "point 3,4"
    assert show_point(none) == "no point"
    assert is_none(none).to_str() == "true"
    assert is_none(0).to_str() == "false"
}

test "let else with continue" {
    assert sum_present(["one", "two", "three", "two"]) == 4
}

test "let else in sequence" {
    assert handle(must json.parse("{\"method\": \"ping\", \"id\": 7}")) == "ping #7"
    assert handle(must json.parse("{\"method\": \"ping\"}")) == "ping: no id"
    assert handle(must json.parse("{\"id\": 7}")) == "no method"
}

test "let else in a test body" {
    let explicit: int64? = 5
    let .Some(e) = explicit else {
        fail("explicit is none")
        return
    }
    assert e == 5
    let y: int64? = 9
    let .Some(v) = y else {
        fail("y is none")
        return
    }
    assert v == 9
}
