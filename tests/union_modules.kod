// A union is one type however, and wherever, it is spelled.
import "./union_dep"
import "./union_dep" { Value, Unit, describe }

// Declared before the type it holds, and used before it is declared.
type Later = Far | str
type Holder = struct {
    v: Value
    later: Later = "soon"
}
type Boxed = enum {
    Full(v: union_dep.Value)
    Empty
}
type Far = struct {
    n: int64
}
type Op = func(int64) -> int64

func spell(anon v: int64 | union_dep.Unit | str) -> str {
    return describe(v)
}

func twice(anon n: int64) -> int64 {
    return n * 2
}

func apply(anon f: Op | int64) -> int64 {
    match f {
        g: Op -> return g(4)
        n: int64 -> return n
    }
}

func main() -> int64 {
    print(spell(1))
    print(spell("s"))
    print(spell(Unit(name: "m")))
    print(describe(union_dep.default_value()))
    let h = Holder(v: 3)
    print(describe(h.v))
    if h.later is s: str {
        print(s)
    }
    let far: Later = Far(n: 6)
    if far is f: Far {
        print_int(f.n)
    }
    let b: Boxed = .Full(v: "boxed")
    match b {
        .Full(v) -> print(describe(v))
        .Empty -> print("empty")
    }
    print_int(apply(twice))
    print_int(apply(5))

    // A let-else takes a member through `Some`.
    let maybe: Value | none = "there"
    let .Some(s: str) = maybe else { return 1 }
    print(s)
    return 0
}

// expected output:
// number 1
// text s
// unit m
// unit kg
// number 3
// soon
// 6
// text boxed
// 8
// 5
// there
