// As a value, `len` is its `str` form, wherever the name falls back to it.
func main() -> int64 {
    let lv = len
    print_int(lv("xy"))
    let f: func(str) -> int64 = len
    print_int(f("abcd"))
    if true {
        let len = 4
        print_int(len)
    }
    let after = len
    print_int(after("abc"))
    return 0
}

// expected output:
// 2
// 4
// 4
// 3
