// A small HTTP server: each connection is a task of its own, so a slow
// request doesn't hold up the others (docs/http.md#serving).
//
//   kod run examples/hello_server.kod 8080
//
// GET /               hello (GET /?name=Ada: hello, Ada)
// GET /greet/{name}   hello to that name, as JSON
// GET /slow?ms=N      answers after N milliseconds (at most 10000)
// POST /echo          gives back the body
// GET /squares?n=N    N lines, written as they go out
// POST /size          the length of a body of any size, read as it comes
// Ctrl-C ends it, once the requests being answered are done.
import "io"
import "json"
import "net/http"
import "net/http" { BodyWriter, HttpError, Request, Response }
import "time"
import "time" { Duration }

func hello(anon req: Request) -> Response or Error {
    if req.query("name") is str(name) {
        return http.text(f"hello, {name}\n")
    }
    return http.text("hello\n")
}

func greet(anon req: Request) -> Response or Error {
    let greeting = f"hello, {req.param("name")}"
    return http.json(f"\{\"greeting\": {json.escape_string(greeting)}\}\n")
}

func slow(anon req: Request) -> Response or Error {
    let Some(ms) = (req.query("ms")? or "100").parse_int() else {
        throw HttpError(status: 400, message: "ms is a number")
    }
    if ms > 10000 {
        throw HttpError(status: 400, message: "ms is at most 10000")
    }
    time.sleep(Duration(:ms))
    return http.text(f"slept {ms} ms\n")
}

func echo(anon req: Request) -> Response or Error {
    return http.text(req.text())
}

func squares(anon req: Request) -> Response or Error {
    let n = (req.query("n")? or "10").parse_int()? or 10
    return http.stream(func(anon w: BodyWriter) -> none or Error {
        for i in 0..n {
            try w.write_str(f"{i} {i * i}\n")
        }
    }, content_type: "text/plain")
}

func size(anon req: Request) -> Response or Error {
    let body = req.reader()
    mut total: int64 = 0
    for true {
        let piece = try body.read(65536)
        if len(piece) == 0 {
            return http.text(f"{total}\n")
        }
        total += len(piece)
    }
}

func main(argv: [str]) -> int64 {
    mut port: int64 = 8080
    if len(argv) == 2 {
        port = argv[1].parse_int()? or -1
    }
    if len(argv) > 2 or port < 0 {
        io.write_stderr("usage: hello_server [PORT]\n")
        return 2
    }
    let routes = http.Router()
    routes.get("/", hello)
    routes.get("/greet/{name}", greet)
    routes.get("/slow", slow)
    routes.post("/echo", echo)
    routes.get("/squares", squares)
    routes.post("/size", size, stream_body: true)
    print(f"listening on http://127.0.0.1:{port}")
    if http.Server(:port, :routes, access_log: true).run() is Err(e) {
        io.write_stderr(f"{e.to_str()}\n")
        return 1
    }
    return 0
}
