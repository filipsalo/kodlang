// `xs += [x]` appends in place without building a one-element array; the
// element converts to the array's element type as it would in the literal.
interface Shape {
    func area(self) -> int64
}

type Sq = struct {
    s: int64
    func area(self) -> int64 {
        return self.s * self.s
    }
}

type Bag = struct {
    items: [str] = []
}

func main() -> int64 {
    mut xs: [int64] = []
    let alias = xs
    for i in 0..100 {
        xs += [i * i]
    }
    print(f"{len(xs)} {xs[99]} {len(alias)}")

    mut opts: [int64?] = []
    opts += [5]
    opts += [none]
    print(f"{opts[0]? or -1} {opts[1] is none}")

    mut shapes: [Shape] = []
    shapes += [Sq(s: 3)]
    print(f"{shapes[0].area()}")

    mut mixed: [int64 | str] = []
    mixed += [7]
    mixed += ["seven"]
    print(f"{mixed[0]} {mixed[1]}")

    let bag = Bag()
    for w in ["a", "b", "c"] {
        bag.items += [w + w]
    }
    print(", ".join(bag.items))

    mut rows: [[int64]] = [[1], [2, 3]]
    rows[0] += [4]
    rows += [[5, 6]]
    print(f"{len(rows)} {rows[0][1]} {rows[2][1]}")

    mut names: [str] = []
    for i in 0..1000 {
        names += [f"n{i}"]
    }
    print(names[999])
    return 0
}

// expected output:
// 100 9801 100
// 5 true
// 9
// 7 seven
// aa, bb, cc
// 3 4 6
// n999
