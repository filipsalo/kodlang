// The interpreter checks the type names a function body writes before main
// runs, as the compiler does, so a function that never runs is checked too.
import "./downcast_generic_xmod_dep"

func holds(anon s: downcast_generic_xmod_dep.Shape) -> bool {
    return s is downcast_generic_xmod_dep.Box
}

func main() -> int64 {
    print("ran")
    return 0
}

// expected status:
// 1
// expected stderr:
// 6:17: error: `downcast_generic_xmod_dep.Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = downcast_generic_xmod_dep.Box[int64]`
// expected mode:
// interpret
