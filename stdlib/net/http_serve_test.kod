// Serving HTTP, and requests made at the same time in tasks (docs/http.md).
import "net/http" { Client, Incoming, Response, get, post, read_request, respond, serve, write_response }
import "net/tcp"
import "strbuilder" { StrBuilder }
import "stream" { BufReader, IoError, MemReader, MemWriter }
import "tasks"
import "time"
import "time" { Duration, monotonic_ns }

func reader(anon text: str) -> BufReader {
    return BufReader(inner: MemReader(data: kod_str_to_bytes(text), pos: 0))
}

test "read_request: the request line, headers and a body" {
    let br = reader("\r\nPOST /items?x=1 HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\n\r\nhelloGET / HTTP/1.0\r\n\r\n")
    let first = must must read_request(br)
    assert first.method == "POST"
    assert first.target == "/items?x=1"
    assert first.path() == "/items"
    assert must first.headers.get("host") == "a"
    assert first.text() == "hello"
    assert first.keep_alive
    let second = must must read_request(br)
    assert second.target == "/"
    assert second.text() == ""
    assert not second.keep_alive
    assert must read_request(br) is none
}

test "read_request: a chunked body, and keep-alive by the Connection header" {
    let br = reader("PUT /c HTTP/1.1\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nabc\r\n0\r\n\r\n")
    let req = must must read_request(br)
    assert req.text() == "abc"
    assert not req.keep_alive
    let old = must must read_request(reader("GET / HTTP/1.0\r\nConnection: keep-alive\r\n\r\n"))
    assert old.keep_alive
}

test "read_request: broken requests are protocol errors" {
    for text in ["GET /\r\n\r\n", "GET / HTTP/2.0\r\n\r\n", "G@T / HTTP/1.1\r\n\r\n", "GET / HTTP/1.1\r\nbad\r\n\r\n", "GET / HTTP/1.1\r\n"] {
        let got = read_request(reader(text))
        mut kind = ""
        if got is Err(e) and e is IoError(io) {
            kind = f"{io.kind}"
        }
        if kind != "Protocol" and kind != "UnexpectedEof" {
            fail(f"{text}: not a protocol error")
        }
    }
}

test "write_response: status line, length, and Connection: close unless kept alive" {
    let w = MemWriter(buf: StrBuilder())
    must write_response(w, respond(404, "gone"))
    assert kod_bytes_to_str(w.to_bytes()) == "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 4\r\nConnection: close\r\n\r\ngone"
    let kept = MemWriter(buf: StrBuilder())
    let resp = respond(200, "", content_type: "application/json")
    resp.reason = "Fine"
    must write_response(kept, resp, keep_alive: true)
    assert kod_bytes_to_str(kept.to_bytes()) == "HTTP/1.1 200 Fine\r\nContent-Type: application/json\r\nContent-Length: 0\r\n\r\n"
    let bad = respond(200, "")
    bad.headers.add("X", "a\r\nb")
    assert write_response(MemWriter(buf: StrBuilder()), bad) is Err(_)
}

func answer(anon req: Incoming) -> Response {
    if req.path() == "/slow" {
        time.sleep(Duration(ms: 100))
        return respond(200, "slow")
    }
    if req.method == "POST" {
        return respond(201, f"got {req.text()}")
    }
    return respond(200, f"{req.method} {req.target}")
}

func body_of(anon url: str) -> str or Error {
    let r = try get(url)
    return f"{r.status} {r.text()}"
}

func ms_since(anon t0: int64) -> int64 {
    return (monotonic_ns() - t0) / 1000000
}

test "a server and its clients in one program, requests at the same time" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let base = f"http://127.0.0.1:{l.port()}"
    let server = spawn serve(l, answer)
    assert must body_of(base + "/a?b=c") == "200 GET /a?b=c"
    let t0 = monotonic_ns()
    let a = spawn body_of(base + "/slow")
    let b = spawn body_of(base + "/slow")
    let c = spawn body_of(base + "/slow")
    assert must a.wait() == "200 slow"
    assert must b.wait() == "200 slow"
    assert must c.wait() == "200 slow"
    assert ms_since(t0) < 250
    let posted = must post(base + "/p", kod_str_to_bytes("x=1"), content_type: "text/plain")
    assert posted.status == 201
    assert posted.text() == "got x=1"
    server.cancel()
    if server.wait() is Err(e) and e is IoError(io) {
        assert io.kind == .Cancelled
    } else {
        fail("serve didn't end with an error")
    }
    must l.close()
}

test "a Client keeps its connection to the server, shared between tasks" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let base = f"http://127.0.0.1:{l.port()}"
    let server = spawn serve(l, answer)
    let client = Client()
    let first = must client.get(base + "/1")
    assert first.text() == "GET /1"
    assert first.keep_alive
    let x = spawn client.get(base + "/slow")
    let y = spawn client.get(base + "/slow")
    assert (must x.wait()).text() == "slow"
    assert (must y.wait()).text() == "slow"
    client.close()
    server.cancel()
    let _ = server.wait()
    must l.close()
}

test "a request the server can't read gets a 400" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let server = spawn serve(l, answer)
    let conn = must tcp.connect("127.0.0.1", port: l.port())
    must conn.write(kod_str_to_bytes("NOT HTTP\r\n\r\n"))
    let back = kod_bytes_to_str(must conn.read(1000))
    assert back.starts_with("HTTP/1.1 400 Bad Request\r\n")
    must conn.close()
    server.cancel()
    let _ = server.wait()
    must l.close()
}
