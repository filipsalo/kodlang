// `is` on a generic instance holds wherever the value was boxed: in the
// module that declares the instance's alias or in one that names the same
// instance through an alias of its own.
import "./../downcast_generic_xmod_dep"

type MyBox = downcast_generic_xmod_dep.Box[int64]
type StrBox = downcast_generic_xmod_dep.Box[str]

test "is holds for a generic instance boxed in another module" {
    let theirs = downcast_generic_xmod_dep.boxed()
    assert f"{theirs is downcast_generic_xmod_dep.IntBox} {theirs is MyBox} {theirs is StrBox}" == "true true false"
    if theirs is MyBox(b) {
        assert b.v == 3
    } else {
        fail("not MyBox")
    }
    match theirs {
        downcast_generic_xmod_dep.IntBox(b) -> assert b.v + 1 == 4
        else -> fail("not an IntBox")
    }
}

test "is holds for one boxed here and checked there" {
    let mine: downcast_generic_xmod_dep.Shape = MyBox(v: 5)
    let other: downcast_generic_xmod_dep.Shape = StrBox(v: "s")
    assert f"{downcast_generic_xmod_dep.holds_int_box(mine)} {downcast_generic_xmod_dep.holds_int_box(other)}" == "true false"
    assert downcast_generic_xmod_dep.unbox(mine) == 5
    assert downcast_generic_xmod_dep.unbox(other) == -1
}
