// Primitive method dispatch via `x.to_str()` — routed through
// stdlib/primitives/<kind>.kod.

test "to_str and hash on primitives" {
    let n: int64 = 42
    let s: str = "hello"
    let b: bool = true

    assert n.to_str() == "42"
    assert s.to_str() == "hello"
    assert b.to_str() == "true"

    let h: int64 = s.hash()
    assert h.to_str() == "210714636441"
}
