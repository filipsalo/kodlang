// `try x` or `must x` on its own line narrows `x` for the rest of the block.

type Oops = shared struct {
    code: int64

    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

func get(anon n: int64) -> int64 or Error {
    if n < 0 {
        throw Oops(code: n)
    }
    return n
}

func plus_one(anon n: int64) -> int64 or Error {
    let r = get(n)
    try r
    return r + 1
}

func param(anon r: int64 or Error) -> int64 or Error {
    try r
    return r * 10
}

// The rest assigns `r`, so it keeps its declared type.
func reassigned(anon n: int64) -> int64 or Error {
    mut r = get(n)
    try r
    r = get(n + 1)
    return try r
}

func main() -> int64 {
    print(must plus_one(2))
    print(plus_one(-3) is Err)
    print(must param(get(4)))
    print(must reassigned(5))

    let o: int64? = 7
    must o
    print(o + 1)

    let r = get(8)
    if true {
        must r
        print(r + 2)
    }
    print(r is Ok)

    let xs: [int64?] = [1, 2, 3]
    mut sum = 0
    for x in xs {
        must x
        sum += x
    }
    print(sum)

    let missing: str? = none
    must missing
    print(missing.upper())
    return 0
}

// expected output:
// 3
// true
// 40
// 6
// 8
// 10
// true
// 6
// expected stderr:
// must on none
// expected status:
// 1
