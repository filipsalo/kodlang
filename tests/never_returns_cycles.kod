// Thirty `-> none` methods and functions that call each other: deciding
// whether each returns stays polynomial. A default of a call that never
// returns needs no value.
type Walker = struct {
    depth: int64 = 0
    visits: int64 = 0

    func on0(self) -> none {
        self.depth += 1
        self.visits += 1
        if self.depth < 1 {
            self.on1()
        }
        if self.depth < 2 {
            self.on2()
        }
        if self.depth < 3 {
            self.on3()
        }
        self.depth -= 1
    }

    func on1(self) -> none {
        self.depth += 1
        self.visits += 1
        if self.depth < 1 {
            self.on2()
