// A dep that imports this module back registers its enum a second time;
// both registrations are the same `Shape`.
import "./../cyclic_import_enum_dep"

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
}

func area(anon s: Shape) -> int64 {
    match s {
        .Circle(r) -> return r
        .Rect(w, h) -> return w * h
    }
}

test "both registrations of the enum are the same type" {
    let u = .Circle(r: 4)
    assert area(u) + cyclic_import_enum_dep.count() == 7
    assert cyclic_import_enum_dep.measure(u) == 40
    let v: Shape = .Rect(w: 2, h: 3)
    assert cyclic_import_enum_dep.measure(v) == 5
}
