// Colour for a terminal. See docs/io.md.
import "env"
import "posix" { Fd }

// Whether to colour what goes to `fd`: it is a terminal, `NO_COLOR` is unset
// or empty, and `TERM` isn't `dumb`.
func colour(anon fd: Fd) -> bool {
    if not fd.is_terminal() {
        return false
    }
    if len(env.get("NO_COLOR")? or "") > 0 {
        return false
    }
    return (env.get("TERM")? or "") != "dumb"
}

func _style(anon text: str, code: str) -> str {
    return f"\u{1b}[{code}m{text}\u{1b}[0m"
}

func bold(anon text: str) -> str {
    return _style(text, code: "1")
}

func dim(anon text: str) -> str {
    return _style(text, code: "2")
}

func red(anon text: str) -> str {
    return _style(text, code: "31")
}

func green(anon text: str) -> str {
    return _style(text, code: "32")
}

func yellow(anon text: str) -> str {
    return _style(text, code: "33")
}
