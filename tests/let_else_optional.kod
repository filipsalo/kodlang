import "json"

type Point = struct {
    x: int64
    y: int64
}

func show_int(anon opt: int64?) -> str {
    let .Some(n) = opt else { return "no int" }
    return f"int {n}"
}

func show_str(anon opt: str?) -> str {
    let .Some(s) = opt else { return "no str" }
    return f"str '{s}' len {len(s)}"
}

func show_point(anon opt: Point?) -> str {
    let .Some(p) = opt else { return "no point" }
    return f"point {p.x},{p.y}"
}

func is_none(anon opt: int64?) -> bool {
    let .None = opt else { return false }
    return true
}

func lookup(anon key: str) -> int64? {
    if key == "two" {
        return 2
    }
    return none
}

func sum_present(anon keys: [str]) -> int64 {
    mut total = 0
    for key in keys {
        let .Some(n) = lookup(key) else { continue }
        total += n
    }
    return total
}

func handle(anon req: json.Value) -> none {
    let .Some(method) = json.as_str(json.get(req, key: "method")) else {
        print("no method")
        return
    }
    let .Some(id) = json.as_int(json.get(req, key: "id")) else {
        print(f"{method}: no id")
        return
    }
    print(f"{method} #{id}")
}

func main() -> int64 {
    print(show_int(0))
    print(show_int(2))
    print(show_int(42))
    print(show_int(none))
    print(show_str("hi"))
    print(show_str(""))
    print(show_str(none))
    print(show_point(Point(x: 3, y: 4)))
    print(show_point(none))
    print(is_none(none).to_str())
    print(is_none(0).to_str())
    print_int(sum_present(["one", "two", "three", "two"]))
    handle(json.parse("{\"method\": \"ping\", \"id\": 7}"))
    handle(json.parse("{\"method\": \"ping\"}"))
    handle(json.parse("{\"id\": 7}"))
    let explicit: Option[int64] = .Some(value: 5)
    let .Some(e) = explicit else { return 1 }
    print_int(e)
    let y: int64? = 9
    let .Some(v) = y else { return 1 }
    print_int(v)
    return 0
}

// expected output:
// int 0
// int 2
// int 42
// no int
// str 'hi' len 2
// str '' len 0
// no str
// point 3,4
// no point
// true
// false
// 4
// ping #7
// ping: no id
// no method
// 5
// 9
// expected status:
// 0
