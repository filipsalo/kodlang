func parse_num(anon s: str) -> int64? {
    if len(s) == 0 {
        return none
    }
    mut n = 0
    for c in s.code_points() {
        if c < '0' or c > '9' {
            return none
        }
        n = n * 10 + c - '0'
    }
    return n
}

func pick(anon o: str?) -> int64 {
    let x = 5
    let .Some(x) = o else {
        print_int(x)
        return 0
    }
    print(x)
    return 1
}

type Pair = struct {
    a: int64
    b: int64
}

func second(anon o: Pair?) -> int64 {
    let p = "no pair"
    let .Some(p) = o else {
        print(p)
        return -1
    }
    return p.b
}

func main() -> int64 {
    mut total = 0
    for arg in ["12", "x7", "30"] {
        let .Some(arg) = parse_num(arg) else {
            print(f"bad: {arg}")
            continue
        }
        total += arg
    }
    print_int(total)
    print_int(pick(none))
    print_int(pick("hi"))
    print_int(second(none))
    print_int(second(Pair(a: 1, b: 2)))
    return 0
}

// expected output:
// bad: x7
// 42
// 5
// 0
// hi
// 1
// no pair
// -1
// 2
