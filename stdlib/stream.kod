// Byte streams and the I/O error type. See docs/io.md.
import "strbuilder" { StrBuilder }

import "libc"
import "unsafe"

type IoKind = enum {
    NotFound
    PermissionDenied
    AlreadyExists
    InvalidInput
    WouldBlock
    TimedOut
    ConnectionRefused
    ConnectionReset
    BrokenPipe
    UnexpectedEof
    Other
    HostNotFound
    Tls
    Protocol
    // A task waiting for I/O was cancelled (docs/tasks.md).
    Cancelled
}

type IoError = shared struct {
    kind: IoKind
    op: str
    errno: int64
    detail: str

    func to_str(self) -> str {
        return f"{self.op}: {self.detail}"
    }
}

// The kind of failure the macOS error number `err` stands for.
func kind_of_errno(anon err: int64) -> IoKind {
    match err {
        2 -> return .NotFound
        1 | 13 -> return .PermissionDenied
        17 | 48 -> return .AlreadyExists
        9 | 20 | 21 | 22 -> return .InvalidInput
        35 | 60 -> return .TimedOut
        61 -> return .ConnectionRefused
        54 -> return .ConnectionReset
        32 -> return .BrokenPipe
        89 -> return .Cancelled
        else -> return .Other
    }
}

// The error for OS error number `err` raised by `op`.
func os_error(anon op: str, errno: int64) -> IoError {
    return IoError(kind: kind_of_errno(errno), op: op, errno: errno, detail: unsafe.str_at(libc.strerror(errno)))
}

func empty_bytes() -> bytes {
    return kod_str_to_bytes("")
}

interface Reader {
    func read(self, anon max: int64) -> bytes or Error

    // Read until the end of the stream.
    func read_all(self) -> bytes or Error {
        let out = StrBuilder()
        for true {
            let piece = try self.read(65536)
            if len(piece) == 0 {
                return out.to_bytes()
            }
            out.append_bytes(piece)
        }
        return out.to_bytes()
    }

    // Writes what is left of the stream to `to`; how many bytes that was.
    func copy_to(self, anon to: Writer) -> int64 or Error {
        mut total: int64 = 0
        for true {
            let piece = try self.read(65536)
            if len(piece) == 0 {
                return total
            }
            try to.write_all(piece)
            total += len(piece)
        }
        return total
    }

    // Exactly n bytes, or an UnexpectedEof error.
    func read_exact(self, anon n: int64) -> bytes or Error {
        let out = StrBuilder()
        for out.len() < n {
            let piece = try self.read(n - out.len())
            if len(piece) == 0 {
                throw IoError(kind: .UnexpectedEof, op: "read", errno: 0, detail: f"stream ended after {out.len()} of {n} bytes")
            }
            out.append_bytes(piece)
        }
        return out.to_bytes()
    }
}

// The most of a write_all one write is given.
let WRITE_PIECE: int64 = 262144

interface Writer {
    func write(self, anon data: bytes) -> int64 or Error

    // Write every byte, repeating short writes.
    func write_all(self, anon data: bytes) -> none or Error {
        let total = len(data)
        mut done: int64 = 0
        for done < total {
            // Not all that is left: each write that takes only a part would
            // copy it again.
            mut end = done + WRITE_PIECE
            if end > total {
                end = total
            }
            let n = try self.write(data[done..end])
            if n <= 0 {
                throw IoError(kind: .Other, op: "write", errno: 0, detail: "write returned 0")
            }
            done = done + n
        }
    }

    func write_str(self, anon text: str) -> none or Error {
        try self.write_all(kod_str_to_bytes(text))
    }
}

type MemReader = shared struct {
    data: bytes
    pos: int64

    func read(self, anon max: int64) -> bytes or Error {
        let end = self.pos + max
        if max <= 0 or self.pos >= len(self.data) {
            return empty_bytes()
        }
        let piece = self.data[self.pos..end]
        self.pos = self.pos + len(piece)
        return piece
    }
}

type MemWriter = shared struct {
    buf: StrBuilder

    func write(self, anon data: bytes) -> int64 or Error {
        self.buf.append_bytes(data)
        return len(data)
    }

    func to_bytes(self) -> bytes {
        return self.buf.to_bytes()
    }

    func to_str(self) -> str {
        return self.buf.to_str()
    }
}

// Where the first byte `delim` at or after `from` is; the length when there is none.
func _index_of(anon data: bytes, anon delim: int64, from: int64) -> int64 {
    let n = len(data)
    let ones = 0x0101010101010101
    let same = (delim & 255) * ones
    mut i = from
    for i + 8 <= n {
        // A byte of `x` is 0 where `delim` is, the lowest such byte's high bit the
        // lowest bit in `hits`.
        let x = kod_bytes_le64(data, i) ^ same
        let hits = x - ones & (x ^ -1) & ones << 7
        if hits != 0 {
            return i + (hits.trailing_zeros() >> 3)
        }
        i += 8
    }
    for i < n and data[i] != delim {
        i += 1
    }
    return i
}

type BufReader = shared struct {
    inner: Reader
    limit: int64 = 1048576
    chunk: int64 = 8192
    buf: bytes = kod_str_to_bytes("")
    pos: int64 = 0
    ended: bool = false

    func read(self, anon max: int64) -> bytes or Error {
        if max <= 0 {
            return empty_bytes()
        }
        if self.pos < len(self.buf) {
            mut end = self.pos + max
            if end > len(self.buf) {
                end = len(self.buf)
            }
            let piece = self.buf[self.pos..end]
            self.pos = end
            return piece
        }
        return try self.inner.read(max)
    }

    func read_until(self, anon delim: int64) -> bytes? or Error {
        let out = StrBuilder()
        for true {
            if self.pos >= len(self.buf) {
                let more = try self.inner.read(self.chunk)
                if len(more) == 0 {
                    if out.len() == 0 {
                        return none
                    }
                    self.ended = true
                    return out.to_bytes()
                }
                self.buf = more
                self.pos = 0
            }
            let n = len(self.buf)
            let i = _index_of(self.buf, delim, from: self.pos)
            // All of it in one piece, as it mostly is.
            if i < n and out.len() == 0 and i - self.pos <= self.limit {
                let piece = self.buf[self.pos..i]
                self.pos = i + 1
                return piece
            }
            out.append_bytes(self.buf[self.pos..i])
            if out.len() > self.limit {
                throw IoError(kind: .InvalidInput, op: "read", errno: 0, detail: "line too long")
            }
            if i < n {
                self.pos = i + 1
                return out.to_bytes()
            }
            self.pos = n
        }
        return none
    }

    func read_line(self) -> str? or Error {
        // All of it is here, as it mostly is: copied once, without its line end.
        let i = _index_of(self.buf, 10, from: self.pos)
        if i < len(self.buf) and i - self.pos <= self.limit {
            mut end = i
            if end > self.pos and self.buf[end - 1] == 13 {
                end -= 1
            }
            let line = kod_bytes_to_str(self.buf[self.pos..end])
            self.pos = i + 1
            return line
        }
        let raw = try self.read_until(10)
        if raw is none {
            return none
        }
        let text = kod_bytes_to_str(raw)
        let n = len(text)
        if n > 0 and text[n - 1] == 13 {
            return text[0..n - 1]
        }
        return text
    }
}
