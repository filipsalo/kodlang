// `<`, `<=`, `>` and `>=` on two str or bytes values compare contents byte by byte.
func main() -> int64 {
    let a = "zebra"
    let b = "apple"
    print(f"{a < b} {b < a} {a > b} {a >= b} {b <= a}")
    let c = "apples"
    print(f"{b < c} {c < b} {b <= b} {b >= b} {b < b}")
    print(f"{b < c < a} {"" < b} {"é" > "z"}")
    let x = b"ab"
    let y = b"b"
    print(f"{x < y} {x > y} {x <= x}")
    mut words = ["pear", "fig", "apple"]
    mut swapped = true
    for swapped {
        swapped = false
        mut i = 0
        for i + 1 < len(words) {
            if words[i] > words[i + 1] {
                let t = words[i]
                words[i] = words[i + 1]
                words[i + 1] = t
                swapped = true
            }
            i = i + 1
        }
    }
    print(f"{words[0]} {words[1]} {words[2]}")
    return 0
}

// expected output:
// false true true true true
// true false true true false
// true true true
// true false true
// apple fig pear
