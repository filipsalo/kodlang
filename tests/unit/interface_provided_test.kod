// Interface methods with a body: every implementing type has them.

interface Counter {
    func next(self) -> int64

    // Provided: built on `next` only.
    func sum(self, anon n: int64) -> int64 {
        mut total = 0
        for _ in 0..n {
            total += self.next()
        }
        return total
    }

    // Provided, calling another provided method, with a default.
    func average(self, anon n: int64, scale: int64 = 1) -> int64 {
        return self.sum(n) * scale / n
    }

    func describe(self) -> str {
        if self is Steps(s) {
            return f"steps of {s.by}"
        }
        return label(self)
    }
}

func label(anon c: Counter) -> str {
    return f"counter at {c.next()}"
}

type Steps = shared struct {
    by: int64
    at: int64 = 0

    func next(self) -> int64 {
        self.at += self.by
        return self.at
    }
}

// Overrides `sum`; `average` then uses it through the interface.
type Constant = shared struct {
    value: int64

    func next(self) -> int64 {
        return self.value
    }

    func sum(self, anon n: int64) -> int64 {
        return 1000 + self.value * n
    }
}

type Dice = enum {
    Six
    Twenty

    func next(self) -> int64 {
        match self {
            .Six -> return 6
            .Twenty -> return 20
        }
    }
}

interface Shouty {
    func to_str(self) -> str

    func shout(self) -> str {
        return self.to_str().upper() + "!"
    }
}

test "provided methods on a struct" {
    let s = Steps(by: 2)
    assert s.sum(3) == 12                   // 2 + 4 + 6
    assert s.average(2) == 9                // (8 + 10) / 2
    assert s.describe() == "steps of 2"

    let c: Counter = Steps(by: 1)
    assert c.sum(4) == 10                   // 1 + 2 + 3 + 4
    assert c.average(2, scale: 10) == 55    // (5 + 6) * 10 / 2
}

test "a type's own method overrides a provided one" {
    let k = Constant(value: 3)
    assert k.sum(2) == 1006
    let kc: Counter = k
    assert kc.sum(2) == 1006
    assert kc.average(2) == 503             // (1000 + 6) / 2
    assert kc.describe() == "counter at 3"
}

test "provided methods on an enum and through an array" {
    assert Dice.Twenty.sum(2) == 40
    let d: Counter = Dice.Six
    assert d.average(3) == 6

    let counters: [Counter] = [Steps(by: 10), Constant(value: 1), Dice.Six]
    mut sums: [int64] = []
    for each in counters {
        sums += [each.sum(2)]
    }
    assert sums == [30, 1002, 12]
}

test "provided methods on primitives" {
    let n = 42
    assert n.shout() == "42!"
    assert "hey".shout() == "HEY!"
    let sh: Shouty = true
    assert sh.shout() == "TRUE!"
}
