import "kod/lexing"
import "kod/ast"

// A grouped literal's text without its spaces.
func strip_spaces(anon s: str) -> str {
	mut out: str = ""
	for i in 0..len(s) {
		if s[i] != ' ' {
			out = out + s[i..i + 1]
		}
	}
	return out
}

func str_to_int(anon s: str) -> int64 {
	// Base-prefix forms — lexer's already validated digit-set membership.
	if len(s) >= 2 and s[0] == '0' {
		if s[1] == 'x' {
			return parse_hex_after_prefix(s)
		}
		if s[1] == 'o' {
			return parse_int_radix(s, base: 8, start: 2)
		}
		if s[1] == 'b' {
			return parse_int_radix(s, base: 2, start: 2)
		}
	}
	// Decimal: thousands-grouped literals (`1 000 000`) reach str_to_int
	// with embedded spaces; the lexer has already validated grouping,
	// so here we just skip them.
	mut result: int64 = 0
	mut i: int64 = 0
	for i < len(s) {
		if s[i] == ' ' {
			i = i + 1
		} else {
			result = result * 10 + s[i] - '0'
			i = i + 1
		}
	}
	return result
}

// 0 when the literal fits int64, 1 when it is 2^63 (whose negation does), 2 when larger.
func literal_excess(anon s: str) -> int64 {
	mut base: int64 = 10
	mut i: int64 = 0
	if len(s) >= 2 and s[0] == '0' {
		if s[1] == 'x' {
			base = 16
			i = 2
		} else if s[1] == 'o' {
			base = 8
			i = 2
		} else if s[1] == 'b' {
			base = 2
			i = 2
		}
	}
	let max: int64 = 9223372036854775807
	mut value: int64 = 0
	mut excess: int64 = 0
	for i < len(s) {
		let c = s[i]
		if c != ' ' {
			mut d: int64 = c - '0'
			if c >= 'a' and c <= 'f' {
				d = c - 'a' + 10
			}
			if c >= 'A' and c <= 'F' {
				d = c - 'A' + 10
			}
			if excess > 0 {
				excess = 2
			} else if value > (max - d) / base {
				excess = 2
				if (max - d) % base == base - 1 and value == (max - d) / base + 1 {
					excess = 1
				}
			} else {
				value = value * base + d
			}
		}
		i = i + 1
	}
	return excess
}

// Parse a 0/1/.../7 string starting at `start` in base `base`. Used
// for `0o…` and `0b…` literals — both narrow enough to share one loop.
func parse_int_radix(anon s: str, base: int64, start: int64) -> int64 {
	mut result: int64 = 0
	for i in start..len(s) {
		result = result * base + s[i] - '0'
	}
	return result
}

// Hex needs its own loop because `a..f` and `A..F` map outside the
// `c - '0'` range used by the radix loop.
func parse_hex_after_prefix(anon s: str) -> int64 {
	mut result: int64 = 0
	for i in 2..len(s) {
		let c = s[i]
		mut digit: int64 = 0
		if c >= '0' and c <= '9' {
			digit = c - '0'
		}
		if c >= 'a' and c <= 'f' {
			digit = c - 'a' + 10
		}
		if c >= 'A' and c <= 'F' {
			digit = c - 'A' + 10
		}
		result = result * 16 + digit
	}
	return result
}

// The value of a hex digit, or -1 if `c` isn't one.
func hex_digit_value(anon c: int64) -> int64 {
	if c >= '0' and c <= '9' {
		return c - '0'
	}
	if c >= 'a' and c <= 'f' {
		return c - 'a' + 10
	}
	if c >= 'A' and c <= 'F' {
		return c - 'A' + 10
	}
	return -1
}

// The UTF-8 encoding of code point `cp`, which must be a Unicode scalar value.
func utf8_of(anon cp: int64) -> str {
	if cp < 128 {
		return kod_bytes_to_str(kod_bytes_from_array([cp]))
	}
	if cp < 2048 {
		return kod_bytes_to_str(kod_bytes_from_array([192 + cp / 64, 128 + cp % 64]))
	}
	if cp < 65536 {
		return kod_bytes_to_str(kod_bytes_from_array([224 + cp / 4096, 128 + (cp / 64) % 64, 128 + cp % 64]))
	}
	return kod_bytes_to_str(kod_bytes_from_array([240 + cp / 262144, 128 + (cp / 4096) % 64, 128 + (cp / 64) % 64, 128 + cp % 64]))
}

// Index of the `}` that closes the `\u{...}` escape whose `u` is at `u_at`, or -1 if there
// is no `{` after the `u` or the text between the braces isn't 1 to 6 hex digits.
func read_unicode_escape(anon raw: str, u_at: int64) -> int64 {
	let end: int64 = len(raw)
	if u_at + 1 >= end or raw[u_at + 1] != '{' {
		return -1
	}
	mut j: int64 = u_at + 2
	mut digits: int64 = 0
	for j < end and raw[j] != '}' {
		if hex_digit_value(raw[j]) < 0 {
			return -1
		}
		digits = digits + 1
		j = j + 1
	}
	if j >= end or digits == 0 or digits > 6 {
		return -1
	}
	return j
}

// The code point written between the braces of a `\u{...}` whose `u` is at `u_at`
// and whose closing brace is at `close`.
func unicode_escape_value(anon raw: str, u_at: int64, close: int64) -> int64 {
	mut value: int64 = 0
	mut j: int64 = u_at + 2
	for j < close {
		value = value * 16 + hex_digit_value(raw[j])
		j = j + 1
	}
	return value
}

func is_scalar_value(anon cp: int64) -> bool {
	return cp <= 1114111 and (cp < 55296 or cp > 57343)
}

// What is wrong with the first malformed `\x` or `\u` escape in a raw string body,
// or "" if there is none. Other backslash sequences are never an error.
func escape_problem(anon raw: str) -> str {
	let end: int64 = len(raw)
	mut i: int64 = 0
	for i < end {
		if raw[i] == '\\' and i + 1 < end {
			i = i + 1
			if raw[i] == 'x' {
				if i + 2 >= end or hex_digit_value(raw[i + 1]) < 0 or hex_digit_value(raw[i + 2]) < 0 {
					return "error: invalid escape `\\x`: it needs two hex digits"
				}
				i = i + 2
			} else if raw[i] == 'u' {
				if i + 1 >= end or raw[i + 1] != '{' {
					return "error: invalid escape `\\u`: write the character as `\\u{...}`, for instance `\\u{1F600}`"
				}
				let close: int64 = read_unicode_escape(raw, u_at: i)
				if close < 0 {
					return "error: invalid escape `\\u{...}`: it needs 1 to 6 hex digits between the braces"
				}
				if not is_scalar_value(unicode_escape_value(raw, u_at: i, close: close)) {
					return "error: invalid escape `\\u{...}`: not a Unicode scalar value (above 10FFFF, or a surrogate)"
				}
				i = close
			}
		}
		i = i + 1
	}
	return ""
}

// Process backslash escape sequences in a raw string body.
func unescape_str(anon raw: str) -> str {
	mut result: str = ""
	mut i: int64 = 0
	let end: int64 = len(raw)
	for i < end {
		if raw[i] == '\\' and i + 1 < end {
			i = i + 1
			if raw[i] == 'n' {
				result = result + "\n"
			} else if raw[i] == 't' {
				result = result + "\t"
			} else if raw[i] == 'r' {
				result = result + "\r"
			} else if raw[i] == '\\' {
				result = result + "\\"
			} else if raw[i] == '\'' {
				result = result + "'"
			} else if raw[i] == '0' {
				result = result + "\0"
			} else if raw[i] == '"' {
				// Append a literal " — written via slice because the
				// `\"` escape can't appear in the source until lexer
				// + this fn are both built with `\"` support.
				result = result + raw[i..i+1]
			} else if raw[i] == 'x' {
				// `\xHH`: one byte. A malformed one is reported by escape_problem.
				if i + 2 < end and hex_digit_value(raw[i + 1]) >= 0 and hex_digit_value(raw[i + 2]) >= 0 {
					result = result + kod_bytes_to_str(kod_bytes_from_array([hex_digit_value(raw[i + 1]) * 16 + hex_digit_value(raw[i + 2])]))
					i = i + 2
				}
			} else if raw[i] == 'u' {
				// `\u{H...}`: a character, as UTF-8.
				let close: int64 = read_unicode_escape(raw, u_at: i)
				if close >= 0 {
					let cp: int64 = unicode_escape_value(raw, u_at: i, close: close)
					if is_scalar_value(cp) {
						result = result + utf8_of(cp)
						i = close
					}
				}
			}
		} else {
			result = result + raw[i..i+1]
		}
		i = i + 1
	}
	return result
}

// Dedent a triple-quoted body. `body` is everything between the
// opening and closing `"""` — i.e., raw[3..len(raw)-3]. The first line
// (between opening `"""` and the first `\n`) is discarded; the indent
// of the final line (the one carrying the closing `"""`) is stripped
// from each content line that starts with it. Escape sequences are
// NOT processed here — callers run unescape_str on the result (or on
// each interpolation chunk, for f-strings).
func dedent_triple_body(anon body: str) -> str {
	let n: int64 = len(body)
	mut first_nl: int64 = 0
	for first_nl < n and body[first_nl] != '\n' {
		first_nl = first_nl + 1
	}
	mut content_start: int64 = first_nl
	if content_start < n {
		content_start = content_start + 1
	}
	mut last_nl: int64 = n - 1
	for last_nl >= content_start and body[last_nl] != '\n' {
		last_nl = last_nl - 1
	}
	if last_nl < content_start {
		return ""
	}
	let indent: str = body[last_nl+1..n]
	let indent_len: int64 = len(indent)
	let content: str = body[content_start..last_nl+1]
	mut result: str = ""
	mut line_start: int64 = 0
	let m: int64 = len(content)
	for i in 0..m {
		if content[i] == '\n' {
			mut line: str = content[line_start..i+1]
			if len(line) >= indent_len + 1 {
				mut prefix_match: bool = true
				for p in 0..indent_len {
					if line[p] != indent[p] {
						prefix_match = false
					}
				}
				if prefix_match {
					line = line[indent_len..len(line)]
				}
			}
			result = result + line
			line_start = i + 1
		}
	}
	return result
}

// True if `s` starts with three " characters (the triple-quoted prefix).
// Written character-by-character because Kod doesn't yet have a `\"`
// escape in string literals.
func is_triple_quoted(anon s: str) -> bool {
	return len(s) >= 6 and s[0] == '"' and s[1] == '"' and s[2] == '"'
}

// Parse a string token value (with surrounding quotes) into a Kod string,
// processing escape sequences. Handles both regular "..." and triple
// """...""" forms.
func parse_string_value(anon raw: str) -> str {
	return unescape_str(string_body(raw))
}

// The text between the quotes of a string token, dedented if triple-quoted, with its
// escape sequences still in it.
func string_body(anon raw: str) -> str {
	if is_triple_quoted(raw) {
		return dedent_triple_body(raw[3..len(raw)-3])
	}
	return raw[1..len(raw)-1]
}

// ParseError is the structured diagnostic the parser produces when
// `expect()` finds a token kind that doesn't match. Same field shape
// as codegen.Diagnostic so callers can fold parser errors into the codegen's
// error list without re-formatting (see kodc.kod / tools/lsp.kod).
// The name a payload position binds when it holds pattern `pattern_id`.
func hidden_binding(anon pattern_id: int64) -> str {
	return f"__pat{pattern_id}"
}

func is_hidden_binding(anon name: str) -> bool {
	return name.starts_with("__pat")
}

func payload_bindings(anon items: [ast.SubPattern]) -> [str] {
	mut bindings: [str] = []
	for item in items {
		bindings += [item.binding]
	}
	return bindings
}

type ParseError = struct {
	path: str
	line: int64
	col: int64
	end_col: int64
	message: str
	source_line: str
	caret: str

	func to_str(self) -> str {
		return f"{self.path}:{self.line}:{self.col}: {self.message}"
	}
}

type Parser = struct {
	// Path of the source file this parser was built from. Used by
	// the codegen's error reporter to produce `path:line:col` prefixes.
	path: str
	// The original source text. Kept on the parser so downstream tools
	// (the codegen's error reporter) can decode `Span.start` byte
	// offsets into line:col without re-reading the file.
	source: str
	tokens: [lexing.Token]
	pos: int64

	exprs: [ast.Expr]
	// Parallel to `exprs`: source span for each expression. Indexed
	// by expr_id. Populated by alloc_expr.
	expr_spans: [ast.Span]
	stmts: [ast.Stmt]
	type_exprs: [ast.TypeExpr]
	patterns: [ast.Pattern]
	// By pattern id: the positions of its payload that hold a pattern.
	pattern_subs: [[ast.SubPattern]] = []
	match_arms: [ast.MatchArm]
	match_expr_arms: [ast.MatchExprArm]
	func_decls: [ast.FuncDecl]

	// Errors accumulated by `expect`/`expect_identifier` when the
	// next token doesn't have the expected kind. Empty means the
	// input parsed cleanly. Inspect this after `parse_module` —
	// the parser advances past the bad token and keeps going so
	// downstream errors don't cascade off the original cause.
	errors: [ParseError]

	// Lazy cache of line-start byte offsets. `line_starts[i]` is the
	// byte offset of the (i+1)-th line; line 1 starts at 0. Built
	// the first time `codegen.line_of_offset` runs against this
	// parser, then reused for every subsequent lookup (per-statement
	// backtrace line tracking does thousands of these per module).
	line_starts: [int64] = []
	// Parallel to `type_exprs`: the span of each type's first token.
	type_spans: [ast.Span] = []
	// IntLit exprs whose literal doesn't fit, so codegen gives them no kind.
	bad_lits: [int64] = []
	// Parallel to `patterns`: where each pattern's last token ends.
	pattern_ends: [int64] = []
	// Parallel to `type_exprs` up to the last qualified one: the module alias a
	// type is written with (`pa` of `pa.Pt`), or "". Missing entries are "".
	type_quals: [str] = []
	// How many bindings got a name of their own (`x#1`) because they hide one in force.
	renames: int64 = 0
	// Match expressions parsed so far, so a FuncDecl can tell whether its body has one.
	binding_exprs: int64 = 0
	// The module-level constants parsed so far: their names, and the expressions that
	// give their values (for the check that none refers to itself).
	const_names: [str] = []
	const_exprs: [int64] = []
	const_spans: [ast.Span] = []
	// Each local a function binds (parameter, `let`, `mut`, `for` variable,
	// pattern binding) and where its name starts, for codegen's checks.
	// Whether the arm's patterns just parsed have a guard after them.
	arm_guarded: bool = false
	// Above zero while an `is` right-hand side parses, where `name: T` in a payload is a type pattern.
	in_is_rhs: int64 = 0
	binding_names: [str] = []
	binding_starts: [int64] = []

	func peek(self) -> lexing.Token {
		if self.pos >= len(self.tokens) {
			return self.tokens[len(self.tokens) - 1]
		}
		return self.tokens[self.pos]
	}

	func peek_kind(self) -> lexing.TokenKind {
		if self.pos >= len(self.tokens) {
			return lexing.TokenKind.EOF
		}
		return self.tokens[self.pos].kind
	}

	func peek_kind_at(self, anon offset: int64) -> lexing.TokenKind {
		let idx: int64 = self.pos + offset
		if idx >= len(self.tokens) {
			return lexing.TokenKind.EOF
		}
		return self.tokens[idx].kind
	}

	// Past-the-end stays at the final token (always lexing.TokenKind.EOF).
	// Without this clamp, error-recovery advances past the EOF token and
	// peek_kind starts reading garbage memory; the parse loop then sees
	// non-EOF kinds and never terminates.
	func advance(self) -> lexing.Token {
		if self.pos >= len(self.tokens) {
			return self.tokens[len(self.tokens) - 1]
		}
		let tok: lexing.Token = self.tokens[self.pos]
		self.pos = self.pos + 1
		return tok
	}

	func at(self, anon kind: lexing.TokenKind) -> bool {
		return self.peek_kind() == kind
	}

	func try_consume(self, anon kind: lexing.TokenKind) -> bool {
		if self.peek_kind() == kind {
			self.advance()
			return true
		}
		return false
	}

	func expect(self, anon kind: lexing.TokenKind) -> lexing.Token {
		if self.peek_kind() != kind {
			self.record_unexpected(expected: lexing.kind_name(kind), got: self.peek())
		}
		return self.advance()
	}

	// expect_identifier for a name a local binds, noted in binding_names.
	func binding_identifier(self) -> str {
		self.binding_starts += [self.peek().start]
		let name = self.expect_identifier()
		self.binding_names += [name]
		return name
	}

	func expect_identifier(self) -> str {
		if self.peek_kind() != .Identifier {
			self.record_unexpected(expected: "identifier", got: self.peek())
		}
		return self.advance().value
	}

	// Push a structured ParseError onto self.errors. Mirrors the
	// line/col/source_line/caret computation in codegen.report_error so
	// callers can render parse errors the same way (and the LSP can
	// publish them as Diagnostics without reformatting).
	func record_unexpected(self, expected: str, got: lexing.Token) -> none {
		self.record_error(f"error: expected {expected}, got {lexing.kind_name(got.kind)}", :got)
	}

	func record_error(self, anon message: str, got: lexing.Token) -> none {
		let offset: int64 = got.start
		mut line: int64 = 1
		mut col: int64 = 1
		mut line_start: int64 = 0
		mut i: int64 = 0
		for i < offset and i < len(self.source) {
			if self.source[i] == '\n' {
				line = line + 1
				col = 1
				line_start = i + 1
			} else {
				col = col + 1
			}
			i = i + 1
		}
		mut line_end: int64 = line_start
		for line_end < len(self.source) and self.source[line_end] != '\n' {
			line_end = line_end + 1
		}
		let raw_line: str = self.source[line_start..line_end]
		mut line_text: str = ""
		for li in 0..len(raw_line) {
			if raw_line[li] == '\t' {
				line_text = line_text + "    "
			} else {
				line_text = line_text + raw_line[li..li+1]
			}
		}
		mut caret: str = ""
		for s in 0..col - 1 {
			if line_start + s < len(self.source) and self.source[line_start + s] == '\t' {
				caret = caret + "    "
			} else {
				caret = caret + " "
			}
		}
		caret = caret + "^"
		// Use the token's own width for the end_col, falling back to one.
		mut width: int64 = got.end - got.start
		if width < 1 {
			width = 1
		}
		let end_col: int64 = col + width
		self.errors += [ParseError(path: self.path, :line, :col, :end_col, :message, source_line: line_text, :caret)]
	}

	// Report a malformed `\x` or `\u` escape in the string body `body` of `tok`.
	func check_escapes(self, anon body: str, tok: lexing.Token) -> none {
		let problem: str = escape_problem(body)
		if len(problem) > 0 {
			self.record_error(problem, got: tok)
		}
	}

	func check_literal_range(self, anon tok: lexing.Token) -> bool {
		if literal_excess(tok.value) > 0 {
			self.record_error(f"error: integer literal `{tok.value}` doesn't fit in `int64`, whose largest value is 9223372036854775807", got: tok)
			return false
		}
		return true
	}

	// Whether the token `offset` ahead continues a postfix chain.
	func postfix_at(self, anon offset: int64) -> bool {
		match self.peek_kind_at(offset) {
			.OpenParen -> return true
			.Dot -> return true
			.OpenBracket -> return true
			.Question -> return true
			else return false
		}
	}

	func skip_newlines(self) -> none {
		for self.at(.EOL) or self.at(.Comment) {
			self.advance()
		}
	}


	func alloc_expr(self, anon e: ast.Expr, span: ast.Span) -> int64 {
		mut id: int64 = len(self.exprs)
		self.exprs += [e]
		self.expr_spans += [span]
		return id
	}

	// Capture the byte offset of the upcoming token. Caller-side
	// helper: stash the result at the top of a parse method, build
	// the expression, then pass the result as the `span` argument
	// to alloc_expr.
	func here(self) -> ast.Span {
		return ast.Span(start: self.peek().start)
	}

	func alloc_stmt(self, anon s: ast.Stmt) -> int64 {
		mut id: int64 = len(self.stmts)
		self.stmts += [s]
		return id
	}

	func alloc_type(self, anon tok: ast.TypeExpr, span: ast.Span, qual: str = "") -> int64 {
		mut id: int64 = len(self.type_exprs)
		self.type_exprs += [tok]
		self.type_spans += [span]
		if len(qual) > 0 {
			for len(self.type_quals) < id {
				self.type_quals += [""]
			}
			self.type_quals += [qual]
		}
		return id
	}

	func alloc_pattern(self, anon p: ast.Pattern) -> int64 {
		mut id: int64 = len(self.patterns)
		self.patterns += [p]
		let no_subs: [ast.SubPattern] = []
		self.pattern_subs += [no_subs]
		mut end: int64 = 0
		if self.pos > 0 {
			end = self.tokens[self.pos - 1].end
		}
		self.pattern_ends += [end]
		return id
	}

	func alloc_match_arm(self, anon a: ast.MatchArm) -> int64 {
		mut id: int64 = len(self.match_arms)
		self.match_arms += [a]
		return id
	}

	func alloc_match_expr_arm(self, anon a: ast.MatchExprArm) -> int64 {
		mut id: int64 = len(self.match_expr_arms)
		self.match_expr_arms += [a]
		return id
	}

	func alloc_func_decl(self, anon f: ast.FuncDecl) -> int64 {
		mut id: int64 = len(self.func_decls)
		self.func_decls += [f]
		return id
	}


	func parse_type_expr_core(self) -> int64 {
		mut span: ast.Span = self.here()
		// Array type: [T]
		if self.try_consume(.OpenBracket) {
			mut inner: int64 = self.parse_type_expr()
			self.expect(.CloseBracket)
			let array_id: int64 = self.alloc_type(ast.TypeExpr.Array(:inner), :span)
			if self.try_consume(.Question) {
				return self.alloc_type(ast.TypeExpr.Optional(inner: array_id), :span)
			}
			return array_id
		}
		// Function type: `func(T1, T2, ...) -> R`. Reuses the `func`
		// keyword (no `fn` token added) — the `(` immediately after
		// disambiguates from a declaration site, which never appears
		// in type position.
		if self.try_consume(.KwFunc) {
			self.expect(.OpenParen)
			mut params: [int64] = []
			if self.peek_kind() != .CloseParen {
				params += [self.parse_type_expr()]
				for self.try_consume(.Comma) {
					params += [self.parse_type_expr()]
				}
			}
			self.expect(.CloseParen)
			self.expect(.Arrow)
			let return_typ: int64 = self.parse_type_expr()
			return self.alloc_type(ast.TypeExpr.Func(:params, :return_typ), :span)
		}
		// `none` doubles as both the keyword for the absent optional and
		// the void-return type. The lexer always lex's it as KwNone, so
		// accept it here without going through expect_identifier (which
		// would otherwise report "expected identifier, got `none`").
		mut name: str = ""
		if self.try_consume(.KwNone) {
			name = "none"
		} else {
			name = self.expect_identifier()
		}
		// Module-qualified type: 'mod.Name', with `mod` kept in type_quals.
		mut qual = ""
		if self.try_consume(.Dot) {
			span = self.here()
			qual = name
			name = self.expect_identifier()
		}
		// Optional: T?
		if self.try_consume(.Question) {
			mut inner: int64 = self.alloc_type(ast.TypeExpr.Named(:name), :span, :qual)
			return self.alloc_type(ast.TypeExpr.Optional(:inner), :span)
		}
		// Generic: T[U] or T[U, V, ...]. Codegen monomorphises per
		// concrete instantiation; preserve every type-argument.
		if self.try_consume(.OpenBracket) {
			mut args: [int64] = [self.parse_type_expr()]
			for self.try_consume(.Comma) {
				args += [self.parse_type_expr()]
			}
			self.expect(.CloseBracket)
			let generic_id: int64 = self.alloc_type(ast.TypeExpr.Generic(:name, :args), :span, :qual)
			if self.try_consume(.Question) {
				return self.alloc_type(ast.TypeExpr.Optional(inner: generic_id), :span)
			}
			return generic_id
		}
		return self.alloc_type(ast.TypeExpr.Named(:name), :span, :qual)
	}

	// `A | B | ...`. `T | none` is `T?` itself, so generic code can bind `T` through it.
	func parse_union_type(self) -> int64 {
		let span: ast.Span = self.here()
		let first: int64 = self.parse_type_expr_core()
		if not self.at(.Pipe) {
			return first
		}
		mut members: [int64] = [first]
		for self.try_consume(.Pipe) {
			members += [self.parse_type_expr_core()]
		}
		mut others: [int64] = []
		for member in members {
			mut is_none = false
			if self.type_exprs[member] is .Named(name) and name == "none" {
				is_none = true
			}
			if not is_none {
				others += [member]
			}
		}
		if len(others) == 0 {
			return first
		}
		if len(others) == 1 and len(members) > 1 {
			return self.alloc_type(ast.TypeExpr.Optional(inner: others[0]), :span)
		}
		return self.alloc_type(ast.TypeExpr.Union(:members), :span)
	}

	func parse_type_expr(self) -> int64 {
		let span: ast.Span = self.here()
		mut id: int64 = self.parse_union_type()
		// Fallible result: `T or Error` desugars to Result[T, Error] — the
		// unified tagged-sum representation. Only `or Error` is supported;
		// the umbrella Error interface is the thrown type. Repeated
		// `(T or Error) or Error` collapses back to the same shape.
		for self.try_consume(.KwOr) {
			let err_tok: lexing.Token = self.peek()
			let err_name: str = self.expect_identifier()
			if err_name == "Error" {
				mut already_result: bool = false
				if self.type_exprs[id] is .Generic(gname, _gargs) and gname == "Result" {
					already_result = true
				}
				if not already_result {
					let error_id: int64 = self.alloc_type(ast.TypeExpr.Named(name: "Error"), span: ast.Span(start: err_tok.start))
					let result_args: [int64] = [id, error_id]
					id = self.alloc_type(ast.TypeExpr.Generic(name: "Result", args: result_args), :span)
				}
			} else {
				if err_tok.kind is .Identifier {
					self.record_error(f"error: only `T or Error` is supported, got `or {err_name}`", got: err_tok)
				}
			}
		}
		return id
	}

	func parse_param(self) -> ast.Param {
		let span: ast.Span = self.here()
		let anonymous: bool = self.try_consume(.KwAnon)
		// `mut` (after optional `anon`) makes the parameter binding
		// reassignable inside the body. Irrelevant to the call site.
		let mutable: bool = self.try_consume(.KwMut)
		let first_start = self.peek().start
		let first: str = self.expect_identifier()
		// Optional second identifier (Swift-style label/binding split):
		// `func greet(who person: str)` — `who` is the label and `person`
		// is the binding. With only one identifier, label and binding
		// are the same name.
		mut name: str = first
		if self.at(.Identifier) {
			name = self.binding_identifier()
		} else if first != "self" {
			self.binding_names += [first]
			self.binding_starts += [first_start]
		}
		mut label: str = first
		if anonymous {
			label = ""
		}
		// Method receiver `self` has no type annotation.
		mut typ: int64 = 0
		if self.try_consume(.Colon) {
			typ = self.parse_type_expr()
		}
		// `name: T = expr` — call-site default. Evaluated fresh
		// at each call in the function's defining module's scope.
		// 0 means "no default declared".
		mut default_expr: int64 = 0
		if self.try_consume(.Equal) {
			default_expr = self.parse_expr()
		}
		return ast.Param(:label, :name, :typ, :anonymous, :span, :mutable, :default_expr)
	}

	func parse_param_list(self) -> [ast.Param] {
		self.expect(.OpenParen)
		mut params: [ast.Param] = []
		self.skip_newlines()
		for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
			let errors_before: int64 = len(self.errors)
			params += [self.parse_param()]
			if len(self.errors) > errors_before {
				break
			}
			self.skip_newlines()
			if not self.try_consume(.Comma) {
				break
			}
			self.skip_newlines()
		}
		self.expect(.CloseParen)
		return params
	}


	func pattern_of_expr(self, anon expr_id: int64) -> int64 {
		let none_bindings: [str] = []
		match self.exprs[expr_id] {
			.IntLit(value) -> return self.alloc_pattern(ast.Pattern.IntPat(:value))
			.StrLit(value) -> return self.alloc_pattern(ast.Pattern.StrPat(:value))
			.BoolLit(value) -> return self.alloc_pattern(ast.Pattern.BoolPat(:value))
			.NoneLit -> return self.alloc_pattern(ast.Pattern.NonePat)
			.ImplicitVariant(name) -> return self.alloc_pattern(ast.Pattern.ImplicitEnumPat(variant_name: name, bindings: none_bindings))
			.Ident(name) -> return self.named_pattern(name, binding: "")
			.Binary(lhs, op, rhs) -> {
				// `-1` parsed as `0 - 1`; the `0` sits on the `-`, so a written `0 - 1` isn't one.
				if op is .Sub and self.exprs[lhs] is .IntLit(zero) and zero == 0 and self.source[self.expr_spans[lhs].start] == '-' {
					let .IntLit(value) = self.exprs[rhs] else { return -1 }
					return self.alloc_pattern(ast.Pattern.IntPat(value: 0 - value))
				}
				return self.variant_pattern(expr_id, bindings: none_bindings)
			}
			.Call(callee, args) -> {
				mut bindings: [str] = []
				mut subs: [ast.SubPattern] = []
				for arg in args {
					if len(arg.label) > 0 {
						return -1
					}
					if self.exprs[arg.value] is .Ident(binding) {
						bindings += [binding]
					} else {
						let sub = self.pattern_of_expr(arg.value)
						if sub < 0 {
							return -1
						}
						let hidden = hidden_binding(sub)
						bindings += [hidden]
						subs += [ast.SubPattern(binding: hidden, pattern: sub)]
					}
				}
				// The binding names of an `is` pattern, which parses as a call first.
				for arg in args {
					if self.exprs[arg.value] is .Ident(binding) {
						self.binding_starts += [self.expr_spans[arg.value].start]
						self.binding_names += [binding]
					}
				}
				mut pat: int64 = -1
				match self.exprs[callee] {
					.Ident(name) -> {
						if len(bindings) > 1 {
							return -1
						}
						mut binding = ""
						if len(bindings) == 1 {
							binding = bindings[0]
						}
						pat = self.named_pattern(name, :binding)
					}
					.ImplicitVariant(name) -> pat = self.alloc_pattern(ast.Pattern.ImplicitEnumPat(variant_name: name, :bindings))
					else pat = self.variant_pattern(callee, :bindings)
				}
				if pat >= 0 {
					self.pattern_subs[pat] = subs
				}
				return pat
			}
			else return -1
		}
	}

	// What follows an `else`: a block, or an `if` that chains on.
	func else_block(self) -> [int64] {
		if self.at(.KwIf) {
			return [self.parse_stmt()]
		}
		return self.parse_block()
	}

	// `a and b and c` as its operands, left to right.
	func and_operands(self, anon expr_id: int64) -> [int64] {
		if self.exprs[expr_id] is .Binary(lhs, op, rhs) and op is .And {
			mut ops: [int64] = self.and_operands(lhs)
			ops += self.and_operands(rhs)
			return ops
		}
		return [expr_id]
	}

	// Whether `x is P` binds a name or nests a pattern, so an `if` has to match it rather than test it.
	func binds_names(self, anon expr_id: int64) -> bool {
		if self.exprs[expr_id] is .Binary(_lhs, op, rhs) and op is .Is and self.exprs[rhs] is .Call(_callee, args) {
			for arg in args {
				if self.exprs[arg.value] is .Ident(name) {
					if name != "_" {
						return true
					}
				} else {
					return true
				}
			}
		}
		return false
	}

	// The pattern of each operand that binds, or -1. The patterns go in before
	// the body is parsed, as a whole-condition one does, so their spans end here.
	func chain_patterns(self, anon ops: [int64]) -> [int64] {
		mut pats: [int64] = []
		for op in ops {
			mut pat: int64 = -1
			if self.binds_names(op) and self.exprs[op] is .Binary(_lhs, _op, rhs) {
				pat = self.pattern_of_expr(rhs)
			}
			pats += [pat]
		}
		return pats
	}

	func any_pattern(self, anon pats: [int64]) -> bool {
		for pat in pats {
			if pat >= 0 {
				return true
			}
		}
		return false
	}

	// `let name = counter` and `counter += 1`, ahead of a loop's body, so that
	// `continue` has already moved on.
	func take_counter(self, anon name: str, counter: str, span: ast.Span) -> [int64] {
		let value: int64 = self.alloc_expr(ast.Expr.Ident(name: counter), :span)
		let lhs: int64 = self.alloc_expr(ast.Expr.Ident(name: counter), :span)
		let rhs: int64 = self.alloc_expr(ast.Expr.IntLit(value: 1), :span)
		return [
			self.alloc_stmt(ast.Stmt.Let(:name, typ: 0, :value, mutable: false)),
			self.alloc_stmt(ast.Stmt.PlusAssign(:lhs, :rhs)),
		]
	}

	// `if true` holds a rewritten loop's hidden locals, as a block would.
	func hidden_block(self, anon stmts: [int64], span: ast.Span) -> int64 {
		let always: int64 = self.alloc_expr(ast.Expr.BoolLit(value: true), :span)
		return self.alloc_stmt(ast.Stmt.If(cond: always, then_body: stmts, else_body: []))
	}

	// `for i in a..b`, with the bounds evaluated once and typed `int64`.
	func for_range(self, anon name: str, start: int64, stop: int64, body: [int64]) -> int64 {
		let span: ast.Span = self.expr_spans[start]
		let next_name: str = f"__for_next_{start}"
		let stop_name: str = f"__for_stop_{start}"
		let typ: int64 = self.alloc_type(ast.TypeExpr.Named(name: "int64"), :span)
		let next: int64 = self.alloc_expr(ast.Expr.Ident(name: next_name), :span)
		let last: int64 = self.alloc_expr(ast.Expr.Ident(name: stop_name), :span)
		let cond: int64 = self.alloc_expr(ast.Expr.Binary(lhs: next, op: .Lt, rhs: last), :span)
		mut inner: [int64] = self.take_counter(name, counter: next_name, :span)
		inner += body
		return self.hidden_block([
			self.alloc_stmt(ast.Stmt.Let(name: next_name, :typ, value: start, mutable: true)),
			self.alloc_stmt(ast.Stmt.Let(name: stop_name, :typ, value: stop, mutable: false)),
			self.alloc_stmt(ast.Stmt.For(:cond, body: inner)),
		], :span)
	}

	// `for i, x in xs`.
	func for_numbered(self, anon index: str, name: str, iter: int64, body: [int64]) -> int64 {
		let span: ast.Span = self.expr_spans[iter]
		let counter: str = f"__for_index_{iter}"
		let zero: int64 = self.alloc_expr(ast.Expr.IntLit(value: 0), :span)
		mut inner: [int64] = self.take_counter(index, :counter, :span)
		inner += body
		return self.hidden_block([
			self.alloc_stmt(ast.Stmt.Let(name: counter, typ: 0, value: zero, mutable: true)),
			self.alloc_stmt(ast.Stmt.ForEach(:name, :iter, body: inner)),
		], :span)
	}

	// An `if` whose `and` chain binds: each operand with a pattern is a one-arm
	// match around the operands after it, the others plain `if`s; `elses[i]`
	// runs when operand i fails.
	func chain_stmt(self, anon ops: [int64], pats: [int64], from: int64, body: [int64], elses: [[int64]]) -> int64 {
		mut inner: [int64] = body
		if from + 1 < len(ops) {
			inner = [self.chain_stmt(ops, :pats, from: from + 1, :body, :elses)]
		}
		mut otherwise: [int64] = []
		if len(elses) > 0 {
			otherwise = elses[from]
		}
		let op = ops[from]
		if pats[from] >= 0 {
			if self.exprs[op] is .Binary(subject, _op, _rhs) {
				let wild: int64 = self.alloc_pattern(ast.Pattern.Wildcard)
				mut arms: [int64] = []
				arms += [self.alloc_match_arm(ast.MatchArm(pattern: pats[from], body: inner))]
				arms += [self.alloc_match_arm(ast.MatchArm(pattern: wild, body: otherwise))]
				return self.alloc_stmt(ast.Stmt.MatchStmt(:subject, :arms))
			}
		}
		return self.alloc_stmt(ast.Stmt.If(cond: op, then_body: inner, else_body: otherwise))
	}

	func named_pattern(self, anon name: str, binding: str) -> int64 {
		if name == "Some" {
			return self.alloc_pattern(ast.Pattern.SomePat(:binding))
		}
		if name == "Ok" {
			return self.alloc_pattern(ast.Pattern.OkPat(:binding))
		}
		if name == "Err" {
			return self.alloc_pattern(ast.Pattern.ErrPat(:binding))
		}
		return self.alloc_pattern(ast.Pattern.TypePat(type_name: name, :binding))
	}

	func variant_pattern(self, anon expr_id: int64, bindings: [str]) -> int64 {
		let .Binary(lhs, op, rhs) = self.exprs[expr_id] else { return -1 }
		if not self.is_dot(op) {
			return -1
		}
		let .Ident(variant_name) = self.exprs[rhs] else { return -1 }
		match self.exprs[lhs] {
			.Ident(enum_name) -> return self.alloc_pattern(ast.Pattern.EnumPat(:enum_name, :variant_name, :bindings))
			.Binary(mod_lhs, mod_op, enum_rhs) -> {
				if not self.is_dot(mod_op) {
					return -1
				}
				let .Ident(mod_name) = self.exprs[mod_lhs] else { return -1 }
				let .Ident(enum_name) = self.exprs[enum_rhs] else { return -1 }
				// A pattern travels without its id, so its module rides in the name.
				return self.alloc_pattern(ast.Pattern.EnumPat(enum_name: f"{mod_name}.{enum_name}", :variant_name, :bindings))
			}
			else return -1
		}
	}

	// A typed match: the snapshot reads `let .Dot = op` as the lexer's `.Dot`.
	func is_dot(self, anon op: ast.Op) -> bool {
		match op {
			.Dot -> return true
			else return false
		}
	}

	// `Variant` or `Variant(bindings...)`, past the dot.
	func parse_implicit_variant(self) -> int64 {
		mut variant_name: str = self.expect_identifier()
		let items = self.parse_payload()
		let bindings = payload_bindings(items)
		return self.with_all_subs(self.alloc_pattern(ast.Pattern.ImplicitEnumPat(:variant_name, :bindings)), :items)
	}

	// `name: T` on a union. A built pattern has no id, so the type rides in the
	// variant name, which find_variant_idx reads back.
	func union_pattern_name(self) -> str {
		return f"$t{self.parse_type_expr_core()}"
	}

	func at_union_pattern(self) -> bool {
		return self.at(.Identifier) and self.peek_kind_at(1) == .Colon
	}

	func parse_union_pattern(self) -> int64 {
		let binding: str = self.binding_identifier()
		self.expect(.Colon)
		let bindings: [str] = [binding]
		return self.alloc_pattern(ast.Pattern.ImplicitEnumPat(variant_name: self.union_pattern_name(), :bindings))
	}

	// `x is s: str` reads as `x is .<member>(s)`, as any other pattern after `is` does.
	func parse_union_is_rhs(self) -> int64 {
		let span: ast.Span = self.here()
		let name_tok: lexing.Token = self.peek()
		let binding: str = self.binding_identifier()
		let binding_id: int64 = self.alloc_expr(ast.Expr.Ident(name: binding), span: ast.Span(start: name_tok.start))
		self.expect(.Colon)
		let callee: int64 = self.alloc_expr(ast.Expr.ImplicitVariant(name: self.union_pattern_name()), :span)
		let args: [ast.CallArg] = [ast.CallArg(label: "", label_span: span, value: binding_id)]
		return self.alloc_expr(ast.Expr.Call(:callee, :args), :span)
	}

	func parse_pattern(self) -> int64 {
		if self.at_union_pattern() {
			return self.parse_union_pattern()
		}
		// Integer
		if self.at(.IntegerLit) {
			let tok: lexing.Token = self.advance()
			self.check_literal_range(tok)
			return self.alloc_pattern(ast.Pattern.IntPat(value: str_to_int(tok.value)))
		}
		// A negative integer. A float falls through to its own error below.
		if self.at(.Minus) and self.peek_kind_at(1) != .FloatLit {
			let minus: lexing.Token = self.advance()
			if not self.at(.IntegerLit) {
				self.record_error("error: `-` in a pattern needs an integer literal", got: minus)
				return self.alloc_pattern(ast.Pattern.Wildcard)
			}
			let tok: lexing.Token = self.advance()
			// One past the largest `int64` is the smallest, once negated.
			if literal_excess(tok.value) != 1 {
				self.check_literal_range(tok)
			}
			return self.alloc_pattern(ast.Pattern.IntPat(value: 0 - str_to_int(tok.value)))
		}
		// Only a float still has a `-` here, which changes nothing about its error.
		self.try_consume(.Minus)
		// A float has no pattern: an equality test on one is rarely what is meant.
		if self.at(.FloatLit) {
			let tok: lexing.Token = self.advance()
			self.record_error("error: a float can't be a pattern; test it with `==` or a comparison", got: tok)
			return self.alloc_pattern(ast.Pattern.Wildcard)
		}
		// String
		if self.at(.StringLit) {
			let tok: lexing.Token = self.advance()
			return self.alloc_pattern(ast.Pattern.StrPat(value: parse_string_value(tok.value)))
		}
		// Bool
		if self.try_consume(.KwTrue) {
			return self.alloc_pattern(ast.Pattern.BoolPat(value: true))
		}
		if self.try_consume(.KwFalse) {
			return self.alloc_pattern(ast.Pattern.BoolPat(value: false))
		}
		// none
		if self.try_consume(.KwNone) {
			return self.alloc_pattern(ast.Pattern.NonePat)
		}
		// Some(binding)
		if self.at(.Identifier) and self.peek().value == "Some" {
			self.advance()
			let item = self.parse_one_payload()
			return self.with_subs(self.alloc_pattern(ast.Pattern.SomePat(binding: item.binding)), :item)
		}
		// Ok(binding) / Err(binding) — `T or Error` result patterns.
		if self.at(.Identifier) and self.peek().value == "Ok" {
			self.advance()
			let item = self.parse_one_payload()
			return self.with_subs(self.alloc_pattern(ast.Pattern.OkPat(binding: item.binding)), :item)
		}
		if self.at(.Identifier) and self.peek().value == "Err" {
			self.advance()
			let item = self.parse_one_payload()
			return self.with_subs(self.alloc_pattern(ast.Pattern.ErrPat(binding: item.binding)), :item)
		}
		// Implicit enum variant: .Variant or .Variant(bindings...)
		if self.try_consume(.Dot) {
			return self.parse_implicit_variant()
		}
		// Interface downcast: `StructType` or `StructType(binding)`. A bare
		// identifier NOT followed by `.` (which would make it `Enum.Variant`).
		// codegen validates it names a struct and the subject is an interface.
		if self.at(.Identifier) and self.peek_kind_at(1) != .Dot {
			let type_name: str = self.expect_identifier()
			let item = self.parse_one_payload()
			return self.with_subs(self.alloc_pattern(ast.Pattern.TypePat(:type_name, binding: item.binding)), :item)
		}
		// Explicit enum variant: Enum.Variant or Enum.Variant(bindings...).
		// Also accept three-part 'module.Enum.Variant', whose enum is named
		// `module.Enum`: a pattern travels without its id, so no side array
		// can carry the module.
		let first: str = self.expect_identifier()
		self.expect(.Dot)
		let second: str = self.expect_identifier()
		mut enum_name: str = first
		mut variant_name: str = second
		if self.try_consume(.Dot) {
			enum_name = f"{first}.{second}"
			variant_name = self.expect_identifier()
		}
		let items = self.parse_payload()
		let bindings = payload_bindings(items)
		return self.with_all_subs(self.alloc_pattern(ast.Pattern.EnumPat(:enum_name, :variant_name, :bindings)), :items)
	}

	// A payload position: a name, which binds, or a pattern (pattern >= 0) under a hidden name.
	func parse_payload_item(self) -> ast.SubPattern {
		if self.at(.Identifier) and self.peek_kind_at(1) != .OpenParen and self.peek_kind_at(1) != .Dot and self.peek_kind_at(1) != .Colon {
			return ast.SubPattern(binding: self.binding_identifier(), pattern: -1)
		}
		let pattern = self.parse_pattern()
		return ast.SubPattern(binding: hidden_binding(pattern), :pattern)
	}

	// `(a, .B(c), 0)`, if the pattern has one.
	func parse_payload(self) -> [ast.SubPattern] {
		mut items: [ast.SubPattern] = []
		if self.try_consume(.OpenParen) {
			for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
				items += [self.parse_payload_item()]
				if not self.try_consume(.Comma) {
					break
				}
			}
			self.expect(.CloseParen)
		}
		return items
	}

	// The `(x)` of `Some(x)`, if it has one; without it, an empty binding.
	func parse_one_payload(self) -> ast.SubPattern {
		if self.try_consume(.OpenParen) {
			let item = self.parse_payload_item()
			self.expect(.CloseParen)
			return item
		}
		return ast.SubPattern(binding: "", pattern: -1)
	}

	func with_subs(self, anon pat: int64, item: ast.SubPattern) -> int64 {
		return self.with_all_subs(pat, items: [item])
	}

	func with_all_subs(self, anon pat: int64, items: [ast.SubPattern]) -> int64 {
		mut subs: [ast.SubPattern] = []
		for item in items {
			if item.pattern >= 0 {
				subs += [item]
			}
		}
		self.pattern_subs[pat] = subs
		return pat
	}


	// Lex and parse a Kod expression from a freshly supplied source string.
	// Temporarily swaps the parser's token stream so nodes are allocated into
	// the same pools as the surrounding parse, then restores the position.
	// Spans are offset by `base`, or all at `base` when `pinned`.
	func parse_expr_substring(self, anon source: str, base: int64, pinned: bool) -> int64 {
		let sub_lexer: lexing.Lexer = lexing.Lexer(:source, pos: 0, start: 0)
		mut sub_tokens: [lexing.Token] = []
		for tok in sub_lexer.lex() {
			if pinned {
				sub_tokens += [lexing.Token(kind: tok.kind, value: tok.value, start: base, end: base)]
			} else {
				sub_tokens += [lexing.Token(kind: tok.kind, value: tok.value, start: tok.start + base, end: tok.end + base)]
			}
		}
		let saved_tokens: [lexing.Token] = self.tokens
		let saved_pos: int64 = self.pos
		self.tokens = sub_tokens
		self.pos = 0
		mut result: int64 = self.parse_expr()
		if self.at(.Colon) {
			self.record_error("error: an f-string has no format specs; `{...}` holds one expression", got: self.peek())
		} else if not self.at(.EOF) and not self.at(.EOL) {
			self.record_error("error: the braces of an f-string hold one expression, but this one goes on with " + lexing.kind_name(self.peek_kind()), got: self.peek())
		}
		self.tokens = saved_tokens
		self.pos = saved_pos
		return result
	}

	// Parse the raw token value of an f-string (including f" and trailing ")
	// into a left-folded Binary(Add) tree of string concatenations. The
	// f"""...""" form is dedented before interpolation, so `{expr}` sees
	// the post-dedent body, so its interpolations are spanned at the literal.
	func parse_fstring(self, anon raw: str, span: ast.Span) -> int64 {
		mut inner: str = ""
		let triple: bool = len(raw) >= 7 and raw[1] == '"' and raw[2] == '"' and raw[3] == '"'
		if triple {
			inner = dedent_triple_body(raw[4..len(raw)-3])
		} else {
			inner = raw[2..len(raw)-1]
		}
		mut parts: [int64] = []
		mut i: int64 = 0
		for i < len(inner) {
			mut j: int64 = i
			for j < len(inner) and inner[j] != '{' {
				if inner[j] == '\\' and j + 1 < len(inner) and inner[j + 1] == '\\' {
					j = j + 2
				} else if inner[j] == '\\' and lexing.unicode_escape_end(inner, start: j) >= 0 {
					j = lexing.unicode_escape_end(inner, start: j)
				} else {
					j = j + 1
				}
			}
			if j > i {
				self.check_escapes(inner[i..j], tok: lexing.Token(kind: .FStringLit, value: raw, start: span.start, end: span.start + 1))
				let lit: str = unescape_str(inner[i..j])
				parts += [self.alloc_expr(ast.Expr.StrLit(value: lit), :span)]
			}
			if j >= len(inner) {
				i = j
			} else {
				let k: int64 = lexing.interp_end(inner, start: j + 1)
				let expr_text: str = inner[j+1..k]
				// Wrap each interpolation in str(...) so f-strings compose
				// cleanly with non-string values without `+` doing any
				// implicit coercion of its own. `$str` is always the builtin.
				mut base: int64 = span.start
				if not triple {
					base = span.start + 2 + j + 1
				}
				let inner_expr: int64 = self.parse_expr_substring(expr_text, :base, pinned: triple)
				let str_callee: int64 = self.alloc_expr(ast.Expr.Ident(name: "$str"), :span)
				let arg: ast.CallArg = ast.CallArg(label: "", label_span: span, value: inner_expr)
				let call_args: [ast.CallArg] = [arg]
				parts += [self.alloc_expr(ast.Expr.Call(callee: str_callee, args: call_args), :span)]
				i = k + 1
			}
		}
		if len(parts) == 0 {
			return self.alloc_expr(ast.Expr.StrLit(value: ""), :span)
		}
		mut result: int64 = parts[0]
		mut i: int64 = 1
		for i < len(parts) {
			result = self.alloc_expr(ast.Expr.Binary(lhs: result, op: ast.Op.Add, rhs: parts[i]), :span)
			i = i + 1
		}
		return result
	}

	func parse_primary(self) -> int64 {
		let span: ast.Span = self.here()
		// `not x` is `x == false`, x taken at comparison precedence. The
		// literal's span is the `not`, which is how codegen tells them apart.
		if self.at(.Bang) {
			self.record_error("error: `!` isn't an operator; negate a `bool` with `not`", got: self.peek())
			self.advance()
			return self.parse_expr_prec(7)
		}
		if self.try_consume(.KwNot) {
			let operand: int64 = self.parse_expr_prec(7)
			let rhs: int64 = self.alloc_expr(ast.Expr.BoolLit(value: false), :span)
			return self.alloc_expr(ast.Expr.Binary(lhs: operand, op: ast.Op.Eq, :rhs), :span)
		}
		// Unary minus: desugar -x to 0 - x, x with its postfix chain.
		if self.try_consume(.Minus) {
			if self.at(.IntegerLit) and literal_excess(self.peek().value) == 1 {
				let min_span: ast.Span = self.here()
				let min_tok: lexing.Token = self.advance()
				mut min_lit: int64 = self.alloc_expr(ast.Expr.IntLit(value: str_to_int(min_tok.value)), span: min_span)
				let min_zero: int64 = self.alloc_expr(ast.Expr.IntLit(value: 0), :span)
				if self.postfix_at(0) {
					self.record_error(f"error: integer literal `{min_tok.value}` doesn't fit in `int64`, whose largest value is 9223372036854775807; the `-` negates the whole expression after it, so write `(-{min_tok.value})` for the smallest `int64`", got: min_tok)
					self.bad_lits += [min_lit]
					min_lit = self.parse_postfix(min_lit)
				}
				return self.alloc_expr(ast.Expr.Binary(lhs: min_zero, op: ast.Op.Sub, rhs: min_lit), :span)
			}
			let operand: int64 = self.parse_postfix(self.parse_primary())
			let zero: int64 = self.alloc_expr(ast.Expr.IntLit(value: 0), :span)
			return self.alloc_expr(ast.Expr.Binary(lhs: zero, op: ast.Op.Sub, rhs: operand), :span)
		}
		// `try expr` — unwrap on Ok, propagate Err to the enclosing function.
		// Both `try` and `must` bind at unary precedence: they grab the
		// next primary AND its postfix chain (so `try foo().bar()` wraps
		// the whole `foo().bar()`), but stop at binary operators.
		if self.try_consume(.KwTry) {
			mut inner: int64 = self.parse_primary()
			inner = self.parse_postfix(inner)
			return self.alloc_expr(ast.Expr.Try(:inner), :span)
		}
		// `must expr` — unwrap on Ok, panic + abort on Err.
		if self.try_consume(.KwMust) {
			mut inner: int64 = self.parse_primary()
			inner = self.parse_postfix(inner)
			return self.alloc_expr(ast.Expr.Must(:inner), :span)
		}
		// Integer literal
		if self.at(.IntegerLit) {
			let tok: lexing.Token = self.advance()
			let lit: int64 = self.alloc_expr(ast.Expr.IntLit(value: str_to_int(tok.value)), :span)
			if not self.check_literal_range(tok) {
				self.bad_lits += [lit]
			}
			return lit
		}
		// Float literal
		if self.at(.FloatLit) {
			let tok: lexing.Token = self.advance()
			return self.alloc_expr(ast.Expr.FloatLit(text: strip_spaces(tok.value)), :span)
		}
		// F-string literal
		if self.at(.FStringLit) {
			let tok: lexing.Token = self.advance()
			return self.parse_fstring(tok.value, :span)
		}
		// String literal
		if self.at(.StringLit) {
			let tok: lexing.Token = self.advance()
			self.check_escapes(string_body(tok.value), :tok)
			return self.alloc_expr(ast.Expr.StrLit(value: parse_string_value(tok.value)), :span)
		}
		// Bytes literal: `b"..."`. The lexer emits the leading `b`
		// in tok.value (e.g. `b"hi"`), so `parse_string_value`
		// would mis-interpret it — strip the `b` prefix first
		// before passing the rest through the same unescape path.
		if self.at(.BytesLit) {
			let tok: lexing.Token = self.advance()
			let raw: str = tok.value
			let body: str = raw[1..len(raw)]
			self.check_escapes(string_body(body), :tok)
			return self.alloc_expr(ast.Expr.BytesLit(value: parse_string_value(body)), :span)
		}
		// Boolean
		if self.try_consume(.KwTrue) {
			return self.alloc_expr(ast.Expr.BoolLit(value: true), :span)
		}
		if self.try_consume(.KwFalse) {
			return self.alloc_expr(ast.Expr.BoolLit(value: false), :span)
		}
		// none literal
		if self.try_consume(.KwNone) {
			return self.alloc_expr(ast.Expr.NoneLit, :span)
		}
		// Implicit enum variant: .Variant
		if self.try_consume(.Dot) {
			mut name: str = self.expect_identifier()
			return self.alloc_expr(ast.Expr.ImplicitVariant(:name), :span)
		}
		// Array literal: [e1, e2, ...]
		if self.try_consume(.OpenBracket) {
			mut elements: [int64] = []
			self.skip_newlines()
			for self.peek_kind() != .CloseBracket and self.peek_kind() != .EOF {
				elements += [self.parse_expr()]
				self.skip_newlines()
				if not self.try_consume(.Comma) {
					break
				}
				self.skip_newlines()
			}
			self.expect(.CloseBracket)
			return self.alloc_expr(ast.Expr.ArrayLit(:elements), :span)
		}
		// Parenthesized expression
		if self.try_consume(.OpenParen) {
			let expr: int64 = self.parse_expr()
			self.expect(.CloseParen)
			return expr
		}
		// match expression
		if self.try_consume(.KwMatch) {
			return self.parse_match_expr(span)
		}
		// Anonymous function: `func(params) -> R { ... }` in
		// expression position. Parses as a normal function decl
		// minus the name; the codegen hoists it to a synthesized
		// top-level entry during its registration pass.
		if self.at(.KwFunc) {
			self.advance()
			let params: [ast.Param] = self.parse_param_list()
			mut return_typ: int64 = 0
			if self.try_consume(.Arrow) {
				return_typ = self.parse_type_expr()
			}
			self.binding_exprs += 1
			let binding_mark = self.binding_exprs
			let body: [int64] = self.parse_block()
			let fd: ast.FuncDecl = ast.FuncDecl(name: "", name_span: span, :params, :return_typ, :body, doc: "", expr_binds: self.binding_exprs > binding_mark)
			let decl_id: int64 = self.alloc_func_decl(fd)
			return self.alloc_expr(ast.Expr.FuncLit(:decl_id), :span)
		}
		// Identifier
		mut name: str = self.expect_identifier()
		return self.alloc_expr(ast.Expr.Ident(:name), :span)
	}

	func parse_match_expr(self, anon span: ast.Span) -> int64 {
		self.binding_exprs += 1
		let subject: int64 = self.parse_expr()
		self.expect(.OpenCurly)
		self.skip_newlines()
		mut arms: [int64] = []
		for self.peek_kind() != .CloseCurly and self.peek_kind() != .EOF {
			self.skip_newlines()
			if self.peek_kind() == .CloseCurly {
				break
			}
			let pats: [int64] = self.parse_match_arm_patterns()
			let guarded = self.arm_guarded
			let body_pos = self.pos
			let errors_before = len(self.errors)
			for pat in pats {
				self.pos = body_pos
				arms += [self.parse_match_expr_arm(pat, :guarded)]
				if len(self.errors) > errors_before {
					break
				}
			}
			self.skip_newlines()
		}
		self.expect(.CloseCurly)
		return self.alloc_expr(ast.Expr.MatchExpr(:subject, :arms), :span)
	}

	func parse_match_expr_arm(self, anon pat: int64, guarded: bool) -> int64 {
		let guard = self.parse_arm_guard(guarded)
		mut body: int64 = 0
		mut pre: [int64] = []
		if self.at(.OpenCurly) {
			// A block arm: its last statement is the arm's value.
			let open_tok: lexing.Token = self.peek()
			pre = self.parse_block()
			mut valued = false
			if len(pre) > 0 {
				let last_id: int64 = pre[len(pre) - 1]
				if self.stmts[last_id] is ast.Stmt.ExprStmt(last) {
					body = last
					pre = pre[0..len(pre) - 1]
					valued = true
				}
				if self.stmts[last_id] is ast.Stmt.Return(_value) {
					body = self.unreachable_value()
					valued = true
				}
				if self.stmts[last_id] is ast.Stmt.Throw(_thrown) {
					body = self.unreachable_value()
					valued = true
				}
			}
			if not valued {
				self.record_error("error: a match arm's block must end with an expression, the arm's value", got: open_tok)
				body = self.alloc_expr(ast.Expr.IntLit(value: 0), span: self.here())
			}
		} else {
			body = self.parse_expr()
		}
		return self.alloc_match_expr_arm(ast.MatchExprArm(pattern: pat, :body, :pre, :guard))
	}

	func parse_match_stmt_arm(self, anon pat: int64, guarded: bool) -> int64 {
		let guard = self.parse_arm_guard(guarded)
		mut body: [int64] = []
		if self.try_consume(.KwNone) {
			// `else none` — empty no-op body sugar.
		} else {
			if self.at(.OpenCurly) {
				body = self.parse_block()
			} else {
				body += [self.parse_stmt()]
			}
		}
		return self.alloc_match_arm(ast.MatchArm(pattern: pat, :body, :guard))
	}

	// `if cond ->` after an arm's patterns, or 0. Each alternative of an arm
	// parses it for itself, as it does the body.
	func parse_arm_guard(self, anon guarded: bool) -> int64 {
		if not guarded {
			return 0
		}
		self.expect(.KwIf)
		let guard = self.parse_expr()
		self.expect(.Arrow)
		return guard
	}

	// The value of a block arm that ends in `return` or `throw`: a call that
	// never returns, which the arm never gets to.
	func unreachable_value(self) -> int64 {
		let span: ast.Span = self.here()
		let callee: int64 = self.alloc_expr(ast.Expr.Ident(name: "kod_panic"), :span)
		let message: int64 = self.alloc_expr(ast.Expr.StrLit(value: "unreachable"), :span)
		let args: [ast.CallArg] = [ast.CallArg(label: "", label_span: span, value: message)]
		return self.alloc_expr(ast.Expr.Call(:callee, :args), :span)
	}

	// Parse a match-arm's patterns and the connecting token. `else { ... }`,
	// `else expr`, and `else -> expr` are accepted as catch-all arms in
	// place of `else ...`. For non-else patterns, the `->` is required, unless
	// a guard comes first (`arm_guarded`), whose parse then takes the `->`.
	// `.A | .B -> body` is one arm per pattern; the caller parses the body
	// once for each, so each is its own statements, as with an `else` body.
	func parse_match_arm_patterns(self) -> [int64] {
		self.arm_guarded = false
		if self.try_consume(.KwElse) {
			self.try_consume(.Arrow)
			return [self.alloc_pattern(ast.Pattern.Wildcard)]
		}
		mut pats: [int64] = [self.parse_pattern()]
		let bar_tok: lexing.Token = self.peek()
		for self.try_consume(.Pipe) {
			self.skip_newlines()
			pats += [self.parse_pattern()]
		}
		if len(pats) > 1 {
			for pat in pats {
				if self.pattern_binds(pat) {
					self.record_error("error: alternatives joined by `|` can't bind names; give the arm that binds a line of its own", got: bar_tok)
					break
				}
			}
		}
		if self.at(.KwIf) {
			self.arm_guarded = true
			return pats
		}
		self.expect(.Arrow)
		return pats
	}

	func pattern_binds(self, anon pat: int64) -> bool {
		for sub in self.pattern_subs[pat] {
			if self.pattern_binds(sub.pattern) {
				return true
			}
		}
		match self.patterns[pat] {
			.EnumPat(_enum_name, _variant_name, bindings) -> return self.any_named(bindings)
			.ImplicitEnumPat(_variant_name, bindings) -> return self.any_named(bindings)
			.SomePat(binding) -> return self.any_named([binding])
			.OkPat(binding) -> return self.any_named([binding])
			.ErrPat(binding) -> return self.any_named([binding])
			.TypePat(_type_name, binding) -> return self.any_named([binding])
			else return false
		}
	}

	func any_named(self, anon bindings: [str]) -> bool {
		for name in bindings {
			if len(name) > 0 and name != "_" and not is_hidden_binding(name) {
				return true
			}
		}
		return false
	}

	func parse_postfix(self, anon base: int64) -> int64 {
		mut lhs: int64 = base
		// Source span carried forward across all postfix wraps of the
		// same base expression. For `obj.method(args)` and similar, the
		// resulting nodes all point back to where the base started.
		let lhs_span: ast.Span = self.expr_spans[lhs]
		for self.at(.OpenParen) or self.at(.Dot) or self.at(.OpenBracket) or self.at(.Question) {
			// Function/method call
			if self.at(.OpenParen) {
				self.advance()
				mut args: [ast.CallArg] = []
				self.skip_newlines()
				for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
					let errors_before: int64 = len(self.errors)
					// Leading-colon shorthand `:name` → `name: name`.
					// Explicit form for the (otherwise ambiguous) case of
					// passing a variable whose name matches the parameter
					// label.
					if self.at(.Colon) {
						self.advance()
						let label_span: ast.Span = self.here()
						mut name: str = self.expect_identifier()
						let val: int64 = self.alloc_expr(ast.Expr.Ident(:name), span: label_span)
						args += [ast.CallArg(label: name, :label_span, value: val)]
					} else if self.in_is_rhs > 0 and self.at_union_pattern() {
						args += [ast.CallArg(label: "", label_span: self.here(), value: self.parse_union_is_rhs())]
					} else if self.at(.Identifier) and self.peek_kind_at(1) == .Colon {
						// Labeled arg: identifier followed by colon.
						let label_span: ast.Span = self.here()
						mut label: str = self.expect_identifier()
						self.expect(.Colon)
						let val: int64 = self.parse_expr()
						args += [ast.CallArg(:label, :label_span, value: val)]
					} else {
						// Anonymous arg: anything else, including a bare
						// identifier. To pass a variable to a labeled param,
						// use `:name` or the full `name: name` form.
						let anon_span: ast.Span = self.here()
						let val: int64 = self.parse_expr()
						args += [ast.CallArg(label: "", label_span: anon_span, value: val)]
					}
					// After a bad argument, leave the line end alone: the `)` is
					// expected right here, as it was before calls could span lines.
					if len(self.errors) > errors_before {
						break
					}
					self.skip_newlines()
					if not self.try_consume(.Comma) {
						break
					}
					self.skip_newlines()
				}
				self.expect(.CloseParen)
				lhs = self.alloc_expr(ast.Expr.Call(callee: lhs, :args), span: lhs_span)
			}
			// Dot access: expr.name
			if self.at(.Dot) {
				self.advance()
				let field_span: ast.Span = self.here()
				let field: str = self.expect_identifier()
				let rhs: int64 = self.alloc_expr(ast.Expr.Ident(name: field), span: field_span)
				lhs = self.alloc_expr(ast.Expr.Binary(:lhs, op: ast.Op.Dot, :rhs), span: lhs_span)
			}
			// Index, slice, or generic constructor: expr[idx], expr[lo..hi],
			// expr[..hi], expr[lo..], expr[..], or Type[A, B](...).
			if self.at(.OpenBracket) {
				self.advance()
				// `expr[..hi]` / `expr[..]`: omitted lo, default to 0.
				if self.at(.DotDot) {
					let zero_span: ast.Span = self.here()
					let lo: int64 = self.alloc_expr(ast.Expr.IntLit(value: 0), span: zero_span)
					self.advance()
					mut hi: int64 = 0
					if self.peek_kind() != .CloseBracket {
						hi = self.parse_expr()
					}
					self.expect(.CloseBracket)
					lhs = self.alloc_expr(ast.Expr.Slice(s: lhs, :lo, :hi), span: lhs_span)
				} else {
					let lo: int64 = self.parse_expr()
					if self.try_consume(.DotDot) {
						mut hi: int64 = 0
						if self.peek_kind() != .CloseBracket {
							hi = self.parse_expr()
						}
						self.expect(.CloseBracket)
						lhs = self.alloc_expr(ast.Expr.Slice(s: lhs, :lo, :hi), span: lhs_span)
					} else {
						if self.try_consume(.Comma) {
							// `Type[A, B]` folds into Index(Index(Type, A), B).
							lhs = self.alloc_expr(ast.Expr.Binary(:lhs, op: ast.Op.Index, rhs: lo), span: lhs_span)
							for self.peek_kind() != .CloseBracket and self.peek_kind() != .EOF {
								let type_arg: int64 = self.parse_expr()
								lhs = self.alloc_expr(ast.Expr.Binary(:lhs, op: ast.Op.Index, rhs: type_arg), span: lhs_span)
								if not self.try_consume(.Comma) {
									break
								}
							}
							self.expect(.CloseBracket)
							if not self.at(.OpenParen) and not self.at(.Comma) and not self.at(.CloseBracket) {
								self.record_unexpected(expected: "`(` after generic type arguments", got: self.peek())
							}
						} else {
							self.expect(.CloseBracket)
							// Always produce an Index node, even when the
							// next token is `(`. The codegen distinguishes
							// `Type[A](args)` (generic constructor — lhs is
							// a known struct name) from `arr[i](args)`
							// (indirect call on an indexed value).
							lhs = self.alloc_expr(ast.Expr.Binary(:lhs, op: ast.Op.Index, rhs: lo), span: lhs_span)
						}
					}
				}
			}
			// Postfix `?` on a `T?` value. `expr?` panics on none;
			// `expr? or default` substitutes `default`. The default is parsed
			// at precedence above `or` so a following `or` is left for the
			// surrounding parse_expr_prec (where it'll be the boolean
			// operator, or a type error if applied to the unwrap result).
			if self.at(.Question) {
				self.advance()
				if self.at(.Dot) {
					// `x?.field` — short-circuit field access on a
					// `T?` struct. `x?.method(args)` — short-circuit
					// method call. Both short-circuit to `none` when x
					// is none; otherwise the field/method runs on the
					// unwrapped value and the result is wrapped as Some.
					self.advance()
					let name: str = self.expect_identifier()
					if self.at(.OpenParen) {
						self.advance()
						mut args: [ast.CallArg] = []
						self.skip_newlines()
						for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
							let errors_before: int64 = len(self.errors)
							if self.at(.Colon) {
								self.advance()
								let label_span: ast.Span = self.here()
								mut arg_name: str = self.expect_identifier()
								let val: int64 = self.alloc_expr(ast.Expr.Ident(name: arg_name), span: label_span)
								args += [ast.CallArg(label: arg_name, :label_span, value: val)]
							} else if self.in_is_rhs > 0 and self.at_union_pattern() {
								args += [ast.CallArg(label: "", label_span: self.here(), value: self.parse_union_is_rhs())]
							} else if self.at(.Identifier) and self.peek_kind_at(1) == .Colon {
								let label_span: ast.Span = self.here()
								mut label: str = self.expect_identifier()
								self.expect(.Colon)
								let val: int64 = self.parse_expr()
								args += [ast.CallArg(:label, :label_span, value: val)]
							} else {
								let anon_span: ast.Span = self.here()
								let val: int64 = self.parse_expr()
								args += [ast.CallArg(label: "", label_span: anon_span, value: val)]
							}
							if len(self.errors) > errors_before {
								break
							}
							self.skip_newlines()
							if not self.try_consume(.Comma) {
								break
							}
							self.skip_newlines()
						}
						self.expect(.CloseParen)
						lhs = self.alloc_expr(ast.Expr.OptionalMethodCall(value: lhs, method: name, :args), span: lhs_span)
					} else {
						lhs = self.alloc_expr(ast.Expr.OptionalDot(value: lhs, field: name), span: lhs_span)
					}
				} else {
					mut default_expr: int64 = 0
					if self.try_consume(.KwOr) {
						default_expr = self.parse_expr_prec(3)
					}
					lhs = self.alloc_expr(ast.Expr.UnwrapOpt(value: lhs, default: default_expr), span: lhs_span)
				}
			}
		}
		return lhs
	}

	func bin_op_prec(self) -> int64 {
		// Precedence climbs (higher binds tighter). Mirrors C's relative
		// ordering — bitwise OR/XOR/AND between boolean and comparison,
		// shifts between comparison and arithmetic — so familiar
		// expressions like `(crc >> 8) ^ table[(crc ^ byte) & 0xff]`
		// parse without parens.
		match self.peek_kind() {
			.KwIs -> return 7
			.KwOr -> return 2
			.KwAnd -> return 3
			.Pipe -> return 4
			.Caret -> return 5
			.Ampersand -> return 6
			.EqualEqual -> return 7
			.NotEqual -> return 7
			.LessThan -> return 7
			.LessEqual -> return 7
			.GreaterThan -> return 7
			.GreaterEqual -> return 7
			.ShiftLeft -> return 8
			.ShiftRight -> return 8
			.Plus -> return 9
			.Minus -> return 9
			.Star -> return 10
			.Slash -> return 10
			.Percent -> return 10
			else return 0
		}
	}

	func consume_bin_op(self) -> ast.Op {
		let kind: lexing.TokenKind = self.peek_kind()
		self.advance()
		match kind {
			.KwIs -> {
				// `is not Pat` is a two-word operator — `is` negated.
				// Consuming the `not` here keeps precedence + parsing
				// of the rhs identical to plain `is`.
				if self.try_consume(.KwNot) {
					return .IsNot
				}
				return .Is
			}
			.KwOr -> return .Or
			.KwAnd -> return .And
			.Pipe -> return .BitOr
			.Caret -> return .BitXor
			.Ampersand -> return .BitAnd
			.EqualEqual -> return .Eq
			.NotEqual -> return .Ne
			.LessThan -> return .Lt
			.LessEqual -> return .Le
			.GreaterThan -> return .Gt
			.GreaterEqual -> return .Ge
			.ShiftLeft -> return .Shl
			.ShiftRight -> return .Shr
			.Plus -> return .Add
			.Minus -> return .Sub
			.Star -> return .Mul
			.Slash -> return .Div
			.Percent -> return .Mod
			else return .Add
		}
	}

	func parse_expr(self) -> int64 {
		return self.parse_expr_prec(1)
	}

	// `is` shares the comparisons' precedence but doesn't chain.
	func chains(self, anon op: ast.Op) -> bool {
		match op {
			.Eq -> return true
			.Ne -> return true
			.Lt -> return true
			.Le -> return true
			.Gt -> return true
			.Ge -> return true
			else return false
		}
	}

	func at_chain_op(self) -> bool {
		return self.bin_op_prec() == 7 and self.peek_kind() != .KwIs
	}

	func parse_expr_prec(self, anon min_prec: int64) -> int64 {
		mut lhs: int64 = self.parse_primary()
		lhs = self.parse_postfix(lhs)
		// Binary-op nodes inherit the lhs's span so the whole tree
		// points back to the leftmost token.
		let lhs_span: ast.Span = self.expr_spans[lhs]
		for self.bin_op_prec() >= min_prec and self.bin_op_prec() > 0 {
			let prec: int64 = self.bin_op_prec()
			let op: ast.Op = self.consume_bin_op()
			mut rhs: int64 = 0
			if (op is .Is or op is .IsNot) and self.at_union_pattern() {
				rhs = self.parse_union_is_rhs()
			} else if op is .Is or op is .IsNot {
				self.in_is_rhs = self.in_is_rhs + 1
				rhs = self.parse_expr_prec(prec + 1)
				self.in_is_rhs = self.in_is_rhs - 1
			} else {
				rhs = self.parse_expr_prec(prec + 1)
			}
			// Python-style chained comparisons: `a < b < c` builds a
			// single Chain instead of `((a < b) < c)`. Comparisons live
			// at precedence 7; if the next token is also a comparison
			// op, keep collecting operands and operators into one node.
			if self.chains(op) and self.at_chain_op() {
				mut chain_exprs: [int64] = [lhs, rhs]
				mut chain_ops: [ast.Op] = [op]
				for self.at_chain_op() {
					let next_op: ast.Op = self.consume_bin_op()
					let next_rhs: int64 = self.parse_expr_prec(8)
					chain_exprs += [next_rhs]
					chain_ops += [next_op]
				}
				lhs = self.alloc_expr(ast.Expr.Chain(exprs: chain_exprs, ops: chain_ops), span: lhs_span)
			} else {
				lhs = self.alloc_expr(ast.Expr.Binary(:lhs, :op, :rhs), span: lhs_span)
			}
		}
		return lhs
	}


	func parse_block(self) -> [int64] {
		if not self.at(.OpenCurly) {
			self.record_unexpected(expected: lexing.kind_name(.OpenCurly), got: self.peek())
			// Resume at a `{` later on the line, or give up on the block.
			for not self.at(.OpenCurly) and not self.at(.EOL) and not self.at(.EOF) {
				self.advance()
			}
			if not self.at(.OpenCurly) {
				return []
			}
		}
		self.advance()
		self.skip_newlines()
		mut stmts: [int64] = []
		for self.peek_kind() != .CloseCurly and self.peek_kind() != .EOF {
			self.skip_newlines()
			if self.peek_kind() == .CloseCurly {
				break
			}
			let errors_before = len(self.errors)
			let stmt_id = self.parse_stmt()
			stmts += [stmt_id]
			self.expect_stmt_end(:stmt_id, :errors_before)
			self.skip_newlines()
		}
		self.expect(.CloseCurly)
		return stmts
	}

	// A statement ends its line unless a block's `}` ended it.
	func expect_stmt_end(self, stmt_id: int64, errors_before: int64) -> none {
		let prev = self.tokens[self.pos - 1].kind
		if prev == .EOL or prev == .CloseCurly {
			return
		}
		if self.at(.EOL) or self.at(.Comment) or self.at(.CloseCurly) or self.at(.EOF) {
			return
		}
		if len(self.errors) == errors_before {
			mut what = "this statement"
			if stmt_id >= 0 {
				match self.stmts[stmt_id] {
					.ExprStmt(expr) -> {
						if self.exprs[expr] is .Ident(name) {
							what = f"`{name}`"
							// A misspelled keyword: don't also report the name.
							self.stmts[stmt_id] = ast.Stmt.ExprStmt(expr: 0)
						}
					}
					else none
				}
			}
			self.record_error(f"error: expected the end of the line after {what}, got {lexing.kind_name(self.peek_kind())}", got: self.peek())
		}
		self.skip_rest_of_stmt(depth: 0)
	}

	// Skip to the end of the statement, past any block it opens.
	func skip_rest_of_stmt(self, depth: int64) -> none {
		mut open = depth
		for not self.at(.EOF) {
			if open == 0 {
				if self.at(.EOL) or self.at(.CloseCurly) {
					return
				}
			}
			if self.at(.OpenCurly) {
				open = open + 1
			} else if self.at(.CloseCurly) {
				open = open - 1
			}
			self.advance()
		}
	}

	func parse_stmt(self) -> int64 {
		self.skip_newlines()

		// let declaration (with optional refutable-pattern form)
		if self.try_consume(.KwLet) {
			// `let .Pat(...) = expr else { ... }` — refutable destructure.
			if self.at(.Dot) {
				let pat: int64 = self.parse_pattern()
				self.expect(.Equal)
				let value: int64 = self.parse_expr()
				self.expect(.KwElse)
				mut else_body: [int64] = self.parse_block()
				return self.alloc_stmt(ast.Stmt.LetElse(pattern: pat, :value, :else_body))
			}
			// `let Some(v) = ...`: what `is` would take, without the dot a `let` needs.
			if self.at(.Identifier) and self.peek_kind_at(1) == .OpenParen {
				let variant = self.peek()
				self.record_error(f"error: a `let` pattern starts with a `.`: `let .{variant.value}(...) = ...`", got: variant)
				let pat: int64 = self.parse_implicit_variant()
				self.expect(.Equal)
				let value: int64 = self.parse_expr()
				self.expect(.KwElse)
				mut else_body: [int64] = self.parse_block()
				return self.alloc_stmt(ast.Stmt.LetElse(pattern: pat, :value, :else_body))
			}
			mut name: str = self.binding_identifier()
			mut typ: int64 = 0
			if self.try_consume(.Colon) {
				typ = self.parse_type_expr()
			}
			self.expect(.Equal)
			let value: int64 = self.parse_expr()
			self.skip_newlines()
			return self.alloc_stmt(ast.Stmt.Let(:name, :typ, :value, mutable: false))
		}

		// mut declaration — a mutable local binding. Irrefutable only
		// (`mut .Pat` is rejected: expect_identifier errors on the `.`).
		if self.try_consume(.KwMut) {
			mut name: str = self.binding_identifier()
			mut typ: int64 = 0
			if self.try_consume(.Colon) {
				typ = self.parse_type_expr()
			}
			self.expect(.Equal)
			let value: int64 = self.parse_expr()
			self.skip_newlines()
			return self.alloc_stmt(ast.Stmt.Let(:name, :typ, :value, mutable: true))
		}

		// return
		if self.try_consume(.KwReturn) {
			if self.at(.EOL) or self.at(.CloseCurly) or self.at(.EOF) {
				self.skip_newlines()
				return self.alloc_stmt(ast.Stmt.Return(value: 0))
			}
			let value: int64 = self.parse_expr()
			self.skip_newlines()
			return self.alloc_stmt(ast.Stmt.Return(:value))
		}

		// throw — same as `return .Err(value)` for a function declared
		// `T or Error`. Body must produce an Error-conforming value.
		if self.try_consume(.KwThrow) {
			let value: int64 = self.parse_expr()
			self.skip_newlines()
			return self.alloc_stmt(ast.Stmt.Throw(:value))
		}

		// assert — only meaningful inside a `test "..." { ... }` block,
		// but the parser treats it uniformly. We snapshot the source
		// bytes of the expression so codegen can put them in the
		// failure message (the killer feature of the keyword form).
		if self.at(.KwAssert) {
			let assert_tok: lexing.Token = self.advance()
			let span: ast.Span = ast.Span(start: assert_tok.start)
			let expr_start: int64 = self.peek().start
			let value: int64 = self.parse_expr()
			let expr_end: int64 = self.tokens[self.pos - 1].end
			let source_text: str = self.source[expr_start..expr_end]
			self.skip_newlines()
			return self.alloc_stmt(ast.Stmt.Assert(expr: value, :source_text, :span))
		}

		// if / else. `if expr is Pat { body }` is sugar for a one-arm
		// match-statement (with bindings from Pat scoped to body).
		if self.try_consume(.KwIf) {
			let cond: int64 = self.parse_expr()
			mut pat: int64 = -1
			mut negated = false
			mut subject: int64 = cond
			if self.exprs[cond] is .Binary(is_lhs, is_op, is_rhs) {
				match is_op {
					.Is -> pat = self.pattern_of_expr(is_rhs)
					.IsNot -> {
						pat = self.pattern_of_expr(is_rhs)
						negated = true
					}
					else none
				}
				subject = is_lhs
			}
			// `if a and x is .V(n) and n > 0`: the patterns go in before the
			// body, as the whole-condition one does, so their spans end here.
			let ops: [int64] = self.and_operands(cond)
			mut chained = false
			for op in ops {
				if len(ops) > 1 and self.binds_names(op) {
					chained = true
				}
			}
			if chained {
				let pats: [int64] = self.chain_patterns(ops)
				let body: [int64] = self.parse_block()
				// Any operand can fail, so each gets its own parse of the else
				// block: one statement per path, which the flow checks follow.
				mut elses: [[int64]] = []
				if self.try_consume(.KwElse) {
					let else_pos = self.pos
					let errors_before = len(self.errors)
					let first: [int64] = self.else_block()
					let end_pos = self.pos
					elses += [first]
					for len(elses) < len(ops) {
						if len(self.errors) > errors_before {
							elses += [first]
						} else {
							self.pos = else_pos
							elses += [self.else_block()]
						}
					}
					self.pos = end_pos
				}
				return self.chain_stmt(ops, :pats, from: 0, :body, :elses)
			}
			if pat >= 0 {
				// `if x is not Pat { body } else { else_body }` swaps
				// roles: the body runs when the pattern does NOT match;
				// any bindings in Pat are scoped to else_body.
				mut body: [int64] = self.parse_block()
				let wild: int64 = self.alloc_pattern(ast.Pattern.Wildcard)
				// An optional `else { ... }` after the `is`-form populates
				// the wildcard arm's body — pattern bindings stay scoped
				// to the matching arm. Only consume the `else` when it's
				// the very next token; eating newlines first would let us
				// swallow a separator that surrounding constructs (match
				// arms, function bodies) need.
				mut else_body: [int64] = []
				if self.try_consume(.KwElse) {
					else_body = self.else_block()
				}
				mut arms: [int64] = []
				if negated {
					arms += [self.alloc_match_arm(ast.MatchArm(pattern: pat, body: else_body))]
					arms += [self.alloc_match_arm(ast.MatchArm(pattern: wild, :body))]
				} else {
					arms += [self.alloc_match_arm(ast.MatchArm(pattern: pat, :body))]
					arms += [self.alloc_match_arm(ast.MatchArm(pattern: wild, body: else_body))]
				}
				return self.alloc_stmt(ast.Stmt.MatchStmt(:subject, :arms))
			}
			let then_body: [int64] = self.parse_block()
			mut else_body: [int64] = []
			self.skip_newlines()
			if self.try_consume(.KwElse) {
				if self.at(.KwIf) {
					else_body += [self.parse_stmt()]
				} else {
					else_body = self.parse_block()
				}
			}
			return self.alloc_stmt(ast.Stmt.If(:cond, :then_body, :else_body))
		}

		// for (with foreach detection)
		if self.try_consume(.KwFor) {
			self.skip_newlines()
			if self.at(.Identifier) and self.peek_kind_at(1) == .Comma and self.peek_kind_at(2) == .Identifier and self.peek_kind_at(3) == .KwIn {
				let index: str = self.binding_identifier()
				self.expect(.Comma)
				let name: str = self.binding_identifier()
				self.expect(.KwIn)
				let iter: int64 = self.parse_expr()
				if self.at(.DotDot) {
					self.record_error("error: `for i, x in` numbers an array; a range is already numbers, so write `for x in a..b`", got: self.peek())
					self.advance()
					self.parse_expr()
				}
				let body: [int64] = self.parse_block()
				return self.for_numbered(index, :name, :iter, :body)
			}
			if self.at(.Identifier) and self.peek_kind_at(1) == .KwIn {
				mut name: str = self.binding_identifier()
				self.expect(.KwIn)
				let iter: int64 = self.parse_expr()
				if self.try_consume(.DotDot) {
					let stop: int64 = self.parse_expr()
					let body: [int64] = self.parse_block()
					return self.for_range(name, start: iter, :stop, :body)
				}
				mut body: [int64] = self.parse_block()
				return self.alloc_stmt(ast.Stmt.ForEach(:name, :iter, :body))
			}
			let cond: int64 = self.parse_expr()
			let ops: [int64] = self.and_operands(cond)
			let pats: [int64] = self.chain_patterns(ops)
			mut body: [int64] = self.parse_block()
			if self.any_pattern(pats) {
				// `for true { if cond { body } else { break } }`: `continue`
				// tests the condition again, and `break` is the loop's own.
				mut elses: [[int64]] = []
				for _op in ops {
					elses += [[self.alloc_stmt(ast.Stmt.Break)]]
				}
				let always: int64 = self.alloc_expr(ast.Expr.BoolLit(value: true), span: self.expr_spans[cond])
				return self.alloc_stmt(ast.Stmt.For(cond: always, body: [self.chain_stmt(ops, :pats, from: 0, :body, :elses)]))
			}
			return self.alloc_stmt(ast.Stmt.For(:cond, :body))
		}

		// break / continue
		if self.try_consume(.KwBreak) {
			self.skip_newlines()
			return self.alloc_stmt(ast.Stmt.Break)
		}
		if self.try_consume(.KwContinue) {
			self.skip_newlines()
			return self.alloc_stmt(ast.Stmt.Continue)
		}

		// match statement
		if self.try_consume(.KwMatch) {
			let subject: int64 = self.parse_expr()
			self.expect(.OpenCurly)
			self.skip_newlines()
			mut arms: [int64] = []
			for self.peek_kind() != .CloseCurly and self.peek_kind() != .EOF {
				self.skip_newlines()
				if self.peek_kind() == .CloseCurly {
					break
				}
				let pats: [int64] = self.parse_match_arm_patterns()
				let guarded = self.arm_guarded
				let body_pos = self.pos
				let errors_before = len(self.errors)
				for pat in pats {
					self.pos = body_pos
					arms += [self.parse_match_stmt_arm(pat, :guarded)]
					if len(self.errors) > errors_before {
						break
					}
				}
				self.skip_newlines()
			}
			self.expect(.CloseCurly)
			return self.alloc_stmt(ast.Stmt.MatchStmt(:subject, :arms))
		}

		// Expression, assignment, or +=
		let expr: int64 = self.parse_expr()
		if self.try_consume(.Equal) {
			let rhs: int64 = self.parse_expr()
			self.skip_newlines()
			return self.alloc_stmt(ast.Stmt.Assign(lhs: expr, :rhs))
		}
		if self.try_consume(.PlusEqual) {
			let rhs: int64 = self.parse_expr()
			self.skip_newlines()
			return self.alloc_stmt(ast.Stmt.PlusAssign(lhs: expr, :rhs))
		}
		if self.try_consume(.MinusEqual) {
			let rhs: int64 = self.parse_expr()
			self.skip_newlines()
			return self.alloc_stmt(ast.Stmt.MinusAssign(lhs: expr, :rhs))
		}
		self.skip_newlines()
		return self.alloc_stmt(ast.Stmt.ExprStmt(:expr))
	}


	func parse_func_decl(self, doc: str, is_method: bool = false) -> ast.FuncDecl {
		self.expect(.KwFunc)
		let name_span: ast.Span = self.here()
		mut name: str = self.expect_identifier()
		let bracket = self.peek()
		let type_params = self.parse_func_type_params()
		if is_method and len(type_params) > 0 {
			self.record_error("error: a method can't declare its own type parameters; put them on the struct", got: bracket)
		}
		mut params: [ast.Param] = self.parse_param_list()
		mut return_typ: int64 = 0
		if self.try_consume(.Arrow) {
			return_typ = self.parse_type_expr()
		}
		let binding_mark = self.binding_exprs
		mut body: [int64] = self.parse_block()
		return ast.FuncDecl(:name, :name_span, :params, :return_typ, :body, :doc, expr_binds: self.binding_exprs > binding_mark, :type_params)
	}

	func parse_func_type_params(self) -> [str] {
		mut type_params: [str] = []
		if not self.try_consume(.OpenBracket) {
			return type_params
		}
		for true {
			let tok = self.peek()
			let param = self.expect_identifier()
			for seen in type_params {
				if seen == param {
					self.record_error(f"error: type parameter `{param}` is declared twice", got: tok)
				}
			}
			type_params += [param]
			if not self.try_consume(.Comma) or self.peek_kind() == .CloseBracket or self.peek_kind() == .EOF {
				break
			}
		}
		self.expect(.CloseBracket)
		return type_params
	}

	// Interface method signature: `func name(params) -> ret` (no body).
	func parse_func_sig(self, doc: str) -> ast.FuncDecl {
		self.expect(.KwFunc)
		let name_span: ast.Span = self.here()
		mut name: str = self.expect_identifier()
		mut params: [ast.Param] = self.parse_param_list()
		mut return_typ: int64 = 0
		if self.try_consume(.Arrow) {
			return_typ = self.parse_type_expr()
		}
		mut body: [int64] = []
		return ast.FuncDecl(:name, :name_span, :params, :return_typ, :body, :doc)
	}

	func parse_struct_fields(self) -> [ast.StructField] {
		mut fields: [ast.StructField] = []
		for self.peek_kind() != .CloseCurly and self.peek_kind() != .KwFunc and self.peek_kind() != .EOF {
			self.skip_newlines()
			if self.peek_kind() == .CloseCurly or self.peek_kind() == .KwFunc {
				break
			}
			let name_span = self.here()
			mut name: str = self.expect_identifier()
			self.expect(.Colon)
			mut typ: int64 = self.parse_type_expr()
			mut default_expr: int64 = 0
			if self.try_consume(.Equal) {
				default_expr = self.parse_expr()
			}
			fields += [ast.StructField(:name, :typ, :default_expr, :name_span)]
			self.skip_newlines()
		}
		return fields
	}

	func parse_enum_variants(self) -> [ast.EnumVariant] {
		mut variants: [ast.EnumVariant] = []
		for self.peek_kind() != .CloseCurly and self.peek_kind() != .EOF {
			self.skip_newlines()
			if self.peek_kind() == .CloseCurly {
				break
			}
			let name_span = self.here()
			mut name: str = self.expect_identifier()
			mut fields: [ast.Param] = []
			if self.try_consume(.OpenParen) {
				self.skip_newlines()
				for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
					let errors_before: int64 = len(self.errors)
					fields += [self.parse_param()]
					if len(self.errors) > errors_before {
						break
					}
					self.skip_newlines()
					if not self.try_consume(.Comma) {
						break
					}
					self.skip_newlines()
				}
				self.expect(.CloseParen)
			}
			variants += [ast.EnumVariant(:name, :fields, :name_span)]
			self.skip_newlines()
		}
		return variants
	}

	func parse_decl(self, doc: str) -> ast.Decl {
		self.skip_newlines()

		// import "path" or import "path" { Name1, Name2, ... }
		if self.try_consume(.KwImport) {
			let tok: lexing.Token = self.advance()
			let raw: str = tok.value
			let module_name: str = raw[1..len(raw)-1]
			// local name = last path component
			mut local_name: str = module_name
			mut i: int64 = len(module_name) - 1
			for i >= 0 {
				if module_name[i] == '/' {
					local_name = module_name[i+1..len(module_name)]
					i = -1
				} else {
					i = i - 1
				}
			}
			mut items: [str] = []
			if self.try_consume(.OpenCurly) {
				for self.peek_kind() != .CloseCurly and self.peek_kind() != .EOF {
					items += [self.expect_identifier()]
					if not self.try_consume(.Comma) {
						break
					}
				}
				self.expect(.CloseCurly)
			}
			// An import that lists names binds no alias; `#` keeps source from naming it.
			if len(items) > 0 {
				local_name = "#" + local_name
			}
			self.skip_newlines()
			return ast.Decl.Import(:module_name, :local_name, :items)
		}

		// extern func
		if self.try_consume(.KwExtern) {
			self.expect(.KwFunc)
			let name_span: ast.Span = self.here()
			mut name: str = self.expect_identifier()
			mut params: [ast.Param] = self.parse_param_list()
			mut return_typ: int64 = 0
			if self.try_consume(.Arrow) {
				return_typ = self.parse_type_expr()
			}
			self.skip_newlines()
			return ast.Decl.Extern(:name, :name_span, :params, :return_typ)
		}

		// func
		if self.at(.KwFunc) {
			let func_decl: ast.FuncDecl = self.parse_func_decl(:doc)
			mut id: int64 = self.alloc_func_decl(func_decl)
			self.skip_newlines()
			return ast.Decl.Func(decl: id)
		}

		// interface Name { method signatures }
		if self.try_consume(.KwInterface) {
			let name_span: ast.Span = self.here()
			mut name: str = self.expect_identifier()
			self.expect(.OpenCurly)
			self.skip_newlines()
			mut methods: [int64] = []
			for self.at(.KwFunc) {
				let module: ast.FuncDecl = self.parse_func_sig(doc: "")
				methods += [self.alloc_func_decl(module)]
				self.skip_newlines()
			}
			self.expect(.CloseCurly)
			self.skip_newlines()
			return ast.Decl.Interface(:name, :name_span, :methods)
		}

		// test "description" { ... } — a unit test. The body is stashed
		// inside a synthesized FuncDecl with placeholder name "test"; the
		// codegen picks a unique label per test in the module.
		if self.try_consume(.KwTest) {
			let tok: lexing.Token = self.advance()
			let raw: str = tok.value
			let display: str = parse_string_value(raw)
			let binding_mark = self.binding_exprs
			mut body: [int64] = self.parse_block()
			let empty_params: [ast.Param] = []
			let func_decl: ast.FuncDecl = ast.FuncDecl(name: "test", name_span: ast.Span(start: tok.start), params: empty_params, return_typ: 0, :body, doc: "", expr_binds: self.binding_exprs > binding_mark)
			mut id: int64 = self.alloc_func_decl(func_decl)
			self.skip_newlines()
			return ast.Decl.Test(:display, decl: id)
		}

		// type Name = struct { } or enum { }
		if self.try_consume(.KwType) {
			let name_span: ast.Span = self.here()
			mut name: str = self.expect_identifier()
			// Optional generic params: type Name[A, B, ...] = ...
			// Preserve names so the codegen can monomorphise generic
			// structs per concrete instantiation.
			mut type_params: [str] = []
			if self.try_consume(.OpenBracket) {
				for self.peek_kind() != .CloseBracket and self.peek_kind() != .EOF {
					type_params += [self.expect_identifier()]
					if not self.try_consume(.Comma) {
						break
					}
				}
				self.expect(.CloseBracket)
			}
			self.expect(.Equal)
			if self.try_consume(.KwStruct) {
				self.expect(.OpenCurly)
				self.skip_newlines()
				mut fields: [ast.StructField] = self.parse_struct_fields()
				mut methods: [int64] = []
				for self.at(.KwFunc) {
					let module: ast.FuncDecl = self.parse_func_decl(doc: "", is_method: true)
					methods += [self.alloc_func_decl(module)]
					self.skip_newlines()
				}
				self.expect(.CloseCurly)
				self.skip_newlines()
				return ast.Decl.Struct(:name, :name_span, :type_params, :fields, :methods)
			}
			if self.try_consume(.KwEnum) {
				self.expect(.OpenCurly)
				self.skip_newlines()
				mut variants: [ast.EnumVariant] = self.parse_enum_variants()
				self.expect(.CloseCurly)
				self.skip_newlines()
				return ast.Decl.Enum(:name, :name_span, :type_params, :variants)
			}
			// Type alias: type X = SomeOtherType
			let target: int64 = self.parse_type_expr()
			self.skip_newlines()
			return ast.Decl.TypeAlias(:name, :target, :name_span)
		}

		if self.at(.KwLet) {
			return self.parse_const_decl(:doc)
		}

		let tok = self.advance()
		if tok.kind == .KwMut {
			self.record_error("error: a top-level `mut` isn't supported; use `let NAME: T = ...` for a constant", got: tok)
		} else {
			self.record_error(f"error: expected a declaration (`func`, `type`, `interface`, `import`, `extern` or `test`), got {lexing.kind_name(tok.kind)}", got: tok)
		}
		// Stray words before a declaration (`pub func f`) keep the declaration.
		if tok.kind == .Identifier {
			for self.at(.Identifier) {
				self.advance()
			}
		}
		if self.at(.KwFunc) or self.at(.KwType) or self.at(.KwInterface) or self.at(.KwExtern) or self.at(.KwImport) or self.at(.KwTest) {
			return self.parse_decl(:doc)
		}
		mut open = 0
		if tok.kind == .OpenCurly {
			open = 1
		}
		self.skip_rest_of_stmt(depth: open)
		if self.at(.CloseCurly) {
			self.advance()
		}
		self.skip_newlines()
		// The bad line's block may start on the next line.
		if self.at(.OpenCurly) {
			self.advance()
			self.skip_rest_of_stmt(depth: 1)
			self.skip_newlines()
		}
		return ast.Decl.Import(module_name: "", local_name: "", items: [])
	}

	// `let NAME: T = value` at the top level of a module. It becomes a function with no
	// parameters that returns `value`, flagged as a constant: a use of the name is a call to it.
	func parse_const_decl(self, doc: str) -> ast.Decl {
		self.advance()
		let name_span: ast.Span = self.here()
		let name: str = self.expect_identifier()
		if not self.at(.Colon) {
			self.record_error("error: a module-level constant needs a type: `let NAME: T = ...`", got: self.peek())
			for not self.at(.EOL) and not self.at(.EOF) {
				self.advance()
			}
			return ast.Decl.Import(module_name: "", local_name: "", items: [])
		}
		self.advance()
		let typ: int64 = self.parse_type_expr()
		self.expect(.Equal)
		let value: int64 = self.parse_expr()
		self.check_const_expr(value)
		let ret: int64 = self.alloc_stmt(ast.Stmt.Return(:value))
		let no_params: [ast.Param] = []
		let func_decl: ast.FuncDecl = ast.FuncDecl(:name, :name_span, params: no_params, return_typ: typ, body: [ret], :doc, is_const: true)
		let id: int64 = self.alloc_func_decl(func_decl)
		self.const_names += [name]
		self.const_exprs += [value]
		self.const_spans += [name_span]
		self.skip_newlines()
		return ast.Decl.Func(decl: id)
	}

	// A constant's value may hold only literals, operators, array literals, enum variants
	// and names; reports the first thing that is not one of those.
	func check_const_expr(self, anon id: int64) -> none {
		if not self.const_expr_ok(id) {
			return none
		}
	}

	// Whether `id` is a constant expression; reports the first part that is not.
	func const_expr_ok(self, anon id: int64) -> bool {
		match self.exprs[id] {
			.IntLit(_v) -> return true
			.FloatLit(_v) -> return true
			.StrLit(_v) -> return true
			.BytesLit(_v) -> return true
			.BoolLit(_v) -> return true
			.Ident(_n) -> return true
			.ImplicitVariant(_n) -> return true
			.Binary(lhs, op, rhs) -> {
				if op is .Index {
					return self.const_not_allowed(id)
				}
				if op is .Dot {
					// `Enum.Variant` or `module.NAME`: two plain names.
					if self.exprs[lhs] is .Ident(_a) and self.exprs[rhs] is .Ident(_b) {
						return true
					}
					return self.const_not_allowed(id)
				}
				if not self.const_expr_ok(lhs) {
					return false
				}
				return self.const_expr_ok(rhs)
			}
			.Chain(parts, _ops) -> {
				for part in parts {
					if not self.const_expr_ok(part) {
						return false
					}
				}
				return true
			}
			.ArrayLit(elements) -> {
				for element in elements {
					if not self.const_expr_ok(element) {
						return false
					}
				}
				return true
			}
			else return self.const_not_allowed(id)
		}
	}

	func const_not_allowed(self, anon id: int64) -> bool {
		let at: lexing.Token = lexing.Token(kind: .Identifier, value: "", start: self.expr_spans[id].start, end: self.expr_spans[id].start + 1)
		self.record_error("error: this can't be part of a module-level constant; use literals, operators, other constants and enum variants", got: at)
		return false
	}

	// The names `id` uses, appended to `into`.
	func const_names_in(self, anon id: int64, into: [str]) -> [str] {
		mut out: [str] = into
		match self.exprs[id] {
			.Ident(n) -> out += [n]
			.Binary(lhs, _op, rhs) -> {
				out = self.const_names_in(lhs, into: out)
				out = self.const_names_in(rhs, into: out)
			}
			.Chain(parts, _ops) -> {
				for part in parts {
					out = self.const_names_in(part, into: out)
				}
			}
			.ArrayLit(elements) -> {
				for element in elements {
					out = self.const_names_in(element, into: out)
				}
			}
			else none
		}
		return out
	}

	// Whether the constant at `start` can reach `target` through the constants it names.
	func const_reaches(self, anon start: int64, target: int64, depth: int64) -> bool {
		if depth > len(self.const_names) {
			return false
		}
		let none_yet: [str] = []
		for name in self.const_names_in(self.const_exprs[start], into: none_yet) {
			for k, const_name in self.const_names {
				if const_name == name {
					if k == target {
						return true
					}
					if self.const_reaches(k, :target, depth: depth + 1) {
						return true
					}
				}
			}
		}
		return false
	}

	func check_const_cycles(self) -> none {
		for i, const_name in self.const_names {
			if self.const_reaches(i, target: i, depth: 0) {
				let at: lexing.Token = lexing.Token(kind: .Identifier, value: "", start: self.const_spans[i].start, end: self.const_spans[i].start + len(const_name))
				self.record_error(f"error: constant `{const_name}` refers to itself", got: at)
			}
		}
	}

	func parse_module(self) -> ast.Module {
		mut decls: [ast.Decl] = []
		for self.peek_kind() != .EOF {
			// Eat blank lines, then collect any contiguous `//` doc
			// comments immediately above the next decl. A blank line
			// between comments and the decl breaks the association.
			for self.at(.EOL) {
				self.advance()
			}
			if self.peek_kind() == .EOF {
				break
			}
			let doc: str = self.consume_doc_comments()
			if self.peek_kind() == .EOF {
				break
			}
			let errors_before = len(self.errors)
			decls += [self.parse_decl(:doc)]
			self.expect_stmt_end(stmt_id: -1, :errors_before)
		}
		self.check_const_cycles()
		let renamer = Renamer(p: self)
		renamer.run(decls)
		return ast.Module(:decls)
	}

	// Consume any contiguous `//` comments immediately before the next
	// non-comment token. Returns the joined doc text with the `//` and
	// one trailing space stripped from each line; "" when no comments
	// precede the decl, or when a blank line separates them from it.
	func consume_doc_comments(self) -> str {
		mut lines: [str] = []
		for self.at(.Comment) {
			let tok: lexing.Token = self.advance()
			lines += [strip_comment_marker(tok.value)]
			// Allow exactly one EOL between comments (the natural line
			// break). A second EOL is a blank line — the comments
			// stop being docs for what follows.
			if not self.at(.EOL) {
				break
			}
			self.advance()
			if self.at(.EOL) {
				// Blank line — discard collected and start over so any
				// later comment block can still attach as docs.
				lines = []
				for self.at(.EOL) {
					self.advance()
				}
			}
		}
		if len(lines) == 0 {
			return ""
		}
		mut s: str = ""
		for i, line in lines {
			if i > 0 {
				s = s + "\n"
			}
			s = s + line
		}
		return s
	}
}

// Strip a leading `//` and one trailing space from a comment token's
// raw value. The lexer already skipped the indentation up to `//`,
// so the value starts with the slashes themselves.
func strip_comment_marker(anon raw: str) -> str {
	let n: int64 = len(raw)
	if n < 2 or raw[0..2] != "//" {
		return raw
	}
	mut s: int64 = 2
	if s < n and raw[s] == ' ' {
		s = s + 1
	}
	return raw[s..n]
}

// The rhs of `.` is a member name and the rhs of `is` a type or pattern, not a read.
func reads_operand_rhs(anon op: ast.Op) -> bool {
	match op {
		.Dot -> return false
		.Is -> return false
		.IsNot -> return false
		else return true
	}
}

// Gives a binding that hides one still in force a name of its own, `x#k`
// with k the number of bindings of `x` it hides, and renames the reads and
// stores that reach it, so codegen keeps one slot per name. A binding again
// at the same depth keeps the name in force, so sibling blocks share `x#1`.
// The depths:
//   parameters, `self`        1, like the function's top block
//   if/else/loop body         parent + 1 (an `else if` is one more)
//   `for x in xs` variable    the body's depth, bound after `xs`
//   match arm, `if … is`      the arm body's depth, bound after the subject
//   match-expression arm      parent + 1
//   let-else                  this depth, bound after its else block
//   `let` / `mut`             this depth, bound after its value
//   function literal          parent + 1 for its parameters and body
// A default sees no locals. A read of a binding older than a function literal
// is one it captures, which goes on the FuncDecl of every literal it's inside.
type Renamer = struct {
	p: Parser
	// The bindings in force, innermost last; `top` of them are live.
	names: [str] = []
	keys: [str] = []
	depths: [int64] = []
	levels: [int64] = []
	top: int64 = 0
	depth: int64 = 0
	// Live entries that hide another; a read needs a lookup only while one is.
	renamed: int64 = 0
	// Without a match expression or function literal an expression binds nothing.
	expr_binds: bool = false
	// The function literals being walked, outermost first, and `top` at each.
	lit_ids: [int64] = []
	lit_marks: [int64] = []

	func run(self, anon decls: [ast.Decl]) -> none {
		// Last first: a literal's id is below the function it's in, so it's walked in place.
		mut id = len(self.p.func_decls) - 1
		for id >= 1 {
			let fd = self.p.func_decls[id]
			id -= 1
			if fd.walked {
				continue
			}
			fd.walked = true
			self.top = 0
			self.renamed = 0
			self.expr_binds = fd.expr_binds
			self.depth = 1
			for param in fd.params {
				self.bind(param.name)
			}
			self.depth = 0
			self.block(fd.body)
			for param in fd.params {
				self.walk_default(param.default_expr)
			}
		}
		for decl in decls {
			match decl {
				.Struct(_name, _name_span, _type_params, fields, _methods) -> {
					for field in fields {
						self.walk_default(field.default_expr)
					}
				}
				.Extern(_name, _name_span, params, _return_typ) -> {
					for param in params {
						self.walk_default(param.default_expr)
					}
				}
				else none
			}
		}
	}

	func walk_default(self, anon expr_id: int64) -> none {
		self.top = 0
		self.renamed = 0
		self.expr_binds = true
		self.depth = 1
		self.expr(expr_id)
	}

	func literal(self, anon decl_id: int64) -> none {
		let fd = self.p.func_decls[decl_id]
		if fd.walked {
			return
		}
		fd.walked = true
		let saved_binds = self.expr_binds
		let mark = self.top
		self.expr_binds = true
		self.lit_ids += [decl_id]
		self.lit_marks += [mark]
		self.depth += 1
		for param in fd.params {
			param.name = self.bind(param.name)
		}
		self.depth -= 1
		self.block(fd.body)
		self.end_scope(mark)
		self.lit_ids = self.lit_ids[0..len(self.lit_ids) - 1]
		self.lit_marks = self.lit_marks[0..len(self.lit_marks) - 1]
		self.expr_binds = saved_binds
		for param in fd.params {
			if param.default_expr != 0 {
				let fresh = Renamer(p: self.p)
				fresh.walk_default(param.default_expr)
			}
		}
	}

	// The binding at `i` is read: a capture of each literal younger than it.
	func note_capture(self, anon i: int64, expr_id: int64) -> none {
		for k, mark in self.lit_marks {
			if i < mark {
				let fd = self.p.func_decls[self.lit_ids[k]]
				mut known = false
				for c in fd.captures {
					if c.key == self.keys[i] {
						known = true
					}
				}
				if not known {
					fd.captures += [ast.Capture(key: self.keys[i], span: self.p.expr_spans[expr_id])]
				}
			}
		}
	}

	func find(self, anon name: str) -> int64 {
		mut i = self.top - 1
		for i >= 0 {
			if self.names[i] == name {
				return i
			}
			i -= 1
		}
		return -1
	}

	// The name a binding of `name` at this depth gets.
	func bind(self, anon name: str) -> str {
		if len(name) == 0 {
			return name
		}
		mut key = name
		mut level = 0
		let i = self.find(name)
		if i >= 0 {
			key = self.keys[i]
			level = self.levels[i]
			if self.depths[i] < self.depth {
				level += 1
				key = f"{name}#{level}"
				self.p.renames += 1
			}
		}
		if self.top < len(self.names) {
			self.names[self.top] = name
			self.keys[self.top] = key
			self.depths[self.top] = self.depth
			self.levels[self.top] = level
		} else {
			self.names += [name]
			self.keys += [key]
			self.depths += [self.depth]
			self.levels += [level]
		}
		self.top += 1
		if level > 0 {
			self.renamed += 1
		}
		return key
	}

	func end_scope(self, anon mark: int64) -> none {
		for self.top > mark {
			self.top -= 1
			if self.levels[self.top] > 0 {
				self.renamed -= 1
			}
		}
	}

	func block(self, anon stmts: [int64]) -> none {
		let mark = self.top
		self.depth += 1
		for stmt_id in stmts {
			self.stmt(stmt_id)
		}
		self.depth -= 1
		self.end_scope(mark)
	}

	// The names `names` bind as, or [] when each keeps its own.
	func bind_all(self, anon names: [str]) -> [str] {
		mut keys: [str] = []
		mut changed = false
		for name in names {
			let key = self.bind(name)
			if key != name {
				changed = true
			}
			keys += [key]
		}
		if changed {
			return keys
		}
		let same: [str] = []
		return same
	}

	func bind_pattern(self, anon pattern_id: int64) -> none {
		match self.p.patterns[pattern_id] {
			.SomePat(binding) -> {
				let key = self.bind(binding)
				if key != binding {
					self.p.patterns[pattern_id] = ast.Pattern.SomePat(binding: key)
				}
			}
			.OkPat(binding) -> {
				let key = self.bind(binding)
				if key != binding {
					self.p.patterns[pattern_id] = ast.Pattern.OkPat(binding: key)
				}
			}
			.ErrPat(binding) -> {
				let key = self.bind(binding)
				if key != binding {
					self.p.patterns[pattern_id] = ast.Pattern.ErrPat(binding: key)
				}
			}
			.TypePat(type_name, binding) -> {
				let key = self.bind(binding)
				if key != binding {
					self.p.patterns[pattern_id] = ast.Pattern.TypePat(:type_name, binding: key)
				}
			}
			.EnumPat(enum_name, variant_name, bindings) -> {
				let keys = self.bind_all(bindings)
				if len(keys) > 0 {
					self.p.patterns[pattern_id] = ast.Pattern.EnumPat(:enum_name, :variant_name, bindings: keys)
				}
			}
			.ImplicitEnumPat(variant_name, bindings) -> {
				let keys = self.bind_all(bindings)
				if len(keys) > 0 {
					self.p.patterns[pattern_id] = ast.Pattern.ImplicitEnumPat(:variant_name, bindings: keys)
				}
			}
			else none
		}
		for sub in self.p.pattern_subs[pattern_id] {
			self.bind_pattern(sub.pattern)
		}
	}

	// A match arm's pattern binds for its body, one level in.
	func arm(self, anon pattern_id: int64, guard: int64, body: [int64]) -> none {
		let mark = self.top
		self.depth += 1
		self.bind_pattern(pattern_id)
		self.expr(guard)
		for stmt_id in body {
			self.stmt(stmt_id)
		}
		self.depth -= 1
		self.end_scope(mark)
	}

	func stmt(self, anon stmt_id: int64) -> none {
		match self.p.stmts[stmt_id] {
			.Let(name, typ, value, mutable) -> {
				if self.p.exprs[value] is .FuncLit(decl_id) {
					self.p.func_decls[decl_id].let_name = name
				}
				self.expr(value)
				let key = self.bind(name)
				if key != name {
					self.p.stmts[stmt_id] = ast.Stmt.Let(name: key, :typ, :value, :mutable)
				}
			}
			.Assign(lhs, rhs) -> {
				self.expr(lhs)
				self.expr(rhs)
			}
			.PlusAssign(lhs, rhs) -> {
				self.expr(lhs)
				self.expr(rhs)
			}
			.MinusAssign(lhs, rhs) -> {
				self.expr(lhs)
				self.expr(rhs)
			}
			.Return(value) -> self.expr(value)
			.Throw(value) -> self.expr(value)
			.Assert(expr, _source_text, _span) -> self.expr(expr)
			.ExprStmt(expr) -> self.expr(expr)
			.If(cond, then_body, else_body) -> {
				self.expr(cond)
				self.block(then_body)
				self.block(else_body)
			}
			.For(cond, body) -> {
				self.expr(cond)
				self.block(body)
			}
			.ForEach(name, iter, body) -> {
				self.expr(iter)
				let mark = self.top
				self.depth += 1
				let key = self.bind(name)
				if key != name {
					self.p.stmts[stmt_id] = ast.Stmt.ForEach(name: key, :iter, :body)
				}
				for body_id in body {
					self.stmt(body_id)
				}
				self.depth -= 1
				self.end_scope(mark)
			}
			.MatchStmt(subject, arms) -> {
				self.expr(subject)
				for arm_id in arms {
					let match_arm = self.p.match_arms[arm_id]
					self.arm(match_arm.pattern, guard: match_arm.guard, body: match_arm.body)
				}
			}
			.LetElse(pattern, value, else_body) -> {
				self.expr(value)
				self.block(else_body)
				self.bind_pattern(pattern)
			}
			else none
		}
	}

	func read(self, anon expr_id: int64, name: str) -> none {
		if self.renamed == 0 and len(self.lit_marks) == 0 {
			return
		}
		let i = self.find(name)
		if i < 0 {
			return
		}
		self.note_capture(i, :expr_id)
		if self.levels[i] > 0 {
			self.p.exprs[expr_id] = ast.Expr.Ident(name: self.keys[i])
		}
	}

	func args(self, anon args: [ast.CallArg]) -> none {
		for arg in args {
			self.expr(arg.value)
		}
	}

	func expr(self, anon expr_id: int64) -> none {
		if expr_id == 0 or (self.renamed == 0 and not self.expr_binds) {
			return
		}
		match self.p.exprs[expr_id] {
			.Ident(name) -> self.read(expr_id, :name)
			.Binary(lhs, op, rhs) -> {
				self.expr(lhs)
				if reads_operand_rhs(op) {
					self.expr(rhs)
				}
			}
			.Chain(exprs, _ops) -> {
				for e in exprs {
					self.expr(e)
				}
			}
			.Call(callee, args) -> {
				self.expr(callee)
				self.args(args)
			}
			.ArrayLit(elements) -> {
				for e in elements {
					self.expr(e)
				}
			}
			.MatchExpr(subject, arms) -> {
				self.expr(subject)
				for arm_id in arms {
					let match_arm = self.p.match_expr_arms[arm_id]
					let mark = self.top
					self.depth += 1
					self.bind_pattern(match_arm.pattern)
					self.expr(match_arm.guard)
					for stmt_id in match_arm.pre {
						self.stmt(stmt_id)
					}
					self.expr(match_arm.body)
					self.depth -= 1
					self.end_scope(mark)
				}
			}
			.Slice(s, lo, hi) -> {
				self.expr(s)
				self.expr(lo)
				self.expr(hi)
			}
			.Try(inner) -> self.expr(inner)
			.Must(inner) -> self.expr(inner)
			.UnwrapOpt(value, default) -> {
				self.expr(value)
				self.expr(default)
			}
			.OptionalDot(value, _field) -> self.expr(value)
			.OptionalMethodCall(value, _method, args) -> {
				self.expr(value)
				self.args(args)
			}
			.FuncLit(decl_id) -> self.literal(decl_id)
			else none
		}
	}
}

func make_parser(anon tokens: [lexing.Token], path: str, source: str) -> Parser {
	// Index 0 is reserved as a null sentinel in every pool so that fields
	// of type int64 can use 0 to mean 'absent' (e.g. no return type, no
	// type annotation, bare return, open slice). Push a dummy at index 0.
	let exprs: [ast.Expr] = [ast.Expr.NoneLit]
	let expr_spans: [ast.Span] = [ast.Span(start: 0)]
	mut stmts: [ast.Stmt] = [ast.Stmt.Break]
	let type_exprs: [ast.TypeExpr] = [ast.TypeExpr.Named(name: "")]
	let type_spans: [ast.Span] = [ast.Span(start: 0)]
	let line_starts: [int64] = []
	let patterns: [ast.Pattern] = [ast.Pattern.Wildcard]
	let pattern_ends: [int64] = [0]
	let dummy_arm_body: [int64] = []
	let match_arms: [ast.MatchArm] = [ast.MatchArm(pattern: 0, body: dummy_arm_body)]
	let match_expr_arms: [ast.MatchExprArm] = [ast.MatchExprArm(pattern: 0, body: 0)]
	let dummy_params: [ast.Param] = []
	let dummy_body: [int64] = []
	let func_decls: [ast.FuncDecl] = [ast.FuncDecl(name: "", name_span: ast.Span(start: 0), params: dummy_params, return_typ: 0, body: dummy_body, doc: "")]
	let errors: [ParseError] = []
	let no_subs: [ast.SubPattern] = []
	let pattern_subs: [[ast.SubPattern]] = [no_subs]
	return Parser(:path, :source, :tokens, pos: 0, :exprs, :expr_spans, :stmts, :type_exprs, :patterns, :pattern_subs, :match_arms, :match_expr_arms, :func_decls, :errors, :line_starts, :type_spans, :pattern_ends)
}
