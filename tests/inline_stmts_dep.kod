// A struct whose short methods are statements, for inline_stmts.kod.

let LIMIT: int64 = 5

func helper(anon n: int64) -> int64 {
    return n * 100
}

type Counter = struct {
    total: int64 = 0
    steps: int64 = 0
    _hidden: int64 = 3
    log: str = ""

    // An early return, a private field, a module constant and a function of this module.
    func add(self, anon n: int64) -> none {
        if n < 0 {
            return
        }
        self.steps += 1
        if self.steps > LIMIT {
            self.total = -1
            return
        }
        self.total += n * self._hidden + helper(0)
    }

    // A string field built up: the temporaries are released by the statement.
    func note(self, anon n: int64) -> none {
        self.log = self.log + f"{n};"
    }
}
