// A variant without a payload is one cell in the program's data: making one
// allocates nothing, whatever else its enum's variants carry.
extern func rc_live_bytes() -> int64

type Dir = enum {
    Up
    Down

    func flip(self) -> Dir {
        return match self {
            .Up -> .Down
            .Down -> .Up
        }
    }
}

type Shape = enum {
    Empty
    Square(side: int64)
}

func area(anon s: Shape) -> int64 {
    return match s {
        .Empty -> 0
        .Square(side) -> side * side
    }
}

func main() -> int64 {
    let before = rc_live_bytes()
    let up = Dir.Up
    let empty: Shape = .Empty
    print_int(rc_live_bytes() - before)
    mut d = up
    mut total = 0
    for _ in 0..1000 {
        d = d.flip()
        total += area(empty)
    }
    print(f"{rc_live_bytes() - before} {d == Dir.Up} {total}")
    let shapes: [Shape] = [.Empty, .Square(side: 3), .Empty]
    mut sum = 0
    for s in shapes {
        sum += area(s)
    }
    print_int(sum)
    return 0
}

// expected output:
// 0
// 0 true 0
// 9
