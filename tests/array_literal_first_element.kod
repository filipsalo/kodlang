// A literal with no type to go to is built as its first element's type.
interface Shape {
    func area(self) -> int64
}
type Sq = struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type Color = enum {
    Red
    Green
}
func main() -> int64 {
    let sh: Shape = Sq(s: 2)
    for y in [sh, Sq(s: 3)] {
        print_int(y.area())
    }
    let a: int64? = 3
    for x in [a, 5, none] {
        print_int(x? or 0)
    }
    print_int([a, 7][1]? or 0)
    let c = Color.Green
    for k in [c, .Red] {
        print(match k {
            .Red -> "red"
            .Green -> "green"
        })
    }
    let shapes: [Shape] = [Sq(s: 1)]
    for row in [shapes, [Sq(s: 4)]] {
        print_int(row[0].area())
    }
    return 0
}

// expected output:
// 4
// 9
// 3
// 5
// 0
// 7
// green
// red
// 1
// 16
