// `is` recovers a struct from an interface value boxed in another module,
// such as an error that an imported function throws.
import "./downcast_xmod_dep"
import "./downcast_xmod_dep" { Pt, Oops }

func main() -> int64 {
    let m = downcast_xmod_dep.boxed()
    if m is p: Pt {
        print_int(p.x)
    } else {
        print("not pt")
    }
    match m {
        p: Pt -> print(p.name())
        else -> print("?")
    }
    match downcast_xmod_dep.fail(1) {
        Ok(v) -> print_int(v)
        Err(e) -> {
            if e is o: Oops {
                print_int(o.code)
            } else {
                print(e.to_str())
            }
        }
    }
    print(downcast_xmod_dep.which(downcast_xmod_dep.Pt(x: 5)))
    return 0
}

// expected output:
// 42
// pt42
// 11
// dep sees pt 5
