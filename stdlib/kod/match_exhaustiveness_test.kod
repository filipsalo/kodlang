// Compiler tests for match exhaustiveness. Each test embeds a source
// snippet and runs it through the in-process dry-run codegen, then
// inspects the returned error list.

import "kod/codegen"
import "./test_support"

test "match on int64 requires an `else` arm" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n: int64 = 1
            match n {
                1 -> print("one")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "match on int64 must include an `else` arm")
}

test "match on str requires an `else` arm" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let s: str = "hello"
            match s {
                "a" -> print("a")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "match on str must include an `else` arm")
}

test "match on enum: missing variant reported" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum { Red, Green, Blue }
        func main() -> int64 {
            let c: Color = .Red
            match c {
                .Red -> print("red")
                .Green -> print("green")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "doesn't cover variant `Blue`")
}

test "match with `else` catch-all is accepted" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n: int64 = 1
            match n {
                1 -> print("one")
                else -> print("other")
            }
            return 0
        }
        """)
    assert len(errs) == 0
}

test "match on bool: missing `true` reported" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let b: bool = false
            match b {
                false -> print("f")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "match on bool doesn't cover `true`")
}

test "match on bool: missing `false` reported" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let b: bool = true
            match b {
                true -> print("t")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "match on bool doesn't cover `false`")
}

test "match on bool covering both arms is accepted" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let b: bool = true
            match b {
                true -> print("t")
                false -> print("f")
            }
            return 0
        }
        """)
    assert len(errs) == 0
}

test "match on bool with wildcard `else` is accepted" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let b: bool = true
            match b {
                true -> print("t")
                else -> print("other")
            }
            return 0
        }
        """)
    assert len(errs) == 0
}

test "match on a comparison is a bool match" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let a = 1
            match a < 2 {
                true -> print("t")
                false -> print("f")
            }
            return 0
        }
        """)
    assert len(errs) == 0
}

test "match on a comparison: missing `false` reported" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let a = 1
            let ok = a == 1 and a != 2
            match ok {
                true -> print("t")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "match on bool doesn't cover `false`")
}

let NESTED_TYPES: str = """
    type Shape = enum {
        Circle(r: int64)
        Rect(w: int64, h: int64)
    }
    type Pair = enum {
        Both(a: Shape?, b: bool)
    }
    """

test "a guarded arm covers nothing" {
    let errs: [codegen.Diagnostic] = test_support.try_compile(NESTED_TYPES + """
        func main() -> int64 {
            let s: Shape = .Circle(r: 1)
            match s {
                .Circle(r) if r > 0 -> print("big")
                .Rect(_, _) -> print("rect")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "doesn't cover variant `Circle`")
    let opt_errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let o: int64? = none
            let b = true
            let _ = match o {
                Some(v) if v > 0 -> 1
                none if b -> 2
                none -> 3
            }
            let _ = match b {
                true -> 1
                false if b -> 2
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(opt_errs, needle: "doesn't cover `Some(_)`")
    assert test_support.any_message_contains(opt_errs, needle: "doesn't cover `false`")
}

test "a guarded arm plus an unguarded one is exhaustive" {
    let errs: [codegen.Diagnostic] = test_support.try_compile(NESTED_TYPES + """
        func main() -> int64 {
            let s: Shape = .Circle(r: 1)
            match s {
                .Circle(r) if r > 0 -> print("big")
                .Circle(_) -> print("small")
                .Rect(_, _) -> print("rect")
            }
            return 0
        }
        """)
    assert len(errs) == 0
}

test "nested patterns count toward exhaustiveness" {
    let errs: [codegen.Diagnostic] = test_support.try_compile(NESTED_TYPES + """
        func main() -> int64 {
            let o: Shape? = none
            match o {
                Some(.Circle(_)) -> print("circle")
                Some(.Rect(_, _)) -> print("rect")
                none -> print("nothing")
            }
            let p: Pair = .Both(a: none, b: true)
            match p {
                .Both(Some(.Circle(_)), _) -> print("a")
                .Both(Some(.Rect(_, _)), true) -> print("b")
                .Both(Some(_), false) -> print("c")
                .Both(none, _) -> print("d")
            }
            return 0
        }
        """)
    assert len(errs) == 0
}

test "a gap under a nested pattern names what is missing" {
    let errs: [codegen.Diagnostic] = test_support.try_compile(NESTED_TYPES + """
        func main() -> int64 {
            let o: Shape? = none
            match o {
                Some(.Circle(_)) -> print("circle")
                none -> print("nothing")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "doesn't cover `Some(.Rect(_, _))`")
    let lit_errs: [codegen.Diagnostic] = test_support.try_compile(NESTED_TYPES + """
        func main() -> int64 {
            let s: Shape = .Circle(r: 1)
            match s {
                .Circle(0) -> print("zero")
                .Rect(_, _) -> print("rect")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(lit_errs, needle: "doesn't cover `.Circle(_)`")
    let pair_errs: [codegen.Diagnostic] = test_support.try_compile(NESTED_TYPES + """
        func main() -> int64 {
            let p: Pair = .Both(a: none, b: true)
            match p {
                .Both(Some(_), _) -> print("a")
                .Both(none, true) -> print("b")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(pair_errs, needle: "doesn't cover `.Both(none, false)`")
}

test "a recursive enum's nested patterns finish checking" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Tree = enum {
            Leaf
            Node(left: Tree, right: Tree)
        }
        func main() -> int64 {
            let t: Tree = .Leaf
            match t {
                .Node(.Leaf, _) -> print("a")
                .Node(.Node(_, _), .Leaf) -> print("b")
                .Leaf -> print("c")
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "doesn't cover `.Node(.Node(_, _), .Node(_, _))`")
}
