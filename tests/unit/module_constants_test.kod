// A top-level `let NAME: T = value` is a constant.
import "./../module_constants_dep"
import "./../module_constants_dep" { LIMIT }

type Color = enum {
    Red
    Green
}

// A constant may use constants declared before or after it.
let SECONDS_PER_DAY: int64 = 24 * HOURS_PER_DAY_SECONDS
let HOURS_PER_DAY_SECONDS: int64 = 60 * 60
let GREETING: str = "hello, " + AUDIENCE + "!"
let AUDIENCE: str = "world"
let PRIMES: [int64] = [2, 3, 5, 7]
let FAVORITE: Color = Color.Green
let VERBOSE: bool = false
let NEGATIVE: int64 = -5
let MASK: int64 = (1 << 4) - 1
let SMALL: bool = 1 < 2 and 2 < 3
let LETTER: int64 = 'A'
let BLOB: bytes = b"\x01\x02"

// Doc comments go with a constant, as they do with a function.
let DOCUMENTED: int64 = 7

func area(anon side: int64 = SIDE) -> int64 {
    return side * side
}

let SIDE: int64 = 3

func color_name(anon c: Color) -> str {
    match c {
        .Red -> return "red"
        .Green -> return "green"
    }
}

test "constants in expressions" {
    assert SECONDS_PER_DAY == 86400
    assert GREETING == "hello, world!"
    assert len(PRIMES) == 4
    assert PRIMES[2] == 5
    assert color_name(FAVORITE) == "green"
    if VERBOSE {
        fail("verbose")
    }
    assert NEGATIVE == -5
    assert MASK == 15
    if not SMALL {
        fail("not small")
    }
    assert LETTER == 65
    assert len(BLOB) == 2
    assert DOCUMENTED == 7
}

test "constants as defaults and with annotations" {
    assert area() == 9
    assert area(4) == 16
    let doubled: int64 = SIDE * 2
    assert doubled == 6
    let copy = SIDE
    assert copy == 3
}

test "another module's constants" {
    assert LIMIT == 1000
    assert module_constants_dep.LIMIT == 1000
    assert module_constants_dep.NAME == "limits"
    assert module_constants_dep.DOUBLE_LIMIT == 2000
    assert module_constants_dep.DOUBLE_LIMIT + LIMIT == 3000
}

test "a local hides a constant" {
    let SIDE = 10
    assert SIDE == 10
}

test "an array constant is new at each use" {
    mut mine = PRIMES
    mine[0] = 99
    assert PRIMES[0] == 2
    assert mine[0] == 99
}
