// `print` takes what an f-string does, and an enum converts to its variant's name.

type Color = enum {
    Red
    Blue
}

type Op = enum {
    Lit(n: int64)
    Add(a: int64, b: int64)
    Nop
}

type Point = struct {
    x: int64

    func to_str(self) -> str {
        return f"<{self.x}>"
    }
}

type Maybe[T] = enum {
    Just(value: T)
    Nothing
}


func main() -> int64 {
    print(3)
    print(true)
    print("text")
    print(1 + 2)
    print(Point(x: 4))
    let c: Color = .Blue
    print(c)
    print(f"color {c}!")
    print(Op.Lit(n: 4))
    print(Op.Add(a: 1, b: 2))
    print(f"{Op.Nop} {Color.Red}")
    let m: Maybe[int64] = .Just(value: 1)
    print(m)
    return 0
}

// expected output:
// 3
// true
// text
// 3
// <4>
// Blue
// color Blue!
// Lit
// Add
// Nop Red
// Just
