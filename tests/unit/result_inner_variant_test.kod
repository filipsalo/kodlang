// In a `T or Error` function, a returned `.Ok` is T's own variant when only
// its payload fits, and the result's `Ok` otherwise, through an alias too.
type Status = enum {
    Ok
    Failed(code: int64)
}

type Bad = shared struct {
    func to_str(self) -> str {
        return "bad"
    }
}

func check(anon n: int64) -> Status or Error {
    if n < 0 {
        throw Bad()
    }
    if n == 0 {
        return .Failed(code: 7)
    }
    if n == 2 {
        return .Ok(.Failed(code: 2))
    }
    if n == 3 {
        return .Ok(value: Status.Ok)
    }
    return .Ok
}

func arm(anon n: int64) -> Status or Error {
    return match n {
        0 -> .Ok
        1 -> .Ok(.Failed(code: 1))
        else -> .Failed(code: n)
    }
}

type Reading = enum {
    Ok(n: int64)
    Down
}

type Res = Status or Error

func aliased(anon n: int64) -> Res {
    if n == 0 {
        return .Ok
    }
    if n == 1 {
        return .Ok(.Failed(code: 1))
    }
    return match n {
        2 -> .Ok
        else -> .Failed(code: n)
    }
}

func read(anon k: int64) -> Reading or Error {
    if k == 0 {
        return .Ok(5)
    }
    if k == 1 {
        return .Ok(.Down)
    }
    if k == 2 {
        let r: Reading = .Ok(n: 8)
        return .Ok(r)
    }
    return .Ok(n: k)
}

func reading(anon r: Reading) -> str {
    match r {
        .Ok(n) -> return f"reading {n}"
        .Down -> return "down"
    }
}

type Gauge = enum {
    Ok(value: int64)
    Off
}

func gauge(anon n: int64) -> Gauge or Error {
    return .Ok(value: n)
}

func name(anon s: Status) -> str {
    match s {
        .Ok -> return "ok"
        .Failed(code) -> return f"failed {code}"
    }
}

func checked(anon r: Status or Error) -> str {
    return match r {
        Ok(s) -> name(s)
        Err(e) -> f"err {e}"
    }
}

test "a returned .Ok in a T or Error function" {
    mut got: [str] = []
    for n in [1, 0, -1, 2, 3] {
        got += [checked(check(n))]
    }
    assert got == ["ok", "failed 7", "err bad", "failed 2", "ok"]
}

test "a returned .Ok in a match arm" {
    mut got: [str] = []
    for n in [0, 1, 4] {
        got += [name(must arm(n))]
    }
    assert got == ["ok", "failed 1", "failed 4"]
}

test "a returned .Ok through an alias" {
    mut got: [str] = []
    for n in [0, 1, 2, 3] {
        got += [checked(aliased(n))]
    }
    assert got == ["ok", "failed 1", "ok", "failed 3"]
}

test "a T whose Ok variant has a payload" {
    mut got: [str] = []
    for k in [0, 1, 2, 3] {
        got += [reading(must read(k))]
    }
    assert got == ["reading 5", "down", "reading 8", "reading 3"]
    let g = must gauge(4)
    if g is .Ok(value) {
        assert value == 4
    } else {
        fail("not Ok")
    }
}
