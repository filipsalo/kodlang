// More locals than fit in the frame's short addressing (past slot 32), kept
// in registers where they fit: each must keep its own value, around a loop
// and across calls.

func bump(anon n: int64) -> int64 {
    return n + 1000
}

func main() -> int64 {
    mut a0: int64 = 1
    mut a1: int64 = 4
    mut a2: int64 = 7
    mut a3: int64 = 10
    mut a4: int64 = 13
    mut a5: int64 = 16
    mut a6: int64 = 19
    mut a7: int64 = 22
    mut a8: int64 = 25
    mut a9: int64 = 28
    mut a10: int64 = 31
    mut a11: int64 = 34
    mut a12: int64 = 37
    mut a13: int64 = 40
    mut a14: int64 = 43
    mut a15: int64 = 46
    mut a16: int64 = 49
    mut a17: int64 = 52
    mut a18: int64 = 55
    mut a19: int64 = 58
    mut a20: int64 = 61
    mut a21: int64 = 64
    mut a22: int64 = 67
    mut a23: int64 = 70
    mut a24: int64 = 73
    mut a25: int64 = 76
    mut a26: int64 = 79
    mut a27: int64 = 82
    mut a28: int64 = 85
    mut a29: int64 = 88
    mut a30: int64 = 91
    mut a31: int64 = 94
    mut a32: int64 = 97
    mut a33: int64 = 100
    mut a34: int64 = 103
    mut a35: int64 = 106
    mut a36: int64 = 109
    mut a37: int64 = 112
    mut a38: int64 = 115
    mut a39: int64 = 118
    for round in 0..3 {
        a0 = a0 + round + 0
        a1 = a1 + round + 1
        a2 = a2 + round + 2
        a3 = a3 + round + 3
        a4 = a4 + round + 4
        a5 = a5 + round + 5
        a6 = a6 + round + 6
        a7 = a7 + round + 7
        a8 = a8 + round + 8
        a9 = a9 + round + 9
        a10 = a10 + round + 10
        a11 = a11 + round + 11
        a12 = a12 + round + 12
        a13 = a13 + round + 13
        a14 = a14 + round + 14
        a15 = a15 + round + 15
        a16 = a16 + round + 16
        a17 = a17 + round + 17
        a18 = a18 + round + 18
        a19 = a19 + round + 19
        a20 = a20 + round + 20
        a21 = a21 + round + 21
        a22 = a22 + round + 22
        a23 = a23 + round + 23
        a24 = a24 + round + 24
        a25 = a25 + round + 25
        a26 = a26 + round + 26
        a27 = a27 + round + 27
        a28 = a28 + round + 28
        a29 = a29 + round + 29
        a30 = a30 + round + 30
        a31 = a31 + round + 31
        a32 = a32 + round + 32
        a33 = a33 + round + 33
        a34 = a34 + round + 34
        a35 = a35 + round + 35
        a36 = a36 + round + 36
        a37 = a37 + round + 37
        a38 = a38 + round + 38
        a39 = a39 + round + 39
        a7 = bump(a7)
    }
    mut total: int64 = 0
    total = total * 3 + a0
    total = total * 3 + a1
    total = total * 3 + a2
    total = total * 3 + a3
    total = total * 3 + a4
    total = total * 3 + a5
    total = total * 3 + a6
    total = total * 3 + a7
    total = total * 3 + a8
    total = total * 3 + a9
    total = total * 3 + a10
    total = total * 3 + a11
    total = total * 3 + a12
    total = total * 3 + a13
    total = total * 3 + a14
    total = total * 3 + a15
    total = total * 3 + a16
    total = total * 3 + a17
    total = total * 3 + a18
    total = total * 3 + a19
    total = total * 3 + a20
    total = total * 3 + a21
    total = total * 3 + a22
    total = total * 3 + a23
    total = total * 3 + a24
    total = total * 3 + a25
    total = total * 3 + a26
    total = total * 3 + a27
    total = total * 3 + a28
    total = total * 3 + a29
    total = total * 3 + a30
    total = total * 3 + a31
    total = total * 3 + a32
    total = total * 3 + a33
    total = total * 3 + a34
    total = total * 3 + a35
    total = total * 3 + a36
    total = total * 3 + a37
    total = total * 3 + a38
    total = total * 3 + a39
    print_int(total)
    print_int(a0 + a39 * 1000 + a7 * 1000000)
    return 0
}

// expected output:
// -7229342547873881168
// 3046238004
// expected status:
// 0
