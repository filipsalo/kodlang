// Generic code with function literals, used from another module.

func prefix() -> str {
    return "dep"
}

func labeller[T](anon x: T) -> func(str) -> str {
    return func(anon tag: str) -> str {
        return f"{prefix()}:{tag}:{x}"
    }
}

// The same instance as the test module makes, made here too.
func labelled_here() -> str {
    return labeller(3)("here")
}

func apply_to[T](anon x: T, anon f: func(T) -> T) -> T {
    return f(x)
}
