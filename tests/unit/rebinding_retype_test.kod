// A `let` that binds a name again in its block reads the old binding,
// with its old type, in its value.
type A = shared struct {
    x: int64
}

func label(anon n: int64) -> str {
    let n = f"#{n}"
    return n
}

test "a rebinding reads the old binding" {
    let x = 5
    let x = f"v{x}"
    assert x == "v5"
    let a = A(x: 7)
    let a = a.x + 1
    assert a == 8
    let o: int64? = 4
    match o {
        Some(v) -> {
            let v = f"v{v}"
            assert v == "v4"
        }
        none -> fail("none")
    }
    assert label(3) == "#3"
}
