// Leaf functions with more locals than there are caller-saved registers, in loops.
// What they give was worked out apart from the compiler.

func crowded_0(anon xs: [int64], anon bs: bytes, anon p0: int64, anon p1: int64, anon p2: int64) -> int64 {
    mut v0 = p0
    mut v1 = xs[(p1 | p1) & 15]
    mut v2 = ((v0 * 5) - (p0 ^ 1542))
    mut v3 = ((p0 & v2) & (p0 * 8))
    mut v4 = xs[(p1 ^ 1926) & 15]
    mut v5 = ((2730 - p2) ^ (2219 * 1))
    mut v6 = v0
    mut v7 = kod_bytes_le64(bs, (3171 & v1) & 15)
    mut v8 = xs[(p1).trailing_zeros() & 15]
    mut v9 = (xs[v0 & 15] - 3391)
    mut v10 = ((v9 >> 5) + (v4 - v3))
    mut v11 = v7
    mut v12 = ((v6 >> 5) - (v6 + 5))
    mut v13 = ((v10 + v4) >> 6)
    mut v14 = (p1 ^ v8)
    for i1 in 0..1 {
        for i2 in 0..4 {
            v6 = (xs[(v8 ^ 2901) & 15] + ((((v9 - v1) - (v4 - 4907)) + 4672) >> 3))
        }
        v3 += (((p2 - v0)).trailing_zeros() - p0)
    }
    v12 = xs[((v0 - p0) - (v8 - v10)) & 15]
    return ((((((((((((((v0 ^ (v1 * 3)) ^ (v2 * 4)) ^ (v3 * 5)) ^ (v4 * 6)) ^ (v5 * 7)) ^ (v6 * 8)) ^ (v7 * 9)) ^ (v8 * 10)) ^ (v9 * 11)) ^ (v10 * 12)) ^ (v11 * 13)) ^ (v12 * 14)) ^ (v13 * 15)) ^ (v14 * 16))
}

func crowded_1(anon xs: [int64], anon bs: bytes, anon p0: int64, anon p1: int64, anon p2: int64, anon p3: int64, anon p4: int64) -> int64 {
    mut v0 = ((p3 - p3)).trailing_zeros()
    mut v1 = ((p4 - p0) | (p1 + p4))
    mut v2 = (p1 - (541).trailing_zeros())
    mut v3 = xs[(p2 * 7) & 15]
    mut v4 = ((v1).trailing_zeros() + p4)
    mut v5 = ((v2 + 305) * 2)
    mut v6 = ((p2 + p0) - (p2 - 4449))
    mut v7 = ((v5 & v2) + p2)
    mut v8 = ((v4 >> 5) & xs[3746 & 15])
    mut v9 = ((52 | v2) + v8)
    mut v10 = ((v1 + p4) - (v2 - 320))
    mut v11 = ((v10 + v4) + xs[v2 & 15])
    if ((v0 + p4) - (p2 & v11)) < (p3 | (p4 + v7)) {
        v9 = p4
        v2 += v3
        v8 = ((p4 * 3) - (v4 - p2))
        v3 = ((((kod_bytes_le64(bs, v0 & 15) - (p0 | v1)) * 4) - (((v9 + v7) - (4384 + 2595)) - ((p1 - v6) * 8))) + (((v3 - (p0 & 4111)) * 1) ^ (((p4 & 4901) | (v9 + v2)) & (v0 ^ (2478 - v10)))))
    } else {
        v1 = ((946 & p3) + (398 - p2))
        v1 = (v8).trailing_zeros()
        v6 = v5
        for i1 in 0..4 {
            v10 = (((xs[(v9 | v8) & 15] >> 5) - (((v9 + v9) - v4) ^ ((3943 * 2) * 8))) & v8)
            v6 = p3
            v6 = ((xs[v9 & 15] + (v11 + v1)) - xs[(2401 - p1) & 15])
            v10 = xs[2086 & 15]
        }
    }
    if v2 < ((4891 * 4)).trailing_zeros() {
        v3 = (v7 - (xs[((v1 + 2681) | (p0 - v8)) & 15] + (((p1 - v4) + (p2 * 7)) * 8)))
        v5 = (v8 * 2)
        v10 += (((p4 + v10) + (1478 & 3506)) >> 4)
    } else {
        v4 = ((v9 - v4) & (v5).trailing_zeros())
        v3 = (v3 - xs[907 & 15])
        v0 = kod_bytes_le64(bs, (p2 + ((p4 & v8) - (v11 * 1))) & 15)
    }
    return (((((((((((v0 ^ (v1 * 3)) ^ (v2 * 4)) ^ (v3 * 5)) ^ (v4 * 6)) ^ (v5 * 7)) ^ (v6 * 8)) ^ (v7 * 9)) ^ (v8 * 10)) ^ (v9 * 11)) ^ (v10 * 12)) ^ (v11 * 13))
}

test "many locals in a leaf function, 1" {
    let xs: [int64] = [-8358595930177792728, 40, 5899822014965179147, -4303502238279503321, 3540875882980888845, 8560939601899684594, 4125145518022194610, 52, 656, 273, 7244564664994725662, -7621939402519846474, 499, 355, 2455352818075143242, 854]
    let bs = kod_bytes_from_array([106, 76, 51, 0, 182, 250, 76, 36, 141, 40, 178, 140, 202, 98, 47, 147, 160, 152, 157, 125, 73, 248, 151, 20, 233, 1, 210, 0, 28, 41, 129, 209, 12, 220, 177, 183, 69, 181, 238, 15])
    assert crowded_0(xs, bs, 296, -69, -544) == 7933771441529890504
}

test "many locals in a leaf function, 2" {
    let xs: [int64] = [160, 564, 830, 8746243867259934948, 898, -3475045326653723052, 3861444739463633792, 104, 877, 499, -2946565378958085893, 545, 938, -6860633980295078206, 4028102430486873844, 6059266885483971259]
    let bs = kod_bytes_from_array([173, 49, 184, 214, 8, 215, 31, 77, 119, 66, 168, 242, 58, 253, 139, 139, 128, 139, 112, 196, 255, 43, 143, 165, 129, 46, 209, 11, 69, 202, 200, 175, 78, 205, 137, 249, 184, 132, 183, 8])
    assert crowded_1(xs, bs, -326, 118, 530, 362, -816) == 976287917878260158
}
