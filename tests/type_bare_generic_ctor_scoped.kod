// A generic constructor of a type that only another module declares gets the
// hint where a local of that name is only elsewhere: after its block, or
// before its `let`.
import "./type_bare_generic_ctor_dep"

func after_block(anon n: int64) -> int64 {
    if n > 0 {
        let Box = 4
        print_int(Box)
    }
    let a = Box[int64](v: 1)
    return 0
}

func before_let() -> int64 {
    let a = Wrap[str](v: "x")
    let Wrap = 4
    return Wrap
}

func main() -> int64 {
    print_int(after_block(1))
    return before_let()
}

// expected errors:
// 11:13: error: unknown type `Box`; tests/type_bare_generic_ctor_dep.kod declares `Box`: write `type_bare_generic_ctor_dep.Box` or list it in the import (`{ Box }`)
// 16:13: error: unknown type `Wrap`; tests/type_bare_generic_ctor_dep.kod declares `Wrap`: write `type_bare_generic_ctor_dep.Wrap` or list it in the import (`{ Wrap }`)
