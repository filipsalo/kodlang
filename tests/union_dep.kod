type Unit = struct {
    name: str
}
type Value = str | int64 | Unit

func describe(anon v: Value) -> str {
    return match v {
        s: str -> f"text {s}"
        n: int64 -> f"number {n}"
        u: Unit -> f"unit {u.name}"
    }
}

func default_value() -> int64 | Unit | str {
    return Unit(name: "kg")
}
