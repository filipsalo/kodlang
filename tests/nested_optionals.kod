// An optional of an optional is that optional: `T?` is `T | none`, a set, so
// `none` means one thing however the type is spelled.
type MaybeInt = int64?

type Slot = struct {
    v: MaybeInt?
}

type Box = enum {
    Full(v: MaybeInt?)
    Empty
}

func show(anon x: MaybeInt?) -> str {
    match x {
        int64(n) -> return f"some {n}"
        none -> return "none"
    }
}

func lift(anon x: int64?) -> MaybeInt? {
    return x
}

func first[T](anon xs: [T]) -> T? {
    if len(xs) == 0 {
        return none
    }
    return xs[0]
}

func main() -> int64 {
    // A stored `none` and a missing key both read as `none`; `contains` tells them apart.
    let m = Map[str, int64?]()
    m.set("k", 5)
    m["n"] = none
    for key in ["k", "n", "zz"] {
        print(f"{key}: {show(m.get(key))} {show(m[key])} {m.contains(key)}")
    }
    let five: int64? = 5
    let stored: int64? = none
    print(show(lift(five)))
    print(show(lift(stored)))
    let s = Slot(v: stored)
    print(show(s.v))
    s.v = five
    print(show(s.v))
    let boxes = [Box.Full(v: stored), Box.Full(v: five), Box.Empty]
    for b in boxes {
        match b {
            .Full(v) -> print(show(v))
            .Empty -> print("empty")
        }
    }
    let xs: [MaybeInt?] = [five, stored, none]
    for x in xs {
        print(show(x))
    }
    let opts: [int64?] = [none, 3]
    let empty: [int64?] = []
    print(f"{show(first(opts))} {show(first(empty))}")
    if first(opts) is none {
        print("first is none")
    }
    let got: int64 = m.get("k")? or 0
    print_int(got)
    return 0
}

// expected output:
// k: some 5 some 5 true
// n: none none true
// zz: none none false
// some 5
// none
// none
// some 5
// none
// some 5
// empty
// some 5
// none
// none
// none none
// first is none
// 5
