import "./../xmod_default_scope_dep"

// Aliases here must not rebind the dep's method bodies to this module.
type C2 = xmod_default_scope_dep.Counter
type SBox = xmod_default_scope_dep.Box[str]

func helper() -> int64 {
    return 2
}

func other() -> int64 {
    return 3
}

test "defaults and bodies resolve in the dep's scope" {
    let helper = other
    let bx = SBox(v: "x")
    assert xmod_default_scope_dep.f() == 1
    assert xmod_default_scope_dep.run() == 1
    assert xmod_default_scope_dep.Cfg().n == 1
    assert xmod_default_scope_dep.Counter(base: 0).bump() == 1
    assert bx.tag() == 1
    assert xmod_default_scope_dep.Counter(base: 0).step() == 1
    assert C2(base: 0).step() == 1
}
