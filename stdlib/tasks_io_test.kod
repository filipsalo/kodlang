// Tasks that wait for I/O, timers and child processes let the others run
// (docs/tasks.md).

import "arrays"
import "net/tcp"
import "process"
import "stream" { IoError }
import "tasks"
import "time"
import "time" { Duration, monotonic_ns }

mut trace: [str] = []

func nap(anon ms: int64) -> int64 {
    time.sleep(Duration(ms: ms))
    return ms
}

func ms_since(anon t0: int64) -> int64 {
    return (monotonic_ns() - t0) / 1000000
}

test "tasks sleep at the same time" {
    let t0 = monotonic_ns()
    let a = spawn nap(100)
    let b = spawn nap(100)
    let c = spawn nap(100)
    assert a.wait() + b.wait() + c.wait() == 300
    let took = ms_since(t0)
    assert 100 <= took < 250
}

test "a task that gives way doesn't hold up one that sleeps" {
    let t0 = monotonic_ns()
    let sleeper = spawn nap(50)
    mut turns: int64 = 0
    for ms_since(t0) < 200 and turns < 100000000 {
        tasks.give_way()
        turns += 1
        if turns % 1000 == 0 {
            // The sleeper ends while this one is busy.
            if ms_since(t0) >= 60 {
                break
            }
        }
    }
    assert sleeper.wait() == 50
    assert ms_since(t0) < 200
}

func note(anon what: str) -> none {
    trace += [what]
}

func run_child() -> int64 or Error {
    let child = try process.start(["sleep", "0.2"], stdin: .Null, stdout: .Null, stderr: .Null)
    let status = try child.wait()
    note("child done")
    return status
}

func tick(anon n: int64) -> none {
    for i in 0..n {
        time.sleep(Duration(ms: 20))
        note(f"tick {i}")
    }
}

test "waiting for a child process lets the others run" {
    trace = []
    let t0 = monotonic_ns()
    let child = spawn run_child()
    spawn tick(3)
    assert must child.wait() == 0
    assert trace[0..3] == ["tick 0", "tick 1", "tick 2"]
    assert trace[3] == "child done"
    assert ms_since(t0) < 400
}

func serve_once(anon l: tcp.Listener) -> str or Error {
    let conn = try l.accept()
    let data = try conn.read(100)
    try conn.write(data)
    try conn.close()
    return kod_bytes_to_str(data)
}

test "a server and a client in one program" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let server = spawn serve_once(l)
    let conn = must tcp.connect("127.0.0.1", port: l.port())
    must conn.write(kod_str_to_bytes("ping"))
    // Without tasks waiting for I/O this read would hold up the server.
    let back = must conn.read(100)
    assert kod_bytes_to_str(back) == "ping"
    assert must server.wait() == "ping"
    must conn.close()
    must l.close()
}

test "with one task, a sleep just sleeps" {
    let t0 = monotonic_ns()
    time.sleep(Duration(ms: 30))
    assert ms_since(t0) >= 30
}

func accept_forever(anon l: tcp.Listener) -> none or Error {
    let conn = l.accept()
    if conn is Err(e) and e is IoError(io) and io.kind == .Cancelled {
        note("accept cancelled")
    }
    try conn
}

func give_up(anon l: tcp.Listener) -> none or Error {
    spawn accept_forever(l)
    time.sleep(Duration(ms: 20))
    throw IoError(kind: .InvalidInput, op: "give_up", errno: 0, detail: "no")
}

test "a function that returns an error cancels its tasks" {
    trace = []
    let l = must tcp.listen("127.0.0.1", port: 0)
    let t0 = monotonic_ns()
    assert give_up(l) is Err(_)
    assert trace == ["accept cancelled"]
    assert ms_since(t0) < 500
    must l.close()
}

func nap_then_note(anon ms: int64) -> none {
    time.sleep(Duration(ms: ms))
    note("woke")
}

func receive_or_note(anon ch: tasks.Channel[int64]) -> none {
    if ch.receive() is none {
        note("receive gave up")
    }
}

func fail_with_waiters(anon ch: tasks.Channel[int64]) -> none or Error {
    spawn nap_then_note(5000)
    spawn receive_or_note(ch)
    tasks.give_way()
    throw IoError(kind: .InvalidInput, op: "fail", errno: 0, detail: "no")
}

test "a cancelled task's sleep ends and its receive gives none" {
    trace = []
    let t0 = monotonic_ns()
    assert fail_with_waiters(tasks.Channel[int64]()) is Err(_)
    assert ms_since(t0) < 500
    assert arrays.contains(trace, "woke")
    assert arrays.contains(trace, "receive gave up")
}

func ok_after(anon ms: int64) -> int64 {
    time.sleep(Duration(ms: ms))
    return ms
}

test "within gives the result in time, or a timeout and cancels" {
    assert must tasks.within(Duration(ms: 500), func() -> int64 { return ok_after(10) }) == 10
    let t0 = monotonic_ns()
    let late = tasks.within(Duration(ms: 50), func() -> int64 { return ok_after(5000) })
    if late is Err(e) and e is IoError(io) {
        assert io.kind == .TimedOut
    } else {
        fail("no timeout")
    }
    assert ms_since(t0) < 500
}

func slow_value(anon ms: int64, anon value: int64) -> int64 or Error {
    time.sleep(Duration(ms: ms))
    return value
}

func slow_failure(anon ms: int64) -> int64 or Error {
    time.sleep(Duration(ms: ms))
    throw IoError(kind: .InvalidInput, op: "slow", errno: 0, detail: "failed")
}

test "tasks.all gives the results in order, at the same time" {
    let t0 = monotonic_ns()
    let got = must tasks.all([
        func() -> int64 or Error { return slow_value(60, 1) },
        func() -> int64 or Error { return slow_value(20, 2) },
        func() -> int64 or Error { return slow_value(40, 3) },
    ])
    assert got == [1, 2, 3]
    assert ms_since(t0) < 150
}

test "tasks.all gives the first error and cancels the rest" {
    let t0 = monotonic_ns()
    let got = tasks.all([
        func() -> int64 or Error { return slow_value(5000, 1) },
        func() -> int64 or Error { return slow_failure(20) },
    ])
    assert got is Err(_)
    assert ms_since(t0) < 500
}

test "tasks.first gives the first success and cancels the rest" {
    let t0 = monotonic_ns()
    let got = tasks.first([
        func() -> int64 or Error { return slow_value(5000, 1) },
        func() -> int64 or Error { return slow_failure(10) },
        func() -> int64 or Error { return slow_value(30, 3) },
    ])
    assert must got == 3
    assert ms_since(t0) < 500
    let none_ok = tasks.first([func() -> int64 or Error { return slow_failure(5) }])
    assert none_ok is Err(_)
}

mut running: int64 = 0
mut most: int64 = 0

func square_slowly(anon x: int64) -> int64 {
    running += 1
    if running > most {
        most = running
    }
    time.sleep(Duration(ms: 20))
    running -= 1
    return x * x
}

test "tasks.map_concurrently keeps the order and the limit" {
    most = 0
    let t0 = monotonic_ns()
    let got = tasks.map_concurrently([1, 2, 3, 4, 5, 6], square_slowly, limit: 3)
    assert got == [1, 4, 9, 16, 25, 36]
    assert most == 3
    assert ms_since(t0) < 120
}

func bump_slowly(anon m: tasks.Mutex) -> none {
    m.lock()
    let seen = counter
    time.sleep(Duration(ms: 10))
    counter = seen + 1
    m.unlock()
}

mut counter: int64 = 0

// Returns once the three have ended.
func bump_three(anon m: tasks.Mutex) -> none {
    spawn bump_slowly(m)
    spawn bump_slowly(m)
    spawn bump_slowly(m)
}

test "a Mutex keeps a value held across a wait" {
    counter = 0
    bump_three(tasks.Mutex())
    assert counter == 3
}
