// The interface and its provided methods for interface_provided_xmod.kod.

interface Source {
    func next(self) -> int64

    func take(self, anon n: int64, from: int64 = 0) -> [int64] {
        mut out: [int64] = []
        for _ in 0..n {
            out += [self.next() + from]
        }
        return out
    }
}

type Ones = shared struct {
    func next(self) -> int64 {
        return 1
    }
}
