// An interpolation can hold string literals, braces in strings and nested f-strings.
type B = shared struct {
    item: str
}

test "interpolations hold strings, braces and nested f-strings" {
    let n = 1
    let nn = 22
    assert f"[{f"<{nn}>"}]" == "[<22>]"
    let b = B(item: "box")
    let name = "kod"
    assert f"nested {f"inner {b.item}"} done" == "nested inner box done"
    assert f"{f"{name}"}" == "kod"
    assert f"{"}" + name} {n}" == "}kod 1"
    let c = 'x'
    assert f"{c == '"'} {c == '}'}" == "false false"
    let t = f"""
        a {f"b {nn}"} c
        """
    assert t[0..len(t) - 1] == "a b 22 c"
}
