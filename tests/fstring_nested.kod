// An interpolation can hold string literals, braces in strings and nested f-strings.
type B = struct {
    item: str
}
func main() -> int64 {
    let n = 1
    let nn = 22
    print(f"[{f"<{nn}>"}]")
    let b = B(item: "box")
    let name = "kod"
    print(f"nested {f"inner {b.item}"} done")
    print(f"{f"{name}"}")
    print(f"{"}" + name} {n}")
    let c = 'x'
    print(f"{c == '"'} {c == '}'}")
    let t = f"""
        a {f"b {nn}"} c
        """
    print(t[0..len(t) - 1])
    return 0
}

// expected output:
// [<22>]
// nested inner box done
// kod
// }kod 1
// false false
// a b 22 c
