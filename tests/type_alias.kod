// Type aliases are transparent and can name any type, including ones
// declared further down the module.

type Name = str
type Ids = [int64]
type MaybeBox = Box?
type Cb = func(int64) -> int64
type Fwd = Later
type Shown = Showable
type Far = Mid
type Mid = Distant
type FarDir = MidDir
type MidDir = Dir

type Box = struct {
    label: str
}

type Later = struct {
    n: int64
    s: str
}

type Distant = struct {
    tag: str
}

type Dir = enum {
    Up
    Down(steps: int64)
}

interface Showable {
    func show(self) -> str
}

type Dot = struct {
    c: str

    func show(self) -> str {
        return f"dot {self.c}"
    }
}

func greet(anon n: Name) -> str {
    return f"hi {n} ({n.char_count()})"
}

func total(anon ids: Ids) -> int64 {
    mut sum: int64 = 0
    for id in ids {
        sum = sum + id
    }
    return sum
}

func label_of(anon b: MaybeBox) -> str {
    let label: str? = b?.label
    return label? or "nothing"
}

func inc(anon x: int64) -> int64 {
    return x + 1
}

func twice(anon f: Cb, anon x: int64) -> int64 {
    return f(f(x))
}

func render(anon s: Shown) -> str {
    return s.show()
}

func main() -> int64 {
    let n: Name = "kod"
    print(greet(n))
    print(f"{n}!")

    let ids: Ids = [1, 2, 3]
    print(f"total {total(ids)} len {len(ids)} first {ids[0]}")

    let some_box: MaybeBox = Box(label: "full")
    let no_box: MaybeBox = none
    print(label_of(some_box))
    print(label_of(no_box))

    let cb: Cb = inc
    print(f"twice {twice(cb, 5)} direct {cb(1)}")

    let fwd: Fwd = Later(n: 3, s: "later")
    print(f"{fwd.s} {fwd.n}")

    print(render(Dot(c: "x")))
    let shown: Shown = Dot(c: "y")
    print(shown.show())

    let far = Far(tag: "far")
    print(far.tag)
    let dir = FarDir.Down(steps: 2)
    match dir {
        .Up -> print("up")
        .Down(steps) -> print(f"down {steps}")
    }
    return 0
}

// expected output:
// hi kod (3)
// kod!
// total 6 len 3 first 1
// full
// nothing
// twice 7 direct 2
// later 3
// dot x
// dot y
// far
// down 2
// expected status:
// 0
