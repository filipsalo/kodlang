// Array literals are boxed and wrapped for their element type, nested or appended.
interface Shape {
    func area(self) -> int64
}

type Sq = shared struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}

func total(anon shapes: [Shape]) -> int64 {
    mut t = 0
    for sh in shapes {
        t += sh.area()
    }
    return t
}

func grid_total(anon grid: [[Shape]]) -> int64 {
    mut t = 0
    for row in grid {
        t += total(row)
    }
    return t
}

test "nested literals boxed and wrapped" {
    let g: [[Shape]] = [[Sq(s: 3)]]
    assert g[0][0].area() == 9
    let o: [[int64?]] = [[1, none]]
    let row = o[0]
    assert (row[0]? or -1) == 1
    assert (row[1]? or -1) == -1
    assert total([Sq(s: 2), Sq(s: 1)]) == 5
    assert grid_total([[Sq(s: 2)], [Sq(s: 1), Sq(s: 1)]]) == 6
}

test "appended and stored literals boxed and wrapped" {
    mut shapes: [Shape] = []
    shapes += [Sq(s: 4)]
    assert total(shapes) == 16
    mut grid: [[Shape]] = []
    grid += [[Sq(s: 5)]]
    grid[0] = [Sq(s: 6)]
    assert grid_total(grid) == 36
    mut opts: [int64?] = [none]
    opts += [7]
    assert (opts[1]? or -1) == 7
}
