// Only the builtins declare the names the compiler finds their types by.
type Option = struct {
    v: int64
}

interface Map {
    func get(self) -> int64
}

type Result = enum {
    Good
    Bad
}

type Error = int64

type Stringable = struct {
    text: str
}

type ExitCode = [int64]

func main() -> int64 {
    return 0
}

// expected errors:
// 2:6: error: `Option` is the name of a builtin type; give this type another name
// 6:11: error: `Map` is the name of a builtin type; give this type another name
// 10:6: error: `Result` is the name of a builtin type; give this type another name
// 15:6: error: `Error` is the name of a builtin type; give this type another name
// 17:6: error: `Stringable` is the name of a builtin type; give this type another name
// 21:6: error: `ExitCode` is the name of a builtin type; give this type another name
