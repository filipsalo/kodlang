// A name that is a local only elsewhere, after its block or before its
// `let`, means what it would without the local: a type that only another
// module declares gets the hint to write or import it.
import "./scoped_reads_type_dep"

func after_block(anon n: int64) -> int64 {
    if n > 0 {
        let Pt = 4
        let Mode = 5
        print_int(Pt + Mode)
    }
    let a = Pt(x: 1)
    let b = Mode.On
    return 0
}

func before_let() -> int64 {
    let a = Pt(x: 1)
    let b = Mode.Off
    let Pt = 4
    let Mode = 5
    return Pt + Mode
}

func main() -> int64 {
    print_int(after_block(1))
    return before_let()
}

