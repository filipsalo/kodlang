// Pattern bindings take their kinds from the matched variant.

type Val = enum {
    I(value: int64)
    S(value: str)
}

type Other = enum {
    Named(id: int64)
}

type Item = enum {
    Named(label: str)
    Count(n: int64)
}

type Box = struct {
    id: int64
    name: str
}

func describe(anon v: Val) -> none {
    match v {
        .I(value) -> print(f"int {value}")
        .S(value) -> print(f"str {value}")
    }
}

func describe_expr(anon v: Val) -> str {
    let d: str = match v {
        .I(value) -> f"int {value}"
        .S(value) -> f"str {value}"
    }
    return d
}

func show_items(anon items: [Item]) -> none {
    for o in items {
        match o {
            .Named(label) -> print(f"named {label}")
            .Count(n) -> print(f"count {n}")
        }
    }
}

func show_boxes(anon boxes: [Box?]) -> none {
    for o in boxes {
        match o {
            Some(b) -> print(b.name)
            none -> print("empty")
        }
    }
    for o in boxes {
        let .Some(b) = o else { continue }
        print(f"let-else {b.name}")
    }
}

func main() -> int64 {
    describe(Val.I(value: 7))
    describe(Val.S(value: "seven"))
    print(describe_expr(Val.S(value: "eight")))
    show_items([Item.Named(label: "first"), Item.Count(n: 2)])
    let o: Other = Other.Named(id: 1)
    if o is .Named(id) {
        print(f"other {id}")
    }
    let full: Box? = Box(id: 1, name: "boxed")
    show_boxes([full, none])
    return 0
}

// expected output:
// int 7
// str seven
// str eight
// named first
// count 2
// other 1
// boxed
// empty
// let-else boxed
// expected status:
// 0
