// A guard that ends in a call that never returns narrows the rest of its block;
// one that ends in a call that can return leaves the name as it was.
import "./narrowing_never_dep"

type Log = struct {
    name: str
    func die(self, anon msg: str) -> none {
        panic(f"{self.name}: {msg}")
    }
}

func fail(anon msg: str) -> none {
    narrowing_never_dep.fail(msg)
}

func spin() -> none {
    for true {}
}

func note(anon msg: str) -> none {
    print(f"note: {msg}")
}

func lookup(anon n: int64) -> int64 or Error {
    return n * 2
}

func local(anon x: int64?) -> int64 {
    if x is none {
        fail("no x")
    }
    return x + 1
}

func imported(anon x: int64?) -> int64 {
    if x is none {
        narrowing_never_dep.fail("no x")
    }
    return x + 2
}

func method(anon x: int64?) -> int64 {
    let log = Log(name: "m")
    if x is none {
        log.die("no x")
    }
    return x + 3
}

func looping(anon x: int64?) -> int64 {
    if x is none {
        spin()
    }
    return x + 4
}

func result(anon n: int64) -> int64 {
    let r = lookup(n)
    if r is Err(e) {
        fail(e.to_str())
    }
    return r + 5
}

func member(anon v: int64 | str) -> int64 {
    if v is not int64 {
        fail("not an int")
    }
    return v + 6
}

// `note` returns, so both paths reach the rest, with `x` still optional.
func returns(anon x: int64?) -> int64 {
    if x is none {
        note("no x")
    }
    return x? or -1
}

func main() -> int64 {
    print(local(1))
    print(imported(1))
    print(method(1))
    print(looping(1))
    print(result(1))
    print(member(1))
    print(returns(1))
    print(returns(none))
    return 0
}

// expected output:
// 2
// 3
// 4
// 5
// 7
// 7
// 1
// note: no x
// -1
