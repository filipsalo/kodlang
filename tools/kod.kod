// Native `kod` driver: `kod build|run|test|check`.
// The only build orchestrator: `uv run kod` (kod/__main__.py) refreshes
// the toolchain and hands off to it, so a normal user build doesn't
// have to go through the Python entry point.
//
// The Python `kod` stays as the interpreter and as the
// bootstrap path — the very first sh_kodc on a fresh clone is
// always built via `python -m kod _interpret`.
//
// Pipeline:
//   1. Parse the entry, walk its imports transitively.
//   2. `sh_kodc _compile` each module to a .o.
//   3. `sh_kodc _emit-runtime-main` for the entry; `as` it to a .o.
//   4. Link everything together with the prebuilt stage0 .o set, with the
//      `LINK` command of link.cfg (`clang`).
//
// link.cfg (and link.local.cfg, which overrides single names on one
// machine) is read from the working directory: the Makefile includes the same
// file, so the compiler and every program are linked the same way. It also
// names the always-linked C files and Kod modules.
//
// `run` and `test` end by replacing this process with the program
// (`become`), so it has the terminal, its output streams as it is
// written and its exit status is what the shell sees. Nothing can run
// after it, so there is no driver epilogue and nothing to clean up.
//
// Assumes stage0 has been built (`make stage0`) and `build/stage1/sh_kodc`
// exists. Both are true after a normal `make stage1`. No incremental
// build today — every invocation does the full compile + link.
import "io"
import "process"
import "kod/parsing"
import "kod/ast"
import "kod/build"

func main(argv: [str]) -> int64 {
    if len(argv) < 3 {
        return usage()
    }
    let cmd: str = argv[1]
    if cmd != "build" and cmd != "run" and cmd != "test" and cmd != "check" {
        return usage()
    }
    if require_repo_root() != 0 {
        return 1
    }
    let cfg: build.LinkVars = build.LinkVars(items: [])
    if read_link_config(into: cfg) == false {
        return 1
    }
    if cmd != "check" and require_stage0_objects(cfg) != 0 {
        return 1
    }
    if cmd == "build" {
        let exe: str = build_executable(argv[2], :cfg)
        if len(exe) == 0 {
            return 1
        }
        return 0
    }
    if cmd == "run" {
        let exe: str = build_executable(argv[2], :cfg)
        if len(exe) == 0 {
            return 1
        }
        mut child_argv: [str] = [exe]
        for arg in argv[3..len(argv)] {
            child_argv += [arg]
        }
        return become(child_argv)
    }
    if cmd == "test" {
        return run_test(argv[2], :cfg)
    }
    return run_check_cmd(argv[2], stage0: stage0_modules(cfg))
}

// The commands read `link.cfg` and run `build/stage1/sh_kodc`, both relative
// to the working directory: say so, rather than fail later with a tool that
// could not be run. Returns 0 in the repository root of a built tree.
func require_repo_root() -> int64 {
    if io.is_file("link.cfg") == false {
        kod_eprint("kod: link.cfg not found; run kod from the repository root")
        return 1
    }
    if io.is_file("build/stage1/sh_kodc") == false {
        kod_eprint("kod: build/stage1/sh_kodc not found; run make")
        return 1
    }
    return 0
}

// Read `link.cfg`, then `link.local.cfg` if there is one (it overrides single
// names), into `into`. Prints the first error and returns false. The names
// every build needs must be set.
func read_link_config(into: build.LinkVars) -> bool {
    for path in ["link.cfg", "link.local.cfg"] {
        if io.is_file(path) {
            let text: str = io.read_file(path)
            // read_file gives "" for a file it cannot read, which for
            // link.cfg is no configuration at all.
            if len(text) == 0 and path == "link.cfg" {
                kod_eprint("kod: link.cfg is empty or cannot be read")
                return false
            }
            let error: str = build.parse_link_config(text, :path, :into, overrides: path == "link.local.cfg")
            if len(error) > 0 {
                kod_eprint(error)
                return false
            }
        }
    }
    for name in ["LINK", "RUNTIME_C", "STAGE0_KOD"] {
        if len(build.split_words(build.link_value(into, :name))) == 0 {
            kod_eprint(f"kod: link.cfg and link.local.cfg set no {name}")
            return false
        }
    }
    return true
}

// `make` builds the always-linked objects, not the driver. Say so when the
// configuration names one that is not there (a module added to it since the
// last `make`), rather than let the link fail on it. Returns 0 when all are.
func require_stage0_objects(anon cfg: build.LinkVars) -> int64 {
    for o in stage0_objects(cfg) {
        if io.is_file(o) == false {
            kod_eprint(f"kod: {o} not found; run make")
            return 1
        }
    }
    return 0
}

// The always-linked Kod modules (`STAGE0_KOD`), in link order. Each has a
// prebuilt `build/stage0/_<basename>.o`.
func stage0_modules(anon cfg: build.LinkVars) -> [str] {
    return build.split_words(build.link_value(cfg, name: "STAGE0_KOD"))
}

// Replace this process with `argv` (a path with a `/`, so no PATH search): the
// program is given our terminal, stdin, stdout and stderr, and its exit status
// or signal becomes the one the caller sees. Returns only if it can't be
// executed (127, as a shell says).
func become(anon argv: [str]) -> int64 {
    process.exec(argv)
    kod_eprint(f"kod: cannot execute {argv[0]}")
    return 127
}

func usage() -> int64 {
    kod_eprint("usage: kod build <file>")
    kod_eprint("       kod run <file> [args...]")
    kod_eprint("       kod test <file-or-dir>")
    kod_eprint("       kod check <file>")
    return 1
}

// Compile the entry and every transitive user import through sh_kodc,
// counting failures. No artifacts emitted — sh_kodc's asm goes to
// captured stdout and is discarded; stderr (the diagnostic) is
// forwarded so the user sees the error. Exits 1 if any module
// failed, 0 otherwise. The pre-built stage0 modules are skipped
// (they were already typechecked when their .o was built).
func run_check_cmd(anon entry_path: str, stage0: [str]) -> int64 {
    let modules: [str] = collect_user_modules(entry_path, :stage0)
    let sh_kodc: str = "build/stage1/sh_kodc"
    mut errors: int64 = 0
    mut shown: [str] = []
    for m in modules {
        let r: process.ProcessResult = process.run([sh_kodc, m])
        if r.status != 0 {
            // A failing importer's compile also shows its imports' errors.
            mut repeat = false
            for line in split_lines(r.stderr) {
                if line.contains(": error: ") {
                    repeat = str_listed(shown, line)
                    shown += [line]
                }
                if repeat == false {
                    io.write_stderr(f"{line}\n")
                }
            }
            errors = errors + 1
        }
    }
    if errors > 0 {
        return 1
    }
    return 0
}

func str_listed(anon xs: [str], anon x: str) -> bool {
    for s in xs {
        if s == x {
            return true
        }
    }
    return false
}

func ends_with(anon s: str, suffix: str) -> bool {
    let n: int64 = len(s)
    let m: int64 = len(suffix)
    if m > n {
        return false
    }
    return s[n-m..n] == suffix
}

// The non-empty pieces of `s` between the bytes `sep`.
func split_at(anon s: str, sep: int64) -> [str] {
    mut result: [str] = []
    mut start: int64 = 0
    mut i: int64 = 0
    for i < len(s) {
        if s[i] == sep {
            if i > start {
                result += [s[start..i]]
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < len(s) {
        result += [s[start..len(s)]]
    }
    return result
}

func split_lines(anon s: str) -> [str] {
    return split_at(s, sep: '\n')
}

// `kod test <path>` — a `.kod` file is built as a single-module
// test executable; anything else is treated as a directory and
// walked recursively for `*_test.kod` files, which are built into one
// program. Either way the test binary then takes this process's place.
// The walk uses `find` to avoid a new io extern; results
// aren't sorted, since the test runner's `__run_tests` dispatchers
// don't care about order.
func run_test(anon path: str, cfg: build.LinkVars) -> int64 {
    if ends_with(path, suffix: ".kod") {
        return run_single_test(path, :cfg)
    }
    return run_dir_tests(path, :cfg)
}

func run_single_test(anon entry: str, cfg: build.LinkVars) -> int64 {
    let exe: str = build_test_executable(entry, :cfg)
    if len(exe) == 0 {
        return 1
    }
    return become([exe])
}

// The part of `path` below `dir`, as `find <dir>` printed it (`dir` itself
// first, then a `/`).
func below_dir(anon path: str, dir: str) -> str {
    if build.starts_with(path, prefix: dir) == false {
        return path
    }
    mut start: int64 = len(dir)
    for start < len(path) and path[start] == '/' {
        start = start + 1
    }
    return path[start..len(path)]
}

// Is a test file left out of `kod test <dir>`? One with a path component
// below `dir` that starts with `.` (worktrees under `.claude/`, editor
// files, scratch files such as `.kod_compile_test.kod`), or below a `build`
// directory directly in `dir`. (The tests' own finder skips the
// directories among these, not the files.)
func is_skipped_test_file(anon rel: str) -> bool {
    mut start: int64 = 0
    mut i: int64 = 0
    for i <= len(rel) {
        if i == len(rel) or rel[i] == '/' {
            if i > start and rel[start] == '.' {
                return true
            }
            if start == 0 and i < len(rel) and rel[0..i] == "build" {
                return true
            }
            start = i + 1
        }
        i = i + 1
    }
    return false
}

// The name of the program `kod test <dir>` builds: the directory with
// every byte outside letters, digits, `_` and `-` replaced by `_` (its
// last 200 bytes, so that the names derived from it fit a file name),
// then `_tests`.
func tests_stem(anon dir: str) -> str {
    mut stem: str = ""
    mut i: int64 = 0
    for i < len(dir) {
        let c: int64 = dir[i]
        if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '-' {
            stem = stem + dir[i..i+1]
        } else {
            stem = stem + "_"
        }
        i = i + 1
    }
    if len(stem) > 200 {
        stem = stem[len(stem)-200..len(stem)]
    }
    return stem + "_tests"
}

func run_dir_tests(anon dir: str, cfg: build.LinkVars) -> int64 {
    // `find` takes an argument that starts with `-` for an option. Its paths
    // end at a NUL byte, not at a newline, which a file name can hold.
    mut root: str = dir
    if len(dir) > 0 and dir[0] == '-' {
        root = f"./{dir}"
    }
    let r: process.ProcessResult = process.run(["find", root, "!", "-type", "d", "-name", "*_test.kod", "-print0"])
    if r.status != 0 {
        io.write_stderr(r.stderr)
        return r.status
    }
    // `find` doesn't prune, so the paths to leave out are dropped here. A
    // directory named like a test file is not listed. Any other path that is
    // not a readable file (a dangling link) stops the run: a test that is
    // skipped without a word reads as one that passed.
    mut test_files: [str] = []
    for tf in split_at(r.stdout, sep: 0) {
        if is_skipped_test_file(below_dir(tf, dir: root)) == false {
            if io.is_file(tf) == false {
                kod_eprint(f"kod test: cannot read {tf}")
                return 1
            }
            test_files += [build.normalize_path(tf)]
        }
    }
    if len(test_files) == 0 {
        kod_eprint(f"kod test: no `*_test.kod` files under {dir}")
        return 1
    }
    // One program for all of them, so no temporary module is needed.
    let stem: str = tests_stem(dir)
    let exe: str = build_program(entries: test_files, app: stem, exe_name: f"{stem}_test", emit_main_cmd: "_emit-test-runtime-main", shim_kind: "testmain", :cfg)
    if len(exe) == 0 {
        return 1
    }
    return become([exe])
}

// Walk the entry's import graph and return the full list of .kod
// files that need their own .o, in load order. The entry is the
// first element; the always-linked modules `stage0` (builtins, the
// primitives, io, process, time, ...) are *not* included — those already
// have prebuilt .o files under build/stage0/ and are added at link time.
func collect_user_modules(anon entry_path: str, stage0: [str]) -> [str] {
    mut result: [str] = [build.normalize_path(entry_path)]
    let p: parsing.Parser = build.parse_file(entry_path)
    let module: ast.Module = p.parse_module()
    walk_imports(module: module, importer_path: entry_path, :stage0, modules: result)
    return result
}

func walk_imports(module: ast.Module, importer_path: str, stage0: [str], mut modules: [str]) -> none {
    for d in module.decls {
        match d {
            ast.Decl.Import(module_name, _local_name, _items) -> {
                if len(module_name) > 0 {
                    let resolved: build.Resolved = build.resolve_import(target_path: importer_path, :module_name)
                    // A missing file is reported by its importer's compile.
                    if is_stage0(resolved.file, :stage0) == false and io.is_file(resolved.file) {
                        mut already: bool = false
                        for m in modules {
                            if m == resolved.file {
                                already = true
                            }
                        }
                        if already == false {
                            modules += [resolved.file]
                            let p: parsing.Parser = build.parse_file(resolved.file)
                            let im: ast.Module = p.parse_module()
                            walk_imports(module: im, importer_path: resolved.file, :stage0, :modules)
                        }
                    }
                }
            }
            else none
        }
    }
}

func is_stage0(anon path: str, stage0: [str]) -> bool {
    for s in stage0 {
        if s == path {
            return true
        }
    }
    return false
}

// Strip directory + `.kod` extension. `tests/hello.kod` → `hello`,
// `stdlib/primitives/int64.kod` → `int64`. Names the per-app output
// directory under `build/apps/<basename>/` and its executable; the
// stage0 objects `build/stage0/_<basename>.o` are named the same way.
func basename_no_ext(anon path: str) -> str {
    return basename_without(path, ext: ".kod")
}

// Strip directory + the extension `ext`, if the name has it.
func basename_without(anon path: str, ext: str) -> str {
    mut last_slash: int64 = -1
    mut i: int64 = 0
    for i < len(path) {
        if path[i] == '/' {
            last_slash = i
        }
        i = i + 1
    }
    let after_slash: int64 = last_slash + 1
    mut end: int64 = len(path)
    // Strip the suffix if present.
    if end - after_slash >= len(ext) and path[end-len(ext)..end] == ext {
        end = end - len(ext)
    }
    return path[after_slash..end]
}

// Run a process, forwarding its stderr to ours when it fails so the
// user sees the underlying tool's diagnostic. Returns the exit
// status (0 on success).
func run_check(anon argv: [str]) -> int64 {
    let r: process.ProcessResult = process.run(argv)
    if r.status != 0 {
        io.write_stderr(r.stderr)
    }
    if r.status == -1 {
        // It never ran, or was killed: it has said nothing.
        kod_eprint(f"kod: {argv[0]} could not be run (not found, killed, or its argument list too long)")
    }
    return r.status
}

// Build an executable from `entries` and everything they import. `app`
// names the directory `build/apps/<app>/` that holds it and its objects,
// `exe_name` is the file dropped into it; `emit_main_cmd` is the
// sh_kodc subcommand that emits the runtime_main shim asm, and
// `shim_kind` (`main` or `testmain`) names the shim's files. Two
// callers: `build_executable` uses `_emit-runtime-main` (plain main
// shim, one entry), `build_test_executable` and `run_dir_tests` use
// `_emit-test-runtime-main` (the dispatcher that calls every module's
// `__run_tests` then prints the aggregate summary). The objects go to
// `build/apps/<app>/<app>.obj/`, in a tree that mirrors the source
// tree. `cfg` is the link configuration. Returns the executable path on
// success, "" on failure (the underlying tool already printed via
// `run_check`).
func build_program(entries: [str], app: str, exe_name: str, emit_main_cmd: str, shim_kind: str, cfg: build.LinkVars) -> str {
    if app == "" or app == "." or app == ".." {
        kod_eprint(f"kod: cannot name a program after {entries[0]}; rename the file")
        return ""
    }
    let app_dir: str = f"build/apps/{app}"
    let obj_root: str = f"{app_dir}/{app}.obj"
    let exe_path: str = f"{app_dir}/{exe_name}"
    let sh_kodc: str = "build/stage1/sh_kodc"

    // 1. User modules: the entries + transitive imports (skipping
    //    stage0), each to the object named after its source path.
    let stage0: [str] = stage0_modules(cfg)
    mut user_modules: [str] = []
    for entry in entries {
        for m in collect_user_modules(entry, :stage0) {
            if str_listed(user_modules, m) == false {
                user_modules += [m]
            }
        }
    }
    mut obj_dirs: [str] = [obj_root]
    for m in user_modules {
        let dir: str = build.dirname(build.obj_path(root: obj_root, source: m))
        let bare_dir: str = dir[0..len(dir)-1]
        if str_listed(obj_dirs, bare_dir) == false {
            obj_dirs += [bare_dir]
        }
    }
    mut mkdir_argv: [str] = ["mkdir", "-p"]
    for d in obj_dirs {
        mkdir_argv += [d]
    }
    if run_check(mkdir_argv) != 0 {
        return ""
    }
    mut user_objs: [str] = []
    for m in user_modules {
        let obj: str = build.obj_path(root: obj_root, source: m)
        let rc: int64 = run_check([sh_kodc, "_compile", m, obj])
        if rc != 0 {
            return ""
        }
        user_objs += [obj]
    }

    // 2. Runtime main shim — variant selected by `emit_main_cmd`, next
    //    to the first entry's object.
    let entry_obj: str = user_objs[0]
    let shim_base: str = entry_obj[0..len(entry_obj)-2]
    let main_s: str = f"{shim_base}.{shim_kind}.s"
    let main_o: str = f"{shim_base}.{shim_kind}.o"
    mut shim_argv: [str] = [sh_kodc, emit_main_cmd, entries[0], main_s]
    for more in entries[1..len(entries)] {
        shim_argv += [more]
    }
    let rc_main: int64 = run_check(shim_argv)
    if rc_main != 0 {
        return ""
    }
    let rc_as: int64 = run_check(["as", "-target", "arm64-apple-darwin", "-o", main_o, main_s])
    if rc_as != 0 {
        return ""
    }

    // 3. Link: the program's objects and its shim, after the always-linked
    //    set that `make stage0` keeps fresh.
    mut inputs: [str] = []
    for o in user_objs {
        inputs += [o]
    }
    inputs += [main_o]
    let rc_link: int64 = run_check(link_argv(cfg, :exe_path, objs: inputs))
    if rc_link != 0 {
        return ""
    }
    return exe_path
}

// The objects every program links first, in link order: one per `RUNTIME_C`
// file (`build/stage0/<name>.o`) and one per `STAGE0_KOD` module
// (`build/stage0/_<basename>.o`), named as the Makefile names them. We don't
// try to rebuild them here; `make stage0` does.
func stage0_objects(anon cfg: build.LinkVars) -> [str] {
    mut objs: [str] = []
    for c in build.split_words(build.link_value(cfg, name: "RUNTIME_C")) {
        let name: str = basename_without(c, ext: ".c")
        objs += [f"build/stage0/{name}.o"]
    }
    for m in stage0_modules(cfg) {
        let name: str = basename_no_ext(m)
        objs += [f"build/stage0/_{name}.o"]
    }
    return objs
}

// The command that links `exe_path`: the `LINK` words, `-o exe_path`, the
// always-linked objects, then `objs`, the program's own in link order.
func link_argv(anon cfg: build.LinkVars, exe_path: str, objs: [str]) -> [str] {
    mut argv: [str] = []
    for w in build.split_words(build.link_value(cfg, name: "LINK")) {
        argv += [w]
    }
    argv += ["-o", exe_path]
    for o in stage0_objects(cfg) {
        argv += [o]
    }
    for o in objs {
        argv += [o]
    }
    return argv
}

// Are `a` and `b` one file or directory, whatever they are spelled like?
// (An absolute path, a link, another case on a volume that ignores case.)
func same_file(anon a: str, anon b: str) -> bool {
    let r: process.ProcessResult = process.run(["test", a, "-ef", b])
    return r.status == 0
}

// Would a program in `build/apps/<app>/` be written over the tool `tool`
// (`build/apps/kod/kod`, `build/apps/lsp/lsp`)? `make` would go on calling
// the tool up to date. It would if `app` is its name, or another name for
// its directory.
func names_tool(app: str, tool: str) -> bool {
    return app == tool or same_file(f"build/apps/{app}", f"build/apps/{tool}")
}

// An entry that would write its executable over the tool `kod` or `lsp` is
// refused. Only the tools' own sources, in any spelling, may do that.
func refuse_tool_names(app: str, entry: str) -> bool {
    if names_tool(:app, tool: "kod") and same_file(entry, "tools/kod.kod") == false {
        kod_eprint(f"kod: an entry named {app} would replace the build tool")
        return true
    }
    if names_tool(:app, tool: "lsp") and same_file(entry, "tools/lsp.kod") == false {
        kod_eprint(f"kod: an entry named {app} would replace the language server")
        return true
    }
    return false
}

func build_executable(anon entry_path: str, cfg: build.LinkVars) -> str {
    let stem: str = basename_no_ext(entry_path)
    if refuse_tool_names(app: stem, entry: entry_path) {
        return ""
    }
    return build_program(entries: [entry_path], app: stem, exe_name: stem, emit_main_cmd: "_emit-runtime-main", shim_kind: "main", :cfg)
}

func build_test_executable(anon entry_path: str, cfg: build.LinkVars) -> str {
    let stem: str = basename_no_ext(entry_path)
    return build_program(entries: [entry_path], app: stem, exe_name: f"{stem}_test", emit_main_cmd: "_emit-test-runtime-main", shim_kind: "testmain", :cfg)
}
