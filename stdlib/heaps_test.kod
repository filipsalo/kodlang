import "heaps" { Heap }
import "sort"

type Job = struct {
    priority: int64
    name: str

    // Higher priority first.
    func op_lt(self, anon other: Job) -> bool {
        return self.priority > other.priority
    }
}

func drain(mut h: Heap[int64]) -> [int64] {
    mut out: [int64] = []
    for h.pop() is int64(x) {
        out += [x]
    }
    return out
}

test "pop gives the smallest first" {
    mut h = Heap[int64]()
    assert h.pop() is none
    assert h.peek() is none
    assert h.is_empty()
    let xs = [5, 3, 8, 1, 9, 2, 7, 3, 0, -4]
    for x in xs {
        h.push(x)
    }
    assert len(h) == 10
    assert h.peek() == -4
    assert drain(h: mut h) == sort.sorted(xs)
    assert h.is_empty()
}

test "many elements come out in order" {
    mut h = Heap[int64]()
    mut x = 7
    for _ in 0..2000 {
        x = (x * 1103515245 + 12345) % 2147483648
        h.push(x % 1000)
    }
    let out = drain(h: mut h)
    assert len(out) == 2000
    assert out == sort.sorted(out)
}

test "tuples, strs and an op_lt" {
    mut pairs = Heap[(int64, str)]()
    pairs.push((3, "c"))
    pairs.push((1, "z"))
    pairs.push((1, "a"))
    assert pairs.pop() == (1, "a")
    assert pairs.pop() == (1, "z")
    mut words = Heap[str]()
    for w in ["pear", "apple", "fig"] {
        words.push(w)
    }
    assert words.pop() == "apple"
    mut jobs = Heap[Job]()
    jobs.push(Job(priority: 1, name: "low"))
    jobs.push(Job(priority: 9, name: "high"))
    assert (jobs.pop()? or Job(priority: 0, name: "")).name == "high"
}

test "a heap is a value" {
    mut h = Heap[int64]()
    h.push(2)
    h.push(1)
    let saved = h
    assert h.pop() == 1
    assert len(saved) == 2
    assert sort.sorted(saved.values()) == [1, 2]
}
