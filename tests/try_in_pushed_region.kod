// `try` can return from the middle of an expression that has values pushed
// on the stack: an array literal, call arguments or slice bounds.
type ParseError = struct {
    text: str
    func to_str(self) -> str { return f"bad {self.text}" }
}

type Box = struct {
    v: int64
}

func parse(anon s: str) -> int64 or Error {
    if s == "1" { return 1 }
    if s == "2" { return 2 }
    if s == "3" { return 3 }
    throw ParseError(text: s)
}

func collect(anon xs: [str]) -> [int64] or Error {
    mut out: [int64] = []
    for x in xs {
        out += [try parse(x)]
    }
    return out
}

func triple(anon xs: [str]) -> [int64] or Error {
    return [len(xs), try parse(xs[0]), try parse(xs[1])]
}

func nested(anon xs: [str]) -> [[int64]] or Error {
    return [[7], [8, try parse(xs[0])], [try parse(xs[1])]]
}

func boxes(anon xs: [str]) -> [Box] or Error {
    let bs = [Box(v: 10), Box(v: try parse(xs[0])), Box(v: try parse(xs[1]))]
    return bs
}

func add3(anon a: int64, anon b: int64, anon c: int64) -> int64 {
    return a + b + c
}

func summed(anon xs: [str]) -> int64 or Error {
    return add3(100, try parse(xs[0]), add3(10, try parse(xs[1]), 1000))
}

func window(anon xs: [int64], from: str, to: str) -> [int64] or Error {
    return xs[try parse(from)..try parse(to)]
}

func ints(anon xs: [int64]) -> str {
    mut s = ""
    for x in xs {
        s = f"{s} {x}"
    }
    return s
}

func show(anon label: str, anon r: [int64] or Error) -> none {
    match r {
        Ok(xs) -> print(f"{label}:{ints(xs)}")
        Err(e) -> print(f"{label}: {e.to_str()}")
    }
}

func main() -> int64 {
    show("collect", collect(["1", "2", "3"]))
    show("collect", collect(["1", "x", "3"]))
    show("triple", triple(["2", "3"]))
    show("triple", triple(["2", "y"]))
    match nested(["1", "z"]) {
        Ok(xss) -> print(f"nested {len(xss)}")
        Err(e) -> print(f"nested: {e.to_str()}")
    }
    match nested(["1", "2"]) {
        Ok(xss) -> print(f"nested{ints(xss[1])}")
        Err(e) -> print(f"nested: {e.to_str()}")
    }
    match boxes(["q", "1"]) {
        Ok(bs) -> print(f"boxes {len(bs)}")
        Err(e) -> print(f"boxes: {e.to_str()}")
    }
    match boxes(["3", "2"]) {
        Ok(bs) -> print(f"boxes {bs[0].v} {bs[1].v} {bs[2].v}")
        Err(e) -> print(f"boxes: {e.to_str()}")
    }
    match summed(["1", "w"]) {
        Ok(n) -> print(f"summed {n}")
        Err(e) -> print(f"summed: {e.to_str()}")
    }
    match summed(["1", "2"]) {
        Ok(n) -> print(f"summed {n}")
        Err(e) -> print(f"summed: {e.to_str()}")
    }
    let xs = [10, 20, 30, 40]
    show("window", window(xs, from: "1", to: "3"))
    show("window", window(xs, from: "1", to: "v"))
    show("window", window(xs, from: "u", to: "3"))
    return 0
}

// expected output:
// collect: 1 2 3
// collect: bad x
// triple: 2 2 3
// triple: bad y
// nested: bad z
// nested 8 1
// boxes: bad q
// boxes 10 3 2
// summed: bad w
// summed 1113
// window: 20 30
// window: bad v
// window: bad u
