// `len(x)` on a struct calls its `len` method: a Map's entry count, or a
// user type's own count.

type Shelf = shared struct {
    books: [str]

    func len(self) -> int64 {
        return len(self.books) * 10
    }
}

test "len calls a struct's len method" {
    mut m = Map[str, int64]()
    assert len(m) == 0
    m.set("a", 1)
    m.set("b", 2)
    m["a"] = 3
    assert len(m) == 2
    assert len(Shelf(books: ["x", "y", "z"])) == 30
}
