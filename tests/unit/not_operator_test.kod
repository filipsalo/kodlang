// `not` negates a bool: looser than comparisons and `is`, tighter than `and` and `or`.

type Color = enum {
    Red
    Blue
}

func yes() -> bool {
    return true
}

test "not in expressions" {
    let a = true
    let b = false
    let c: Color = .Red
    assert f"{not a}" == "false"
    assert f"{not b and a}" == "true"
    assert f"{not a or a}" == "true"
    assert f"{not 1 == 2}" == "true"
    assert f"{not 1 < 2 < 3}" == "false"
    assert f"{not c is .Blue}" == "true"
    assert f"{not (a and b)}" == "true"
    assert f"{not not a}" == "true"
    assert f"{not yes()}" == "false"
    assert f"{a == not b}" == "true"
    let ok = not c is .Red
    assert f"{ok}" == "false"
}

test "not in conditions" {
    let a = true
    let b = false
    let o: int64? = 3
    mut branch = ""
    if not a {
        branch = "bad"
    } else if not b {
        branch = "else if"
    }
    assert branch == "else if"
    mut chain = ""
    if not b and o is Some(v) and not v == 4 {
        chain = f"chain {v}"
    }
    assert chain == "chain 3"
    mut i = 0
    for not i == 2 {
        i += 1
    }
    assert i == 2
}
