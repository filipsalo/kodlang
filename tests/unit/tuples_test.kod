// Tuples (docs/tuples.md).
import "sets" { Set }
import "sort"
import "tasks"

func divide(anon a: int64, by b: int64) -> (int64, int64) {
    return (a / b, a % b)
}

func swapped[A, B](anon p: (A, B)) -> (B, A) {
    return (p.1, p.0)
}

test "literals, elements and text" {
    let p = (3, "three")
    assert p.0 == 3 and p.1 == "three"
    assert f"{p}" == "(3, three)" and str((1, (2, [true]))) == "(1, (2, [true]))"
    let nested = ((1, 2), (3, (4, 5)))
    assert nested.0.1 == 2 and nested.1.1.0 == 4 and nested.1.1.1 == 5
    let wide = (1, "b", 3.5, true, [1], none_of(4), (6, 7), b"h")
    assert wide.6.1 == 7 and wide.2 == 3.5 and wide.7 == b"h" and wide.4 == [1]
    assert (-3, 4).0.abs() == 3 and (1, [5, 6]).1[1] == 6
    assert (1 + 2, 3 * 4) == (3, 12)
    let lines = [
        (
            1,
            "a",
        ),
        (2, "b"),
    ]
    assert lines == [(1, "a"), (2, "b")]
    // Parentheses around one value are just that.
    assert (7) == 7 and (1 + 2) * 3 == 9
}

func none_of(anon n: int64) -> int64? {
    return none
}

test "a tuple is a value" {
    mut t = (1, [2])
    let before = t
    t.0 += 1
    t.1 += [3]
    assert t == (2, [2, 3]) and before == (1, [2])
    mut grid = [[(0, 0)] * 2] * 2
    grid[1][0].1 = 7
    assert grid == [[(0, 0), (0, 0)], [(0, 7), (0, 0)]]
}

type Holder = shared struct {
    pos: (int64, str)
    all: [(int64, str)]
}

test "elements of tuples in fields, arrays and maps" {
    let h = Holder(pos: (1, "a"), all: [(1, "x"), (2, "y")])
    h.pos.0 += 4
    h.pos.1 += "b"
    h.all[1].0 *= 10
    h.all[0] = (9, "n")
    assert h.pos == (5, "ab") and h.all == [(9, "n"), (20, "y")]
    mut m = Map[str, (int64, int64)]()
    m["a", default: (0, 0)].0 += 5
    m["a", default: (0, 0)].1 -= 1
    assert must m["a"] == (5, -1)
    let o: (int64, str)? = (4, "q")
    assert (o?.1? or "-") == "q"
}

test "taking apart with let and mut" {
    let (n, word) = (3, "three")
    assert n == 3 and word == "three"
    let (q, r) = divide(17, by: 5)
    assert q == 3 and r == 2
    let ((a, b), c) = ((1, 2), "x")
    assert a == 1 and b == 2 and c == "x"
    let (_, (third, (_, fifth))) = ((1, 2), (3, (4, 5)))
    assert third == 3 and fifth == 5
    mut (x, y) = (0, 1)
    x += 5
    assert x == 5 and y == 1
    let (_, last) = if n == 3 { (1, "L") } else { (2, "M") }
    assert last == "L"
    let (d, e): (int64?, int64 | str) = (none, "let")
    assert d is none and e == "let"
}

test "a name bound again means the one outside" {
    let (a, b) = (1, 2)
    if a == 1 {
        let (b, a) = (a, b)
        assert a == 2 and b == 1
        let (a, text) = (a + 1, f"{a}")
        assert a == 3 and text == "2"
    }
    assert a == 1 and b == 2
}

test "assigning, and swapping" {
    mut a = 1
    mut b = 2
    (a, b) = (b, a)
    assert a == 2 and b == 1
    mut xs = [5, 6, 7]
    (xs[0], xs[2]) = (xs[2], xs[0])
    assert xs == [7, 6, 5]
    mut (c, d, e) = (1, 2, 3)
    (c, d, e) = (e, c, d)
    assert c == 3 and d == 1 and e == 2
    (a, b) = divide(9, by: 4)
    assert a == 2 and b == 1
    (_, a) = (5, 6)
    assert a == 6
    ((a, b), c) = ((7, 8), 9)
    assert a == 7 and b == 8 and c == 9
    let h = Holder(pos: (1, "a"), all: [])
    mut o: int64? = 3
    mut list = [1]
    (h.pos, o, list) = ((2, "b"), none, [])
    assert h.pos == (2, "b") and o is none and len(list) == 0
    match a {
        7 -> (a, b) = (b, a)
        else -> none
    }
    assert a == 8 and b == 7
}

test "in for loops" {
    mut out = ""
    for (n, w) in [(1, "one"), (2, "two")] {
        out += f"{n}{w} "
    }
    for i, (n, w) in [(1, "one"), (2, "two")] {
        if i == 1 {
            continue
        }
        out += f"{i}{n}{w} "
    }
    mut m = Map[(int64, int64), (str, bool)]()
    m[(0, 1)] = ("a", true)
    m[(2, 1)] = ("b", false)
    for (x, y), (name, _) in m {
        out += f"{x}{y}{name} "
    }
    for (x, y) in m {
        out += f"{x + y}"
    }
    for ((a, b), c) in [((1, 2), 3)] {
        out += f" {a}{b}{c}"
    }
    assert out == "1one 2two 01one 01a 21b 13 123"
    // A condition in parentheses is still one.
    mut k = 0
    for (k < 3) {
        k += 1
    }
    assert k == 3
}

func where_is(anon p: (int64, int64)) -> str {
    match p {
        (0, 0) -> return "origin"
        (x, 0) -> return f"x {x}"
        (0, _) -> return "y"
        (x, y) if x == y -> return "diagonal"
        (_, _) -> return "elsewhere"
    }
}

type Shape = enum {
    Rect(size: (int64, int64))
    Dot
}

test "patterns" {
    assert where_is((0, 0)) == "origin" and where_is((4, 0)) == "x 4" and where_is((0, 2)) == "y"
    assert where_is((2, 2)) == "diagonal" and where_is((1, 2)) == "elsewhere"
    let o: (int64, str)? = (1, "a")
    if o is Some((n, _)) {
        assert n == 1
    } else {
        assert false
    }
    let p = (3, ("three", true))
    mut fits = 0
    if p is (3, (_, true)) {
        fits += 1
    }
    if p is (4, _) {
        fits += 10
    }
    if p is (_, ("three", false)) {
        fits += 100
    }
    assert fits == 1
    if p is (n, (word, _)) and n > 2 {
        assert word == "three"
    } else {
        assert false
    }
    let s: Shape = .Rect(size: (2, 5))
    let area = match s {
        .Rect((w, h)) if w < h -> w * h
        .Rect((w, _)) -> w
        .Dot -> 0
    }
    assert area == 10
    let r: (int64, int64) or Error = divide(7, by: 2)
    let sum = match r {
        Ok((a, b)) -> a + b
        Err(_) -> -1
    }
    assert sum == 4
    let pair = (1, o)
    match pair {
        (1, Some((_, t))) -> assert t == "a"
        else -> assert false
    }
}

test "comparing, ordering and hashing" {
    assert (1, "a") == (1, "a") and (1, "a") != (1, "b") and (1, "a") != (2, "a")
    assert (1, 9) < (2, 0) and (2, "a") < (2, "b") and not ((2, "b") < (2, "a")) and not ((1, 1) < (1, 1))
    assert (2, 0) > (1, 9) and (1, 1) >= (1, 1) and (1, 1) <= (1, 1) and not ((2, 2) <= (2, 1))
    assert ((1, 2), "z") < ((1, 3), "a") and (1.5, b"a", "x") < (1.5, b"b", "a")
    assert sort.sorted([(2, "b"), (1, "z"), (2, "a")]) == [(1, "z"), (2, "a"), (2, "b")]
    assert min((1, 2), (0, 5)) == (0, 5) and max((1, "a"), (1, "b")).1 == "b"
    let mixed: (int64?, int64 | str) = (none, 1)
    assert mixed == (none, 1) and mixed != (1, 1) and (none, 1) == mixed and mixed != (none, "1")
    mut s = Set[(int64, int64)]()
    for x in 0..20 {
        for y in 0..20 {
            s.add((x, y))
            s.add((x, y))
        }
    }
    assert len(s) == 400 and s.contains((19, 0)) and not s.contains((0, 20))
    assert hash((1, 2)) == hash((1, 2)) and hash((1, 2)) != hash((2, 1))
}

type Wide = (int64?, int64 | str)

type Fields = struct {
    w: (int64?, int64 | str)
    d: (int64?, int64 | str) = (none, "default")
}

type Payload = enum {
    A(w: (int64?, int64 | str))
    B
}

interface Shower {
    func show(self, anon w: (int64?, int64 | str)) -> str
}

type Show = struct {
    func show(self, anon w: (int64?, int64 | str)) -> str {
        return text(w)
    }
}

func text(anon w: (int64?, int64 | str)) -> str {
    return f"[{w.0? or -1} {w.1}]"
}

func labelled(at w: (int64?, int64 | str) = (5, "p")) -> str {
    return text(w)
}

func returned(anon n: int64) -> (int64?, int64 | str) {
    if n == 0 {
        return (none, 1)
    }
    if n == 1 {
        return if n == 1 { (4, "if") } else { (none, 2) }
    }
    return match n {
        2 -> (none, "m")
        else -> (n, 3)
    }
}

func result(anon n: int64) -> (int64?, int64 | str) or Error {
    if n == 0 {
        return (none, 1)
    }
    return (n, "r")
}

func optional(anon n: int64) -> (int64?, int64 | str)? {
    if n == 0 {
        return (none, 1)
    }
    return none
}

func appended[T](anon a: T, anon xs: [T]) -> [T] {
    return xs + [a]
}

mut state: (int64?, int64 | str) = (none, "module")

test "a literal's elements convert, wherever it goes" {
    assert text((none, 1)) + text((3, "x")) == "[-1 1][3 x]"
    assert labelled() + labelled(at: (none, "y")) == "[5 p][-1 y]"
    assert text(returned(0)) + text(returned(1)) + text(returned(2)) + text(returned(3)) == "[-1 1][4 if][-1 m][3 3]"
    assert text(must result(0)) + text(must result(1)) == "[-1 1][1 r]"
    assert text(optional(0)? or (9, 9)) + text(optional(1)? or (none, "d")) == "[-1 1][-1 d]"
    mut f = Fields(w: (none, 2))
    assert text(f.w) + text(f.d) == "[-1 2][-1 default]"
    f.w = (7, "set")
    assert text(f.w) == "[7 set]"
    f.w.0 = none
    f.w.1 = 8
    assert text(f.w) == "[-1 8]"
    let e: Payload = .A(w: (none, "enum"))
    if e is .A(w) {
        assert text(w) == "[-1 enum]"
    }
    let s: Shower = Show()
    assert s.show((none, "i")) == "[-1 i]"
    mut m = Map[str, (int64?, int64 | str)]()
    m["a"] = (none, "map")
    m.set("b", (1, 2))
    assert text(must m["a"]) + text(must m["b"]) + text(m["z", default: (none, "d")]) == "[-1 map][1 2][-1 d]"
    mut xs: [(int64?, int64 | str)] = [(none, 1)]
    xs += [(2, "push")]
    xs += [(none, "two"), (4, 5)]
    xs[0] = (none, "zero")
    mut all = ""
    for x in xs + [(none, "plus")] {
        all += text(x)
    }
    assert all == "[-1 zero][2 push][-1 two][4 5][-1 plus]"
    mut grid: [[(int64?, int64 | str)]] = [[(none, "g")], []]
    grid[1] += [(1, "gg")]
    assert text(grid[0][0]) + text(grid[1][0]) == "[-1 g][1 gg]"
    let o: (int64?, int64 | str)? = (none, "opt")
    assert text(must o) == "[-1 opt]"
    let u: (int64?, int64 | str) | bool = (none, "union")
    match u {
        bool -> assert false
        else -> assert f"{returned(0).1}" == "1"
    }
    let g = func(anon w: (int64?, int64 | str)) -> (int64?, int64 | str) {
        return (w.0, "lit")
    }
    assert text(g((none, 1))) == "[-1 lit]"
    assert text(state) == "[-1 module]"
    state = (3, "changed")
    assert text(state) == "[3 changed]"
    let ch = tasks.Channel[(int64?, int64 | str)](capacity: 2)
    ch.send((none, "chan"))
    assert text(must ch.receive()) == "[-1 chan]"
    let t = spawn returned(2)
    assert text(t.wait()) == "[-1 m]"
    let w: Wide = (none, "alias")
    assert text(w) == "[-1 alias]"
    assert appended((1, "z"), [(2, "y")]) == [(2, "y"), (1, "z")]
    assert swapped((1, "q")) == ("q", 1)
    let deep: ((int64?, str), [(int64?, bool)]) = ((none, "n"), [(none, true), (3, false)])
    assert deep.0.0 is none and (deep.1[1].0? or 0) == 3 and deep.1[0].1
}

func counter() -> func() -> int64 {
    mut (a, b) = (1, 10)
    return func() -> int64 {
        a += 1
        b += a
        return a * 100 + b
    }
}

test "captured by closures" {
    let next = counter()
    assert next() == 212 and next() == 315
    mut sums: [func() -> int64] = []
    for (a, b) in [(1, 2), (3, 4)] {
        sums += [func() -> int64 { return a * 10 + b }]
    }
    assert sums[0]() == 12 and sums[1]() == 34
}

extern func rc_live_bytes() -> int64

func made(anon i: int64) -> (str, (int64, [str])) {
    return (f"k{i}", (i, [f"a{i}", f"b{i}"]))
}

func work(anon i: int64) -> int64 {
    let (k, (n, parts)) = made(i)
    mut (x, y) = (k, parts)
    (x, y[0]) = (y[0], x)
    mut total = len(x) + len(y[0]) + n
    for (a, (b, c)) in [made(i), made(i + 1)] {
        total += len(a) + b + len(c)
    }
    mut m = Map[(str, int64), (str, [str])]()
    m[(k, n)] = (x, y)
    m[("z", i)] = ("q", [])
    for (p, q), (r, s) in m {
        total += len(p) + q + len(r) + len(s)
    }
    match made(i) {
        ("k3", (v, _)) -> total += v
        (w, (v, u)) if v > 2 -> total += len(w) + len(u)
        else -> total += 1
    }
    let o = if i % 2 == 0 { none } else { made(i) }
    if o is Some((w, (v, _))) {
        total += len(w) + v
    }
    if (made(i).0, i) < (made(i + 1).0, i) and (made(i).1, 1) != ((0, ["q"]), 1) {
        total += len(f"{made(i)}")
    }
    return total
}

test "nothing is left behind" {
    mut n = 0
    for i in 0..20 {
        n += work(i)
    }
    let before = rc_live_bytes()
    for i in 0..1000 {
        n += work(i % 20)
    }
    assert n > 0 and rc_live_bytes() - before < 1000
}
