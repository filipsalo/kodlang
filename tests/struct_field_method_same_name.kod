// A method can't take the name of a field of its struct.
type Bag = struct {
    items: [int64]
    len: int64 = 0

    func len(self) -> int64 {
        return len(self.items) + self.len
    }
}

func main() -> int64 {
    let b = Bag(items: [1, 2], len: 10)
    print_int(b.len())
    return 0
}

// expected errors:
// 6:10: error: `Bag.len` is already declared on line 4
