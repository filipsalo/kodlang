// String literals are UTF-8 bytes. `len` returns the byte length, not a
// code-point count.
test "len counts UTF-8 bytes" {
    assert len("héllo") == 6      // `é` is 2 UTF-8 bytes
    assert len("wörld") == 6
    assert len("ascii") == 5      // ASCII unchanged
    assert len("a\tb") == 3       // escapes still process
    let name = "wörld"
    assert len(f"{name}") == 6    // f-string preserves bytes
}
