// Fetch several URLs at once, each in a task of its own (docs/tasks.md).
//
//   kod run examples/fetch_all.kod https://example.com/ https://codeberg.org/
//
// Prints each URL's status, size and time, in the order given, then the
// total time, which is about the slowest fetch's rather than their sum.
// Exit status: 0 when every fetch got a response, 1 when one failed, 2 on a
// bad command line.
import "io"
import "net/http" { Client }
import "tasks"
import "time" { Duration, monotonic_ns }

type Fetched = struct {
    status: int64
    size: int64
    ms: int64
}

func ms_since(anon t0: int64) -> int64 {
    return (monotonic_ns() - t0) / 1000000
}

func fetch(anon client: Client, anon url: str) -> Fetched or Error {
    let t0 = monotonic_ns()
    let r = try client.get(url)
    return Fetched(status: r.status, size: len(r.body), ms: ms_since(t0))
}

func main(argv: [str]) -> int64 {
    if len(argv) < 2 {
        io.write_stderr("usage: fetch_all URL...\n")
        return 2
    }
    let urls = argv[1..len(argv)]
    // One Client for all: requests to one host can share its connections.
    let client = Client(deadline: Duration(seconds: 30))
    let t0 = monotonic_ns()
    mut fetches: [tasks.Task[Fetched or Error]] = []
    for url in urls {
        fetches += [spawn fetch(client, url)]
    }
    mut failed = false
    for i, task in fetches {
        match task.wait() {
            Ok(f) -> print(f"{f.status} {f.size} bytes {f.ms} ms {urls[i]}")
            Err(e) -> {
                io.write_stderr(f"{urls[i]}: {e.to_str()}\n")
                failed = true
            }
        }
    }
    print(f"{len(urls)} in {ms_since(t0)} ms")
    client.close()
    if failed {
        return 1
    }
    return 0
}
