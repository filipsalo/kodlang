type Box = shared struct {
    items: [int64] = []
}

func grow(anon xs: [int64]) -> int64 {
    mut ys = xs
    ys += [100]
    return len(ys)
}

func make() -> [int64] {
    return [1, 2]
}

test "every holder has an array of its own" {
    mut xs: [int64] = [1, 2]
    // Appending to xs leaves a alone.
    let a = xs
    let copy = xs + []
    xs += [3]
    assert a == [1, 2]
    assert copy == [1, 2]
    assert xs == [1, 2, 3]

    let b = Box()
    let held = b.items
    b.items += [7]
    b.items += [8]
    assert held == []
    assert b.items == [7, 8]
    assert Box().items == []

    mut rows: [[int64]] = [[1], [2, 3]]
    let first = rows[0]
    rows[0] += [4, 5]
    assert first == [1]
    assert rows[0] == [1, 4, 5]

    // A loop goes over the array as it was when it started.
    mut seen = 0
    for x in xs {
        if x < 3 {
            xs += [x + 10]
        }
        seen += 1
    }
    assert seen == 3
    assert xs == [1, 2, 3, 11, 12]

    // A mut binding has an array of its own, however it starts.
    mut mine = b.items
    mine += [99]
    assert mine == [7, 8, 99]
    assert b.items == [7, 8]
    mut row = rows[0]
    row += [6]
    assert row == [1, 4, 5, 6]
    assert rows[0] == [1, 4, 5]
    mut ws = xs
    ws += [1]
    xs += [2]
    assert len(ws) - len(xs) == 0
    assert ws == [1, 2, 3, 11, 12, 1]
    assert xs == [1, 2, 3, 11, 12, 2]
}

test "a fresh array each time round a loop" {
    mut fresh: [[int64]] = []
    for i in [0, 1, 2] {
        mut acc: [int64] = []
        acc += [i]
        fresh += [acc]
    }
    assert fresh == [[0], [1], [2]]
}

test "appending to a parameter's copy leaves the caller's array alone" {
    let zs: [int64] = [7]
    assert grow(zs) == 2
    assert zs == [7]
}

test "appending to a returned array" {
    mut made = make()
    made += [5]
    assert made == [1, 2, 5]
}
