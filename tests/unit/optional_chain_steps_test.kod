// After `x?.`, the rest of the chain runs on the unwrapped value: `none` as soon as `x` is.

type Oops = shared struct {
    func to_str(self) -> str {
        return "oops"
    }
}

type Inner = shared struct {
    n: int64
    label: str?

    func twice(self) -> int64 {
        return self.n * 2
    }
}

type User = shared struct {
    name: str
    tags: [str]
    inner: Inner
    maybe: Inner?

    func shout(self) -> str {
        return self.name.upper()
    }

    func get(self, anon key: str) -> Inner {
        return Inner(n: len(key), label: key)
    }
}

func make(anon id: int64) -> User? {
    if id < 0 {
        return none
    }
    mut maybe: Inner? = none
    if id > 0 {
        maybe = Inner(n: id, label: none)
    }
    return User(name: f"user{id}", tags: ["a", "bc"], inner: Inner(n: 10 + id, label: "in"), maybe: maybe)
}

func load(anon id: int64) -> User or Error {
    if id < 0 {
        throw Oops()
    }
    return must make(id)
}

mut evaluated: [str] = []

func noisy(anon s: str) -> str {
    evaluated += [s]
    return s
}

test "steps after ?. on an optional" {
    assert (make(1)?.name.upper()? or "-") == "USER1"
    assert (make(-1)?.name.upper()? or "-") == "-"
    assert (make(2)?.tags[1]? or "-") == "bc"
    assert (make(-2)?.tags[1]? or "-") == "-"
    assert (make(3)?.inner.twice()? or 0) == 26
    assert (make(-3)?.inner.twice()? or 0) == 0
    assert (make(4)?.shout().lower()? or "-") == "user4"
    assert (make(4)?.get(noisy("key")).n? or 0) == 3
    assert evaluated == ["key"]
    assert (make(-4)?.get(noisy("never")).n? or 0) == 0
    assert evaluated == ["key"]
}

test "steps that give an optional flatten" {
    // A step that gives an optional flattens: `label` is `str?`.
    assert (make(5)?.inner.label? or "-") == "in"
    assert (make(5)?.get("xy").label? or "-") == "xy"
    // `?.` again where a step is itself optional.
    assert (make(6)?.maybe?.twice()? or 0) == 12
    assert (make(0)?.maybe?.twice()? or 0) == 0
    assert (make(7)?.maybe?.label? or "no label") == "no label"
    assert (make(7)?.maybe?.n.to_str()? or "-") == "7"
}

test "steps after ?. on a result" {
    assert (load(8)?.name.upper()? or "-") == "USER8"
    assert (load(-8)?.name.upper()? or "-") == "-"
    assert (load(9)?.inner.label? or "-") == "in"
}

test "a chain as a statement and in a binding" {
    make(1)?.inner.twice()
    let n = make(11)?.inner.n
    assert (n? or 0) == 21
    let missing = make(-1)?.inner.n
    assert missing is none
}
