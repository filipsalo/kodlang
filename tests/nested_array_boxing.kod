// Array literals are boxed and wrapped for their element type, nested or appended.
interface Shape {
    func area(self) -> int64
}
type Sq = struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
func total(anon shapes: [Shape]) -> int64 {
    mut t = 0
    for sh in shapes {
        t += sh.area()
    }
    return t
}
func grid_total(anon grid: [[Shape]]) -> int64 {
    mut t = 0
    for row in grid {
        t += total(row)
    }
    return t
}
func main() -> int64 {
    let g: [[Shape]] = [[Sq(s: 3)]]
    print_int(g[0][0].area())
    let o: [[int64?]] = [[1, none]]
    let row = o[0]
    print_int(row[0]? or -1)
    print_int(row[1]? or -1)
    print_int(total([Sq(s: 2), Sq(s: 1)]))
    print_int(grid_total([[Sq(s: 2)], [Sq(s: 1), Sq(s: 1)]]))
    mut shapes: [Shape] = []
    shapes += [Sq(s: 4)]
    print_int(total(shapes))
    mut grid: [[Shape]] = []
    grid += [[Sq(s: 5)]]
    grid[0] = [Sq(s: 6)]
    print_int(grid_total(grid))
    mut opts: [int64?] = [none]
    opts += [7]
    print_int(opts[1]? or -1)
    return 0
}

// expected output:
// 9
// 1
// -1
// 5
// 6
// 16
// 36
// 7
