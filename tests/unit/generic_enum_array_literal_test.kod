// A generic enum's variants in an array literal are built as the element instance.
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}
type Opt[T] = enum {
    None
    Some(value: T)
}
type H = shared struct {
    ms: [Maybe[int64]]
}
func show(anon m: Maybe[int64]) -> str {
    return match m {
        .Just(v) -> f"just {v}"
        .Nothing -> "nothing"
    }
}
func shows(anon ms: [Maybe[int64]]) -> str {
    mut parts = ""
    for m in ms {
        parts = parts + show(m) + ";"
    }
    return parts
}
func make() -> [[Maybe[int64]]] {
    return [[Maybe.Just(value: 7)], [.Nothing]]
}
test "variants in array literals" {
    let xs: [Maybe[int64]] = [Maybe.Just(value: 5), .Nothing, .Just(value: 6)]
    assert shows(xs) == "just 5;nothing;just 6;"
    assert shows([Maybe.Nothing, Maybe.Just(value: 1)]) == "nothing;just 1;"
    let h = H(ms: [.Just(value: 2)])
    assert shows(h.ms) == "just 2;"
    mut ys: [Maybe[int64]] = []
    ys += [Maybe.Just(value: 8)]
    ys[0] = Maybe.Just(value: 10)
    assert shows(ys) == "just 10;"
    let g = make()
    assert shows(g[0]) == "just 7;"
    assert shows(g[1]) == "nothing;"
}

test "results and a user enum with Some and None variants" {
    let rs: [int64 or Error] = [.Ok(value: 3), Result.Ok(value: 4)]
    assert must rs[0] + must rs[1] == 7
    let os: [Opt[int64]] = [Opt.Some(9), .None]
    mut seen: [str] = []
    for o in os {
        match o {
            .Some(v) -> seen += [f"{v}"]
            .None -> seen += ["none"]
        }
    }
    assert seen == ["9", "none"]
}
