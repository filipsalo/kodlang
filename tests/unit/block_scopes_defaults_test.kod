// A default follows the block rules too: a match arm's binding in a
// parameter, field, method or interface method default hides the same name
// bound by an enclosing arm, and that one is back after the inner match.
func one() -> int64? {
    return 1
}

func two() -> int64? {
    return 20
}

func f(x: int64 = match one() {
    .Some(v) -> match two() {
        .Some(v) -> v
        else -> 0
    } + v
    else -> 0
}) -> int64 {
    return x
}

interface Sized {
    func size(self, by: int64 = match one() { .Some(v) -> match two() { .Some(v) -> v  else -> 0 } + v  else -> 0 }) -> int64
}

type Box = shared struct {
    n: int64 = match one() {
        .Some(v) -> match two() {
            .Some(v) -> v
            else -> 0
        } + v
        else -> 0
    }

    func size(self, by: int64 = match one() { .Some(v) -> match two() { .Some(v) -> v  else -> 0 } + v  else -> 0 }) -> int64 {
        return by
    }
}

test "a default's inner match binding hides the outer one" {
    assert f() == 21
    assert Box().n == 21
    let s: Sized = Box()
    assert s.size() == 21
}
