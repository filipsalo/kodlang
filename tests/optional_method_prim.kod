// `x?.method(...)` on a `T?` whose `T` isn't a struct: primitives,
// interface values and a generic `T`.

interface Talker {
    func say(self, loud: bool = false) -> str
    func shout(self) -> none
}

type Dog = struct {
    name: str
    func say(self, loud: bool = false) -> str {
        if loud {
            return self.name.upper()
        }
        return self.name
    }
    func shout(self) -> none {
        print(f"{self.name}!")
    }
}

func opt_f(anon v: float64?) -> float64? { return v }
func opt_i(anon v: int64?) -> int64? { return v }
func opt_s(anon v: str?) -> str? { return v }

func talker(anon b: bool) -> Talker? {
    if b {
        return Dog(name: "rex")
    }
    return none
}

mut calls: int64 = 0

func arg() -> str {
    calls += 1
    return "l"
}

func show[T](anon v: T?) -> str {
    return v?.to_str()? or "-"
}

func main() {
    print(f"{opt_f(1.0 / 0.0)?.is_inf()? or false} {opt_f(none)?.is_inf() is none}")
    print(opt_i(7)?.to_str()? or "none")
    print(opt_i(none)?.to_str()? or "none")
    print(f"{opt_s("hello")?.find(arg())? or -1} {opt_s(none)?.find(arg())? or -1} {calls}")
    print(opt_s("ab")?.repeat(2)?.upper()? or "none")
    print(len(opt_s("a,b,c")?.split(",")? or []))
    print(talker(true)?.say()? or "-")
    print(talker(true)?.say(loud: true)? or "-")
    print(talker(false)?.say()? or "-")
    talker(true)?.shout()
    talker(false)?.shout()
    let missing: int64? = none
    print(f"{show(5)} {show(missing)} {show(2.5)}")
}

// expected output:
// true true
// 7
// none
// 2 -1 1
// ABAB
// 3
// rex
// REX
// -
// rex!
// 5 - 2.5
