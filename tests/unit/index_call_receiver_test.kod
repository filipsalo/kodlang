// Indexing a value a call returned with an index a call returns keeps the
// value while the index is computed, also when the calls nest.

type Tab = shared struct {
    base: int64

    func op_index(self, anon k: int64) -> int64 {
        return self.base + k
    }
}

func arr(anon xs: [int64]) -> [int64] {
    return xs
}

func idx(anon n: int64) -> int64 {
    return n
}

func word() -> str {
    return "hello"
}

func raw() -> bytes {
    return b"world"
}

func tab() -> Tab {
    return Tab(base: 40)
}

func ages() -> Map[str, int64] {
    mut m = Map[str, int64]()
    m["ann"] = 31
    return m
}

func name() -> str {
    return "ann"
}

test "a returned value keeps while its index is computed" {
    let xs = [10, 20, 30]
    assert arr(xs)[idx(1)] == 20
    assert arr(xs)[idx(-1)] == 30
    assert word()[idx(1)] == 101
    assert raw()[idx(0)] == 119
    assert tab()[idx(2)] == 42
    assert (ages()[name()]? or 0) == 31
    assert arr(xs)[arr([0, 1, 2])[arr([2, 1, 0])[idx(0)]]] == 30
    assert arr(xs)[idx(0)] + arr(xs)[idx(1)] * arr(xs)[idx(2)] == 610
}
