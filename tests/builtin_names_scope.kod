// A local hides a function or builtin of its name from its declaration on,
// and only when it holds a function.
type Fn = func([int64]) -> int64

func pick(anon n: int64) -> Fn? {
    if n > 0 {
        return func(anon xs: [int64]) -> int64 {
            return 100
        }
    }
    return none
}

func param_len(anon s: str, len: int64) -> int64 {
    return len(s) + len
}

func lets(anon xs: [int64]) -> none {
    let len = len(xs)
    print_int(len + len([1]))
    let hash = hash("ab")
    print(f"{hash == "ab".hash()}")
}

func loops(anon xs: [int64]) -> none {
    print_int(len(xs))
    for len in [5, 6] {
        print_int(len(xs) + len)
    }
    mut n = 0
    for n < 2 {
        let len = len([1, 2, 3])
        print_int(len + n)
        n += 1
    }
}

func blocks(anon xs: [int64]) -> none {
    if len(xs) > 1 {
        let len = func(anon a: [int64]) -> int64 {
            return 50
        }
        print_int(len(xs))
    }
    print_int(len(xs))
    let o: int64? = 7
    match o {
        Some(n) -> print(str(n + 1))
        none -> print("none")
    }
    print(str(9))
    if pick(1) is Some(hash) {
        print_int(hash(xs))
    }
    print_int(hash(3))
}

func later(anon xs: [int64]) -> none {
    print_int(len(xs))
    kod_panic("x")
    let len = func(anon a: [int64]) -> int64 {
        return 50
    }
}

func values(anon xs: [int64]) -> none {
    print(str(1))
    let kod_panic = func(anon m: str) -> none {
        print(f"soft {m}")
    }
    kod_panic("x")
}

func main() -> int64 {
    let xs = [1, 2, 3, 4]
    lets(xs)
    print_int(param_len("abc", len: 10))
    loops(xs)
    blocks(xs)
    values(xs)
    later(xs)
    return 0
}

// expected output:
// 5
// true
// 13
// 4
// 9
// 10
// 3
// 4
// 50
// 4
// 8
// 9
// 100
// 3
// 1
// soft x
// 4
// expected stderr:
// panic: x
// expected status:
// 1
