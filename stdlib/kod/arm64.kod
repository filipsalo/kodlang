// The arm64 lowering of the compiler's IR (regalloc.Insn, see docs/ir.md):
// how each instruction is written as arm64 assembly, the mnemonics, the
// inlined runtime functions, and the lines arm64 needs where one instruction
// can't do. Another target gets a module like this one.

import "kod/lexing"
import "kod/regalloc"
import "libc"
import "unsafe"
import "strbuilder" { StrBuilder }

// The arm64 name of a condition.
func cond_name(anon c: regalloc.Cond) -> str {
    match c {
        .Eq -> return "eq"
        .Ne -> return "ne"
        .Hs -> return "hs"
        .Lo -> return "lo"
        .Hi -> return "hi"
        .Ls -> return "ls"
        .Mi -> return "mi"
        .Pl -> return "pl"
        .Vs -> return "vs"
        .Vc -> return "vc"
        .Ge -> return "ge"
        .Lt -> return "lt"
        .Gt -> return "gt"
        .Le -> return "le"
    }
}

// The arm64 mnemonic of a branch.
func branch_mnemonic(anon kind: regalloc.BranchKind) -> str {
    match kind {
        .Always -> return "b"
        .If(cond) -> return f"b.{cond_name(cond)}"
        .IfZero -> return "cbz"
        .IfNonzero -> return "cbnz"
    }
}

// The arm64 mnemonic for an opcode.
func arm64_mnemonic(anon op: regalloc.Opcode) -> str {
    match op {
        .Move -> return "mov"
        .Add -> return "add"
        .Sub -> return "sub"
        .Mul -> return "mul"
        .DivSigned -> return "sdiv"
        .And -> return "and"
        .Or -> return "orr"
        .Xor -> return "eor"
        .ShiftLeft -> return "lsl"
        .ShiftRight -> return "lsr"
        .ShiftRightSigned -> return "asr"
        .Compare -> return "cmp"
        .CompareIf -> return "ccmp"
        .SetIf -> return "cset"
        .Select -> return "csel"
        .AddressPage -> return "adrp"
        .FloatMove -> return "fmov"
        .FloatAdd -> return "fadd"
        .FloatSub -> return "fsub"
        .FloatMul -> return "fmul"
        .FloatDiv -> return "fdiv"
        .FloatNeg -> return "fneg"
        .FloatCompare -> return "fcmp"
        .CallIndirect -> return "blr"
        .Return -> return "ret"
    }
}

// The opcode an arm64 mnemonic is, for the passes that still read mnemonics.
func opcode_named(anon mn: str) -> regalloc.Opcode? {
    match mn {
        "mov" -> return .Move
        "add" -> return .Add
        "sub" -> return .Sub
        "cmp" -> return .Compare
        "cset" -> return .SetIf
        else return none
    }
}

// The arm64 mnemonic for a load or store of `width` bytes.
func mem_mnemonic(load: bool, width: int64) -> str {
    mut op = "str"
    if load {
        op = "ldr"
    }
    if width == 1 {
        return op + "b"
    }
    if width == 2 {
        return op + "h"
    }
    return op
}

// The asm text of an `Op` line.
func op_text(op: regalloc.Opcode, a: str, b: str, c: str, d: str) -> str {
    let mn = arm64_mnemonic(op)
    if len(a) == 0 {
        return f"\t{mn}"
    }
    if len(b) == 0 {
        return f"\t{mn} {a}"
    }
    if len(c) == 0 {
        return f"\t{mn} {a}, {b}"
    }
    if len(d) == 0 {
        return f"\t{mn} {a}, {b}, {c}"
    }
    return f"\t{mn} {a}, {b}, {c}, {d}"
}

// log2 of an access width of 1, 2, 4 or 8 bytes: the shift a scaled index takes.
func width_shift(anon width: int64) -> int64 {
    if width == 8 {
        return 3
    } else if width == 4 {
        return 2
    } else if width == 2 {
        return 1
    }
    return 0
}

// The asm text of a `Mem` line, with `reg`, `base` and an index as its
// registers (`index` stands for the one `at` has).
func mem_text(load: bool, width: int64, reg: str, base: str, at: regalloc.MemAt, index: str = "") -> str {
    let op = mem_mnemonic(:load, :width)
    match at {
        .Base -> return f"\t{op} {reg}, [{base}]"
        .Offset(off) -> return f"\t{op} {reg}, [{base}, #{off}]"
        .Index(_reg, scaled) -> {
            if scaled {
                return f"\t{op} {reg}, [{base}, {index}, lsl #{width_shift(width)}]"
            }
            return f"\t{op} {reg}, [{base}, {index}]"
        }
        .Symbol(name, got) -> {
            if got {
                return f"\t{op} {reg}, [{base}, {name}@GOTPAGEOFF]"
            }
            return f"\t{op} {reg}, [{base}, {name}@PAGEOFF]"
        }
    }
}

// The asm text of a `Pair` line.
func pair_text(load: bool, a: str, b: str, base: str, mode: regalloc.PairMode) -> str {
    mut op = "stp"
    if load {
        op = "ldp"
    }
    match mode {
        .At(off) -> {
            if off == 0 {
                return f"\t{op} {a}, {b}, [{base}]"
            }
            return f"\t{op} {a}, {b}, [{base}, #{off}]"
        }
        .Pre(off) -> return f"\t{op} {a}, {b}, [{base}, #{off}]!"
        .Post(off) -> return f"\t{op} {a}, {b}, [{base}], #{off}"
    }
}

// The asm text of a `Slot` line, with `reg` as the register.
func slot_text(store: bool, reg: str, off: int64) -> str {
    mut op = "ldr"
    if store {
        op = "str"
    }
    if off >= 0 {
        return f"\t{op} {reg}, [fp]"
    }
    return f"\t{op} {reg}, [fp, #{off}]"
}

// The asm text of a `Branch` line, with `reg` as its register.
func branch_text(kind: regalloc.BranchKind, reg: str, target: str) -> str {
    let op = branch_mnemonic(kind)
    if len(reg) == 0 {
        return f"\t{op} {target}"
    }
    return f"\t{op} {reg}, {target}"
}

// The asm text of a `LoadConst`: its lines, joined by newlines. A 16-bit part
// that is zero needs no `movk`, so this is at most LOAD_CONST_LINES lines.
func load_const_text(dst: str, value: int64) -> str {
    mut text = f"\tmov {dst}, #({value} & 0xffff)"
    for shift in [16, 32, 48] {
        if ((value >> shift) & 65535) != 0 {
            text += f"\n\tmovk {dst}, #(({value} >> {shift}) & 0xffff), lsl #{shift}"
        }
    }
    return text
}

// How many lines of asm `body` prints, which limits that count lines go by.
func line_count(anon body: [regalloc.Insn]) -> int64 {
    mut n = len(body)
    for insn in body {
        if insn is .LoadConst(_dst, _value) {
            n += regalloc.LOAD_CONST_LINES - 1
        }
        if insn is .Intrinsic(label) {
            n += len(arm64_intrinsic(label)) - 1
        }
    }
    return n
}

// Whether a call to `label` is an intrinsic, done without calling.
func is_intrinsic(anon label: str) -> bool {
    return len(arm64_intrinsic(label)) > 0
}

// The arm64 instructions that stand in for a call to `label`, with the
// arguments in x0 and x1 and the result left in x0, or [] for an ordinary call.
func arm64_intrinsic(anon label: str) -> [str] {
    match label {
        "$primitives$int64$leading_zeros" -> return ["clz x0, x0"]
        "$primitives$int64$trailing_zeros" -> return ["rbit x0, x0", "clz x0, x0"]
        // Count the bits of each byte, then add up the eight counts.
        "$primitives$int64$count_ones" -> return ["fmov d0, x0", "cnt v0.8b, v0.8b", "addv b0, v0.8b", "fmov x0, d0"]
        "$primitives$int64$mul_high" -> return ["umulh x0, x0, x1"]
        "_kod_f64_abs" -> return ["fmov d0, x0", "fabs d0, d0", "fmov x0, d0"]
        // Rounding toward minus infinity, plus infinity, and to nearest
        // with ties away from zero, as C's floor, ceil and round.
        "_kod_f64_floor" -> return ["fmov d0, x0", "frintm d0, d0", "fmov x0, d0"]
        "_kod_f64_ceil" -> return ["fmov d0, x0", "frintp d0, d0", "fmov x0, d0"]
        "_kod_f64_round" -> return ["fmov d0, x0", "frinta d0, d0", "fmov x0, d0"]
        "_kod_f64_sqrt" -> return ["fmov d0, x0", "fsqrt d0, d0", "fmov x0, d0"]
        // Only not-a-number is unordered with itself.
        "_kod_f64_is_nan" -> return ["fmov d0, x0", "fcmp d0, d0", "cset x0, vs"]
        // Without the sign bit, infinity is exactly the all-ones exponent.
        "_kod_f64_is_inf" -> return ["and x0, x0, #0x7fffffffffffffff", "eor x0, x0, #0x7ff0000000000000", "cmp x0, #0", "cset x0, eq"]
        // Truncates toward zero, saturates out of range, and gives 0 for
        // not-a-number.
        "_kod_f64_to_i64" -> return ["fmov d0, x0", "fcvtzs x0, d0"]
        "_kod_i64_to_f64" -> return ["scvtf d0, x0", "fmov x0, d0"]
        // A float64 already travels as its bits, so these change only the type.
        "_kod_f64_bits" | "_kod_f64_from_bits" -> return ["mov x0, x0"]
        // stdlib/unsafe.kod: raw loads and stores, a C int's sign, and the
        // address a str or bytes value already is. `w<n>` in this text is a
        // virtual register, so the narrow forms go through x and v0's b/s views.
        "_kod_unsafe_load8" -> return ["ldrsb x0, [x0]", "and x0, x0, #0xff"]
        "_kod_unsafe_load32" -> return ["ldrsw x0, [x0]"]
        "_kod_unsafe_load64" -> return ["ldr x0, [x0]"]
        "_kod_unsafe_store8" -> return ["fmov d0, x1", "str b0, [x0]"]
        "_kod_unsafe_store32" -> return ["fmov d0, x1", "str s0, [x0]"]
        "_kod_unsafe_store64" -> return ["str x1, [x0]"]
        "_kod_unsafe_c_int" -> return ["lsl x0, x0, #32", "asr x0, x0, #32"]
        "_kod_unsafe_str_ref" | "_kod_unsafe_bytes_ref" -> return ["mov x0, x0"]
        else -> return []
    }
}

// The text of a Raw instruction, or "" for a label.
func insn_text(anon insn: regalloc.Insn) -> str {
    match insn {
        .Slot(store, reg, off) -> return slot_text(:store, reg: regalloc.reg_text(reg), :off)
        .Mov(dst, src) -> return f"\tmov {regalloc.reg_text(dst)}, {regalloc.reg_text(src)}"
        .Mem(load, width, reg, base, at) -> return mem_text(:load, :width, reg: regalloc.reg_text(reg), base: regalloc.reg_text(base), :at, index: regalloc.reg_text(regalloc.at_reg(at)))
        .Op(op, a, b, c, d, _flags) -> return op_text(:op, a: regalloc.reg_text(a), b: regalloc.reg_text(b), c: regalloc.reg_text(c), d: regalloc.reg_text(d))
        .Pair(load, a, b, base, mode) -> return pair_text(:load, a: regalloc.reg_text(a), b: regalloc.reg_text(b), base: regalloc.reg_text(base), :mode)
        .LoadConst(dst, value) -> return load_const_text(dst: regalloc.reg_text(dst), :value)
        .Data(text) -> return text
        .Intrinsic(label) -> {
            mut text = ""
            for line in arm64_intrinsic(label) {
                if len(text) > 0 {
                    text = text + "\n"
                }
                text = text + "\t" + line
            }
            return text
        }
        .Call(target) -> return f"\tbl {target}"
        .Branch(kind, reg, target) -> return branch_text(:kind, reg: regalloc.reg_text(reg), :target)
        .Label(_name) -> return ""
    }
}

// Where `#N` starts in an `add`, `sub`, `ldr` or `str` line that can't encode N, or -1.
func big_immediate_at(anon s: str) -> int64 {
    if len(s) < 5 {
        return -1
    }
    let op = s[0..5]
    let is_arith = op == "\tadd " or op == "\tsub "
    let is_mem = op == "\tldr " or op == "\tstr "
    if not is_arith and not is_mem {
        return -1
    }
    let at = s.find("#")
    if at is Some(hash) {
        mut end = hash + 1
        mut value = 0
        // Far past either limit; a longer number needn't be read in full.
        for end < len(s) and lexing.is_digit(s[end]) {
            if value < 1000000 {
                value = value * 10 + s[end] - '0'
            }
            end += 1
        }
        if end == hash + 1 {
            return -1
        }
        if is_arith and end == len(s) and value > 4095 {
            return hash
        }
        if is_mem and s[end..] == "]" and value > 32760 {
            return hash
        }
    }
    return -1
}

// The asm lines for `s`: itself, or, for an `add`, `sub`, `ldr` or `str`
// whose immediate is too big to encode, that immediate put in x16 first (x16
// holds nothing between instructions of this kind).
func encodable_lines(anon s: str) -> [str] {
    let at = big_immediate_at(s)
    if at < 0 {
        return [s]
    }
    mut end = at + 1
    for end < len(s) and lexing.is_digit(s[end]) {
        end += 1
    }
    let value = s[at + 1..end]
    return [
        f"\tmov x16, #({value} & 0xffff)",
        f"\tmovk x16, #(({value} >> 16) & 0xffff), lsl #16",
        f"\tmovk x16, #(({value} >> 32) & 0xffff), lsl #32",
        s[0..at] + "x16" + s[end..],
    ]
}

// The asm text of an instruction, with each vreg its physical register in
// `vreg_phys` (an instruction's lines joined by newlines).
func format_insn(anon insn: regalloc.Insn, vreg_phys: [regalloc.Reg]) -> str {
    match insn {
        .Slot(store, reg, off) -> return slot_text(:store, reg: phys_of(reg, :vreg_phys), :off)
        .Mov(dst, src) -> return f"\tmov {phys_of(dst, :vreg_phys)}, {phys_of(src, :vreg_phys)}"
        .Mem(load, width, reg, base, at) -> return mem_text(:load, :width, reg: phys_of(reg, :vreg_phys), base: phys_of(base, :vreg_phys), :at, index: phys_of(regalloc.at_reg(at), :vreg_phys))
        .Pair(load, a, b, base, mode) -> return pair_text(:load, a: regalloc.reg_text(a), b: regalloc.reg_text(b), base: regalloc.reg_text(base), :mode)
        .LoadConst(dst, value) -> return load_const_text(dst: phys_of(dst, :vreg_phys), :value)
        .Intrinsic(_label) -> return insn_text(insn)
        .Data(text) -> return text
        .Op(op, a, b, c, d, _flags) -> return op_text(:op, a: phys_of(a, :vreg_phys), b: phys_of(b, :vreg_phys), c: phys_of(c, :vreg_phys), d: phys_of(d, :vreg_phys))
        .Call(target) -> return f"\tbl {target}"
        .Branch(kind, reg, target) -> return branch_text(:kind, reg: phys_of(reg, :vreg_phys), :target)
        .Label(name) -> return name + ":"
    }
}

// Writes the asm lines of an instruction to `out`, each ending in a newline:
// format_insn's text, less a `mov` of a register to itself, with an immediate
// too big to encode put in x16 first (encodable_lines). The common
// instructions are written piece by piece, with no string made for the line.
// An instruction written as its word gets its text as a comment only with
// KOD_ASM_TEXT set: writing the text, and skipping it when the output is
// assembled, cost about a twentieth of a compile.
mut ASM_TEXT: bool = libc.getenv(unsafe.c_str("KOD_ASM_TEXT")) != 0

func write_insn(anon insn: regalloc.Insn, vreg_phys: [regalloc.Reg], out: StrBuilder) -> none {
    if not ASM_TEXT and write_word_only(insn, :vreg_phys, :out) {
        return none
    }
    match insn {
        .Slot(store, reg, off) -> {
            write_word(insn, :vreg_phys, :out)
            if store {
                out.append("\tstr ")
            } else {
                out.append("\tldr ")
            }
            write_reg(reg, :vreg_phys, :out)
            if off >= 0 {
                out.append(", [fp]\n")
            } else {
                out.append(", [fp, #")
                out.append_int(off)
                out.append("]\n")
            }
        }
        .Mov(dst, src) -> {
            let d = phys_of(dst, :vreg_phys)
            let s = phys_of(src, :vreg_phys)
            if d == s and is_numbered_reg(d) {
                return none
            }
            write_word(insn, :vreg_phys, :out)
            out.append("\tmov ")
            out.append(d)
            out.append(", ")
            out.append(s)
            out.append("\n")
        }
        .Mem(load, width, reg, base, at) -> {
            if at is .Offset(off) and width >= 4 and off > 32760 {
                write_text(format_insn(insn, :vreg_phys), flags: regalloc.INFO_BIG_IMM, :out)
                return none
            }
            write_word(insn, :vreg_phys, :out)
            out.append("\t")
            out.append(mem_mnemonic(:load, :width))
            out.append(" ")
            write_reg(reg, :vreg_phys, :out)
            out.append(", [")
            write_reg(base, :vreg_phys, :out)
            match at {
                .Base -> out.append("]\n")
                .Offset(off) -> {
                    out.append(", #")
                    out.append_int(off)
                    out.append("]\n")
                }
                .Index(index, scaled) -> {
                    out.append(", ")
                    write_reg(index, :vreg_phys, :out)
                    if scaled {
                        out.append(", lsl #")
                        out.append_int(width_shift(width))
                    }
                    out.append("]\n")
                }
                .Symbol(name, got) -> {
                    out.append(", ")
                    out.append(name)
                    if got {
                        out.append("@GOTPAGEOFF]\n")
                    } else {
                        out.append("@PAGEOFF]\n")
                    }
                }
            }
        }
        .Op(op, a, b, c, d, flags) -> {
            if (flags & regalloc.INFO_BIG_IMM) != 0 {
                write_text(format_insn(insn, :vreg_phys), :flags, :out)
                return none
            }
            if op is .Move and c == regalloc.NO_REG {
                let pa = phys_of(a, :vreg_phys)
                if pa == phys_of(b, :vreg_phys) and is_numbered_reg(pa) {
                    return none
                }
            }
            write_word(insn, :vreg_phys, :out)
            out.append("\t")
            out.append(arm64_mnemonic(op))
            // The operands are a prefix of a, b, c, d: the first empty one ends them.
            if a != regalloc.NO_REG {
                out.append(" ")
                write_reg(a, :vreg_phys, :out)
                if b != regalloc.NO_REG {
                    out.append(", ")
                    write_reg(b, :vreg_phys, :out)
                    if c != regalloc.NO_REG {
                        out.append(", ")
                        write_reg(c, :vreg_phys, :out)
                        if d != regalloc.NO_REG {
                            out.append(", ")
                            write_reg(d, :vreg_phys, :out)
                        }
                    }
                }
            }
            out.append("\n")
        }
        .Call(target) -> {
            out.append("\tbl ")
            out.append(target)
            out.append("\n")
        }
        .Branch(kind, reg, target) -> {
            out.append("\t")
            out.append(branch_mnemonic(kind))
            out.append(" ")
            if reg != regalloc.NO_REG {
                write_reg(reg, :vreg_phys, :out)
                out.append(", ")
            }
            out.append(target)
            out.append("\n")
        }
        .Label(name) -> {
            out.append(name)
            out.append(":\n")
        }
        .Intrinsic(label) -> {
            // Line by line, as a call's lines were: `mov x0, x0` is no line at all.
            for line in arm64_intrinsic(label) {
                let text = "\t" + line
                if not is_self_mov(text) {
                    write_line(text, :out)
                }
            }
        }
        .Pair(_load, _a, _b, _base, _mode) -> {
            write_word(insn, :vreg_phys, :out)
            write_text(format_insn(insn, :vreg_phys), flags: regalloc.insn_flags(insn), :out)
        }
        else -> write_text(format_insn(insn, :vreg_phys), flags: regalloc.insn_flags(insn), :out)
    }
}

// Writes `s`, an instruction's text with `flags` its insn_flags, as write_insn does.
func write_text(anon s: str, flags: int64, out: StrBuilder) -> none {
    // Only a `mov` can be a self-mov; only a flagged line can need splitting.
    if regalloc.mnemonic_code(flags) == regalloc.MN_MOV and is_self_mov(s) {
        return none
    }
    for line in encodable_lines(s) {
        // A large constant's text is several lines.
        if line.contains("\n") {
            for part in line.split("\n") {
                write_line(part, :out)
            }
        } else {
            write_line(line, :out)
        }
    }
}

// Writes an instruction's text line, as its word where encode_text has one.
func write_line(anon text: str, out: StrBuilder) -> none {
    let word = encode_text(text)
    if word >= 0 {
        write_hex_word(word, :out)
        if not ASM_TEXT {
            out.append("\n")
            return none
        }
    }
    out.append(text)
    out.append("\n")
}

// Writes `insn` as its word alone, if it has one and is written as itself
// (a self-move is left out, a far slot is several instructions).
func write_word_only(anon insn: regalloc.Insn, vreg_phys: [regalloc.Reg], out: StrBuilder) -> bool {
    match insn {
        .Mov(dst, src) -> {
            if phys_of(dst, :vreg_phys) == phys_of(src, :vreg_phys) {
                return false
            }
        }
        .Mem(_load, width, _reg, _base, at) -> {
            if at is .Offset(off) and width >= 4 and off > 32760 {
                return false
            }
        }
        else none
    }
    let word = encode(insn, :vreg_phys)
    if word < 0 {
        return false
    }
    write_hex_word(word, :out)
    out.append("\n")
    return true
}

// Whether `reg` is `xN` or `wN`, the registers is_self_mov looks for.
func is_numbered_reg(anon reg: str) -> bool {
    if len(reg) < 2 or (reg[0] != 'x' and reg[0] != 'w') {
        return false
    }
    for k in 1..len(reg) {
        if not lexing.is_digit(reg[k]) {
            return false
        }
    }
    return true
}

// Appends `r` as phys_of writes it, without making a string for it.
func write_reg(anon r: regalloc.Reg, vreg_phys: [regalloc.Reg], out: StrBuilder) -> none {
    let tag = r & 3
    if tag == 3 {
        out.append("#")
        out.append_int(r >> 2)
    } else if tag == 0 {
        out.append(regalloc.NAMES[r >> 2])
    } else {
        out.append(phys_of(r, :vreg_phys))
    }
}

// The physical register a register name stands for at output: a vreg's,
// `w` form for a `w` vreg, and any other name as it is.
func phys_of(anon reg: regalloc.Reg, vreg_phys: [regalloc.Reg]) -> str {
    let id = regalloc.reg_vreg(reg)
    if id < 0 or id >= len(vreg_phys) {
        return regalloc.reg_text(reg)
    }
    let phys = regalloc.reg_text(vreg_phys[id])
    if (reg & 3) == 2 {
        return "w" + phys[1..len(phys)]
    }
    return phys
}

// True if `s` is `\tmov xN, xN` for some register N — the no-op
// pattern coalescing leaves behind once vDst and vSrc share a phys.
func is_self_mov(anon s: str) -> bool {
    let n: int64 = len(s)
    if n < 8 or s[0] != '\t' or s[1] != 'm' or s[2] != 'o' or s[3] != 'v' or s[4] != ' ' {
        return false
    }
    mut i: int64 = 5
    // First operand: `xN` or `wN`.
    if i >= n or (s[i] != 'x' and s[i] != 'w') {
        return false
    }
    let start_a: int64 = i
    i = i + 1
    for i < n and lexing.is_digit(s[i]) {
        i = i + 1
    }
    let end_a: int64 = i
    if i >= n or s[i] != ',' {
        return false
    }
    i = i + 1
    for i < n and s[i] == ' ' {
        i = i + 1
    }
    // Second operand: same prefix + digits, exact match.
    if i >= n or (s[i] != 'x' and s[i] != 'w') {
        return false
    }
    let start_b: int64 = i
    i = i + 1
    for i < n and lexing.is_digit(s[i]) {
        i = i + 1
    }
    let end_b: int64 = i
    if i != n {
        return false
    }
    return s[start_a..end_a] == s[start_b..end_b]
}

// ── Machine words (docs/ir.md, step 9) ──────────────────────────────────────

// The number arm64 gives the general register `r` is (a vreg's register for a
// vreg), in a position where 31 is the zero register: -1 for sp, a 32-bit
// register, or anything that isn't a general register.
func zr_num(anon r: regalloc.Reg, vreg_phys: [regalloc.Reg]) -> int64 {
    let p = phys_reg(r, :vreg_phys)
    if p == regalloc.XZR {
        return 31
    }
    return x_num(p)
}

// As zr_num, where 31 is sp: -1 for the zero register.
func sp_num(anon r: regalloc.Reg, vreg_phys: [regalloc.Reg]) -> int64 {
    let p = phys_reg(r, :vreg_phys)
    if p == regalloc.SP {
        return 31
    }
    return x_num(p)
}

// The physical register of `r`: its register for an x vreg, `r` for a name,
// NO_REG for anything else (a w vreg, an immediate).
func phys_reg(anon r: regalloc.Reg, vreg_phys: [regalloc.Reg]) -> regalloc.Reg {
    let tag = r & 3
    if tag == 0 {
        return r
    }
    if tag == 1 and r >> 2 < len(vreg_phys) {
        return vreg_phys[r >> 2]
    }
    return regalloc.NO_REG
}

// x0 to x30 (fp and lr among them) as 0 to 30; -1 for any other.
func x_num(anon p: regalloc.Reg) -> int64 {
    let k = p >> 2
    if (p & 3) == 0 and k >= 1 and k <= 31 {
        return k - 1
    }
    if p == regalloc.FP {
        return 29
    }
    if p == regalloc.LR {
        return 30
    }
    return -1
}

// The number of a 32-bit register, a w vreg's register: -1 for any other.
func w_num(anon r: regalloc.Reg, vreg_phys: [regalloc.Reg]) -> int64 {
    if (r & 3) == 2 and r >> 2 < len(vreg_phys) {
        return x_num(vreg_phys[r >> 2])
    }
    // A w register named as itself, as text an instruction gives.
    if (r & 3) == 0 and r > regalloc.XZR {
        let text = regalloc.NAMES[r >> 2]
        if text == "wzr" {
            return 31
        }
        let n = reg_digits(text, prefix: 'w')
        if n >= 0 and n <= 30 {
            return n
        }
    }
    return -1
}

// The number after `prefix` in a register name such as `d3`, or -1.
func reg_digits(anon text: str, prefix: int64) -> int64 {
    if len(text) < 2 or len(text) > 3 or text[0] != prefix {
        return -1
    }
    mut n: int64 = 0
    for k in 1..len(text) {
        if text[k] < '0' or text[k] > '9' {
            return -1
        }
        n = n * 10 + text[k] - '0'
    }
    return n
}

// arm64's number for a condition.
func cond_code(anon c: regalloc.Cond) -> int64 {
    match c {
        .Eq -> return 0
        .Ne -> return 1
        .Hs -> return 2
        .Lo -> return 3
        .Mi -> return 4
        .Pl -> return 5
        .Vs -> return 6
        .Vc -> return 7
        .Hi -> return 8
        .Ls -> return 9
        .Ge -> return 10
        .Lt -> return 11
        .Gt -> return 12
        .Le -> return 13
    }
}

// The value of an immediate operand `#n` or `#-n`; none for any other.
func imm_of(anon r: regalloc.Reg) -> int64? {
    let v = regalloc.imm_value(r)
    if v >= 0 {
        return v
    }
    if (r & 3) == 0 and r > regalloc.XZR {
        let text = regalloc.NAMES[r >> 2]
        if len(text) >= 3 and text[0] == '#' and text[1] == '-' {
            mut n: int64 = 0
            for k in 2..len(text) {
                if text[k] < '0' or text[k] > '9' or k > 12 {
                    return none
                }
                n = n * 10 + text[k] - '0'
            }
            return 0 - n
        }
    }
    return none
}

// The word arm64 assembles `insn` to, as `as` would assemble its text, or -1
// when it names a label or a symbol, or is a form this doesn't know.
func encode(anon insn: regalloc.Insn, vreg_phys: [regalloc.Reg]) -> int64 {
    match insn {
        .Slot(store, reg, off) -> {
            mut at: regalloc.MemAt = .Base
            if off < 0 {
                at = .Offset(:off)
            }
            mut width = 8
            if (reg & 3) == 2 {
                width = 4
            }
            return mem_word(load: not store, :width, :reg, base: regalloc.FP, :at, :vreg_phys)
        }
        .Mov(dst, src) -> return move_word(dst, :src, :vreg_phys)
        .Mem(load, width, reg, base, at) -> return mem_word(:load, :width, :reg, :base, :at, :vreg_phys)
        .Op(op, a, b, c, d, _flags) -> return op_word(op, :a, :b, :c, :d, :vreg_phys)
        .Pair(load, a, b, base, mode) -> {
            let t = zr_num(a, :vreg_phys)
            let t2 = zr_num(b, :vreg_phys)
            let n = sp_num(base, :vreg_phys)
            if t < 0 or t2 < 0 or n < 0 {
                return -1
            }
            mut word = 0
            mut off = 0
            match mode {
                .At(at) -> {
                    word = 0xA9000000
                    off = at
                }
                .Pre(at) -> {
                    word = 0xA9800000
                    off = at
                }
                .Post(at) -> {
                    word = 0xA8800000
                    off = at
                }
            }
            if off % 8 != 0 or off < -512 or off > 504 {
                return -1
            }
            if load {
                word = word | 0x400000
            }
            return word | ((off / 8) & 0x7f) << 15 | t2 << 10 | n << 5 | t
        }
        else return -1
    }
}

// The word of `mov dst, src` between registers.
func move_word(anon dst: regalloc.Reg, src: regalloc.Reg, vreg_phys: [regalloc.Reg]) -> int64 {
    let pd = phys_reg(dst, :vreg_phys)
    let ps = phys_reg(src, :vreg_phys)
    if pd == regalloc.SP or ps == regalloc.SP {
        // `add d, n, #0`, where 31 is sp.
        let d = sp_num(dst, :vreg_phys)
        let n = sp_num(src, :vreg_phys)
        if d < 0 or n < 0 {
            return -1
        }
        return 0x91000000 | n << 5 | d
    }
    let d = zr_num(dst, :vreg_phys)
    let m = zr_num(src, :vreg_phys)
    if d < 0 or m < 0 {
        return -1
    }
    // `orr d, xzr, m`.
    return 0xAA0003E0 | m << 16 | d
}

// The word of a load or store, or -1.
func mem_word(load: bool, width: int64, reg: regalloc.Reg, base: regalloc.Reg, at: regalloc.MemAt, vreg_phys: [regalloc.Reg]) -> int64 {
    mut t = -1
    mut size = 3
    if width == 8 {
        t = zr_num(reg, :vreg_phys)
    } else {
        t = w_num(reg, :vreg_phys)
        if width == 4 {
            size = 2
        } else if width == 2 {
            size = 1
        } else if width == 1 {
            size = 0
        } else {
            return -1
        }
    }
    let n = sp_num(base, :vreg_phys)
    if t < 0 or n < 0 {
        return -1
    }
    mut opc = 0
    if load {
        opc = 1
    }
    let head = size << 30 | opc << 22 | n << 5 | t
    mut off = 0
    match at {
        .Base -> off = 0
        .Offset(o) -> off = o
        .Index(index, scaled) -> {
            let m = zr_num(index, :vreg_phys)
            if m < 0 or m == 31 {
                return -1
            }
            // `[n, m]`: the register form, LSL #0, or with S set, shifted
            // by the access size.
            mut s = 0
            if scaled and width > 1 {
                s = 0x1000
            }
            return 0x38206800 | head | m << 16 | s
        }
        .Symbol(_name, _got) -> return -1
    }
    let scale = 1 << size
    if off >= 0 and off % scale == 0 and off / scale < 4096 {
        return 0x39000000 | head | (off / scale) << 10
    }
    if off >= -256 and off <= 255 {
        // ldur/stur.
        return 0x38000000 | head | (off & 0x1ff) << 12
    }
    return -1
}

// The word of an `Op`, or -1.
func op_word(anon op: regalloc.Opcode, a: regalloc.Reg, b: regalloc.Reg, c: regalloc.Reg, d: regalloc.Reg, vreg_phys: [regalloc.Reg]) -> int64 {
    match op {
        .Return -> {
            if a == regalloc.NO_REG {
                return 0xD65F03C0
            }
            return -1
        }
        .CallIndirect -> {
            let n = zr_num(a, :vreg_phys)
            if n < 0 or n == 31 or b != regalloc.NO_REG {
                return -1
            }
            return 0xD63F0000 | n << 5
        }
        .Move -> {
            if c != regalloc.NO_REG {
                return -1
            }
            if imm_of(b) is Some(v) {
                let rd = zr_num(a, :vreg_phys)
                if rd < 0 {
                    return -1
                }
                if v >= 0 and v <= 65535 {
                    return 0xD2800000 | v << 5 | rd
                }
                if v < 0 and v >= -65536 {
                    return 0x92800000 | (0 - v - 1) << 5 | rd
                }
                return -1
            }
            return move_word(a, src: b, :vreg_phys)
        }
        .SetIf -> {
            let rd = zr_num(a, :vreg_phys)
            if rd < 0 or c != regalloc.NO_REG {
                return -1
            }
            if regalloc.cond_named(regalloc.reg_text(b)) is Some(cond) {
                return 0x9A9F07E0 | (cond_code(cond) ^ 1) << 12 | rd
            }
            return -1
        }
        .Select -> {
            let rd = zr_num(a, :vreg_phys)
            let rn = zr_num(b, :vreg_phys)
            let rm = zr_num(c, :vreg_phys)
            if rd < 0 or rn < 0 or rm < 0 {
                return -1
            }
            if regalloc.cond_named(regalloc.reg_text(d)) is Some(cond) {
                return 0x9A800000 | rm << 16 | cond_code(cond) << 12 | rn << 5 | rd
            }
            return -1
        }
        .Compare -> {
            if c != regalloc.NO_REG {
                return -1
            }
            let v = regalloc.imm_value(b)
            if v >= 0 {
                let rn = sp_num(a, :vreg_phys)
                if rn < 0 or v > 4095 {
                    return -1
                }
                return 0xF100001F | v << 10 | rn << 5
            }
            let rn = zr_num(a, :vreg_phys)
            let rm = zr_num(b, :vreg_phys)
            if rn < 0 or rm < 0 or rn == 31 {
                return -1
            }
            return 0xEB00001F | rm << 16 | rn << 5
        }
        else none
    }
    // Three operands: `a` written from `b` and `c`.
    if d != regalloc.NO_REG or c == regalloc.NO_REG {
        return -1
    }
    let v = regalloc.imm_value(c)
    if v >= 0 {
        match op {
            .Add -> return add_imm_word(0x91000000, :a, :b, :v, :vreg_phys)
            .Sub -> return add_imm_word(0xD1000000, :a, :b, :v, :vreg_phys)
            .ShiftLeft -> {
                let rd = zr_num(a, :vreg_phys)
                let rn = zr_num(b, :vreg_phys)
                if rd < 0 or rn < 0 or v > 63 {
                    return -1
                }
                return 0xD3400000 | ((64 - v) & 63) << 16 | (63 - v) << 10 | rn << 5 | rd
            }
            .ShiftRight -> {
                let rd = zr_num(a, :vreg_phys)
                let rn = zr_num(b, :vreg_phys)
                if rd < 0 or rn < 0 or v > 63 {
                    return -1
                }
                return 0xD340FC00 | v << 16 | rn << 5 | rd
            }
            .ShiftRightSigned -> {
                let rd = zr_num(a, :vreg_phys)
                let rn = zr_num(b, :vreg_phys)
                if rd < 0 or rn < 0 or v > 63 {
                    return -1
                }
                return 0x9340FC00 | v << 16 | rn << 5 | rd
            }
            else return -1
        }
    }
    if (op is .Add or op is .Sub) and (phys_reg(a, :vreg_phys) == regalloc.SP or phys_reg(b, :vreg_phys) == regalloc.SP) {
        // With sp, the extended-register form (uxtx), where 31 is sp.
        let rd = sp_num(a, :vreg_phys)
        let rn = sp_num(b, :vreg_phys)
        let rm = zr_num(c, :vreg_phys)
        if rd < 0 or rn < 0 or rm < 0 {
            return -1
        }
        mut base = 0x8B206000
        if op is .Sub {
            base = 0xCB206000
        }
        return base | rm << 16 | rn << 5 | rd
    }
    let rd = zr_num(a, :vreg_phys)
    let rn = zr_num(b, :vreg_phys)
    let rm = zr_num(c, :vreg_phys)
    if rd < 0 or rn < 0 or rm < 0 {
        return -1
    }
    let regs = rm << 16 | rn << 5 | rd
    match op {
        .Add -> return 0x8B000000 | regs
        .Sub -> return 0xCB000000 | regs
        .Mul -> return 0x9B007C00 | regs
        .DivSigned -> return 0x9AC00C00 | regs
        .And -> return 0x8A000000 | regs
        .Or -> return 0xAA000000 | regs
        .Xor -> return 0xCA000000 | regs
        .ShiftLeft -> return 0x9AC02000 | regs
        .ShiftRight -> return 0x9AC02400 | regs
        .ShiftRightSigned -> return 0x9AC02800 | regs
        else return -1
    }
}

// `add` or `sub` (`base`) of an immediate up to 4095, where 31 is sp.
func add_imm_word(anon base: int64, a: regalloc.Reg, b: regalloc.Reg, v: int64, vreg_phys: [regalloc.Reg]) -> int64 {
    let rd = sp_num(a, :vreg_phys)
    let rn = sp_num(b, :vreg_phys)
    if rd < 0 or rn < 0 or v > 4095 {
        return -1
    }
    return base | v << 10 | rn << 5 | rd
}

// Starts the line of an instruction `encode` has a word for: `.inst` and the
// word, then a comment, which the instruction's text goes on to fill.
func write_word(anon insn: regalloc.Insn, vreg_phys: [regalloc.Reg], out: StrBuilder) -> none {
    let word = encode(insn, :vreg_phys)
    if word < 0 {
        return none
    }
    write_hex_word(word, :out)
}

// `.inst` and `word`, then a comment that the instruction's text fills.
func write_hex_word(anon word: int64, out: StrBuilder) -> none {
    out.append("\t.inst 0x")
    mut shift = 28
    for shift >= 0 {
        out.append_byte(HEX_DIGITS[(word >> shift) & 15])
        shift -= 4
    }
    out.append(" //")
}

let HEX_DIGITS: str = "0123456789abcdef"

// ── Instructions given as text ──────────────────────────────────────────────

// In text, `w5` is a register, not a vreg: reg_of reads it as vreg 5's 32-bit
// form, so text is encoded with vreg n in xn.
mut TEXT_PHYS: [regalloc.Reg] = text_phys()

func text_phys() -> [regalloc.Reg] {
    mut regs: [regalloc.Reg] = []
    for n in 0..31 {
        regs += [regalloc.reg_of(f"x{n}")]
    }
    return regs
}

// The word `as` assembles one instruction line to (`\tmov x0, #1`), for the
// lines that reach the output as text: the inlined runtime functions, a large
// constant's `mov` and `movk`s, and lines codegen writes as text. -1 for a line
// with a label or a symbol, or a form this doesn't know.
func encode_text(anon line: str) -> int64 {
    let text = line.trim()
    mut space = len(text)
    for k in 0..len(text) {
        if text[k] == ' ' {
            space = k
            break
        }
    }
    let mn = text[0..space]
    let ops = operands(text[space..len(text)])
    let none_phys = TEXT_PHYS
    match mn {
        "ret" -> return word_of(regalloc.op(.Return), ops, count: 0)
        "mov" -> {
            if len(ops) != 2 {
                return -1
            }
            if imm_text(ops[1]) is Some(v) {
                return op_word(.Move, a: regalloc.reg_of(ops[0]), b: imm_reg(v), c: regalloc.NO_REG, d: regalloc.NO_REG, vreg_phys: none_phys)
            }
            return move_word(regalloc.reg_of(ops[0]), src: regalloc.reg_of(ops[1]), vreg_phys: none_phys)
        }
        "movk" -> {
            let rd = gp_text(ops, 0)
            if len(ops) != 3 or rd < 0 or not ops[2].starts_with("lsl #") {
                return -1
            }
            if imm_text(ops[1]) is Some(v) {
                if imm_text(ops[2][4..len(ops[2])]) is Some(shift) {
                    if v >= 0 and v <= 65535 and shift % 16 == 0 and shift <= 48 {
                        return 0xF2800000 | (shift / 16) << 21 | v << 5 | rd
                    }
                }
            }
            return -1
        }
        "add" | "sub" | "mul" | "sdiv" | "orr" | "lsl" | "lsr" | "cmp" | "cset" | "csel" | "blr" -> {
            mut regs: [regalloc.Reg] = [regalloc.NO_REG, regalloc.NO_REG, regalloc.NO_REG, regalloc.NO_REG]
            if len(ops) > 4 {
                return -1
            }
            for k, operand in ops {
                if imm_text(operand) is Some(v) {
                    regs[k] = imm_reg(v)
                } else {
                    regs[k] = regalloc.reg_of(operand)
                }
            }
            if opcode_of(mn) is Some(op) {
                return op_word(op, a: regs[0], b: regs[1], c: regs[2], d: regs[3], vreg_phys: none_phys)
            }
            return -1
        }
        "and" | "eor" -> {
            let rd = gp_text(ops, 0)
            let rn = gp_text(ops, 1)
            if len(ops) != 3 or rd < 0 or rn < 0 {
                return -1
            }
            if imm_text(ops[2]) is Some(v) {
                let fields = bitmask_imm(v)
                if fields < 0 {
                    return -1
                }
                mut base = 0x92000000
                if mn == "eor" {
                    base = 0xD2000000
                }
                return base | fields << 10 | rn << 5 | rd
            }
            let rm = gp_text(ops, 2)
            if rm < 0 {
                return -1
            }
            mut base = 0x8A000000
            if mn == "eor" {
                base = 0xCA000000
            }
            return base | rm << 16 | rn << 5 | rd
        }
        "asr" -> {
            let rd = gp_text(ops, 0)
            let rn = gp_text(ops, 1)
            if len(ops) == 3 and rd >= 0 and rn >= 0 {
                if imm_text(ops[2]) is Some(v) {
                    if v >= 0 and v <= 63 {
                        return 0x9340FC00 | v << 16 | rn << 5 | rd
                    }
                }
            }
            return -1
        }
        "umulh" -> return three_gp(0x9BC07C00, ops)
        "clz" -> return two_gp(0xDAC01000, ops)
        "rbit" -> return two_gp(0xDAC00000, ops)
        "ccmp" -> {
            let rn = gp_text(ops, 0)
            let rm = gp_text(ops, 1)
            if len(ops) != 4 or rn < 0 or rm < 0 {
                return -1
            }
            if imm_text(ops[2]) is Some(nzcv) {
                if regalloc.cond_named(ops[3]) is Some(cond) {
                    if nzcv >= 0 and nzcv <= 15 {
                        return 0xFA400000 | rm << 16 | cond_code(cond) << 12 | rn << 5 | nzcv
                    }
                }
            }
            return -1
        }
        "fmov" -> {
            if len(ops) != 2 {
                return -1
            }
            let dd = reg_digits(ops[0], prefix: 'd')
            let dn = reg_digits(ops[1], prefix: 'd')
            if dd >= 0 and gp_text(ops, 1) >= 0 {
                return 0x9E670000 | gp_text(ops, 1) << 5 | dd
            }
            if dn >= 0 and gp_text(ops, 0) >= 0 {
                return 0x9E660000 | dn << 5 | gp_text(ops, 0)
            }
            return -1
        }
        "fcmp" -> {
            let dn = fp_text(ops, 0)
            let dm = fp_text(ops, 1)
            if len(ops) != 2 or dn < 0 or dm < 0 {
                return -1
            }
            return 0x1E602000 | dm << 16 | dn << 5
        }
        "fneg" -> return two_fp(0x1E614000, ops)
        "fabs" -> return two_fp(0x1E60C000, ops)
        "fsqrt" -> return two_fp(0x1E61C000, ops)
        "frintm" -> return two_fp(0x1E654000, ops)
        "frintp" -> return two_fp(0x1E64C000, ops)
        "frinta" -> return two_fp(0x1E664000, ops)
        "fadd" -> return three_fp(0x1E602800, ops)
        "fsub" -> return three_fp(0x1E603800, ops)
        "fmul" -> return three_fp(0x1E600800, ops)
        "fdiv" -> return three_fp(0x1E601800, ops)
        "scvtf" -> {
            let dd = fp_text(ops, 0)
            let rn = gp_text(ops, 1)
            if len(ops) != 2 or dd < 0 or rn < 0 {
                return -1
            }
            return 0x9E620000 | rn << 5 | dd
        }
        "fcvtzs" -> {
            let rd = gp_text(ops, 0)
            let dn = fp_text(ops, 1)
            if len(ops) != 2 or rd < 0 or dn < 0 {
                return -1
            }
            return 0x9E780000 | dn << 5 | rd
        }
        "cnt" -> {
            if len(ops) == 2 and ops[0] == "v0.8b" and ops[1] == "v0.8b" {
                return 0x0E205800
            }
            return -1
        }
        "addv" -> {
            if len(ops) == 2 and ops[0] == "b0" and ops[1] == "v0.8b" {
                return 0x0E31B800
            }
            return -1
        }
        "ldr" | "str" | "ldrb" | "strb" | "ldrh" | "strh" | "ldrsw" | "ldrsb" -> return load_store_text(mn, :ops)
        "ldp" | "stp" -> {
            if len(ops) < 3 {
                return -1
            }
            let a = regalloc.reg_of(ops[0])
            let b = regalloc.reg_of(ops[1])
            let addr = ops[2]
            if not addr.starts_with("[") {
                return -1
            }
            mut mode: regalloc.PairMode = .At(off: 0)
            let base_text = addr_base(addr)
            if len(ops) == 4 {
                // `[base], #off`: after.
                if imm_text(ops[3]) is Some(v) {
                    mode = .Post(off: v)
                } else {
                    return -1
                }
            } else if addr_offset(addr) is Some(v) {
                if addr.ends_with("!") {
                    mode = .Pre(off: v)
                } else {
                    mode = .At(off: v)
                }
            }
            return encode(.Pair(load: mn == "ldp", :a, :b, base: regalloc.reg_of(base_text), :mode), vreg_phys: none_phys)
        }
        else return -1
    }
}

// A load or store given as text.
func load_store_text(anon mn: str, ops: [str]) -> int64 {
    if len(ops) != 2 or not ops[1].starts_with("[") or ops[1].ends_with("!") {
        return -1
    }
    let none_phys = TEXT_PHYS
    let base = regalloc.reg_of(addr_base(ops[1]))
    let n = sp_num(base, vreg_phys: none_phys)
    if n < 0 {
        return -1
    }
    let index_text = addr_index(ops[1])
    // `[base, index, lsl #k]`: the index scaled by the access size.
    let parts = operands(addr_inner(ops[1]))
    mut shifted = false
    if len(parts) == 3 {
        if not parts[2].starts_with("lsl #") {
            return -1
        }
        shifted = true
    }
    mut off: int64 = 0
    if len(index_text) == 0 {
        if addr_offset(ops[1]) is Some(v) {
            off = v
        } else if ops[1] != f"[{addr_base(ops[1])}]" {
            return -1
        }
    }
    let load = mn.starts_with("ldr")
    // A float register: b, h, s or d, by its size.
    let fp_sizes = "bhsd"
    for size in 0..4 {
        let t = reg_digits(ops[0], prefix: fp_sizes[size])
        if t >= 0 and (mn == "ldr" or mn == "str") and len(index_text) == 0 {
            let scale = 1 << size
            if off < 0 or off % scale != 0 or off / scale >= 4096 {
                return -1
            }
            mut opc = 0
            if load {
                opc = 1
            }
            return 0x3D000000 | size << 30 | opc << 22 | (off / scale) << 10 | n << 5 | t
        }
    }
    if mn == "ldrsw" or mn == "ldrsb" {
        let t = gp_text(ops, 0)
        if t < 0 or len(index_text) > 0 {
            return -1
        }
        mut size = 2
        if mn == "ldrsb" {
            size = 0
        }
        let scale = 1 << size
        if off < 0 or off % scale != 0 or off / scale >= 4096 {
            return -1
        }
        // opc 10: sign-extend to 64 bits.
        return 0x39000000 | size << 30 | 2 << 22 | (off / scale) << 10 | n << 5 | t
    }
    let reg = regalloc.reg_of(ops[0])
    mut width = regalloc.reg_width(reg)
    if mn.ends_with("b") {
        width = 1
    } else if mn.ends_with("h") {
        width = 2
    }
    mut at: regalloc.MemAt = .Offset(:off)
    if len(index_text) > 0 {
        at = .Index(reg: regalloc.reg_of(index_text), scaled: false)
    }
    let word = mem_word(:load, :width, :reg, :base, :at, vreg_phys: none_phys)
    if shifted and word >= 0 {
        // Only by the access size: `lsl #3` for 8 bytes.
        if imm_text(parts[2][4..len(parts[2])]) is Some(k) {
            if 1 << k == width and width > 1 {
                return word | 0x1000
            }
        }
        return -1
    }
    return word
}

// The operands of an instruction, split at the commas outside brackets.
func operands(anon rest: str) -> [str] {
    mut ops: [str] = []
    mut depth = 0
    mut start = 0
    for k in 0..len(rest) {
        let c = rest[k]
        if c == '[' or c == '(' {
            depth += 1
        } else if c == ']' or c == ')' {
            depth -= 1
        } else if c == ',' and depth == 0 {
            ops += [rest[start..k].trim()]
            start = k + 1
        }
    }
    let last = rest[start..len(rest)].trim()
    if len(last) > 0 {
        ops += [last]
    }
    return ops
}

// The base register of `[base, ...]`.
func addr_base(anon addr: str) -> str {
    mut end = 1
    for end < len(addr) and addr[end] != ',' and addr[end] != ']' {
        end += 1
    }
    return addr[1..end].trim()
}

// The offset of `[base, #off]` (with or without `!`), or none.
func addr_offset(anon addr: str) -> int64? {
    let parts = operands(addr_inner(addr))
    if len(parts) == 2 {
        return imm_text(parts[1])
    }
    return none
}

// The index register of `[base, index]` (or `[base, index, lsl #k]`), or "".
func addr_index(anon addr: str) -> str {
    let parts = operands(addr_inner(addr))
    if len(parts) >= 2 and not parts[1].starts_with("#") {
        return parts[1]
    }
    return ""
}

// What is between the brackets of an address.
func addr_inner(anon addr: str) -> str {
    mut end = len(addr)
    for k in 0..len(addr) {
        if addr[k] == ']' {
            end = k
            break
        }
    }
    return addr[1..end]
}

// The value of an immediate operand as the compiler writes them: `#12`,
// `#-12`, `#0xff`, `#(N & 0xffff)` or `#((N >> S) & 0xffff)`; none otherwise.
func imm_text(anon op: str) -> int64? {
    if len(op) < 2 or op[0] != '#' {
        return none
    }
    let body = op[1..len(op)]
    if body.starts_with("((") and body.ends_with(" & 0xffff)") {
        // ((N >> S) & 0xffff)
        let inner = body[2..len(body) - 10]
        let parts = inner.split(" >> ")
        if len(parts) == 2 and parts[1].ends_with(")") {
            if number_text(parts[0]) is Some(n) {
                if number_text(parts[1][0..len(parts[1]) - 1]) is Some(shift) {
                    return (n >> shift) & 0xffff
                }
            }
        }
        return none
    }
    if body.starts_with("(") and body.ends_with(" & 0xffff)") {
        if number_text(body[1..len(body) - 10]) is Some(n) {
            return n & 0xffff
        }
        return none
    }
    return number_text(body)
}

// A decimal number (maybe negative) or `0x` hex, as an int64; none otherwise.
func number_text(anon s: str) -> int64? {
    if len(s) == 0 {
        return none
    }
    mut negative = false
    mut k = 0
    if s[0] == '-' {
        negative = true
        k = 1
    }
    if k >= len(s) {
        return none
    }
    mut v: int64 = 0
    if len(s) - k > 2 and s[k] == '0' and s[k + 1] == 'x' {
        for i in k + 2..len(s) {
            let c = s[i]
            mut d = -1
            if c >= '0' and c <= '9' {
                d = c - '0'
            } else if c >= 'a' and c <= 'f' {
                d = c - 'a' + 10
            }
            if d < 0 {
                return none
            }
            v = v * 16 + d
        }
    } else {
        for i in k..len(s) {
            let c = s[i]
            if c < '0' or c > '9' {
                return none
            }
            // Down from zero, so the smallest int64 fits.
            v = v * 10 - (c - '0')
        }
        if not negative {
            v = 0 - v
        }
        return v
    }
    if negative {
        return 0 - v
    }
    return v
}

// An immediate as an operand `encode` reads: `#v`, or `#-v` by name.
func imm_reg(anon v: int64) -> regalloc.Reg {
    if v >= 0 {
        return regalloc.imm(v)
    }
    return regalloc.reg_of(f"#{v}")
}

// The opcode of the mnemonics encode_text hands to op_word.
func opcode_of(anon mn: str) -> regalloc.Opcode? {
    match mn {
        "add" -> return .Add
        "sub" -> return .Sub
        "mul" -> return .Mul
        "sdiv" -> return .DivSigned
        "orr" -> return .Or
        "lsl" -> return .ShiftLeft
        "lsr" -> return .ShiftRight
        "asr" -> return .ShiftRightSigned
        "cmp" -> return .Compare
        "cset" -> return .SetIf
        "csel" -> return .Select
        "blr" -> return .CallIndirect
        else return none
    }
}

// The number of the general register operand `k` names (31 for xzr), or -1.
func gp_text(anon ops: [str], anon k: int64) -> int64 {
    if k >= len(ops) {
        return -1
    }
    let none_phys = TEXT_PHYS
    return zr_num(regalloc.reg_of(ops[k]), vreg_phys: none_phys)
}

// The number of the d register operand `k` names, or -1.
func fp_text(anon ops: [str], anon k: int64) -> int64 {
    if k >= len(ops) {
        return -1
    }
    return reg_digits(ops[k], prefix: 'd')
}

func two_gp(anon base: int64, anon ops: [str]) -> int64 {
    let rd = gp_text(ops, 0)
    let rn = gp_text(ops, 1)
    if len(ops) != 2 or rd < 0 or rn < 0 {
        return -1
    }
    return base | rn << 5 | rd
}

func three_gp(anon base: int64, anon ops: [str]) -> int64 {
    let rd = gp_text(ops, 0)
    let rn = gp_text(ops, 1)
    let rm = gp_text(ops, 2)
    if len(ops) != 3 or rd < 0 or rn < 0 or rm < 0 {
        return -1
    }
    return base | rm << 16 | rn << 5 | rd
}

func two_fp(anon base: int64, anon ops: [str]) -> int64 {
    let dd = fp_text(ops, 0)
    let dn = fp_text(ops, 1)
    if len(ops) != 2 or dd < 0 or dn < 0 {
        return -1
    }
    return base | dn << 5 | dd
}

func three_fp(anon base: int64, anon ops: [str]) -> int64 {
    let dd = fp_text(ops, 0)
    let dn = fp_text(ops, 1)
    let dm = fp_text(ops, 2)
    if len(ops) != 3 or dd < 0 or dn < 0 or dm < 0 {
        return -1
    }
    return base | dm << 16 | dn << 5 | dd
}

// `insn`'s word if `ops` has `count` operands, else -1.
func word_of(anon insn: regalloc.Insn, anon ops: [str], count: int64) -> int64 {
    if len(ops) != count {
        return -1
    }
    let none_phys = TEXT_PHYS
    return encode(insn, vreg_phys: none_phys)
}

// The N:immr:imms fields (13 bits) of a 64-bit logical immediate, or -1 for a
// value that has none (0, all ones, or not a rotated run of ones repeated).
func bitmask_imm(anon v: int64) -> int64 {
    if v == 0 or v == -1 {
        return -1
    }
    // The smallest element size the value repeats at.
    mut size = 64
    for size > 2 {
        let half = size / 2
        let mask = (1 << half) - 1
        if (v & mask) != ((v >> half) & mask) {
            break
        }
        size = half
    }
    mut elt = v
    if size < 64 {
        elt = v & ((1 << size) - 1)
    }
    let ones = elt.count_ones()
    mut run = -1
    if ones < 64 {
        run = (1 << ones) - 1
    }
    // The rotation right of `run` that gives `elt`.
    for r in 0..size {
        if rotate_right(run, r, size) == elt {
            mut n = 0
            if size == 64 {
                n = 1
            }
            let imms = ((0 - size) << 1 | (ones - 1)) & 0x3f
            return n << 12 | r << 6 | imms
        }
    }
    return -1
}

// `x` rotated right by `r` within its low `size` bits.
func rotate_right(anon x: int64, anon r: int64, anon size: int64) -> int64 {
    if r == 0 {
        return x
    }
    if size == 64 {
        return (x >> r) & ((1 << (64 - r)) - 1) | x << (64 - r)
    }
    let mask = (1 << size) - 1
    return ((x >> r) | (x << (size - r))) & mask
}
