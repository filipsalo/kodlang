// A downcast names a module only where no local of that name is bound,
// and it binds one name.
import "./downcast_qualified_dep"

func by_local(anon e: Error) -> bool {
    let downcast_qualified_dep = 3
    if e is downcast_qualified_dep.NotFound(nf) {
        return true
    }
    return downcast_qualified_dep > 2
}

func by_param(anon e: Error, downcast_qualified_dep: int64) -> int64 {
    match e {
        downcast_qualified_dep.NotFound(nf) -> return 1
        else -> return downcast_qualified_dep
    }
}

func by_value(anon e: Error) -> bool {
    let downcast_qualified_dep = 3
    return e is downcast_qualified_dep.NotFound
}

func two(anon e: Error) -> int64 {
