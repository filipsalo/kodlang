// Basic if statements
test "if and else run the right branches" {
    mut ran: [str] = []
    if true {
        ran += ["You should see this"]
        if false {
            fail("But not this")
        } else {
            ran += ["And this"]
        }
    } else {
        fail("But not this")
    }
    assert ran == ["You should see this", "And this"]
}
