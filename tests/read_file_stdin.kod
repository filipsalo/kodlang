// Echo stdin via io.read_file("/dev/stdin"), prefixed by its length.
// Driven with piped input by test_read_file_pipe in examples_test.py.
import "io"

func main() -> int64 {
    let data: str = io.read_file("/dev/stdin")
    print_int(len(data))
    print(data)
    return 0
}

