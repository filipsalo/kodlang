// `kod test` runs each test in a process of its own (docs/testing.md).

import "process"

// The words of `s`, split on runs of spaces.
func words(anon s: str) -> [str] {
    mut out: [str] = []
    for w in s.split(" ") {
        if w != "" {
            out += [w]
        }
    }
    return out
}

test "a panic or a crash fails only its test" {
    let r = process.run(["build/apps/kod/kod", "test", "tests/support/crashing_tests.kod"])
    if r.status != 1 {
        fail(f"status {r.status}\n{r.stdout}{r.stderr}")
    }
    mut results: [str] = []
    for line in r.stdout.split("\n") {
        if line.starts_with("  ") {
            let ws = words(line)
            results += [f"{ws[0]} {ws[1]}"]
        }
    }
    if results != ["FAIL fails", "FAIL panics", "FAIL crashes", "ok runs"] {
        fail(f"results {", ".join(results)}\n{r.stdout}")
    }
    assert r.stdout.contains("1/4 passed")
    assert r.stderr.contains("assertion failed: 1 == 2")
    assert r.stderr.contains("panic: index 5 out of bounds")
    assert r.stderr.contains("#0  test \"panics\"")
    assert r.stderr.contains("killed by SIGSEGV")
}
