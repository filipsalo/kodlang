// An argv main declared with an alias of `T or Error` exits with its value.
type Exit = int64 or Error

func count(anon args: [str]) -> Exit {
    return len(args) + 4
}

func main(argv: [str]) -> Exit {
    let n = try count(argv)
    print(f"count {n}")
    return n
}

// expected output:
// count 5
// expected status:
// 5
