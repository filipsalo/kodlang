// An index key that is converted for its slot (an enum constructor, a
// call boxed into an interface or optional key) keeps its value while the
// indexed value is computed.

type Color = enum {
    Red
    Green
    Blue
}

interface Shape {
    func area(self) -> int64
}

type Sq = struct {
    s: int64

    func area(self) -> int64 {
        return self.s * self.s
    }
}

type Palette = struct {
    names: [str]

    func op_index(self, anon c: Color) -> str {
        match c {
            .Red -> return self.names[0]
            .Green -> return self.names[1]
            .Blue -> return self.names[2]
        }
    }

    func op_index_set(self, anon c: Color, anon name: str) -> none {
        match c {
            .Red -> self.names[0] = name
            .Green -> self.names[1] = name
            .Blue -> self.names[2] = name
        }
    }
}

type Board = struct {
    base: int64

    func op_index(self, anon s: Shape) -> int64 {
        return self.base + s.area()
    }
}

type Opt = struct {
    base: int64

    func op_index(self, anon n: int64?) -> int64 {
        return self.base + (n? or 0)
    }
}

func mk(anon s: int64) -> Shape {
    return Sq(:s)
}

func mo(anon n: int64) -> int64? {
    return n
}

func main() -> int64 {
    let cm = Map[Color, int64]()
    cm[Color.Red] = 1
    cm[.Green] = 2
    let c = Color.Blue
    cm[c] = 3
    print_int(cm[.Red]? or -1)
    print_int(cm[Color.Green]? or -1)
    print_int(cm[c]? or -1)
    print_int(len(cm))

    let p = Palette(names: ["r", "g", "b"])
    p[.Blue] = "B"
    print(p[.Green])
    print(p[Color.Blue])

    let b = Board(base: 1000)
    print_int(b[mk(3)])
    let o = Opt(base: 100)
    print_int(o[mo(5)])
    print_int(o[7])
    return 0
}

// expected output:
// 1
// 2
// 3
// 3
// g
// B
// 1009
// 105
// 107
