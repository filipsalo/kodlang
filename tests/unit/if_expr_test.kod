// `if` as a value (docs/control-flow.md#if-as-a-value).

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
}

type Bad = struct {
    func to_str(self) -> str {
        return "bad"
    }
}

interface Named {
    func name(self) -> str
}

type Dog = struct {
    func name(self) -> str {
        return "dog"
    }
}

type Cat = struct {
    func name(self) -> str {
        return "cat"
    }
}

func sign(anon n: int64) -> str {
    return if n < 0 { "negative" } else if n == 0 { "zero" } else { "positive" }
}

test "the value of the branch that runs" {
    assert sign(-3) == "negative" and sign(0) == "zero" and sign(9) == "positive"
    let n = 5
    let f: float64 = if n > 1 { 1.5 } else { 2.5 }
    assert f == 1.5
    assert (if n > 9 { 1 } else { 2 }) == 2
    let xs = [if n > 1 { 1 } else { 2 }, if n > 9 { 3 } else { 4 }]
    assert xs == [1, 4] and xs[if n > 1 { 1 } else { 0 }] == 4
    mut total = 1 + if n > 2 { 10 } else { 20 }
    total += if total > 5 { 100 } else { 200 }
    assert total == 111
    assert f"{n} is {if n % 2 == 0 { "even" } else { "odd" }}, {sign(n)}" == "5 is odd, positive"
    assert "<" + if n == 5 { "five" } else { "other" } + ">" == "<five>"
    assert sign(if n > 1 { -1 } else { 1 }) == "negative"
}

mut calls: [str] = []

func noted(anon name: str, value: bool) -> bool {
    calls += [name]
    return value
}

test "only one branch runs, and each part of the condition at most once" {
    calls = []
    let a = if noted("a", value: false) and noted("b", value: true) { noted("c", value: true) } else { noted("d", value: false) }
    assert not a and calls == ["a", "d"]
    calls = []
    let b = if noted("a", value: true) or noted("b", value: true) { noted("c", value: true) } else { noted("d", value: false) }
    assert b and calls == ["a", "c"]
}

func early(anon n: int64) -> int64 {
    let x = if n > 0 {
        let d = n * 2
        d + 1
    } else if n == 0 {
        if n == 0 { 100 } else { 200 }
    } else {
        return -5
    }
    return x
}

func parsed(anon s: str) -> int64 or Error {
    return if s == "a" { 1 } else if s == "b" { try parsed("a") } else { throw Bad() }
}

func small(anon n: int64) -> int64 {
    return if n < 10 { n } else { panic("too large") }
}

test "branches of several statements, and those that leave" {
    assert early(4) == 9 and early(0) == 100 and early(-1) == -5
    assert must parsed("a") == 1 and must parsed("b") == 1
    assert parsed("c") is Err(_)
    assert small(3) == 3
}

test "an `if` at the end of a match's arm is the arm's value" {
    for n in 0..3 {
        let text = match n {
            0 -> {
                let k = n + 1
                if k == 1 { "one" } else { "none" }
            }
            else -> {
                if n == 1 {
                    "two"
                } else {
                    "three"
                }
            }
        }
        assert text == ["one", "two", "three"][n]
    }
}

func opt(anon b: bool) -> str? {
    return if b { "x" } else { none }
}

func pet(anon b: bool) -> Named {
    return if b { Dog() } else { Cat() }
}

test "the branches convert as a match's arms do" {
    assert (opt(true)? or "-") == "x" and opt(false) is none
    let o = if early(1) == 3 { 4 } else { none }
    assert (o? or 0) == 4
    assert pet(true).name() == "dog" and pet(false).name() == "cat"
    let s: Shape = if early(1) == 3 { .Circle(r: 2) } else { .Rect(w: 1, h: 1) }
    assert s is .Circle(_)
    let e: [int64] = if early(1) == 3 { [] } else { [1] }
    assert len(e) == 0
}

func area(anon s: Shape) -> int64 {
    return if s is .Rect(w, h) and w > 0 { w * h } else { -1 }
}

func num(anon s: str) -> int64 {
    return if s.parse_int() is int64(n) and n > 5 { n } else if s == "x" { 99 } else { 0 }
}

func product(anon o: int64?, anon p: int64?, anon q: int64?) -> int64 {
    return if o is not none and p is Some(y) and q is not none and q > 1 { o * y * q } else { -1 }
}

func after(anon o: int64?) -> int64 {
    return if o is none { -1 } else { o + 1 }
}

func text_of(anon v: int64 | str) -> str {
    return if v is int64 { (v + 1).to_str() } else if v is str { v + "!" } else { "?" }
}

func said(anon r: int64 or Error) -> str {
    return if r is Err(e) { e.to_str() } else if r is Ok(n) { f"{n}" } else { "" }
}

func either(anon r: int64 or Error) -> int64 {
    return if r is not Err(_) { 1 } else { 0 }
}

test "conditions bind names and narrow them" {
    assert area(.Rect(w: 2, h: 3)) == 6 and area(.Rect(w: 0, h: 3)) == -1 and area(.Circle(r: 1)) == -1
    assert num("7") == 7 and num("3") == 0 and num("x") == 99 and num("") == 0
    assert product(2, 3, 4) == 24 and product(none, 3, 4) == -1 and product(2, none, 4) == -1
    assert product(2, 3, none) == -1 and product(2, 3, 1) == -1
    assert after(4) == 5 and after(none) == -1
    assert text_of(4) == "5" and text_of("a") == "a!"
    assert said(parsed("a")) == "1" and said(parsed("c")) == "bad"
    assert either(parsed("a")) == 1 and either(parsed("c")) == 0
    // A binding is the branch's own.
    let n = "outer"
    let m = if num("7") is 7 { n } else { "" }
    assert m == "outer"
}

test "in closures, loops and arguments" {
    let pick = func(anon b: bool) -> str {
        return if b { "yes" } else { "no" }
    }
    assert pick(true) == "yes" and pick(false) == "no"
    mut out = ""
    for i in 0..5 {
        out += if i % 2 == 0 { f"{i}" } else { "-" }
    }
    assert out == "0-2-4"
    mut k = 0
    for k < (if out == "0-2-4" { 3 } else { 1 }) {
        k += 1
    }
    assert k == 3
}

extern func rc_live_bytes() -> int64

func made(anon i: int64) -> str {
    return f"v{i}"
}

func long(anon s: str) -> bool {
    return len(s) > 2
}

func work(anon i: int64, anon flag: bool) -> int64 {
    let a = if long(made(i) + "x") { made(i + 1) } else { made(i) + made(i) }
    let o = if i % 3 == 0 { none } else { made(i) }
    let b = if o is Some(v) and long(v) { v + a } else { a }
    let f = f"{made(i)} {if flag and long(made(i)) { a + made(3) } else { made(i) }} {if long(made(i)) { a } else { b }}"
    let c = if flag {
        let z = made(i) + "!"
        z + z
    } else if i % 7 == 0 {
        if long(a) { a } else { b }
    } else {
        b
    }
    let xs = [made(i), if flag { made(1) } else { "x" }, made(2)]
    return len(a) + len(b) + len(f) + len(c) + len(xs)
}

test "what the branches and conditions make is given up" {
    mut n = 0
    for i in 0..100 {
        n += work(i, i % 2 == 0)
    }
    let before = rc_live_bytes()
    for i in 0..1000 {
        n += work(i % 100, i % 2 == 0)
    }
    assert n > 0
    // Not per round.
    assert rc_live_bytes() - before < 1000
}
