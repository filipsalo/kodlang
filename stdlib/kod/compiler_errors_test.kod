    assert test_support.any_message_contains(errs, needle: "expected `int64`, got `int64?`; unwrap it first")
    assert test_support.any_message_contains(errs, needle: "expected `str`, got `int64`")
    assert test_support.any_message_contains(errs, needle: "expected `Any`, got `bytes`")
}

test "bytes isn't a value of an interface with methods either" {
