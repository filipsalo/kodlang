// What's the same for an array of any type. Elements compare with `==`.

func contains[T](anon xs: [T], anon x: T) -> bool {
    for item in xs {
        if item == x {
            return true
        }
    }
    return false
}

func equal[T](anon a: [T], anon b: [T]) -> bool {
    if len(a) != len(b) {
        return false
    }
    for i, item in a {
        if item != b[i] {
            return false
        }
    }
    return true
}
