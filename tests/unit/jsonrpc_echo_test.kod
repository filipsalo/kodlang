// Read every JSON-RPC message from stdin and echo each body back as a
// framed response. Exits cleanly on EOF. Proves the read+write framing
// round-trips an entire message stream without losing or splitting
// anything, which is the foundation an actual LSP server sits on.
import "jsonrpc"
import "testing"

func echo() -> none {
    for true {
        match jsonrpc.read_message() {
            Some(body) -> jsonrpc.write_message(body)
            none -> return
        }
    }
}

test "echo stops cleanly at the end of input" {
    let r = testing.run(func() { echo() })
    assert r.status == 0
    assert r.stdout == ""
}

test "echo writes each message back framed" {
    let input = "Content-Length: 7\r\n\r\n{\"a\":1}Content-Length: 2\r\n\r\n[]"
    let r = testing.run(func() { echo() }, stdin: input)
    assert r.status == 0
    assert r.stdout == input
}
