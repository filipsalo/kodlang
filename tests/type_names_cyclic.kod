// Two modules that import each other declare types of the same names: each
// module's `Pt`, `Named` and `Shape` stay its own. The dep imports this
// module back, so this module's types register twice; the later copy is the
// one both modules mean.
import "./type_names_cyclic_dep"

interface Named {
    func name(self) -> str
}

type Pt = struct {
    x: int64

    func name(self) -> str {
        return f"main pt {self.x}"
    }
}

type Shape = enum {
    Circle(r: int64)
    Dot
}

func main() -> int64 {
    let boxed: Named = type_names_cyclic_dep.boxed()
    print(f"{boxed is Pt} {boxed is type_names_cyclic_dep.Pt}")
    print(type_names_cyclic_dep.show(Pt(x: 3)))
    print(type_names_cyclic_dep.show_own(type_names_cyclic_dep.Pt(y: 4)))
    let dep_named: type_names_cyclic_dep.Named = Pt(x: 5)
    print(dep_named.name())
    print_int(type_names_cyclic_dep.area(.Dot))
    let s: Shape = .Circle(r: 2)
    print_int(type_names_cyclic_dep.area_main(s))
    let o: type_names_cyclic_dep.Shape = .Circle(r: 2)
    print_int(type_names_cyclic_dep.area(o))
    let m = Map[str, Pt]()
    m["a"] = Pt(x: 8)
    let n = Map[str, type_names_cyclic_dep.Pt]()
    n["a"] = type_names_cyclic_dep.Pt(y: 9)
    print_int(type_names_cyclic_dep.sum(m, n))
    return 0
}

// expected output:
// false true
// main pt 3
// dep pt 4
// main pt 5
// 0
// 10
// 6
// 17
