import "crypto/aesgcm"
import "encoding/hex"

func h(anon s: str) -> bytes {
    return must hex.decode(s)
}

func aead(anon key: str, anon nonce: str, anon plaintext: str, anon aad: str, anon want: str) -> none {
    let sealed = aesgcm.seal(h(plaintext), key: h(key), nonce: h(nonce), aad: h(aad))
    assert hex.encode(sealed) == want
    assert aesgcm.open(sealed, key: h(key), nonce: h(nonce), aad: h(aad)) == h(plaintext)
}

test "FIPS 197 and OpenSSL blocks" {
    let fips128 = aesgcm.encrypt_block(h("00112233445566778899aabbccddeeff"), key: h("000102030405060708090a0b0c0d0e0f"))
    assert hex.encode(fips128) == "69c4e0d86a7b0430d8cdb78070b4c55a"
    let fips256 = aesgcm.encrypt_block(h("00112233445566778899aabbccddeeff"), key: h("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"))
    assert hex.encode(fips256) == "8ea2b7ca516745bfeafc49904b496089"
    assert hex.encode(aesgcm.encrypt_block(h("d08f5dc7512447e3404300026b6e5455"), key: h("82b70eee7f1a5039bef07ec2347f066e"))) == "5313bacca6385e1919724a212b35949f"
    assert hex.encode(aesgcm.encrypt_block(h("9a01ad219eb59cf6a15ef6f15a1d830b"), key: h("94a065685d64c4980bb8d4544a8721a9"))) == "e829af93e0004bfacbc0ff2328299364"
    assert hex.encode(aesgcm.encrypt_block(h("80ec37bc9712dd2e6aaeb94bae8d2f9f"), key: h("b7ce09d6bbc004e7175c643c7decb0b5"))) == "d5b94b7942d2b9b2d0a36eff7adc063d"
    assert hex.encode(aesgcm.encrypt_block(h("d79648e856e8f9a2f58c95f0ce4b39c1"), key: h("a29c5a284c9ef7521829cf1079b080e9d74a1c10fcab6a4243d33656debe4c1e"))) == "e9d7659568b38fd2b2cc5bf2d9898016"
    assert hex.encode(aesgcm.encrypt_block(h("58e6baab485565b9f49028d557d79a8a"), key: h("5bffad5c2dfb8bb820b6119cba8ff88796ae5b05f280a68ced93b6b28cb0d1b3"))) == "13044a9373a2e55a6f08c94c3439f23b"
    assert hex.encode(aesgcm.encrypt_block(h("3abf129a3097ad96b442d6d1bdef4850"), key: h("0e6451e15c705c15f173541b4438a25cf76312d4eeb3c2246879bf00b3cf8ed1"))) == "009af63f3cb22ea76b25cdd61e123ed6"
}

test "GCM specification test cases 2 and 3" {
    aead("00000000000000000000000000000000", "000000000000000000000000", "00000000000000000000000000000000", "", "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf")
    aead("feffe9928665731c6d6a8f9467308308", "cafebabefacedbaddecaf888", "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255", "", "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f59854d5c2af327cd64a62cf35abd2ba6fab4")
}

