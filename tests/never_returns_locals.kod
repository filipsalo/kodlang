// A helper that ends in a method on a local never returns when that
// method doesn't, whatever binds the local: a `let`, a match arm,
// `if … is`, a let-else, or a `let` that binds a parameter again. The
// binding in force at the call decides, and a local that isn't a
// function doesn't hide the builtin `kod_panic`.
type Hard = struct {
    tag: str

    func fail(self, anon msg: str) -> none {
        kod_panic(f"{self.tag}: {msg}")
    }
}

type Soft = struct {
    tag: str

    func fail(self, anon msg: str) -> none {
        print(f"{self.tag}: {msg}")
    }
}

func die_let(anon msg: str) -> none {
    let r = Hard(tag: "let")
    r.fail(msg)
}

func die_arm(anon o: Hard?, anon msg: str) -> none {
    match o {
        Some(r) -> r.fail(msg)
        none -> kod_panic(msg)
    }
}

func die_if_is(anon o: Hard?, anon msg: str) -> none {
    if o is Some(r) {
        r.fail(msg)
    } else {
        kod_panic(msg)
    }
}

func die_let_else(anon o: Hard?, anon msg: str) -> none {
    let .Some(r) = o else { kod_panic(msg) }
    r.fail(msg)
}

func die_rebound(anon r: Soft, anon msg: str) -> none {
    r.fail(msg)
    let r = Hard(tag: "rebound")
    r.fail(msg)
}

func die_outer(anon hide: bool, anon msg: str) -> none {
    let r = Hard(tag: "outer")
    if hide {
        let r = Soft(tag: "inner")
        r.fail(msg)
    }
    r.fail(msg)
}

func die_retyped(anon msg: str) -> none {
    let r = Soft(tag: "first")
    r.fail(msg)
    let r = Hard(tag: "retyped")
    r.fail(msg)
}

func die_named(anon msg: str) -> none {
    let kod_panic = 5
    print_int(kod_panic)
    kod_panic(msg)
}

func positive(anon n: int64) -> int64? {
    if n > 0 {
        return n
    }
    return none
}

func pick_let(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    die_let("negative")
}

func pick_arm(anon n: int64) -> int64 {
    return match n {
        0 -> die_arm(Hard(tag: "arm"), "zero")
        else -> n
    }
}

func pick_if_is(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    return die_if_is(Hard(tag: "if"), "negative")
}

func pick_let_else(anon n: int64) -> int64 {
    return positive(n)? or die_let_else(Hard(tag: "let-else"), "negative")
}

func pick_rebound(anon n: int64) -> int64 {
    let .Some(v) = positive(n) else { die_rebound(Soft(tag: "soft"), "negative") }
    return v
}

func pick_outer(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    die_outer(true, "negative")
}

func pick_retyped(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    die_retyped("negative")
}

func pick_named(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    die_named("negative")
}

// The parameter's own type holds until the `let` that binds it again.
func pick_param(anon r: Hard, anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    match n {
        0 -> r.fail("zero")
        else -> r.fail("negative")
    }
    let r = Soft(tag: "soft")
    r.fail("unreached")
}

func pick_else_block(anon n: int64) -> int64 {
    let r = Hard(tag: "else")
    let .Some(v) = positive(n) else { r.fail("negative") }
    return v
}

func pick_named_here(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    let kod_panic = 5
    print_int(kod_panic)
    kod_panic("negative")
}

func main() -> int64 {
    print_int(pick_let(1) + pick_arm(2) + pick_if_is(3) + pick_let_else(4))
    print_int(pick_rebound(5) + pick_outer(6) + pick_retyped(7) + pick_named(8))
    print_int(pick_param(Hard(tag: "param"), 9) + pick_else_block(10) + pick_named_here(11))
    print_int(pick_outer(-1))
    return 0
}

// expected output:
// 10
// 26
// 30
// inner: negative
// expected status:
// 1
// expected stderr:
// panic: outer: negative
