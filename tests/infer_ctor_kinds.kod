// Unannotated bindings of `Enum.Variant(...)`, `mod.Enum.Variant(...)` and
// `mod.Struct(...)` constructor calls get the constructed type.
import "json"
import "./infer_ctor_kinds_dep"

type Dir = enum {
    North(steps: int64)
    South(steps: int64)
}

func main() -> int64 {
    let n = Dir.North(steps: 2)
    match n {
        .North(steps) -> print(f"north {steps}")
        .South(steps) -> print(f"south {steps}")
    }
    let t = infer_ctor_kinds_dep.Thing(a: 1, s: "x")
    print(t.s)
    print(f"{t.a} {t.s}")
    let v = infer_ctor_kinds_dep.Shape.Square(side: 3)
    match v {
        .Circle(r) -> print(f"circle {r}")
        .Square(side) -> print(f"square {side}")
    }
    let j = json.Value.Number(value: 4)
    match j {
        .Number(value) -> print(f"number {value}")
        else -> print("not a number")
    }
    return 0
}

// expected output:
// north 2
// x
// 1 x
// square 3
// number 4
// expected status:
// 0
