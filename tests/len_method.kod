// `len(x)` on a struct calls its `len` method: a Map's entry count, or a
// user type's own count.

type Shelf = struct {
    books: [str]

    func len(self) -> int64 {
        return len(self.books) * 10
    }
}

func main() -> int64 {
    let m = Map[str, int64]()
    print_int(len(m))
    m.set("a", 1)
    m.set("b", 2)
    m["a"] = 3
    print_int(len(m))
    print_int(len(Shelf(books: ["x", "y", "z"])))
    return 0
}

// expected output:
// 0
// 2
// 30
