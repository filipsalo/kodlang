// A block's function value can't be called after the block.
func main() -> int64 {
    if true {
        let f = func(anon n: int64) -> int64 {
            return n + 1
        }
        print_int(f(1))
    }
    print_int(f(2))
    return 0
}

// expected output:
// expected status:
// 1
// expected stderr:
// 9:15: error: `f` is declared in a block that has ended; declare it outside the block to call it here
// expected mode:
// interpret
