// `T(n)` and `T` on unions, interfaces and optionals, and through generics.
interface Shape {
    func area(self) -> int64
}
type Circle = struct {
    r: int64

    func area(self) -> int64 {
        return 3 * self.r * self.r
    }
}
type Square = struct {
    s: int64

    func area(self) -> int64 {
        return self.s * self.s
    }
}
type Id = int64 | str

func shape_name(anon s: Shape) -> str {
    return match s {
        Circle(c) if c.r > 10 -> "big circle"
        Circle(c) -> f"circle {c.r}"
        Square -> "a square"
        else -> "other"
    }
}

type Slot = enum {
    Full(shape: Shape)
    Empty
}

// After `is`, `Circle(c)` in a payload is a type pattern too.
func nested_in_is(anon s: Shape) -> str {
    let slot = Slot.Full(shape: s)
    if slot is .Full(Circle(c)) {
        return f"circle {c.r}"
    }
    return "other"
}

func maybe_id(anon m: Id | none) -> str {
    match m {
        int64(n) -> return f"int {n}"
        str(s) -> return f"str {s}"
        none -> return "none"
    }
}

func maybe_int(anon m: int64?) -> str {
    return match m {
        int64(n) if n > 100 -> "big"
        int64(n) -> f"{n}"
        none -> "none"
    }
}

func maybe_shape(anon m: Shape?) -> str {
    match m {
        Circle(c) -> return f"circle {c.r}"
        none -> return "none"
        else -> return "another shape"
    }
}

type Cell = enum {
    Held(v: Id?)
    Count(n: int64?)
    Blank
}

// In a payload, an optional takes `T(n)` without its `Some`, at any depth.
func cell_text(anon c: Cell) -> str {
    return match c {
        .Held(int64(n)) -> f"held int {n}"
        .Held(str(s)) -> f"held str {s}"
        .Held(none) -> "held none"
        .Count(int64(n)) if n > 9 -> "many"
        .Count(int64(n)) -> f"count {n}"
        .Count(none) -> "no count"
        .Blank -> "blank"
    }
}

func maybe_cell(anon m: Cell?) -> str {
    if m is Some(.Held(str(s))) {
        return f"is {s}"
    }
    match m {
        Some(.Count(int64(n))) -> return f"some count {n}"
        none -> return "no cell"
        else -> return "other cell"
    }
}

// In a payload, a type's name is its pattern, not a binding.
func slot_kind(anon slot: Slot) -> str {
    return match slot {
        .Full(Circle) -> "full of circle"
        .Full(_) -> "full"
        .Empty -> "empty"
    }
}

func held_kind(anon c: Cell) -> str {
    return match c {
        .Held(str) -> "a str"
        .Held(int64) -> "an int"
        else -> "other"
    }
}

func let_else_forms(anon held: Id | none, shape: Shape, plain: int64?) -> str {
    let str(s) = held else { return "no str" }
    let Circle(c) = shape else { return "no circle" }
    let Some(n) = plain else { return "no int" }
    return f"{s} {c.r} {n}"
}

// One pattern, compiled for each subject an instance gives it.
func holds_int[T](anon x: T) -> str {
    match x {
        else -> return "any"
    }
}

func generic_optional[T](anon x: T?) -> str {
    match x {
        T -> return "some"
        none -> return "none"
    }
}

func main() -> int64 {
    print(shape_name(Circle(r: 20)))
    print(shape_name(Circle(r: 1)))
    print(shape_name(Square(s: 1)))
    print(nested_in_is(Circle(r: 2)))

    let shape: Shape = Circle(r: 3)
    if shape is Circle(c) {
        print_int(c.r)
    }
    if shape is Square {
        print("not reached")
    }
    if shape is not Square {
        print("not a square")
    }
    let is_circle = shape is Circle
    print(f"{is_circle}")

    print(maybe_id(1))
    print(maybe_id("s"))
    print(maybe_id(none))
    print(maybe_int(500))
    print(maybe_int(5))
    print(maybe_int(none))
    print(maybe_shape(Circle(r: 4)))
    print(maybe_shape(Square(s: 4)))
    print(maybe_shape(none))

    let held: Id | none = "held"
    if held is str(s) {
        print(s)
    }
    if held is int64(n) {
        print_int(n)
    } else {
        print("no int")
    }
    let has_str = held is str
    let has_int = held is int64
    let not_int = held is not int64
    print(f"{has_str} {has_int} {not_int}")
    let gone: Id | none = none
    let gone_str = gone is str
    print(f"{gone_str}")
    if held is str(s) and len(s) == 4 {
        print("four")
    }

    let plain: int64? = 6
    if plain is int64(n) {
        print_int(n)
    }
    let word = match held {
        str(s) -> s
        int64(n) -> f"{n}"
        none -> "none"
    }
    print(word)

    print(cell_text(.Held(v: 3)))
    print(cell_text(.Held(v: "x")))
    print(cell_text(.Held(v: none)))
    print(cell_text(.Count(n: 12)))
    print(cell_text(.Count(n: 2)))
    print(cell_text(.Count(n: none)))
    print(cell_text(.Blank))
    print(maybe_cell(.Held(v: "y")))
    print(maybe_cell(.Count(n: 1)))
    print(maybe_cell(none))
    print(maybe_cell(.Blank))

    print(generic_optional[int64](1))
    print(generic_optional[str]("s"))
    print(generic_optional[str](none))
    print(holds_int(1))

    print(slot_kind(.Full(shape: Circle(r: 1))))
    print(slot_kind(.Full(shape: Square(s: 1))))
    print(slot_kind(.Empty))
    print(held_kind(.Held(v: "a")))
    print(held_kind(.Held(v: 2)))
    print(held_kind(.Blank))
    print(let_else_forms("w", shape: Circle(r: 7), plain: 8))
    print(let_else_forms(1, shape: Circle(r: 7), plain: 8))
    print(let_else_forms("w", shape: Square(s: 7), plain: 8))
    print(let_else_forms("w", shape: Circle(r: 7), plain: none))

    // Both spellings stay valid, next to each other.
    match held {
        Some(int64(n)) -> print_int(n)
        str(s) -> print(s)
        none -> print("none")
    }
    return 0
}

// expected output:
// big circle
// circle 1
// a square
// circle 2
// 3
// not a square
// true
// int 1
// str s
// none
// big
// 5
// none
// circle 4
// another shape
// none
// held
// no int
// true false true
// false
// four
// 6
// held
// held int 3
// held str x
// held none
// many
// count 2
// no count
// blank
// is y
// some count 1
// no cell
// other cell
// some
// some
// none
// any
// full of circle
// full
// empty
// a str
// an int
// other
// w 7 8
// no str
// no circle
// no int
// held
