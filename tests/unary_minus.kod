// A prefix `-` negates the whole call, field access, index or `?` after
// it, an unwrap's default included, and binds tighter than the binary
// operators.

type P = struct {
    x: int64
    rows: [[int64]] = [[1, 2], [3, 4]]

    func get(self) -> int64 {
        return self.x * 2
    }
}

func twice(anon n: int64) -> int64 {
    return n * 2
}

func main() -> int64 {
    let xs = [5, 6, 7]
    let p = P(x: 4)
    let m = Map[str, int64]()
    m["k"] = 9
    print_int(-xs[0])
    print_int(-xs[-1] + 1)
    print_int(-p.x)
    print_int(-twice(3))
    print_int(-p.get())
    print_int(-p.rows[1][0])
    print_int(-m.get("k")? or 0)
    print_int(-m.get("none")? or 3)
    print_int(-xs[1] * 2)
    print_int(10 - -p.x)
    print_int(-(xs[0] + 1) * -2)
    return 0
}

// expected output:
// -5
// -6
// -4
// -6
// -8
// -3
// -9
// -3
// -12
// 14
// 12
