// `x in c` and `x not in c`.
import "sets" { Set }

type Range = struct {
    lo: int64
    hi: int64

    func contains(self, anon n: int64) -> bool {
        return n >= self.lo and n < self.hi
    }
}

type Pt = struct {
    x: int64
    y: int64
}

test "in an array" {
    let xs = [1, 2, 3]
    assert 2 in xs
    assert 5 not in xs
    assert not 5 in xs
    let empty: [str] = []
    assert "a" not in empty
    assert "b" in ["a", "b"]
    assert Pt(x: 1, y: 2) in [Pt(x: 0, y: 0), Pt(x: 1, y: 2)]
    assert [1] in [[0], [1]]
}

test "in a str" {
    assert "ell" in "hello"
    assert "z" not in "hello"
    assert "" in ""
}

test "in a Map, a Set, or a struct with contains" {
    mut m = Map[str, int64]()
    m.set("a", 1)
    assert "a" in m
    assert "b" not in m
    mut s = Set[int64]()
    s.add(4)
    assert 4 in s
    assert 5 not in s
    assert 3 in Range(lo: 0, hi: 10)
    assert 10 not in Range(lo: 0, hi: 10)
}

test "binds like a comparison" {
    let xs = [1, 2]
    assert 1 + 1 in xs and 3 not in xs
    assert (2 in xs) == true
    assert [x for x in [1, 2, 3, 4] if x not in xs] == [3, 4]
    mut hits = 0
    for x in [1, 2, 3] {
        if x in xs {
            hits += 1
        }
    }
    assert hits == 2
}
