// `else if` after an `if` whose condition binds: it runs when the pattern fails and can bind its own names.

type Token = enum {
    Num(n: int64)
    Word(w: str)
    End
}

func show(t: Token) -> str {
    if t is .Num(n) {
        return f"num {n}"
    } else if t is .Word(w) and len(w) > 3 {
        return f"long {w}"
    } else if t is .Word(w) {
        return f"word {w}"
    } else {
        return "end"
    }
}

func small(t: Token) -> str {
    if t is .Num(n) and n < 10 {
        return f"small {n}"
    } else if t is .Num(n) {
        return f"big {n}"
    }
    return "other"
}

func main() -> int64 {
    print(show(t: .Num(n: 4)))
    print(show(t: .Word(w: "hello")))
    print(show(t: .Word(w: "hi")))
    print(show(t: .End))
    print(small(t: .Num(n: 3)))
    print(small(t: .Num(n: 30)))
    print(small(t: .End))
    let o: int64? = none
    if o is not Some(v) {
        print("missing")
    } else if v > 0 {
        print("bad")
    }
    return 0
}

// expected output:
// num 4
// long hello
// word hi
// end
// small 3
// big 30
// other
// missing
