// A function whose last act is to call itself jumps back to its start, so the
// recursion takes no stack: these go far deeper than a stack of calls could.
type Walker = shared struct {
    steps: int64

    func walk(self, anon n: int64) -> none {
        if n == 0 {
            return
        }
        self.steps += 1
        self.walk(n - 1)
    }
}

type Counter = struct {
    base: int64

    func sum_to(self, anon n: int64, acc: int64) -> int64 {
        if n == 0 {
            return acc + self.base
        }
        return self.sum_to(n - 1, acc: acc + n)
    }
}

func sum_to(anon n: int64, acc: int64) -> int64 {
    if n == 0 {
        return acc
    }
    return sum_to(n - 1, acc: acc + n)
}

// Parameters are given their new values together: `b` gets the old `a`.
func gcd(a: int64, b: int64) -> int64 {
    if b == 0 {
        return a
    }
    return gcd(a: b, b: a % b)
}

// A counted parameter passed on as it is, and locals given up each round.
func count_long(anon words: [str], i: int64, n: int64) -> int64 {
    if i == len(words) {
        return n
    }
    let w = words[i] + "?"
    if len(w) > 3 {
        return count_long(words, i: i + 1, n: n + 1)
    }
    return count_long(words, i: i + 1, n: n)
}

// A new array for a counted parameter is an ordinary call.
func drop_all(anon xs: [int64], n: int64) -> int64 {
    if len(xs) == 0 {
        return n
    }
    return drop_all(xs[1..], n: n + 1)
}

// A default fills the parameter on each round.
func countdown(anon n: int64, step: int64 = 1) -> int64 {
    if n <= 0 {
        return n
    }
    return countdown(n - step)
}

func main() -> int64 {
    print_int(sum_to(10000000, acc: 0))
    print_int(gcd(a: 1071, b: 462))
    let w = Walker(steps: 0)
    w.walk(10000000)
    print_int(w.steps)
    let c = Counter(base: 1)
    print_int(c.sum_to(10000000, acc: 0))
    mut words: [str] = []
    for i in 0..1000000 {
        words += [f"{i % 1000}"]
    }
    print_int(count_long(words, i: 0, n: 0))
    print_int(drop_all([1, 2, 3, 4], n: 0))
    print_int(countdown(10000001))
    return 0
}

// expected output:
// 50000005000000
// 21
// 10000000
// 50000005000001
// 900000
// 4
// 0
