// The compiler reports a bare type name in a return type that only
// another module declares, as it does in a parameter.
import "./type_bare_cross_module_dep"

func origin() -> Pt {
    return type_bare_cross_module_dep.Pt(x: 0)
}

func main() -> int64 {
    return origin().x
}

// expected status:
// 1
// expected stderr:
// 5:18: error: unknown type `Pt`; tests/type_bare_cross_module_dep.kod declares `Pt`: write `type_bare_cross_module_dep.Pt` or list it in the import (`{ Pt }`)
