type Node = struct {
    kids: [Node]
    name: str
}

type Link = struct {
    next: Link?
    label: str
}

type Tree = enum {
    Leaf(n: int64)
    Branch(kids: [Tree])
}

func show_next(anon l: Link) -> none {
    match l.next {
        Some(x) -> print(x.label)
        none -> print("no next")
    }
}

func main() -> int64 {
    let leaf = Node(kids: [], name: "leaf")
    let root = Node(kids: [leaf], name: "root")
    print(root.kids[0].name)
    print(f"first kid: {root.kids[0].name}")

    let tail = Link(next: none, label: "tail")
    let head = Link(next: tail, label: "head")
    show_next(head)
    show_next(tail)

    let t: Tree = Tree.Branch(kids: [Tree.Leaf(n: 7)])
    if t is .Branch(kids) {
        if kids[0] is .Leaf(n) {
            print(f"leaf {n}")
        }
    }
    return 0
}

// expected output:
// leaf
// first kid: leaf
// tail
// no next
// leaf 7
// expected status:
// 0
