// A variable whose value needs itself, through a function, stops the program.
mut a: int64 = from_b()
mut b: int64 = a + 1

func from_b() -> int64 {
    return b * 2
}

func main() -> int64 {
    print("start")
    print_int(a)
    return 0
}

// expected output:
// start
// expected stderr:
// panic: `a` is used while its value is being worked out
// expected status:
// 1
