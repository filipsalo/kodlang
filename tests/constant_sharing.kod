// Reads of a constant that can't change it share one copy; any other use is a copy of its own.
import "./constant_sharing_dep"
import "./constant_sharing_dep" { TITLE }

type Mode = enum {
    Fast
    Safe
}

let SQUARES: [int64] = [0, 1, 4, 9, 16]
let WORDS: [str] = ["zero", "one", "two"]
let FLAGS: [bool] = [true, false]
let HALVES: [float64] = [0.5, 1.5]
let MODES: [Mode] = [Mode.Fast, Mode.Safe]
let GRID: [[int64]] = [[1, 2], [3, 4]]
let GREETING: str = "hello" + ", " + "world"

func sum_squares() -> int64 {
    mut total: int64 = 0
    for i in 0..len(SQUARES) {
        total += SQUARES[i]
    }
    for s in SQUARES {
        total += s
    }
    return total
}

// A string constant handed out, as a function's result and kept in an array.
func greeting() -> str {
    return GREETING
}

func main() -> int64 {
    mut kept: [str] = []
    for _ in 0..1000 {
        kept += [greeting()]
        kept += [TITLE]
    }
    mut total: int64 = 0
    for k in 0..1000 {
        total += SQUARES[k % 5] + constant_sharing_dep.CODES[k % 3]
    }
    print(f"{kept[0]} {kept[1999]} {len(kept)} {total}")
    print_int(sum_squares())
    print_int(sum_squares())
    print(WORDS[2] + " " + str(len(WORDS)))
    for w in WORDS {
        print(w)
    }
    print(str(FLAGS[1]))
    print(f"{HALVES[0] + HALVES[1]}")
    print(str(MODES[1] is .Safe))
    print(GREETING)
    print(TITLE + " " + str(len(constant_sharing_dep.TITLE)))
    print_int(constant_sharing_dep.CODES[1] + len(constant_sharing_dep.CODES))

    // A copy is its own: changing it leaves the constant, and the shared copy, alone.
    let mine = SQUARES
    mine[0] = 100
    print_int(mine[0])
    print_int(SQUARES[0])
    // So is an element array of an array constant.
    let row = GRID[0]
    row[0] = 50
    print_int(GRID[0][0])
    mut codes = constant_sharing_dep.CODES
    codes += [40]
    print_int(len(codes))
    print_int(len(constant_sharing_dep.CODES))
    return 0
}

// expected output:
// hello, world the title 2000 25990
// 60
// 60
// two 3
// zero
// one
// two
// false
// 2.0
// true
// hello, world
// the title 9
// 23
// 100
// 0
// 1
// 4
// 3
