// A `.Variant` belongs to the enum of the slot it goes to or of the other
// side of `==`, even when this module declares a variant of that name too.
import "./../variant_slots_dep"

type Mark = enum {
    Start
    End
    Red
}

type Pair = shared struct {
    tok: variant_slots_dep.Tok
    mark: Mark
}

func last() -> variant_slots_dep.Tok {
    return .End
}

func pick(anon n: int64) -> variant_slots_dep.Tok {
    return match n {
        0 -> .End
        else -> .Word(s: "w")
    }
}

func shade(c: variant_slots_dep.Color = .Red) -> bool {
    return variant_slots_dep.is_red(c)
}

test "arguments and ==" {
    assert variant_slots_dep.count_words([.Word(s: "a"), .End, .Word(s: "b")]) == 2
    assert variant_slots_dep.is_end(.End)
    assert variant_slots_dep.is_red(.Red)
    let t: variant_slots_dep.Tok = .End
    assert f"{t == .End} {.End == t} {t != .End} {variant_slots_dep.is_end(t)}" == "true true false true"
}

test "assignments, fields and index stores" {
    mut u = variant_slots_dep.Tok.Word(s: "x")
    u = .End
    assert variant_slots_dep.is_end(u)
    let p = Pair(tok: .End, mark: .End)
    assert variant_slots_dep.is_end(p.tok)
    assert p.mark == Mark.End
    p.tok = .Word(s: "y")
    p.tok = .End
    assert variant_slots_dep.is_end(p.tok)
    mut ts = [variant_slots_dep.Tok.Word(s: "z")]
    ts[0] = .End
    assert variant_slots_dep.is_end(ts[0])
}

test "returns, field defaults and payloads" {
    assert variant_slots_dep.is_end(last())
    assert variant_slots_dep.is_end(pick(0))
    assert not variant_slots_dep.is_end(pick(1))
    let cell = variant_slots_dep.Cell(t: .End)
    assert variant_slots_dep.is_end(cell.t)
    assert not variant_slots_dep.is_red(cell.tag)
    let h = variant_slots_dep.Held.Holds(t: .End)
    if h is .Holds(inner) {
        assert variant_slots_dep.is_end(inner)
    } else {
        fail("not Holds")
    }
}

test "map keys and parameter defaults" {
    mut m = Map[variant_slots_dep.Color, int64]()
    m[.Red] = 1
    m.set(.Green, 2)
    let red = m[variant_slots_dep.Color.Red]? or 0
    let green = m.get(.Green)? or 0
    assert red == 1
    assert green == 2
    assert len(m) == 2
    assert shade()
}
