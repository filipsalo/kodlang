// The interpreter reports a three-part pattern written through a name that
// is no module, rather than matching by the variant alone.
import "./qualified_type_wrong_module_ka"

func main() -> int64 {
    let kind: qualified_type_wrong_module_ka.E = .V
    match kind {
        nosuch.E.V -> return 2
        else -> return 0
    }
}

// expected status:
// 1
// expected stderr:
// 8:9: error: unknown type `nosuch.E`
// expected mode:
// interpret
