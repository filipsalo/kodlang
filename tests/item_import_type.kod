// Types listed in an import are written by their own names, in annotations
// and as the generic of an alias.
import "./item_import_type_dep" { Vec2, dot, Box }

type IntBox = Box[int64]

func norm2(anon v: Vec2) -> int64 {
    return dot(v, v)
}

func unbox(anon b: IntBox) -> int64 {
    return b.get()
}

func main() -> int64 {
    let v: Vec2 = Vec2(x: 3, y: 4)
    print_int(norm2(v))
    let b: Box[str] = Box[str](v: "boxed")
    print(b.get())
    print_int(unbox(IntBox(v: 7)))
    let vs: [Vec2] = [v, item_import_type_dep.Vec2(x: 1, y: 2)]
    print_int(norm2(vs[1]))
    return 0
}

// expected output:
// 25
// boxed
// 7
// 5
