// The interpreter reports a context-free `.Variant` that two enums the
// module sees declare, as the compiler does, instead of taking the first.
import "./implicit_variant_ambiguous_dep"

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
}

func area(anon s: Shape) -> int64 {
    match s {
        .Circle(r) -> return 3 * r * r
        .Rect(w, h) -> return w * h
    }
}

func main() -> int64 {
    let v: Shape = .Rect(w: 2, h: 3)
    print_int(area(v))
    let u = .Circle(r: 2)
    return area(u)
}

// expected status:
// 1
// expected stderr:
// 20:13: error: `.Circle` is ambiguous: `implicit_variant_ambiguous_dep.Figure` and `Shape` both declare it; write `Shape.Circle` or give the value a type
// expected mode:
// interpret
