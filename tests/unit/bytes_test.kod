// Regression: `bytes` is a distinct type from `str` with the same
// in-memory layout, written as `b"..."`.
test "bytes literals, indexing, slicing, + and comparison" {
    let raw: bytes = b"hello"
    assert len(raw) == 5
    assert raw[0] == 104
    assert raw[4] == 111

    let zero: bytes = b"\0ok"
    assert len(zero) == 3
    assert zero[0] == 0
    assert zero[1] == 111

    let slice: bytes = raw[1..4]
    assert len(slice) == 3

    let cat: bytes = raw + b" world"
    assert len(cat) == 11

    assert raw == b"hello"
    assert raw != b"hellO"
}
