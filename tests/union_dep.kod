type Unit = struct {
    name: str
}
type Value = str | int64 | Unit

func describe(anon v: Value) -> str {
    return match v {
        str(s) -> f"text {s}"
        int64(n) -> f"number {n}"
        Unit(u) -> f"unit {u.name}"
    }
}

func default_value() -> int64 | Unit | str {
    return Unit(name: "kg")
}
