// The interpreter rejects a parameter name used twice before running
// anything, as the compiler does.
func pick(anon a: int64, b a: str) -> str {
    return a
}

func main() -> int64 {
    print("start")
    print(pick(1, b: "x"))
    return 0
}

// expected mode:
// interpret
// expected output:
// expected stderr:
// 3:26: error: parameter `a` is declared twice; give one of them another name
// expected status:
// 1
