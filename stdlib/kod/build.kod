// Shared compile pipeline. The CLI driver in `kodc.kod` and the
// language server in `tools/lsp.kod` both need to take a Kod source
// file, walk its transitive imports, register everything in a fresh
// codegen, and run codegen.compile_module. This module owns that
// orchestration so neither caller has to repeat the import-walk
// boilerplate. Callers differ only in:
//   - whether they start from a path on disk (kodc) or an in-memory
//     buffer (lsp), so the entry parser/module are passed in;
//   - whether they want asm side effects, which is controlled by
//     codegen.Codegen.dry_run.
import "io"
import "kod/lexing"
import "kod/parsing"
import "kod/ast"
import "kod/codegen"

func starts_with(anon s: str, prefix: str) -> bool {
    if len(prefix) > len(s) {
        return false
    }
    mut i: int64 = 0
    for i < len(prefix) {
        if s[i] != prefix[i] {
            return false
        }
        i = i + 1
    }
    return true
}

func ends_with(anon s: str, suffix: str) -> bool {
    let n: int64 = len(s)
    let m: int64 = len(suffix)
    if m > n {
        return false
    }
    return s[n-m..n] == suffix
}

func dirname(anon path: str) -> str {
    // Returns the directory portion (including trailing slash) or "" if none.
    mut i: int64 = len(path) - 1
    for i >= 0 {
        if path[i] == '/' {
            return path[0..i+1]
        }
        i = i - 1
    }
    return ""
}

// One byte as the escape of a symbol: `$$` and two lowercase hex digits.
func escape_byte(anon b: int64) -> str {
    let digits: str = "0123456789abcdef"
    let hi: int64 = b / 16
    let lo: int64 = b % 16
    let hi_digit: str = digits[hi..hi+1]
    let lo_digit: str = digits[lo..lo+1]
    return "$$" + hi_digit + lo_digit
}

// The assembler reads `.1e5` as a number, so in a result that is to get a
// `.` in front, an `e` or `E` that follows its leading digits is escaped.
func escape_exponent(anon s: str) -> str {
    mut end: int64 = 0
    for end < len(s) and lexing.is_digit(s[end]) {
        end = end + 1
    }
    if end > 0 and end < len(s) and (s[end] == 'e' or s[end] == 'E') {
        return s[0..end] + escape_byte(s[end]) + s[end+1..len(s)]
    }
    return s
}

// A path as assembler symbol characters (docs/modules.md, "Symbol and
// object names"). `/` is `$`; letters, digits, `_` and a `.` that is not
// the first byte stay; every other byte is escaped. The label it ends up
// in is `$<prefix>$<name>`, and the assembler reads `$` and a digit as a
// number, so a result that is empty or starts with `$` or a digit gets a
// `.` in front (and an `e` after its digits is escaped, see above). Two
// paths without `//` never share a result.
func mangle_path(anon name: str) -> str {
    mut result: str = ""
    mut i: int64 = 0
    for i < len(name) {
        let b: int64 = name[i]
        if b == '/' {
            result = result + "$"
        } else if lexing.is_alnum(b) or (b == '.' and i > 0) {
            result = result + name[i..i+1]
        } else {
            result = result + escape_byte(b)
        }
        i = i + 1
    }
    if len(result) == 0 or result[0] == '$' or lexing.is_digit(result[0]) {
        return "." + escape_exponent(result)
    }
    return result
}

func path_to_prefix(anon path: str) -> str {
    // Strip the .kod suffix and a leading '/' (an absolute path would
    // otherwise start the prefix with '$'), and drop the 'stdlib/' root
    // so the prefix matches what 'import "kod/foo"' resolves to.
    mut name: str = path[0..len(path)-4]
    if len(name) > 0 and name[0] == '/' {
        name = name[1..len(name)]
    }
    if len(name) > 7 and name[0..7] == "stdlib/" {
        return mangle_path(name[7..len(name)])
    }
    // A project module whose path also exists under stdlib/ is another
    // module than the stdlib one: it gets its own namespace.
    if io.is_file(f"stdlib/{name}.kod") {
        return ".user$" + mangle_path(name)
    }
    return mangle_path(name)
}

// A directory of a source path as one component of an object path: a
// `.` or `..` directory, the empty root of an absolute path and a `%` are
// written `%xx`, so no two source paths share an object.
func escape_part(anon part: str) -> str {
    if part == "" {
        return "%2f"
    }
    if part == "." {
        return "%2e"
    }
    if part == ".." {
        return "%2e%2e"
    }
    mut out: str = ""
    mut i: int64 = 0
    for i < len(part) {
        if part[i] == '%' {
            out = out + "%25"
        } else {
            out = out + part[i..i+1]
        }
        i = i + 1
    }
    return out
}

// The object file of the module at `source` (a normalized path) under
// `root`: the source tree mirrored, `lib/json.kod` is `<root>/lib/json.kod.o`.
func obj_path(root: str, source: str) -> str {
    mut out: str = root
    mut start: int64 = 0
    mut i: int64 = 0
    for i <= len(source) {
        if i == len(source) or source[i] == '/' {
            out = f"{out}/{escape_part(source[start..i])}"
            start = i + 1
        }
        i = i + 1
    }
    return out + ".o"
}

// A missing file still yields a parser (over empty source) carrying a
// "no such file" ParseError, so callers that fold parser errors report it.
func parse_file(anon path: str) -> parsing.Parser {
    let found: bool = io.is_file(path)
    mut source: str = ""
    if found {
        source = io.read_file(path)
    }
    let lxr: lexing.Lexer = lexing.Lexer(:source, pos: 0, start: 0)
    let tokens: [lexing.Token] = lxr.lex()
    let p: parsing.Parser = parsing.make_parser(tokens, :path, :source)
    if found == false {
        p.errors += [parsing.ParseError(:path, line: 1, col: 1, end_col: 2, message: "error: no such file", source_line: "", caret: "")]
    }
    return p
}

// Byte offset of the first `"<module_name>"` in `source`, or 0. Import
// decls carry no span, so a missing-import error locates the import by
// its text.
func import_offset(source: str, module_name: str) -> int64 {
    let needle: str = "\"" + module_name + "\""
    let n: int64 = len(needle)
    mut i: int64 = 0
    for i + n <= len(source) {
        if source[i] == '"' and source[i..i+n] == needle {
            return i
        }
        i = i + 1
    }
    return 0
}

// Print a parser's errors to stderr; true if there were any. For the
// sh_kodc subcommands that parse without running codegen.
func report_parse_errors(anon p: parsing.Parser) -> bool {
    for pe in p.errors {
        kod_eprint(pe.to_str())
    }
    return len(p.errors) > 0
}

// Resolve an import's module_name to (file_path, codegen_prefix).
type Resolved = struct {
    file: str
    prefix: str
}

func resolve_import(target_path: str, module_name: str) -> Resolved {
    if starts_with(module_name, prefix: "./") {
        let rel: str = module_name[2..len(module_name)]
        let dir: str = dirname(target_path)
        let rel_file: str = normalize_path(f"{dir}{rel}.kod")
        return Resolved(file: rel_file, prefix: path_to_prefix(rel_file))
    }
    // stdlib import: prefix drops the stdlib/ root
    let std_file: str = normalize_path(f"stdlib/{module_name}.kod")
    return Resolved(file: std_file, prefix: path_to_prefix(std_file))
}

// One spelling per file, so a module reached two ways is loaded once.
func normalize_path(anon path: str) -> str {
    mut parts: [str] = []
    mut start: int64 = 0
    mut i: int64 = 0
    for i <= len(path) {
        if i == len(path) or path[i] == '/' {
            let part: str = path[start..i]
            if part == ".." and len(parts) > 0 and parts[len(parts) - 1] != ".." {
                if parts[len(parts) - 1] != "" {
                    parts = parts[0..len(parts) - 1]
                }
            } else if part != "." and (len(part) > 0 or start == 0) {
                parts += [part]
            }
            start = i + 1
        }
        i = i + 1
    }
    mut out: str = ""
    mut k: int64 = 0
    for part in parts {
        if k > 0 {
            out = out + "/"
        }
        out = out + part
        k = k + 1
    }
    return out
}

// Recursively register types from a module's own imports. The
// transitively-loaded modules don't get entry-level import aliases or
// function exports — they're loaded purely so the codegen can resolve types
// they define when those types appear in fields of structs the entry
// does use. `loaded` is the running set of already-loaded file paths;
// returned so the caller can keep deduplicating.
func load_transitive(cg: codegen.Codegen, module: ast.Module, importer_p: parsing.Parser, mut loaded: [str]) -> [str] {
    let importer_path = importer_p.path
    for d in module.decls {
        match d {
            ast.Decl.Import(module_name, local_name, _items) -> {
                if len(module_name) > 0 {
                    let resolved: Resolved = resolve_import(target_path: importer_path, :module_name)
                    if io.is_file(resolved.file) == false {
                        let at = import_offset(source: importer_p.source, :module_name)
                        cg.note_dep_import_error(f"error: no such module `{module_name}` (looked for {resolved.file})", p: importer_p, span: ast.Span(start: at))
                    }
                    mut already: bool = false
                    for lp in loaded {
                        if lp == resolved.file {
                            already = true
                        }
                    }
                    if already == false {
                        loaded += [resolved.file]
                        let import_parser: parsing.Parser = parse_file(resolved.file)
                        let im: ast.Module = import_parser.parse_module()
                        cg.add_scope(im, prefix: resolved.prefix, p: import_parser)
                        note_imports(:cg, module: im, p: import_parser)
                        cg.register_module_types(im, prefix: resolved.prefix, p: import_parser)
                        loaded = load_transitive(:cg, module: im, importer_p: import_parser, :loaded)
                        // Aliases of types from the module's own imports, now registered.
                        cg.register_type_aliases(im, p: import_parser)
                    }
                }
            }
            else none
        }
    }
    return loaded
}

// Before a module's types register, so its declarations can name a type through
// an import. The module's own code compiled here resolves `alias.f` through these too.
func note_imports(cg: codegen.Codegen, module: ast.Module, p: parsing.Parser) -> none {
    for d in module.decls {
        if d is .Import(module_name, local_name, items) {
            if len(module_name) > 0 {
                let resolved: Resolved = resolve_import(target_path: p.path, :module_name)
                cg.note_import(importer: p.path, :local_name, target: resolved.file, :items)
            }
        }
    }
}

func module_has_tests(anon module: ast.Module) -> bool {
    for d in module.decls {
        if d is .Test(_display, _decl) {
            return true
        }
    }
    return false
}

// Walk the import graph from `module` (which lives at `importer_path`)
// and collect the mangled prefixes of every reachable test-bearing
// module. `loaded` and `prefixes` are accumulators threaded through
// the recursion; returns the updated prefixes list.
func collect_test_modules(module: ast.Module, importer_path: str, mut loaded: [str], mut prefixes: [str]) -> [str] {
    for d in module.decls {
        match d {
            ast.Decl.Import(module_name, _local_name, _items) -> {
                if len(module_name) > 0 {
                    let resolved: Resolved = resolve_import(target_path: importer_path, :module_name)
                    mut already: bool = false
                    for lp in loaded {
                        if lp == resolved.file {
                            already = true
                        }
                    }
                    if already == false {
                        loaded += [resolved.file]
                        let p: parsing.Parser = parse_file(resolved.file)
                        let im: ast.Module = p.parse_module()
                        if module_has_tests(im) {
                            prefixes += [resolved.prefix]
                        }
                        prefixes = collect_test_modules(module: im, importer_path: resolved.file, :loaded, :prefixes)
                    }
                }
            }
            else none
        }
    }
    return prefixes
}

// Compile the already-parsed entry module against the full stdlib +
// the transitive import graph rooted at `entry_path`. The caller
// supplies the parsed entry so it can come from an editor buffer
// (LSP) instead of disk (kodc). Returns the configured codegen so
// the caller can read `cg.errors`, `cg.print_errors()`, etc.
//
// `dry_run = true` suppresses asm emission — what the LSP wants.
// `dry_run = false` is the kodc.kod path.
//
// `entry_path` matters for two things: relative-import resolution
// (`./foo`) walks from its directory, and codegen.Diagnostic stamps it as
// `error.path` for errors that came from the entry module.
func compile_program(entry_parser: parsing.Parser, entry_module: ast.Module, entry_path: str, dry_run: bool) -> codegen.Codegen {
    let builtins_parser: parsing.Parser = parse_file("stdlib/builtins.kod")
    let builtins_module: ast.Module = builtins_parser.parse_module()

    // Primitive type modules: their functions are registered as
    // methods on the corresponding TypeKind, not as global names.
    let int64_parser: parsing.Parser = parse_file("stdlib/primitives/int64.kod")
    let int64_module: ast.Module = int64_parser.parse_module()
    let str_parser: parsing.Parser = parse_file("stdlib/primitives/str.kod")
    let str_module: ast.Module = str_parser.parse_module()
    let bool_parser: parsing.Parser = parse_file("stdlib/primitives/bool.kod")
    let bool_module: ast.Module = bool_parser.parse_module()
    let float64_parser: parsing.Parser = parse_file("stdlib/primitives/float64.kod")
    let float64_module: ast.Module = float64_parser.parse_module()

    let prefix: str = path_to_prefix(entry_path)
    let cg: codegen.Codegen = codegen.make_codegen(p: entry_parser, path_prefix: prefix)
    cg.dry_run = dry_run
    // Fold structured parser errors into cg.errors so callers (kodc's
    // print_errors, lsp's diagnostic loop) see a single error stream.
    // Codegen.had_errors then naturally short-circuits asm emission for
    // a file whose parser bailed.
    for pe in entry_parser.errors {
        cg.errors += [codegen.Diagnostic(path: pe.path, line: pe.line, col: pe.col, end_col: pe.end_col, message: pe.message, source_line: pe.source_line, caret: pe.caret)]
    }
    cg.builtins_path = builtins_parser.path
    cg.register_module_types(builtins_module, prefix: "builtins", p: builtins_parser)
    cg.register_module_funcs(builtins_module, prefix: "builtins", p: builtins_parser)
    cg.register_primitive_module(int64_module, kind: .KInt64, prefix: "primitives$int64", p: int64_parser)
    cg.register_primitive_module(str_module, kind: .KStr, prefix: "primitives$str", p: str_parser)
    cg.register_primitive_module(bool_module, kind: .KBool, prefix: "primitives$bool", p: bool_parser)
    cg.register_primitive_module(float64_module, kind: .KFloat64, prefix: "primitives$float64", p: float64_parser)

    // Two-pass import walk. Pass 1 parses every import, registers its
    // alias, and registers the module's *types* (with transitive
    // descent), so the type registry is complete before any function
    // sig is resolved against it. Pass 2 then binds the function sigs
    // and the named imported items. Without the split, a sig that
    // returns an enum from a later-walked module captures KInt64 (the
    // find_enum_idx fallback) and stays wrong forever — `infer_kind`
    // on `mod.fn(...)` would then fail to dereference an enum match
    // subject. Pass 2 reuses pass 1's parse of each import: under the
    // Python interpreter (bootstrap) a parse of codegen.kod alone takes
    // about a minute.
    mut loaded: [str] = []
    mut import_parsers: [parsing.Parser] = []
    mut import_modules: [ast.Module] = []
    note_imports(:cg, module: entry_module, p: entry_parser)
    for d in entry_module.decls {
        match d {
            ast.Decl.Import(module_name, local_name, _items) -> {
                if len(module_name) > 0 {
                    let resolved: Resolved = resolve_import(target_path: entry_path, :module_name)
                    if io.is_file(resolved.file) == false {
                        let at: int64 = import_offset(source: entry_parser.source, :module_name)
                        cg.report_error(f"error: no such module `{module_name}` (looked for {resolved.file})", span: ast.Span(start: at))
                    }
                    let import_parser: parsing.Parser = parse_file(resolved.file)
                    let im: ast.Module = import_parser.parse_module()
                    import_parsers += [import_parser]
                    import_modules += [im]
                    cg.register_import_module_alias(local_name)
                    cg.note_entry_import(resolved.file)
                    mut already: bool = false
                    for lp in loaded {
                        if lp == resolved.file {
                            already = true
                        }
                    }
                    if already == false {
                        loaded += [resolved.file]
                        cg.add_scope(im, prefix: resolved.prefix, p: import_parser)
                        note_imports(:cg, module: im, p: import_parser)
                        cg.register_module_types(im, prefix: resolved.prefix, p: import_parser)
                        loaded = load_transitive(:cg, module: im, importer_p: import_parser, :loaded)
                        // Aliases of types from the module's own imports, now registered.
                        cg.register_type_aliases(im, p: import_parser)
                    }
                }
            }
            else none
        }
    }

    // Re-resolve struct field kinds now that every imported module has
    // been registered. If an earlier-registered struct had a field
    // whose element type came from a later-registered module, its kind
    // was recorded as a plain KArray (no element). Re-resolving with
    // the full registry in place pins down the right kind so downstream
    // chained access (`p.func_decls[0].name`) infers correctly.
    cg.resolve_field_kinds(start: 0)
    cg.resolve_variant_field_kinds(start: 0)
    cg.resolve_method_sigs(struct_start: 0, iface_start: 0)

    mut import_k: int64 = 0
    for d2 in entry_module.decls {
        match d2 {
            ast.Decl.Import(module_name, local_name, items) -> {
                if len(module_name) > 0 {
                    let resolved: Resolved = resolve_import(target_path: entry_path, :module_name)
                    let ip: parsing.Parser = import_parsers[import_k]
                    let im: ast.Module = import_modules[import_k]
                    import_k += 1
                    cg.register_import_module_funcs(im, local_mod: local_name, prefix: resolved.prefix, p: ip)
                    cg.register_imported_items(items, im, prefix: resolved.prefix, p: ip)
                }
            }
            else none
        }
    }

    cg.compile_module(entry_module)
    if cg.had_errors() {
        cg.report_dep_errors()
    }
    return cg
}

// The link configuration (docs/self-hosting.md, "The link configuration").
// `link.cfg` and `link.local.cfg` hold `NAME := word word ...` lines, which
// the Makefile `include`s and the driver reads here. The format is the part
// of Make syntax that Make and this reader take the same way.

type LinkVar = struct {
    name: str
    value: str
}

type LinkVars = struct {
    items: [LinkVar]
}

// The value of `name`, its words separated by one space; "" when it is not
// set (or set to nothing).
func link_value(anon vars: LinkVars, name: str) -> str {
    for v in vars.items {
        if v.name == name {
            return v.value
        }
    }
    return ""
}

func link_has(anon vars: LinkVars, name: str) -> bool {
    for v in vars.items {
        if v.name == name {
            return true
        }
    }
    return false
}

// Set `name`, replacing what an earlier file set.
func link_set(anon vars: LinkVars, name: str, value: str) -> none {
    mut kept: [LinkVar] = []
    for v in vars.items {
        if v.name != name {
            kept += [v]
        }
    }
    kept += [LinkVar(name: name, value: value)]
    vars.items = kept
}

// The words of `s`, separated by spaces.
func split_words(anon s: str) -> [str] {
    mut words: [str] = []
    mut start: int64 = 0
    mut i: int64 = 0
    for i <= len(s) {
        if i == len(s) or s[i] == ' ' {
            if i > start {
                words += [s[start..i]]
            }
            start = i + 1
        }
        i = i + 1
    }
    return words
}

// The lines of `s` without their `\n`, empty ones included (so that a line
// number is a position in the file); a final newline ends the last line.
func lines_of(anon s: str) -> [str] {
    mut lines: [str] = []
    mut start: int64 = 0
    mut i: int64 = 0
    for i < len(s) {
        if s[i] == '\n' {
            lines += [s[start..i]]
            start = i + 1
        }
        i = i + 1
    }
    if start < len(s) {
        lines += [s[start..len(s)]]
    }
    return lines
}

func is_cfg_name_byte(anon b: int64) -> bool {
    return (b >= 'A' and b <= 'Z') or lexing.is_digit(b) or b == '_'
}

// What a word is made of: nothing Make or a shell would take for anything
// but itself.
func is_cfg_word_byte(anon b: int64) -> bool {
    return lexing.is_alnum(b) or b == '.' or b == '/' or b == ',' or b == '=' or b == '+' or b == '@' or b == '-'
}

func cfg_error(path: str, line: int64, col: int64, message: str) -> str {
    return f"{path}:{line}:{col}: error: {message}"
}

// The byte at `at` as an error message shows it.
func cfg_byte(anon line: str, at: int64) -> str {
    let b: int64 = line[at]
    if b > 32 and b < 127 {
        let shown: str = line[at..at+1]
        return f"`{shown}`"
    }
    return f"byte {b}"
}

func cfg_bad_word_byte(anon line: str, at: int64, path: str, number: int64) -> str {
    return cfg_error(:path, line: number, col: at + 1, message: f"{cfg_byte(line, :at)} cannot be in a word; a word is letters, digits and _ . / , = + @ -")
}

// The end of the name a line starts with.
func cfg_name_end(anon line: str) -> int64 {
    mut end: int64 = 1
    for end < len(line) and is_cfg_name_byte(line[end]) {
        end = end + 1
    }
    return end
}

// "" if `line` is empty, a comment or `NAME := words`, else the error.
func check_link_line(anon line: str, path: str, number: int64) -> str {
    mut i: int64 = 0
    for i < len(line) {
        if line[i] == '\t' {
            return cfg_error(:path, line: number, col: i + 1, message: "a tab is not allowed")
        }
        if line[i] == '\r' {
            return cfg_error(:path, line: number, col: i + 1, message: "a carriage return is not allowed; the file needs LF line ends")
        }
        i = i + 1
    }
    if len(line) == 0 {
        return ""
    }
    if line[0] == '#' {
        // Make would go on with the next line as part of the comment.
        if line[len(line) - 1] == '\\' {
            return cfg_error(:path, line: number, col: len(line), message: "a comment cannot end in a backslash")
        }
        return ""
    }
    if line[0] < 'A' or line[0] > 'Z' {
        return cfg_error(:path, line: number, col: 1, message: "expected `NAME := words`; a name is capital letters, digits and _, starting with a letter")
    }
    let end: int64 = cfg_name_end(line)
    if end + 3 > len(line) or line[end..end+3] != " :=" {
        return cfg_error(:path, line: number, col: end + 1, message: "expected ` :=` after the name")
    }
    i = end + 3
    if i < len(line) and line[i] != ' ' {
        return cfg_error(:path, line: number, col: i + 1, message: "expected a space after `:=`")
    }
    // Each word follows one space.
    for i < len(line) {
        i = i + 1
        let start: int64 = i
        for i < len(line) and is_cfg_word_byte(line[i]) {
            i = i + 1
        }
        if i == start {
            if i == len(line) or line[i] == ' ' {
                return cfg_error(:path, line: number, col: i + 1, message: "words are separated by one space, with none at the end")
            }
            return cfg_bad_word_byte(line, at: i, :path, :number)
        }
        if i < len(line) and line[i] != ' ' {
            return cfg_bad_word_byte(line, at: i, :path, :number)
        }
    }
    return ""
}

// Read the text of the file `path` (`link.cfg` or `link.local.cfg`) into
// `into`: each `NAME := words` line sets a name, replacing what an earlier
// file set. Returns "" or the first error, `path:line:col: error: ...`
// (`into` then holds what was read before it). A name is set once per file.
// With `overrides`, the file may only set names `into` already has: it is
// `link.local.cfg`, which overrides what `link.cfg` sets and adds nothing.
func parse_link_config(anon source: str, path: str, into: LinkVars, overrides: bool) -> str {
    mut seen: [str] = []
    mut number: int64 = 0
    for line in lines_of(source) {
        number = number + 1
        let bad: str = check_link_line(line, :path, :number)
        if len(bad) > 0 {
            return bad
        }
        if len(line) > 0 and line[0] != '#' {
            let end: int64 = cfg_name_end(line)
            let name: str = line[0..end]
            if overrides and link_has(into, :name) == false {
                return cfg_error(:path, line: number, col: 1, message: f"{name} is not set in link.cfg; this file only overrides the names it sets")
            }
            for s in seen {
                if s == name {
                    return cfg_error(:path, line: number, col: 1, message: f"{name} is set twice in this file")
                }
            }
            seen += [name]
            mut value: str = ""
            if len(line) > end + 3 {
                value = line[end+4..len(line)]
            }
            link_set(into, :name, :value)
        }
    }
    return ""
}

// The link inputs a module declares in the comment lines at its top
// (docs/modules.md, "Link inputs"): C files to compile, arguments for the
// link and files that must exist. Pure; the driver acts on them.

// A `kod:cc` line: the C file (its path from the repository root, the
// module's directory included), the flags after it and the line it is on.
type CcDecl = struct {
    file: str
    flags: [str]
    line: int64
}

// A `kod:require` line.
type RequireDecl = struct {
    file: str
    hint: str
    line: int64
}

// What a module declares, in the order of its lines. `errors` holds what is
// wrong with its lines as `path:line:1: error: ...`; `first` is the line of
// the first `// kod:` line, right or wrong, and 0 when there is none.
type LinkDecls = struct {
    cc: [CcDecl]
    link: [str]
    require: [RequireDecl]
    errors: [str]
    first: int64
}

// `s` without the spaces and tabs it starts with.
func trim_indent(anon s: str) -> str {
    mut i: int64 = 0
    for i < len(s) and (s[i] == ' ' or s[i] == '\t') {
        i = i + 1
    }
    return s[i..len(s)]
}

// `line` without a `\r` that ends it.
func without_cr(anon line: str) -> str {
    if len(line) > 0 and line[len(line) - 1] == '\r' {
        return line[0..len(line) - 1]
    }
    return line
}

// `source` without the UTF-8 byte order mark that may start it. The lexer
// skips the mark like any byte it has no use for, so the lines below must too.
func without_bom(anon source: str) -> str {
    if len(source) >= 3 and source[0] == 239 and source[1] == 187 and source[2] == 191 {
        return source[3..len(source)]
    }
    return source
}

// The lower-case letter for a capital, any other byte as it is.
func lower_byte(anon b: int64) -> int64 {
    if b >= 'A' and b <= 'Z' {
        return b + 32
    }
    return b
}

// Does the comment line `text` (without its indent) read as a directive,
// `kod` and a colon after the slashes, although it is not spelled `// kod:`?
// Taken for a comment, a slip such as `//kod:cc x.c` would not be found until
// the link fails.
func looks_like_directive(anon text: str) -> bool {
    if starts_with(text, prefix: "//") == false {
        return false
    }
    mut i: int64 = 2
    for i < len(text) and (text[i] == ' ' or text[i] == '\t') {
        i = i + 1
    }
    if i + 3 > len(text) {
        return false
    }
    if lower_byte(text[i]) != 'k' or lower_byte(text[i + 1]) != 'o' or lower_byte(text[i + 2]) != 'd' {
        return false
    }
    i = i + 3
    for i < len(text) and (text[i] == ' ' or text[i] == '\t') {
        i = i + 1
    }
    return i < len(text) and text[i] == ':'
}

// Is there a control character, a tab say, in `s`?
func has_control_byte(anon s: str) -> bool {
    mut i: int64 = 0
    for i < len(s) {
        if s[i] < 32 or s[i] == 127 {
            return true
        }
        i = i + 1
    }
    return false
}

// The start of `source` up to the first line that is neither blank nor a
// `//` comment: the block of comment lines that a module's link inputs are
// declared in. (Its lines are numbered as the file's are.)
func leading_block(anon source: str) -> str {
    mut start: int64 = 0
    mut i: int64 = 0
    for i <= len(source) {
        if i == len(source) or source[i] == '\n' {
            let text: str = trim_indent(without_cr(source[start..i]))
            if len(text) > 0 and starts_with(text, prefix: "//") == false {
                return source[0..start]
            }
            start = i + 1
        }
        i = i + 1
    }
    return source
}

// The name in the `${NAME}` that starts at `at` in `word`, "" if what is
// there is no `${NAME}`.
func braced_name(anon word: str, at: int64) -> str {
    if at + 2 >= len(word) {
        return ""
    }
    if word[at + 1] != '{' {
        return ""
    }
    mut end: int64 = at + 2
    for end < len(word) and is_cfg_name_byte(word[end]) {
        end = end + 1
    }
    if end == at + 2 or end >= len(word) or word[end] != '}' {
        return ""
    }
    return word[at+2..end]
}

// A word with its names replaced, or what is wrong with it.
type Expanded = struct {
    text: str
    error: str
}

// `word` with each `${NAME}` replaced by what link.cfg (or link.local.cfg)
// sets NAME to, which must be one word. Any other `$` is an error, so that
// `$(NAME)` and `$NAME` are not taken for what they are not.
func expand_word(anon word: str, vars: LinkVars) -> Expanded {
    mut parts: [str] = []
    mut copied: int64 = 0
    mut i: int64 = 0
    for i < len(word) {
        if word[i] != '$' {
            i = i + 1
        } else {
            let name: str = braced_name(word, at: i)
            if len(name) == 0 {
                return Expanded(text: "", error: "a `$` must start `${NAME}` (capital letters, digits and _)")
            }
            if link_has(vars, :name) == false {
                return Expanded(text: "", error: "`${" + name + "}` is not set in link.cfg or link.local.cfg")
            }
            let value: [str] = split_words(link_value(vars, :name))
            if len(value) != 1 {
                return Expanded(text: "", error: "`${" + name + "}` must be one word to be used in a directive")
            }
            parts += [word[copied..i], value[0]]
            i = i + len(name) + 3
            copied = i
        }
    }
    parts += [word[copied..len(word)]]
    return Expanded(text: joined(parts, sep: ""), error: "")
}

// `parts` joined by `sep`, put together by halves: n parts cost n log n
// bytes, where adding them one at a time would cost n squared (the arena
// frees nothing), more than a long word or hint can afford.
func joined(anon parts: [str], sep: str) -> str {
    if len(parts) == 0 {
        return ""
    }
    if len(parts) == 1 {
        return parts[0]
    }
    let half: int64 = len(parts) / 2
    return joined(parts[0..half], :sep) + sep + joined(parts[half..len(parts)], :sep)
}

// The words of `words`, joined by single spaces.
func join_words(anon words: [str]) -> str {
    return joined(words, sep: " ")
}

// Is `file` the name of a C file beside a module: no directory, ends in `.c`?
func is_c_file_name(anon file: str) -> bool {
    if len(file) <= 2 or ends_with(file, suffix: ".c") == false {
        return false
    }
    return file.contains("/") == false
}

// One `// kod:` line of a module at `path`, without the `// kod:`: what it
// declares goes into `into`; the result is "" or what is wrong with it.
func read_link_decl(anon rest: str, path: str, line: int64, vars: LinkVars, into: LinkDecls) -> str {
    if has_control_byte(rest) {
        return "a tab or another control character in a directive line; its words are separated by spaces"
    }
    mut end: int64 = 0
    for end < len(rest) and rest[end] != ' ' {
        end = end + 1
    }
    let name: str = rest[0..end]
    if len(name) == 0 {
        return "a directive is `// kod:` and its name with no space between, as in `// kod:link -lz`"
    }
    if name != "cc" and name != "link" and name != "require" {
        return f"unknown directive kod:{name}"
    }
    mut words: [str] = []
    for word in split_words(rest[end..len(rest)]) {
        let e: Expanded = expand_word(word, :vars)
        if len(e.error) > 0 {
            return e.error
        }
        words += [e.text]
    }
    if len(words) == 0 {
        if name == "cc" {
            return "kod:cc needs the name of a C file"
        }
        if name == "link" {
            return "kod:link needs at least one argument"
        }
        return "kod:require needs the file that must exist"
    }
    if name == "link" {
        for w in words {
            into.link += [w]
        }
        return ""
    }
    if name == "require" {
        into.require += [RequireDecl(file: words[0], hint: join_words(words[1..len(words)]), :line)]
        return ""
    }
    if is_c_file_name(words[0]) == false {
        return f"kod:cc names `{words[0]}`, which is not the name of a .c file beside the module (a bare name that ends in .c)"
    }
    into.cc += [CcDecl(file: normalize_path(dirname(path) + words[0]), flags: words[1..len(words)], :line)]
    return ""
}

// What the module at `path`, whose text is `source`, declares in the comment
// lines at its top; `vars` is the link configuration for `${NAME}`. Only the
// leading block is read: the lines from the top that are blank or comments.
// In it a line that starts with `// kod:` (after any indent) is a directive,
// and one that is spelled like it but not so (`//kod:`, `// Kod:`) is an error.
func parse_link_decls(path: str, source: str, vars: LinkVars) -> LinkDecls {
    let decls: LinkDecls = LinkDecls(cc: [], link: [], require: [], errors: [], first: 0)
    mut number: int64 = 0
    for raw in lines_of(leading_block(without_bom(source))) {
        number = number + 1
        let text: str = trim_indent(without_cr(raw))
        if starts_with(text, prefix: "// kod:") {
            if decls.first == 0 {
                decls.first = number
            }
            let error: str = read_link_decl(text[7..len(text)], :path, line: number, :vars, into: decls)
            if len(error) > 0 {
                decls.errors += [cfg_error(:path, line: number, col: 1, message: error)]
            }
        } else if looks_like_directive(text) {
            if decls.first == 0 {
                decls.first = number
            }
            decls.errors += [cfg_error(:path, line: number, col: 1, message: "a directive is written `// kod:name`, in lower case, with one space after the slashes and none before the colon")]
        }
    }
    return decls
}
