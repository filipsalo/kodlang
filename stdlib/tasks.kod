// kod:cc tasks.c

// Tasks: calls that run on stacks of their own and take turns on the one
// thread (docs/tasks.md). The stacks and the switch are in tasks.c; which
// task runs next is decided here.

import "kod/inspect"
import "libc"
import "panics"
import "stream" { IoError }
import "time" { Duration }
import "unsafe"

extern func kod_task_stack_new() -> int64
extern func kod_task_stack_free(anon base: int64) -> none
extern func kod_task_ctx_new() -> int64
extern func kod_task_ctx_free(anon ctx: int64) -> none
extern func kod_task_ctx_init(anon ctx: int64, anon base: int64) -> none
extern func kod_task_switch(anon from: int64, anon to: int64) -> none
extern func kod_task_kq_add(anon ident: int64, anon filter: int64, anon data: int64, anon key: int64) -> int64
extern func kod_task_fd_key(anon fd: int64, anon writes: int64) -> int64
extern func kod_task_kq_drop_timer(anon key: int64) -> none
extern func kod_task_kq_wait(anon block: int64) -> int64
extern func kod_task_kq_key(anon i: int64) -> int64
extern func kod_task_kq_failed(anon i: int64) -> int64
extern func kod_task_kq_data(anon i: int64) -> int64
extern func kod_task_set_room(anon room: int64) -> none
extern func kod_task_hook() -> none
extern func kod_task_set_now(anon stack: int64) -> none
extern func kod_panic_uncaught(anon msg: str) -> none
extern func kod_eprint(anon s: str) -> none
extern func kod_sim_set_clock(anon ns: int64) -> none
extern func kod_sim_set_epoch(anon ns: int64) -> none
extern func kod_poll_set(anon flag: int64, anon budget: int64, anon store_budget: int64) -> none
extern func kod_poll_simulate(anon on: int64) -> none
extern func kod_poll_after_store() -> int64
extern func kod_sim_reach(anon job: Job) -> none
extern func kod_sim_set_random(anon on: int64, anon seed: int64) -> none
extern func _inspect_caller_fp() -> int64
extern func _inspect_read_i64(anon addr: int64) -> int64

// kevent's filters.
let EVFILT_READ: int64 = -1
let EVFILT_WRITE: int64 = -2
let EVFILT_TIMER: int64 = -7

// What a task runs: its Task, whatever its result's type.
interface Job {
    func run(self) -> none
}

// A task as the scheduler sees it: its saved registers, its stack (0 for the
// program's first one, which has the thread's own), what it runs, and the
// tasks waiting for it to end.
type Fiber = shared struct {
    ctx: int64
    stack: int64 = 0
    job: Job? = none
    done: bool = false
    waiters: [Fiber] = []
    // In the ready queue: made ready again, it isn't queued twice. A task woken
    // for nothing (a channel's list can name one that has gone on) finds what
    // it waits for not there yet and waits again: every wait is a loop.
    queued: bool = false
    // Cancelled (wait_group): its waits for I/O give `.Cancelled`, its sleeps
    // and channel waits give up.
    cancelled: bool = false
    // The key of the kevent registration it waits on, 0 for none.
    io_key: int64 = 0
    // The descriptor it waited for has been closed.
    io_closed: bool = false
    io_failed: bool = false
    // What the event that came said: for a write, how much there is room for.
    io_data: int64 = 0
    // Under a simulation that schedules by priority, its priority: drawn when
    // it is first ready, lowered below every other when it is preempted.
    prio: int64 = 0
    // Where it was spawned (_spawn_trace).
    spawned_at: [int64] = []
    // The panic that ended it, and the group that takes it, when the function it
    // belongs to runs under a catch (docs/panics.md#tasks).
    failed: panics.Panic? = none
    group: TaskGroup? = none
    // The groups of its functions with a panic it is still to go on with, which it
    // does at its next wait; not while it waits for the tasks of an abandoned
    // function (_unwind_group).
    hurt: [TaskGroup] = []
    unwinding: int64 = 0
}

// The task that is running, made for the program's first one when first
// asked for.
mut _current: Fiber? = none

// Tasks ready to run, from `_head` on, in the order they became ready.
mut _ready: [Fiber] = []
mut _head: int64 = 0

// Tasks that have ended, whose stacks the next task to run frees.
mut _dead: [Fiber] = []

// Tasks that haven't ended, the program's first one included: while it is the
// only one, a call that would block just blocks (_wait_event).
mut _live: int64 = 1
mut _hooked: bool = false

// Tasks waiting for a kevent event, by the key their registration carries.
mut _io: Map[int64, Fiber] = Map[int64, Fiber]()
mut _io_next: int64 = 0

// The registers of the switch a task that ends makes: no reference stays in
// its frame, which never returns.
mut _leave_from: int64 = 0
mut _leave_to: int64 = 0

// A task started by `start`, and what it gave back once it has ended.
type Task[T] = shared struct {
    fiber: Fiber
    body: func() -> T
    // Empty until the task ends; then what it gave back.
    results: [T] = []

    func run(self) -> none {
        self.results = [self.body()]
    }

    // What the task gave back; until it has ended, this task waits for it.
    func wait(self) -> T {
        _wait_for(self.fiber)
        _raise_failed(self.fiber)
        return self.results[0]
    }

    // Cancels the task, unless it has ended (docs/tasks.md#cancellation).
    func cancel(self) -> none {
        _cancel(self.fiber)
    }
}

// Runs `body` as a new task, which first runs the next time this one waits
// or gives way. `spawn` calls it with the group of the function it is in
// (none for `spawn detached`).
func start[T](anon body: func() -> T, group: TaskGroup? = none) -> Task[T] {
    let fiber = _new_fiber()
    let task = Task[T](:fiber, :body)
    fiber.job = task
    _reached(task)
    _join(fiber, :group)
    _make_ready(fiber)
    return task
}

// A task started by `start_none`, whose body gives back nothing (`none` can't
// be a type argument, so it isn't a `Task[none]`).
type NoneTask = shared struct {
    fiber: Fiber
    body: func() -> none

    func run(self) -> none {
        self.body()
    }

    // Until the task has ended, this task waits for it.
    func wait(self) -> none {
        _wait_for(self.fiber)
        _raise_failed(self.fiber)
    }

    func cancel(self) -> none {
        _cancel(self.fiber)
    }
}

// As `start`, for a body that gives back nothing.
func start_none(anon body: func() -> none, group: TaskGroup? = none) -> NoneTask {
    let fiber = _new_fiber()
    let task = NoneTask(:fiber, :body)
    fiber.job = task
    _reached(task)
    _join(fiber, :group)
    _make_ready(fiber)
    return task
}

// Under a simulation, what a new task's body refers to (the arguments `spawn`
// passed, what it captured) other tasks can now reach: stores to it count
// (stdlib/runtime.c, kod_sim_reach).
func _reached(anon job: Job) -> none {
    if _sim is _Sim {
        kod_sim_reach(job)
    }
}

// The tasks a function has started with `spawn`: codegen keeps the group in a
// hidden local (`#group`), made by the first `spawn` that runs, and waits for
// it where the function returns.
type TaskGroup = shared struct {
    fibers: [Fiber] = []
    // How many `fibers` there are to be before those that have ended are dropped.
    sweep_at: int64 = 64
    // The task whose function it is, and the catch that function runs under (0
    // for none): where a panic in one of its tasks goes.
    owner: Fiber
    catch: int64 = 0
    // The panic of the first of its tasks to have one, until `owner` goes on
    // with it.
    failed: panics.Panic? = none
}

func _new_group() -> TaskGroup {
    return TaskGroup(owner: _running(), catch: panics.here())
}

// `group`, or a new one when there is none yet. Optional both ways, as the
// hidden local that holds it is, which is none until the first `spawn` runs.
func group_of(anon group: TaskGroup?) -> TaskGroup? {
    if group is none {
        return _new_group()
    }
    return group
}

// Waits for each task in `group` that hasn't ended, cancelling them first when
// `cancel` (codegen: when the function returns an error).
func wait_group(anon group: TaskGroup?, anon cancel: bool) -> none {
    let Some(g) = group else {
        return
    }
    if cancel {
        for fiber in g.fibers {
            _cancel(fiber)
        }
    }
    for fiber in g.fibers {
        _wait_for(fiber)
    }
    g.fibers = []
    if g.failed is panics.Panic(p) {
        _take_failed(g)
        panics.again_at(p, catch: g.catch)
    }
}

// A caught panic abandons the function `group` belongs to (runtime.c,
// kod_unwind_frame): its tasks are cancelled and waited for, and any panic of
// theirs is part of it.
func _unwind_group(anon group: TaskGroup?) -> none {
    let Some(g) = group else {
        return
    }
    let me = _running()
    me.unwinding += 1
    for fiber in g.fibers {
        _cancel(fiber)
    }
    for fiber in g.fibers {
        _wait_for(fiber)
    }
    g.fibers = []
    _take_failed(g)
    me.unwinding -= 1
}

// Forgets the panic `group` has.
func _take_failed(anon group: TaskGroup) -> none {
    group.failed = none
    mut kept: [TaskGroup] = []
    for g in group.owner.hurt {
        if g.failed is panics.Panic(_p) {
            kept += [g]
        }
    }
    group.owner.hurt = kept
}

// `fiber`, a task of a function that runs under a catch, has panicked: the task
// that function is in goes on with it when it next waits, so is woken if it
// waits now.
func _fail(anon fiber: Fiber, anon p: panics.Panic, group: TaskGroup) -> none {
    fiber.failed = p
    if group.failed is panics.Panic(_first) {
        return
    }
    group.failed = p
    let owner = group.owner
    owner.hurt += [group]
    if owner.unwinding == 0 {
        _wake(owner)
    }
}

// After a wait: goes on with a panic of one of this task's own tasks.
func _raise_hurt(anon me: Fiber) -> none {
    if len(me.hurt) == 0 or me.unwinding > 0 {
        return
    }
    let group = me.hurt[0]
    if group.failed is panics.Panic(p) {
        _take_failed(group)
        panics.again_at(p, catch: group.catch)
    }
}

// Goes on with the panic that ended `fiber`, if one did.
func _raise_failed(anon fiber: Fiber) -> none {
    if fiber.failed is panics.Panic(p) {
        panics.again(p)
    }
}

// Marks `fiber` cancelled and wakes it if it waits, forgetting the event it
// waited for.
func _cancel(anon fiber: Fiber) -> none {
    if fiber.done or fiber.cancelled {
        return
    }
    fiber.cancelled = true
    _wake(fiber)
}

// Makes `fiber` ready, forgetting the event it waits for.
func _wake(anon fiber: Fiber) -> none {
    if fiber.io_key != 0 {
        let _gone = _io.remove(fiber.io_key)
        fiber.io_key = 0
    }
    _make_ready(fiber)
}

func _join(anon fiber: Fiber, group: TaskGroup?) -> none {
    if group is TaskGroup(g) {
        g.fibers += [fiber]
        // A loop that spawns for as long as it runs keeps only those running.
        if len(g.fibers) >= g.sweep_at {
            mut running: [Fiber] = []
            for f in g.fibers {
                if not f.done {
                    running += [f]
                }
            }
            g.fibers = running
            g.sweep_at = 64 + 2 * len(running)
        }
        if g.catch != 0 {
            fiber.group = g
        }
    }
}

// Lets the tasks that are ready run, then goes on.
func give_way() -> none {
    // Tasks whose event has come are ready too, so I/O doesn't wait for a busy task.
    if _io.len() > 0 {
        _poll(false)
    }
    if _head == len(_ready) {
        return
    }
    let me = _running()
    _make_ready(me)
    _switch_from(me)
}

// Whether the running task is cancelled: for a loop whose waits can't fail, such
// as a sleep, to end by.
func cancelled() -> bool {
    return _running().cancelled
}

func _new_fiber() -> Fiber {
    if not _hooked {
        kod_task_hook()
        _hooked = true
    }
    _live += 1
    let stack = kod_task_stack_new()
    if stack == 0 {
        panic("tasks: no room for another task's stack")
    }
    let fiber = Fiber(ctx: kod_task_ctx_new(), :stack, spawned_at: _spawn_trace())
    kod_task_ctx_init(fiber.ctx, stack)
    if _sim is _Sim(sim) and sim.first is Fiber(_first) {
        sim.fibers += [fiber]
    }
    return fiber
}

// Where the running task spawns one: the return addresses of the calls it is
// in (at most 16), then 0 and where it was spawned itself, at most 64 in all.
// Only the addresses: _print_spawn_trace looks them up after a panic.
func _spawn_trace() -> [int64] {
    mut pcs: [int64] = []
    mut fp = _inspect_caller_fp()
    for fp != 0 and len(pcs) < 16 {
        let next = _inspect_read_i64(fp)
        if next == 0 {
            break
        }
        pcs += [_inspect_read_i64(fp + 8)]
        if next <= fp {
            break
        }
        fp = next
    }
    let outer = _running().spawned_at
    if len(outer) > 0 {
        pcs += [0]
        mut keep = 63 - len(pcs)
        if keep > len(outer) {
            keep = len(outer)
        }
        pcs += outer[0..keep]
    }
    return pcs
}

// After a panic's backtrace (tasks.c sets the hook): where the running task
// was spawned, and where the one that spawned it was, and so on.
func _print_spawn_trace() -> none {
    if _current is none {
        return
    }
    let me = _current
    mut header_due = true
    mut skipping = false
    mut i: int64 = 0
    for pc in me.spawned_at {
        if pc == 0 {
            header_due = true
            skipping = false
            continue
        }
        if skipping {
            continue
        }
        if inspect.resolve(addr: pc) is inspect.Frame(f) {
            // Below a test is only the test runner.
            if f.name == inspect.TEST_RUNNER {
                skipping = true
                continue
            }
            if f.file == "stdlib/tasks.kod" {
                continue
            }
            if header_due {
                kod_eprint("spawned at:")
                header_due = false
                i = 0
            }
            kod_eprint(f"  #{i}  {f.name} ({f.file}:{f.line})")
            i += 1
        }
    }
}

func _running() -> Fiber {
    if _current is none {
        _current = Fiber(ctx: kod_task_ctx_new())
    }
    return must _current
}

func _make_ready(anon fiber: Fiber) -> none {
    if fiber.queued or fiber.done {
        return
    }
    fiber.queued = true
    _ready += [fiber]
}

// The next ready task, taken off the queue. While there is none, it waits for
// the events tasks wait for; with none of those either, every task waits for
// another, and none can go on.
func _take_next() -> Fiber {
    _scheduling += 1
    for true {
        for _head == len(_ready) {
            if _io.len() == 0 {
                kod_panic_uncaught("all tasks are asleep: deadlock")
            }
            _poll(true)
        }
        // A simulation looks for I/O that has come at every switch, as the
        // kernel would have woken those tasks meanwhile, and picks one of the
        // ready tasks by its seed, or the one with the highest priority.
        if _sim is _Sim and _io.len() > 0 {
            _poll(false)
        }
        if _sim is _Sim(sim) and len(_ready) - _head > 1 {
            mut k = _head
            if sim.by_priority {
                for i in _head.._head + len(_ready) - _head {
                    let f = _ready[i]
                    if f.prio == 0 {
                        f.prio = 1 + _sim_rand(1 << 40)
                    }
                    if f.prio > _ready[k].prio {
                        k = i
                    }
                }
            } else {
                k = _head + _sim_rand(len(_ready) - _head)
            }
            let t = _ready[_head]
            _ready[_head] = _ready[k]
            _ready[k] = t
        }
        let next = _ready[_head]
        next.queued = false
        _head += 1
        // Drop what has been taken once it is most of the queue.
        if _head >= 64 and _head * 2 >= len(_ready) {
            _ready = _ready[_head..len(_ready)]
            _head = 0
        }
        // A task that made itself ready (a channel it had waited on still named
        // it when it closed the channel) may have ended since.
        if not next.done {
            _scheduling -= 1
            return next
        }
    }
    _scheduling -= 1
    return _running()
}

// Switches from `me`, the running task, to the next ready one, and comes
// back here when `me` runs again.
func _switch_from(anon me: Fiber) -> none {
    let next = _take_next()
    _current = next
    kod_task_set_now(next.stack)
    kod_task_switch(me.ctx, next.ctx)
    _reap()
}

// As _switch_from, for a wait: a panic of one of this task's own tasks ends it.
func _wait_turn(anon me: Fiber) -> none {
    _raise_hurt(me)
    _switch_from(me)
    _raise_hurt(me)
}

// Frees the stacks of tasks that have ended; none of them is running.
func _reap() -> none {
    if len(_dead) == 0 {
        return
    }
    for fiber in _dead {
        kod_task_stack_free(fiber.stack)
        kod_task_ctx_free(fiber.ctx)
    }
    _dead = []
}

// Waits, as the running task, for `fiber` to end.
func _wait_for(anon fiber: Fiber) -> none {
    let me = _running()
    _raise_hurt(me)
    for not fiber.done {
        fiber.waiters += [me]
        _wait_turn(me)
    }
}

// A new task's first turn (tasks.c calls it on the task's stack): runs it,
// readies those waiting for it, and switches away for good.
func _run_current() -> none {
    _reap()
    _finish()
    kod_task_switch(_leave_from, _leave_to)
}

func _finish() -> none {
    let fiber = must _current
    let job = must fiber.job
    // The Task holds the Fiber; the Fiber lets go of the Task, so neither
    // keeps the other.
    fiber.job = none
    if fiber.group is TaskGroup(group) {
        if panics.run(func() { job.run() }) is panics.Panic(p) {
            _fail(fiber, p, :group)
        }
        fiber.group = none
    } else {
        job.run()
    }
    _live -= 1
    fiber.done = true
    for waiter in fiber.waiters {
        _make_ready(waiter)
    }
    fiber.waiters = []
    _dead += [fiber]
    let next = _take_next()
    _current = next
    kod_task_set_now(next.stack)
    _leave_from = fiber.ctx
    _leave_to = next.ctx
}

// The ticker set the flag (_poll_due): the running task has run for a while
// without waiting, and lets those that are ready run.
func _preempt() -> none {
    // In the scheduler (_take_next, _poll) a turn given away would run the
    // scheduler inside itself: a second _poll overwrites the events the first
    // is still handing out, and the tasks they were for never wake.
    // A simulation decides itself where tasks give way.
    if _scheduling > 0 or _sim is _Sim {
        return
    }
    give_way()
}

// A loop's check found the flag set and the countdown out (runtime.c,
// kod_poll_stub): every 10 ms, the running task gives way; under a
// simulation, after as many checks as the seed says, counting on.
func _poll_due() -> none {
    if _sim is _Sim(sim) {
        kod_poll_set(1, _sim_budget(sim), _sim_store_budget(sim))
        if _scheduling > 0 {
            return
        }
        // Looking for what I/O has come takes system calls, which a seed
        // that preempts every few checks would make most of the run: done
        // one time in 16, so a task waiting for I/O wakes a little later, but
        // always right after a store, where another task is most likely to
        // see what this one is in the middle of.
        let after_store = kod_poll_after_store() != 0
        if _io.len() > 0 and (after_store or _sim_rand(16) == 0) {
            _poll(false)
        }
        if _head == len(_ready) {
            return
        }
        let me = _running()
        if sim.by_priority {
            sim.lowest -= 1
            me.prio = sim.lowest
        }
        _make_ready(me)
        _switch_from(me)
        return
    }
    kod_poll_set(0, 1, _NEVER)
    _preempt()
}

// A countdown that doesn't run out.
let _NEVER: int64 = 1 << 62

// How deep the running code is in the scheduler's own loops, which no
// preemption may interrupt (_preempt).
mut _scheduling: int64 = 0

// Tasks waiting for a module variable's initializer, which another task runs,
// by the variable's cell (runtime.c, kod_var_busy).
mut _var_waiters: Map[int64, [Fiber]] = Map[int64, [Fiber]]()

// Waits, as the running task, until the cell's initializer is over, or for
// nothing: kod_var_busy looks again.
func _wait_var(anon cell: int64) -> none {
    let me = _running()
    _var_waiters[cell] = (_var_waiters.get(cell)? or []) + [me]
    _switch_from(me)
}

func _wake_var(anon cell: int64) -> none {
    let none_waiting: [Fiber] = []
    for fiber in _var_waiters.remove(cell)? or none_waiting {
        _make_ready(fiber)
    }
}

// Carries values from tasks that send to tasks that receive, in order
// (docs/tasks.md). A sender adds its value and then waits until at most
// `capacity` of the values sent up to its own are still to be received: with
// 0, until its own is.
type Channel[T] = shared struct {
    capacity: int64 = 0
    // Sent and not received: `items` from `head` on.
    items: [T] = []
    head: int64 = 0
    sent: int64 = 0
    taken: int64 = 0
    closed: bool = false
    // The panic that ended the generator whose channel it is.
    failed: panics.Panic? = none
    // Tasks waiting to receive, and to have what they sent received.
    receivers: [Fiber] = []
    senders: [Fiber] = []

    func send(self, anon value: T) -> none {
        if self.closed {
            panic("send on a closed channel")
        }
        // A cancelled task's send isn't made.
        if _running().cancelled {
            return
        }
        self.items += [value]
        self.sent += 1
        let ticket = self.sent
        self.receivers = _wake_all(self.receivers)
        for self.taken < ticket - self.capacity and not _running().cancelled {
            if self.closed {
                panic("send on a closed channel")
            }
            self.senders += [_running()]
            _park()
        }
    }

    // Adds `value` if the channel is open and has room; whether it did.
    func send_now(self, anon value: T) -> bool {
        if self.closed or len(self.items) - self.head >= self.capacity {
            return false
        }
        self.items += [value]
        self.sent += 1
        self.receivers = _wake_all(self.receivers)
        return true
    }

    // The next value, once there is one; none once the channel is closed and
    // every value has been received.
    func receive(self) -> T? {
        if self.has_next() {
            return self.take()
        }
        return none
    }

    // Waits until a value can be received, or the channel is closed and empty;
    // whether one can. `for v in ch` is `has_next` and `take`: nothing runs
    // between them, since a task gives way only where it waits.
    func has_next(self) -> bool {
        for self.head == len(self.items) and not self.closed and not _running().cancelled {
            self.receivers += [_running()]
            // A `select` that waits to send sees a receiver come.
            self.senders = _wake_all(self.senders)
            _park()
        }
        self.raise_failed()
        return self.head < len(self.items)
    }

    // The next value if there is one now, without waiting; none otherwise.
    func receive_now(self) -> T? {
        if self.head < len(self.items) {
            return self.take()
        }
        self.raise_failed()
        return none
    }

    // Once every value is received, the generator's panic, if it had one.
    func raise_failed(self) -> none {
        if self.head == len(self.items) and self.failed is panics.Panic(p) {
            panics.again(p)
        }
    }

    // For `select` (Selectable).
    func ready_to_receive(self) -> bool {
        return self.head < len(self.items) or self.closed
    }

    func ready_to_send(self) -> bool {
        return self.closed or self.sent - self.taken < self.capacity or len(self.receivers) > 0
    }

    func wait_to_receive(self, anon fiber: Fiber) -> none {
        self.receivers += [fiber]
    }

    func wait_to_send(self, anon fiber: Fiber) -> none {
        self.senders += [fiber]
    }

    // The next value, which `has_next` said is there.
    func take(self) -> T {
        let value = self.items[self.head]
        self.head += 1
        self.taken += 1
        if self.head >= 64 and self.head * 2 >= len(self.items) {
            self.items = self.items[self.head..len(self.items)]
            self.head = 0
        }
        self.senders = _wake_all(self.senders)
        return value
    }

    func close(self) -> none {
        if self.closed {
            panic("close of a closed channel")
        }
        self.closed = true
        self.receivers = _wake_all(self.receivers)
        self.senders = _wake_all(self.senders)
    }
}

// Makes each of `fibers` ready; gives back the empty list to keep.
func _wake_all(anon fibers: [Fiber]) -> [Fiber] {
    for fiber in fibers {
        _make_ready(fiber)
    }
    return []
}

// Waits, as the running task, until something makes it ready again.
func _park() -> none {
    _wait_turn(_running())
}

// kod_wait_event, once a task has been started (stdlib/runtime.c): makes the
// running task wait for the event while the others run, 1; or 0, and the
// caller blocks as it would without tasks, when this task is the only one or
// the event can't come (a child that has already exited, say); or 2 when the
// task is cancelled, and the caller gives up with `.Cancelled`; or 3 when the
// descriptor's limit of `data` nanoseconds passed first, and the caller gives
// up with `.TimedOut`; or 4 when another task has closed the descriptor.
func _wait_event(anon ident: int64, anon filter: int64, anon data: int64) -> int64 {
    let me = _running()
    if me.cancelled {
        return 2
    }
    if filter == 0 {
        // Under a simulation, a write that doesn't wait may let another task in.
        if _sim is _Sim and _sim_rand(2) == 0 {
            give_way()
        }
        return 0
    }
    if _live <= 1 and _sim is none {
        return 0
    }
    mut limit: int64 = 0
    mut event_data = data
    if filter == EVFILT_READ or filter == EVFILT_WRITE {
        limit = data
        event_data = 0
    }
    _io_next += 1
    let key = _io_next
    if _add_event(ident, filter, event_data, key) != 0 {
        return 0
    }
    // A limit is a timer of its own, whose event wakes the task as the other
    // does; _cancel forgets only `key`, which ends the wait too.
    mut timer_key: int64 = 0
    if limit > 0 {
        _io_next += 1
        timer_key = _io_next
        if _add_event(0, EVFILT_TIMER, limit, timer_key) == 0 {
            _io[timer_key] = me
        } else {
            timer_key = 0
        }
    }
    _io[key] = me
    me.io_key = key
    me.io_closed = false
    me.io_failed = false
    // _poll takes the key out when the event comes, _cancel when the task is.
    for _io.contains(key) and (timer_key == 0 or _io.contains(timer_key)) {
        _switch_from(me)
    }
    me.io_key = 0
    if len(me.hurt) > 0 {
        let _gone = _io.remove(key)
        _forget(timer_key)
        _raise_hurt(me)
    }
    let timed_out = timer_key != 0 and not _io.contains(timer_key) and _io.contains(key)
    // The event that didn't come may still: then it finds no one waiting.
    let _event = _io.remove(key)
    _forget(timer_key)
    if me.cancelled {
        return 2
    }
    if timed_out {
        return 3
    }
    if me.io_closed {
        return 4
    }
    if me.io_failed {
        return 0
    }
    kod_task_set_room(me.io_data)
    return 1
}

// The descriptor is about to be closed (runtime.c, kod_closing): the tasks that wait
// for it give up.
func _closing(anon fd: int64) -> none {
    if _sim is _Sim(sim) {
        for k, have in sim.open {
            if have == fd {
                sim.open[k] = -1
            }
        }
        for k, waited in sim.fds {
            if waited == fd and _io.remove(sim.fd_keys[k]) is Fiber(fiber) {
                fiber.io_closed = true
                _make_ready(fiber)
            }
        }
    }
    for writes in 0..2 {
        if _io.remove(kod_task_fd_key(fd, writes)) is Fiber(fiber) {
            fiber.io_closed = true
            _make_ready(fiber)
        }
    }
}

// Makes ready the tasks whose events have come, waiting for one when `block`.
func _poll(anon block: bool) -> none {
    _scheduling += 1
    if _sim is _Sim(sim) {
        _sim_poll(sim, :block)
        _scheduling -= 1
        return
    }
    mut wait: int64 = 0
    if block {
        wait = 1
    }
    let n = kod_task_kq_wait(wait)
    for i in 0..n {
        if _io.remove(kod_task_kq_key(i)) is Fiber(fiber) {
            fiber.io_data = kod_task_kq_data(i)
            fiber.io_failed = kod_task_kq_failed(i) != 0
            _make_ready(fiber)
        }
    }
    _scheduling -= 1
}

// `body` as a task given at most `d`: what it gives back, or a `.TimedOut`
// error once `d` has passed, when the task is cancelled and waited for.
func within[T](anon d: Duration, anon body: func() -> T) -> T or Error {
    // Its tasks end with it, should it be abandoned.
    let group: TaskGroup? = _new_group()
    let task = start(body, :group)
    if not _wait_until_done(task.fiber, ns: d.ns) {
        _cancel(task.fiber)
        _wait_for(task.fiber)
        throw IoError(kind: .TimedOut, op: "within", errno: 0, detail: "timed out")
    }
    return task.wait()
}

// Waits, as the running task, until `fiber` has ended or `ns` have passed:
// whether it has ended.
func _wait_until_done(anon fiber: Fiber, ns: int64) -> bool {
    if fiber.done {
        return true
    }
    let me = _running()
    _io_next += 1
    let key = _io_next
    if _add_event(0, EVFILT_TIMER, ns, key) != 0 {
        _wait_for(fiber)
        return true
    }
    _io[key] = me
    for not fiber.done and _io.contains(key) {
        fiber.waiters += [me]
        _wait_turn(me)
    }
    _forget(key)
    return fiber.done
}

// Runs `job` as a new task, of the function `group` belongs to or of none: the
// helpers below wait for their tasks themselves.
func _start_job(anon job: Job, group: TaskGroup? = none) -> Fiber {
    let fiber = _new_fiber()
    fiber.job = job
    _join(fiber, :group)
    _make_ready(fiber)
    return fiber
}

// Waits, as the running task, until one of `fibers` has ended: its index.
func _wait_any(anon fibers: [Fiber]) -> int64 {
    _raise_hurt(_running())
    for true {
        for i, fiber in fibers {
            if fiber.done {
                return i
            }
        }
        let me = _running()
        for fiber in fibers {
            fiber.waiters += [me]
        }
        _wait_turn(me)
    }
    return -1
}

func _fibers_of[T](anon tasks: [Task[T]]) -> [Fiber] {
    mut out: [Fiber] = []
    for t in tasks {
        out += [t.fiber]
    }
    return out
}

// Cancels each of `fibers` and waits for them.
func _cancel_all(anon fibers: [Fiber]) -> none {
    for fiber in fibers {
        _cancel(fiber)
    }
    for fiber in fibers {
        _wait_for(fiber)
    }
}

// The indexes of `fibers` not in `seen`, in order.
func _unseen(anon seen: [bool]) -> [int64] {
    mut out: [int64] = []
    for i, s in seen {
        if not s {
            out += [i]
        }
    }
    return out
}

func _pick(anon fibers: [Fiber], anon at: [int64]) -> [Fiber] {
    mut out: [Fiber] = []
    for i in at {
        out += [fibers[i]]
    }
    return out
}

// Each of `fs` as a task: their results in order, or the first error to
// come, once the others are cancelled and have ended.
func all[T](anon fs: [func() -> T or Error]) -> [T] or Error {
    let group: TaskGroup? = _new_group()
    mut started: [Task[T or Error]] = []
    for f in fs {
        started += [start(f, :group)]
    }
    let fibers = _fibers_of(started)
    mut seen = [false] * len(fibers)
    for _ in 0..len(fibers) {
        let open = _unseen(seen)
        let k = open[_wait_any(_pick(fibers, open))]
        seen[k] = true
        let result = started[k].wait()
        if result is Err(e) {
            _cancel_all(fibers)
            throw e
        }
    }
    mut out: [T] = []
    for t in started {
        out += [must t.wait()]
    }
    return out
}

// Each of `fs` as a task: the first result that isn't an error, once the
// others are cancelled and have ended, or the last error when all fail.
func first[T](anon fs: [func() -> T or Error]) -> T or Error {
    let group: TaskGroup? = _new_group()
    mut started: [Task[T or Error]] = []
    for f in fs {
        started += [start(f, :group)]
    }
    let fibers = _fibers_of(started)
    mut seen = [false] * len(fibers)
    mut last: Error? = none
    for _ in 0..len(fibers) {
        let open = _unseen(seen)
        let k = open[_wait_any(_pick(fibers, open))]
        seen[k] = true
        let result = started[k].wait()
        if result is Err(e) {
            last = e
        } else {
            _cancel_all(fibers)
            return must result
        }
    }
    throw must last
}

// A generator's body as a job (generate): the channel, if a reader still
// holds it, is closed when the body ends.
type _Gen[T] = shared struct {
    gen: _GenRef[T]
    body: func() -> none
    // Whether it was made under a catch: its panic then goes to who receives.
    caught: bool

    func run(self) -> none {
        mut failed: panics.Panic? = none
        if self.caught {
            failed = panics.run(self.body)
        } else {
            self.body()
        }
        let Some(ch) = self.gen.ch else {
            if failed is panics.Panic(p) {
                kod_eprint(f"panic in a generator nothing receives from: {p.message}\n{p.backtrace}")
            }
            return
        }
        ch.failed = failed
        ch.close()
    }
}

// What a generator's body holds its channel by: weakly, so that the body runs
// only while a reader holds the channel (docs/tasks.md#generators).
type _GenRef[T] = shared struct {
    weak ch: Channel[T]?
    // The body's task while it waits in `give`, and whether it is on
    // _gen_waiting.
    waiting: Fiber? = none
    listed: bool = false

    // `yield value`: sends it and waits until it is received; true when the
    // body is to end instead, as no reader holds the channel any more or the
    // task is cancelled. Only `put` and `taken_yet` hold the channel, so it
    // isn't held while the task waits.
    func give(self, anon value: T) -> bool {
        let ticket = self.put(value)
        if ticket < 0 {
            return true
        }
        for true {
            let taken = self.taken_yet(ticket)
            if taken != 0 {
                return taken < 0
            }
            self.waiting = _running()
            if not self.listed {
                self.listed = true
                _gen_waiting += [self]
            }
            _park()
            self.waiting = none
        }
        return true
    }

    // Adds `value` to the channel, as `send` does: its ticket, or -1 when the
    // body is to end.
    func put(self, anon value: T) -> int64 {
        if _running().cancelled {
            return -1
        }
        let Some(ch) = self.ch else {
            return -1
        }
        if ch.closed {
            panic("send on a closed channel")
        }
        ch.items += [value]
        ch.sent += 1
        ch.receivers = _wake_all(ch.receivers)
        return ch.sent
    }

    // 1 once the value of `ticket` has been received, -1 when the body is to
    // end, else 0, the task waiting among the channel's senders.
    func taken_yet(self, anon ticket: int64) -> int64 {
        if _running().cancelled {
            return -1
        }
        let Some(ch) = self.ch else {
            return -1
        }
        if ch.closed {
            panic("send on a closed channel")
        }
        if ch.taken >= ticket - ch.capacity {
            return 1
        }
        ch.senders += [_running()]
        return 0
    }

    // Whether to stay on _gen_waiting: while the body waits for a reader;
    // one whose channel is gone is woken to end.
    func sweep(self) -> bool {
        if self.waiting is Fiber(fiber) {
            if self.ch is none {
                _make_ready(fiber)
            } else {
                return true
            }
        }
        self.listed = false
        return false
    }
}

// What _gen_waiting holds, whatever the channel's type.
interface _GenWaiting {
    func sweep(self) -> bool
}

// Generator bodies that have waited in a `yield`: those whose channel is gone
// are woken when the next generator starts (generate).
mut _gen_waiting: [_GenWaiting] = []

// The weak hold on `ch` its generator's body has.
func gen_ref[T](anon ch: Channel[T]) -> _GenRef[T] {
    return _GenRef[T](:ch)
}

// What a function with `yield` gives back (docs/tasks.md#generators): `body`
// runs as a task, belonging to no function, that sends on `ch` through `gen`;
// `ch` is closed when it ends. Bodies left waiting in a `yield` by a reader
// that let go of the channel are woken first, to end.
func generate[T](anon ch: Channel[T], anon gen: _GenRef[T], anon body: func() -> none) -> Channel[T] {
    if len(_gen_waiting) > 0 {
        mut kept: [_GenWaiting] = []
        for w in _gen_waiting {
            if w.sweep() {
                kept += [w]
            }
        }
        _gen_waiting = kept
    }
    let _fiber = _start_job(_Gen[T](:gen, :body, caught: panics.here() != 0))
    return ch
}

// `f(x)` as a job, which keeps its result.
type _Apply[T, U] = shared struct {
    f: func(T) -> U
    x: T
    results: [U] = []

    func run(self) -> none {
        self.results = [self.f(self.x)]
    }
}

// `f` of each of `xs`, in order, with at most `limit` calls running at a time
// (at least one).
func map_concurrently[T, U](anon xs: [T], anon f: func(T) -> U, limit: int64) -> [U] {
    mut jobs: [_Apply[T, U]] = []
    for x in xs {
        jobs += [_Apply[T, U](:f, :x)]
    }
    mut most = limit
    if most < 1 {
        most = 1
    }
    let group: TaskGroup? = _new_group()
    mut running: [Fiber] = []
    mut all_fibers: [Fiber] = []
    for job in jobs {
        if len(running) == most {
            let k = _wait_any(running)
            running = running[0..k] + running[k + 1..len(running)]
        }
        let fiber = _start_job(job, :group)
        running += [fiber]
        all_fibers += [fiber]
    }
    for fiber in all_fibers {
        _wait_for(fiber)
    }
    mut out: [U] = []
    for job in jobs {
        out += [job.results[0]]
    }
    return out
}

// For a value held across a wait (docs/tasks.md): `lock` waits until no other
// task holds it.
type Mutex = shared struct {
    held: bool = false
    waiters: [Fiber] = []

    func lock(self) -> none {
        for self.held {
            self.waiters += [_running()]
            _park()
        }
        self.held = true
    }

    func unlock(self) -> none {
        if not self.held {
            panic("unlock of a Mutex that isn't locked")
        }
        self.held = false
        self.waiters = _wake_all(self.waiters)
    }
}

// A channel as `select` sees it, whatever its values' type.
interface Selectable {
    func ready_to_receive(self) -> bool
    func ready_to_send(self) -> bool
    func wait_to_receive(self, anon fiber: Fiber) -> none
    func wait_to_send(self, anon fiber: Fiber) -> none
}

// What a `select` waits for (parsing.parse_select): its arms in order, each
// a receive (0), a send (1) or an `after` (2), with its channel or wait.
type Selector = shared struct {
    kinds: [int64] = []
    channels: [Selectable] = []
    // For each arm, its index in `channels`, or -1.
    channel_at: [int64] = []
    waits: [int64] = []

    func add_receive(self, anon ch: Selectable) -> none {
        self._add(0, :ch)
    }

    func add_send(self, anon ch: Selectable) -> none {
        self._add(1, :ch)
    }

    func _add(self, anon kind: int64, ch: Selectable) -> none {
        self.kinds += [kind]
        self.channel_at += [len(self.channels)]
        self.channels += [ch]
        self.waits += [0]
    }

    func add_after(self, anon d: Duration) -> none {
        self.kinds += [2]
        self.channel_at += [-1]
        self.waits += [d.ns]
    }

    // The arm to run: one that can go now, at random among those; -1 for
    // `else` when none can and there is one; else, once one can, waiting.
    func choose(self, anon has_else: bool) -> int64 {
        let me = _running()
        mut timer_key: int64 = 0
        mut timer_arm: int64 = -1
        for true {
            let ready = self._ready()
            if len(ready) > 0 {
                _forget(timer_key)
                return ready[_random(len(ready))]
            }
            if timer_key != 0 and not _io.contains(timer_key) {
                return timer_arm
            }
            if has_else {
                return -1
            }
            if me.cancelled {
                _forget(timer_key)
                return self._cancelled_arm()
            }
            if timer_key == 0 {
                timer_arm = self._soonest()
                if timer_arm >= 0 {
                    _io_next += 1
                    timer_key = _io_next
                    if _add_event(0, EVFILT_TIMER, self.waits[timer_arm], timer_key) != 0 {
                        return timer_arm
                    }
                    _io[timer_key] = me
                }
            }
            for i, kind in self.kinds {
                if kind == 0 {
                    self.channels[self.channel_at[i]].wait_to_receive(me)
                } else if kind == 1 {
                    self.channels[self.channel_at[i]].wait_to_send(me)
                }
            }
            _wait_turn(me)
        }
        return -1
    }

    func _ready(self) -> [int64] {
        mut ready: [int64] = []
        for i, kind in self.kinds {
            if kind == 0 and self.channels[self.channel_at[i]].ready_to_receive() {
                ready += [i]
            } else if kind == 1 and self.channels[self.channel_at[i]].ready_to_send() {
                ready += [i]
            }
        }
        return ready
    }

    // The `after` arm with the shortest wait, or -1.
    func _soonest(self) -> int64 {
        mut best: int64 = -1
        for i, kind in self.kinds {
            if kind == 2 and (best < 0 or self.waits[i] < self.waits[best]) {
                best = i
            }
        }
        return best
    }

    // A cancelled task's `select`: its first receive, else its first `after`,
    // else `else`.
    func _cancelled_arm(self) -> int64 {
        for i, kind in self.kinds {
            if kind == 0 {
                return i
            }
        }
        return self._soonest()
    }
}

// Forgets a timer, taking it from kevent too if it has yet to come.
func _forget(anon key: int64) -> none {
    if key != 0 and _io.remove(key) is Fiber(_waiting) {
        if _sim is none {
            kod_task_kq_drop_timer(key)
        }
    }
}

// Picks among ready `select` arms (a linear congruential generator).
mut _seed: int64 = 12345

func _random(anon n: int64) -> int64 {
    _seed = (_seed * 1103515245 + 12345) % 2147483648
    return (_seed / 65536) % n
}

// ---- simulation (stdlib/sim.kod, docs/simulation.md) ----

// A run under a seed: the generator its choices come from, a number that
// stands for them all, and the simulated clock. What tasks wait for is
// noted here instead of in the kqueue: for a descriptor, its number, 1 for
// room to write (0 for something to read) and the event's key; for a time,
// when it is due and the key.
type _Sim = shared struct {
    seed: int64
    state: int64
    digest: int64 = 0
    now: int64 = 0
    fds: [int64] = []
    writes: [int64] = []
    fd_keys: [int64] = []
    due: [int64] = []
    timer_keys: [int64] = []
    // What the simulation's network made, for its end to tidy up: socket
    // paths, and the descriptors not closed yet.
    paths: [str] = []
    open: [int64] = []
    // How long tasks run before they are preempted: each time after 1 to
    // 2^(b + 1) loop checks, b from 0 to `rate`; and how many checks that
    // come right after a store to what other tasks can reach, the same way
    // with `store_rate`.
    rate: int64 = 0
    store_rate: int64 = 0
    // Ready tasks are picked by priority (PCT: probabilistic concurrency
    // testing), a preempted task's dropping below the others, instead of
    // at random; and the lowest priority given so far.
    by_priority: bool = false
    lowest: int64 = 0
    // While a body that may crash runs (sim_crashable), the task that waits
    // for it, and every task started since: those a crash stops.
    first: Fiber? = none
    fibers: [Fiber] = []
}

mut _sim: _Sim? = none
// One more for each simulation, so that what a module keeps for one (as
// net/tcp its listeners) is known to be from an earlier one.
mut _sim_gen: int64 = 0

let _POLLIN: int64 = 1
let _POLLOUT: int64 = 4

func simulating() -> bool {
    return _sim is _Sim
}

func sim_generation() -> int64 {
    return _sim_gen
}

func sim_seed() -> int64 {
    if _sim is _Sim(sim) {
        return sim.seed
    }
    return -1
}

// Starts a simulation under `seed`, its calendar at `epoch_ns` (since 1970);
// the running task is the only one.
func sim_begin(anon seed: int64, epoch_ns: int64) -> none {
    if _sim is _Sim {
        panic("sim: a simulation is under way already")
    }
    if _live > 1 {
        panic("sim: a simulation starts with no other task running")
    }
    if not _hooked {
        kod_task_hook()
        _hooked = true
    }
    _sim_gen += 1
    let sim = _Sim(:seed, state: seed.wrapping_mul(-7046029254386353131).wrapping_add(1))
    _sim = sim
    kod_sim_set_epoch(epoch_ns)
    kod_sim_set_clock(0)
    // The longest a task runs before it is preempted: 32 checks under some
    // seeds, some hundred thousand under others.
    sim.rate = 4 + _sim_rand(14)
    // Right after such a store: under some seeds at the next check, under
    // others after a hundred or so.
    sim.store_rate = _sim_rand(7)
    sim.by_priority = _sim_rand(2) == 0
    // By priority a task runs long, preempted mostly right after its stores,
    // which is what lets another fall behind, ready, as on a busy machine.
    if sim.by_priority {
        sim.rate = 14 + _sim_rand(5)
    }
    // The running task's priority is from an earlier run, if any.
    _running().prio = 0
    kod_sim_set_random(1, seed)
    kod_poll_simulate(1)
    kod_poll_set(1, _sim_budget(sim), _sim_store_budget(sim))
}

// How many checks right after a store until the running task is preempted.
func _sim_store_budget(anon sim: _Sim) -> int64 {
    return 1 + _sim_rand(1 << _sim_rand(sim.store_rate + 1))
}

// How many loop checks until the running task is next preempted: as likely
// a few as some thousands.
func _sim_budget(anon sim: _Sim) -> int64 {
    return 1 + _sim_rand(2 << _sim_rand(sim.rate + 1))
}

// A socket path the simulation's network made (net/tcp), removed at its end.
func sim_note_path(anon path: str) -> none {
    if _sim is _Sim(sim) {
        sim.paths += [path]
    }
}

// A descriptor the simulation's network made, closed at its end if a run that
// failed left it open.
func sim_note_fd(anon fd: int64) -> none {
    if _sim is _Sim(sim) {
        sim.open += [fd]
    }
}

// Ends the simulation: the number that stands for its choices.
func sim_end() -> int64 {
    mut digest = 0
    if _sim is _Sim(sim) {
        digest = sim.digest
        for fd in sim.open {
            if fd >= 0 {
                libc.close(fd)
            }
        }
        for path in sim.paths {
            libc.unlink(unsafe.c_str(path))
        }
        // What a run that failed left waiting.
        for key in sim.fd_keys {
            let _gone = _io.remove(key)
        }
        for key in sim.timer_keys {
            let _gone = _io.remove(key)
        }
    }
    _sim = none
    _scheduling = 0
    kod_sim_set_random(0, 0)
    kod_poll_simulate(0)
    kod_poll_set(0, 1, _NEVER)
    kod_sim_set_clock(-1)
    return digest
}

// Runs `body` as a task, which a crash (sim_crash) may stop where it is: the
// panic it ended with, or none.
func sim_crashable(anon body: func() -> none) -> panics.Panic? {
    let sim = must _sim
    sim.first = _running()
    mut failed: panics.Panic? = none
    let task = start_none(func() { failed = panics.run(body) })
    _wait_for(task.fiber)
    sim.first = none
    sim.fibers = []
    return failed
}

// The power is cut (stdlib/simdisk.kod): every task sim_crashable started,
// and those they started, stops where it is, never to run again, and the
// task that waits for them goes on. What they hold isn't let go of.
func sim_crash() -> none {
    let sim = must _sim
    let first = must sim.first
    let me = _running()
    for fiber in sim.fibers {
        if fiber.done {
            continue
        }
        fiber.done = true
        fiber.cancelled = true
        fiber.queued = false
        fiber.waiters = []
        _live -= 1
        _dead += [fiber]
    }
    sim.fibers = []
    _ready = []
    _head = 0
    _io = Map[int64, Fiber]()
    _var_waiters = Map[int64, [Fiber]]()
    sim.fds = []
    sim.writes = []
    sim.fd_keys = []
    sim.due = []
    sim.timer_keys = []
    _scheduling = 0
    sim_reboot()
    // As a task that ends (_finish): its stack is freed once the switch is
    // made.
    _current = first
    kod_task_set_now(first.stack)
    _leave_from = me.ctx
    _leave_to = first.ctx
    kod_task_switch(_leave_from, _leave_to)
}

// After a crash: what a module keeps for the simulation's network is from
// before (net/tcp), its listeners gone.
func sim_reboot() -> none {
    _sim_gen += 1
}

// A number from 0 to n - 1, by the seed, counted in the digest.
func sim_rand(anon n: int64) -> int64 {
    return _sim_rand(n)
}

// A number from 0 to n - 1, by the seed (splitmix64), counted in the digest.
func _sim_rand(anon n: int64) -> int64 {
    let Some(sim) = _sim else { return 0 }
    sim.state = sim.state.wrapping_add(-7046029254386353131)
    mut z = sim.state
    z = (z ^ (z >> 30)).wrapping_mul(-4658895280553007687)
    z = (z ^ (z >> 27)).wrapping_mul(-7723592293110705685)
    z = z ^ (z >> 31)
    let r = (z >> 1) % n
    sim.digest = (sim.digest ^ r ^ (n << 20)).wrapping_mul(1099511628211)
    return r
}

// kod_task_kq_add, or under a simulation a wait it notes: 0, or -1 for one
// it can't make (for a child process, say), which the caller then waits for
// without other tasks running.
func _add_event(anon ident: int64, anon filter: int64, anon data: int64, anon key: int64) -> int64 {
    let Some(sim) = _sim else { return kod_task_kq_add(ident, filter, data, key) }
    if filter == EVFILT_READ or filter == EVFILT_WRITE {
        sim.fds += [ident]
        sim.writes += [if filter == EVFILT_WRITE { 1 } else { 0 }]
        sim.fd_keys += [key]
        return 0
    }
    if filter == EVFILT_TIMER {
        sim.due += [sim.now + data]
        sim.timer_keys += [key]
        return 0
    }
    return -1
}

// Whether `fd` has something to read (or, `writes`, room to write) now, or
// is at its end or broken, which the read or write then finds.
// Which of the descriptors `fds` (for writing where `writes` says 1, else
// reading) can go on now: one poll(2) for them all.
func _sim_fds_ready(anon fds: [int64], anon writes: [int64]) -> [bool] {
    mut out = [false] * len(fds)
    if len(fds) == 0 {
        return out
    }
    let p = unsafe.alloc(8 * len(fds))
    for k, fd in fds {
        unsafe.store32(p + 8 * k, fd)
        unsafe.store32(p + 8 * k + 4, if writes[k] == 1 { _POLLOUT } else { _POLLIN })
    }
    let n = unsafe.c_int(libc.poll(p, len(fds), 0))
    if n > 0 {
        for k in 0..len(fds) {
            out[k] = ((unsafe.load32(p + 8 * k + 4) >> 16) & 0xffff) != 0
        }
    }
    unsafe.free(p)
    return out
}

// _poll under a simulation: the tasks whose descriptor can go on now wake,
// in an order the seed picks; when none can and `block`, the clock moves to
// the earliest time a task waits for, and those wake. With nothing to wait
// for, every task waits for another: the run fails.
func _sim_poll(anon sim: _Sim, block: bool) -> none {
    mut fds: [int64] = []
    mut writes: [int64] = []
    mut keys: [int64] = []
    mut ready: [int64] = []
    let can = _sim_fds_ready(sim.fds, sim.writes)
    for k, key in sim.fd_keys {
        if not _io.contains(key) {
            continue
        }
        if can[k] {
            ready += [k]
        } else {
            fds += [sim.fds[k]]
            writes += [sim.writes[k]]
            keys += [key]
        }
    }
    // The ready ones, shuffled.
    for i in len(ready) - 1..=1 step -1 {
        let j = _sim_rand(i + 1)
        let t = ready[i]
        ready[i] = ready[j]
        ready[j] = t
    }
    for k in ready {
        if _io.remove(sim.fd_keys[k]) is Fiber(fiber) {
            // Room for a write of a size the seed picks.
            fiber.io_data = 256 + _sim_rand(769)
            fiber.io_failed = false
            _make_ready(fiber)
        }
    }
    sim.fds = fds
    sim.writes = writes
    sim.fd_keys = keys
    if len(ready) > 0 or not block {
        return
    }
    // The timers still waited for, and the earliest.
    mut due: [int64] = []
    mut timer_keys: [int64] = []
    mut next = -1
    for k, key in sim.timer_keys {
        if _io.contains(key) {
            due += [sim.due[k]]
            timer_keys += [key]
            if next < 0 or sim.due[k] < next {
                next = sim.due[k]
            }
        }
    }
    if next < 0 {
        sim.timer_keys = timer_keys
        sim.due = due
        _scheduling = 0
        panic("simulation: every task waits, and nothing can wake one")
    }
    if next > sim.now {
        sim.now = next
        kod_sim_set_clock(next)
    }
    mut left_due: [int64] = []
    mut left_keys: [int64] = []
    for k, key in timer_keys {
        if due[k] <= sim.now {
            if _io.remove(key) is Fiber(fiber) {
                _make_ready(fiber)
            }
        } else {
            left_due += [due[k]]
            left_keys += [key]
        }
    }
    sim.due = left_due
    sim.timer_keys = left_keys
}
