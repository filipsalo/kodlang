// A downcast through a module's name still needs a struct of that name.
import "./downcast_qualified_dep"

func f(anon e: Error) -> bool {
    if e is x: downcast_qualified_dep.Nope {
        return true
    }
    return e is _: downcast_qualified_dep.Nope
}

func main() -> int64 {
    return 0
}

// expected errors:
// 5:8: error: module `downcast_qualified_dep` has no type `Nope`
// 8:12: error: module `downcast_qualified_dep` has no type `Nope`
