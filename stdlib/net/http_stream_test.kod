// Bodies a server streams, and reads as they come (docs/http.md#streaming).
import "libc"
import "net/http" { BodyWriter, HttpError, Request, Response, Router, Server, file, get, stream, text }
import "net/tcp"
import "posix"
import "posix" { Fd }
import "stream" { IoError }
import "tasks"
import "time"
import "time" { Duration, monotonic_ns }
import "unsafe"

type Log = shared struct {
    lines: [str] = []
    // What the handlers have to say.
    notes: [str] = []
}

mut _log: Log = Log()

func note(anon s: str) -> none {
    _log.notes += [s]
}

func lines(anon w: BodyWriter) -> none or Error {
    for i in 0..5 {
        try w.write_str(f"line {i}\n")
    }
}

func short(anon _req: Request) -> Response or Error {
    return stream(lines, content_type: "text/plain")
}

func sized(anon req: Request) -> Response or Error {
    return stream(lines, length: req.param("n").parse_int())
}

func piece(anon n: int64, anon c: str) -> str {
    mut s = c
    for len(s) < n {
        s += s
    }
    return s[0..n]
}

func long_body(anon w: BodyWriter) -> none or Error {
    for i in 0..40 {
        try w.write_str(piece(10000, f"{i % 10}"))
    }
}

func big(anon _req: Request) -> Response or Error {
    return stream(long_body)
}

func huge(anon _req: Request) -> Response or Error {
    return stream(func(anon w: BodyWriter) -> none or Error {
        for _i in 0..100 {
            let wrote = w.write_all(kod_str_to_bytes(piece(200000, "x")))
            if wrote is Err(e) {
                note(f"write failed: {e is IoError(_)}")
                throw e
            }
        }
        note("wrote it all")
    }, length: 20000000)
}

func flushed(anon _req: Request) -> Response or Error {
    return stream(func(anon w: BodyWriter) -> none or Error {
        for i in 0..3 {
            try w.write_str(f"event {i}\n")
            try w.flush()
            time.sleep(Duration(ms: 60))
        }
    })
}

func fails_first(anon _req: Request) -> Response or Error {
    return stream(func(anon w: BodyWriter) -> none or Error {
        try w.write_str("not sent")
        throw HttpError(status: 409, message: "in the way")
    })
}

func panics_first(anon _req: Request) -> Response or Error {
    return stream(func(anon w: BodyWriter) -> none or Error {
        let xs = [1]
        try w.write_str(f"{xs[len(xs)]}")
    })
}

func fails_late(anon _req: Request) -> Response or Error {
    return stream(func(anon w: BodyWriter) -> none or Error {
        try w.write_str("some")
        try w.flush()
        throw IoError(kind: .Other, op: "rows", errno: 0, detail: "no more")
    })
}

func panics_late(anon _req: Request) -> Response or Error {
    return stream(func(anon w: BodyWriter) -> none or Error {
        let xs = [1]
        try w.write_str("some")
        try w.flush()
        try w.write_str(f"{xs[len(xs)]}")
    })
}

func endless(anon _req: Request) -> Response or Error {
    return stream(func(anon w: BodyWriter) -> none or Error {
        for true {
            try w.write_str("tick\n")
            try w.flush()
            time.sleep(Duration(ms: 10))
        }
    })
}

func empty(anon _req: Request) -> Response or Error {
    return stream(func(anon _w: BodyWriter) -> none or Error {
    })
}

func gone(anon _req: Request) -> Response or Error {
    return stream(func(anon w: BodyWriter) -> none or Error {
        note("called")
        try w.write_str("x")
    }, status: 204)
}

// How long the body is, read as it comes.
func count(anon req: Request) -> Response or Error {
    let body = req.reader()
    mut n: int64 = 0
    for true {
        let data = try body.read(10000)
        if len(data) == 0 {
            break
        }
        n += len(data)
    }
    return text(f"{n}")
}

func ignore(anon _req: Request) -> Response or Error {
    return text("ignored")
}

func echo(anon req: Request) -> Response or Error {
    let body = req.reader()
    return stream(func(anon w: BodyWriter) -> none or Error {
        for true {
            let data = try body.read(10000)
            if len(data) == 0 {
                return
            }
            try w.write_all(data)
            try w.flush()
        }
    })
}

func swallow(anon req: Request) -> Response or Error {
    if req.reader().read_all() is Err(e) {
        note(e.to_str())
    }
    return text("fine")
}

func a_file(anon req: Request) -> Response or Error {
    return try file(req.query("path")? or "")
}

type Fixture = shared struct {
    l: tcp.Listener
    server: Server
    log: Log

    func init() -> Fixture {
        let log = Log()
        _log = log
        let routes = Router()
        routes.get("/short", short)
        routes.get("/sized/{n}", sized)
        routes.get("/big", big)
        routes.get("/huge", huge)
        routes.get("/flushed", flushed)
        routes.get("/fails-first", fails_first)
        routes.get("/panics-first", panics_first)
        routes.get("/fails-late", fails_late)
        routes.get("/panics-late", panics_late)
        routes.get("/endless", endless)
        routes.get("/empty", empty)
        routes.get("/gone", gone)
        routes.get("/file", a_file)
        routes.post("/count", count, stream_body: true)
        routes.post("/count-read", count)
        routes.post("/ignore", ignore, stream_body: true)
        routes.post("/echo", echo, stream_body: true)
        routes.post("/swallow", swallow, stream_body: true)
        let server = Server(
            : routes,
            header_timeout: Duration(ms: 150),
            body_timeout: Duration(ms: 150),
            write_timeout: Duration(ms: 200),
            idle_timeout: Duration(ms: 150),
            log: func(anon line: str) { log.lines += [line] },
        )
        server.limits.max_body = 1000
        return Fixture(l: must tcp.listen("127.0.0.1", port: 0), :server, :log)
    }

    func connect(self) -> Fd {
        return must tcp.connect("127.0.0.1", port: self.l.port())
    }

    // Everything that comes back for `text`, until the server closes.
    func talk(self, anon text: str) -> str {
        let conn = self.connect()
        say(conn, text)
        let got = rest(conn)
        must conn.close()
        return got
    }

    func ask(self, anon path: str) -> str {
        return self.talk(f"GET {path} HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")
    }

    func end(self, anon serving: tasks.Task[str]) -> none {
        self.server.stop()
        assert serving.wait() == "ok"
        must self.l.close()
        assert len(self.server.conns) == 0
    }
}

func serve(anon f: Fixture) -> str {
    if f.server.serve(f.l) is Err(e) {
        return e.to_str()
    }
    return "ok"
}

func say(anon conn: Fd, anon text: str) -> none {
    must conn.write_all(kod_str_to_bytes(text))
}

func rest(anon conn: Fd) -> str {
    let _ = tcp.set_timeout(conn, timeout: Duration(seconds: 3))
    mut out = ""
    for true {
        let data = conn.read(65536)
        if data is Err(e) {
            return out + f"[{e.to_str()}]"
        }
        let got = data
        if len(got) == 0 {
            return out
        }
        out += kod_bytes_to_str(got)
    }
    return out
}

func ms_since(anon t0: int64) -> int64 {
    return (monotonic_ns() - t0) / 1000000
}

func body_of(anon resp: str) -> str {
    let Some(at) = resp.find("\r\n\r\n") else {
        return "no headers"
    }
    return resp[at + 4..len(resp)]
}

test "a short body goes out with its length" {
    let f = Fixture()
    let serving = spawn serve(f)
    let got = f.ask("/short")
    assert got == "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 35\r\nConnection: close\r\n\r\nline 0\nline 1\nline 2\nline 3\nline 4\n"
    assert f.ask("/empty").ends_with("Content-Length: 0\r\nConnection: close\r\n\r\n")
    f.end(serving)
}

test "a long body goes out in chunks" {
    let f = Fixture()
    let serving = spawn serve(f)
    let got = f.ask("/big")
    assert got.contains("\r\nTransfer-Encoding: chunked\r\n")
    assert not got.contains("Content-Length")
    assert body_of(got).starts_with("10000\r\n0000")
    assert got.ends_with("\r\n0\r\n\r\n")
    let r = must get(f"http://127.0.0.1:{f.l.port()}/big")
    let whole = r.text()
    assert len(whole) == 400000
    for i in 0..40 {
        assert whole[i * 10000..(i + 1) * 10000] == piece(10000, f"{i % 10}")
    }
    f.end(serving)
}

test "connections go on after streamed bodies" {
    let f = Fixture()
    let serving = spawn serve(f)
    let one = "GET /big HTTP/1.1\r\nHost: a\r\n\r\n"
    let got = f.talk(one + "GET /short HTTP/1.1\r\nHost: a\r\n\r\n" + "GET /sized/35 HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")
    assert len(got.split("HTTP/1.1 200 OK\r\n")) == 4
    assert got.ends_with("Content-Length: 35\r\nConnection: close\r\n\r\nline 0\nline 1\nline 2\nline 3\nline 4\n")
    f.end(serving)
}

test "HTTP/1.0 gets no chunks" {
    let f = Fixture()
    let serving = spawn serve(f)
    let got = f.talk("GET /big HTTP/1.0\r\nConnection: keep-alive\r\n\r\n")
    assert not got.contains("Transfer-Encoding")
    assert got.contains("\r\nConnection: close\r\n")
    assert len(body_of(got)) == 400000
    f.end(serving)
}

test "HEAD and a status without a body don't call the function" {
    let f = Fixture()
    let serving = spawn serve(f)
    assert f.talk("HEAD /sized/35 HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n").ends_with("Content-Length: 35\r\nConnection: close\r\n\r\n")
    let head = f.talk("HEAD /huge HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")
    assert head.ends_with("\r\n\r\n")
    assert f.ask("/gone").ends_with("Connection: close\r\n\r\n")
    assert len(f.log.notes) == 0
    f.end(serving)
}

test "the length given is the length written" {
    let f = Fixture()
    let serving = spawn serve(f)
    assert f.ask("/sized/35").ends_with("Content-Length: 35\r\nConnection: close\r\n\r\nline 0\nline 1\nline 2\nline 3\nline 4\n")
    assert f.ask("/sized/34").starts_with("HTTP/1.1 500 ")
    assert f.ask("/sized/36").starts_with("HTTP/1.1 500 ")
    assert f.log.lines == ["GET /sized/34: write: 35 bytes of a body of 34", "GET /sized/36: write: 35 bytes of a body of 36"]
    f.end(serving)
}

test "flush sends what there is" {
    let f = Fixture()
    let serving = spawn serve(f)
    let conn = f.connect()
    let t0 = monotonic_ns()
    say(conn, "GET /flushed HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")
    let first = kod_bytes_to_str(must conn.read(65536))
    assert ms_since(t0) < 50
    assert body_of(first) == "8\r\nevent 0\n\r\n"
    assert rest(conn) == "8\r\nevent 1\n\r\n8\r\nevent 2\n\r\n0\r\n\r\n"
    must conn.close()
    f.end(serving)
}

test "a failure before anything is sent is a response" {
    let f = Fixture()
    let serving = spawn serve(f)
    let got = f.ask("/fails-first")
    assert got.starts_with("HTTP/1.1 409 ") and got.ends_with("\r\n\r\nin the way\n")
    assert f.ask("/panics-first").starts_with("HTTP/1.1 500 ")
    assert len(f.log.lines) == 1
    assert f.log.lines[0].starts_with("GET /panics-first: panic: ")
    // And the connection goes on.
    let two = f.talk("GET /fails-first HTTP/1.1\r\nHost: a\r\n\r\nGET /short HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")
    assert two.contains("HTTP/1.1 409 ") and two.contains("HTTP/1.1 200 OK")
    f.end(serving)
}

test "a failure after that ends the connection" {
    let f = Fixture()
    let serving = spawn serve(f)
    let asked = "HTTP/1.1\r\nHost: a\r\n\r\n"
    assert body_of(f.talk(f"GET /fails-late {asked}")) == "4\r\nsome\r\n"
    assert body_of(f.talk(f"GET /panics-late {asked}")) == "4\r\nsome\r\n"
    assert f.log.lines[0] == "GET /fails-late: rows: no more (after 4 bytes of the body)"
    assert f.log.lines[1].starts_with("GET /panics-late: panic: ")
    assert len(f.log.lines) == 2
    f.end(serving)
}

test "a client that goes away ends its body, and isn't logged" {
    let f = Fixture()
    let serving = spawn serve(f)
    let conn = f.connect()
    say(conn, "GET /endless HTTP/1.1\r\nHost: a\r\n\r\n")
    let _ = must conn.read(1000)
    must conn.close()
    time.sleep(Duration(ms: 100))
    assert len(f.server.conns) == 0
    assert len(f.log.lines) == 0
    f.end(serving)
}

test "a client that doesn't read a body is dropped, and holds up nobody" {
    let f = Fixture()
    let serving = spawn serve(f)
    let conn = f.connect()
    say(conn, "GET /huge HTTP/1.1\r\nHost: a\r\n\r\n")
    time.sleep(Duration(ms: 20))
    assert f.ask("/short").starts_with("HTTP/1.1 200 ")
    time.sleep(Duration(ms: 400))
    assert len(f.server.conns) == 0
    assert f.log.notes == ["write failed: true"]
    assert len(f.log.lines) == 0
    must conn.close()
    f.end(serving)
}

test "a slow reader gets the whole body, past the write timeout" {
    let f = Fixture()
    let serving = spawn serve(f)
    let conn = f.connect()
    say(conn, "GET /huge HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")
    let t0 = monotonic_ns()
    mut n: int64 = 0
    for ms_since(t0) < 2000 {
        let data = must conn.read(65536)
        if len(data) == 0 {
            break
        }
        n += len(data)
        time.sleep(Duration(ms: 1))
    }
    assert n > 20000000
    assert ms_since(t0) > 300
    assert f.log.notes == ["wrote it all"]
    must conn.close()
    f.end(serving)
}

test "stop cuts off a body without an end" {
    let f = Fixture()
    let serving = spawn serve(f)
    let conn = f.connect()
    say(conn, "GET /endless HTTP/1.1\r\nHost: a\r\n\r\n")
    let _ = must conn.read(1000)
    f.server.stop(within: Duration(ms: 50))
    assert serving.wait() == "serve: stopped with 1 connections still busy"
    assert not rest(conn).ends_with("0\r\n\r\n")
    assert len(f.server.conns) == 0
    assert len(f.log.lines) == 0
    must conn.close()
    must f.l.close()
}

func post(anon path: str, anon body: str) -> str {
    return f"POST {path} HTTP/1.1\r\nHost: a\r\nContent-Length: {len(body)}\r\n\r\n{body}"
}

let LAST: str = "GET /short HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"

test "a handler reads a body as it comes" {
    let f = Fixture()
    let serving = spawn serve(f)
    // Past limits.max_body, and followed by another request.
    let got = f.talk(post("/count", piece(300000, "a")) + LAST)
    assert body_of(got).starts_with("300000HTTP/1.1 200 OK\r\n")
    let chunked = f.talk("POST /count HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nabcd\r\n10;x=y\r\n0123456789abcdef\r\n0\r\nT: 1\r\n\r\n" + LAST)
    assert body_of(chunked).starts_with("20HTTP/1.1 200 OK\r\n")
    let none_at_all = f.talk("POST /count HTTP/1.1\r\nHost: a\r\n\r\n" + LAST)
    assert body_of(none_at_all).starts_with("0HTTP/1.1 200 OK\r\n")
    // One read before the handler is called can be read so too.
    assert body_of(f.talk(post("/count-read", piece(900, "a")) + LAST)).starts_with("900HTTP/1.1")
    assert f.talk(post("/count-read", piece(1001, "a"))).starts_with("HTTP/1.1 413 ")
    f.end(serving)
}

test "a body sent slowly has the time for each part" {
    let f = Fixture()
    let serving = spawn serve(f)
    let conn = f.connect()
    say(conn, "POST /count HTTP/1.1\r\nHost: a\r\nConnection: close\r\nContent-Length: 5\r\n\r\n")
    for c in ["a", "b", "c", "d", "e"] {
        time.sleep(Duration(ms: 60))
        say(conn, c)
    }
    assert body_of(rest(conn)) == "5"
    must conn.close()
    f.end(serving)
}

test "a body cut short, or wrong, is answered as if read before" {
    let f = Fixture()
    let serving = spawn serve(f)
    let head = "POST /count HTTP/1.1\r\nHost: a\r\n"
    assert f.talk(head + "Content-Length: 10\r\n\r\nabc").starts_with("HTTP/1.1 408 Request Timeout\r\n")
    assert f.talk(head + "Transfer-Encoding: chunked\r\n\r\nzz\r\n").starts_with("HTTP/1.1 400 Bad Request\r\n")
    assert f.talk(head + "Transfer-Encoding: gzip\r\n\r\n").starts_with("HTTP/1.1 501 ")
    assert f.talk(head + "Content-Length: 1\r\nContent-Length: 2\r\n\r\n").starts_with("HTTP/1.1 400 ")
    assert f.talk(head + "Expect: tea\r\nContent-Length: 2\r\n\r\n").starts_with("HTTP/1.1 417 ")
    // The handler may answer all the same; the connection ends.
    let got = f.talk("POST /swallow HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n" + LAST)
    assert got.starts_with("HTTP/1.1 200 OK\r\n") and got.ends_with("Connection: close\r\n\r\nfine")
    assert f.log.notes == ["http: bad chunk size"]
    // Gone.
    let conn = f.connect()
    say(conn, head + "Content-Length: 10\r\n\r\nabc")
    must conn.close()
    time.sleep(Duration(ms: 50))
    assert len(f.server.conns) == 0
    assert len(f.log.lines) == 0
    f.end(serving)
}

test "Expect: 100-continue is answered at the first read" {
    let f = Fixture()
    let serving = spawn serve(f)
    let conn = f.connect()
    say(conn, "POST /count HTTP/1.1\r\nHost: a\r\nExpect: 100-continue\r\nContent-Length: 3\r\n\r\n")
    assert kod_bytes_to_str(must conn.read(1000)) == "HTTP/1.1 100 Continue\r\n\r\n"
    say(conn, "abc")
    assert body_of(kod_bytes_to_str(must conn.read(1000))) == "3"
    must conn.close()
    // Not at all, when the handler reads none of it.
    let got = f.talk("POST /ignore HTTP/1.1\r\nHost: a\r\nExpect: 100-continue\r\nContent-Length: 3\r\n\r\n")
    assert got.starts_with("HTTP/1.1 200 OK\r\n") and got.ends_with("Connection: close\r\n\r\nignored")
    f.end(serving)
}

test "what a handler leaves unread" {
    let f = Fixture()
    let serving = spawn serve(f)
    let short = f.talk(post("/ignore", "some text") + LAST)
    assert body_of(short).starts_with("ignoredHTTP/1.1 200 OK\r\n")
    let long = f.talk(post("/ignore", piece(300000, "a")) + LAST)
    assert long.ends_with("Connection: close\r\n\r\nignored")
    f.end(serving)
}

test "a body is echoed as it comes" {
    let f = Fixture()
    let serving = spawn serve(f)
    let conn = f.connect()
    say(conn, "POST /echo HTTP/1.1\r\nHost: a\r\nContent-Length: 10\r\n\r\nhello")
    assert body_of(kod_bytes_to_str(must conn.read(1000))) == "5\r\nhello\r\n"
    time.sleep(Duration(ms: 30))
    say(conn, "world")
    assert rest(conn) == "5\r\nworld\r\n0\r\n\r\n"
    must conn.close()
    f.end(serving)
}

test "a client that goes away in the middle of an echo isn't logged" {
    let f = Fixture()
    let serving = spawn serve(f)
    let conn = f.connect()
    say(conn, "POST /echo HTTP/1.1\r\nHost: a\r\nContent-Length: 10\r\n\r\nhello")
    assert body_of(kod_bytes_to_str(must conn.read(1000))) == "5\r\nhello\r\n"
    must conn.close()
    time.sleep(Duration(ms: 50))
    assert len(f.server.conns) == 0
    assert len(f.log.lines) == 0
    f.end(serving)
}

test "a server without routes can stream bodies" {
    let server = Server(handler: count, stream_bodies: true)
    server.limits.max_body = 10
    let l = must tcp.listen("127.0.0.1", port: 0)
    let serving = spawn server.serve(l)
    let conn = must tcp.connect("127.0.0.1", port: l.port())
    say(conn, "POST / HTTP/1.1\r\nHost: a\r\nConnection: close\r\nContent-Length: 20\r\n\r\n0123456789abcdefghij")
    assert body_of(rest(conn)) == "20"
    must conn.close()
    server.stop()
    assert serving.wait() is Ok(_)
    must l.close()
}

test "file" {
    let f = Fixture()
    let serving = spawn serve(f)
    let path = f"/tmp/kod-http-stream-{libc.getpid()}.html"
    let out = must posix.create(path)
    must out.write_str(piece(200000, "abc"))
    must out.close()
    let got = f.ask(f"/file?path={path}")
    assert got.contains("\r\nContent-Type: text/html; charset=utf-8\r\n")
    assert got.contains("\r\nContent-Length: 200000\r\n")
    assert body_of(got) == piece(200000, "abc")
    let head = f.talk(f"HEAD /file?path={path} HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")
    assert head.contains("\r\nContent-Length: 200000\r\n") and head.ends_with("\r\n\r\n")
    let _ = libc.unlink(unsafe.c_str(path))
    assert f.ask(f"/file?path={path}").starts_with("HTTP/1.1 404 ")
    assert f.ask("/file?path=stdlib").starts_with("HTTP/1.1 404 ")
    assert len(f.log.lines) == 0
    f.end(serving)
}

test "the access log has the length sent" {
    let f = Fixture()
    f.server.access_log = true
    let serving = spawn serve(f)
    let _ = f.ask("/big")
    let _ = f.ask("/short")
    time.sleep(Duration(ms: 20))
    assert f.log.lines[0].contains(" GET /big 200 400000 B ")
    assert f.log.lines[1].contains(" GET /short 200 35 B ")
    f.end(serving)
}
