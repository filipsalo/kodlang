// `is` binds tighter than and/or, and a bare `is` tests enum variants.
import "./../infer_ctor_kinds_dep"

type Color = enum {
    Red
    Green
}

type Form = enum {
    Circle(radius: int64)
    Rect(w: int64, h: int64)
}

test "is binds tighter than and, or and ==" {
    let f = true
    let o: int64? = none
    assert f and o is none
    let p: int64? = 3
    assert o is not none or p is not none
    let both = o is none and p is not none
    assert both == true
    let c: Color = .Green
    assert c is .Green and f
    assert (o is none == true) == true
}

test "a bare is tests enum variants" {
    let c: Color = .Green
    let s: Form = .Rect(w: 2, h: 3)
    assert (s is .Circle(_)) == false
    assert (s is Form.Rect(_, _)) == true
    assert (c is Color.Red) == false
    assert (c is not .Red) == true
    let maybe_c: Color? = .Red
    assert (maybe_c is .Some) == true
    assert (maybe_c is .None) == false
}

test "is with bindings" {
    let p: int64? = 3
    if p is Some(v) {
        assert v == 3
    } else {
        fail("p is none")
    }
    let s: Form = .Rect(w: 2, h: 3)
    if s is Form.Rect(w, h) {
        assert w * h == 6
    } else {
        fail("not a Rect")
    }
    mut ran = ""
    if s is not Form.Circle(r) {
        ran = "not a circle"
    } else {
        fail(f"circle {r}")
    }
    assert ran == "not a circle"
    let d: infer_ctor_kinds_dep.Shape = .Square(side: 4)
    if d is infer_ctor_kinds_dep.Shape.Square(side) {
        assert side == 4
    } else {
        fail("not a Square")
    }
}
