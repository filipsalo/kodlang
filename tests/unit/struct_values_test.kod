// A plain struct is a value: assigning or passing copies it, while a
// `shared struct` is shared.
type Point = struct {
    x: int64
    y: int64

    func sum(self) -> int64 {
        return self.x + self.y
    }

    func shift(mut self, anon by: int64) -> none {
        self.x += by
        self.y += by
    }

    func bumped(self) -> Point {
        mut copy = self
        copy.shift(1)
        return copy
    }
}

type Line = struct {
    from: Point
    to: Point
    tags: [str] = []
}

type Grid = struct {
    cells: [int64] = [0, 0, 0]

    func op_index(self, anon i: int64) -> int64 {
        return self.cells[i]
    }

    func op_index_set(mut self, anon i: int64, anon v: int64) -> none {
        self.cells[i] = v
    }
}

type Log = shared struct {
    lines: [str] = []
}

type Holder = shared struct {
    n: int64 = 7
    p: Point
}

func moved(anon p: Point) -> Point {
    mut q = p
    q.x = 100
    return q
}

func grow(mut p: Point) -> none {
    p.shift(5)
}

test "assigning shares, changing copies" {
    mut a = Point(x: 1, y: 2)
    let b = a
    a.x = 10
    assert a.x == 10
    assert b.x == 1

    // Fields of fields, and arrays in fields.
    mut line = Line(from: a, to: b)
    line.from.y = 5
    line.tags += ["t"]
    let kept = line
    line.to.x = 7
    line.tags[0] = "u"
    assert line.from.y == 5
    assert a.y == 2
    assert line.to.x == 7
    assert kept.to.x == 1
    assert line.tags == ["u"]
    assert kept.tags == ["t"]

    // `mut self`, on a local, a field and an element.
    a.shift(1)
    line.from.shift(2)
    mut ps = [Point(x: 0, y: 0), Point(x: 1, y: 1)]
    ps[1].shift(3)
    assert a.x == 11
    assert line.from.x == 12
    assert ps[1].x == 4
    assert b.bumped().x == 2
    assert b.x == 1

    // Passing gives the function the struct as it is.
    let m = moved(a)
    assert m.x == 100
    assert a.x == 11
    grow(p: mut a)
    assert a.x == 16

    // An array of structs holds each one's own.
    mut row = [a] * 2
    row[0].x = -1
    assert row[0].x == -1
    assert row[1].x == 16
}

test "a value struct in a shared struct changes through the shared one" {
    let h = Holder(p: Point(x: 1, y: 1))
    let same = h
    h.p.x = 9
    h.p.shift(1)
    assert same.p.x == 10
    assert same.p.sum() == 12
    assert h.n == 7
}

test "a shared struct is shared" {
    let log = Log()
    let other = log
    other.lines += ["one"]
    assert log.lines == ["one"]
}

test "x[k] = v through a mut self op_index_set" {
    mut g = Grid()
    let before = g
    g[1] = 5
    g[2] += 4
    assert g.cells == [0, 5, 4]
    assert before.cells == [0, 0, 0]
}
