func helper() -> int64 {
    return 1
}

func apply(anon f: func(int64) -> int64, anon x: int64) -> int64 {
    return f(x)
}

func bumped() -> int64 {
    return apply(func(x: int64) -> int64 { return x + 1 }, 1)
}

func run(cb: func() -> int64 = helper) -> int64 {
    return cb()
}

func run_lambda(cb: func() -> int64 = func() -> int64 { return 7 }) -> int64 {
    return cb()
}

