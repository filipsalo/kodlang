// External argument label (for the caller) can differ from the
// binding name (inside the function).

func greet(who person: str) -> str {
    return person
}

// Single-name form still works: label and binding are the same.
func say(name: str) -> str {
    return name
}

// Anon params have no label regardless of the form.
func shout(anon msg: str) -> str {
    return msg
}

test "labels and binding names" {
    assert greet(who: "kod") == "kod"
    assert say(name: "world") == "world"
    assert shout("hi") == "hi"
}
