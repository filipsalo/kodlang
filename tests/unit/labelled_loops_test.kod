// `name: for ...` with `break name` and `continue name`.
import "sets" { Set }

func find_negative(anon grid: [[int64]]) -> int64 {
    mut found = -1
    rows: for i, row in grid {
        for x in row {
            if x < 0 {
                found = i
                break rows
            }
        }
    }
    return found
}

// The `for true` ends through its label, so the `return` after it is reached.
func leave_forever() -> int64 {
    outer: for true {
        for i in 0..10 {
            if i == 3 {
                break outer
            }
        }
    }
    return 7
}

test "break leaves the labelled loop" {
    assert find_negative([[1, 2], [3, -1], [-5, 6]]) == 1
    assert find_negative([[1]]) == -1
    assert leave_forever() == 7
    mut c = 0
    w: for c < 100 {
        c += 1
        for true {
            if c > 5 {
                break w
            }
            break
        }
    }
    assert c == 6
}

test "continue goes on with the labelled loop's next pass" {
    mut pairs: [str] = []
    outer: for a in 0..4 {
        for b in 0..=3 {
            if b > a {
                continue outer
            }
            if a == 3 {
                break outer
            }
            pairs += [f"{a}{b}"]
        }
    }
    assert pairs == ["00", "10", "11", "20", "21", "22"]
}

test "over a Map, a Set and three loops deep" {
    mut m = Map[str, int64]()
    m.set("a", 1)
    m.set("b", 2)
    mut n = 0
    keys: for _k, v in m {
        for j in [1, 2, 3] {
            if j == 2 {
                continue keys
            }
            n += v * 10 + j
        }
    }
    assert n == 32
    mut s = Set[int64]()
    s.add(1)
    s.add(2)
    mut seen = 0
    elems: for x in s {
        for y in 0..3 {
            for z in 0..3 {
                if z == 1 {
                    continue elems
                }
                seen += x + y + z
            }
        }
    }
    assert seen == 3
}
