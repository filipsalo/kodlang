// `let x = match ...` takes its arms' type, with each arm's own bindings.

type W = enum {
    I(value: int64)
    S(value: str)
}

type Item = shared struct {
    name: str
}

func show(anon w: W) -> str {
    match w {
        .I(value) -> return f"int {value}"
        .S(value) -> return f"str {value}"
    }
}

func label(anon w: W) -> str {
    let d = match w {
        .S(value) -> value
        .I(value) -> f"#{value}"
    }
    return d + "!"
}

test "arms binding payloads of different types" {
    assert show(.I(value: 5)) == "int 5"
    assert label(.S(value: "hey")) == "hey!"
    assert label(.I(value: 7)) == "#7!"
}

test "inferred str, optional-subject and bool matches" {
    let k = 2
    let word = match k {
        1 -> "one"
        else -> "many"
    }
    assert word + "?" == "many?"
    assert f"{word} {word.char_count()}" == "many 4"
    let items: [Item?] = [Item(name: "a"), none]
    mut got: [str] = []
    for o in items {
        let n = match o {
            Some(it) -> it.name
            none -> "-"
        }
        got += [n + n]
    }
    assert got == ["aa", "--"]
    let flag = match k {
        2 -> true
        else -> false
    }
    assert f"{flag}" == "true"
}
