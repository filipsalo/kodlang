// Slice bounds clamp to [0, len]: a negative bound becomes 0, a bound
// past the end becomes len, and an end before the start gives an empty
// slice. Same rules for str, bytes and arrays; bounds never wrap.
func fmt_ints(anon xs: [int64]) -> str {
    mut out: str = f"{len(xs)}:"
    for x in xs {
        out = out + " " + x.to_str()
    }
    return out
}

func main() -> int64 {
    let s: str = "hello"
    let neg: int64 = 0 - 2
    let far: int64 = 900000000
    print(f"[{s[3..40]}]")
    print(f"[{s[neg..]}]")
    print(f"[{s[-2..3]}]")
    print(f"[{s[0..far]}]")
    print(f"[{s[4..2]}]")
    print(f"[{s[7..9]}]")
    print(f"[{s[-5..-1]}]")
    print(f"[{s[..neg]}]")
    print(f"[{s[far..]}]")
    let tail: str = s[3..40]
    print_int(len(tail))

    let b: bytes = b"hello"
    let b1: bytes = b[3..40]
    let b2: bytes = b[-2..]
    let b3: bytes = b[4..1]
    print_int(len(b1))
    print_int(len(b2))
    print_int(len(b3))
    if b1 == b"lo" and b2 == b"hello" {
        print("bytes ok")
    }

    let xs: [int64] = [1, 2, 3]
    print(fmt_ints(xs[1..10]))
    print(fmt_ints(xs[neg..]))
    print(fmt_ints(xs[-1..2]))
    print(fmt_ints(xs[2..1]))
    print(fmt_ints(xs[5..]))
    print(fmt_ints(xs[..far]))
    print(fmt_ints(xs[..-1]))

    let names: [str] = ["a", "b", "c"]
    let more: [str] = names[2..99]
    print_int(len(more))
    print(more[0])
    return 0
}

// expected output:
// [lo]
// [hello]
// [hel]
// [hello]
// []
// []
// []
// []
// []
// 2
// 2
// 5
// 0
// bytes ok
// 2: 2 3
// 3: 1 2 3
// 2: 1 2
// 0:
// 0:
// 3: 1 2 3
// 0:
// 1
// c
