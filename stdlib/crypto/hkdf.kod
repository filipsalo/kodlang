// HKDF (RFC 5869): keys from a shared secret. See docs/crypto.md.
import "crypto/hmac"
import "crypto/sha2" { Algo }

func extract(anon algo: Algo, salt: bytes, ikm: bytes) -> bytes {
    mut key = salt
    if len(key) == 0 {
        key = kod_bytes_from_array([0] * algo.size())
    }
    return hmac.mac(algo, key: key, data: ikm)
}

func expand(anon algo: Algo, prk: bytes, info: bytes, length: int64) -> bytes {
    if length < 0 or length > 255 * algo.size() {
        panic(f"hkdf.expand: {length} bytes is more than 255 digests")
    }
    mut out = b""
    mut t = b""
    mut counter = 1
    for len(out) < length {
        t = hmac.mac(algo, key: prk, data: t + info + kod_bytes_from_array([counter]))
        out = out + t
        counter += 1
    }
    return out[..length]
}
