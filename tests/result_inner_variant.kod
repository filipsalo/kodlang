// In a `T or Error` function, a returned `.Ok` is T's own variant when only
// its payload fits, and the result's `Ok` otherwise.
type Status = enum {
    Ok
    Failed(code: int64)
}

type Bad = struct {
    func to_str(self) -> str {
        return "bad"
    }
}

func check(anon n: int64) -> Status or Error {
    if n < 0 {
        throw Bad()
    }
    if n == 0 {
        return .Failed(code: 7)
    }
    if n == 2 {
        return .Ok(.Failed(code: 2))
    }
    if n == 3 {
        return .Ok(value: Status.Ok)
    }
    return .Ok
}

func arm(anon n: int64) -> Status or Error {
    return match n {
        0 -> .Ok
        1 -> .Ok(.Failed(code: 1))
        else -> .Failed(code: n)
    }
}

func name(anon s: Status) -> str {
    match s {
        .Ok -> return "ok"
        .Failed(code) -> return f"failed {code}"
    }
}

func main() -> int64 {
    for n in [1, 0, -1, 2, 3] {
        match check(n) {
            Ok(s) -> print(name(s))
            Err(e) -> print(f"err {e}")
        }
    }
    for n in [0, 1, 4] {
        print(name(must arm(n)))
    }
    return 0
}

// expected output:
// ok
// failed 7
// err bad
// failed 2
// ok
// ok
// failed 1
// failed 4
