// `try x` or `must x` on its own line narrows `x` for the rest of the block.
import "testing"

type Oops = shared struct {
    code: int64

    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

func get(anon n: int64) -> int64 or Error {
    if n < 0 {
        throw Oops(code: n)
    }
    return n
}

func plus_one(anon n: int64) -> int64 or Error {
    let r = get(n)
    try r
    return r + 1
}

func param(anon r: int64 or Error) -> int64 or Error {
    try r
    return r * 10
}

// The rest assigns `r`, so it keeps its declared type.
func reassigned(anon n: int64) -> int64 or Error {
    mut r = get(n)
    try r
    r = get(n + 1)
    return try r
}

test "try or must on its own line narrows" {
    assert must plus_one(2) == 3
    assert plus_one(-3) is Err
    assert must param(get(4)) == 40
    assert must reassigned(5) == 6

    let o: int64? = 7
    must o
    assert o + 1 == 8

    let r = get(8)
    if true {
        must r
        assert r + 2 == 10
    }
    assert r is Ok

    let xs: [int64?] = [1, 2, 3]
    mut sum = 0
    for x in xs {
        must x
        sum += x
    }
    assert sum == 6
}

test "must on none stops the program" {
    let r = testing.run(func() {
        let missing: str? = none
        must missing
        print(missing.upper())
    })
    assert r.status == 1
    assert r.stdout == ""
    assert r.stderr.contains("must on none")
}
