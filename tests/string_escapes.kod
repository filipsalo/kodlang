// \xHH is one byte; \u{H...} is a Unicode character written as UTF-8.

func bytes_of(anon s: str) -> str {
    mut out = ""
    mut i = 0
    for i < len(s) {
        out = out + f"{s[i]}"
        if i + 1 < len(s) {
            out = out + " "
        }
        i = i + 1
    }
    return out
}

func same(anon a: str, anon b: str) -> str {
    if a == b {
        return "true"
    }
    return "false"
}

func main() -> int64 {
    print("\x41\x42\x43")                  // ABC
    print(bytes_of("\x00\x7f\x80\xff"))    // 0 127 128 255
    print(bytes_of("\xC3\xA9"))            // 195 169
    print(same("\xC3\xA9", "é"))         // true
    print(same("\u{e9}", "é"))           // true
    print(bytes_of("\u{41}"))              // 65
    print(bytes_of("\u{e9}"))              // 195 169
    print(bytes_of("\u{20AC}"))            // 226 130 172
    print(bytes_of("\u{1F600}"))           // 240 159 152 128
    print(bytes_of("\u{0}"))               // 0
    print(bytes_of("\u{000041}"))          // 65
    print(bytes_of("\u{10FFFF}"))          // 244 143 191 191
    print(bytes_of("\u{7FF}\u{800}"))      // 223 191 224 160 128
    print("a\u{e9}b\x21")                  // aéb!
    print(same("\u{1F600}", "😀"))       // true

    // A backslash escaped first is not the start of an escape.
    print("\\x41")                         // \x41
    print("\\u{e9}")                       // \u{e9}
    print_int(len("\\x41"))                // 4

    // Unknown simple escapes are still dropped.
    print_int(len("\q"))                   // 0

    // Triple-quoted strings.
    let block = """
        tab\x09here
        \u{e9}
        """
    print(bytes_of(block))                 // 116 97 98 9 104 101 114 101 10 195 169 10

    // Byte literals and f-strings take them too.
    let raw = b"\xFF\x00\u{e9}"
    print_int(len(raw))                    // 4
    let n = 2
    print(f"\u{e9}{n + 1}")                // é3
    print(f"{n}\u{41}{n}")                 // 2A2
    print(f"\x41{n}\u{1F600}")             // A2😀
    print(f"{n}" + "\u{e9}")               // 2é
    return 0
}

// expected output:
// ABC
// 0 127 128 255
// 195 169
// true
// true
// 65
// 195 169
// 226 130 172
// 240 159 152 128
// 0
// 65
// 244 143 191 191
// 223 191 224 160 128
// aéb!
// true
// \x41
// \u{e9}
// 4
// 0
// 116 97 98 9 104 101 114 101 10 195 169 10
// 4
// é3
// 2A2
// A2😀
// 2é

// expected status:
// 0
