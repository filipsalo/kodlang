type Holder[T] = struct {
    v: T
}

func secret() -> str {
    return "the module's"
}

func _private[T](anon x: T) -> str {
    return f"{secret()}:{x}"
}

func tag[T](anon x: T) -> str {
    return _private(x)
}

func wrap[T](anon x: T) -> Holder[T] {
    return Holder[T](v: x)
}

func empty[T]() -> [T] {
    let out: [T] = []
    return out
}

func one[T](anon xs: [T]) -> [T] {
    return xs + xs[0..1]
}

func with_default[T](xs: [T], ys: [T] = empty[T]()) -> int64 {
    return len(one(xs)) + len(ys)
}

func literal_inside[T](anon x: T) -> int64 {
    let _ = x
    let f = func(anon n: int64) -> int64 { return n + 1 }
    return f(1)
}

