// The interpreter writes a generic instance and its type arguments that way
// too.
import "./generic_names_pa"
import "./generic_names_pb"

func main() -> int64 {
    print("start")
    let g = generic_names_pb.boxed_boxed()
    print_int(g(1))
    return 0
}

// expected mode:
// interpret
// expected output:
// start
// expected stderr:
// 9:15: error: `g` is a local of type `generic_names_pb.Box[generic_names_pb.Box[generic_names_pb.Pt]]`, not a function
// expected status:
// 1
