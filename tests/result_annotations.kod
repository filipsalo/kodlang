// `T or Error` works as a let annotation, a parameter, a struct field and
// an alias target, in both frontends.

type Oops = struct {
    message: str
    func to_str(self) -> str { return self.message }
}

type Outcome = int64 or Error

type Attempt = struct {
    label: str
    result: int64 or Error
}

func half(anon n: int64) -> int64 or Error {
    if n % 2 == 1 {
        throw Oops(message: f"{n} is odd")
    }
    return n / 2
}

func show(anon r: int64 or Error) -> str {
    match r {
        Ok(v) -> return f"ok {v}"
        Err(e) -> return f"err {e.to_str()}"
    }
}

func main() -> int64 {
    let a: int64 or Error = half(4)
    print(show(a))
    let b: Outcome = half(3)
    print(show(b))
    let t = Attempt(label: "six", result: half(6))
    print(f"{t.label}: {show(t.result)}")
    return 0
}

// expected output:
// ok 2
// err 3 is odd
// six: ok 3
