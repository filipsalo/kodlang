// A pattern's bindings reach the `and` operands after it and the body; the else sees none.

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
}

func describe(s: Shape, t: Shape) -> str {
    if s is .Rect(w, h) and t is .Rect(w2, h2) and w * h == w2 * h2 {
        return f"same area {w * h}"
    } else {
        return "differ"
    }
}

func first_big(xs: [Shape]) -> int64 {
    for x in xs {
        if x is .Circle(r) and r < 3 {
            continue
        }
        if x is .Circle(r) and r > 9 {
            break
        }
        if x is .Circle(r) and r >= 3 {
            return r
        }
    }
    return -1
}

test "bindings reach later and operands and the body" {
    let c: Shape = .Circle(r: 4)
    mut ran: [str] = []
    if c is .Circle(r) and r > 2 and r < 5 {
        ran += [f"circle {r}"]
    }
    if c is .Circle(r) and r > 9 {
        fail("bad")
    } else {
        ran += ["small"]
    }
    let ready = true
    if ready and c is .Circle(r) and r == 4 {
        ran += [f"ready {r}"]
    }
    let o: int64? = 7
    if c is .Circle(r) and o is Some(v) {
        ran += [f"sum {r + v}"]
    }
    let r = 100
    if c is .Rect(r, _h) and r > 0 {
        fail("bad")
    } else {
        ran += [f"outer {r}"]
    }
    if c is .Circle(r) and r == 4 {
        if o is Some(v) and v == 7 {
            ran += ["nested"]
        } else {
            fail("bad")
        }
    } else {
        fail("bad")
    }
    assert ran == ["circle 4", "small", "ready 4", "sum 11", "outer 100", "nested"]
}

test "bindings in functions and loops" {
    assert describe(s: .Rect(w: 2, h: 6), t: .Rect(w: 3, h: 4)) == "same area 12"
    assert describe(s: .Rect(w: 2, h: 6), t: .Rect(w: 3, h: 5)) == "differ"
    assert describe(s: .Circle(r: 1), t: .Rect(w: 3, h: 5)) == "differ"
    assert first_big(xs: [.Circle(r: 1), .Rect(w: 1, h: 1), .Circle(r: 5)]) == 5
    assert first_big(xs: [.Circle(r: 10), .Circle(r: 5)]) == -1
}
