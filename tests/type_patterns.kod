// `n: T` on unions, interfaces and optionals, and through generics.
interface Shape {
    func area(self) -> int64
}
type Circle = struct {
    r: int64

    func area(self) -> int64 {
        return 3 * self.r * self.r
    }
}
type Square = struct {
    s: int64

    func area(self) -> int64 {
        return self.s * self.s
    }
}
type Id = int64 | str

func shape_name(anon s: Shape) -> str {
    return match s {
        c: Circle if c.r > 10 -> "big circle"
        c: Circle -> f"circle {c.r}"
        _: Square -> "a square"
        else -> "other"
    }
}

type Slot = enum {
    Full(shape: Shape)
    Empty
}

// After `is`, `c: Circle` in a payload is the type pattern, not an argument label.
func nested_in_is(anon s: Shape) -> str {
    let slot = Slot.Full(shape: s)
    if slot is .Full(c: Circle) {
        return f"circle {c.r}"
    }
    return "other"
}

func maybe_id(anon m: Id | none) -> str {
    match m {
        n: int64 -> return f"int {n}"
        s: str -> return f"str {s}"
        none -> return "none"
    }
}

func maybe_int(anon m: int64?) -> str {
    return match m {
        n: int64 if n > 100 -> "big"
        n: int64 -> f"{n}"
        none -> "none"
    }
}

func maybe_shape(anon m: Shape?) -> str {
    match m {
        c: Circle -> return f"circle {c.r}"
        none -> return "none"
        else -> return "another shape"
    }
}

// One pattern, compiled for each subject an instance gives it.
func holds_int[T](anon x: T) -> str {
    match x {
        else -> return "any"
    }
}

func generic_optional[T](anon x: T?) -> str {
    match x {
        _: T -> return "some"
        none -> return "none"
    }
}

func main() -> int64 {
    print(shape_name(Circle(r: 20)))
    print(shape_name(Circle(r: 1)))
    print(shape_name(Square(s: 1)))
    print(nested_in_is(Circle(r: 2)))

    let shape: Shape = Circle(r: 3)
    if shape is c: Circle {
        print_int(c.r)
    }
    if shape is _: Square {
        print("not reached")
    }
    if shape is not _: Square {
        print("not a square")
    }
    let is_circle = shape is _: Circle
    print(f"{is_circle}")

    print(maybe_id(1))
    print(maybe_id("s"))
    print(maybe_id(none))
    print(maybe_int(500))
    print(maybe_int(5))
    print(maybe_int(none))
    print(maybe_shape(Circle(r: 4)))
    print(maybe_shape(Square(s: 4)))
    print(maybe_shape(none))

    let held: Id | none = "held"
    if held is s: str {
        print(s)
    }
    if held is n: int64 {
        print_int(n)
    } else {
        print("no int")
    }
    let has_str = held is _: str
    let has_int = held is _: int64
    let not_int = held is not _: int64
    print(f"{has_str} {has_int} {not_int}")
    let gone: Id | none = none
    let gone_str = gone is _: str
    print(f"{gone_str}")
    if held is s: str and len(s) == 4 {
        print("four")
    }

    let plain: int64? = 6
    if plain is n: int64 {
        print_int(n)
    }
    let word = match held {
        s: str -> s
        n: int64 -> f"{n}"
        none -> "none"
    }
    print(word)

    print(generic_optional[int64](1))
    print(generic_optional[str]("s"))
    print(generic_optional[str](none))
    print(holds_int(1))

    // Both spellings stay valid, next to each other.
    match held {
        Some(n: int64) -> print_int(n)
        s: str -> print(s)
        none -> print("none")
    }
    return 0
}

// expected output:
// big circle
// circle 1
// a square
// circle 2
// 3
// not a square
// true
// int 1
// str s
// none
// big
// 5
// none
// circle 4
// another shape
// none
// held
// no int
// true false true
// false
// four
// 6
// held
// some
// some
// none
// any
// held
