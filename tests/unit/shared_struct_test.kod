type Parser = shared struct {
    pos: int64
    shared: int64 = 0

    func step(self) -> none {
        self.pos += 1
    }
}

test "shared struct copies share state and a field named shared" {
    let p = Parser(pos: 0)
    let q = p
    q.step()
    let shared = p.pos + p.shared
    assert shared == 1
}
