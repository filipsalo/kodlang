// A union whose members can all be hashed is a Map key; keys of different members
// are different keys, even when they look alike.
import "sets" { Set }

type Color = enum {
    Red
    Green
}

type Key = int64 | str | bool | Color

func describe(anon k: Key) -> str {
    return f"{k}"
}

func main() -> int64 {
    let m = Map[Key, str]()
    m.set(1, "one")
    m.set("1", "string one")
    m.set(true, "yes")
    m.set(Color.Red, "red")
    m.set(0, "zero")
    m.set(false, "no")
    print_int(len(m))
    print(m.get(1)? or "missing")
    print(m.get("1")? or "missing")
    print(m.get(true)? or "missing")
    print(m.get(Color.Red)? or "missing")
    print(m.get(Color.Green)? or "missing")
    print(m.get(0)? or "missing")
    print(m.get(false)? or "missing")
    print(m.get(2)? or "missing")

    // A key read back from a variable of the union type finds the same entry.
    let k: Key = "1"
    m.set(k, "replaced")
    print_int(len(m))
    print(m.get("1")? or "missing")
    print(str(m.contains(k)))

    // Many keys of each member, so the table grows and every key is found again.
    let big = Map[int64 | str, int64]()
    for i in 0..500 {
        big.set(i, i)
        big.set(f"{i}", -i)
    }
    mut found: int64 = 0
    for i in 0..500 {
        if big.get(i) is Some(v) and v == i {
            found += 1
        }
        if big.get(f"{i}") is Some(v) and v == -i {
            found += 1
        }
    }
    print_int(len(big))
    print_int(found)

    // hash agrees with ==, and a member's hash depends on which member it is.
    let a: int64 | bool = 0
    let b: int64 | bool = false
    let c: int64 | bool = 0
    print(str(hash(a) == hash(c)))
    print(str(hash(a) == hash(b)))

    let seen = Set[int64 | str](items: Map[int64 | str, bool]())
    seen.add(3)
    seen.add("3")
    seen.add(3)
    print_int(len(seen))
    print(describe(Color.Green))
    return 0
}

// expected output:
// 6
// one
// string one
// yes
// red
// missing
// zero
// no
// missing
// 6
// replaced
// true
// 1000
// 1000
// true
// false
// 2
// Green
