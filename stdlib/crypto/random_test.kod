import "crypto/random"

test "secure_bytes" {
    assert len(random.secure_bytes(0)) == 0
    let a = random.secure_bytes(1000)
    let b = random.secure_bytes(1000)
    assert len(a) == 1000 and a != b
    // Every byte value turns up in 64 KB, and no value far too often.
    let big = random.secure_bytes(65536)
    mut counts = [0] * 256
    for x in big {
        counts[x] += 1
    }
    for c in counts {
        assert c > 128 and c < 400
    }
}
