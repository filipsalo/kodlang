// A generic enum's variants in an array literal are built as the element instance.
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}
type H = struct {
    ms: [Maybe[int64]]
}
func show(anon m: Maybe[int64]) -> str {
    return match m {
        .Just(v) -> f"just {v}"
        .Nothing -> "nothing"
    }
}
func shows(anon ms: [Maybe[int64]]) -> none {
    mut parts = ""
    for m in ms {
        parts = parts + show(m) + ";"
    }
    print(parts)
}
func make() -> [[Maybe[int64]]] {
    return [[Maybe.Just(value: 7)], [.Nothing]]
}
func main() -> int64 {
    let xs: [Maybe[int64]] = [Maybe.Just(value: 5), .Nothing, .Just(value: 6)]
    shows(xs)
    shows([Maybe.Nothing, Maybe.Just(value: 1)])
    let h = H(ms: [.Just(value: 2)])
    shows(h.ms)
    mut ys: [Maybe[int64]] = []
    ys += [Maybe.Just(value: 8)]
    ys[0] = Maybe.Just(value: 10)
    shows(ys)
    let g = make()
    shows(g[0])
    shows(g[1])
    let rs: [int64 or Error] = [.Ok(value: 3), Result.Ok(value: 4)]
    print_int(must rs[0] + must rs[1])
    let os: [Option[int64]] = [Option.Some(9), .None]
    for o in os {
        match o {
            .Some(v) -> print_int(v)
            .None -> print("none")
        }
    }
    return 0
}

// expected output:
// just 5;nothing;just 6;
// nothing;just 1;
// just 2;
// just 10;
// just 7;
// nothing;
// 7
// 9
// none
