// Alternates stdout and stderr, flushing stdout where the order matters.
// tests/stdio_test.py merges both into one pipe and expects the order here.
import "io"

func main() -> int64 {
    print("out1")
    io.flush_stdout()
    io.write_stderr("err1\n")
    print("out2")
    io.flush_stdout()
    io.write_stderr("err2\n")
    print("out3")
    return 0
}

// expected mode:
// skip
