// The interpreter reports a match of an enum's variant on an interface value.
import "./downcast_qualified_dep"

type Kind = enum {
    NotFound
    Other
}

func f(anon e: Error) -> str {
    match e {
        Kind.NotFound -> return "kind"
        else -> return "else"
    }
}

func main() -> int64 {
    print(f(downcast_qualified_dep.failure("q")))
    return 0
}

// expected status:
// 1
// expected stderr:
// 11:9: error: `Kind.NotFound` needs an enum value
// expected mode:
// interpret
