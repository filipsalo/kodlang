// Operator methods on enums, generic ones included.

type Amount = enum {
    Cents(n: int64)
    Free

    func op_eq(self, other: Amount) -> bool {
        return self.cents() == other.cents()
    }

    func op_lt(self, other: Amount) -> bool {
        return self.cents() < other.cents()
    }

    func op_add(self, other: Amount) -> Amount {
        return .Cents(n: self.cents() + other.cents())
    }

    func op_mul(self, times: int64) -> Amount {
        return .Cents(n: self.cents() * times)
    }

    func op_rmul(self, times: int64) -> Amount {
        return self * times
    }

    func op_rsub(self, from: int64) -> Amount {
        return .Cents(n: from - self.cents())
    }

    func cents(self) -> int64 {
        return match self {
            .Cents(n) -> n
            .Free -> 0
        }
    }
}

type Light = enum {
    Red
    Green

    func op_eq(self, other: Light) -> bool {
        return true
    }
}

type Pick[T] = enum {
    One(v: T)
    Nothing

    func op_eq(self, other: Pick[T]) -> bool {
        return match self {
            .One(a) -> match other {
                .One(b) -> a == b
                .Nothing -> false
            }
            .Nothing -> other is .Nothing
        }
    }
}

func note(anon s: str) -> int64 {
    print(s)
    return 1
}

func main() -> int64 {
    let a: Amount = .Cents(n: 0)
    let b: Amount = .Cents(n: 5)
    print(f"{a == .Free} {a != .Free} {b == .Free} {a == b}")
    print(f"{a < b} {a > b} {a <= .Free} {b >= .Cents(n: 6)}")
    let sum = b + .Cents(n: 2) + Amount.Free
    print_int(sum.cents())
    print_int((sum * 2).cents())
    print_int((3 * b).cents())
    print_int((-b).cents())
    mut total: Amount = .Free
    total += b
    total += b
    print_int(total.cents())
    print(a < b < .Cents(n: 9))

    let r: Light = .Red
    print(r == .Green)

    let p: Pick[str] = .One(v: "x")
    let q: Pick[str] = .One(v: "x")
    let n: Pick[int64] = .Nothing
    print(f"{p == q} {p == .One(v: "y")} {p != .Nothing} {n == .Nothing}")

    let left: Amount = .Cents(n: note("left"))
    print(left == .Cents(n: note("right")))
    return 0
}

// expected output:
// true false false false
// true false true false
// 7
// 14
// 15
// -5
// 10
// true
// true
// true false true true
// left
// right
// true
