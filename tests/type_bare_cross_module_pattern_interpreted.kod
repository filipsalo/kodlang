// The interpreter reports a pattern naming an enum only another module
// declares, rather than matching by the variant alone.
import "./type_bare_cross_module_dep"

func main() -> int64 {
    let d: type_bare_cross_module_dep.Mood = .Up
    match d {
        Mood.Up -> return 2
        else -> return 0
    }
}

// expected status:
// 1
// expected stderr:
// 8:9: error: unknown type `Mood`; tests/type_bare_cross_module_dep.kod declares `Mood`: write `type_bare_cross_module_dep.Mood` or list it in the import (`{ Mood }`)
// expected mode:
// interpret
