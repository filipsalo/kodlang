// An optional-chained method call written as a statement runs the method
// when there is a value and skips it, arguments included, when there is
// `none`.
mut log: [str] = []

type Bell = shared struct {
    tag: str

    func ring(self, anon times: int64) -> none {
        log += [f"{self.tag} x{times}"]
    }
}

func count(anon n: int64) -> int64 {
    log += [f"{n}"]
    return n
}

func poke(anon b: Bell?, anon times: int64) -> none {
    b?.ring(count(times))
    log += ["poked"]
}

test "a ?. call statement runs or skips the call and its arguments" {
    poke(Bell(tag: "a"), 2)
    assert log == ["2", "a x2", "poked"]
    poke(none, 5)
    assert log == ["2", "a x2", "poked", "poked"]
    let o: Bell? = Bell(tag: "b")
    o?.ring(1)
    assert log == ["2", "a x2", "poked", "poked", "b x1"]
}
