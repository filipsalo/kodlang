// A pattern's bindings reach the `and` operands after it and the body; the else sees none.

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
}

func describe(s: Shape, t: Shape) -> str {
    if s is .Rect(w, h) and t is .Rect(w2, h2) and w * h == w2 * h2 {
        return f"same area {w * h}"
    } else {
        return "differ"
    }
}

func first_big(xs: [Shape]) -> int64 {
    for x in xs {
        if x is .Circle(r) and r < 3 {
            continue
        }
        if x is .Circle(r) and r > 9 {
            break
        }
        if x is .Circle(r) and r >= 3 {
            return r
        }
    }
    return -1
}

func main() -> int64 {
    let c: Shape = .Circle(r: 4)
    if c is .Circle(r) and r > 2 and r < 5 {
        print(f"circle {r}")
    }
    if c is .Circle(r) and r > 9 {
        print("bad")
    } else {
        print("small")
    }
    let ready = true
    if ready and c is .Circle(r) and r == 4 {
        print(f"ready {r}")
    }
    let o: int64? = 7
    if c is .Circle(r) and o is Some(v) {
        print(f"sum {r + v}")
    }
    let r = 100
    if c is .Rect(r, _h) and r > 0 {
        print("bad")
    } else {
        print(f"outer {r}")
    }
    print(describe(s: .Rect(w: 2, h: 6), t: .Rect(w: 3, h: 4)))
    print(describe(s: .Rect(w: 2, h: 6), t: .Rect(w: 3, h: 5)))
    print(describe(s: .Circle(r: 1), t: .Rect(w: 3, h: 5)))
    print_int(first_big(xs: [.Circle(r: 1), .Rect(w: 1, h: 1), .Circle(r: 5)]))
    print_int(first_big(xs: [.Circle(r: 10), .Circle(r: 5)]))
    if c is .Circle(r) and r == 4 {
        if o is Some(v) and v == 7 {
            print("nested")
        } else {
            print("bad")
        }
    } else {
        print("bad")
    }
    return 0
}

// expected output:
// circle 4
// small
// ready 4
// sum 11
// outer 100
// same area 12
// differ
// differ
// 5
// -1
// nested
