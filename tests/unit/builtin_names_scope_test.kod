// A local hides a function or builtin of its name from its declaration on,
// and only when it holds a function.
import "testing"

type Fn = func([int64]) -> int64

func pick(anon n: int64) -> Fn? {
    if n > 0 {
        return func(anon xs: [int64]) -> int64 {
            return 100
        }
    }
    return none
}

func param_len(anon s: str, len: int64) -> int64 {
    return len(s) + len
}

func lets(anon xs: [int64]) -> none {
    let len = len(xs)
    print_int(len + len([1]))
    let hash = hash("ab")
    print(f"{hash == "ab".hash()}")
}

func loops(anon xs: [int64]) -> none {
    print_int(len(xs))
    for len in [5, 6] {
        print_int(len(xs) + len)
    }
    mut n = 0
    for n < 2 {
        let len = len([1, 2, 3])
        print_int(len + n)
        n += 1
    }
}

func blocks(anon xs: [int64]) -> none {
    if len(xs) > 1 {
        let len = func(anon a: [int64]) -> int64 {
            return 50
        }
        print_int(len(xs))
    }
    print_int(len(xs))
    let o: int64? = 7
    match o {
        Some(n) -> print(str(n + 1))
        none -> print("none")
    }
    print(str(9))
    if pick(1) is Some(hash) {
        print_int(hash(xs))
    }
    print_int(hash(3))
}

func later(anon xs: [int64]) -> none {
    print_int(len(xs))
    panic("x")
    let len = func(anon a: [int64]) -> int64 {
        return 50
    }
}

func values(anon xs: [int64]) -> none {
    print(str(1))
    let panic = func(anon m: str) -> none {
        print(f"soft {m}")
    }
    panic("x")
}

test "a let hides a builtin from its declaration on" {
    let r = testing.run(func() { lets([1, 2, 3, 4]) })
    assert r.status == 0
    assert r.stdout == "5\ntrue\n"
}

test "a parameter that holds no function leaves len to the builtin" {
    assert param_len("abc", len: 10) == 13
}

test "a loop variable that holds no function leaves len to the builtin" {
    let r = testing.run(func() { loops([1, 2, 3, 4]) })
    assert r.status == 0
    assert r.stdout == "4\n9\n10\n3\n4\n"
}

test "a function value hides a builtin only inside its block" {
    let r = testing.run(func() { blocks([1, 2, 3, 4]) })
    assert r.status == 0
    assert r.stdout == "50\n4\n8\n9\n100\n3\n"
}

test "a local function value hides panic" {
    let r = testing.run(func() { values([1, 2, 3, 4]) })
    assert r.status == 0
    assert r.stdout == "1\nsoft x\n"
}

test "a local declared later doesn't hide panic before it" {
    let r = testing.run(func() { later([1, 2, 3, 4]) })
    assert r.status == 1
    assert r.stdout == "4\n"
    assert r.stderr.contains("panic: x")
}
