// The interpreter reports a `.Variant` that several enums it can't see
// declare, as the compiler does, instead of picking one of them.
import "./variant_hidden_mid"

func main() -> int64 {
    print_int(variant_hidden_mid.radius(.Circle(r: 3)))
    let c = .Circle(r: 2)
    print_int(variant_hidden_mid.radius(c))
    return 0
}

// expected mode:
// interpret
// expected output:
// 3
// expected stderr:
// 7:13: error: `.Circle` is ambiguous: `Figure` and `Shape` both declare it; give the value a type
// expected status:
// 1
