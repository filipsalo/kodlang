}

test "an optional isn't boxed into an optional interface" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s * self.s }
        }
        type Holder = struct { sh: Shape? }
        type Shapes = [Shape?]
        func show(anon sh: Shape?) -> none {}
        func conv(anon sq: Sq?) -> Shape? {
            return sq
        }
        func keep(anon sh: Shape?) -> Shape? {
            return sh
        }
        func main() -> int64 {
            let sq: Sq? = Sq(s: 3)
            let n: int64? = 4
            let a: Shape? = sq
            show(n)
            let h = Holder(sh: sq)
            let sqs: [Sq?] = [sq]
            let xs: Shapes = sqs
            let ok: Shape? = Sq(s: 2)
            show(keep(ok))
            return 0
        }
        """)
    assert len(errs) == 5
    assert test_support.any_message_contains(errs, needle: "expected `Shape?`, got `Sq?`; rewrap it instead, as in `match sq { Some(v) -> v none -> none }`")
    assert test_support.any_message_contains(errs, needle: "expected `Shape?`, got `int64?`; rewrap it instead, as in `match n { Some(v) -> v none -> none }`")
    assert test_support.any_message_contains(errs, needle: "expected `[Shape?]`, got `[Sq?]`")
    assert test_support.any_message_contains(errs, needle: "unwrap it first") == false
    let call_errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        func show(anon sh: Shape?) -> none {}
        func mksq() -> Sq? {
            return Sq(s: 1)
        }
        func main() -> int64 {
            show(mksq())
            let rewrapped: Shape? = match mksq() {
                Some(v) -> v
                none -> none
            }
            show(rewrapped)
            return 0
        }
        """)
    assert len(call_errs) == 1
    assert call_errs[0].message == "error: expected `Shape?`, got `Sq?`; rewrap it instead with a `match` whose arms are `Some(v) -> v` and `none -> none`"
}

test "an optional that becomes the value of an optional keeps its type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        type MaybeShape = Shape?
        type MaybeInt = int64?
        func show(anon sh: MaybeShape?) -> none {}
        func count(anon n: MaybeInt?) -> none {}
        func main() -> int64 {
            let sq: Sq? = Sq(s: 3)
            let sh: Shape? = Sq(s: 2)
            let n: int64? = 4
            let b: bool? = true
            show(sq)
            show(sh)
            count(n)
            count(b)
            return 0
        }
        """)
    assert len(errs) == 2
    assert errs[0].message == "error: expected `Shape??`, got `Sq?`; rewrap it instead, as in `match sq { Some(v) -> v none -> none }`"
    assert errs[0].line == 17
    assert errs[1].message == "error: expected `int64??`, got `bool?`"
    assert errs[1].line == 20
}

test "an argument must have its parameter's type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        interface Any {}
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s * self.s }
        }
        type Gen[T] = struct {
            v: T
        }
        type Color = enum {
            Red
            Green
        }
        extern func labs(anon n: int64) -> int64
        func take(anon xs: [Shape]) -> int64 { return len(xs) }
        func gs(anon g: Gen[str]) -> int64 { return 0 }
        func want(anon n: int64) -> int64 { return n }
        func shape(anon s: Shape) -> int64 { return s.area() }
        func keep(anon a: Any) -> int64 { return 0 }
        func main() -> int64 {
            print(5)
            let sqs = [Sq(s: 1)]
            take(sqs)
            gs(Gen[int64](v: 1))
            let m = Map[str, int64]()
            want(m["k"])
            shape(Color.Red)
            keep(b"y")
            let f: func(int64) -> int64 = want
            f("a")
            labs("x")
            return 0
        }
        """)
    assert len(errs) == 8
    assert errs[0].message == "error: expected `str`, got `int64`"
    assert errs[1].message == "error: expected `[Shape]`, got `[Sq]`"
    assert errs[2].message == "error: expected `Gen[str]`, got `Gen[int64]`"
    assert errs[3].message.contains("expected `int64`, got `int64?`; unwrap it first")
    assert errs[4].message == "error: expected `Shape`, got `Color`"
    assert errs[5].message == "error: expected `Any`, got `bytes`"
    assert errs[6].message == "error: expected `int64`, got `str`"
    assert errs[6].line == 32
    assert errs[7].message == "error: expected `int64`, got `str`"
    assert errs[7].line == 33
}

