// A generic constructor `Box[int64](...)` of a type that only another module
// declares gets the same hint as a plain constructor.
import "./type_bare_generic_ctor_dep"

func main() -> int64 {
    let a = Box[int64](v: 1)
    let b = Wrap[str](v: "x")
    return 0
}

// expected errors:
// 6:13: error: unknown type `Box`; tests/type_bare_generic_ctor_dep.kod declares `Box`: write `type_bare_generic_ctor_dep.Box` or list it in the import (`{ Box }`)
// 7:13: error: unknown type `Wrap`; tests/type_bare_generic_ctor_dep.kod declares `Wrap`: write `type_bare_generic_ctor_dep.Wrap` or list it in the import (`{ Wrap }`)
