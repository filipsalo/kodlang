// `match` on an int64 with character and int literal patterns.

test "match on an int64 picks a character literal's arm" {
	let c: int64 = 'B'
	mut got = ""
	match c {
		'A' -> got = "A"
		'B' -> got = "B"
		else got = "other"
	}
	assert got == "B"
}

test "match on an int64 picks an int literal's arm" {
	let n: int64 = 42
	mut got = ""
	match n {
		1 -> got = "one"
		42 -> got = "forty-two"
		else got = "other"
	}
	assert got == "forty-two"
}
