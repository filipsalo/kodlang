type Box = struct {
    label: str

    func twice(self) -> Box {
        return Box(label: self.label + self.label)
    }

    func name(self) -> str {
        return self.label
    }

    func to_str(self) -> str {
        return f"Box({self.label})"
    }
}

type Holder = struct {
    seed: str

    func make(self) -> Later {
        return Later(pad: 0, s: self.seed)
    }
}

type Later = struct {
    pad: int64
    s: str
}

func main() -> int64 {
    let b = Box(label: "ab")
    print(b.twice().name())
    print(f"{b.twice()}")

    let h = Holder(seed: "later")
    let l = h.make()
    print(l.s)
    return 0
}

// expected output:
// abab
// Box(abab)
// later
// expected status:
// 0
