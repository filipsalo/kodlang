// putchar is a builtin extern, and shares libc's stdout buffer with print.
import "testing"

test "putchar and print share stdout" {
    let r = testing.run(func() {
        putchar(72)
        print("-")
        putchar(105)
        putchar(10)
    })
    assert r.status == 0
    assert r.stdout == "H-\ni\n"
}
