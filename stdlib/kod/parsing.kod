import "arrays"
import "kod/ast"
import "kod/lexing"
import "primitives/format"

// A grouped literal's text without its spaces.
func strip_spaces(anon s: str) -> str {
    mut out: str = ""
    for i in 0..len(s) {
        if s[i] != ' ' {
            out = out + s[i..i + 1]
        }
    }
    return out
}

func str_to_int(anon s: str) -> int64 {
    // Base-prefix forms — lexer's already validated digit-set membership.
    if len(s) >= 2 and s[0] == '0' {
        if s[1] == 'x' {
            return parse_hex_after_prefix(s)
        }
        if s[1] == 'o' {
            return parse_int_radix(s, base: 8, start: 2)
        }
        if s[1] == 'b' {
            return parse_int_radix(s, base: 2, start: 2)
        }
    }
    // Decimal: thousands-grouped literals (`1 000 000`) reach str_to_int
    // with embedded spaces; the lexer has already validated grouping,
    // so here we just skip them.
    mut result: int64 = 0
    mut i: int64 = 0
    for i < len(s) {
        if s[i] == ' ' {
            i = i + 1
        } else {
            result = result.wrapping_mul(10).wrapping_add(s[i] - '0')
            i = i + 1
        }
    }
    return result
}

// 0 when the literal fits int64, 1 when it is 2^63 (whose negation does), 2 when larger.
func literal_excess(anon s: str) -> int64 {
    mut base: int64 = 10
    mut i: int64 = 0
    if len(s) >= 2 and s[0] == '0' {
        if s[1] == 'x' {
            base = 16
            i = 2
        } else if s[1] == 'o' {
            base = 8
            i = 2
        } else if s[1] == 'b' {
            base = 2
            i = 2
        }
    }
    let max: int64 = 9223372036854775807
    mut value: int64 = 0
    mut excess: int64 = 0
    for i < len(s) {
        let c = s[i]
        if c != ' ' {
            mut d: int64 = c - '0'
            if c >= 'a' and c <= 'f' {
                d = c - 'a' + 10
            }
            if c >= 'A' and c <= 'F' {
                d = c - 'A' + 10
            }
            if excess > 0 {
                excess = 2
            } else if value > (max - d) / base {
                excess = 2
                if (max - d) % base == base - 1 and value == (max - d) / base + 1 {
                    excess = 1
                }
            } else {
                value = value * base + d
            }
        }
        i = i + 1
    }
    return excess
}

// Parse a 0/1/.../7 string starting at `start` in base `base`. Used
// for `0o…` and `0b…` literals — both narrow enough to share one loop.
func parse_int_radix(anon s: str, base: int64, start: int64) -> int64 {
    mut result: int64 = 0
    for i in start..len(s) {
        result = result.wrapping_mul(base).wrapping_add(s[i] - '0')
    }
    return result
}

// Hex needs its own loop because `a..f` and `A..F` map outside the
// `c - '0'` range used by the radix loop.
func parse_hex_after_prefix(anon s: str) -> int64 {
    mut result: int64 = 0
    for i in 2..len(s) {
        let c = s[i]
        mut digit: int64 = 0
        if c >= '0' and c <= '9' {
            digit = c - '0'
        }
        if c >= 'a' and c <= 'f' {
            digit = c - 'a' + 10
        }
        if c >= 'A' and c <= 'F' {
            digit = c - 'A' + 10
        }
        result = result.wrapping_mul(16).wrapping_add(digit)
    }
    return result
}

// The value of a hex digit, or -1 if `c` isn't one.
func hex_digit_value(anon c: int64) -> int64 {
    if c >= '0' and c <= '9' {
        return c - '0'
    }
    if c >= 'a' and c <= 'f' {
        return c - 'a' + 10
    }
    if c >= 'A' and c <= 'F' {
        return c - 'A' + 10
    }
    return -1
}

// The UTF-8 encoding of code point `cp`, which must be a Unicode scalar value.
func utf8_of(anon cp: int64) -> str {
    if cp < 128 {
        return kod_bytes_to_str(kod_bytes_from_array([cp]))
    }
    if cp < 2048 {
        return kod_bytes_to_str(kod_bytes_from_array([192 + cp / 64, 128 + cp % 64]))
    }
    if cp < 65536 {
        return kod_bytes_to_str(kod_bytes_from_array([224 + cp / 4096, 128 + (cp / 64) % 64, 128 + cp % 64]))
    }
    return kod_bytes_to_str(kod_bytes_from_array([240 + cp / 262144, 128 + (cp / 4096) % 64, 128 + (cp / 64) % 64, 128 + cp % 64]))
}

// Index of the `}` that closes the `\u{...}` escape whose `u` is at `u_at`, or -1 if there
// is no `{` after the `u` or the text between the braces isn't 1 to 6 hex digits.
func read_unicode_escape(anon raw: str, u_at: int64) -> int64 {
    let end: int64 = len(raw)
    if u_at + 1 >= end or raw[u_at + 1] != '{' {
        return -1
    }
    mut j: int64 = u_at + 2
    mut digits: int64 = 0
    for j < end and raw[j] != '}' {
        if hex_digit_value(raw[j]) < 0 {
            return -1
        }
        digits = digits + 1
        j = j + 1
    }
    if j >= end or digits == 0 or digits > 6 {
        return -1
    }
    return j
}

// The code point written between the braces of a `\u{...}` whose `u` is at `u_at`
// and whose closing brace is at `close`.
func unicode_escape_value(anon raw: str, u_at: int64, close: int64) -> int64 {
    mut value: int64 = 0
    mut j: int64 = u_at + 2
    for j < close {
        value = value * 16 + hex_digit_value(raw[j])
        j = j + 1
    }
    return value
}

func is_scalar_value(anon cp: int64) -> bool {
    return cp <= 1114111 and (cp < 55296 or cp > 57343)
}

// What is wrong with the first malformed `\x` or `\u` escape, or the first
// escape there isn't, in a string body, or "" if there is none.
func escape_problem(anon raw: str) -> str {
    let end: int64 = len(raw)
    mut i: int64 = 0
    for i < end {
        if raw[i] == '\\' and i + 1 < end {
            i = i + 1
            if raw[i] == 'x' {
                if i + 2 >= end or hex_digit_value(raw[i + 1]) < 0 or hex_digit_value(raw[i + 2]) < 0 {
                    return "error: invalid escape `\\x`: it needs two hex digits"
                }
                i = i + 2
            } else if raw[i] == 'u' {
                if i + 1 >= end or raw[i + 1] != '{' {
                    return "error: invalid escape `\\u`: write the character as `\\u{...}`, for instance `\\u{1F600}`"
                }
                let close: int64 = read_unicode_escape(raw, u_at: i)
                if close < 0 {
                    return "error: invalid escape `\\u{...}`: it needs 1 to 6 hex digits between the braces"
                }
                if not is_scalar_value(unicode_escape_value(raw, u_at: i, close: close)) {
                    return "error: invalid escape `\\u{...}`: not a Unicode scalar value (above 10FFFF, or a surrogate)"
                }
                i = close
            } else if raw[i] != 'n' and raw[i] != 't' and raw[i] != 'r' and raw[i] != '0' and raw[i] != '\\' and raw[i] != '"' and raw[i] != '\'' and raw[i] != '{' and raw[i] != '}' {
                let c: str = raw[i..i + 1]
                return f"error: unknown escape `\\{c}`: write `\\\\` for a backslash, or the string raw, as r\"...\""
            }
        }
        i = i + 1
    }
    return ""
}

// Process backslash escape sequences in a raw string body.
func unescape_str(anon raw: str) -> str {
    // A string builder (stdlib/strbuilder.kod is not in the compiler's link list).
    let out = kod_sb_new()
    mut i: int64 = 0
    let end: int64 = len(raw)
    for i < end {
        // Copy the run up to the next escape whole: byte by byte, `+` would copy the
        // result each time, which is quadratic in a long literal.
        mut run_end: int64 = i
        for run_end < end and raw[run_end] != '\\' {
            run_end = run_end + 1
        }
        if run_end > i {
            kod_sb_append(out, raw[i..run_end])
            i = run_end
            continue
        }
        if i + 1 >= end {
            kod_sb_append(out, raw[i..i + 1])
            i = i + 1
            continue
        }
        i = i + 1
        if raw[i] == 'n' {
            kod_sb_append(out, "\n")
        } else if raw[i] == 't' {
            kod_sb_append(out, "\t")
        } else if raw[i] == 'r' {
            kod_sb_append(out, "\r")
        } else if raw[i] == '\\' {
            kod_sb_append(out, "\\")
        } else if raw[i] == '\'' {
            kod_sb_append(out, "'")
        } else if raw[i] == '0' {
            kod_sb_append_byte(out, 0)
        } else if raw[i] == '"' or raw[i] == '{' or raw[i] == '}' {
            kod_sb_append(out, raw[i..i + 1])
        } else if raw[i] == 'x' {
            // `\xHH`: one byte. A malformed one is reported by escape_problem.
            if i + 2 < end and hex_digit_value(raw[i + 1]) >= 0 and hex_digit_value(raw[i + 2]) >= 0 {
                kod_sb_append_byte(out, hex_digit_value(raw[i + 1]) * 16 + hex_digit_value(raw[i + 2]))
                i = i + 2
            }
        } else if raw[i] == 'u' {
            // `\u{H...}`: a character, as UTF-8.
            let close: int64 = read_unicode_escape(raw, u_at: i)
            if close >= 0 {
                let cp: int64 = unicode_escape_value(raw, u_at: i, close: close)
                if is_scalar_value(cp) {
                    kod_sb_append(out, utf8_of(cp))
                    i = close
                }
            }
        }
        i = i + 1
    }
    return kod_sb_to_str(out)
}

// Dedent a triple-quoted body. `body` is everything between the
// opening and closing `"""` — i.e., raw[3..len(raw)-3]. The first line
// (between opening `"""` and the first `\n`) is discarded; the indent
// of the final line (the one carrying the closing `"""`) is stripped
// from each content line that starts with it. Escape sequences are
// NOT processed here — callers run unescape_str on the result (or on
// each interpolation chunk, for f-strings).
func dedent_triple_body(anon body: str) -> str {
    let n: int64 = len(body)
    mut first_nl: int64 = 0
    for first_nl < n and body[first_nl] != '\n' {
        first_nl = first_nl + 1
    }
    mut content_start: int64 = first_nl
    if content_start < n {
        content_start = content_start + 1
    }
    mut last_nl: int64 = n - 1
    for last_nl >= content_start and body[last_nl] != '\n' {
        last_nl = last_nl - 1
    }
    if last_nl < content_start {
        return ""
    }
    let indent: str = body[last_nl + 1..n]
    let indent_len: int64 = len(indent)
    let content: str = body[content_start..last_nl + 1]
    mut result: str = ""
    mut line_start: int64 = 0
    let m: int64 = len(content)
    for i in 0..m {
        if content[i] == '\n' {
            mut line: str = content[line_start..i + 1]
            if len(line) >= indent_len + 1 {
                mut prefix_match: bool = true
                for p in 0..indent_len {
                    if line[p] != indent[p] {
                        prefix_match = false
                    }
                }
                if prefix_match {
                    line = line[indent_len..len(line)]
                }
            }
            result = result + line
            line_start = i + 1
        }
    }
    return result
}

// True if `s` starts with three " characters (the triple-quoted prefix).
// Written character-by-character because Kod doesn't yet have a `\"`
// escape in string literals.
func is_triple_quoted(anon s: str) -> bool {
    return len(s) >= 6 and s[0] == '"' and s[1] == '"' and s[2] == '"'
}

// Parse a string token value (with surrounding quotes) into a Kod string,
// processing escape sequences. Handles both regular "..." and triple
// """...""" forms.
func parse_string_value(anon raw: str) -> str {
    // `r"..."`: the text as it is.
    if is_raw_string(raw) {
        return string_body(raw[1..])
    }
    return unescape_str(string_body(raw))
}

// Whether a string token's value is a raw string's, `r"..."`.
func is_raw_string(anon raw: str) -> bool {
    return len(raw) >= 2 and raw[0] == 'r' and raw[1] == '"'
}

// The text between the quotes of a string token, dedented if triple-quoted, with its
// escape sequences still in it.
func string_body(anon raw: str) -> str {
    if is_triple_quoted(raw) {
        return dedent_triple_body(raw[3..len(raw) - 3])
    }
    return raw[1..len(raw) - 1]
}

// ParseError is the structured diagnostic the parser produces when
// `expect()` finds a token kind that doesn't match. Same field shape
// as codegen.Diagnostic so callers can fold parser errors into the codegen's
// error list without re-formatting (see kodc.kod / tools/lsp.kod).
// A `for` of a comprehension, or an `if`, which has a `cond`.
type CompClause = struct {
    names: [TupleNames] = []
    iter: int64 = 0
    range: RangeTail = RangeTail()
    cond: int64 = 0
}

// The rest of a range after its start: `..b`, `..=b`, and `step k`. `stop` is 0
// when there is no range.
type RangeTail = struct {
    stop: int64 = 0
    inclusive: bool = false
    step: int64 = 0
}

// What `(a, (b, _))` binds: a name, or a hidden one and the parts taken from it.
type TupleNames = shared struct {
    name: str
    span: ast.Span
    parts: [TupleNames]
}

// A block that gives a value: the statements before it, and the value.
type ValueBlock = struct {
    pre: [int64]
    body: int64
}

// An early exit parse_block folds the rest of the block into (see fold_guards):
// `at` is where the rest starts in the block's statements and `from` in its tokens.
// A `try x` or `must x` statement, which narrows `x` from token `from` on.
type Unwrap = shared struct {
    stmt: int64
    from: int64
    name: str
}

type Guard = shared struct {
    at: int64
    from: int64
    arm: int64
    pattern: int64
    name: str
    // The call the guard's block ends in, when only codegen can tell whether it returns.
    call: int64 = 0
}

// The name a payload position binds when it holds pattern `pattern_id`.
// The most elements a tuple has: builtins.kod declares a struct for each number of them.
let MAX_TUPLE: int64 = 8
// What the hidden name of the tuple a pattern takes apart begins with.
let TUPLE_PATTERN: str = "__pattuple"

func hidden_binding(anon pattern_id: int64) -> str {
    return f"__pat{pattern_id}"
}

func is_hidden_binding(anon name: str) -> bool {
    return name.starts_with("__pat")
}

func payload_bindings(anon items: [ast.SubPattern]) -> [str] {
    mut bindings: [str] = []
    for item in items {
        bindings += [item.binding]
    }
    return bindings
}

type ParseError = struct {
    path: str
    line: int64
    col: int64
    end_col: int64
    message: str
    source_line: str
    caret: str

    func to_str(self) -> str {
        return f"{self.path}:{self.line}:{self.col}: {self.message}"
    }
}

// What enter_function keeps of the function around a body.
type SavedFunction = struct {
    yields: [int64]
    yield_values: [int64]
    value_returns: [lexing.Token]
    value_return_stmts: [int64]
    loops: int64
    labels: [str] = []
}

type Parser = shared struct {
    // Path of the source file this parser was built from. Used by
    // the codegen's error reporter to produce `path:line:col` prefixes.
    path: str
    // The original source text. Kept on the parser so downstream tools
    // (the codegen's error reporter) can decode `Span.start` byte
    // offsets into line:col without re-reading the file.
    source: str
    tokens: [lexing.Token]
    pos: int64

    exprs: [ast.Expr]
    // Parallel to `exprs`: source span for each expression. Indexed
    // by expr_id. Populated by alloc_expr.
    expr_spans: [ast.Span]
    stmts: [ast.Stmt]
    type_exprs: [ast.TypeExpr]
    patterns: [ast.Pattern]
    // By pattern id: the positions of its payload that hold a pattern.
    pattern_subs: [[ast.SubPattern]] = []
    match_arms: [ast.MatchArm]
    match_expr_arms: [ast.MatchExprArm]
    // The statements that go after the one just parsed, in its place (see first_of).
    more_stmts: [int64] = []
    // How many loops of the function being parsed are open.
    loops: int64 = 0
    // Where the last statement of the block parsed last begins, or -1.
    last_stmt_at: int64 = -1
    func_decls: [ast.FuncDecl]

    // Errors accumulated by `expect`/`expect_identifier` when the
    // next token doesn't have the expected kind. Empty means the
    // input parsed cleanly. Inspect this after `parse_module` —
    // the parser advances past the bad token and keeps going so
    // downstream errors don't cascade off the original cause.
    errors: [ParseError]
    // After an error, the parser is quiet until the next statement, field,
    // parameter, match arm or declaration starts: what it reports meanwhile
    // is likely a cascade. Such errors are still recorded, so the checks that
    // count errors work as before, and `parse_module` drops them at the end.
    quiet: bool = false
    error_quiet: [bool] = []
    // Set once the declarations are parsed: the checks after that report
    // each error they find.
    parsed: bool = false
    // How many errors so far left the parser out of step with the source
    // (an unexpected token, something after the end of a statement): only
    // those make it quiet and mark their declaration broken. Others, such as
    // a literal too large, leave the parse as written.
    desyncs: int64 = 0
    // Where each top-level declaration with such an error starts and ends
    // (byte offsets), so codegen can leave out errors inside it.
    broken_starts: [int64] = []
    broken_ends: [int64] = []
    // The column the module's first declaration starts in, which the others
    // are taken to start in too, for skipping to one after an error.
    decl_col: int64 = -1
    // Set by parse_expr_substring: where the `:` before a format spec is in the
    // substring, or -1.
    fspec_at: int64 = -1
    // Where `expect` last left a token it didn't want: a second miss there
    // takes it, so a loop that makes no progress can't go round for good.
    kept_pos: int64 = -1

    // Lazy cache of line-start byte offsets. `line_starts[i]` is the
    // byte offset of the (i+1)-th line; line 1 starts at 0. Built
    // the first time `codegen.line_of_offset` runs against this
    // parser, then reused for every subsequent lookup (per-statement
    // backtrace line tracking does thousands of these per module).
    line_starts: [int64] = []
    // Parallel to `type_exprs`: the span of each type's first token.
    type_spans: [ast.Span] = []
    // IntLit exprs whose literal doesn't fit, so codegen gives them no kind.
    bad_lits: [int64] = []
    // Exprs written in parentheses, which may mix `and` and `or`.
    grouped: [int64] = []
    // How many `spawn`s have been parsed: each numbers its hidden names, and a
    // module with any imports `tasks` as `#spawn` (parse_module).
    spawns: int64 = 0
    // The function being parsed: its `yield` statements, and the value each
    // sends (one with any is a generator, generator_body), and where it returns
    // a value.
    yields: [int64] = []
    yield_values: [int64] = []
    value_returns: [lexing.Token] = []
    value_return_stmts: [int64] = []
    // Inside a generic function, or a method of a generic type: a function
    // literal here is compiled per instance (ast.FuncDecl.in_generic).
    in_generic: bool = false
    // Parallel to `patterns`: where each pattern's last token ends.
    pattern_ends: [int64] = []
    // Parallel to `type_exprs` up to the last qualified one: the module alias a
    // type is written with (`pa` of `pa.Pt`), or "". Missing entries are "".
    type_quals: [str] = []
    // How many bindings got a name of their own (`x#1`) because they hide one in force.
    renames: int64 = 0
    // Per statement, the `let` locals of its block it uses last (the Renamer
    // works it out), for codegen to release after it.
    release_after: Map[int64, [str]] = Map[int64, [str]]()
    // A call's callee that names a local function, and that function's literal:
    // codegen checks the call's labels against its parameters.
    local_fn_calls: Map[int64, int64] = Map[int64, int64]()
    // Whether the file declares a local function: only then are calls looked up.
    has_local_fns: bool = false
    // `and` chains with an `is` that binds, not yet taken as an `if` or `for`
    // condition: after the statement they become `match`es (value_chain).
    value_chains: [int64] = []
    // `name: for ...`: each loop statement's label, and each `break name` or
    // `continue name` statement's. `open_labels` has one entry per loop being
    // parsed ("" for none); `pending_label` waits for the next loop's body.
    loop_labels: Map[int64, str] = Map[int64, str]()
    jump_labels: Map[int64, str] = Map[int64, str]()
    open_labels: [str] = []
    pending_label: str = ""
    // Match expressions parsed so far, so a FuncDecl can tell whether its body has one.
    binding_exprs: int64 = 0
    // Whether the parameter list parse_param_list read last ended in `...`.
    params_variadic: bool = false
    // The module-level constants parsed so far: their names, and the expressions that
    // give their values (for the check that none refers to itself).
    const_names: [str] = []
    const_exprs: [int64] = []
    const_spans: [ast.Span] = []
    // Each local a function binds (parameter, `let`, `mut`, `for` variable,
    // pattern binding) and where its name starts, for codegen's checks.
    // Whether the arm's patterns just parsed have a guard after them.
    arm_guarded: bool = false
    // Set by parse_match_arm_patterns when an arm had no `->`: the rest of it was
    // skipped, so the caller adds no arm for it.
    arm_broken: bool = false
    binding_names: [str] = []
    binding_starts: [int64] = []
    // The guard the statement just parsed set up (see fold_guards): the match
    // arm the rest of its block goes in, that arm's pattern, and the name it narrows.
    guard_arm: int64 = -1
    guard_pat: int64 = -1
    guard_name: str = ""
    guard_call: int64 = 0
    // Folds that hold only if the call their guard ends in never returns: the
    // match statement, the call, and the arm the rest of the block went in.
    fold_stmts: [int64] = []
    fold_calls: [int64] = []
    fold_arms: [int64] = []
    // A name in a payload position, which binds unless it names a type.
    payload_names: [str] = []
    payload_starts: [int64] = []
    // Names that are type patterns if they name types, which codegen decides
    // (resolve_type_patterns): a bare payload name, by its pattern and position,
    // and `m.T` or `m.T(b)`, by its pattern and position -1, with the type each would be.
    maybe_type_pats: [int64] = []
    maybe_type_slots: [int64] = []
    maybe_type_ids: [int64] = []

    func peek(self) -> lexing.Token {
        if self.pos >= len(self.tokens) {
            return self.tokens[len(self.tokens) - 1]
        }
        return self.tokens[self.pos]
    }

    func peek_kind(self) -> lexing.TokenKind {
        if self.pos >= len(self.tokens) {
            return lexing.TokenKind.EOF
        }
        return self.tokens[self.pos].kind
    }

    func peek_kind_at(self, anon offset: int64) -> lexing.TokenKind {
        let idx: int64 = self.pos + offset
        if idx >= len(self.tokens) {
            return lexing.TokenKind.EOF
        }
        return self.tokens[idx].kind
    }

    // Past-the-end stays at the final token (always lexing.TokenKind.EOF).
    // Without this clamp, error-recovery advances past the EOF token and
    // peek_kind starts reading garbage memory; the parse loop then sees
    // non-EOF kinds and never terminates.
    func advance(self) -> lexing.Token {
        if self.pos >= len(self.tokens) {
            return self.tokens[len(self.tokens) - 1]
        }
        let tok: lexing.Token = self.tokens[self.pos]
        self.pos = self.pos + 1
        return tok
    }

    func at(self, anon kind: lexing.TokenKind) -> bool {
        return self.peek_kind() == kind
    }

    func try_consume(self, anon kind: lexing.TokenKind) -> bool {
        if self.peek_kind() == kind {
            self.advance()
            return true
        }
        return false
    }

    func expect(self, anon kind: lexing.TokenKind) -> lexing.Token {
        if self.peek_kind() != kind {
            self.record_unexpected(expected: kind.name(), got: self.peek())
            if self.structural(self.peek_kind()) and self.pos != self.kept_pos {
                self.kept_pos = self.pos
                return self.peek()
            }
        }
        return self.advance()
    }

    // A bare name in a payload position, noted in payload_names, with the type it may name.
    func payload_name(self) -> ast.SubPattern {
        let span = self.here()
        self.payload_starts += [span.start]
        let name = self.expect_identifier()
        self.payload_names += [name]
        return ast.SubPattern(binding: name, pattern: -1, type_id: self.alloc_type(ast.TypeExpr.Named(:name), :span))
    }

    func note_maybe_type(self, anon pat: int64, slot: int64, type_id: int64) -> none {
        self.maybe_type_pats += [pat]
        self.maybe_type_slots += [slot]
        self.maybe_type_ids += [type_id]
    }

    // A type pattern on `type_id`, binding `binding` (`_` when empty).
    func type_pattern(self, anon type_id: int64, binding: str) -> int64 {
        mut b = binding
        if len(b) == 0 {
            b = "_"
        }
        let bindings: [str] = [b]
        return self.alloc_pattern(ast.Pattern.ImplicitEnumPat(variant_name: f"$t{type_id}", :bindings))
    }

    // expect_identifier for a name a local binds, noted in binding_names.
    func binding_identifier(self) -> str {
        self.binding_starts += [self.peek().start]
        let name = self.expect_identifier()
        self.binding_names += [name]
        return name
    }

    // A field's name, or a tuple element's number.
    func expect_field(self) -> str {
        if self.at(.IntegerLit) {
            return self.advance().value
        }
        return self.expect_identifier()
    }

    func expect_identifier(self) -> str {
        if self.peek_kind() != .Identifier {
            self.record_unexpected(expected: "identifier", got: self.peek())
            if self.structural(self.peek_kind()) and self.pos != self.kept_pos {
                self.kept_pos = self.pos
                return ""
            }
        }
        return self.advance().value
    }

    // Push a structured ParseError onto self.errors. Mirrors the
    // line/col/source_line/caret computation in codegen.report_error so
    // callers can render parse errors the same way (and the LSP can
    // publish them as Diagnostics without reformatting).
    func record_unexpected(self, expected: str, got: lexing.Token) -> none {
        self.record_error(f"error: expected {expected}, got {got.kind.name()}", :got, desync: true)
    }

    func record_error(self, anon message: str, got: lexing.Token, desync: bool = false) -> none {
        let offset: int64 = got.start
        mut line: int64 = 1
        mut col: int64 = 1
        mut line_start: int64 = 0
        mut i: int64 = 0
        for i < offset and i < len(self.source) {
            if self.source[i] == '\n' {
                line = line + 1
                col = 1
                line_start = i + 1
            } else {
                col = col + 1
            }
            i = i + 1
        }
        mut line_end: int64 = line_start
        for line_end < len(self.source) and self.source[line_end] != '\n' {
            line_end = line_end + 1
        }
        let raw_line: str = self.source[line_start..line_end]
        mut line_text: str = ""
        for li in 0..len(raw_line) {
            if raw_line[li] == '\t' {
                line_text = line_text + "    "
            } else {
                line_text = line_text + raw_line[li..li + 1]
            }
        }
        mut caret: str = ""
        for s in 0..col - 1 {
            if line_start + s < len(self.source) and self.source[line_start + s] == '\t' {
                caret = caret + "    "
            } else {
                caret = caret + " "
            }
        }
        caret = caret + "^"
        // Use the token's own width for the end_col, falling back to one.
        mut width: int64 = got.end - got.start
        if width < 1 {
            width = 1
        }
        let end_col: int64 = col + width
        self.errors += [ParseError(path: self.path, :line, :col, :end_col, :message, source_line: line_text, :caret)]
        self.error_quiet += [self.quiet]
        if desync and not self.parsed {
            self.quiet = true
            self.desyncs += 1
        }
    }

    // The column (from 0) of the next token.
    func column(self) -> int64 {
        let start = self.peek().start
        mut k = start
        for k > 0 and self.source[k - 1] != '\n' {
            k -= 1
        }
        return start - k
    }

    // Whether the next token is a keyword only a declaration starts with
    // (`func name`, not `func(`), so no statement does.
    func at_decl_keyword(self) -> bool {
        match self.peek_kind() {
            .KwType | .KwInterface | .KwImport | .KwExtern | .KwTest -> return true
            .KwFunc -> return self.peek_kind_at(1) == .Identifier
            else return false
        }
    }

    // Whether the next token may start a declaration: it is in the column the
    // module's declarations start in, and isn't a `}` (which ends one) or the
    // end of a line.
    func at_decl_start(self) -> bool {
        if self.decl_col < 0 or self.at(.CloseCurly) or self.at(.EOL) {
            return false
        }
        return self.column() == self.decl_col
    }

    // Whether `kind` closes something or ends a line or the file: `expect`
    // leaves such a token for whoever it belongs to.
    func structural(self, anon kind: lexing.TokenKind) -> bool {
        match kind {
            .CloseCurly | .CloseParen | .CloseBracket | .EOL | .EOF -> return true
            else return false
        }
    }

    // Report a malformed `\x` or `\u` escape in the string body `body` of `tok`.
    func check_escapes(self, anon body: str, tok: lexing.Token) -> none {
        let problem: str = escape_problem(body)
        if len(problem) > 0 {
            self.record_error(problem, got: tok)
        }
    }

    func check_literal_range(self, anon tok: lexing.Token) -> bool {
        if literal_excess(tok.value) > 0 {
            self.record_error(f"error: integer literal `{tok.value}` doesn't fit in `int64`, whose largest value is 9223372036854775807", got: tok)
            return false
        }
        return true
    }

    // Whether the token `offset` ahead continues a postfix chain.
    func postfix_at(self, anon offset: int64) -> bool {
        match self.peek_kind_at(offset) {
            .OpenParen -> return true
            .Dot -> return true
            .OpenBracket -> return true
            .Question -> return true
            else return false
        }
    }

    func skip_newlines(self) -> none {
        for self.at(.EOL) or self.at(.Comment) {
            self.advance()
        }
    }

    func alloc_expr(self, anon e: ast.Expr, span: ast.Span) -> int64 {
        mut id: int64 = len(self.exprs)
        self.exprs += [e]
        self.expr_spans += [span]
        return id
    }

    // Capture the byte offset of the upcoming token. Caller-side
    // helper: stash the result at the top of a parse method, build
    // the expression, then pass the result as the `span` argument
    // to alloc_expr.
    func here(self) -> ast.Span {
        return ast.Span(start: self.peek().start)
    }

    func alloc_stmt(self, anon s: ast.Stmt) -> int64 {
        mut id: int64 = len(self.stmts)
        self.stmts += [s]
        return id
    }

    func alloc_type(self, anon tok: ast.TypeExpr, span: ast.Span, qual: str = "") -> int64 {
        mut id: int64 = len(self.type_exprs)
        self.type_exprs += [tok]
        self.type_spans += [span]
        if len(qual) > 0 {
            for len(self.type_quals) < id {
                self.type_quals += [""]
            }
            self.type_quals += [qual]
        }
        return id
    }

    func alloc_pattern(self, anon p: ast.Pattern) -> int64 {
        mut id: int64 = len(self.patterns)
        self.patterns += [p]
        let no_subs: [ast.SubPattern] = []
        self.pattern_subs += [no_subs]
        mut end: int64 = 0
        if self.pos > 0 {
            end = self.tokens[self.pos - 1].end
        }
        self.pattern_ends += [end]
        return id
    }

    func alloc_match_arm(self, anon a: ast.MatchArm) -> int64 {
        mut id: int64 = len(self.match_arms)
        self.match_arms += [a]
        return id
    }

    func alloc_match_expr_arm(self, anon a: ast.MatchExprArm) -> int64 {
        mut id: int64 = len(self.match_expr_arms)
        self.match_expr_arms += [a]
        return id
    }

    func alloc_func_decl(self, anon f: ast.FuncDecl) -> int64 {
        mut id: int64 = len(self.func_decls)
        self.func_decls += [f]
        return id
    }

    func parse_type_expr_core(self) -> int64 {
        mut span: ast.Span = self.here()
        // A group: `(T)`, as in `(A | B)?` or `(func() -> int64) | str`.
        if self.try_consume(.OpenParen) {
            mut inner: int64 = self.parse_type_expr()
            if self.at(.Comma) {
                inner = self.parse_tuple_type(inner, :span)
            }
            self.expect(.CloseParen)
            if self.try_consume(.Question) {
                return self.alloc_type(ast.TypeExpr.Optional(:inner), :span)
            }
            return inner
        }
        // Array type: [T]
        if self.try_consume(.OpenBracket) {
            mut inner: int64 = self.parse_type_expr()
            self.expect(.CloseBracket)
            let array_id: int64 = self.alloc_type(ast.TypeExpr.Array(:inner), :span)
            if self.try_consume(.Question) {
                return self.alloc_type(ast.TypeExpr.Optional(inner: array_id), :span)
            }
            return array_id
        }
        // Function type: `func(T1, T2, ...) -> R`. Reuses the `func`
        // keyword (no `fn` token added) — the `(` immediately after
        // disambiguates from a declaration site, which never appears
        // in type position.
        if self.try_consume(.KwFunc) {
            self.expect(.OpenParen)
            mut params: [int64] = []
            if self.peek_kind() != .CloseParen {
                params += [self.parse_type_expr()]
                for self.try_consume(.Comma) {
                    params += [self.parse_type_expr()]
                }
            }
            self.expect(.CloseParen)
            self.expect(.Arrow)
            let return_typ: int64 = self.parse_type_expr()
            return self.alloc_type(ast.TypeExpr.Func(:params, :return_typ), :span)
        }
        // `none` doubles as both the keyword for the absent optional and
        // the void-return type. The lexer always lex's it as KwNone, so
        // accept it here without going through expect_identifier (which
        // would otherwise report "expected identifier, got `none`").
        mut name: str = ""
        if self.try_consume(.KwNone) {
            name = "none"
        } else {
            name = self.expect_identifier()
        }
        // Module-qualified type: 'mod.Name', with `mod` kept in type_quals.
        mut qual = ""
        if self.try_consume(.Dot) {
            span = self.here()
            qual = name
            name = self.expect_identifier()
        }
        // Optional: T?
        if self.try_consume(.Question) {
            mut inner: int64 = self.alloc_type(ast.TypeExpr.Named(:name), :span, :qual)
            return self.alloc_type(ast.TypeExpr.Optional(:inner), :span)
        }
        // Generic: T[U] or T[U, V, ...]. Codegen monomorphises per
        // concrete instantiation; preserve every type-argument.
        if self.try_consume(.OpenBracket) {
            mut args: [int64] = [self.parse_type_expr()]
            for self.try_consume(.Comma) {
                args += [self.parse_type_expr()]
            }
            self.expect(.CloseBracket)
            let generic_id: int64 = self.alloc_type(ast.TypeExpr.Generic(:name, :args), :span, :qual)
            if self.try_consume(.Question) {
                return self.alloc_type(ast.TypeExpr.Optional(inner: generic_id), :span)
            }
            return generic_id
        }
        return self.alloc_type(ast.TypeExpr.Named(:name), :span, :qual)
    }

    // `A | B | ...`. `T | none` is `T?` itself, so generic code can bind `T` through it.
    func parse_union_type(self) -> int64 {
        let span: ast.Span = self.here()
        let first: int64 = self.parse_type_expr_core()
        if not self.at(.Pipe) {
            return first
        }
        mut members: [int64] = [first]
        for self.try_consume(.Pipe) {
            members += [self.parse_type_expr_core()]
        }
        mut others: [int64] = []
        for member in members {
            mut is_none = false
            if self.type_exprs[member] is .Named(name) and name == "none" {
                is_none = true
            }
            if not is_none {
                others += [member]
            }
        }
        if len(others) == 0 {
            return first
        }
        if len(others) == 1 and len(members) > 1 {
            return self.alloc_type(ast.TypeExpr.Optional(inner: others[0]), :span)
        }
        return self.alloc_type(ast.TypeExpr.Union(:members), :span)
    }

    // The rest of `(A, B)`, after its first type.
    func parse_tuple_type(self, anon first: int64, span: ast.Span) -> int64 {
        mut args = [first]
        for self.try_consume(.Comma) {
            if self.at(.CloseParen) {
                break
            }
            args += [self.parse_type_expr()]
        }
        if not self.check_tuple_len(len(args), :span) {
            return first
        }
        return self.alloc_type(ast.TypeExpr.Generic(name: f"_Tuple{len(args)}", :args), :span)
    }

    func check_tuple_len(self, anon n: int64, span: ast.Span) -> bool {
        let at = lexing.Token(kind: .OpenParen, value: "", start: span.start, end: span.start + 1)
        if n < 2 {
            self.record_error("error: a tuple has at least two elements; `(x)` is just `x`", got: at)
        } else if n > MAX_TUPLE {
            self.record_error(f"error: a tuple has at most {MAX_TUPLE} elements; declare a struct for more", got: at)
        }
        return 2 <= n <= MAX_TUPLE
    }

    func parse_type_expr(self) -> int64 {
        let span: ast.Span = self.here()
        let grouped = self.at(.OpenParen)
        mut id: int64 = self.parse_union_type()
        // `(T or Error) or Error` is a result of a result; only a chain collapses.
        mut nests = grouped
        // Fallible result: `T or Error` desugars to Result[T, Error] — the
        // unified tagged-sum representation. Only `or Error` is supported;
        // the umbrella Error interface is the thrown type. A repeated
        // `T or Error or Error` collapses back to the same shape.
        for self.try_consume(.KwOr) {
            let err_tok: lexing.Token = self.peek()
            let err_name: str = self.expect_identifier()
            if err_name == "Error" {
                mut already_result: bool = false
                if self.type_exprs[id] is .Generic(gname, _gargs) and gname == "Result" and not nests {
                    already_result = true
                }
                nests = false
                if not already_result {
                    let error_id: int64 = self.alloc_type(ast.TypeExpr.Named(name: "Error"), span: ast.Span(start: err_tok.start))
                    let result_args: [int64] = [id, error_id]
                    id = self.alloc_type(ast.TypeExpr.Generic(name: "Result", args: result_args), :span)
                }
            } else {
                if err_tok.kind is .Identifier {
                    self.record_error(f"error: only `T or Error` is supported, got `or {err_name}`", got: err_tok)
                }
            }
        }
        return id
    }

    func parse_param(self) -> ast.Param {
        let span: ast.Span = self.here()
        let anonymous: bool = self.try_consume(.KwAnon)
        // `mut` (after optional `anon`): the caller's variable, passed with
        // `mut` at the call site.
        let mutable: bool = self.try_consume(.KwMut)
        let first_start = self.peek().start
        let first: str = self.expect_identifier()
        // Optional second identifier (Swift-style label/binding split):
        // `func greet(who person: str)` — `who` is the label and `person`
        // is the binding. With only one identifier, label and binding
        // are the same name.
        mut name: str = first
        if self.at(.Identifier) {
            name = self.binding_identifier()
        } else if first != "self" {
            self.binding_names += [first]
            self.binding_starts += [first_start]
        }
        mut label: str = first
        if anonymous {
            label = ""
        }
        // Method receiver `self` has no type annotation.
        mut typ: int64 = 0
        if self.try_consume(.Colon) {
            typ = self.parse_type_expr()
        }
        // `name: T = expr` — call-site default. Evaluated fresh
        // at each call in the function's defining module's scope.
        // 0 means "no default declared".
        mut default_expr: int64 = 0
        if self.try_consume(.Equal) {
            default_expr = self.parse_expr()
        }
        return ast.Param(:label, :name, :typ, :anonymous, :span, :mutable, :default_expr)
    }

    func parse_param_list(self, allow_variadic: bool = false) -> [ast.Param] {
        self.expect(.OpenParen)
        mut params: [ast.Param] = []
        self.params_variadic = false
        self.skip_newlines()
        for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
            self.quiet = false
            if self.at(.Ellipsis) {
                let dots = self.advance()
                if allow_variadic {
                    self.params_variadic = true
                } else {
                    self.record_error("error: only an `extern` can take `...`", got: dots)
                }
                self.skip_newlines()
                if not self.at(.CloseParen) {
                    self.record_error("error: `...` comes last in a parameter list", got: self.peek())
                    for not self.at(.CloseParen) and not self.at(.EOF) and not self.at(.EOL) {
                        self.advance()
                    }
                }
                break
            }
            let start = self.pos
            let errors_before: int64 = len(self.errors)
            params += [self.parse_param()]
            if len(self.errors) > errors_before or self.pos == start {
                break
            }
            self.skip_newlines()
            if self.try_consume(.Comma) {
                self.skip_newlines()
                continue
            }
            // Another parameter without the `,` before it: taken as written.
            if self.at(.Identifier) or self.at(.KwAnon) or self.at(.KwMut) {
                self.record_unexpected(expected: "`,` or `)`", got: self.peek())
                continue
            }
            break
        }
        self.expect(.CloseParen)
        return params
    }

    // `Rect(w: 0, :h)`: the type pattern on `Rect` binding a hidden name, with
    // a sub-pattern for each labelled field of the value it binds.
    func struct_pattern(self, anon callee: int64, args: [ast.CallArg], expr_id: int64) -> int64 {
        if self.exprs[callee] is .ImplicitVariant(_name) {
            let start = self.expr_spans[callee].start
            self.record_error("error: an enum payload binds by position, as in `.Branch(size)`; labels are for struct patterns", got: lexing.Token(kind: .Identifier, value: "", start: start, end: start + 1))
            return -1
        }
        let whole = f"__patfields{expr_id}"
        mut subs: [ast.SubPattern] = []
        for arg in args {
            if len(arg.label) == 0 {
                self.record_error("error: a struct pattern labels every argument, as in `Rect(w: 0)`; without labels, `Rect(r)` binds the whole value", got: lexing.Token(kind: .Identifier, value: "", start: self.expr_spans[arg.value].start, end: self.expr_spans[arg.value].start + 1))
                return -1
            }
            mut sub = -1
            if self.exprs[arg.value] is .Ident(name) {
                sub = self.field_binding(name, span: self.expr_spans[arg.value])
            } else {
                sub = self.pattern_of_expr(arg.value)
            }
            if sub < 0 {
                return -1
            }
            subs += [ast.SubPattern(binding: whole, pattern: sub, field: arg.label)]
        }
        mut pat = -1
        if self.exprs[callee] is .Ident(name) {
            pat = self.named_pattern(name, binding: whole, span: self.expr_spans[callee])
        } else {
            pat = self.note_qualified(self.variant_pattern(callee, bindings: [whole]), :callee)
        }
        if pat >= 0 {
            self.pattern_subs[pat] = subs
        }
        return pat
    }

    // As parse_tuple_pattern, of an expression's elements.
    func tuple_pattern(self, anon elements: [int64], span: ast.Span) -> int64 {
        let whole = f"{TUPLE_PATTERN}{span.start}"
        mut subs: [ast.SubPattern] = []
        for e in elements {
            mut sub = -1
            if self.exprs[e] is .Ident(name) {
                sub = self.field_binding(name, span: self.expr_spans[e])
            } else {
                sub = self.pattern_of_expr(e)
            }
            if sub < 0 {
                return -1
            }
            subs += [ast.SubPattern(binding: whole, pattern: sub, field: f"{len(subs)}")]
        }
        let pat = self.alloc_pattern(ast.Pattern.BindPat(binding: whole))
        self.pattern_subs[pat] = subs
        return pat
    }

    func pattern_of_expr(self, anon expr_id: int64) -> int64 {
        let none_bindings: [str] = []
        match self.exprs[expr_id] {
            .IntLit(value) -> return self.alloc_pattern(ast.Pattern.IntPat(:value))
            .StrLit(value) -> return self.alloc_pattern(ast.Pattern.StrPat(:value))
            .BoolLit(value) -> return self.alloc_pattern(ast.Pattern.BoolPat(:value))
            .NoneLit -> return self.alloc_pattern(ast.Pattern.NonePat)
            .ImplicitVariant(name) -> return self.alloc_pattern(ast.Pattern.ImplicitEnumPat(variant_name: name, bindings: none_bindings))
            .Ident(name) -> return self.named_pattern(name, binding: "", span: self.expr_spans[expr_id])
            .Binary(lhs, op, rhs) -> {
                // `-1` parsed as `0 - 1`; the `0` sits on the `-`, so a written `0 - 1` isn't one.
                if op is .Sub and self.exprs[lhs] is .IntLit(zero) and zero == 0 and self.source[self.expr_spans[lhs].start] == '-' {
                    let .IntLit(value) = self.exprs[rhs] else { return -1 }
                    return self.alloc_pattern(ast.Pattern.IntPat(value: 0 - value))
                }
                return self.note_qualified(self.variant_pattern(expr_id, bindings: none_bindings), callee: expr_id)
            }
            .Call(callee, args) -> {
                for arg in args {
                    if len(arg.label) > 0 {
                        return self.struct_pattern(callee, :args, :expr_id)
                    }
                }
                let elements = self.tuple_elements(expr_id)
                if len(elements) > 0 {
                    return self.tuple_pattern(elements, span: self.expr_spans[expr_id])
                }
                mut bindings: [str] = []
                mut subs: [ast.SubPattern] = []
                for arg in args {
                    if self.exprs[arg.value] is .Ident(binding) {
                        bindings += [binding]
                    } else {
                        let sub = self.pattern_of_expr(arg.value)
                        if sub < 0 {
                            return -1
                        }
                        let hidden = hidden_binding(sub)
                        bindings += [hidden]
                        subs += [ast.SubPattern(binding: hidden, pattern: sub)]
                    }
                }
                // The binding names of an `is` pattern, which parses as a call first,
                // and the types they would name.
                mut slots: [int64] = []
                mut slot_types: [int64] = []
                for i, arg in args {
                    if self.exprs[arg.value] is .Ident(binding) {
                        let span = self.expr_spans[arg.value]
                        self.payload_starts += [span.start]
                        self.payload_names += [binding]
                        slots += [i]
                        slot_types += [self.alloc_type(ast.TypeExpr.Named(name: binding), :span)]
                    }
                }
                mut pat: int64 = -1
                match self.exprs[callee] {
                    .Ident(name) -> {
                        if len(bindings) > 1 {
                            return -1
                        }
                        mut binding = ""
                        if len(bindings) == 1 {
                            binding = bindings[0]
                        }
                        pat = self.named_pattern(name, :binding, span: self.expr_spans[callee])
                    }
                    .ImplicitVariant(name) -> pat = self.alloc_pattern(ast.Pattern.ImplicitEnumPat(variant_name: name, :bindings))
                    else {
                        if len(bindings) <= 1 {
                            pat = self.note_qualified(self.variant_pattern(callee, :bindings), :callee)
                        } else {
                            pat = self.variant_pattern(callee, :bindings)
                        }
                    }
                }
                if pat >= 0 {
                    self.pattern_subs[pat] = subs
                    for i, slot in slots {
                        self.note_maybe_type(pat, :slot, type_id: slot_types[i])
                    }
                }
                return pat
            }
            else return -1
        }
    }

    // What follows an `else`: a block, or an `if` that chains on.
    func else_block(self) -> [int64] {
        if self.at(.KwIf) {
            return [self.parse_stmt()]
        }
        return self.parse_block()
    }

    // `a and b and c` as its operands, left to right.
    func and_operands(self, anon expr_id: int64) -> [int64] {
        // A condition takes its chain over.
        if len(self.value_chains) > 0 and self.value_chains[-1] == expr_id {
            self.value_chains = self.value_chains[..-1]
        }
        if self.exprs[expr_id] is .Binary(lhs, op, rhs) and op is .And {
            mut ops: [int64] = self.and_operands(lhs)
            ops += self.and_operands(rhs)
            return ops
        }
        return [expr_id]
    }

    // Whether `x is P` binds a name or nests a pattern, so an `if` has to match it rather than test it.
    func binds_names(self, anon expr_id: int64) -> bool {
        if self.exprs[expr_id] is .Binary(_lhs, op, rhs) and op is .Is and self.exprs[rhs] is .Call(_callee, args) {
            for arg in args {
                if self.exprs[arg.value] is .Ident(name) {
                    if name != "_" {
                        return true
                    }
                } else {
                    return true
                }
            }
        }
        return false
    }

    // The pattern of each operand that binds, or -1. The patterns go in before
    // the body is parsed, as a whole-condition one does, so their spans end here.
    // With `narrow`, an operand that narrows its name gets a pattern too (see narrow_chain).
    func chain_patterns(self, anon ops: [int64], narrow: bool = false) -> [int64] {
        mut pats: [int64] = []
        for op in ops {
            mut pat: int64 = -1
            if self.binds_names(op) and self.exprs[op] is .Binary(_lhs, _op, rhs) {
                pat = self.pattern_of_expr(rhs)
            } else if narrow {
                pat = self.narrowing_pattern(op)
            }
            pats += [pat]
        }
        return pats
    }

    // The pattern of an `and` operand that narrows a plain name, binding nothing
    // yet: `x is T`, `x is Some`, `x is Ok`, `x is Err`, or `x is not none` as `Some`.
    func narrowing_pattern(self, anon op: int64) -> int64 {
        let .Binary(lhs, is_op, rhs) = self.exprs[op] else { return -1 }
        if len(self.narrow_name(lhs)) == 0 {
            return -1
        }
        if is_op is .IsNot and self.exprs[rhs] is .NoneLit {
            return self.alloc_pattern(ast.Pattern.SomePat(binding: ""))
        }
        if not (is_op is .Is) {
            return -1
        }
        let pat = self.pattern_of_expr(rhs)
        if pat >= 0 and self.narrows(pat) {
            return pat
        }
        return -1
    }

    func narrows_op(self, anon op: int64) -> bool {
        if self.exprs[op] is .Binary(lhs, is_op, rhs) and len(self.narrow_name(lhs)) > 0 {
            if is_op is .IsNot {
                return self.exprs[rhs] is .NoneLit
            }
            if is_op is .Is and not self.binds_names(op) {
                match self.exprs[rhs] {
                    .Ident(name) -> return name != "None"
                    .Call(callee, _args) -> return self.exprs[callee] is .Ident(_name)
                    else return false
                }
            }
        }
        return false
    }

    // The name an `is` tests, when narrowing can rebind it: a plain name.
    func narrow_name(self, anon subject: int64) -> str {
        if self.exprs[subject] is .Ident(name) and name != "self" and name != "_" {
            return name
        }
        return ""
    }

    // A test that binds nothing and that narrowing can make bind its name: a type
    // pattern written by its own name, `Some`, `Ok` or `Err`.
    func narrows(self, anon pat: int64) -> bool {
        if len(self.pattern_subs[pat]) > 0 {
            return false
        }
        match self.patterns[pat] {
            .ImplicitEnumPat(v, b) -> return v.starts_with("$t") and len(b) == 1 and b[0] == "_"
            .SomePat(b) -> return len(b) == 0 or b == "_"
            .OkPat(b) -> return len(b) == 0 or b == "_"
            .ErrPat(b) -> return len(b) == 0 or b == "_"
            else return false
        }
    }

    // `pat`, which `narrows`, binding `name`.
    func narrow_to(self, anon pat: int64, name: str) -> none {
        match self.patterns[pat] {
            .ImplicitEnumPat(v, _b) -> self.patterns[pat] = ast.Pattern.ImplicitEnumPat(variant_name: v, bindings: [name])
            .SomePat(_b) -> self.patterns[pat] = ast.Pattern.SomePat(binding: name)
            .OkPat(_b) -> self.patterns[pat] = ast.Pattern.OkPat(binding: name)
            .ErrPat(_b) -> self.patterns[pat] = ast.Pattern.ErrPat(binding: name)
            else none
        }
    }

    // Whether the tokens from `from` up to `to` assign to `name`: `name =`,
    // `name +=` or another such, not after a `.`. A block that does isn't narrowed.
    func assigns(self, anon name: str, from: int64, to: int64) -> bool {
        mut i = from
        for i + 1 < to {
            let tok = self.tokens[i]
            if tok.kind == .Identifier and tok.value == name and (i == 0 or self.tokens[i - 1].kind != .Dot) {
                let next = self.tokens[i + 1].kind
                if next == .Equal or next == .PlusEqual or update_op(next) is Some {
                    return true
                }
            }
            i += 1
        }
        return false
    }

    // Each narrowing operand of an `and` chain binds its name in the body, which
    // spans tokens `from` to `to`.
    func narrow_chain(self, anon ops: [int64], pats: [int64], from: int64, to: int64) -> none {
        for i, op in ops {
            if pats[i] >= 0 and self.narrows(pats[i]) and self.exprs[op] is .Binary(lhs, _op, _rhs) {
                let name = self.narrow_name(lhs)
                if len(name) > 0 and not self.assigns(name, :from, :to) {
                    self.narrow_to(pats[i], :name)
                }
            }
        }
    }

    func any_pattern(self, anon pats: [int64]) -> bool {
        for pat in pats {
            if pat >= 0 {
                return true
            }
        }
        return false
    }

    // `let name = counter` and `counter += 1`, ahead of a loop's body, so that
    // `continue` has already moved on.
    func take_counter(self, anon name: str, counter: str, span: ast.Span, by: int64 = 0) -> [int64] {
        let value: int64 = self.alloc_expr(ast.Expr.Ident(name: counter), :span)
        let lhs: int64 = self.alloc_expr(ast.Expr.Ident(name: counter), :span)
        mut rhs = by
        if rhs == 0 {
            rhs = self.alloc_expr(ast.Expr.IntLit(value: 1), :span)
        }
        return [
            self.alloc_stmt(ast.Stmt.Let(:name, typ: 0, :value, mutable: false)),
            self.alloc_stmt(ast.Stmt.PlusAssign(:lhs, :rhs)),
        ]
    }

    // `if true` holds a rewritten loop's hidden locals, as a block would.
    func hidden_block(self, anon stmts: [int64], span: ast.Span) -> int64 {
        let always: int64 = self.alloc_expr(ast.Expr.BoolLit(value: true), :span)
        return self.alloc_stmt(ast.Stmt.If(cond: always, then_body: stmts, else_body: []))
    }

    // `..=` is for a `for` range only: a slice is reported, then read as `..`.
    func no_inclusive_slice(self) -> none {
        if self.at(.DotDotEq) {
            self.record_error("error: a slice takes `a..b`, which leaves `b` out; `..=` is for a `for` range", got: self.peek())
        }
    }

    // After a range's start, at `..` or `..=`: the stop and any `step`.
    func parse_range_tail(self) -> RangeTail {
        let inclusive = self.at(.DotDotEq)
        self.advance()
        let stop = self.parse_expr()
        mut step = 0
        if self.at(.Identifier) and self.peek().value == "step" {
            self.advance()
            let step_tok = self.peek()
            step = self.parse_expr()
            if self.int_literal(step) is Some(k) and k == 0 {
                self.record_error("error: a range's step can't be 0", got: step_tok)
            }
        }
        return RangeTail(:stop, :inclusive, :step)
    }

    // An `int64` literal, `5` or `-5`.
    func int_literal(self, anon e: int64) -> int64? {
        match self.exprs[e] {
            .IntLit(v) -> return v
            .Binary(lhs, op, rhs) -> {
                if op is .Sub and self.exprs[lhs] is .IntLit(zero) and zero == 0 and self.exprs[rhs] is .IntLit(v) {
                    return 0 - v
                }
                return none
            }
            else return none
        }
    }

    // `for i in a..b`, `a..=b` and either with `step k`: the bounds and the step
    // evaluated once and typed `int64`. A literal step picks the comparison here;
    // another is tested for its sign on each pass, and panics when it's 0.
    func for_range(self, anon name: str, start: int64, range: RangeTail, body: [int64]) -> int64 {
        let span: ast.Span = self.expr_spans[start]
        let next_name: str = f"__for_next_{start}"
        let stop_name: str = f"__for_stop_{start}"
        let step_name: str = f"__for_step_{start}"
        let typ: int64 = self.alloc_type(ast.TypeExpr.Named(name: "int64"), :span)
        mut up: ast.Op = .Lt
        mut down: ast.Op = .Gt
        if range.inclusive {
            up = .Le
            down = .Ge
        }
        mut stmts = [
            self.alloc_stmt(ast.Stmt.Let(name: next_name, :typ, value: start, mutable: true)),
            self.alloc_stmt(ast.Stmt.Let(name: stop_name, :typ, value: range.stop, mutable: false)),
        ]
        mut cond = self.range_test(next_name, op: up, stop_name: stop_name, :span)
        mut by = 0
        if range.step != 0 {
            if self.int_literal(range.step) is Some(k) {
                if k < 0 {
                    cond = self.range_test(next_name, op: down, stop_name: stop_name, :span)
                }
                by = range.step
            } else {
                stmts += [self.alloc_stmt(ast.Stmt.Let(name: step_name, :typ, value: range.step, mutable: false))]
                let zero_test = self.alloc_expr(ast.Expr.Binary(lhs: self.alloc_expr(ast.Expr.Ident(name: step_name), :span), op: .Eq, rhs: self.alloc_expr(ast.Expr.IntLit(value: 0), :span)), :span)
                let panic_fn = self.alloc_expr(ast.Expr.Ident(name: "panic"), :span)
                let msg = self.alloc_expr(ast.Expr.StrLit(value: "a range's step is 0"), :span)
                let call = self.alloc_expr(ast.Expr.Call(callee: panic_fn, args: [ast.CallArg(label: "", label_span: span, value: msg)]), :span)
                stmts += [self.alloc_stmt(ast.Stmt.If(cond: zero_test, then_body: [self.alloc_stmt(ast.Stmt.ExprStmt(expr: call))], else_body: []))]
                let rising = self.alloc_expr(ast.Expr.Binary(lhs: self.alloc_expr(ast.Expr.Ident(name: step_name), :span), op: .Gt, rhs: self.alloc_expr(ast.Expr.IntLit(value: 0), :span)), :span)
                let up_test = self.alloc_expr(ast.Expr.Binary(lhs: rising, op: .And, rhs: cond), :span)
                let falling = self.alloc_expr(ast.Expr.Binary(lhs: self.alloc_expr(ast.Expr.Ident(name: step_name), :span), op: .Lt, rhs: self.alloc_expr(ast.Expr.IntLit(value: 0), :span)), :span)
                let down_test = self.alloc_expr(ast.Expr.Binary(lhs: falling, op: .And, rhs: self.range_test(next_name, op: down, stop_name: stop_name, :span)), :span)
                cond = self.alloc_expr(ast.Expr.Binary(lhs: up_test, op: .Or, rhs: down_test), :span)
                by = self.alloc_expr(ast.Expr.Ident(name: step_name), :span)
            }
        }
        if not range.inclusive and range.step == 0 {
            mut inner: [int64] = self.take_counter(name, counter: next_name, :span, :by)
            inner += body
            stmts += [self.alloc_stmt(ast.Stmt.For(:cond, body: inner))]
            return self.hidden_block(stmts, :span)
        }
        // Past `stop` may be past the last `int64`: the counter steps with a
        // wrapping add, and a step that wraps ends the loop.
        let more_name: str = f"__for_more_{start}"
        let was_name: str = f"__for_was_{start}"
        let bool_typ: int64 = self.alloc_type(ast.TypeExpr.Named(name: "bool"), :span)
        stmts += [self.alloc_stmt(ast.Stmt.Let(name: more_name, typ: bool_typ, value: self.alloc_expr(ast.Expr.BoolLit(value: true), :span), mutable: true))]
        cond = self.alloc_expr(ast.Expr.Binary(lhs: self.alloc_expr(ast.Expr.Ident(name: more_name), :span), op: .And, rhs: cond), :span)
        if by == 0 {
            by = self.alloc_expr(ast.Expr.IntLit(value: 1), :span)
        }
        let member = self.alloc_expr(ast.Expr.Ident(name: "wrapping_add"), :span)
        let callee = self.alloc_expr(ast.Expr.Binary(lhs: self.alloc_expr(ast.Expr.Ident(name: next_name), :span), op: .Dot, rhs: member), :span)
        let stepped = self.alloc_expr(ast.Expr.Call(:callee, args: [ast.CallArg(label: "", label_span: span, value: by)]), :span)
        // The step wrapped when the counter moved against it.
        mut wrapped = self.alloc_expr(ast.Expr.Binary(lhs: self.alloc_expr(ast.Expr.Ident(name: next_name), :span), op: .Lt, rhs: self.alloc_expr(ast.Expr.Ident(name: was_name), :span)), :span)
        if self.int_literal(by) is Some(k) {
            if k < 0 {
                wrapped = self.alloc_expr(ast.Expr.Binary(lhs: self.alloc_expr(ast.Expr.Ident(name: next_name), :span), op: .Gt, rhs: self.alloc_expr(ast.Expr.Ident(name: was_name), :span)), :span)
            }
        } else {
            let rising = self.alloc_expr(ast.Expr.Binary(lhs: self.alloc_expr(ast.Expr.Ident(name: step_name), :span), op: .Gt, rhs: self.alloc_expr(ast.Expr.IntLit(value: 0), :span)), :span)
            wrapped = self.alloc_expr(ast.Expr.Binary(lhs: wrapped, op: .Eq, rhs: rising), :span)
        }
        let stop_loop = self.alloc_stmt(ast.Stmt.Assign(lhs: self.alloc_expr(ast.Expr.Ident(name: more_name), :span), rhs: self.alloc_expr(ast.Expr.BoolLit(value: false), :span)))
        mut inner: [int64] = [
            self.alloc_stmt(ast.Stmt.Let(name: was_name, typ: 0, value: self.alloc_expr(ast.Expr.Ident(name: next_name), :span), mutable: false)),
            self.alloc_stmt(ast.Stmt.Let(:name, typ: 0, value: self.alloc_expr(ast.Expr.Ident(name: was_name), :span), mutable: false)),
            self.alloc_stmt(ast.Stmt.Assign(lhs: self.alloc_expr(ast.Expr.Ident(name: next_name), :span), rhs: stepped)),
            self.alloc_stmt(ast.Stmt.If(cond: wrapped, then_body: [stop_loop], else_body: [])),
        ]
        inner += body
        stmts += [self.alloc_stmt(ast.Stmt.For(:cond, body: inner))]
        return self.hidden_block(stmts, :span)
    }

    // `next op stop` on a range loop's hidden locals.
    func range_test(self, anon next_name: str, op: ast.Op, stop_name: str, span: ast.Span) -> int64 {
        let next: int64 = self.alloc_expr(ast.Expr.Ident(name: next_name), :span)
        let last: int64 = self.alloc_expr(ast.Expr.Ident(name: stop_name), :span)
        return self.alloc_expr(ast.Expr.Binary(lhs: next, op: op, rhs: last), :span)
    }

    // `for i, x in xs`.
    func for_numbered(self, anon index: str, name: str, iter: int64, body: [int64]) -> int64 {
        let span: ast.Span = self.expr_spans[iter]
        let counter: str = f"__for_index_{iter}"
        let zero: int64 = self.alloc_expr(ast.Expr.IntLit(value: 0), :span)
        mut inner: [int64] = self.take_counter(index, :counter, :span)
        inner += body
        return self.hidden_block([
            self.alloc_stmt(ast.Stmt.Let(name: counter, typ: 0, value: zero, mutable: true)),
            self.alloc_stmt(ast.Stmt.ForEach(:name, :iter, body: inner)),
        ], :span)
    }

    // An `if` whose `and` chain binds: each operand with a pattern is a one-arm
    // match around the operands after it, the others plain `if`s; `elses[i]`
    // runs when operand i fails.
    func chain_stmt(self, anon ops: [int64], pats: [int64], from: int64, body: [int64], elses: [[int64]]) -> int64 {
        mut inner: [int64] = body
        if from + 1 < len(ops) {
            inner = [self.chain_stmt(ops, :pats, from: from + 1, :body, :elses)]
        }
        mut otherwise: [int64] = []
        if len(elses) > 0 {
            otherwise = elses[from]
        }
        let op = ops[from]
        if pats[from] >= 0 {
            if self.exprs[op] is .Binary(subject, _op, _rhs) {
                let wild: int64 = self.alloc_pattern(ast.Pattern.Wildcard)
                mut arms: [int64] = []
                arms += [self.alloc_match_arm(ast.MatchArm(pattern: pats[from], body: inner))]
                arms += [self.alloc_match_arm(ast.MatchArm(pattern: wild, body: otherwise))]
                return self.alloc_stmt(ast.Stmt.MatchStmt(:subject, :arms))
            }
        }
        return self.alloc_stmt(ast.Stmt.If(cond: op, then_body: inner, else_body: otherwise))
    }

    // `m.T` of a pattern `pat` that reads as `Enum.Variant`, noted as the type it may be.
    func note_qualified(self, anon pat: int64, callee: int64) -> int64 {
        if pat < 0 {
            return pat
        }
        if self.exprs[callee] is .Binary(lhs, _op, rhs) and self.exprs[lhs] is .Ident(qual) and self.exprs[rhs] is .Ident(name) {
            self.note_maybe_type(pat, slot: -1, type_id: self.alloc_type(ast.TypeExpr.Named(:name), span: self.expr_spans[rhs], :qual))
        }
        return pat
    }

    func named_pattern(self, anon name: str, binding: str, span: ast.Span) -> int64 {
        if name == "Some" {
            return self.alloc_pattern(ast.Pattern.SomePat(:binding))
        }
        if name == "Ok" {
            return self.alloc_pattern(ast.Pattern.OkPat(:binding))
        }
        if name == "Err" {
            return self.alloc_pattern(ast.Pattern.ErrPat(:binding))
        }
        return self.type_pattern(self.alloc_type(ast.TypeExpr.Named(:name), :span), :binding)
    }

    func variant_pattern(self, anon expr_id: int64, bindings: [str]) -> int64 {
        let .Binary(lhs, op, rhs) = self.exprs[expr_id] else { return -1 }
        if not self.is_dot(op) {
            return -1
        }
        let .Ident(variant_name) = self.exprs[rhs] else { return -1 }
        match self.exprs[lhs] {
            .Ident(enum_name) -> return self.alloc_pattern(ast.Pattern.EnumPat(:enum_name, :variant_name, :bindings))
            .Binary(mod_lhs, mod_op, enum_rhs) -> {
                if not self.is_dot(mod_op) {
                    return -1
                }
                let .Ident(mod_name) = self.exprs[mod_lhs] else { return -1 }
                let .Ident(enum_name) = self.exprs[enum_rhs] else { return -1 }
                // A pattern travels without its id, so its module rides in the name.
                return self.alloc_pattern(ast.Pattern.EnumPat(enum_name: f"{mod_name}.{enum_name}", :variant_name, :bindings))
            }
            else return -1
        }
    }

    // A typed match: the snapshot reads `let .Dot = op` as the lexer's `.Dot`.
    func is_dot(self, anon op: ast.Op) -> bool {
        match op {
            .Dot -> return true
            else return false
        }
    }

    // `Variant` or `Variant(bindings...)`, past the dot.
    func parse_implicit_variant(self) -> int64 {
        mut variant_name: str = self.expect_identifier()
        let items = self.parse_payload()
        let bindings = payload_bindings(items)
        return self.with_all_subs(self.alloc_pattern(ast.Pattern.ImplicitEnumPat(:variant_name, :bindings)), :items)
    }

    func parse_pattern(self) -> int64 {
        // Integer
        if self.at(.IntegerLit) {
            let tok: lexing.Token = self.advance()
            self.check_literal_range(tok)
            return self.alloc_pattern(ast.Pattern.IntPat(value: str_to_int(tok.value)))
        }
        // A negative integer. A float falls through to its own error below.
        if self.at(.Minus) and self.peek_kind_at(1) != .FloatLit {
            let minus: lexing.Token = self.advance()
            if not self.at(.IntegerLit) {
                self.record_error("error: `-` in a pattern needs an integer literal", got: minus)
                return self.alloc_pattern(ast.Pattern.Wildcard)
            }
            let tok: lexing.Token = self.advance()
            // One past the largest `int64` is the smallest, once negated.
            if literal_excess(tok.value) != 1 {
                self.check_literal_range(tok)
            }
            return self.alloc_pattern(ast.Pattern.IntPat(value: str_to_int(tok.value).wrapping_mul(-1)))
        }
        // Only a float still has a `-` here, which changes nothing about its error.
        self.try_consume(.Minus)
        // A float has no pattern: an equality test on one is rarely what is meant.
        if self.at(.FloatLit) {
            let tok: lexing.Token = self.advance()
            self.record_error("error: a float can't be a pattern; test it with `==` or a comparison", got: tok)
            return self.alloc_pattern(ast.Pattern.Wildcard)
        }
        // String
        if self.at(.StringLit) {
            let tok: lexing.Token = self.advance()
            return self.alloc_pattern(ast.Pattern.StrPat(value: parse_string_value(tok.value)))
        }
        // Bool
        if self.try_consume(.KwTrue) {
            return self.alloc_pattern(ast.Pattern.BoolPat(value: true))
        }
        if self.try_consume(.KwFalse) {
            return self.alloc_pattern(ast.Pattern.BoolPat(value: false))
        }
        // none
        if self.try_consume(.KwNone) {
            return self.alloc_pattern(ast.Pattern.NonePat)
        }
        if self.at(.OpenParen) {
            return self.parse_tuple_pattern()
        }
        // Some(binding)
        if self.at(.Identifier) and self.peek().value == "Some" {
            self.advance()
            let item = self.parse_one_payload()
            return self.with_subs(self.alloc_pattern(ast.Pattern.SomePat(binding: item.binding)), :item)
        }
        // Ok(binding) / Err(binding) — `T or Error` result patterns.
        if self.at(.Identifier) and self.peek().value == "Ok" {
            self.advance()
            let item = self.parse_one_payload()
            return self.with_subs(self.alloc_pattern(ast.Pattern.OkPat(binding: item.binding)), :item)
        }
        if self.at(.Identifier) and self.peek().value == "Err" {
            self.advance()
            let item = self.parse_one_payload()
            return self.with_subs(self.alloc_pattern(ast.Pattern.ErrPat(binding: item.binding)), :item)
        }
        // Implicit enum variant: .Variant or .Variant(bindings...)
        if self.try_consume(.Dot) {
            return self.parse_implicit_variant()
        }
        // A type pattern: `T` or `T(binding)`, a bare identifier not followed by
        // `.` (which would make it `Enum.Variant`). Codegen resolves the type.
        if self.at(.Identifier) and self.peek_kind_at(1) != .Dot {
            let span = self.here()
            let name: str = self.expect_identifier()
            let type_id = self.alloc_type(ast.TypeExpr.Named(:name), :span)
            if self.labelled_payload_ahead() {
                let whole = f"__patfields{span.start}"
                let fields = self.parse_field_payload(whole)
                let pat = self.type_pattern(type_id, binding: whole)
                self.pattern_subs[pat] = fields
                return pat
            }
            let item = self.parse_one_payload()
            return self.with_subs(self.type_pattern(type_id, binding: item.binding), :item)
        }
        // Explicit enum variant: Enum.Variant or Enum.Variant(bindings...).
        // Also accept three-part 'module.Enum.Variant', whose enum is named
        // `module.Enum`: a pattern travels without its id, so no side array
        // can carry the module.
        let first: str = self.expect_identifier()
        self.expect(.Dot)
        let second_span = self.here()
        let second: str = self.expect_identifier()
        mut enum_name: str = first
        mut variant_name: str = second
        mut qualified_type = true
        if self.try_consume(.Dot) {
            enum_name = f"{first}.{second}"
            variant_name = self.expect_identifier()
            qualified_type = false
        }
        if qualified_type and self.labelled_payload_ahead() {
            // `m.T(f: p)`: a struct pattern on a type of another module.
            let whole = f"__patfields{second_span.start}"
            let fields = self.parse_field_payload(whole)
            let pat = self.alloc_pattern(ast.Pattern.EnumPat(:enum_name, :variant_name, bindings: [whole]))
            self.pattern_subs[pat] = fields
            self.note_maybe_type(pat, slot: -1, type_id: self.alloc_type(ast.TypeExpr.Named(name: second), span: second_span, qual: first))
            return pat
        }
        let items = self.parse_payload()
        let bindings = payload_bindings(items)
        let pat = self.with_all_subs(self.alloc_pattern(ast.Pattern.EnumPat(:enum_name, :variant_name, :bindings)), :items)
        // `m.T(b)` reads as `Enum.Variant(b)` until codegen knows `m` is an import.
        if qualified_type and len(items) <= 1 {
            self.note_maybe_type(pat, slot: -1, type_id: self.alloc_type(ast.TypeExpr.Named(name: second), span: second_span, qual: first))
        }
        return pat
    }

    // Whether a `(` with a labelled first argument comes next: a struct pattern's fields.
    func labelled_payload_ahead(self) -> bool {
        if not self.at(.OpenParen) {
            return false
        }
        let k1 = self.peek_kind_at(1)
        return k1 == .Colon or (k1 == .Identifier and self.peek_kind_at(2) == .Colon)
    }

    // A struct pattern's `(f: p, :g)`: a sub-pattern per field of the value
    // bound as `whole`. `:g` binds field `g` as `g`; a name binds, `_` ignores.
    func parse_field_payload(self, anon whole: str) -> [ast.SubPattern] {
        mut fields: [ast.SubPattern] = []
        self.expect(.OpenParen)
        for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
            mut label = ""
            mut sub = -1
            if self.try_consume(.Colon) {
                let span = self.here()
                label = self.expect_identifier()
                sub = self.field_binding(label, :span)
            } else if self.at(.Identifier) and self.peek_kind_at(1) == .Colon {
                label = self.expect_identifier()
                self.advance()
                if self.at(.Identifier) and self.peek_kind_at(1) != .OpenParen and self.peek_kind_at(1) != .Dot {
                    let span = self.here()
                    let name = self.expect_identifier()
                    sub = self.field_binding(name, :span)
                } else {
                    sub = self.parse_pattern()
                }
            } else {
                self.record_error("error: a struct pattern labels every argument, as in `Rect(w: 0)`; without labels, `Rect(r)` binds the whole value", got: self.peek())
                self.skip_rest_of_stmt(depth: 1)
                break
            }
            fields += [ast.SubPattern(binding: whole, pattern: sub, field: label)]
            if not self.try_consume(.Comma) {
                break
            }
        }
        self.expect(.CloseParen)
        return fields
    }

    // `(p, q)`: the whole tuple under a hidden name, and a sub-pattern for each element.
    func parse_tuple_pattern(self) -> int64 {
        let span = self.here()
        self.advance()
        let whole = f"{TUPLE_PATTERN}{span.start}"
        mut subs: [ast.SubPattern] = []
        for not self.at(.CloseParen) and not self.at(.EOF) {
            mut sub = -1
            if self.at(.Identifier) and self.peek_kind_at(1) != .OpenParen and self.peek_kind_at(1) != .Dot {
                let name_span = self.here()
                sub = self.field_binding(self.expect_identifier(), span: name_span)
            } else {
                sub = self.parse_pattern()
            }
            subs += [ast.SubPattern(binding: whole, pattern: sub, field: f"{len(subs)}")]
            if not self.try_consume(.Comma) {
                break
            }
        }
        self.expect(.CloseParen)
        self.check_tuple_len(len(subs), :span)
        let pat = self.alloc_pattern(ast.Pattern.BindPat(binding: whole))
        self.pattern_subs[pat] = subs
        return pat
    }

    // What a field bound to `name` in a struct pattern is: `_` ignores it.
    func field_binding(self, anon name: str, span: ast.Span) -> int64 {
        if name == "_" {
            return self.alloc_pattern(ast.Pattern.Wildcard)
        }
        self.payload_starts += [span.start]
        self.payload_names += [name]
        return self.alloc_pattern(ast.Pattern.BindPat(binding: name))
    }

    // A payload position: a name, which binds, or a pattern (pattern >= 0) under a hidden name.
    // A name that names a type is a type pattern, which codegen decides (resolve_type_patterns).
    func parse_payload_item(self) -> ast.SubPattern {
        if self.at(.Identifier) and self.peek_kind_at(1) != .OpenParen and self.peek_kind_at(1) != .Dot {
            return self.payload_name()
        }
        let pattern = self.parse_pattern()
        return ast.SubPattern(binding: hidden_binding(pattern), :pattern)
    }

    // `(a, .B(c), 0)`, if the pattern has one.
    func parse_payload(self) -> [ast.SubPattern] {
        mut items: [ast.SubPattern] = []
        if self.try_consume(.OpenParen) {
            for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
                items += [self.parse_payload_item()]
                if not self.try_consume(.Comma) {
                    break
                }
            }
            self.expect(.CloseParen)
        }
        return items
    }

    // The `(x)` of `Some(x)`, if it has one; without it, an empty binding.
    func parse_one_payload(self) -> ast.SubPattern {
        if self.try_consume(.OpenParen) {
            let item = self.parse_payload_item()
            self.expect(.CloseParen)
            return item
        }
        return ast.SubPattern(binding: "", pattern: -1)
    }

    func with_subs(self, anon pat: int64, item: ast.SubPattern) -> int64 {
        return self.with_all_subs(pat, items: [item])
    }

    func with_all_subs(self, anon pat: int64, items: [ast.SubPattern]) -> int64 {
        mut subs: [ast.SubPattern] = []
        for i, item in items {
            if item.pattern >= 0 {
                subs += [item]
            } else if item.type_id > 0 {
                self.note_maybe_type(pat, slot: i, type_id: item.type_id)
            }
        }
        self.pattern_subs[pat] = subs
        return pat
    }

    // Lex and parse a Kod expression from a freshly supplied source string.
    // Temporarily swaps the parser's token stream so nodes are allocated into
    // the same pools as the surrounding parse, then restores the position.
    // Spans are offset by `base`, or all at `base` when `pinned`.
    func parse_expr_substring(self, anon source: str, base: int64, pinned: bool) -> int64 {
        let sub_lexer: lexing.Lexer = lexing.Lexer(:source, pos: 0, start: 0)
        mut sub_tokens: [lexing.Token] = []
        mut sub_starts: [int64] = []
        for tok in sub_lexer.lex() {
            sub_starts += [tok.start]
            if pinned {
                sub_tokens += [lexing.Token(kind: tok.kind, value: tok.value, start: base, end: base)]
            } else {
                sub_tokens += [lexing.Token(kind: tok.kind, value: tok.value, start: tok.start + base, end: tok.end + base)]
            }
        }
        let saved_tokens: [lexing.Token] = self.tokens
        let saved_pos: int64 = self.pos
        self.tokens = sub_tokens
        self.pos = 0
        mut result: int64 = self.parse_expr()
        self.fspec_at = -1
        if self.at(.Colon) {
            self.fspec_at = sub_starts[self.pos]
        } else if not self.at(.EOF) and not self.at(.EOL) {
            self.record_error("error: the braces of an f-string hold one expression, but this one goes on with " + self.peek_kind().name(), got: self.peek())
        }
        self.tokens = saved_tokens
        self.pos = saved_pos
        return result
    }

    // Parse the raw token value of an f-string (including f" and trailing ")
    // into a left-folded Binary(Add) tree of string concatenations. The
    // f"""...""" form is dedented before interpolation, so `{expr}` sees
    // the post-dedent body, so its interpolations are spanned at the literal.
    func parse_fstring(self, anon raw: str, span: ast.Span) -> int64 {
        mut inner: str = ""
        let triple: bool = len(raw) >= 7 and raw[1] == '"' and raw[2] == '"' and raw[3] == '"'
        if triple {
            inner = dedent_triple_body(raw[4..len(raw) - 3])
        } else {
            inner = raw[2..len(raw) - 1]
        }
        mut parts: [int64] = []
        mut i: int64 = 0
        for i < len(inner) {
            mut j: int64 = i
            for j < len(inner) and inner[j] != '{' {
                // `\\`, and `\{` and `\}`, braces that are characters.
                if inner[j] == '\\' and j + 1 < len(inner) and (inner[j + 1] == '\\' or inner[j + 1] == '{' or inner[j + 1] == '}') {
                    j = j + 2
                } else if inner[j] == '\\' and lexing.unicode_escape_end(inner, start: j) >= 0 {
                    j = lexing.unicode_escape_end(inner, start: j)
                } else {
                    j = j + 1
                }
            }
            if j > i {
                self.check_escapes(inner[i..j], tok: lexing.Token(kind: .FStringLit, value: raw, start: span.start, end: span.start + 1))
                let lit: str = unescape_str(inner[i..j])
                parts += [self.alloc_expr(ast.Expr.StrLit(value: lit), :span)]
            }
            if j >= len(inner) {
                i = j
            } else {
                let k: int64 = lexing.interp_end(inner, start: j + 1)
                let expr_text: str = inner[j + 1..k]
                // Wrap each interpolation in str(...) so f-strings compose
                // cleanly with non-string values without `+` doing any
                // implicit coercion of its own. `$str` is always the builtin.
                mut base: int64 = span.start
                if not triple {
                    base = span.start + 2 + j + 1
                }
                let inner_expr: int64 = self.parse_expr_substring(expr_text, :base, pinned: triple)
                let arg: ast.CallArg = ast.CallArg(label: "", label_span: span, value: inner_expr)
                let spec_at = self.fspec_at
                if spec_at >= 0 {
                    // `{x:spec}` is `$fmt(x, "spec")`, which codegen checks
                    // against x's type; how the spec is written is checked here.
                    let spec = expr_text[spec_at + 1..len(expr_text)]
                    mut spec_start = base
                    if not triple {
                        spec_start = base + spec_at + 1
                    }
                    let problem = format.check(spec, kind: -1, shown: "")
                    if len(problem) > 0 {
                        self.record_error(f"error: in the format spec `{spec}`, {problem}", got: lexing.Token(kind: .FStringLit, value: spec, start: spec_start, end: spec_start + len(spec)))
                    }
                    let fmt_callee: int64 = self.alloc_expr(ast.Expr.Ident(name: "$fmt"), :span)
                    let spec_lit: int64 = self.alloc_expr(ast.Expr.StrLit(value: spec), span: ast.Span(start: spec_start))
                    let spec_arg: ast.CallArg = ast.CallArg(label: "", label_span: span, value: spec_lit)
                    parts += [self.alloc_expr(ast.Expr.Call(callee: fmt_callee, args: [arg, spec_arg]), :span)]
                } else {
                    let str_callee: int64 = self.alloc_expr(ast.Expr.Ident(name: "$str"), :span)
                    let call_args: [ast.CallArg] = [arg]
                    parts += [self.alloc_expr(ast.Expr.Call(callee: str_callee, args: call_args), :span)]
                }
                i = k + 1
            }
        }
        if len(parts) == 0 {
            return self.alloc_expr(ast.Expr.StrLit(value: ""), :span)
        }
        mut result: int64 = parts[0]
        mut i: int64 = 1
        for i < len(parts) {
            result = self.alloc_expr(ast.Expr.Binary(lhs: result, op: ast.Op.Add, rhs: parts[i]), :span)
            i = i + 1
        }
        return result
    }

    // `select { receive(ch) is v -> ... send(ch, x) -> ... after(d) -> ... else -> ... }`
    // (docs/tasks.md), as statements: each channel and value is held in a local,
    // each case is told to a `#spawn.Selector`, its `choose` gives the index of the
    // arm to run (-1 for `else`), and a chain of `if`s runs it, doing the receive
    // or send that can now go at once. All in an `if true` block, for its scope.
    func parse_select(self, anon span: ast.Span) -> int64 {
        self.spawns += 1
        let n = self.spawns
        let sel = f"__sel{n}"
        mut setup: [int64] = []
        setup += [self.alloc_stmt(ast.Stmt.Let(name: sel, typ: 0, value: self.spawn_member_call("Selector", recv: "", args: [], :span), mutable: false))]
        mut prefixes: [[int64]] = []
        mut bodies: [[int64]] = []
        mut else_body: [int64] = []
        mut has_else = false
        self.expect(.OpenCurly)
        self.skip_newlines()
        for not self.at(.CloseCurly) and not self.at(.EOF) {
            if self.try_consume(.KwElse) {
                self.expect(.Arrow)
                else_body = self.parse_select_body()
                has_else = true
                self.skip_newlines()
                continue
            }
            let at = self.peek()
            let word = self.expect_identifier()
            let k = len(bodies)
            let ch = f"{sel}_{k}"
            mut prefix: [int64] = []
            self.expect(.OpenParen)
            if word == "receive" {
                setup += [self.alloc_stmt(ast.Stmt.Let(name: ch, typ: 0, value: self.parse_expr(), mutable: false))]
                self.expect(.CloseParen)
                setup += [self.spawn_stmt_call(sel, method: "add_receive", arg: ch, :span)]
                mut bound = "_"
                if self.try_consume(.KwIs) {
                    bound = self.expect_identifier()
                }
                prefix += [self.alloc_stmt(ast.Stmt.Let(name: bound, typ: 0, value: self.select_method(ch, method: "receive_now", arg: "", :span), mutable: false))]
            } else if word == "send" {
                setup += [self.alloc_stmt(ast.Stmt.Let(name: ch, typ: 0, value: self.parse_expr(), mutable: false))]
                self.expect(.Comma)
                let value = f"{ch}_value"
                setup += [self.alloc_stmt(ast.Stmt.Let(name: value, typ: 0, value: self.parse_expr(), mutable: false))]
                self.expect(.CloseParen)
                setup += [self.spawn_stmt_call(sel, method: "add_send", arg: ch, :span)]
                prefix += [self.alloc_stmt(ast.Stmt.ExprStmt(expr: self.select_method(ch, method: "send", arg: value, :span)))]
            } else if word == "after" {
                let wait = f"{ch}_wait"
                setup += [self.alloc_stmt(ast.Stmt.Let(name: wait, typ: 0, value: self.parse_expr(), mutable: false))]
                self.expect(.CloseParen)
                setup += [self.spawn_stmt_call(sel, method: "add_after", arg: wait, :span)]
            } else {
                self.record_error("error: a `select` arm is `receive(ch)`, `receive(ch) is v`, `send(ch, value)`, `after(d)` or `else`", got: at)
            }
            self.expect(.Arrow)
            prefixes += [prefix]
            bodies += [self.parse_select_body()]
            self.skip_newlines()
        }
        self.expect(.CloseCurly)
        let chosen = f"{sel}_chosen"
        let flag = self.alloc_expr(ast.Expr.BoolLit(value: has_else), :span)
        let choose = self.select_call_expr(sel, method: "choose", args: [ast.CallArg(label: "", label_span: span, value: flag)], :span)
        setup += [self.alloc_stmt(ast.Stmt.Let(name: chosen, typ: 0, value: choose, mutable: false))]
        mut chain = else_body
        mut k = len(bodies) - 1
        for k >= 0 {
            let lhs = self.alloc_expr(ast.Expr.Ident(name: chosen), :span)
            let rhs = self.alloc_expr(ast.Expr.IntLit(value: k), :span)
            let cond = self.alloc_expr(ast.Expr.Binary(:lhs, op: .Eq, :rhs), :span)
            chain = [self.alloc_stmt(ast.Stmt.If(:cond, then_body: prefixes[k] + bodies[k], else_body: chain))]
            k -= 1
        }
        let yes = self.alloc_expr(ast.Expr.BoolLit(value: true), :span)
        return self.alloc_stmt(ast.Stmt.If(cond: yes, then_body: setup + chain, else_body: []))
    }

    func parse_select_body(self) -> [int64] {
        if self.at(.OpenCurly) {
            return self.parse_block()
        }
        return [self.parse_stmt()]
    }

    // `recv.method(arg)` (no argument for ""), names a parser-made local.
    func select_method(self, anon recv: str, method: str, arg: str, span: ast.Span) -> int64 {
        mut args: [ast.CallArg] = []
        if len(arg) > 0 {
            args += [ast.CallArg(label: "", label_span: span, value: self.alloc_expr(ast.Expr.Ident(name: arg), :span))]
        }
        return self.select_call_expr(recv, :method, :args, :span)
    }

    func select_call_expr(self, anon recv: str, method: str, args: [ast.CallArg], span: ast.Span) -> int64 {
        let lhs = self.alloc_expr(ast.Expr.Ident(name: recv), :span)
        let member = self.alloc_expr(ast.Expr.Ident(name: method), :span)
        let callee = self.alloc_expr(ast.Expr.Binary(:lhs, op: .Dot, rhs: member), :span)
        return self.alloc_expr(ast.Expr.Call(:callee, :args), :span)
    }

    // `sel.method(arg)` as a statement.
    func spawn_stmt_call(self, anon sel: str, method: str, arg: str, span: ast.Span) -> int64 {
        return self.alloc_stmt(ast.Stmt.ExprStmt(expr: self.select_method(sel, :method, :arg, :span)))
    }

    // `#spawn.name(args)`.
    func spawn_member_call(self, anon name: str, recv: str, args: [ast.CallArg], span: ast.Span) -> int64 {
        return self.select_call_expr("#spawn", method: name, :args, :span)
    }

    // `spawn f(a, b)`, `spawn detached f(a, b)` (ast.Expr.Spawn). The task runs a
    // function literal that captures the arguments, which codegen stores where
    // `spawn` is: `__spawnN_k` are names no source can use.
    func parse_spawn(self, anon span: ast.Span) -> int64 {
        mut detached = false
        if self.at(.Identifier) and self.peek().value == "detached" and self.peek_kind_at(1) == .Identifier {
            self.advance()
            detached = true
        }
        let at = self.peek()
        let call = self.parse_postfix(self.parse_primary())
        let .Call(callee, args) = self.exprs[call] else {
            self.record_error("error: `spawn` takes a call, as in `spawn fetch(url)`", got: at)
            return call
        }
        self.spawns += 1
        let n = self.spawns
        mut inner_args: [ast.CallArg] = []
        mut captures: [ast.Capture] = []
        for k, arg in args {
            if arg.by_ref {
                self.record_error("error: `spawn` can't pass a `mut` argument: the task runs after this function has gone on", got: at)
            }
            let key = f"__spawn{n}_{k}"
            let arg_span = self.expr_spans[arg.value]
            inner_args += [ast.CallArg(label: arg.label, label_span: arg.label_span, value: self.alloc_expr(ast.Expr.Ident(name: key), span: arg_span))]
            captures += [ast.Capture(key: key, span: arg_span)]
        }
        let inner = self.alloc_expr(ast.Expr.Call(:callee, args: inner_args), :span)
        let ret = self.alloc_stmt(ast.Stmt.Return(value: inner))
        let no_params: [ast.Param] = []
        let decl_id = self.alloc_func_decl(ast.FuncDecl(name: "", name_span: span, params: no_params, return_typ: 0, body: [ret], doc: "", :captures, spawned: true, in_generic: self.in_generic))
        // A literal binds names inside an expression, which the Renamer looks for.
        self.binding_exprs += 1
        let lit = self.alloc_expr(ast.Expr.FuncLit(:decl_id), :span)
        mut group = self.alloc_expr(ast.Expr.Ident(name: "#group"), :span)
        if detached {
            group = self.alloc_expr(ast.Expr.NoneLit, :span)
        }
        let start = self.spawn_call("start", lit: lit, group: group, :span)
        let start_none = self.spawn_call("start_none", lit: lit, group: group, :span)
        return self.alloc_expr(ast.Expr.Spawn(:call, :decl_id, :start, :start_none, :detached), :span)
    }

    // `#spawn.name(lit, group: group)`: a call into `tasks` for `spawn`.
    func spawn_call(self, anon name: str, lit: int64, group: int64, span: ast.Span) -> int64 {
        let module = self.alloc_expr(ast.Expr.Ident(name: "#spawn"), :span)
        let member = self.alloc_expr(ast.Expr.Ident(:name), :span)
        let callee = self.alloc_expr(ast.Expr.Binary(lhs: module, op: .Dot, rhs: member), :span)
        let args = [
            ast.CallArg(label: "", label_span: span, value: lit),
            ast.CallArg(label: "group", label_span: span, value: group),
        ]
        return self.alloc_expr(ast.Expr.Call(:callee, :args), :span)
    }

    func parse_primary(self) -> int64 {
        let span: ast.Span = self.here()
        // `not x` is `x == false`, x taken at comparison precedence. The
        // literal's span is the `not`, which is how codegen tells them apart.
        if self.at(.Bang) {
            self.record_error("error: `!` isn't an operator; negate a `bool` with `not`", got: self.peek())
            self.advance()
            return self.parse_expr_prec(comparison_prec())
        }
        if self.try_consume(.KwNot) {
            let operand: int64 = self.parse_expr_prec(comparison_prec())
            let rhs: int64 = self.alloc_expr(ast.Expr.BoolLit(value: false), :span)
            return self.alloc_expr(ast.Expr.Binary(lhs: operand, op: ast.Op.Eq, :rhs), :span)
        }
        // Unary minus: desugar -x to 0 - x, x with its postfix chain.
        if self.try_consume(.Minus) {
            if self.at(.IntegerLit) and literal_excess(self.peek().value) == 1 {
                let min_span: ast.Span = self.here()
                let min_tok: lexing.Token = self.advance()
                mut min_lit: int64 = self.alloc_expr(ast.Expr.IntLit(value: str_to_int(min_tok.value)), span: min_span)
                let min_zero: int64 = self.alloc_expr(ast.Expr.IntLit(value: 0), :span)
                if self.postfix_at(0) {
                    self.record_error(f"error: integer literal `{min_tok.value}` doesn't fit in `int64`, whose largest value is 9223372036854775807; the `-` negates the whole expression after it, so write `(-{min_tok.value})` for the smallest `int64`", got: min_tok)
                    self.bad_lits += [min_lit]
                    min_lit = self.parse_postfix(min_lit)
                    return self.alloc_expr(ast.Expr.Binary(lhs: min_zero, op: ast.Op.Sub, rhs: min_lit), :span)
                }
                // The smallest int64 is one literal: `0 - 2^63` would overflow.
                return self.alloc_expr(ast.Expr.IntLit(value: str_to_int(min_tok.value)), :span)
            }
            let operand: int64 = self.parse_postfix(self.parse_primary())
            let zero: int64 = self.alloc_expr(ast.Expr.IntLit(value: 0), :span)
            return self.alloc_expr(ast.Expr.Binary(lhs: zero, op: ast.Op.Sub, rhs: operand), :span)
        }
        // `try expr` — unwrap on Ok, propagate Err to the enclosing function.
        // Both `try` and `must` bind at unary precedence: they grab the
        // next primary AND its postfix chain (so `try foo().bar()` wraps
        // the whole `foo().bar()`), but stop at binary operators.
        if self.try_consume(.KwTry) {
            mut inner: int64 = self.parse_primary()
            inner = self.parse_postfix(inner)
            return self.alloc_expr(ast.Expr.Try(:inner), :span)
        }
        // `must expr` — unwrap on Ok, panic + abort on Err.
        if self.try_consume(.KwMust) {
            mut inner: int64 = self.parse_primary()
            inner = self.parse_postfix(inner)
            return self.alloc_expr(ast.Expr.Must(:inner), :span)
        }
        // Integer literal
        if self.at(.IntegerLit) {
            let tok: lexing.Token = self.advance()
            let lit: int64 = self.alloc_expr(ast.Expr.IntLit(value: str_to_int(tok.value)), :span)
            if not self.check_literal_range(tok) {
                self.bad_lits += [lit]
            }
            return lit
        }
        // Float literal
        if self.at(.FloatLit) {
            let tok: lexing.Token = self.advance()
            return self.alloc_expr(ast.Expr.FloatLit(text: strip_spaces(tok.value)), :span)
        }
        // F-string literal
        if self.at(.FStringLit) {
            let tok: lexing.Token = self.advance()
            return self.parse_fstring(tok.value, :span)
        }
        // String literal
        if self.at(.StringLit) {
            let tok: lexing.Token = self.advance()
            if not is_raw_string(tok.value) {
                self.check_escapes(string_body(tok.value), :tok)
            }
            return self.alloc_expr(ast.Expr.StrLit(value: parse_string_value(tok.value)), :span)
        }
        // Bytes literal: `b"..."`. The lexer emits the leading `b`
        // in tok.value (e.g. `b"hi"`), so `parse_string_value`
        // would mis-interpret it — strip the `b` prefix first
        // before passing the rest through the same unescape path.
        if self.at(.BytesLit) {
            let tok: lexing.Token = self.advance()
            let raw: str = tok.value
            let body: str = raw[1..len(raw)]
            self.check_escapes(string_body(body), :tok)
            return self.alloc_expr(ast.Expr.BytesLit(value: parse_string_value(body)), :span)
        }
        // Boolean
        if self.try_consume(.KwTrue) {
            return self.alloc_expr(ast.Expr.BoolLit(value: true), :span)
        }
        if self.try_consume(.KwFalse) {
            return self.alloc_expr(ast.Expr.BoolLit(value: false), :span)
        }
        // none literal
        if self.try_consume(.KwNone) {
            return self.alloc_expr(ast.Expr.NoneLit, :span)
        }
        // Implicit enum variant: .Variant
        if self.try_consume(.Dot) {
            mut name: str = self.expect_identifier()
            return self.alloc_expr(ast.Expr.ImplicitVariant(:name), :span)
        }
        // Array literal: [e1, e2, ...]
        if self.try_consume(.OpenBracket) {
            mut elements: [int64] = []
            self.skip_newlines()
            for self.peek_kind() != .CloseBracket and self.peek_kind() != .EOF {
                let from = self.pos
                elements += [self.parse_expr()]
                self.skip_newlines()
                if len(elements) == 1 and self.at(.KwFor) {
                    return self.parse_comprehension(elements[0], :from, :span)
                }
                if not self.try_consume(.Comma) {
                    break
                }
                self.skip_newlines()
            }
            self.expect(.CloseBracket)
            return self.alloc_expr(ast.Expr.ArrayLit(:elements), :span)
        }
        // Parenthesized expression
        if self.try_consume(.OpenParen) {
            if self.at(.EOL) and self.tuple_ahead() {
                self.skip_newlines()
            }
            let expr: int64 = self.parse_expr()
            if self.at(.Comma) {
                return self.parse_tuple(expr, :span)
            }
            self.expect(.CloseParen)
            self.grouped += [expr]
            return expr
        }
        // match expression
        if self.try_consume(.KwMatch) {
            return self.parse_match_expr(span)
        }
        if self.at(.KwIf) {
            let if_tok = self.advance()
            return self.parse_if_expr(if_tok, :span)
        }
        if self.try_consume(.KwSpawn) {
            return self.parse_spawn(span)
        }
        // Anonymous function: `func(params) -> R { ... }` in
        // expression position. Parses as a normal function decl
        // minus the name; the codegen hoists it to a synthesized
        // top-level entry during its registration pass.
        if self.at(.KwFunc) {
            self.advance()
            return self.parse_func_literal(span)
        }
        // Identifier
        mut name: str = self.expect_identifier()
        return self.alloc_expr(ast.Expr.Ident(:name), :span)
    }

    // The rest of a function literal, after `func`.
    func parse_func_literal(self, anon span: ast.Span) -> int64 {
        let params: [ast.Param] = self.parse_param_list()
        mut return_typ: int64 = 0
        if self.try_consume(.Arrow) {
            return_typ = self.parse_type_expr()
        }
        self.binding_exprs += 1
        let binding_mark = self.binding_exprs
        let outer = self.enter_function()
        let body_tok = self.peek()
        let body: [int64] = self.parse_block()
        if len(self.yields) > 0 {
            self.record_error("error: `yield` goes in a named function or method that gives back a `tasks.Channel[T]`, not in a function literal", got: body_tok)
            self.drop_yields()
        }
        self.leave_function(outer)
        let fd: ast.FuncDecl = ast.FuncDecl(name: "", name_span: span, :params, :return_typ, :body, doc: "", expr_binds: self.binding_exprs > binding_mark, in_generic: self.in_generic)
        let decl_id: int64 = self.alloc_func_decl(fd)
        return self.alloc_expr(ast.Expr.FuncLit(:decl_id), :span)
    }

    // The rest of `[elem for x in xs if cond]`, after `elem`, which begins at token `from`:
    // the loops and tests as statements around an append to a hidden array. Its type is
    // the elements', which codegen works out from the statement named in `$acc`.
    func parse_comprehension(self, anon elem: int64, from: int64, span: ast.Span) -> int64 {
        self.binding_exprs += 1
        let to = self.pos
        mut clauses: [CompClause] = []
        for self.at(.KwFor) or self.at(.KwIf) {
            let tok = self.advance()
            self.skip_newlines()
            if tok.kind == .KwIf {
                clauses += [CompClause(cond: self.parse_expr())]
                self.skip_newlines()
                continue
            }
            let first_len = self.for_names_len(0)
            mut second_len = 0
            if first_len > 0 and self.peek_kind_at(first_len) == .Comma {
                second_len = self.for_names_len(first_len + 1)
            }
            if first_len == 0 or not (self.peek_kind_at(first_len) == .KwIn or (second_len > 0 and self.peek_kind_at(first_len + 1 + second_len) == .KwIn)) {
                self.record_error("error: a comprehension's `for` is as a loop's, `for x in xs`", got: tok)
                break
            }
            mut names = [self.parse_for_names()]
            if self.try_consume(.Comma) {
                names += [self.parse_for_names()]
            }
            self.expect(.KwIn)
            let iter = self.parse_expr()
            mut range = RangeTail()
            if self.at(.DotDot) or self.at(.DotDotEq) {
                if len(names) == 2 {
                    self.record_error("error: `for i, x in` numbers an array; a range is already numbers, so write `for x in a..b`", got: self.peek())
                    names = [names[1]]
                }
                range = self.parse_range_tail()
            }
            clauses += [CompClause(:names, :iter, :range)]
            self.skip_newlines()
        }
        self.expect(.CloseBracket)
        let acc = f"__comp{len(self.exprs)}"
        let target = self.alloc_expr(ast.Expr.Ident(name: acc), :span)
        let item = self.alloc_expr(ast.Expr.ArrayLit(elements: [elem]), span: self.expr_spans[elem])
        mut inner = [self.alloc_stmt(ast.Stmt.PlusAssign(lhs: target, rhs: item))]
        mut k = len(clauses) - 1
        for k >= 0 {
            inner = [self.comp_clause(clauses[k], :inner, :from, :to)]
            k -= 1
        }
        let start = self.alloc_expr(ast.Expr.Ident(name: f"$acc{inner[0]}"), :span)
        let pre = [self.alloc_stmt(ast.Stmt.Let(name: acc, typ: 0, value: start, mutable: true))] + inner
        let arg = ast.CallArg(label: "", label_span: span, value: self.alloc_expr(ast.Expr.Ident(name: acc), :span))
        let body = self.alloc_expr(ast.Expr.Call(callee: self.alloc_expr(ast.Expr.Ident(name: "$moved"), :span), args: [arg]), :span)
        let arm = self.alloc_match_expr_arm(ast.MatchExprArm(pattern: self.alloc_pattern(ast.Pattern.Wildcard), :body, :pre, is_comp: true))
        let subject = self.alloc_expr(ast.Expr.BoolLit(value: true), :span)
        return self.alloc_expr(ast.Expr.MatchExpr(:subject, arms: [arm]), :span)
    }

    // One `for` or `if` of a comprehension around `inner`; its element spans tokens `from`
    // up to `to`.
    func comp_clause(self, anon clause: CompClause, inner: [int64], from: int64, to: int64) -> int64 {
        if clause.cond != 0 {
            let ops = self.and_operands(clause.cond)
            let pats = self.chain_patterns(ops, narrow: true)
            if not self.any_pattern(pats) {
                return self.alloc_stmt(ast.Stmt.If(cond: clause.cond, then_body: inner, else_body: []))
            }
            self.narrow_chain(ops, :pats, :from, :to)
            return self.chain_stmt(ops, :pats, from: 0, body: inner, elses: [])
        }
        let span = self.expr_spans[clause.iter]
        let name = clause.names[-1]
        if len(clause.names) == 2 {
            let index = clause.names[0]
            return self.for_numbered(index.name, name: name.name, iter: clause.iter, body: self.bind_for(index, :span) + self.bind_for(name, :span) + inner)
        }
        if clause.range.stop != 0 {
            return self.for_range(name.name, start: clause.iter, range: clause.range, body: self.bind_for(name, :span) + inner)
        }
        return self.alloc_stmt(ast.Stmt.ForEach(name: name.name, iter: clause.iter, body: self.bind_for(name, :span) + inner))
    }

    // Whether the `(` just passed opens a list with a comma of its own.
    func tuple_ahead(self) -> bool {
        mut depth = 0
        mut i = self.pos
        for i < len(self.tokens) {
            match self.tokens[i].kind {
                .OpenParen | .OpenBracket | .OpenCurly -> depth += 1
                .CloseParen | .CloseBracket | .CloseCurly -> {
                    if depth == 0 {
                        return false
                    }
                    depth -= 1
                }
                .Comma -> {
                    if depth == 0 {
                        return true
                    }
                }
                .EOF -> return false
                else none
            }
            i += 1
        }
        return false
    }

    // The rest of `(a, b)`, after its first element: a call of `$tuple`.
    func parse_tuple(self, anon first: int64, span: ast.Span) -> int64 {
        mut args = [ast.CallArg(label: "", label_span: self.expr_spans[first], value: first)]
        for self.try_consume(.Comma) {
            self.skip_newlines()
            if self.at(.CloseParen) {
                break
            }
            let value = self.parse_expr()
            args += [ast.CallArg(label: "", label_span: self.expr_spans[value], :value)]
            if self.at(.EOL) {
                self.skip_newlines()
            }
        }
        self.expect(.CloseParen)
        if not self.check_tuple_len(len(args), :span) {
            return first
        }
        let callee = self.alloc_expr(ast.Expr.Ident(name: "$tuple"), :span)
        return self.alloc_expr(ast.Expr.Call(:callee, :args), :span)
    }

    // The elements of the tuple literal `expr_id`, or none of them.
    func tuple_elements(self, anon expr_id: int64) -> [int64] {
        mut out: [int64] = []
        if self.exprs[expr_id] is .Call(callee, args) and self.exprs[callee] is .Ident(name) and name == "$tuple" {
            for arg in args {
                out += [arg.value]
            }
        }
        return out
    }

    func parse_match_expr(self, anon span: ast.Span) -> int64 {
        self.binding_exprs += 1
        let subject: int64 = self.parse_expr()
        self.expect(.OpenCurly)
        self.skip_newlines()
        mut arms: [int64] = []
        for self.peek_kind() != .CloseCurly and self.peek_kind() != .EOF {
            self.skip_newlines()
            if self.peek_kind() == .CloseCurly {
                break
            }
            self.quiet = false
            let pats: [int64] = self.parse_match_arm_patterns()
            if self.arm_broken {
                self.skip_newlines()
                continue
            }
            let guarded = self.arm_guarded
            let body_pos = self.pos
            let errors_before = len(self.errors)
            for pat in pats {
                self.pos = body_pos
                arms += [self.parse_match_expr_arm(pat, :guarded)]
                if len(self.errors) > errors_before {
                    break
                }
            }
            self.end_arm_line(errors_before)
            self.skip_newlines()
        }
        self.expect(.CloseCurly)
        return self.alloc_expr(ast.Expr.MatchExpr(:subject, :arms), :span)
    }

    func parse_match_expr_arm(self, anon pat: int64, guarded: bool) -> int64 {
        let guard = self.parse_arm_guard(guarded)
        if self.at(.OpenCurly) {
            let value = self.parse_value_block("a match arm's block must end with an expression, the arm's value")
            return self.alloc_match_expr_arm(ast.MatchExprArm(pattern: pat, body: value.body, pre: value.pre, :guard))
        }
        return self.alloc_match_expr_arm(ast.MatchExprArm(pattern: pat, body: self.parse_expr(), :guard))
    }

    // A block whose last statement is its value; `need` says so when it isn't.
    func parse_value_block(self, anon need: str) -> ValueBlock {
        let open_tok = self.peek()
        let errors_before = len(self.errors)
        let pre = self.parse_block()
        if len(self.errors) == errors_before and len(pre) > 0 and self.last_stmt_at >= 0 and self.tokens[self.last_stmt_at].kind is .KwIf {
            // An `if` at the end is the value: read it again, as that.
            self.pos = self.last_stmt_at
            let body = self.parse_expr()
            self.skip_newlines()
            self.expect(.CloseCurly)
            return ValueBlock(pre: pre[0..len(pre) - 1], :body)
        }
        if len(pre) > 0 {
            let before = pre[0..len(pre) - 1]
            match self.stmts[pre[-1]] {
                .ExprStmt(last) -> return ValueBlock(pre: before, body: last)
                .Return(_value) -> return ValueBlock(:pre, body: self.unreachable_value())
                .Throw(_thrown) -> return ValueBlock(:pre, body: self.unreachable_value())
                else none
            }
        }
        self.record_error(f"error: {need}", got: open_tok)
        return ValueBlock(:pre, body: self.unreachable_value())
    }

    // `if cond { a } else { b }` as a value, after the `if`: a match of the condition, or
    // of what it tests with `is`. An `and` that binds or narrows is a match in a match,
    // each with the `else` parsed for itself, as for the statement.
    func parse_if_expr(self, anon if_tok: lexing.Token, span: ast.Span) -> int64 {
        self.binding_exprs += 1
        let cond = self.parse_expr()
        let ops = self.and_operands(cond)
        mut patterned = false
        for op in ops {
            if self.binds_names(op) or self.narrows_op(op) {
                patterned = true
            }
        }
        if len(ops) == 1 and self.exprs[cond] is .Binary(subject, is_op, rhs) and (is_op is .Is or is_op is .IsNot) {
            let pattern = self.pattern_of_expr(rhs)
            if pattern >= 0 {
                return self.parse_if_is(if_tok, subject, :pattern, negated: is_op is .IsNot, :span)
            }
            patterned = false
        }
        if not patterned {
            let yes = self.parse_branch()
            let no = self.parse_else_branch(if_tok)
            return self.if_expr(cond, pattern: self.alloc_pattern(ast.Pattern.BoolPat(value: true)), :yes, other: self.alloc_pattern(ast.Pattern.Wildcard), :no, :span)
        }
        let pats = self.chain_patterns(ops, narrow: true)
        let from = self.pos
        let yes = self.parse_branch()
        self.narrow_chain(ops, :pats, :from, to: self.pos)
        let else_pos = self.pos
        let errors_before = len(self.errors)
        mut elses = [self.parse_else_branch(if_tok)]
        let end_pos = self.pos
        for len(elses) < len(ops) {
            if len(self.errors) > errors_before {
                elses += [elses[0]]
            } else {
                self.pos = else_pos
                elses += [self.parse_else_branch(if_tok)]
            }
        }
        self.pos = end_pos
        mut inner = yes
        mut k = len(ops) - 1
        for k >= 0 {
            mut subject = ops[k]
            mut pattern = pats[k]
            if pattern < 0 {
                pattern = self.alloc_pattern(ast.Pattern.BoolPat(value: true))
            } else if self.exprs[subject] is .Binary(tested, _op, _rhs) {
                subject = tested
            }
            let body = self.if_expr(subject, :pattern, yes: inner, other: self.alloc_pattern(ast.Pattern.Wildcard), no: elses[k], :span)
            inner = ValueBlock(pre: [], :body)
            k -= 1
        }
        return inner.body
    }

    // `if subject is pattern { a } else { b }`, or with `is not`, from the first block on.
    func parse_if_is(self, anon if_tok: lexing.Token, anon subject: int64, pattern: int64, negated: bool, span: ast.Span) -> int64 {
        let from = self.pos
        let yes = self.parse_branch()
        let to = self.pos
        let no = self.parse_else_branch(if_tok)
        let end = self.pos
        mut other = self.alloc_pattern(ast.Pattern.Wildcard)
        let name = self.narrow_name(subject)
        if len(name) > 0 {
            // What the pattern fits is in the first block, and with `is not` in the other.
            let fits = not self.assigns(name, :from, :to)
            let rest = not self.assigns(name, from: to, to: end)
            if self.narrows(pattern) {
                if (not negated and fits) or (negated and rest) {
                    self.narrow_to(pattern, :name)
                }
            } else if self.patterns[pattern] is .NonePat {
                if (not negated and rest) or (negated and fits) {
                    other = self.alloc_pattern(ast.Pattern.SomePat(binding: name))
                }
            }
        }
        if negated {
            return self.if_expr(subject, :pattern, yes: no, :other, no: yes, :span)
        }
        return self.if_expr(subject, :pattern, :yes, :other, :no, :span)
    }

    func if_expr(self, anon subject: int64, pattern: int64, yes: ValueBlock, other: int64, no: ValueBlock, span: ast.Span) -> int64 {
        let arms = [
            self.alloc_match_expr_arm(ast.MatchExprArm(:pattern, body: yes.body, pre: yes.pre, is_if: true)),
            self.alloc_match_expr_arm(ast.MatchExprArm(pattern: other, body: no.body, pre: no.pre, is_if: true)),
        ]
        return self.alloc_expr(ast.Expr.MatchExpr(:subject, :arms), :span)
    }

    func parse_branch(self) -> ValueBlock {
        return self.parse_value_block("a branch of an `if` used as a value must end with an expression, its value")
    }

    func parse_else_branch(self, anon if_tok: lexing.Token) -> ValueBlock {
        let pos = self.pos
        self.skip_newlines()
        if not self.try_consume(.KwElse) {
            self.pos = pos
            self.record_error("error: an `if` used as a value needs an `else`", got: if_tok)
            return ValueBlock(pre: [], body: self.unreachable_value())
        }
        if self.at(.KwIf) {
            return ValueBlock(pre: [], body: self.parse_expr())
        }
        return self.parse_branch()
    }

    func parse_match_stmt_arm(self, anon pat: int64, guarded: bool) -> int64 {
        let guard = self.parse_arm_guard(guarded)
        mut body: [int64] = []
        if self.try_consume(.KwNone) {
            // `else none` — empty no-op body sugar.
        } else {
            if self.at(.OpenCurly) {
                body = self.parse_block()
            } else {
                body += self.parse_stmts()
            }
        }
        return self.alloc_match_arm(ast.MatchArm(pattern: pat, :body, :guard))
    }

    // `if cond ->` after an arm's patterns, or 0. Each alternative of an arm
    // parses it for itself, as it does the body.
    func parse_arm_guard(self, anon guarded: bool) -> int64 {
        if not guarded {
            return 0
        }
        self.expect(.KwIf)
        let guard = self.parse_expr()
        self.expect(.Arrow)
        return guard
    }

    // The value of a block arm that ends in `return` or `throw`: a call that
    // never returns, which the arm never gets to.
    func unreachable_value(self) -> int64 {
        let span: ast.Span = self.here()
        let callee: int64 = self.alloc_expr(ast.Expr.Ident(name: "panic"), :span)
        let message: int64 = self.alloc_expr(ast.Expr.StrLit(value: "unreachable"), :span)
        let args: [ast.CallArg] = [ast.CallArg(label: "", label_span: span, value: message)]
        return self.alloc_expr(ast.Expr.Call(:callee, :args), :span)
    }

    // Parse a match-arm's patterns and the connecting token. `else { ... }`,
    // `else expr`, and `else -> expr` are accepted as catch-all arms in
    // place of `else ...`. For non-else patterns, the `->` is required, unless
    // a guard comes first (`arm_guarded`), whose parse then takes the `->`.
    // `.A | .B -> body` is one arm per pattern; the caller parses the body
    // once for each, so each is its own statements, as with an `else` body.
    func parse_match_arm_patterns(self) -> [int64] {
        self.arm_guarded = false
        self.arm_broken = false
        if self.try_consume(.KwElse) {
            self.try_consume(.Arrow)
            return [self.alloc_pattern(ast.Pattern.Wildcard)]
        }
        mut pats: [int64] = [self.parse_pattern()]
        let bar_tok: lexing.Token = self.peek()
        for self.at(.Pipe) or self.at(.Comma) {
            if self.at(.Comma) {
                self.record_error("error: alternatives in a match arm are joined by `|`, not `,`: `.A | .B -> ...`", got: self.peek())
            }
            self.advance()
            self.skip_newlines()
            pats += [self.parse_pattern()]
        }
        if len(pats) > 1 {
            for pat in pats {
                if self.pattern_binds(pat) {
                    self.record_error("error: alternatives joined by `|` can't bind names; give the arm that binds a line of its own", got: bar_tok)
                    break
                }
            }
        }
        if self.at(.KwIf) {
            self.arm_guarded = true
            return pats
        }
        if not self.at(.Arrow) {
            // Read on as if the arm were well formed and the rest of the match, and
            // what follows it, comes out as errors too; skip to the `->` or the
            // end of the arm instead.
            self.record_unexpected(expected: lexing.TokenKind.Arrow.name(), got: self.peek())
            self.skip_rest_of_arm()
            if not self.at(.Arrow) {
                self.arm_broken = true
                return pats
            }
        }
        self.advance()
        return pats
    }

    // Skips to a `->`, the end of the line or the `}` that ends the match, past any
    // brackets in between.
    // After an arm's body comes the end of the line, the match's `}`, or another
    // arm on the same line (`{ .A -> 1  else 2 }`). Anything else is one error,
    // and skipped, rather than read as the next arm's patterns.
    func end_arm_line(self, anon errors_before: int64) -> none {
        let kind = self.peek_kind()
        if len(self.errors) > errors_before or kind == .EOL or kind == .Comment or kind == .CloseCurly or kind == .EOF or kind == .KwElse {
            return
        }
        if self.pos > 0 and self.tokens[self.pos - 1].kind == .EOL {
            return
        }
        if self.arrow_before_line_end() {
            return
        }
        self.record_error("error: a match arm's body ends its line; put what follows on a line of its own, or use `{ ... }` for several statements", got: self.peek())
        mut depth: int64 = 0
        for not self.at(.EOF) {
            let next = self.peek_kind()
            if depth == 0 and (next == .EOL or next == .CloseCurly) {
                return
            }
            if next == .OpenCurly or next == .OpenParen or next == .OpenBracket {
                depth += 1
            } else if next == .CloseCurly or next == .CloseParen or next == .CloseBracket {
                depth -= 1
            }
            self.advance()
        }
    }

    // Whether a `->` comes before the end of this line, outside brackets.
    func arrow_before_line_end(self) -> bool {
        mut depth: int64 = 0
        for i in self.pos..len(self.tokens) {
            let kind = self.tokens[i].kind
            if depth == 0 and kind == .Arrow {
                return true
            }
            if (depth == 0 and (kind == .EOL or kind == .CloseCurly)) or kind == .EOF {
                return false
            }
            if kind == .OpenCurly or kind == .OpenParen or kind == .OpenBracket {
                depth += 1
            } else if kind == .CloseCurly or kind == .CloseParen or kind == .CloseBracket {
                depth -= 1
            }
        }
        return false
    }

    func skip_rest_of_arm(self) -> none {
        mut depth: int64 = 0
        for not self.at(.EOF) {
            let kind = self.peek_kind()
            if depth == 0 and (kind == .Arrow or kind == .EOL or kind == .CloseCurly) {
                return
            }
            if kind == .OpenCurly or kind == .OpenParen or kind == .OpenBracket {
                depth += 1
            } else if kind == .CloseCurly or kind == .CloseParen or kind == .CloseBracket {
                depth -= 1
            }
            self.advance()
        }
    }

    func pattern_binds(self, anon pat: int64) -> bool {
        for sub in self.pattern_subs[pat] {
            if self.pattern_binds(sub.pattern) {
                return true
            }
        }
        match self.patterns[pat] {
            .EnumPat(_enum_name, _variant_name, bindings) -> return self.any_named(bindings)
            .ImplicitEnumPat(_variant_name, bindings) -> return self.any_named(bindings)
            .SomePat(binding) -> return self.any_named([binding])
            .OkPat(binding) -> return self.any_named([binding])
            .ErrPat(binding) -> return self.any_named([binding])
            else return false
        }
    }

    func any_named(self, anon bindings: [str]) -> bool {
        for name in bindings {
            if len(name) > 0 and name != "_" and not is_hidden_binding(name) {
                return true
            }
        }
        return false
    }

    func parse_postfix(self, anon base: int64) -> int64 {
        mut lhs: int64 = base
        // Source span carried forward across all postfix wraps of the
        // same base expression. For `obj.method(args)` and similar, the
        // resulting nodes all point back to where the base started.
        let lhs_span: ast.Span = self.expr_spans[lhs]
        // An open chain `x?.a.b`: the value before `?.` and the hidden name
        // the steps after it read, as `lhs`, in place of the unwrapped value.
        mut chain_value: int64 = 0
        mut chain_name: str = ""
        for self.at(.OpenParen) or self.at(.Dot) or self.at(.OpenBracket) or self.at(.Question) {
            // Function/method call
            if self.at(.OpenParen) {
                self.advance()
                mut args: [ast.CallArg] = []
                self.skip_newlines()
                for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
                    let errors_before: int64 = len(self.errors)
                    // Leading-colon shorthand `:name` → `name: name`.
                    // Explicit form for the (otherwise ambiguous) case of
                    // passing a variable whose name matches the parameter
                    // label.
                    if self.at(.Colon) {
                        self.advance()
                        let label_span: ast.Span = self.here()
                        mut name: str = self.expect_identifier()
                        let val: int64 = self.alloc_expr(ast.Expr.Ident(:name), span: label_span)
                        args += [ast.CallArg(label: name, :label_span, value: val)]
                    } else if self.at(.Identifier) and self.peek_kind_at(1) == .Colon {
                        // Labeled arg: identifier followed by colon.
                        let label_span: ast.Span = self.here()
                        mut label: str = self.expect_identifier()
                        self.expect(.Colon)
                        let by_ref = self.try_consume(.KwMut)
                        let val: int64 = self.parse_expr()
                        args += [ast.CallArg(:label, :label_span, value: val, :by_ref)]
                    } else {
                        // Anonymous arg: anything else, including a bare
                        // identifier. To pass a variable to a labeled param,
                        // use `:name` or the full `name: name` form.
                        let anon_span: ast.Span = self.here()
                        let by_ref = self.try_consume(.KwMut)
                        let val: int64 = self.parse_expr()
                        args += [ast.CallArg(label: "", label_span: anon_span, value: val, :by_ref)]
                    }
                    // After a bad argument, leave the line end alone: the `)` is
                    // expected right here, as it was before calls could span lines.
                    if len(self.errors) > errors_before {
                        break
                    }
                    self.skip_newlines()
                    if not self.try_consume(.Comma) {
                        break
                    }
                    self.skip_newlines()
                }
                self.expect(.CloseParen)
                lhs = self.alloc_expr(ast.Expr.Call(callee: lhs, :args), span: lhs_span)
            }
            // Dot access: expr.name
            if self.at(.Dot) {
                self.advance()
                let field_span: ast.Span = self.here()
                let field: str = self.expect_field()
                let rhs: int64 = self.alloc_expr(ast.Expr.Ident(name: field), span: field_span)
                lhs = self.alloc_expr(ast.Expr.Binary(:lhs, op: ast.Op.Dot, :rhs), span: lhs_span)
            }
            // Index, slice, or generic constructor: expr[idx], expr[lo..hi],
            // expr[..hi], expr[lo..], expr[..], or Type[A, B](...).
            if self.at(.OpenBracket) {
                self.advance()
                // `expr[..hi]` / `expr[..]`: omitted lo, default to 0.
                self.no_inclusive_slice()
                if self.at(.DotDot) or self.at(.DotDotEq) {
                    let zero_span: ast.Span = self.here()
                    let lo: int64 = self.alloc_expr(ast.Expr.IntLit(value: 0), span: zero_span)
                    self.advance()
                    mut hi: int64 = 0
                    if self.peek_kind() != .CloseBracket {
                        hi = self.parse_expr()
                    }
                    self.expect(.CloseBracket)
                    lhs = self.alloc_expr(ast.Expr.Slice(s: lhs, :lo, :hi), span: lhs_span)
                } else {
                    let lo: int64 = self.parse_expr()
                    self.no_inclusive_slice()
                    if self.try_consume(.DotDot) or self.try_consume(.DotDotEq) {
                        mut hi: int64 = 0
                        if self.peek_kind() != .CloseBracket {
                            hi = self.parse_expr()
                        }
                        self.expect(.CloseBracket)
                        lhs = self.alloc_expr(ast.Expr.Slice(s: lhs, :lo, :hi), span: lhs_span)
                    } else {
                        // `m[k, default: d]`: a call of the struct's `op_index_or(k, default: d)`.
                        if self.at(.Comma) and self.peek_kind_at(1) == .Identifier and self.peek_kind_at(2) == .Colon {
                            self.advance()
                            let label_span: ast.Span = self.here()
                            let label_tok = self.peek()
                            let label = self.expect_identifier()
                            if label != "default" {
                                self.record_error(f"error: expected `default:` after the key, got `{label}`", got: label_tok)
                            }
                            self.expect(.Colon)
                            let fallback: int64 = self.parse_expr()
                            self.expect(.CloseBracket)
                            let method = self.alloc_expr(ast.Expr.Ident(name: "op_index_or"), span: label_span)
                            let callee = self.alloc_expr(ast.Expr.Binary(:lhs, op: ast.Op.Dot, rhs: method), span: lhs_span)
                            let args: [ast.CallArg] = [ast.CallArg(label: "", label_span: lhs_span, value: lo), ast.CallArg(label: "default", :label_span, value: fallback)]
                            lhs = self.alloc_expr(ast.Expr.Call(:callee, :args), span: lhs_span)
                            continue
                        }
                        if self.try_consume(.Comma) {
                            // `Type[A, B]` folds into Index(Index(Type, A), B).
                            lhs = self.alloc_expr(ast.Expr.Binary(:lhs, op: ast.Op.Index, rhs: lo), span: lhs_span)
                            for self.peek_kind() != .CloseBracket and self.peek_kind() != .EOF {
                                let type_arg: int64 = self.parse_expr()
                                lhs = self.alloc_expr(ast.Expr.Binary(:lhs, op: ast.Op.Index, rhs: type_arg), span: lhs_span)
                                if not self.try_consume(.Comma) {
                                    break
                                }
                            }
                            self.expect(.CloseBracket)
                            if not self.at(.OpenParen) and not self.at(.Comma) and not self.at(.CloseBracket) {
                                self.record_unexpected(expected: "`(` after generic type arguments", got: self.peek())
                            }
                        } else {
                            self.expect(.CloseBracket)
                            // Always produce an Index node, even when the
                            // next token is `(`. The codegen distinguishes
                            // `Type[A](args)` (generic constructor — lhs is
                            // a known struct name) from `arr[i](args)`
                            // (indirect call on an indexed value).
                            lhs = self.alloc_expr(ast.Expr.Binary(:lhs, op: ast.Op.Index, rhs: lo), span: lhs_span)
                        }
                    }
                }
            }
            // Postfix `?` on a `T?` value. `expr?` panics on none;
            // `expr? or default` substitutes `default`. The default is parsed
            // at precedence above `or` so a following `or` is left for the
            // surrounding parse_expr_prec (where it'll be the boolean
            // operator, or a type error if applied to the unwrap result).
            if self.at(.Question) {
                if chain_value != 0 {
                    lhs = self.close_chain(chain_value, name: chain_name, body: lhs, span: lhs_span)
                    chain_value = 0
                }
                self.advance()
                if self.at(.Dot) {
                    // `x?.field` — short-circuit field access on a
                    // `T?` struct. `x?.method(args)` — short-circuit
                    // method call. Both short-circuit to `none` when x
                    // is none; otherwise the field/method runs on the
                    // unwrapped value and the result is wrapped as Some.
                    self.advance()
                    let name: str = self.expect_field()
                    if self.at(.OpenParen) {
                        self.advance()
                        mut args: [ast.CallArg] = []
                        self.skip_newlines()
                        for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
                            let errors_before: int64 = len(self.errors)
                            if self.at(.Colon) {
                                self.advance()
                                let label_span: ast.Span = self.here()
                                mut arg_name: str = self.expect_identifier()
                                let val: int64 = self.alloc_expr(ast.Expr.Ident(name: arg_name), span: label_span)
                                args += [ast.CallArg(label: arg_name, :label_span, value: val)]
                            } else if self.at(.Identifier) and self.peek_kind_at(1) == .Colon {
                                let label_span: ast.Span = self.here()
                                mut label: str = self.expect_identifier()
                                self.expect(.Colon)
                                let by_ref = self.try_consume(.KwMut)
                                let val: int64 = self.parse_expr()
                                args += [ast.CallArg(:label, :label_span, value: val, :by_ref)]
                            } else {
                                let anon_span: ast.Span = self.here()
                                let by_ref = self.try_consume(.KwMut)
                                let val: int64 = self.parse_expr()
                                args += [ast.CallArg(label: "", label_span: anon_span, value: val, :by_ref)]
                            }
                            if len(self.errors) > errors_before {
                                break
                            }
                            self.skip_newlines()
                            if not self.try_consume(.Comma) {
                                break
                            }
                            self.skip_newlines()
                        }
                        self.expect(.CloseParen)
                        if self.at(.Dot) or self.at(.OpenBracket) {
                            chain_value = lhs
                            chain_name = f"__patchain{lhs}"
                            let method: int64 = self.chain_step(chain_name, field: name, span: lhs_span)
                            lhs = self.alloc_expr(ast.Expr.Call(callee: method, :args), span: lhs_span)
                        } else {
                            lhs = self.alloc_expr(ast.Expr.OptionalMethodCall(value: lhs, method: name, :args), span: lhs_span)
                        }
                    } else if self.at(.Dot) or self.at(.OpenBracket) {
                        chain_value = lhs
                        chain_name = f"__patchain{lhs}"
                        lhs = self.chain_step(chain_name, field: name, span: lhs_span)
                    } else {
                        lhs = self.alloc_expr(ast.Expr.OptionalDot(value: lhs, field: name), span: lhs_span)
                    }
                } else {
                    mut default_expr: int64 = 0
                    if self.try_consume(.KwOr) {
                        default_expr = self.parse_expr_prec(3)
                    }
                    lhs = self.alloc_expr(ast.Expr.UnwrapOpt(value: lhs, default: default_expr), span: lhs_span)
                }
            }
        }
        if chain_value != 0 {
            lhs = self.close_chain(chain_value, name: chain_name, body: lhs, span: lhs_span)
        }
        return lhs
    }

    // `name.field`: the first step of a chain, on the unwrapped value.
    func chain_step(self, anon name: str, field: str, span: ast.Span) -> int64 {
        let unwrapped: int64 = self.alloc_expr(ast.Expr.Ident(:name), :span)
        let rhs: int64 = self.alloc_expr(ast.Expr.Ident(name: field), :span)
        return self.alloc_expr(ast.Expr.Binary(lhs: unwrapped, op: ast.Op.Dot, :rhs), :span)
    }

    // `x?.a.b` as `match x { Some(v) -> v.a.b  else -> none }`, with `x` seen as an
    // optional so that a result's failure is `none` too.
    func close_chain(self, anon value: int64, name: str, body: int64, span: ast.Span) -> int64 {
        let subject: int64 = self.alloc_expr(ast.Expr.AsOptional(:value), :span)
        let some: int64 = self.alloc_pattern(ast.Pattern.SomePat(binding: name))
        let none_lit: int64 = self.alloc_expr(ast.Expr.NoneLit, :span)
        let arms: [int64] = [
            self.alloc_match_expr_arm(ast.MatchExprArm(pattern: some, :body)),
            self.alloc_match_expr_arm(ast.MatchExprArm(pattern: self.alloc_pattern(ast.Pattern.Wildcard), body: none_lit)),
        ]
        return self.alloc_expr(ast.Expr.MatchExpr(:subject, :arms), :span)
    }

    func bin_op_prec(self) -> int64 {
        // Precedence climbs (higher binds tighter): `or`, `and`, the
        // comparisons and `is` (comparison_prec()), then `|`, `^` and `&`
        // (above the comparisons, as in Python and Rust, not C, so
        // `flags & 1 != 0` needs no parentheses), shifts, and arithmetic.
        match self.peek_kind() {
            .KwOr -> return 2
            .KwAnd -> return 3
            .KwIs -> return 4
            .KwIn -> return 4
            .KwNot -> {
                if self.peek_kind_at(1) == .KwIn {
                    return 4
                }
                return 0
            }
            .EqualEqual -> return 4
            .NotEqual -> return 4
            .LessThan -> return 4
            .LessEqual -> return 4
            .GreaterThan -> return 4
            .GreaterEqual -> return 4
            .Pipe -> return 5
            .Caret -> return 6
            .Ampersand -> return 7
            .ShiftLeft -> return 8
            .ShiftRight -> return 8
            .Plus -> return 9
            .Minus -> return 9
            .Star -> return 10
            .Slash -> return 10
            .Percent -> return 10
            else return 0
        }
    }

    func consume_bin_op(self) -> ast.Op {
        let kind: lexing.TokenKind = self.peek_kind()
        self.advance()
        match kind {
            .KwIs -> {
                // `is not Pat` is a two-word operator — `is` negated.
                // Consuming the `not` here keeps precedence + parsing
                // of the rhs identical to plain `is`.
                if self.try_consume(.KwNot) {
                    return .IsNot
                }
                return .Is
            }
            .KwIn -> return .In
            .KwNot -> {
                self.expect(.KwIn)
                return .NotIn
            }
            .KwOr -> return .Or
            .KwAnd -> return .And
            .Pipe -> return .BitOr
            .Caret -> return .BitXor
            .Ampersand -> return .BitAnd
            .EqualEqual -> return .Eq
            .NotEqual -> return .Ne
            .LessThan -> return .Lt
            .LessEqual -> return .Le
            .GreaterThan -> return .Gt
            .GreaterEqual -> return .Ge
            .ShiftLeft -> return .Shl
            .ShiftRight -> return .Shr
            .Plus -> return .Add
            .Minus -> return .Sub
            .Star -> return .Mul
            .Slash -> return .Div
            .Percent -> return .Mod
            else return .Add
        }
    }

    func parse_expr(self) -> int64 {
        let e = self.parse_expr_prec(1)
        if self.exprs[e] is .Binary(_l, op, _r) and op is .And {
            for o in self.and_operands(e) {
                if self.binds_names(o) {
                    self.value_chains += [e]
                    break
                }
            }
        }
        return e
    }

    // The `and` chains no condition took, each rewritten in place: `a and x is
    // P(b) and c` as `a and match x { P(b) -> c, else -> false }`, so `b` reaches
    // the rest of the chain wherever it is.
    func flush_value_chains(self) -> none {
        let chains = self.value_chains
        self.value_chains = []
        for e in chains {
            let ops = self.and_operands(e)
            let span = self.expr_spans[e]
            let whole = self.value_chain(ops, from: 0, :span)
            self.exprs[e] = self.exprs[whole]
        }
    }

    func value_chain(self, anon ops: [int64], from: int64, span: ast.Span) -> int64 {
        if from >= len(ops) {
            return self.alloc_expr(ast.Expr.BoolLit(value: true), :span)
        }
        let op = ops[from]
        if self.binds_names(op) and self.exprs[op] is .Binary(subject, _is, rhs) {
            let pat = self.pattern_of_expr(rhs)
            if pat >= 0 {
                self.binding_exprs += 1
                let arms = [
                    self.alloc_match_expr_arm(ast.MatchExprArm(pattern: pat, body: self.value_chain(ops, from: from + 1, :span))),
                    self.alloc_match_expr_arm(ast.MatchExprArm(pattern: self.alloc_pattern(ast.Pattern.Wildcard), body: self.alloc_expr(ast.Expr.BoolLit(value: false), :span))),
                ]
                return self.alloc_expr(ast.Expr.MatchExpr(:subject, :arms), :span)
            }
        }
        if from + 1 == len(ops) {
            return op
        }
        return self.alloc_expr(ast.Expr.Binary(lhs: op, op: .And, rhs: self.value_chain(ops, from: from + 1, :span)), :span)
    }

    // `is` shares the comparisons' precedence but doesn't chain.
    func chains(self, anon op: ast.Op) -> bool {
        match op {
            .Eq -> return true
            .Ne -> return true
            .Lt -> return true
            .Le -> return true
            .Gt -> return true
            .Ge -> return true
            else return false
        }
    }

    func at_chain_op(self) -> bool {
        return self.bin_op_prec() == comparison_prec() and self.peek_kind() != .KwIs and self.peek_kind() != .KwIn and self.peek_kind() != .KwNot
    }

    func parse_expr_prec(self, anon min_prec: int64) -> int64 {
        mut lhs: int64 = self.parse_primary()
        lhs = self.parse_postfix(lhs)
        // Binary-op nodes inherit the lhs's span so the whole tree
        // points back to the leftmost token.
        let lhs_span: ast.Span = self.expr_spans[lhs]
        for self.bin_op_prec() >= min_prec and self.bin_op_prec() > 0 {
            let prec: int64 = self.bin_op_prec()
            let op_tok: lexing.Token = self.peek()
            let op: ast.Op = self.consume_bin_op()
            let rhs: int64 = self.parse_expr_prec(prec + 1)
            if self.mixes_and_or(op, lhs) or self.mixes_and_or(op, rhs) {
                self.record_error("error: `and` and `or` don't mix without parentheses: write `(a and b) or c` or `a and (b or c)`", got: op_tok)
            }
            // Python-style chained comparisons: `a < b < c` builds a
            // single Chain instead of `((a < b) < c)`. Comparisons live
            // at comparison_prec(); if the next token is also a comparison
            // op, keep collecting operands and operators into one node.
            if self.chains(op) and self.at_chain_op() {
                mut chain_exprs: [int64] = [lhs, rhs]
                mut chain_ops: [ast.Op] = [op]
                for self.at_chain_op() {
                    let next_op: ast.Op = self.consume_bin_op()
                    let next_rhs: int64 = self.parse_expr_prec(comparison_prec() + 1)
                    chain_exprs += [next_rhs]
                    chain_ops += [next_op]
                }
                lhs = self.alloc_expr(ast.Expr.Chain(exprs: chain_exprs, ops: chain_ops), span: lhs_span)
            } else {
                lhs = self.alloc_expr(ast.Expr.Binary(:lhs, :op, :rhs), span: lhs_span)
            }
        }
        return lhs
    }

    // Whether `operand` of an `op` is an `and` under an `or`, or an `or` under
    // an `and`, not in parentheses.
    func mixes_and_or(self, anon op: ast.Op, anon operand: int64) -> bool {
        let .Binary(_l, inner, _r) = self.exprs[operand] else { return false }
        let mixed = (op is .And and inner is .Or) or (op is .Or and inner is .And)
        return mixed and not arrays.contains(self.grouped, operand)
    }

    func parse_block(self) -> [int64] {
        if not self.at(.OpenCurly) {
            self.record_unexpected(expected: lexing.TokenKind.OpenCurly.name(), got: self.peek())
            // Resume at a `{` later on the line, or give up on the block.
            for not self.at(.OpenCurly) and not self.at(.EOL) and not self.at(.EOF) {
                self.advance()
            }
            if not self.at(.OpenCurly) {
                return []
            }
        }
        self.advance()
        self.skip_newlines()
        mut stmts: [int64] = []
        mut guards: [Guard] = []
        mut unwraps: [Unwrap] = []
        mut last_at = -1
        for self.peek_kind() != .CloseCurly and self.peek_kind() != .EOF {
            self.skip_newlines()
            if self.peek_kind() == .CloseCurly {
                break
            }
            // A declaration can't be a statement: the block's `}` is missing.
            // Each block it is in ends here, and the declaration is parsed.
            // A `func name` to the right of the module's declarations is a local function.
            if self.at_decl_keyword() and not (self.at(.KwFunc) and not self.at_decl_start()) {
                self.record_error(f"error: expected `}` before {self.peek_kind().name()}, which starts a declaration", got: self.peek(), desync: true)
                self.narrow_unwraps(unwraps, to: self.pos)
                return self.fold_guards(stmts, :guards, to: self.pos)
            }
            let errors_before = len(self.errors)
            self.quiet = false
            let start = self.pos
            last_at = start
            self.guard_arm = -1
            let stmt_id = self.parse_stmt()
            self.flush_value_chains()
            stmts += [stmt_id]
            stmts += self.more_stmts
            self.more_stmts = []
            self.expect_stmt_end(:stmt_id, :errors_before)
            if self.pos == start {
                self.advance()
            }
            if self.guard_arm >= 0 {
                guards += [Guard(at: len(stmts), from: self.pos, arm: self.guard_arm, pattern: self.guard_pat, name: self.guard_name, call: self.guard_call)]
                self.guard_arm = -1
            }
            let unwrapped = self.unwrap_stmt_name(stmt_id)
            if len(unwrapped) > 0 {
                unwraps += [Unwrap(stmt: stmt_id, from: self.pos, name: unwrapped)]
            }
            self.skip_newlines()
        }
        let stmts_end = self.pos
        // After the blocks inside, which set it too.
        self.last_stmt_at = last_at
        if len(guards) > 0 {
            self.last_stmt_at = -1
        }
        self.expect(.CloseCurly)
        self.narrow_unwraps(unwraps, to: stmts_end)
        return self.fold_guards(stmts, :guards, to: stmts_end)
    }

    // The name of a `try x` or `must x` statement, or "".
    func unwrap_stmt_name(self, anon stmt_id: int64) -> str {
        if stmt_id < 0 {
            return ""
        }
        let .ExprStmt(expr) = self.stmts[stmt_id] else { return "" }
        match self.exprs[expr] {
            .Try(inner) -> return self.narrow_name(inner)
            .Must(inner) -> return self.narrow_name(inner)
            else return ""
        }
    }

    // `try x` and `must x` statements narrow `x` for the rest of the block: each
    // becomes `let x = try x`, unless the rest assigns `x`.
    func narrow_unwraps(self, anon unwraps: [Unwrap], to: int64) -> none {
        for u in unwraps {
            if not self.assigns(u.name, from: u.from, :to) {
                let .ExprStmt(expr) = self.stmts[u.stmt] else { continue }
                self.stmts[u.stmt] = ast.Stmt.Let(name: u.name, typ: 0, value: expr, mutable: false)
            }
        }
    }

    // `if x is none { return }` and the statements after it: those go in the
    // match arm where `x` holds something, so `x` is narrowed there. The last
    // guard folds first, so an earlier one takes it in. A rest that assigns `x`
    // stays where it is.
    func fold_guards(self, anon stmts: [int64], guards: [Guard], to: int64) -> [int64] {
        mut out = stmts
        mut i = len(guards) - 1
        for i >= 0 {
            let g = guards[i]
            i -= 1
            if g.at >= len(out) or self.assigns(g.name, from: g.from, :to) {
                continue
            }
            self.match_arms[g.arm] = ast.MatchArm(pattern: g.pattern, body: out[g.at..])
            if g.call != 0 {
                self.fold_stmts += [out[g.at - 1]]
                self.fold_calls += [g.call]
                self.fold_arms += [g.arm]
            }
            out = out[0..g.at]
        }
        return out
    }

    // Whether a block ends in a statement that can't fall through: a written
    // `return`, `throw`, `break`, `continue` or `panic(...)`.
    func ends_in_exit(self, anon stmts: [int64]) -> bool {
        if len(stmts) == 0 {
            return false
        }
        match self.stmts[stmts[len(stmts) - 1]] {
            .Return(_v) -> return true
            .Throw(_v) -> return true
            .Break -> return true
            .Continue -> return true
            .ExprStmt(expr) -> {
                if self.exprs[expr] is .Call(callee, _args) and self.exprs[callee] is .Ident(name) {
                    return name == "panic"
                }
                return false
            }
            else return false
        }
    }

    // The call a block ends in, other than `panic(...)`, or 0: codegen
    // decides whether it returns.
    func ends_in_call(self, anon stmts: [int64]) -> int64 {
        if len(stmts) == 0 {
            return 0
        }
        let .ExprStmt(expr) = self.stmts[stmts[len(stmts) - 1]] else { return 0 }
        let .Call(_callee, _args) = self.exprs[expr] else { return 0 }
        return expr
    }

    // A statement ends its line unless a block's `}` ended it.
    func expect_stmt_end(self, stmt_id: int64, errors_before: int64) -> none {
        let prev = self.tokens[self.pos - 1].kind
        if prev == .EOL or prev == .CloseCurly {
            return
        }
        if self.at(.EOL) or self.at(.Comment) or self.at(.CloseCurly) or self.at(.EOF) {
            return
        }
        if len(self.errors) == errors_before {
            mut what = "this statement"
            if stmt_id >= 0 {
                match self.stmts[stmt_id] {
                    .ExprStmt(expr) -> {
                        if self.exprs[expr] is .Ident(name) {
                            what = f"`{name}`"
                            // A misspelled keyword: don't also report the name.
                            self.stmts[stmt_id] = ast.Stmt.ExprStmt(expr: 0)
                        }
                    }
                    else none
                }
            }
            self.record_error(f"error: expected the end of the line after {what}, got {self.peek_kind().name()}", got: self.peek(), desync: true)
        }
        self.skip_rest_of_stmt(depth: 0)
    }

    // Skip to the end of the statement, past any block it opens.
    func skip_rest_of_stmt(self, depth: int64) -> none {
        mut open = depth
        for not self.at(.EOF) {
            if open == 0 {
                if self.at(.EOL) or self.at(.CloseCurly) {
                    return
                }
            }
            if self.at(.OpenCurly) {
                open = open + 1
            } else if self.at(.CloseCurly) {
                open = open - 1
            }
            self.advance()
        }
    }

    // The names `(a, (b, _))` binds, from the `(` on.
    func parse_tuple_names(self) -> TupleNames {
        let span = self.here()
        self.expect(.OpenParen)
        mut parts: [TupleNames] = []
        for not self.at(.CloseParen) and not self.at(.EOF) {
            if self.at(.OpenParen) {
                parts += [self.parse_tuple_names()]
            } else {
                let name_span = self.here()
                parts += [TupleNames(name: self.binding_identifier(), span: name_span, parts: [])]
            }
            if not self.try_consume(.Comma) {
                break
            }
        }
        self.expect(.CloseParen)
        self.check_tuple_len(len(parts), :span)
        return TupleNames(name: f"__tuple{span.start}", :span, :parts)
    }

    // A name, or the names a tuple is taken apart into, where a `for` binds one.
    func parse_for_names(self) -> TupleNames {
        if self.at(.OpenParen) {
            return self.parse_tuple_names()
        }
        let span = self.here()
        return TupleNames(name: self.binding_identifier(), :span, parts: [])
    }

    // What a `for`'s body begins with, to take its variable apart.
    func bind_for(self, anon names: TupleNames, span: ast.Span) -> [int64] {
        if len(names.parts) == 0 {
            return []
        }
        self.check_twice(names)
        return self.bind_parts(names, :span, mutable: false)
    }

    // How many tokens the names at `offset` take, or 0 when none can be there.
    func for_names_len(self, anon offset: int64) -> int64 {
        if self.peek_kind_at(offset) == .Identifier {
            return 1
        }
        if self.peek_kind_at(offset) != .OpenParen {
            return 0
        }
        mut depth = 0
        mut i = offset
        for true {
            match self.peek_kind_at(i) {
                .OpenParen -> depth += 1
                .CloseParen -> {
                    depth -= 1
                    if depth == 0 {
                        return i + 1 - offset
                    }
                }
                .Identifier | .Comma -> none
                else return 0
            }
            i += 1
        }
        return 0
    }

    // `let (a, b) = value`, after the `let` or `mut`.
    func parse_let_tuple(self, mutable: bool) -> int64 {
        let names = self.parse_tuple_names()
        mut typ = 0
        if self.try_consume(.Colon) {
            typ = self.parse_type_expr()
        }
        self.expect(.Equal)
        let from = self.pos
        let value = self.parse_expr()
        let to = self.pos
        self.skip_newlines()
        self.check_twice(names)
        let elements = self.tuple_elements(value)
        if typ != 0 or len(elements) != len(names.parts) {
            return self.first_of(self.bind_tuple(names, :value, :typ, :mutable))
        }
        // A tuple to be taken apart at once isn't made. An element that reads a name
        // bound here before it means the one outside.
        mut stmts: [int64] = []
        mut values = elements
        if self.mentions(self.names_of(names), :from, :to) {
            values = []
            for i, e in elements {
                let held = f"{names.name}_{i}"
                stmts += [self.alloc_stmt(ast.Stmt.Let(name: held, typ: 0, value: e, mutable: false))]
                values += [self.alloc_expr(ast.Expr.Ident(name: held), span: self.expr_spans[e])]
            }
        }
        for i, part in names.parts {
            stmts += self.bind_tuple(part, value: values[i], typ: 0, :mutable)
        }
        return self.first_of(stmts)
    }

    // `let` statements that bind `names` to `value`, or what it holds.
    func bind_tuple(self, anon names: TupleNames, value: int64, typ: int64, mutable: bool) -> [int64] {
        if len(names.parts) == 0 {
            return [self.alloc_stmt(ast.Stmt.Let(name: names.name, :typ, :value, mutable: mutable and names.name != "_"))]
        }
        mut stmts = [self.alloc_stmt(ast.Stmt.Let(name: names.name, :typ, :value, mutable: false))]
        stmts += self.bind_parts(names, span: self.expr_spans[value], :mutable)
        return stmts
    }

    // The `let`s of a tuple's parts, the tuple itself being in `names.name`.
    func bind_parts(self, anon names: TupleNames, span: ast.Span, mutable: bool) -> [int64] {
        mut stmts = [self.count_parts(names.name, len(names.parts), :span)]
        for i, part in names.parts {
            if part.name != "_" {
                stmts += self.bind_tuple(part, value: self.tuple_part(names.name, i, :span), typ: 0, :mutable)
            }
        }
        return stmts
    }

    // A statement that does nothing, and is an error unless `name` is a tuple of `n`.
    func count_parts(self, anon name: str, anon n: int64, span: ast.Span) -> int64 {
        let callee = self.alloc_expr(ast.Expr.Ident(name: f"$parts{n}"), :span)
        let arg = ast.CallArg(label: "", label_span: span, value: self.alloc_expr(ast.Expr.Ident(:name), :span))
        return self.alloc_stmt(ast.Stmt.ExprStmt(expr: self.alloc_expr(ast.Expr.Call(:callee, args: [arg]), :span)))
    }

    // `name.i`
    func tuple_part(self, anon name: str, anon i: int64, span: ast.Span) -> int64 {
        let whole = self.alloc_expr(ast.Expr.Ident(:name), :span)
        return self.alloc_expr(ast.Expr.Binary(lhs: whole, op: .Dot, rhs: self.alloc_expr(ast.Expr.Ident(name: f"{i}"), :span)), :span)
    }

    func names_of(self, anon names: TupleNames) -> [str] {
        if len(names.parts) == 0 {
            return [names.name]
        }
        mut out: [str] = []
        for part in names.parts {
            out += self.names_of(part)
        }
        return out
    }

    func check_twice(self, anon names: TupleNames) -> none {
        mut seen: [str] = []
        for name in self.names_of(names) {
            if name != "_" and arrays.contains(seen, name) {
                self.record_error(f"error: `{name}` is bound twice", got: lexing.Token(kind: .Identifier, value: name, start: names.span.start, end: names.span.start + 1))
            }
            seen += [name]
        }
    }

    // Whether the tokens from `from` up to `to` have one of `names`, or text that may.
    func mentions(self, anon names: [str], from: int64, to: int64) -> bool {
        for i in from..to {
            match self.tokens[i].kind {
                .Identifier -> {
                    if arrays.contains(names, self.tokens[i].value) {
                        return true
                    }
                }
                .FStringLit -> return true
                else none
            }
        }
        return false
    }

    // `(a, b) = rhs`: the right side is worked out before any of it is stored.
    func assign_tuple(self, anon lhs: int64, anon rhs: int64, from: int64, to: int64) -> [int64] {
        let targets = self.tuple_elements(lhs)
        if len(targets) == 0 {
            if self.exprs[lhs] is .Ident(name) and name == "_" {
                return [self.alloc_stmt(ast.Stmt.Let(:name, typ: 0, value: rhs, mutable: false))]
            }
            return [self.alloc_stmt(ast.Stmt.Assign(:lhs, :rhs))]
        }
        let span = self.expr_spans[lhs]
        let hidden = f"__tuple{span.start}"
        mut stmts: [int64] = []
        mut values: [int64] = []
        let elements = self.tuple_elements(rhs)
        if len(elements) == len(targets) {
            for i, e in elements {
                if self.reads_nothing(e) {
                    values += [e]
                    continue
                }
                let held = f"{hidden}_{i}"
                stmts += [self.alloc_stmt(ast.Stmt.Let(name: held, typ: 0, value: e, mutable: false))]
                values += [self.alloc_expr(ast.Expr.Ident(name: held), span: self.expr_spans[e])]
            }
        } else {
            stmts += [self.alloc_stmt(ast.Stmt.Let(name: hidden, typ: 0, value: rhs, mutable: false)), self.count_parts(hidden, len(targets), :span)]
            for i in 0..len(targets) {
                values += [self.tuple_part(hidden, i, :span)]
            }
        }
        for i, target in targets {
            stmts += self.assign_tuple(target, values[i], from: 0, to: 0)
        }
        return stmts
    }

    // A value that stays what it is whatever is assigned, and may need to know where it
    // goes: a literal, `none`, `[]` or `.Variant`.
    func reads_nothing(self, anon expr_id: int64) -> bool {
        match self.exprs[expr_id] {
            .IntLit(_) | .StrLit(_) | .BoolLit(_) | .FloatLit(_) | .ImplicitVariant(_) | .NoneLit -> return true
            .ArrayLit(elements) -> return len(elements) == 0
            else return false
        }
    }

    // The first of some statements in the place of one; the block takes the rest after it.
    func first_of(self, anon stmts: [int64]) -> int64 {
        if len(stmts) == 0 {
            // After an error.
            return self.alloc_stmt(ast.Stmt.ExprStmt(expr: self.unreachable_value()))
        }
        self.more_stmts = stmts[1..]
        return stmts[0]
    }

    // What a statement stands for: itself, and those that come with it.
    func parse_stmts(self) -> [int64] {
        let first = self.parse_stmt()
        self.flush_value_chains()
        let all = [first] + self.more_stmts
        self.more_stmts = []
        return all
    }

    func parse_stmt(self) -> int64 {
        self.skip_newlines()

        // let declaration (with optional refutable-pattern form)
        if self.try_consume(.KwLet) {
            if self.at(.OpenParen) {
                return self.parse_let_tuple(mutable: false)
            }
            // `let .Pat(...) = expr else { ... }` — refutable destructure, as is
            // `let T(...) =`, `let Some(...) =` and `let E.V(...) =`.
            if self.at(.Dot) or (self.at(.Identifier) and (self.peek_kind_at(1) == .OpenParen or self.peek_kind_at(1) == .Dot)) {
                let pat: int64 = self.parse_pattern()
                self.expect(.Equal)
                let value: int64 = self.parse_expr()
                self.expect(.KwElse)
                mut else_body: [int64] = self.parse_block()
                return self.alloc_stmt(ast.Stmt.LetElse(pattern: pat, :value, :else_body))
            }
            mut name: str = self.binding_identifier()
            mut typ: int64 = 0
            if self.try_consume(.Colon) {
                typ = self.parse_type_expr()
            }
            self.expect(.Equal)
            let value: int64 = self.parse_expr()
            self.skip_newlines()
            return self.alloc_stmt(ast.Stmt.Let(:name, :typ, :value, mutable: false))
        }

        // mut declaration — a mutable local binding. Irrefutable only
        // (`mut .Pat` is rejected: expect_identifier errors on the `.`).
        if self.try_consume(.KwMut) {
            if self.at(.OpenParen) {
                return self.parse_let_tuple(mutable: true)
            }
            mut name: str = self.binding_identifier()
            mut typ: int64 = 0
            if self.try_consume(.Colon) {
                typ = self.parse_type_expr()
            }
            self.expect(.Equal)
            let value: int64 = self.parse_expr()
            self.skip_newlines()
            return self.alloc_stmt(ast.Stmt.Let(:name, :typ, :value, mutable: true))
        }

        // `func name(...) -> T { ... }`: a local function, `let name = func(...)`
        // whose body sees `name` too.
        if self.at(.KwFunc) and self.peek_kind_at(1) == .Identifier {
            self.advance()
            let span = self.here()
            let name = self.binding_identifier()
            if self.at(.OpenBracket) {
                self.record_error("error: a local function can't take type parameters; declare it at the module's top level", got: self.peek())
                for not self.at(.CloseBracket) and not self.structural(self.peek_kind()) {
                    self.advance()
                }
                if self.at(.CloseBracket) {
                    self.advance()
                }
            }
            let value = self.parse_func_literal(span)
            if self.exprs[value] is .FuncLit(decl_id) {
                self.func_decls[decl_id].local_func = true
                self.has_local_fns = true
            }
            self.skip_newlines()
            return self.alloc_stmt(ast.Stmt.Let(:name, typ: 0, :value, mutable: false))
        }

        // return
        if self.try_consume(.KwReturn) {
            if self.at(.EOL) or self.at(.CloseCurly) or self.at(.EOF) {
                self.skip_newlines()
                return self.alloc_stmt(ast.Stmt.Return(value: 0))
            }
            let value_tok = self.peek()
            let value: int64 = self.parse_expr()
            self.skip_newlines()
            let stmt = self.alloc_stmt(ast.Stmt.Return(:value))
            self.value_returns += [value_tok]
            self.value_return_stmts += [stmt]
            return stmt
        }

        // throw — same as `return .Err(value)` for a function declared
        // `T or Error`. Body must produce an Error-conforming value.
        if self.try_consume(.KwThrow) {
            let value: int64 = self.parse_expr()
            self.skip_newlines()
            return self.alloc_stmt(ast.Stmt.Throw(:value))
        }

        // assert — only meaningful inside a `test "..." { ... }` block,
        // but the parser treats it uniformly. We snapshot the source
        // bytes of the expression so codegen can put them in the
        // failure message (the killer feature of the keyword form).
        if self.at(.KwAssert) {
            let assert_tok: lexing.Token = self.advance()
            let span: ast.Span = ast.Span(start: assert_tok.start)
            let expr_start: int64 = self.peek().start
            let value: int64 = self.parse_expr()
            let expr_end: int64 = self.tokens[self.pos - 1].end
            let source_text: str = self.source[expr_start..expr_end]
            self.skip_newlines()
            return self.alloc_stmt(ast.Stmt.Assert(expr: value, :source_text, :span))
        }

        // `yield e` sends on the generator's channel, and ends the body once
        // no reader holds it (generator_body): `if __genw.give(e) { return }`.
        if self.at(.KwYield) {
            let yield_span = self.here()
            self.advance()
            let value = self.parse_expr()
            self.skip_newlines()
            let arg = ast.CallArg(label: "", label_span: yield_span, :value)
            let give = self.select_call_expr("__genw", method: "give", args: [arg], span: yield_span)
            let stmt = self.alloc_stmt(ast.Stmt.If(cond: give, then_body: [self.alloc_stmt(ast.Stmt.Return(value: 0))], else_body: []))
            self.yields += [stmt]
            self.yield_values += [value]
            return stmt
        }
        if self.at(.KwSelect) {
            let select_span = self.here()
            self.advance()
            return self.parse_select(select_span)
        }
        // if / else. `if expr is Pat { body }` is sugar for a one-arm
        // match-statement (with bindings from Pat scoped to body).
        if self.try_consume(.KwIf) {
            let cond: int64 = self.parse_expr()
            mut pat: int64 = -1
            mut negated = false
            mut subject: int64 = cond
            if self.exprs[cond] is .Binary(is_lhs, is_op, is_rhs) {
                match is_op {
                    .Is -> pat = self.pattern_of_expr(is_rhs)
                    .IsNot -> {
                        pat = self.pattern_of_expr(is_rhs)
                        negated = true
                    }
                    else none
                }
                subject = is_lhs
            }
            // `if a and x is .V(n) and n > 0`: the patterns go in before the
            // body, as the whole-condition one does, so their spans end here.
            let ops: [int64] = self.and_operands(cond)
            mut chained = false
            for op in ops {
                if len(ops) > 1 and (self.binds_names(op) or self.narrows_op(op)) {
                    chained = true
                }
            }
            if chained {
                let pats: [int64] = self.chain_patterns(ops, narrow: true)
                let body_from = self.pos
                let body: [int64] = self.parse_block()
                self.narrow_chain(ops, :pats, from: body_from, to: self.pos)
                // Any operand can fail, so each gets its own parse of the else
                // block: one statement per path, which the flow checks follow.
                mut elses: [[int64]] = []
                if self.try_consume(.KwElse) {
                    let else_pos = self.pos
                    let errors_before = len(self.errors)
                    let first: [int64] = self.else_block()
                    let end_pos = self.pos
                    elses += [first]
                    for len(elses) < len(ops) {
                        if len(self.errors) > errors_before {
                            elses += [first]
                        } else {
                            self.pos = else_pos
                            elses += [self.else_block()]
                        }
                    }
                    self.pos = end_pos
                }
                return self.chain_stmt(ops, :pats, from: 0, :body, :elses)
            }
            if pat >= 0 {
                // `if x is not Pat { body } else { else_body }` swaps
                // roles: the body runs when the pattern does NOT match;
                // any bindings in Pat are scoped to else_body.
                let body_from = self.pos
                mut body: [int64] = self.parse_block()
                let body_to = self.pos
                mut other: int64 = self.alloc_pattern(ast.Pattern.Wildcard)
                // An optional `else { ... }` after the `is`-form populates
                // the wildcard arm's body — pattern bindings stay scoped
                // to the matching arm. Only consume the `else` when it's
                // the very next token; eating newlines first would let us
                // swallow a separator that surrounding constructs (match
                // arms, function bodies) need.
                mut else_body: [int64] = []
                let else_from = self.pos
                if self.try_consume(.KwElse) {
                    else_body = self.else_block()
                }
                let else_to = self.pos
                // Narrowing: the block the test proves something in binds the name.
                let name = self.narrow_name(subject)
                let pat_narrows = self.narrows(pat)
                if len(name) > 0 {
                    let tests_none = self.patterns[pat] is .NonePat
                    // `x is T` narrows the body, and `x is not T` the else block.
                    if self.narrows(pat) {
                        if (not negated and not self.assigns(name, from: body_from, to: body_to)) or (negated and not self.assigns(name, from: else_from, to: else_to)) {
                            self.narrow_to(pat, :name)
                        }
                    }
                    // `x is none` narrows the else block, and `x is not none` the body.
                    if tests_none {
                        if (not negated and not self.assigns(name, from: else_from, to: else_to)) or (negated and not self.assigns(name, from: body_from, to: body_to)) {
                            other = self.alloc_pattern(ast.Pattern.SomePat(binding: name))
                        }
                    }
                }
                mut arms: [int64] = []
                if negated {
                    arms += [self.alloc_match_arm(ast.MatchArm(pattern: pat, body: else_body))]
                    arms += [self.alloc_match_arm(ast.MatchArm(pattern: other, :body))]
                } else {
                    arms += [self.alloc_match_arm(ast.MatchArm(pattern: pat, :body))]
                    arms += [self.alloc_match_arm(ast.MatchArm(pattern: other, body: else_body))]
                }
                // A guard: with no else and a body that can't fall through, the rest of
                // the block runs where the test failed, narrowed (see fold_guards).
                self.guard_call = 0
                if not self.ends_in_exit(body) {
                    self.guard_call = self.ends_in_call(body)
                }
                if len(name) > 0 and else_to == else_from and (self.ends_in_exit(body) or self.guard_call != 0) {
                    if not negated and self.patterns[pat] is .NonePat {
                        self.guard_arm = arms[1]
                        self.guard_pat = self.alloc_pattern(ast.Pattern.SomePat(binding: name))
                        self.guard_name = name
                    } else if not negated and self.patterns[pat] is .ErrPat(_e) {
                        self.guard_arm = arms[1]
                        self.guard_pat = self.alloc_pattern(ast.Pattern.OkPat(binding: name))
                        self.guard_name = name
                    } else if negated and pat_narrows {
                        self.narrow_to(pat, :name)
                        self.guard_arm = arms[0]
                        self.guard_pat = pat
                        self.guard_name = name
                    }
                }
                return self.alloc_stmt(ast.Stmt.MatchStmt(:subject, :arms))
            }
            let then_body: [int64] = self.parse_block()
            mut else_body: [int64] = []
            self.skip_newlines()
            if self.try_consume(.KwElse) {
                if self.at(.KwIf) {
                    else_body += [self.parse_stmt()]
                } else {
                    else_body = self.parse_block()
                }
            }
            return self.alloc_stmt(ast.Stmt.If(:cond, :then_body, :else_body))
        }

        // for (with foreach detection)
        if self.try_consume(.KwFor) {
            self.skip_newlines()
            let first_len = self.for_names_len(0)
            mut second_len = 0
            if first_len > 0 and self.peek_kind_at(first_len) == .Comma {
                second_len = self.for_names_len(first_len + 1)
            }
            if second_len > 0 and self.peek_kind_at(first_len + 1 + second_len) == .KwIn {
                let index = self.parse_for_names()
                self.expect(.Comma)
                let name = self.parse_for_names()
                self.expect(.KwIn)
                let iter: int64 = self.parse_expr()
                if self.at(.DotDot) or self.at(.DotDotEq) {
                    self.record_error("error: `for i, x in` numbers an array; a range is already numbers, so write `for x in a..b`", got: self.peek())
                    self.parse_range_tail()
                }
                let span = self.expr_spans[iter]
                let body = self.bind_for(index, :span) + self.bind_for(name, :span) + self.parse_loop_block()
                return self.for_numbered(index.name, name: name.name, :iter, :body)
            }
            if first_len > 0 and self.peek_kind_at(first_len) == .KwIn {
                let names = self.parse_for_names()
                let name = names.name
                self.expect(.KwIn)
                let iter: int64 = self.parse_expr()
                if self.at(.DotDot) or self.at(.DotDotEq) {
                    let range = self.parse_range_tail()
                    let body: [int64] = self.parse_loop_block()
                    return self.for_range(name, start: iter, :range, :body)
                }
                let body = self.bind_for(names, span: self.expr_spans[iter]) + self.parse_loop_block()
                return self.alloc_stmt(ast.Stmt.ForEach(:name, :iter, :body))
            }
            let cond: int64 = self.parse_expr()
            let ops: [int64] = self.and_operands(cond)
            let pats: [int64] = self.chain_patterns(ops)
            mut body: [int64] = self.parse_loop_block()
            if self.any_pattern(pats) {
                // `for true { if cond { body } else { break } }`: `continue`
                // tests the condition again, and `break` is the loop's own.
                mut elses: [[int64]] = []
                for _op in ops {
                    elses += [[self.alloc_stmt(ast.Stmt.Break)]]
                }
                let always: int64 = self.alloc_expr(ast.Expr.BoolLit(value: true), span: self.expr_spans[cond])
                return self.alloc_stmt(ast.Stmt.For(cond: always, body: [self.chain_stmt(ops, :pats, from: 0, :body, :elses)]))
            }
            return self.alloc_stmt(ast.Stmt.For(:cond, :body))
        }

        // break / continue
        if (self.at(.KwBreak) or self.at(.KwContinue)) and self.loops == 0 {
            self.record_error(f"error: {self.peek_kind().name()} is only for the body of a `for` loop", got: self.peek())
            self.advance()
            self.skip_newlines()
            return self.alloc_stmt(ast.Stmt.ExprStmt(expr: self.unreachable_value()))
        }
        if self.try_consume(.KwBreak) {
            let stmt = self.alloc_stmt(ast.Stmt.Break)
            self.jump_label(stmt, what: "break")
            self.skip_newlines()
            return stmt
        }
        if self.try_consume(.KwContinue) {
            let stmt = self.alloc_stmt(ast.Stmt.Continue)
            self.jump_label(stmt, what: "continue")
            self.skip_newlines()
            return stmt
        }
        // `name: for ...`: a labelled loop.
        if self.at(.Identifier) and self.peek_kind_at(1) == .Colon and self.peek_kind_at(2) == .KwFor {
            let label_tok = self.advance()
            self.advance()
            if arrays.contains(self.open_labels, label_tok.value) {
                self.record_error(f"error: a loop around this one is already labelled `{label_tok.value}`; give this one another name", got: label_tok)
            }
            self.pending_label = label_tok.value
            let stmt = self.parse_stmt()
            self.pending_label = ""
            let loop_id = self.loop_of(stmt)
            if loop_id >= 0 {
                self.loop_labels[loop_id] = label_tok.value
            }
            return stmt
        }

        // match statement
        if self.try_consume(.KwMatch) {
            let subject: int64 = self.parse_expr()
            self.expect(.OpenCurly)
            self.skip_newlines()
            mut arms: [int64] = []
            for self.peek_kind() != .CloseCurly and self.peek_kind() != .EOF {
                self.skip_newlines()
                if self.peek_kind() == .CloseCurly {
                    break
                }
                self.quiet = false
                let pats: [int64] = self.parse_match_arm_patterns()
                if self.arm_broken {
                    self.skip_newlines()
                    continue
                }
                let guarded = self.arm_guarded
                let body_pos = self.pos
                let errors_before = len(self.errors)
                for pat in pats {
                    self.pos = body_pos
                    arms += [self.parse_match_stmt_arm(pat, :guarded)]
                    if len(self.errors) > errors_before {
                        break
                    }
                }
                self.end_arm_line(errors_before)
                self.skip_newlines()
            }
            self.expect(.CloseCurly)
            return self.alloc_stmt(ast.Stmt.MatchStmt(:subject, :arms))
        }

        // Expression, assignment, or +=
        let expr: int64 = self.parse_expr()
        if self.try_consume(.Equal) {
            let from = self.pos
            let rhs: int64 = self.parse_expr()
            let to = self.pos
            self.skip_newlines()
            if len(self.tuple_elements(expr)) > 0 {
                return self.first_of(self.assign_tuple(expr, rhs, :from, :to))
            }
            return self.alloc_stmt(ast.Stmt.Assign(lhs: expr, :rhs))
        }
        if self.try_consume(.PlusEqual) {
            let rhs: int64 = self.parse_expr()
            self.skip_newlines()
            return self.alloc_stmt(ast.Stmt.PlusAssign(lhs: expr, :rhs))
        }
        if update_op(self.peek_kind()) is Some(op) {
            self.advance()
            let rhs: int64 = self.parse_expr()
            self.skip_newlines()
            return self.alloc_stmt(ast.Stmt.OpAssign(lhs: expr, :rhs, :op))
        }
        self.skip_newlines()
        return self.alloc_stmt(ast.Stmt.ExprStmt(:expr))
    }

    // The `//` lines right above the token at `at`, each on its own line,
    // joined as consume_doc_comments joins them: the doc of a member of a
    // type, whose comments the body's loops skip as they go.
    func doc_above(self, anon at: int64) -> str {
        mut lines: [str] = []
        mut i = at - 1
        for i >= 1 and self.tokens[i].kind is .EOL and self.tokens[i - 1].kind is .Comment and (i < 2 or self.tokens[i - 2].kind is .EOL) {
            lines = [strip_comment_marker(self.tokens[i - 1].value)] + lines
            i -= 2
        }
        mut s = ""
        for j, line in lines {
            if j > 0 {
                s += "\n"
            }
            s += line
        }
        return s
    }

    func parse_func_decl(self, doc: str, is_method: bool = false) -> ast.FuncDecl {
        if is_method and len(doc) == 0 {
            let above = self.doc_above(self.pos)
            if len(above) > 0 {
                return self.parse_func_decl(doc: above, is_method: true)
            }
        }
        self.expect(.KwFunc)
        let name_span: ast.Span = self.here()
        mut name: str = self.expect_identifier()
        let bracket = self.peek()
        let type_params = self.parse_func_type_params()
        if is_method and len(type_params) > 0 {
            self.record_error("error: a method can't declare its own type parameters; put them on the struct", got: bracket)
        }
        mut params: [ast.Param] = self.parse_param_list()
        mut return_typ: int64 = 0
        let ret_start = self.pos + 1
        if self.try_consume(.Arrow) {
            return_typ = self.parse_type_expr()
        }
        let ret_end = self.pos
        let binding_mark = self.binding_exprs
        let outer = self.enter_function()
        let outer_generic = self.in_generic
        if len(type_params) > 0 {
            self.in_generic = true
        }
        mut body: [int64] = self.parse_block()
        if len(self.yields) > 0 {
            body = self.generator_body(body, :return_typ, :ret_start, :ret_end, :name_span)
        }
        self.in_generic = outer_generic
        self.leave_function(outer)
        return ast.FuncDecl(:name, :name_span, :params, :return_typ, :body, :doc, expr_binds: self.binding_exprs > binding_mark, :type_params)
    }

    // Starts a function's body: the outer one's yields and returns, for
    // leave_function.
    func enter_function(self) -> SavedFunction {
        let outer = SavedFunction(yields: self.yields, yield_values: self.yield_values, value_returns: self.value_returns, value_return_stmts: self.value_return_stmts, loops: self.loops, labels: self.open_labels)
        self.loops = 0
        self.open_labels = []
        self.pending_label = ""
        self.yields = []
        self.yield_values = []
        self.value_returns = []
        self.value_return_stmts = []
        return outer
    }

    func leave_function(self, anon outer: SavedFunction) -> none {
        self.flush_value_chains()
        self.yields = outer.yields
        self.yield_values = outer.yield_values
        self.value_returns = outer.value_returns
        self.value_return_stmts = outer.value_return_stmts
        self.loops = outer.loops
        self.open_labels = outer.labels
    }

    // `break name` or `continue name`: the loop it names, which must be around it.
    func jump_label(self, anon stmt: int64, what: str) -> none {
        if not self.at(.Identifier) {
            return
        }
        let tok = self.advance()
        if not arrays.contains(self.open_labels, tok.value) {
            self.record_error(f"error: no loop labelled `{tok.value}` around this `{what}`", got: tok)
            return
        }
        self.jump_labels[stmt] = tok.value
    }

    // The loop statement a `for` parsed into: itself, or the last statement of
    // the hidden block around it (for_range, for_numbered).
    func loop_of(self, anon stmt: int64) -> int64 {
        match self.stmts[stmt] {
            .For(_c, _b) -> return stmt
            .ForEach(_n, _i, _b) -> return stmt
            .If(_c, then_body, _e) -> {
                if len(then_body) == 0 {
                    return -1
                }
                return self.loop_of(then_body[-1])
            }
            else return -1
        }
    }

    // The block a `for` runs.
    func parse_loop_block(self) -> [int64] {
        self.loops += 1
        self.open_labels += [self.pending_label]
        self.pending_label = ""
        let body = self.parse_block()
        self.open_labels = self.open_labels[..-1]
        self.loops -= 1
        return body
    }

    // After an error, each `yield` just evaluates its value, so that it reports
    // no other.
    func drop_yields(self) -> none {
        for k, stmt in self.yields {
            self.stmts[stmt] = ast.Stmt.ExprStmt(expr: self.yield_values[k])
        }
    }

    // A function with `yield` (docs/tasks.md#generators) makes its channel, runs
    // its body as a task that each `yield` sends on, and gives the channel back:
    //
    //     let __gen = <return type>()
    //     let __genw = #spawn.gen_ref(__gen)
    //     return #spawn.generate(__gen, __genw, func() { <body> })
    //
    // The body holds the channel only through `__genw`, weakly, so it ends once
    // no reader holds the channel.
    // The constructor is parsed again from the return type's tokens, which must
    // name a `Channel[T]`.
    func generator_body(self, anon body: [int64], return_typ: int64, ret_start: int64, ret_end: int64, name_span: ast.Span) -> [int64] {
        mut names_channel = false
        mut i = ret_start
        for i + 1 < ret_end {
            if self.tokens[i].kind is .Identifier and self.tokens[i].value == "Channel" and self.tokens[i + 1].kind is .OpenBracket {
                names_channel = true
            }
            i += 1
        }
        if return_typ == 0 or not names_channel {
            self.record_error("error: a function with `yield` gives back a `tasks.Channel[T]`, which the values are sent on", got: self.tokens[ret_start - 1])
            self.drop_yields()
            return body
        }
        for k, tok in self.value_returns {
            self.record_error("error: a function with `yield` ends with a `return` that takes no value", got: tok)
            self.stmts[self.value_return_stmts[k]] = ast.Stmt.Return(value: 0)
        }
        let span = name_span
        let back = self.pos
        self.pos = ret_start
        let channel_type = self.parse_postfix(self.parse_primary())
        self.pos = back
        let no_args: [ast.CallArg] = []
        let ctor = self.alloc_expr(ast.Expr.Call(callee: channel_type, args: no_args), :span)
        let make = self.alloc_stmt(ast.Stmt.Let(name: "__gen", typ: 0, value: ctor, mutable: false))
        let gen_arg = ast.CallArg(label: "", label_span: span, value: self.alloc_expr(ast.Expr.Ident(name: "__gen"), :span))
        let weak_ref = self.alloc_stmt(ast.Stmt.Let(name: "__genw", typ: 0, value: self.spawn_member_call("gen_ref", recv: "", args: [gen_arg], :span), mutable: false))
        let no_params: [ast.Param] = []
        let decl_id = self.alloc_func_decl(ast.FuncDecl(name: "", name_span: span, params: no_params, return_typ: 0, :body, doc: "", in_generic: self.in_generic))
        self.binding_exprs += 1
        let lit = self.alloc_expr(ast.Expr.FuncLit(:decl_id), :span)
        let gen = self.alloc_expr(ast.Expr.Ident(name: "__gen"), :span)
        let genw = self.alloc_expr(ast.Expr.Ident(name: "__genw"), :span)
        let args = [
            ast.CallArg(label: "", label_span: span, value: gen),
            ast.CallArg(label: "", label_span: span, value: genw),
            ast.CallArg(label: "", label_span: span, value: lit),
        ]
        self.spawns += 1
        let ret = self.alloc_stmt(ast.Stmt.Return(value: self.spawn_member_call("generate", recv: "", :args, :span)))
        return [make, weak_ref, ret]
    }

    func parse_func_type_params(self) -> [str] {
        mut type_params: [str] = []
        if not self.try_consume(.OpenBracket) {
            return type_params
        }
        for true {
            let tok = self.peek()
            let param = self.expect_identifier()
            for seen in type_params {
                if seen == param {
                    self.record_error(f"error: type parameter `{param}` is declared twice", got: tok)
                }
            }
            type_params += [param]
            if not self.try_consume(.Comma) or self.peek_kind() == .CloseBracket or self.peek_kind() == .EOF {
                break
            }
        }
        self.expect(.CloseBracket)
        return type_params
    }

    // Interface method: a signature `func name(params) -> ret`, or with a
    // `{ body }` a provided method.
    func parse_func_sig(self, doc: str) -> ast.FuncDecl {
        if len(doc) == 0 {
            let above = self.doc_above(self.pos)
            if len(above) > 0 {
                return self.parse_func_sig(doc: above)
            }
        }
        self.expect(.KwFunc)
        let name_span: ast.Span = self.here()
        mut name: str = self.expect_identifier()
        mut params: [ast.Param] = self.parse_param_list()
        mut return_typ: int64 = 0
        if self.try_consume(.Arrow) {
            return_typ = self.parse_type_expr()
        }
        if self.at(.OpenCurly) {
            let binding_mark = self.binding_exprs
            let body = self.parse_block()
            return ast.FuncDecl(:name, :name_span, :params, :return_typ, :body, :doc, expr_binds: self.binding_exprs > binding_mark, provided: true)
        }
        mut body: [int64] = []
        return ast.FuncDecl(:name, :name_span, :params, :return_typ, :body, :doc)
    }

    func parse_struct_fields(self) -> [ast.StructField] {
        mut fields: [ast.StructField] = []
        for self.peek_kind() != .CloseCurly and self.peek_kind() != .KwFunc and self.peek_kind() != .EOF {
            self.skip_newlines()
            if self.peek_kind() == .CloseCurly or self.peek_kind() == .KwFunc {
                break
            }
            self.quiet = false
            let start = self.pos
            // `weak` is a word only here, before a field's name.
            mut weak = false
            if self.at(.Identifier) and self.peek().value == "weak" and self.peek_kind_at(1) == .Identifier {
                self.advance()
                weak = true
            }
            let name_span = self.here()
            mut name: str = self.expect_identifier()
            // A type right after the name: the `:` is taken as written.
            if not self.try_consume(.Colon) {
                self.record_unexpected(expected: lexing.TokenKind.Colon.name(), got: self.peek())
                if not self.at(.Identifier) {
                    self.skip_rest_of_stmt(depth: 0)
                    if self.pos == start {
                        self.advance()
                    }
                    self.skip_newlines()
                    continue
                }
            }
            mut typ: int64 = self.parse_type_expr()
            mut default_expr: int64 = 0
            if self.try_consume(.Equal) {
                default_expr = self.parse_expr()
            }
            fields += [ast.StructField(:name, :typ, :default_expr, :name_span, :weak)]
            if not self.at(.EOL) and not self.at(.Comment) and not self.at(.CloseCurly) and not self.at(.KwFunc) {
                self.record_error(f"error: expected the end of the line after field `{name}`, got {self.peek_kind().name()}", got: self.peek(), desync: true)
                self.skip_rest_of_stmt(depth: 0)
            }
            if self.pos == start {
                self.advance()
            }
            self.skip_newlines()
        }
        return fields
    }

    func parse_enum_variants(self) -> [ast.EnumVariant] {
        mut variants: [ast.EnumVariant] = []
        mut comma_seen = false
        for self.peek_kind() != .CloseCurly and self.peek_kind() != .KwFunc and self.peek_kind() != .EOF {
            self.skip_newlines()
            if self.peek_kind() == .CloseCurly or self.peek_kind() == .KwFunc {
                break
            }
            self.quiet = false
            let start = self.pos
            let desyncs_before = self.desyncs
            let name_span = self.here()
            mut name: str = self.expect_identifier()
            mut fields: [ast.Param] = []
            if self.try_consume(.OpenParen) {
                self.skip_newlines()
                for self.peek_kind() != .CloseParen and self.peek_kind() != .EOF {
                    let errors_before: int64 = len(self.errors)
                    fields += [self.parse_param()]
                    if len(self.errors) > errors_before {
                        break
                    }
                    self.skip_newlines()
                    if not self.try_consume(.Comma) {
                        break
                    }
                    self.skip_newlines()
                }
                self.expect(.CloseParen)
            }
            variants += [ast.EnumVariant(:name, :fields, :name_span)]
            // The variants still read as written: the first `,` is reported.
            if self.at(.Comma) {
                if not comma_seen {
                    self.record_error("error: enum variants are separated by spaces or line breaks, not `,`", got: self.peek())
                    comma_seen = true
                }
                self.advance()
            }
            // After an error the rest of the line is likely more of it.
            if self.desyncs > desyncs_before {
                self.skip_rest_of_stmt(depth: 0)
            }
            if self.pos == start {
                self.advance()
            }
            self.skip_newlines()
        }
        return variants
    }

    func parse_decl(self, doc: str) -> ast.Decl {
        self.skip_newlines()

        // import "path" or import "path" { Name1, Name2, ... }
        if self.try_consume(.KwImport) {
            let tok: lexing.Token = self.advance()
            let raw: str = tok.value
            let module_name: str = raw[1..len(raw) - 1]
            // local name = last path component
            mut local_name: str = module_name
            mut i: int64 = len(module_name) - 1
            for i >= 0 {
                if module_name[i] == '/' {
                    local_name = module_name[i + 1..len(module_name)]
                    i = -1
                } else {
                    i = i - 1
                }
            }
            mut items: [str] = []
            if self.try_consume(.OpenCurly) {
                for self.peek_kind() != .CloseCurly and self.peek_kind() != .EOF {
                    items += [self.expect_identifier()]
                    if not self.try_consume(.Comma) {
                        break
                    }
                }
                self.expect(.CloseCurly)
            }
            // An import that lists names binds no alias; `#` keeps source from naming it.
            if len(items) > 0 {
                local_name = "#" + local_name
            }
            self.skip_newlines()
            return ast.Decl.Import(:module_name, :local_name, :items)
        }

        // extern func, or extern let for a C variable
        if self.try_consume(.KwExtern) {
            if self.try_consume(.KwLet) {
                let var_span: ast.Span = self.here()
                let var_name: str = self.expect_identifier()
                self.expect(.Colon)
                let typ: int64 = self.parse_type_expr()
                let zero: int64 = self.alloc_expr(ast.Expr.IntLit(value: 0), span: var_span)
                let ret: int64 = self.alloc_stmt(ast.Stmt.Return(value: zero))
                let no_params: [ast.Param] = []
                let id: int64 = self.alloc_func_decl(ast.FuncDecl(name: var_name, name_span: var_span, params: no_params, return_typ: typ, body: [ret], :doc, is_const: true, extern_symbol: var_name))
                self.skip_newlines()
                return ast.Decl.Func(decl: id)
            }
            self.expect(.KwFunc)
            let name_span: ast.Span = self.here()
            mut name: str = self.expect_identifier()
            mut params: [ast.Param] = self.parse_param_list(allow_variadic: true)
            let variadic = self.params_variadic
            mut return_typ: int64 = 0
            if self.try_consume(.Arrow) {
                return_typ = self.parse_type_expr()
            }
            self.skip_newlines()
            return ast.Decl.Extern(:name, :name_span, :params, :return_typ, :variadic)
        }

        // func
        if self.at(.KwFunc) {
            let func_decl: ast.FuncDecl = self.parse_func_decl(:doc)
            mut id: int64 = self.alloc_func_decl(func_decl)
            self.skip_newlines()
            return ast.Decl.Func(decl: id)
        }

        // interface Name { method signatures }
        if self.try_consume(.KwInterface) {
            let name_span: ast.Span = self.here()
            mut name: str = self.expect_identifier()
            self.expect(.OpenCurly)
            self.skip_newlines()
            mut methods: [int64] = []
            for self.at(.KwFunc) {
                let module: ast.FuncDecl = self.parse_func_sig(doc: "")
                methods += [self.alloc_func_decl(module)]
                self.skip_newlines()
            }
            self.expect(.CloseCurly)
            self.skip_newlines()
            return ast.Decl.Interface(:name, :name_span, :methods)
        }

        // test "description" { ... } — a unit test. The body is stashed
        // inside a synthesized FuncDecl with placeholder name "test"; the
        // codegen picks a unique label per test in the module.
        if self.try_consume(.KwTest) {
            let tok: lexing.Token = self.advance()
            let raw: str = tok.value
            let display: str = parse_string_value(raw)
            let binding_mark = self.binding_exprs
            mut body: [int64] = self.parse_block()
            let empty_params: [ast.Param] = []
            let func_decl: ast.FuncDecl = ast.FuncDecl(name: "test", name_span: ast.Span(start: tok.start), params: empty_params, return_typ: 0, :body, doc: "", expr_binds: self.binding_exprs > binding_mark)
            mut id: int64 = self.alloc_func_decl(func_decl)
            self.skip_newlines()
            return ast.Decl.Test(:display, decl: id)
        }

        // type Name = shared struct { } or enum { }
        if self.try_consume(.KwType) {
            let name_span: ast.Span = self.here()
            mut name: str = self.expect_identifier()
            // Optional generic params: type Name[A, B, ...] = ...
            // Preserve names so the codegen can monomorphise generic
            // structs per concrete instantiation.
            mut type_params: [str] = []
            if self.try_consume(.OpenBracket) {
                for self.peek_kind() != .CloseBracket and self.peek_kind() != .EOF {
                    type_params += [self.expect_identifier()]
                    if not self.try_consume(.Comma) {
                        break
                    }
                }
                self.expect(.CloseBracket)
            }
            self.expect(.Equal)
            // `shared struct`: `shared` is a word only here.
            mut shared = false
            if self.at(.Identifier) and self.peek().value == "shared" and self.peek_kind_at(1) == .KwStruct {
                self.advance()
                shared = true
            }
            if self.try_consume(.KwStruct) {
                self.expect(.OpenCurly)
                self.skip_newlines()
                mut fields: [ast.StructField] = self.parse_struct_fields()
                if name.starts_with("_Tuple") and self.path.ends_with("stdlib/builtins.kod") {
                    // `e0` is the element `p.0` names, which no field can be declared as.
                    for i, f in fields {
                        f.name = f"{i}"
                    }
                }
                mut methods: [int64] = []
                self.in_generic = len(type_params) > 0
                for self.at(.KwFunc) {
                    let module: ast.FuncDecl = self.parse_func_decl(doc: "", is_method: true)
                    methods += [self.alloc_func_decl(module)]
                    self.skip_newlines()
                }
                self.in_generic = false
                self.expect(.CloseCurly)
                self.skip_newlines()
                return ast.Decl.Struct(:name, :name_span, :type_params, :fields, :methods, :shared)
            }
            if self.try_consume(.KwEnum) {
                self.expect(.OpenCurly)
                self.skip_newlines()
                mut variants: [ast.EnumVariant] = self.parse_enum_variants()
                mut methods: [int64] = []
                self.in_generic = len(type_params) > 0
                for self.at(.KwFunc) {
                    let method: ast.FuncDecl = self.parse_func_decl(doc: "", is_method: true)
                    methods += [self.alloc_func_decl(method)]
                    self.skip_newlines()
                }
                self.in_generic = false
                self.expect(.CloseCurly)
                self.skip_newlines()
                return ast.Decl.Enum(:name, :name_span, :type_params, :variants, :methods)
            }
            // Type alias: type X = SomeOtherType
            let target: int64 = self.parse_type_expr()
            self.skip_newlines()
            return ast.Decl.TypeAlias(:name, :target, :name_span)
        }

        if self.at(.KwLet) {
            return self.parse_const_decl(:doc)
        }
        if self.at(.KwMut) {
            return self.parse_var_decl(:doc)
        }

        let tok = self.advance()
        self.record_error(f"error: expected a declaration (`func`, `type`, `interface`, `import`, `extern` or `test`), got {tok.kind.name()}", got: tok, desync: true)
        // Stray words before a declaration (`pub func f`) keep the declaration.
        if tok.kind == .Identifier {
            for self.at(.Identifier) {
                self.advance()
            }
        }
        if self.at(.KwFunc) or self.at(.KwType) or self.at(.KwInterface) or self.at(.KwExtern) or self.at(.KwImport) or self.at(.KwTest) {
            return self.parse_decl(:doc)
        }
        mut open = 0
        if tok.kind == .OpenCurly {
            open = 1
        }
        self.skip_rest_of_stmt(depth: open)
        if self.at(.CloseCurly) {
            self.advance()
        }
        self.skip_newlines()
        // The bad line's block may start on the next line.
        if self.at(.OpenCurly) {
            self.advance()
            self.skip_rest_of_stmt(depth: 1)
            self.skip_newlines()
        }
        return ast.Decl.Import(module_name: "", local_name: "", items: [])
    }

    // `let NAME: T = value` at the top level of a module. It becomes a function with no
    // parameters that returns `value`, flagged as a constant: a use of the name is a call to it.
    func parse_const_decl(self, doc: str) -> ast.Decl {
        self.advance()
        let name_span: ast.Span = self.here()
        let name: str = self.expect_identifier()
        if not self.at(.Colon) {
            self.record_error("error: a module-level constant needs a type: `let NAME: T = ...`", got: self.peek())
            for not self.at(.EOL) and not self.at(.EOF) {
                self.advance()
            }
            return ast.Decl.Import(module_name: "", local_name: "", items: [])
        }
        self.advance()
        let typ: int64 = self.parse_type_expr()
        self.expect(.Equal)
        let value: int64 = self.parse_expr()
        self.check_const_expr(value)
        let ret: int64 = self.alloc_stmt(ast.Stmt.Return(:value))
        let no_params: [ast.Param] = []
        let func_decl: ast.FuncDecl = ast.FuncDecl(:name, :name_span, params: no_params, return_typ: typ, body: [ret], :doc, is_const: true)
        let id: int64 = self.alloc_func_decl(func_decl)
        self.const_names += [name]
        self.const_exprs += [value]
        self.const_spans += [name_span]
        self.skip_newlines()
        return ast.Decl.Func(decl: id)
    }

    // `mut NAME: T = value` at the top level of a module. It becomes a function with no
    // parameters that returns `value`, flagged as a variable: codegen compiles it as the
    // initializer behind a getter, and a use of the name is a call to the getter.
    func parse_var_decl(self, doc: str) -> ast.Decl {
        self.advance()
        let name_span: ast.Span = self.here()
        let name: str = self.expect_identifier()
        if not self.at(.Colon) {
            self.record_error("error: a module-level variable needs a type: `mut NAME: T = ...`", got: self.peek())
            for not self.at(.EOL) and not self.at(.EOF) {
                self.advance()
            }
            return ast.Decl.Import(module_name: "", local_name: "", items: [])
        }
        self.advance()
        let typ: int64 = self.parse_type_expr()
        self.expect(.Equal)
        let binding_mark = self.binding_exprs
        let value: int64 = self.parse_expr()
        let ret: int64 = self.alloc_stmt(ast.Stmt.Return(:value))
        let no_params: [ast.Param] = []
        let func_decl: ast.FuncDecl = ast.FuncDecl(:name, :name_span, params: no_params, return_typ: typ, body: [ret], :doc, expr_binds: self.binding_exprs > binding_mark, is_const: true, is_var: true)
        let id: int64 = self.alloc_func_decl(func_decl)
        self.skip_newlines()
        return ast.Decl.Func(decl: id)
    }

    // A constant's value may hold only literals, operators, array literals, enum variants
    // and names; reports the first thing that is not one of those.
    func check_const_expr(self, anon id: int64) -> none {
        if not self.const_expr_ok(id) {
            return none
        }
    }

    // Whether `id` is a constant expression; reports the first part that is not.
    func const_expr_ok(self, anon id: int64) -> bool {
        match self.exprs[id] {
            .IntLit(_v) -> return true
            .FloatLit(_v) -> return true
            .StrLit(_v) -> return true
            .BytesLit(_v) -> return true
            .BoolLit(_v) -> return true
            .Ident(_n) -> return true
            .ImplicitVariant(_n) -> return true
            .Binary(lhs, op, rhs) -> {
                if op is .Index {
                    return self.const_not_allowed(id)
                }
                if op is .Dot {
                    // `Enum.Variant` or `module.NAME`: two plain names.
                    if self.exprs[lhs] is .Ident(_a) and self.exprs[rhs] is .Ident(_b) {
                        return true
                    }
                    return self.const_not_allowed(id)
                }
                if not self.const_expr_ok(lhs) {
                    return false
                }
                return self.const_expr_ok(rhs)
            }
            .Chain(parts, _ops) -> {
                for part in parts {
                    if not self.const_expr_ok(part) {
                        return false
                    }
                }
                return true
            }
            .ArrayLit(elements) -> {
                for element in elements {
                    if not self.const_expr_ok(element) {
                        return false
                    }
                }
                return true
            }
            else return self.const_not_allowed(id)
        }
    }

    func const_not_allowed(self, anon id: int64) -> bool {
        let at: lexing.Token = lexing.Token(kind: .Identifier, value: "", start: self.expr_spans[id].start, end: self.expr_spans[id].start + 1)
        self.record_error("error: this can't be part of a module-level constant; use literals, operators, other constants and enum variants", got: at)
        return false
    }

    // The names `id` uses, appended to `into`.
    func const_names_in(self, anon id: int64, into: [str]) -> [str] {
        mut out: [str] = into
        match self.exprs[id] {
            .Ident(n) -> out += [n]
            .Binary(lhs, _op, rhs) -> {
                out = self.const_names_in(lhs, into: out)
                out = self.const_names_in(rhs, into: out)
            }
            .Chain(parts, _ops) -> {
                for part in parts {
                    out = self.const_names_in(part, into: out)
                }
            }
            .ArrayLit(elements) -> {
                for element in elements {
                    out = self.const_names_in(element, into: out)
                }
            }
            else none
        }
        return out
    }

    // Whether the constant at `start` can reach `target` through the constants it names.
    func const_reaches(self, anon start: int64, target: int64, depth: int64) -> bool {
        if depth > len(self.const_names) {
            return false
        }
        let none_yet: [str] = []
        for name in self.const_names_in(self.const_exprs[start], into: none_yet) {
            for k, const_name in self.const_names {
                if const_name == name {
                    if k == target {
                        return true
                    }
                    if self.const_reaches(k, :target, depth: depth + 1) {
                        return true
                    }
                }
            }
        }
        return false
    }

    func check_const_cycles(self) -> none {
        for i, const_name in self.const_names {
            if self.const_reaches(i, target: i, depth: 0) {
                let at: lexing.Token = lexing.Token(kind: .Identifier, value: "", start: self.const_spans[i].start, end: self.const_spans[i].start + len(const_name))
                self.record_error(f"error: constant `{const_name}` refers to itself", got: at)
            }
        }
    }

    func parse_module(self) -> ast.Module {
        mut decls: [ast.Decl] = []
        for self.peek_kind() != .EOF {
            // Eat blank lines, then collect any contiguous `//` doc
            // comments immediately above the next decl. A blank line
            // between comments and the decl breaks the association.
            for self.at(.EOL) {
                self.advance()
            }
            if self.peek_kind() == .EOF {
                break
            }
            let doc: str = self.consume_doc_comments()
            if self.peek_kind() == .EOF {
                break
            }
            let errors_before = len(self.errors)
            let desyncs_before = self.desyncs
            self.quiet = false
            let start = self.pos
            let decl_start = self.peek().start
            if self.decl_col < 0 {
                self.decl_col = self.column()
            }
            decls += [self.parse_decl(:doc)]
            self.expect_stmt_end(stmt_id: -1, :errors_before)
            if self.pos == start {
                self.advance()
            }
            if self.desyncs > desyncs_before {
                // What follows up to the next line in the declarations' column
                // is likely the rest of this one (a `}` too many ended it
                // early): skip it quietly, and the `}` that ended it.
                for not self.at(.EOF) and not self.at_decl_start() {
                    self.advance()
                }
                self.broken_starts += [decl_start]
                self.broken_ends += [self.tokens[self.pos - 1].end]
            }
        }
        self.quiet = false
        self.parsed = true
        self.check_const_cycles()
        let renamer = Renamer(p: self)
        renamer.run(decls)
        // The errors reported while quiet are left out.
        mut kept: [ParseError] = []
        for i, e in self.errors {
            if i >= len(self.error_quiet) or not self.error_quiet[i] {
                kept += [e]
            }
        }
        self.errors = kept
        // `spawn` starts its tasks through `tasks`, imported under a name no source
        // can write (parse_spawn).
        if self.spawns > 0 {
            let no_items: [str] = []
            decls = [ast.Decl.Import(module_name: "tasks", local_name: "#spawn", items: no_items)] + decls
        }
        return ast.Module(:decls)
    }

    // Consume any contiguous `//` comments immediately before the next
    // non-comment token. Returns the joined doc text with the `//` and
    // one trailing space stripped from each line; "" when no comments
    // precede the decl, or when a blank line separates them from it.
    func consume_doc_comments(self) -> str {
        mut lines: [str] = []
        for self.at(.Comment) {
            let tok: lexing.Token = self.advance()
            lines += [strip_comment_marker(tok.value)]
            // Allow exactly one EOL between comments (the natural line
            // break). A second EOL is a blank line — the comments
            // stop being docs for what follows.
            if not self.at(.EOL) {
                break
            }
            self.advance()
            if self.at(.EOL) {
                // Blank line — discard collected and start over so any
                // later comment block can still attach as docs.
                lines = []
                for self.at(.EOL) {
                    self.advance()
                }
            }
        }
        if len(lines) == 0 {
            return ""
        }
        mut s: str = ""
        for i, line in lines {
            if i > 0 {
                s = s + "\n"
            }
            s = s + line
        }
        return s
    }
}

// Strip a leading `//` and one trailing space from a comment token's
// raw value. The lexer already skipped the indentation up to `//`,
// so the value starts with the slashes themselves.
func strip_comment_marker(anon raw: str) -> str {
    let n: int64 = len(raw)
    if n < 2 or raw[0..2] != "//" {
        return raw
    }
    mut s: int64 = 2
    if s < n and raw[s] == ' ' {
        s = s + 1
    }
    return raw[s..n]
}

// The rhs of `.` is a member name and the rhs of `is` a type or pattern, not a read.
func reads_operand_rhs(anon op: ast.Op) -> bool {
    match op {
        .Dot -> return false
        .Is -> return false
        .IsNot -> return false
        else return true
    }
}

// Gives a binding that hides one still in force a name of its own, `x#k`
// with k the number of bindings of `x` it hides, and renames the reads and
// stores that reach it, so codegen keeps one slot per name. A binding again
// at the same depth keeps the name in force, so sibling blocks share `x#1`.
// The depths:
//   parameters, `self`        1, like the function's top block
//   if/else/loop body         parent + 1 (an `else if` is one more)
//   `for x in xs` variable    the body's depth, bound after `xs`
//   match arm, `if … is`      the arm body's depth, bound after the subject
//   match-expression arm      parent + 1
//   let-else                  this depth, bound after its else block
//   `let` / `mut`             this depth, bound after its value
//   function literal          parent + 1 for its parameters and body
// A default sees no locals. A read of a binding older than a function literal
// is one it captures, which goes on the FuncDecl of every literal it's inside.
// A `mut` that a literal captures is shared: once the function is walked,
// `mut n = v` becomes `let n = _mut_cell(v)` (`_mut_cell[$t<type id>](v)` with a type)
// and each read and store of `n` becomes `n.value`, so both use one cell.
type Renamer = shared struct {
    p: Parser
    // The bindings in force, innermost last; `top` of them are live.
    names: [str] = []
    keys: [str] = []
    depths: [int64] = []
    levels: [int64] = []
    top: int64 = 0
    depth: int64 = 0
    // Live entries that hide another; a read needs a lookup only while one is.
    renamed: int64 = 0
    // Without a match expression or function literal an expression binds nothing.
    expr_binds: bool = false
    // The function literals being walked, outermost first, and `top` at each.
    lit_ids: [int64] = []
    lit_marks: [int64] = []
    // Whether each binding in force was declared `mut`, and how many live ones were.
    muts: [bool] = []
    live_muts: int64 = 0
    // Since the last `share_captured`: reads of `mut` bindings and their keys,
    // the `mut` lets, and the keys a literal captures.
    mut_reads: [int64] = []
    mut_read_keys: [str] = []
    mut_lets: [int64] = []
    shared: [str] = []
    // For releasing locals after their last use (Parser.release_after): the
    // statements being walked, outermost first, and for each binding in force
    // the depth in them of the `let` that bound it (-1 for any other
    // binding), the statement at that depth that last used it, whether a
    // function literal captured it, and the binding a `let-else` binding
    // borrows from (-1 for none).
    cur_stmts: [int64] = []
    lets: [int64] = []
    lasts: [int64] = []
    caps: [bool] = []
    parents: [int64] = []
    live_lets: int64 = 0
    // For each binding in force, the literal of the local function it names, or -1.
    fn_decls: [int64] = []

    func run(self, anon decls: [ast.Decl]) -> none {
        // Last first: a literal's id is below the function it's in, so it's walked in place.
        mut id = len(self.p.func_decls) - 1
        for id >= 1 {
            let fd = self.p.func_decls[id]
            id -= 1
            if fd.walked {
                continue
            }
            fd.walked = true
            self.top = 0
            self.renamed = 0
            self.live_muts = 0
            self.live_lets = 0
            self.expr_binds = fd.expr_binds
            self.depth = 1
            for param in fd.params {
                self.bind(param.name)
            }
            self.depth = 0
            self.block(fd.body)
            self.share_captured()
            for param in fd.params {
                self.walk_default(param.default_expr)
            }
        }
        for decl in decls {
            match decl {
                .Struct(_name, _name_span, _type_params, fields, _methods, _shared) -> {
                    for field in fields {
                        self.walk_default(field.default_expr)
                    }
                }
                .Extern(_name, _name_span, params, _return_typ, _variadic) -> {
                    for param in params {
                        self.walk_default(param.default_expr)
                    }
                }
                else none
            }
        }
    }

    func walk_default(self, anon expr_id: int64) -> none {
        self.top = 0
        self.renamed = 0
        self.live_muts = 0
        self.live_lets = 0
        self.expr_binds = true
        self.depth = 1
        self.expr(expr_id)
        self.share_captured()
    }

    // Moves each captured `mut` into a cell (see the comment on Renamer).
    func share_captured(self) -> none {
        if len(self.shared) > 0 {
            for k, expr_id in self.mut_reads {
                let key = self.mut_read_keys[k]
                if arrays.contains(self.shared, key) {
                    let span = self.p.expr_spans[expr_id]
                    let cell = self.p.alloc_expr(ast.Expr.Ident(name: key), :span)
                    let field = self.p.alloc_expr(ast.Expr.Ident(name: "value"), :span)
                    self.p.exprs[expr_id] = ast.Expr.Binary(lhs: cell, op: ast.Op.Dot, rhs: field)
                }
            }
            for stmt_id in self.mut_lets {
                if self.p.stmts[stmt_id] is .Let(name, typ, value, _mutable) and arrays.contains(self.shared, name) {
                    let span = self.p.expr_spans[value]
                    mut callee = self.p.alloc_expr(ast.Expr.Ident(name: "_mut_cell"), :span)
                    if typ != 0 {
                        let t = self.p.alloc_expr(ast.Expr.Ident(name: f"$t{typ}"), :span)
                        callee = self.p.alloc_expr(ast.Expr.Binary(lhs: callee, op: ast.Op.Index, rhs: t), :span)
                    }
                    let call = self.p.alloc_expr(ast.Expr.Call(:callee, args: [ast.CallArg(label: "", label_span: span, :value)]), :span)
                    self.p.stmts[stmt_id] = ast.Stmt.Let(:name, typ: 0, value: call, mutable: false)
                }
            }
            self.shared = []
        }
        self.mut_reads = []
        self.mut_read_keys = []
        self.mut_lets = []
    }

    func literal(self, anon decl_id: int64) -> none {
        let fd = self.p.func_decls[decl_id]
        if fd.walked {
            return
        }
        fd.walked = true
        let saved_binds = self.expr_binds
        let mark = self.top
        self.expr_binds = true
        self.lit_ids += [decl_id]
        self.lit_marks += [mark]
        self.depth += 1
        for param in fd.params {
            param.name = self.bind(param.name)
        }
        // A local function's own name, which its prologue binds.
        if fd.local_func {
            fd.self_key = self.bind(fd.let_name)
            self.fn_decls[self.top - 1] = decl_id
        }
        self.depth -= 1
        self.block(fd.body)
        self.end_scope(mark)
        self.lit_ids = self.lit_ids[0..len(self.lit_ids) - 1]
        self.lit_marks = self.lit_marks[0..len(self.lit_marks) - 1]
        self.expr_binds = saved_binds
        for param in fd.params {
            if param.default_expr != 0 {
                let fresh = Renamer(p: self.p)
                fresh.walk_default(param.default_expr)
            }
        }
    }

    // The binding at `i` is read: a capture of each literal younger than it.
    func note_capture(self, anon i: int64, expr_id: int64) -> none {
        if len(self.lit_marks) > 0 and i < self.lit_marks[len(self.lit_marks) - 1] {
            mut k = i
            for k >= 0 {
                self.caps[k] = true
                k = self.parents[k]
            }
        }
        if self.muts[i] and len(self.lit_marks) > 0 and i < self.lit_marks[len(self.lit_marks) - 1] and not arrays.contains(self.shared, self.keys[i]) {
            self.shared += [self.keys[i]]
        }
        for k, mark in self.lit_marks {
            if i < mark {
                let fd = self.p.func_decls[self.lit_ids[k]]
                mut known = false
                for c in fd.captures {
                    if c.key == self.keys[i] {
                        known = true
                    }
                }
                if not known {
                    fd.captures += [ast.Capture(key: self.keys[i], span: self.p.expr_spans[expr_id])]
                }
            }
        }
    }

    func find(self, anon name: str) -> int64 {
        mut i = self.top - 1
        for i >= 0 {
            if self.names[i] == name {
                return i
            }
            i -= 1
        }
        return -1
    }

    // The name a binding of `name` at this depth gets.
    func bind(self, anon name: str, mutable: bool = false) -> str {
        if len(name) == 0 {
            return name
        }
        mut key = name
        mut level = 0
        let i = self.find(name)
        if i >= 0 {
            key = self.keys[i]
            level = self.levels[i]
            if self.depths[i] < self.depth {
                level += 1
                key = f"{name}#{level}"
                self.p.renames += 1
            }
        }
        if self.top < len(self.names) {
            self.names[self.top] = name
            self.keys[self.top] = key
            self.depths[self.top] = self.depth
            self.levels[self.top] = level
            self.muts[self.top] = mutable
            self.lets[self.top] = -1
            self.lasts[self.top] = -1
            self.caps[self.top] = false
            self.parents[self.top] = -1
            self.fn_decls[self.top] = -1
        } else {
            self.names += [name]
            self.keys += [key]
            self.depths += [self.depth]
            self.levels += [level]
            self.muts += [mutable]
            self.lets += [-1]
            self.lasts += [-1]
            self.caps += [false]
            self.parents += [-1]
            self.fn_decls += [-1]
        }
        if mutable {
            self.live_muts += 1
        }
        self.top += 1
        if level > 0 {
            self.renamed += 1
        }
        return key
    }

    func end_scope(self, anon mark: int64) -> none {
        for self.top > mark {
            self.top -= 1
            if self.lets[self.top] >= 0 {
                self.live_lets -= 1
                let last = self.lasts[self.top]
                if not self.caps[self.top] and last > 0 {
                    self.p.release_after[last, default: []] += [self.keys[self.top]]
                }
            }
            if self.levels[self.top] > 0 {
                self.renamed -= 1
            }
            if self.muts[self.top] {
                self.live_muts -= 1
            }
        }
    }

    func block(self, anon stmts: [int64]) -> none {
        let mark = self.top
        self.depth += 1
        for stmt_id in stmts {
            self.stmt(stmt_id)
        }
        self.depth -= 1
        self.end_scope(mark)
    }

    // The names `names` bind as, or [] when each keeps its own.
    func bind_all(self, anon names: [str]) -> [str] {
        mut keys: [str] = []
        mut changed = false
        for name in names {
            let key = self.bind(name)
            if key != name {
                changed = true
            }
            keys += [key]
        }
        if changed {
            return keys
        }
        let same: [str] = []
        return same
    }

    func bind_pattern(self, anon pattern_id: int64) -> none {
        match self.p.patterns[pattern_id] {
            .SomePat(binding) -> {
                let key = self.bind(binding)
                if key != binding {
                    self.p.patterns[pattern_id] = ast.Pattern.SomePat(binding: key)
                }
            }
            .OkPat(binding) -> {
                let key = self.bind(binding)
                if key != binding {
                    self.p.patterns[pattern_id] = ast.Pattern.OkPat(binding: key)
                }
            }
            .ErrPat(binding) -> {
                let key = self.bind(binding)
                if key != binding {
                    self.p.patterns[pattern_id] = ast.Pattern.ErrPat(binding: key)
                }
            }
            .EnumPat(enum_name, variant_name, bindings) -> {
                let keys = self.bind_all(bindings)
                if len(keys) > 0 {
                    self.p.patterns[pattern_id] = ast.Pattern.EnumPat(:enum_name, :variant_name, bindings: keys)
                }
            }
            .ImplicitEnumPat(variant_name, bindings) -> {
                let keys = self.bind_all(bindings)
                if len(keys) > 0 {
                    self.p.patterns[pattern_id] = ast.Pattern.ImplicitEnumPat(:variant_name, bindings: keys)
                }
            }
            else none
        }
        for sub in self.p.pattern_subs[pattern_id] {
            self.bind_pattern(sub.pattern)
        }
    }

    // A match arm's pattern binds for its body, one level in.
    func arm(self, anon pattern_id: int64, guard: int64, body: [int64]) -> none {
        let mark = self.top
        self.depth += 1
        self.bind_pattern(pattern_id)
        self.expr(guard)
        for stmt_id in body {
            self.stmt(stmt_id)
        }
        self.depth -= 1
        self.end_scope(mark)
    }

    func stmt(self, anon stmt_id: int64) -> none {
        self.cur_stmts += [stmt_id]
        self.stmt_now(stmt_id)
        self.cur_stmts = self.cur_stmts[0..len(self.cur_stmts) - 1]
    }

    func stmt_now(self, anon stmt_id: int64) -> none {
        match self.p.stmts[stmt_id] {
            .Let(name, typ, value, mutable) -> {
                if self.p.exprs[value] is .FuncLit(decl_id) {
                    self.p.func_decls[decl_id].let_name = name
                }
                self.expr(value)
                // Rebound in the same block, it shares its name and slot with the
                // new binding, so only the newest is released early.
                let prev = self.find(name)
                if prev >= 0 and self.depths[prev] == self.depth and self.lets[prev] >= 0 {
                    self.lets[prev] = -1
                    self.live_lets -= 1
                }
                let key = self.bind(name, mutable: mutable and self.expr_binds)
                if key != name {
                    self.p.stmts[stmt_id] = ast.Stmt.Let(name: key, :typ, :value, :mutable)
                }
                if self.p.exprs[value] is .FuncLit(decl_id) and self.p.func_decls[decl_id].local_func {
                    self.fn_decls[self.top - 1] = decl_id
                }
                if len(name) > 0 {
                    self.lets[self.top - 1] = len(self.cur_stmts)
                    self.lasts[self.top - 1] = stmt_id
                    self.live_lets += 1
                }
                if mutable and self.expr_binds {
                    self.mut_lets += [stmt_id]
                }
            }
            .Assign(lhs, rhs) -> {
                self.expr(lhs)
                self.expr(rhs)
            }
            .PlusAssign(lhs, rhs) -> {
                self.expr(lhs)
                self.expr(rhs)
            }
            .OpAssign(lhs, rhs, _op) -> {
                self.expr(lhs)
                self.expr(rhs)
            }
            .Return(value) -> self.expr(value)
            .Throw(value) -> self.expr(value)
            .Assert(expr, _source_text, _span) -> self.expr(expr)
            .ExprStmt(expr) -> self.expr(expr)
            .If(cond, then_body, else_body) -> {
                self.expr(cond)
                self.block(then_body)
                self.block(else_body)
            }
            .For(cond, body) -> {
                self.expr(cond)
                self.block(body)
            }
            .ForEach(name, iter, body) -> {
                self.expr(iter)
                let mark = self.top
                self.depth += 1
                let key = self.bind(name)
                if key != name {
                    self.p.stmts[stmt_id] = ast.Stmt.ForEach(name: key, :iter, :body)
                }
                for body_id in body {
                    self.stmt(body_id)
                }
                self.depth -= 1
                self.end_scope(mark)
            }
            .MatchStmt(subject, arms) -> {
                self.expr(subject)
                for arm_id in arms {
                    let match_arm = self.p.match_arms[arm_id]
                    self.arm(match_arm.pattern, guard: match_arm.guard, body: match_arm.body)
                }
            }
            .LetElse(pattern, value, else_body) -> {
                self.expr(value)
                self.block(else_body)
                let mark = self.top
                self.bind_pattern(pattern)
                // What it binds may borrow from the local it unpacks.
                if self.p.exprs[value] is .Ident(subject) {
                    let j = self.find(subject)
                    if j >= 0 and j < mark {
                        for b in mark..self.top {
                            self.parents[b] = j
                        }
                    }
                }
            }
            else none
        }
    }

    func read(self, anon expr_id: int64, name: str) -> none {
        if self.renamed == 0 and len(self.lit_marks) == 0 and self.live_muts == 0 and self.live_lets == 0 {
            return
        }
        let i = self.find(name)
        if i < 0 {
            return
        }
        // The statement of each `let` it is or borrows from that uses it now.
        mut k = i
        for k >= 0 {
            let at = self.lets[k]
            if at > 0 and at <= len(self.cur_stmts) {
                self.lasts[k] = self.cur_stmts[at - 1]
            }
            k = self.parents[k]
        }
        if self.muts[i] {
            self.mut_reads += [expr_id]
            self.mut_read_keys += [self.keys[i]]
        }
        self.note_capture(i, :expr_id)
        if self.levels[i] > 0 {
            self.p.exprs[expr_id] = ast.Expr.Ident(name: self.keys[i])
        }
    }

    func args(self, anon args: [ast.CallArg]) -> none {
        for arg in args {
            self.expr(arg.value)
        }
    }

    func expr(self, anon expr_id: int64) -> none {
        if expr_id == 0 or (self.renamed == 0 and not self.expr_binds and self.live_lets == 0) {
            return
        }
        match self.p.exprs[expr_id] {
            .Ident(name) -> self.read(expr_id, :name)
            .Binary(lhs, op, rhs) -> {
                self.expr(lhs)
                if reads_operand_rhs(op) {
                    self.expr(rhs)
                }
            }
            .Chain(exprs, _ops) -> {
                for e in exprs {
                    self.expr(e)
                }
            }
            .Call(callee, args) -> {
                if self.p.has_local_fns and self.p.exprs[callee] is .Ident(name) {
                    let i = self.find(name)
                    if i >= 0 and self.fn_decls[i] >= 0 {
                        self.p.local_fn_calls[callee] = self.fn_decls[i]
                    }
                }
                self.expr(callee)
                self.args(args)
            }
            .ArrayLit(elements) -> {
                for e in elements {
                    self.expr(e)
                }
            }
            .MatchExpr(subject, arms) -> {
                self.expr(subject)
                for arm_id in arms {
                    let match_arm = self.p.match_expr_arms[arm_id]
                    let mark = self.top
                    self.depth += 1
                    self.bind_pattern(match_arm.pattern)
                    self.expr(match_arm.guard)
                    for stmt_id in match_arm.pre {
                        self.stmt(stmt_id)
                    }
                    self.expr(match_arm.body)
                    self.depth -= 1
                    self.end_scope(mark)
                }
            }
            .Slice(s, lo, hi) -> {
                self.expr(s)
                self.expr(lo)
                self.expr(hi)
            }
            .Try(inner) -> self.expr(inner)
            .Must(inner) -> self.expr(inner)
            .UnwrapOpt(value, default) -> {
                self.expr(value)
                self.expr(default)
            }
            .OptionalDot(value, _field) -> self.expr(value)
            .AsOptional(value) -> self.expr(value)
            .OptionalMethodCall(value, _method, args) -> {
                self.expr(value)
                self.args(args)
            }
            .FuncLit(decl_id) -> self.literal(decl_id)
            // The arguments are read where `spawn` is; the literal reads the rest.
            .Spawn(call, _decl_id, start, _start_none, _detached) -> {
                if self.p.exprs[call] is .Call(_callee, args) {
                    self.args(args)
                }
                self.expr(start)
            }
            else none
        }
    }
}

func make_parser(anon tokens: [lexing.Token], path: str, source: str) -> Parser {
    // Index 0 is reserved as a null sentinel in every pool so that fields
    // of type int64 can use 0 to mean 'absent' (e.g. no return type, no
    // type annotation, bare return, open slice). Push a dummy at index 0.
    let exprs: [ast.Expr] = [ast.Expr.NoneLit]
    let expr_spans: [ast.Span] = [ast.Span(start: 0)]
    mut stmts: [ast.Stmt] = [ast.Stmt.Break]
    let type_exprs: [ast.TypeExpr] = [ast.TypeExpr.Named(name: "")]
    let type_spans: [ast.Span] = [ast.Span(start: 0)]
    let line_starts: [int64] = []
    let patterns: [ast.Pattern] = [ast.Pattern.Wildcard]
    let pattern_ends: [int64] = [0]
    let dummy_arm_body: [int64] = []
    let match_arms: [ast.MatchArm] = [ast.MatchArm(pattern: 0, body: dummy_arm_body)]
    let match_expr_arms: [ast.MatchExprArm] = [ast.MatchExprArm(pattern: 0, body: 0)]
    let dummy_params: [ast.Param] = []
    let dummy_body: [int64] = []
    let func_decls: [ast.FuncDecl] = [ast.FuncDecl(name: "", name_span: ast.Span(start: 0), params: dummy_params, return_typ: 0, body: dummy_body, doc: "")]
    let errors: [ParseError] = []
    let no_subs: [ast.SubPattern] = []
    let pattern_subs: [[ast.SubPattern]] = [no_subs]
    return Parser(:path, :source, :tokens, pos: 0, :exprs, :expr_spans, :stmts, :type_exprs, :patterns, :pattern_subs, :match_arms, :match_expr_arms, :func_decls, :errors, :line_starts, :type_spans, :pattern_ends)
}

// The operator of a compound assignment, but for `+=`.
func update_op(anon kind: lexing.TokenKind) -> ast.Op? {
    match kind {
        .MinusEqual -> return .Sub
        .StarEqual -> return .Mul
        .SlashEqual -> return .Div
        .PercentEqual -> return .Mod
        .AmpersandEqual -> return .BitAnd
        .PipeEqual -> return .BitOr
        .CaretEqual -> return .BitXor
        .ShiftLeftEqual -> return .Shl
        .ShiftRightEqual -> return .Shr
        else return none
    }
}

// The precedence of the comparisons and `is` (Parser.bin_op_prec): what a
// chained comparison's operands and `not`'s operand are parsed above.
func comparison_prec() -> int64 {
    return 4
}
