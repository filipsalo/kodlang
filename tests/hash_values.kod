// `hash(x)` gives the same values compiled and interpreted: djb2 over the
// bytes of a `str` or `bytes`, an `int64` itself, 0 or 1 for a `bool`, and
// an enum value's variant.

type Color = enum {
    Red
    Green
    Blue
}

func main() -> int64 {
    print_int(hash(""))
    print_int(hash("a"))
    print_int(hash("abc"))
    print_int(hash("the quick brown fox jumps over the lazy dog"))
    print_int(hash(b"abc"))
    print_int(hash(b"\n"))
    print_int(hash(0))
    print_int(hash(-5))
    print_int(hash(1 << 40))
    print_int(hash(true))
    print_int(hash(false))
    print_int(hash(Color.Red))
    print_int(hash(Color.Green))
    let c: Color = .Blue
    print_int(hash(c))
    print_int("abc".hash())
    return 0
}

// expected output:
// 5381
// 177670
// 193485963
// 1653687373046440190
// 193485963
// 177583
// 0
// -5
// 1099511627776
// 1
// 0
// 1
// 2
// 3
// 193485963
