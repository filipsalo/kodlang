// A dep that imports this module back registers its structs and
// interfaces a second time; both registrations are the same type. The
// interpreter can't load a cycle, so this runs compiled only.
import "./cyclic_import_struct_dep"

interface Named {
    func name(self) -> str
}

type Pt = struct {
    x: int64
    y: int64

    func name(self) -> str {
        return f"pt{self.x}"
    }
}

func total(anon p: Pt) -> int64 {
    return p.x + p.y
}

func main() -> int64 {
    let p = Pt(x: 1, y: 2)
    print_int(cyclic_import_struct_dep.sum(p))
    print_int(cyclic_import_struct_dep.sum_all([p, Pt(x: 3, y: 4)]))
    let o: Pt? = p
    print_int(cyclic_import_struct_dep.first_x(o))
    let m = Map[str, Pt]()
    cyclic_import_struct_dep.store(m, p)
    print_int(total(m["a"]?))
    let n: Named = p
    print(cyclic_import_struct_dep.show(n))
    print(cyclic_import_struct_dep.show(Pt(x: 7, y: 0)))

    let q: Pt = cyclic_import_struct_dep.make()
    print_int(total(q))
    let qs: [Pt] = cyclic_import_struct_dep.make_all()
    print_int(len(qs))
    let qo: Pt? = cyclic_import_struct_dep.make_opt()
    if qo is Some(v) {
        print_int(v.y)
    }
    let qm: Map[str, Pt] = cyclic_import_struct_dep.make_map()
    print_int(total(qm["k"]?))
    let qn: Named = cyclic_import_struct_dep.make_named()
    print(qn.name())
    return 0
}

// expected mode:
// run
// expected output:
// 3
// 10
// 1
// 3
// pt1
// pt7
// 11
// 2
// 6
// 11
// pt5
