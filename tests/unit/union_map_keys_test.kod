// A union whose members can all be hashed is a Map key; keys of different members
// are different keys, even when they look alike.
import "sets" { Set }

type Color = enum {
    Red
    Green
}

type Key = int64 | str | bool | Color

func describe(anon k: Key) -> str {
    return f"{k}"
}

test "keys of different members are different keys" {
    mut m = Map[Key, str]()
    m.set(1, "one")
    m.set("1", "string one")
    m.set(true, "yes")
    m.set(Color.Red, "red")
    m.set(0, "zero")
    m.set(false, "no")
    assert len(m) == 6
    let got = [m.get(1)? or "missing", m.get("1")? or "missing", m.get(true)? or "missing", m.get(Color.Red)? or "missing", m.get(Color.Green)? or "missing", m.get(0)? or "missing", m.get(false)? or "missing", m.get(2)? or "missing"]
    assert got == ["one", "string one", "yes", "red", "missing", "zero", "no", "missing"]

    // A key read back from a variable of the union type finds the same entry.
    let k: Key = "1"
    m.set(k, "replaced")
    assert len(m) == 6
    let again = m.get("1")? or "missing"
    assert again == "replaced"
    assert str(m.contains(k)) == "true"
}

test "a growing table finds every key again" {
    // Many keys of each member, so the table grows and every key is found again.
    mut big = Map[int64 | str, int64]()
    for i in 0..500 {
        big.set(i, i)
        big.set(f"{i}", -i)
    }
    mut found: int64 = 0
    for i in 0..500 {
        if big.get(i) is Some(v) and v == i {
            found += 1
        }
        if big.get(f"{i}") is Some(v) and v == -i {
            found += 1
        }
    }
    assert len(big) == 1000
    assert found == 1000
}

test "hash agrees with == and depends on the member" {
    let a: int64 | bool = 0
    let b: int64 | bool = false
    let c: int64 | bool = 0
    assert hash(a) == hash(c)
    assert not (hash(a) == hash(b))

    mut seen = Set[int64 | str](items: Map[int64 | str, bool]())
    seen.add(3)
    seen.add("3")
    seen.add(3)
    assert len(seen) == 2
    assert describe(Color.Green) == "Green"
}
