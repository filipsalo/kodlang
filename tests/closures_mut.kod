// Function literals that capture a `mut`: the literal and the function share it.
extern func rc_live_bytes() -> int64

type Point = struct {
    x: int64
}

func double(anon n: int64) -> int64 {
    return n * 2
}

func make_counter() -> func() -> int64 {
    mut n = 0
    return func() -> int64 {
        n += 1
        return n
    }
}

func both_ways() -> none {
    mut n = 1
    let get = func() -> int64 {
        return n
    }
    let set = func(anon v: int64) -> none {
        n = v
    }
    n = 5
    print_int(get())
    set(7)
    print_int(n)
    n -= 2
    print_int(get())
}

func typed() -> none {
    mut x: float64 = 1.0
    mut o: int64? = none
    let bump = func() -> none {
        x += 0.5
        o = 3
    }
    bump()
    print(f"{x} {o? or 0}")
    if o is Some(v) {
        print_int(v)
    }
}

func arrays() -> none {
    let base = [1, 2]
    mut xs = base
    let push = func(anon v: int64) -> none {
        xs += [v]
        xs[0] = 10
    }
    push(3)
    print(f"{xs[0]} {xs[1]} {xs[2]} {len(base)} {base[0]}")
    mut total = 0
    for v in xs {
        total += v
    }
    print_int(total)
    print_int(len(xs))
}

func loops() -> none {
    mut fs: [func() -> int64] = []
    for i in 0..3 {
        mut own = i * 10
        fs += [func() -> int64 {
            own += 1
            return own
        }]
    }
    for f in fs {
        print_int(f())
    }
    print_int(fs[0]())
    mut k = 0
    let read_k = func() -> int64 {
        return k
    }
    for k < 4 {
        k += 1
    }
    print_int(read_k())
}

func nested() -> none {
    mut n = 0
    let outer = func() -> func() -> none {
        mut m = 100
        return func() -> none {
            n += 1
            m += 1
            print(f"{n} {m}")
        }
    }
    let inner = outer()
    inner()
    inner()
    print_int(n)
}

func other_kinds() -> none {
    mut s = "a"
    mut p = Point(x: 1)
    mut f: func(int64) -> int64 = double
    let change = func() -> none {
        s += "b"
        p = Point(x: p.x + 1)
        f = func(anon n: int64) -> int64 {
            return n + 100
        }
    }
    change()
    print(f"{s} {p.x} {f(1)}")
}

func shadowed() -> none {
    let x = 1
    if x > 0 {
        mut x = 2
        let g = func() -> int64 {
            return x
        }
        x = 3
        print_int(g())
    }
    print_int(x)
}

func labelled(anon n: int64, by: int64) -> int64 {
    return n * by
}

func shorthand() -> none {
    mut by = 2
    let g = func() -> int64 {
        return labelled(5, :by)
    }
    by = 3
    print_int(g())
}

func counters_freed() -> none {
    let c = make_counter()
    let _ = c()
}

func main() -> int64 {
    let a = make_counter()
    let b = make_counter()
    print_int(a())
    print_int(a())
    print_int(b())
    both_ways()
    typed()
    arrays()
    loops()
    nested()
    other_kinds()
    shadowed()
    shorthand()
    counters_freed()
    let start = rc_live_bytes()
    for _ in 0..1000 {
        counters_freed()
    }
    print(rc_live_bytes() - start > 0)
    return 0
}

// expected output:
// 1
// 2
// 1
// 5
// 7
// 5
// 1.5 3
// 3
// 10 2 3 2 1
// 15
// 3
// 1
// 11
// 21
// 2
// 4
// 1 101
// 2 102
// 2
// ab 2 101
// 3
// 1
// 15
// false

// expected status:
// 0
