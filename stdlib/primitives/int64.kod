// Methods on the int64 primitive type. The compiler dispatches
// `n.to_str()`, `n.hash()`, etc. for int64 receivers to these
// functions. Not user-extensible: the codegen reaches into this
// specific module by hardcoded path.

import "primitives/format" { format_int }

// The number as a format spec says, as `f"{n:spec}"` writes it (see
// docs/strings.md); a spec that doesn't fit an int64 panics.
func format(self: int64, anon spec: str) -> str {
    return format_int(self, :spec)
}

extern func kod_int64_to_str(anon n: int64) -> str

// One allocation, in C (stdlib/runtime.c) like the other string builders.
func to_str(self: int64) -> str {
    return kod_int64_to_str(self)
}

func hash(self: int64) -> int64 {
    return self
}

// `self % m` with the sign of `m`, as a clock counts: `(-1).mod(100)` is 99.
func mod(self: int64, anon m: int64) -> int64 {
    let r = self % m
    if r != 0 and (r < 0) != (m < 0) {
        return r + m
    }
    return r
}

// The smallest int64 panics: its positive twin doesn't fit.
func abs(self: int64) -> int64 {
    if self < 0 {
        // Said outright, for a build by a compiler whose `-` wraps.
        if self == -9223372036854775808 {
            panic("integer overflow")
        }
        return -self
    }
    return self
}

// The bit methods below are single instructions: the compiler puts the
// instruction in place of a call (`inline_intrinsic` in codegen.kod). These
// bodies give the same results for code built by an older compiler.

// How many zero bits are above the highest one bit; 64 for 0.
func leading_zeros(self: int64) -> int64 {
    mut x = self
    mut n: int64 = 0
    if x == 0 {
        return 64
    }
    for (x >> 63) == 0 {
        x = x << 1
        n += 1
    }
    return n
}

// How many zero bits are below the lowest one bit; 64 for 0.
func trailing_zeros(self: int64) -> int64 {
    mut x = self
    mut n: int64 = 0
    if x == 0 {
        return 64
    }
    for (x & 1) == 0 {
        x = x >> 1
        n += 1
    }
    return n
}

// How many bits are one.
func count_ones(self: int64) -> int64 {
    mut x = self
    mut n: int64 = 0
    for x != 0 {
        x = x & (x - 1)
        n += 1
    }
    return n
}

// The top 64 bits of the 128-bit product of self and m as unsigned numbers.
func mul_high(self: int64, anon m: int64) -> int64 {
    let mask: int64 = 4294967295
    let a_lo = self & mask
    let a_hi = self >> 32
    let b_lo = m & mask
    let b_hi = m >> 32
    let lh = a_lo.wrapping_mul(b_hi)
    let hl = a_hi.wrapping_mul(b_lo)
    let mid = (a_lo.wrapping_mul(b_lo) >> 32) + (lh & mask) + (hl & mask)
    return a_hi.wrapping_mul(b_hi).wrapping_add((lh >> 32) + (hl >> 32) + (mid >> 32))
}

// `self + m`, `self - m` and `self * m` wrapped around to 64 bits: where `+`,
// `-` and `*` panic on a result that doesn't fit, these keep its low 64 bits,
// as a hash or a random number generator wants. Each is one instruction.

func wrapping_add(self: int64, anon m: int64) -> int64 {
    // In 32-bit halves, so that no step overflows (`>>` brings in zeros).
    let mask: int64 = 4294967295
    let lo = (self & mask) + (m & mask)
    let hi = (self >> 32) + (m >> 32) + (lo >> 32)
    return (hi << 32) | (lo & mask)
}

func wrapping_sub(self: int64, anon m: int64) -> int64 {
    return self.wrapping_add((m ^ -1).wrapping_add(1))
}

func wrapping_mul(self: int64, anon m: int64) -> int64 {
    // `self` in 32-bit halves times `m` in 16-bit pieces: each product fits.
    let a_lo = self & 4294967295
    let a_hi = self >> 32
    mut out: int64 = 0
    for k in 0..4 {
        let piece = (m >> (16 * k)) & 65535
        let part = (a_lo * piece).wrapping_add((a_hi * piece) << 32)
        out = out.wrapping_add(part << (16 * k))
    }
    return out
}
