// Generic types that name themselves in fields, payloads and method sigs.
type Pair[A, B] = struct {
    first: A
    second: B

    func swap(self) -> Pair[B, A] {
        return Pair[B, A](first: self.second, second: self.first)
    }
}

type Tree[T] = struct {
    value: T
    kids: [Tree[T]]
}

type Unused[T] = struct {
    value: T
    kids: [Unused[T]]
}

type Chain[T] = enum {
    End
    Link(value: T, rest: Chain[T])
}

type UnusedChain[T] = enum {
    Stop
    More(value: T, rest: UnusedChain[T])
}

func main() -> int64 {
    let p: Pair[str, int64] = Pair[str, int64](first: "hello", second: 42)
    let q = p.swap()
    print(f"{q.first} {q.second}")
    let r = q.swap()
    print(f"{r.first} {r.second}")
    let leaf = Tree[int64](value: 2, kids: [])
    let t = Tree[int64](value: 1, kids: [leaf])
    print(f"{t.value} -> {t.kids[0].value}")
    let end: Chain[str] = .End
    let c: Chain[str] = .Link(value: "a", rest: end)
    if c is .Link(value, rest) {
        print(value)
        if rest is .End {
            print("end")
        }
    }
    return 0
}

// expected mode:
// run
// expected output:
// 42 hello
// hello 42
// 1 -> 2
// a
// end
