// The compiler reports `is T` for a `T` only another module declares,
// rather than matching that module's `T`.
import "./type_bare_cross_module_dep"

func main() -> int64 {
    let e: Error = type_bare_cross_module_dep.Pt(x: 1)
    if e is Pt {
        return 2
    }
    return 0
}

// expected status:
// 1
// expected stderr:
// 7:8: error: unknown type `Pt`; tests/type_bare_cross_module_dep.kod declares `Pt`: write `type_bare_cross_module_dep.Pt` or list it in the import (`{ Pt }`)
