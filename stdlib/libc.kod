// The C library functions the standard library calls, declared once, so a
// module can have a function of the same name as one of them (posix.poll,
// process.kill). Pointers are int64 addresses from `unsafe`; a C `int`
// result needs `unsafe.c_int`. See docs/unsafe.md.

// Files and descriptors.
extern func read(anon fd: int64, anon buf: int64, anon n: int64) -> int64
extern func write(anon fd: int64, anon buf: int64, anon n: int64) -> int64
extern func close(anon fd: int64) -> int64
extern func isatty(anon fd: int64) -> int64
extern func pipe(anon fds: int64) -> int64
// fcntl(fd, cmd, arg): fcntl is variadic, which an extern can't call, so
// this is a C function that calls it.
extern func kod_fcntl(anon fd: int64, anon cmd: int64, anon arg: int64) -> int64
extern func fflush(anon stream: int64) -> int64

// Processes and signals.
extern func kill(anon pid: int64, anon sig: int64) -> int64
extern func waitpid(anon pid: int64, anon status: int64, anon options: int64) -> int64
extern func execvp(anon file: int64, anon argv: int64) -> int64
extern func posix_spawnp(anon pid: int64, anon file: int64, anon actions: int64, anon attr: int64, anon argv: int64, anon envp: int64) -> int64
extern func posix_spawn_file_actions_init(anon actions: int64) -> int64
extern func posix_spawn_file_actions_destroy(anon actions: int64) -> int64
extern func posix_spawn_file_actions_adddup2(anon actions: int64, anon fd: int64, anon to: int64) -> int64
extern func posix_spawn_file_actions_addopen(anon actions: int64, anon fd: int64, anon path: int64, anon flags: int64, anon mode: int64) -> int64
extern func posix_spawn_file_actions_addchdir(anon actions: int64, anon path: int64) -> int64

// The environment.
extern func getenv(anon name: int64) -> int64
extern func setenv(anon name: int64, anon value: int64, anon overwrite: int64) -> int64
extern func unsetenv(anon name: int64) -> int64
