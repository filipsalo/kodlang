// A pattern naming a generic enum binds the subject instance's payload types.
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}
type Oops = shared struct {
    message: str
    func to_str(self) -> str { return self.message }
}
func half(anon n: int64) -> int64 or Error {
    if n % 2 == 1 {
        throw Oops(message: "odd")
    }
    return n / 2
}
test "patterns naming a user generic enum" {
    let m: Maybe[int64] = .Just(value: 41)
    match m {
        Maybe.Just(v) -> assert v + 1 == 42
        Maybe.Nothing -> fail("nothing")
    }
    let k = match m {
        Maybe.Just(v) -> v + 10
        Maybe.Nothing -> 0
    }
    assert k == 51
    if m is Maybe.Just(w) {
        assert w * 2 == 82
    } else {
        fail("not Just")
    }
    let s: Maybe[str] = .Just(value: "hi")
    match s {
        Maybe.Just(t) -> assert t + "!" == "hi!"
        Maybe.Nothing -> fail("nothing")
    }
    if s is Maybe.Just(u) {
        assert u + "?" == "hi?"
    } else {
        fail("not Just")
    }
    assert m is Maybe.Just
}

test "patterns naming Option" {
    let o: int64? = 4
    match o {
        .Some(v) -> assert v + 1 == 5
        .None -> fail("none")
    }
    let r: int64 = match o {
        .Some(v) -> v + 10
        .None -> 0
    }
    assert r == 14
    if o is .Some(z) {
        assert z + 20 == 24
    } else {
        fail("not Some")
    }
    let n: int64? = none
    assert o is .Some
    assert n is .None
}

test "patterns naming Result" {
    let e = half(4)
    match e {
        Result.Ok(v) -> assert v + 1 == 3
        Result.Err(x) -> fail(x.to_str())
    }
    let q = match half(3) {
        Result.Ok(v) -> f"ok {v}"
        Result.Err(x) -> f"err {x.to_str()}"
    }
    assert q == "err odd"
    if e is Result.Ok(y) {
        assert y + 30 == 32
    } else {
        fail("not Ok")
    }
    assert e is Result.Ok
    assert not (e is Result.Err)
}
