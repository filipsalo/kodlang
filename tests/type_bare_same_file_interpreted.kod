// The interpreter reads a field's type as it parses, so a type declared further
// down the same file is unknown there; the error doesn't send the file to import
// itself or suggest the very name it can't find.
type Node = struct {
    val: int64
    kids: [Tree]
}

type Tree = struct {
    root: int64
}

func main() -> int64 {
    let n = Node(val: 1, kids: [Tree(root: 2)])
    return len(n.kids)
}

// expected status:
// 1
// expected stderr:
// tests/type_bare_same_file_interpreted.kod:6:12: error: unknown type `Tree`
// expected mode:
// interpret
