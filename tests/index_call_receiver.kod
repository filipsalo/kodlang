// Indexing a value a call returned with an index a call returns keeps the
// value while the index is computed, also when the calls nest.

type Tab = struct {
    base: int64

    func op_index(self, anon k: int64) -> int64 {
        return self.base + k
    }
}

func arr(anon xs: [int64]) -> [int64] {
    return xs
}

func idx(anon n: int64) -> int64 {
    return n
}

func word() -> str {
    return "hello"
}

func raw() -> bytes {
    return b"world"
}

func tab() -> Tab {
    return Tab(base: 40)
}

func ages() -> Map[str, int64] {
    let m = Map[str, int64]()
    m["ann"] = 31
    return m
}

func name() -> str {
    return "ann"
}

func main() -> int64 {
    let xs = [10, 20, 30]
    print_int(arr(xs)[idx(1)])
    print_int(arr(xs)[idx(-1)])
    print_int(word()[idx(1)])
    print_int(raw()[idx(0)])
    print_int(tab()[idx(2)])
    print_int(ages()[name()]? or 0)
    print_int(arr(xs)[arr([0, 1, 2])[arr([2, 1, 0])[idx(0)]]])
    print_int(arr(xs)[idx(0)] + arr(xs)[idx(1)] * arr(xs)[idx(2)])
    return 0
}

// expected output:
// 20
// 30
// 101
// 119
// 42
// 31
// 30
// 610
