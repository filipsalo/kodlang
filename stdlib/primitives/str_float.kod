// The str method that reads a float64.

import "primitives/float_text"

// A decimal number, nothing else: an optional sign, digits with an optional
// point, and an optional exponent. `inf`, `nan` and hex are not numbers here,
// and a value too large for a float64 is infinity.
func parse_float(self: str) -> float64? {
	return float_text.parse(self)
}
