test "a returned or thrown value must have its slot's type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s * self.s }
        }
        type Circle = struct {
            r: int64
            func area(self) -> int64 { return 3 * self.r * self.r }
        }
        type Color = enum {
            Red
            Green
        }
        func parse_int(anon s: str) -> int64 or Error { return len(s) }
        func a() -> str { return 5 }
        func b() -> Sq { return Circle(r: 1) }
        func c() -> [Shape] {
            let sqs = [Sq(s: 1)]
            return sqs
        }
        func d() -> Shape { return Color.Red }
        func e() -> int64? { return "a" }
        func f() -> str or Error { return 5 }
        func g(s: str) -> str or Error { return parse_int(s) }
        func h() -> int64 or Error { throw Color.Red }
        func i() -> none { return 5 }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 9
    assert errs[0].message == "error: expected `str`, got `int64`"
    assert errs[0].line == 17
    assert errs[0].col == 26
    assert errs[1].message == "error: expected `Sq`, got `Circle`"
    assert errs[2].message == "error: expected `[Shape]`, got `[Sq]`"
    assert errs[2].line == 21
    assert errs[3].message == "error: expected `Shape`, got `Color`"
    assert errs[4].message == "error: expected `int64?`, got `str`"
    assert errs[5].message == "error: expected `str`, got `int64`"
    assert errs[5].line == 25
    assert errs[6].message == "error: expected `str or Error`, got `int64 or Error`"
    assert errs[7].message == "error: expected `Error`, got `Color`"
    assert errs[7].col == 36
    assert errs[8].message == "error: expected `none`, got `int64`"
}

test "returned values that have their function's type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s * self.s }
        }
        type Shapes = [Shape]
        type Color = enum {
            Red
            Green
        }
        func nothing() -> none { return none }
        func nothing_or_err() -> none or Error { return none }
        func shapes() -> Shapes? { return [Sq(s: 1)] }
        func one() -> Shape or Error { return Sq(s: 2) }
        func ok() -> int64 or Error { return .Ok(value: 1) }
        func pick(c: Color) -> int64 {
            return match c {
                .Red -> 1
                .Green -> 2
            }
        }
        func forward() -> none { return nothing() }
        func fail() -> str { return kod_panic("unreachable") }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 0
}

test "a stored element, key or value must have its slot's type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Sq = struct { s: int64 }
