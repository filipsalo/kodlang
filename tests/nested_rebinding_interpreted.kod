// The interpreter rejects a block's binding of a parameter's name before
// running anything, as the compiler does.
type A = struct {
    x: int64
}

func pick(anon item: A, anon flag: bool) -> int64 {
    if flag {
        let item = 9
        return item
    }
    return item.x
}

func main() -> int64 {
    print("start")
    print_int(pick(A(x: 1), false))
    return 0
}

// expected mode:
// interpret
// expected output:
// expected stderr:
// 9:13: error: `item` is already a local here (line 7); blocks don't have their own scopes yet, so give this one another name
// expected status:
// 1
