// A module's aliases of types from its own imports resolve when only that module is imported.
import "./alias_chain_mid"

func main() -> alias_chain_mid.Out2 {
    let n: alias_chain_mid.Num2 = 3
    print_int(n + 1)
    let s: alias_chain_mid.Name2 = "ab"
    print(s + "c")
    let t = alias_chain_mid.tag("t")
    let p: alias_chain_mid.Pt2 = t.at
    print(f"{t.name} {p.sum()}")
    return 2
}

// expected output:
// 4
// abc
// t 7
// expected status:
// 2
