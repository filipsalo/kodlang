// A context-free `.Variant` that no enum the module sees declares belongs
// to an enum of another loaded module, here one only `mid` imports.
import "./../variant_transitive_mid"

test "variant resolves to an enum only mid imports" {
    let g = .High
    assert variant_transitive_mid.name(g) == "high"
    assert variant_transitive_mid.name(variant_transitive_mid.low()) == "low"
}
