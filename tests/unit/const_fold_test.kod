// int64, bool and float64 constants made of literals are folded in at each
// use; their values must be what the getter would have given.

let SMALL: int64 = 7
let NEG: int64 = -5
let BIG: int64 = 1 << 52
let MASK: int64 = (1 << 52) - 1
let HEX: int64 = 0xff ^ 0x0f
let MIN: int64 = -9223372036854775808
let WRAP: int64 = 9223372036854775807 + 1
let PER_DAY: int64 = 24 * 60 * 60
let SHIFTED: int64 = -1 >> 60
let FLAG: bool = true
let OFF: bool = false
let HALF: float64 = 0.5
let DIV: int64 = 7 / 2
let FROM_OTHER: int64 = SMALL * 2

test "folded constants have the getter's values" {
    mut t: int64 = 0
    for i in 0..3 {
        t += SMALL + i
    }
    assert SMALL == 7
    assert NEG == -5
    assert BIG == 4503599627370496
    assert MASK == 4503599627370495
    assert HEX == 240
    assert MIN == -9223372036854775808
    assert WRAP == -9223372036854775808
    assert PER_DAY == 86400
    assert SHIFTED == 15
    assert t == 24
    assert FLAG == true
    assert OFF == false
    assert (FLAG and not OFF) == true
    assert HALF == 0.5
    assert HALF * 3.0 == 1.5
    assert DIV == 3
    assert FROM_OTHER == 14
    mut taken = false
    if FLAG {
        taken = true
    }
    assert taken
}
