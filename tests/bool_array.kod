// A [bool] holds a byte per element: literals, *, +, +=, slices, loops,
// copies and a Map's bool values all agree on that.

func flip(anon xs: [bool]) -> [bool] {
    mut out: [bool] = []
    for x in xs {
        out += [not x]
    }
    return out
}

func main() -> int64 {
    let a = [true, false, true]
    mut b = [false] * 5
    b[3] = true
    mut c = a + b
    c += [true]
    print(len(c))
    mut shown = ""
    for x in c {
        if x {
            shown += "1"
        } else {
            shown += "0"
        }
    }
    print(shown)
    let d = c[2..6]
    print(f"{d[0]} {d[1]} {d[2]} {d[3]}")
    let e = flip(a)
    print(f"{e[0]} {e[1]} {e[2]}")
    mut copy = c
    copy[0] = false
    print(f"{c[0]} {copy[0]}")
    for i, x in a {
        print(f"{i} {x}")
    }
    mut m = Map[str, bool]()
    m.set("x", true)
    m.set("y", false)
    print(f"{m.get("x")? or false} {m.get("y")? or true} {m.len()}")
    return 0
}

// expected output:
// 9
// 101000101
// true false false false
// false true false
// true false
// 0 true
// 1 false
// 2 true
// true false 2
// expected status:
// 0
