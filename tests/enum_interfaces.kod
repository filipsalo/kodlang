// Enums as interface values: boxing, calls through the interface, downcasts.

interface Named {
    func name(self) -> str
}

interface Sized {
    func size(self, scale: int64 = 1) -> int64
    func name(self) -> str
}

type Dir = enum {
    Up
    Down

    func name(self) -> str {
        return match self {
            .Up -> "up"
            .Down -> "down"
        }
    }
}

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)

    func name(self) -> str {
        return match self {
            .Circle -> "circle"
            .Rect -> "rect"
        }
    }

    func size(self, scale: int64 = 1) -> int64 {
        return scale * match self {
            .Circle(r) -> 3 * r * r
            .Rect(w, h) -> w * h
        }
    }
}

type Pick[T] = enum {
    One(v: T)
    Nothing

    func name(self) -> str {
        return match self {
            .One(v) -> f"one {v}"
            .Nothing -> "nothing"
        }
    }
}

type IntPick = Pick[int64]

type Label = struct {
    text: str

    func name(self) -> str {
        return self.text
    }
}

type Oops = enum {
    Lost(what: str)

    func to_str(self) -> str {
        return match self {
            .Lost(what) -> f"lost {what}"
        }
    }
}

func names(anon xs: [Named]) -> str {
    mut out = ""
    for x in xs {
        if len(out) > 0 {
            out += " "
        }
        out += x.name()
    }
    return out
}

func kind(anon n: Named) -> str {
    match n {
        Dir(d) -> return f"dir {d == .Up}"
        Shape(s) -> return f"shape {s.size()}"
        IntPick(p) -> return f"int pick {p.name()}"
        Label(l) -> return f"label {l.text}"
        else -> return "other"
    }
}

func find(anon what: str) -> int64 or Error {
    if what == "" {
        throw Oops.Lost(what: "nothing")
    }
    return len(what)
}

func main() -> int64 {
    let d: Named = Dir.Down
    print(d.name())
    let shapes: [Sized] = [Shape.Circle(r: 1), Shape.Rect(w: 2, h: 3)]
    for s in shapes {
        print(f"{s.name()} {s.size()} {s.size(scale: 10)}")
    }
    let sized: Sized = Shape.Rect(w: 1, h: 1)
    let named: Named = sized
    print(named.name())
    let p: Pick[int64] = .One(v: 7)
    let q: Pick[str] = .Nothing
    print(names([Dir.Up, p, q, Label(text: "hi"), sized]))
    print(kind(Dir.Up))
    print(kind(Shape.Rect(w: 2, h: 5)))
    print(kind(named))
    print(kind(p))
    print(kind(q))
    print(kind(Label(text: "x")))
    if d is Dir(dir) {
        print(dir.name())
    }
    let maybe: Named? = Dir.Up
    print(maybe?.name()? or "none")
    match find("") {
        Ok(n) -> print_int(n)
        Err(e) -> print(e.to_str())
    }
    for _ in 0..1000 {
        let _: Named = Shape.Circle(r: 2)
    }
    return 0
}

// expected output:
// down
// circle 3 30
// rect 6 60
// rect
// up one 7 nothing hi rect
// dir true
// shape 10
// shape 1
// int pick one 7
// other
// label x
// down
// up
// lost nothing
