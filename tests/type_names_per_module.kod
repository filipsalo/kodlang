// Each module's type names are its own: two modules may declare a type of
// one name, and they are different types wherever a value was made.
import "./type_names_pa"
import "./type_names_pb"
import "./type_names_re"

interface Sized {
    func size(self) -> int64
}

type Pt = struct {
    x: int64

    func size(self) -> int64 {
        return 100 + self.x
    }
}

type Shape = enum {
    Circle(r: int64)
    Line(n: int64)
}

type Mode = enum {
    On
    Off
}

type Label = bool

// One template, different arguments, and two same-named templates.
type PaPtBox = type_names_pa.Box[type_names_pa.Pt]
type PbPtBox = type_names_pa.Box[type_names_pb.Pt]
type MyPtBox = type_names_pa.Box[Pt]
type OtherMyPtBox = type_names_pb.Box[Pt]
// Arguments nested in an array, an optional and a generic instance.
type ArrBox = type_names_pa.Box[[type_names_pa.Pt]]
type OptBox = type_names_pa.Box[type_names_pa.Pt?]
type MapBox = type_names_pa.Box[Map[str, type_names_pa.Pt]]
type PbArrBox = type_names_pa.Box[[type_names_pb.Pt]]

func area(anon s: Shape) -> int64 {
    match s {
        .Circle(r) -> return r * 5
        .Line(n) -> return n
    }
}

func show(anon s: Sized) -> str {
    return f"{s is _: type_names_pa.Pt} {s is _: type_names_pb.Pt} {s is _: Pt} {s is _: type_names_pa.IntBox} {s is _: type_names_pb.IntBox}"
}

func main() -> int64 {
    // Same-named structs, each with its own layout and methods.
    let a = type_names_pa.make(1)
    let b = type_names_pb.make(2, 3)
    let c = Pt(x: 4)
    print(f"{a.size()} {b.size()} {c.size()}")
    // `is` tells the declarations apart wherever the value was boxed.
    print(show(a))
    print(show(b))
    print(show(c))
    print(show(type_names_pa.IntBox(v: 7)))
    print(show(type_names_pb.IntBox(v: 8)))
    print(f"{type_names_pa.is_pt(a)} {type_names_pb.is_pt(a)} {type_names_pa.is_pt(b)} {type_names_pb.is_pt(b)}")
    let sb: Sized = b
    match sb {
        p: type_names_pa.Pt -> print_int(p.x)
        p: type_names_pb.Pt -> print_int(p.y)
        else -> print("neither")
    }
    if sb is p: type_names_pb.Pt {
        print_int(p.x + p.y)
    }
    // Two same-named generic templates: each instance belongs to its template.
    let ia = type_names_pa.IntBox(v: 1)
    let ib = type_names_pb.IntBox(v: 1)
    print(f"{type_names_pa.is_int_box(ia)} {type_names_pb.is_int_box(ia)} {type_names_pa.is_int_box(ib)} {type_names_pb.is_int_box(ib)} {ia.size()} {ib.size()}")
    // Boxed in the module that declares it, tested here.
    let boxed_a = type_names_pa.boxed(7)
    let boxed_b = type_names_pb.boxed(8)
    print(f"{boxed_a is _: type_names_pa.IntBox} {boxed_a is _: type_names_pb.IntBox} {boxed_b is _: type_names_pa.IntBox} {boxed_b is _: type_names_pb.IntBox}")
    // One template with same-named arguments: different instances.
    let pab: Sized = PaPtBox(v: a)
    let pbb: Sized = PbPtBox(v: b)
    let myb: Sized = MyPtBox(v: c)
    let omb: Sized = OtherMyPtBox(v: c)
    print(f"{pab is _: PaPtBox} {pab is _: PbPtBox} {pbb is _: PbPtBox} {pbb is _: PaPtBox} {myb is _: MyPtBox} {myb is _: OtherMyPtBox} {omb is _: OtherMyPtBox} {omb is _: MyPtBox}")
    // Nested argument kinds.
    let arr: Sized = ArrBox(v: [a])
    let opt: Sized = OptBox(v: none)
    let mp: Sized = MapBox(v: Map[str, type_names_pa.Pt]())
    print(f"{arr is _: ArrBox} {arr is _: OptBox} {arr is _: MapBox} {opt is _: OptBox} {opt is _: ArrBox} {mp is _: MapBox} {mp is _: OptBox}")
    // The same, boxed in the module that declares the template, and tested there.
    let na = type_names_pa.boxed_nested(0)
    let nb = type_names_pa.boxed_nested(1)
    let nc = type_names_pa.boxed_nested(2)
    print(f"{na is _: ArrBox} {na is _: PbArrBox} {nb is _: OptBox} {nb is _: ArrBox} {nc is _: MapBox} {nc is _: OptBox}")
    print(f"{type_names_pa.is_arr_box(ArrBox(v: [a]))} {type_names_pa.is_arr_box(PbArrBox(v: [b]))}")
    // Same-named enums: `m.E.V`, a match in each module, and Map keys of each.
    print(f"{type_names_pa.area(type_names_pa.Shape.Circle(r: 2))} {type_names_pb.area(type_names_pb.Shape.Circle(r: 2))} {area(Shape.Circle(r: 2))}")
    print(f"{type_names_pa.area(.Dot)} {type_names_pb.area(.Square(s: 3))} {area(.Line(n: 7))}")
    let ma = Map[type_names_pa.Mode, int64]()
    ma[type_names_pa.Mode.On] = 1
    let mb = Map[type_names_pb.Mode, int64]()
    mb[type_names_pb.Mode.On] = 2
    mb[.Dim] = 3
    let mc = Map[Mode, int64]()
    mc[Mode.Off] = 4
    print(f"{ma[type_names_pa.Mode.On]? or -1} {ma[.Off]? or -1} {mb[.On]? or -1} {mb[type_names_pb.Mode.Dim]? or -1} {mc[Mode.Off]? or -1} {mc[.On]? or -1}")
    // Same-named generic enums and error types.
    if type_names_pa.just(1) is .Just(ja) {
        print_int(ja)
    }
    if type_names_pb.just(1) is .Just(jb) {
        print_int(jb)
    }
    match type_names_pa.fail(5) {
        Ok(n) -> print_int(n)
        Err(ea) -> print(f"{ea is _: type_names_pa.Oops} {ea is _: type_names_pb.Oops} {ea.to_str()}")
    }
    match type_names_pb.fail(6) {
        Ok(n) -> print_int(n)
        Err(eb) -> print(f"{eb is _: type_names_pa.Oops} {eb is _: type_names_pb.Oops} {eb.to_str()}")
    }
    // Aliases of different types may share a name.
    print(type_names_pa.describe("x"))
    let lb = type_names_pb.Label(text: "t")
    let my: Label = true
    let sa: type_names_pa.Score = [1, 2]
    let sc: type_names_pb.Score = 3
    print(f"{lb.text} {my} {len(sa)} {sc}")
    // An alias passes a type on under its own name.
    let r: type_names_re.Pt = type_names_re.origin()
    let rb = type_names_re.boxed()
    print(f"{r.size()} {rb is _: type_names_re.Pt} {rb is _: type_names_pb.Pt} {rb is _: type_names_pa.Pt}")
    print_int(type_names_pa.far_pt().z)
    return 0
}

// expected output:
// 1 5 104
// true false false false false
// false true false false false
// false false true false false
// false false false true false
// false false false false true
// true false false true
// 3
// 5
// true false false true 1 2
// true false false true
// true false true false true false true false
// true false false true false true false
// true false true false true false
// true false
// 6 8 10
// 0 9 7
// 1 -1 2 3 4 -1
// 1
// 2
// true false pa oops 5
// false true pb oops 6
// pa label x
// t true 2 3
// 0 true true false
// 9
