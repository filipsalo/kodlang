// Calling a local that holds no function, with no function of its name,
// is the compiler's error, spelled with the local's Kod type.
func main() -> int64 {
    print("start")
    let g = 5
    print_int(g(1))
    return 0
}

// expected stderr:
// 6:15: error: `g` is a local of type `int64`, not a function
// expected status:
// 1
