test "to_str: zero" {
    assert 0.to_str() == "0"
}

test "to_str: small positive" {
    assert 1.to_str() == "1"
    assert 7.to_str() == "7"
    assert 9.to_str() == "9"
}

test "to_str: multi-digit positive" {
    assert 10.to_str() == "10"
    assert 42.to_str() == "42"
    assert 1234567.to_str() == "1234567"
    assert 1000000000000.to_str() == "1000000000000"
}

test "to_str: negative" {
    assert (-1).to_str() == "-1"
    assert (-7).to_str() == "-7"
    assert (-12345).to_str() == "-12345"
}

test "to_str round-trips through f-string interpolation" {
    let n: int64 = 42
    assert f"value={n}" == "value=42"
}

test "hash: identity" {
    // Per stdlib/primitives/int64.kod, int64.hash returns the value itself.
    assert 0.hash() == 0
    assert 1.hash() == 1
    assert (-99).hash() == -99
    assert 1234567.hash() == 1234567
    assert (-1000000000000).hash() == -1000000000000
}

test "leading_zeros, trailing_zeros and count_ones look at the 64 bits" {
    let values: [int64] = [0, 1, -1, 40, 0xff, 1 << 62, -9223372036854775808, 0x123456789abcdef, -12345]
    let leading: [int64] = [64, 63, 0, 58, 56, 1, 0, 7, 0]
    let trailing: [int64] = [64, 0, 0, 3, 0, 62, 63, 0, 0]
    let ones: [int64] = [0, 1, 64, 2, 8, 1, 1, 32, 59]
    for i, v in values {
        assert v.leading_zeros() == leading[i]
        assert v.trailing_zeros() == trailing[i]
        assert v.count_ones() == ones[i]
    }
}

test "mul_high is the top half of the unsigned 128-bit product" {
    assert (1 << 62).mul_high(8) == 2
    assert 5.mul_high(7) == 0
    // (2^64 - 1)^2 = 2^128 - 2^65 + 1.
    assert (-1).mul_high(-1) == -2
    assert (-1).mul_high(2) == 1
    assert 0x123456789abcdef.mul_high(0x0fedcba987654321) == 5101321817914740
    assert (-9223372036854775808).mul_high(-9223372036854775808) == 1 << 62
    // With `*` giving the bottom half, the pair is the whole product.
    let a: int64 = 0x123456789abcdef
    let b: int64 = 100
    assert a.mul_high(b) == 0 and a * b == 8198552921648689500
}
