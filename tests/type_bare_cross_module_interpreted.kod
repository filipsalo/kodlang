// The interpreter reports a bare type name only another module declares.
import "./type_bare_cross_module_dep"

func x_of(anon p: Pt) -> int64 {
    return p.x
}

func main() -> int64 {
    return x_of(type_bare_cross_module_dep.Pt(x: 1))
}

// expected status:
// 1
// expected stderr:
// 4:19: error: unknown type `Pt`; tests/type_bare_cross_module_dep.kod declares `Pt`: write `type_bare_cross_module_dep.Pt` or list it in the import (`{ Pt }`)
// expected mode:
// interpret
