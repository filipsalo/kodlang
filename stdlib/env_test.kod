import "env"
import "process"

test "get: a variable that is set" {
    assert (env.get("PATH")? or "").contains("/")
}

test "get: a variable that is not set is none" {
    assert env.get("KOD_TEST_SURELY_NOT_SET") is none
}

test "set then get, and set replaces" {
    must env.set("KOD_TEST_A", "one")
    assert (env.get("KOD_TEST_A")? or "!") == "one"
    must env.set("KOD_TEST_A", "two")
    assert (env.get("KOD_TEST_A")? or "!") == "two"
    env.unset("KOD_TEST_A")
}

test "an empty value is set, not missing" {
    must env.set("KOD_TEST_EMPTY", "")
    assert env.get("KOD_TEST_EMPTY") is not none
    assert (env.get("KOD_TEST_EMPTY")? or "!") == ""
    env.unset("KOD_TEST_EMPTY")
}

test "values keep every byte but NUL, = and spaces included" {
    must env.set("KOD_TEST_B", "a=b c\td é")
    assert (env.get("KOD_TEST_B")? or "!") == "a=b c\td é"
    env.unset("KOD_TEST_B")
}

test "unset removes, and unsetting what is not set does nothing" {
    must env.set("KOD_TEST_C", "x")
    env.unset("KOD_TEST_C")
    assert env.get("KOD_TEST_C") is none
    env.unset("KOD_TEST_C")
    env.unset("KOD_TEST_NEVER_SET")
    env.unset("")
    env.unset("A=B")
}

test "set refuses names and values that cannot be in an environment" {
    assert env.set("", "x") is Err(_)
    assert env.set("A=B", "x") is Err(_)
    assert env.set("A\0B", "x") is Err(_)
    assert env.set("KOD_TEST_D", "a\0b") is Err(_)
    assert env.get("KOD_TEST_D") is none
}

test "get of an odd name is none" {
    assert env.get("") is none
    assert env.get("A=B") is none
    assert env.get("A\0B") is none
}

test "a program started afterwards sees the change" {
    must env.set("KOD_TEST_CHILD", "from the parent")
    let r = process.run(["sh", "-c", "printf %s \"$KOD_TEST_CHILD\""])
    assert r.stdout == "from the parent"
    env.unset("KOD_TEST_CHILD")
    let gone = process.run(["sh", "-c", "printf %s \"${KOD_TEST_CHILD-unset}\""])
    assert gone.stdout == "unset"
}
