import "kod/formatting"

// `source` formatted; a syntax error fails the test.
func fmt(anon source: str) -> str {
    return must formatting.format(source, path: "t.kod")
}

// Statements `source` formatted in a function body, given back without it.
func body(anon source: str) -> str {
    let got = fmt("func t() {\n" + source + "}\n")
    mut out = ""
    for line in got.split("\n")[1..] {
        if line == "}" {
            break
        }
        if line.starts_with("    ") {
            out += line[4..len(line)] + "\n"
        } else {
            out += line + "\n"
        }
    }
    return out
}

test "nested blocks are indented four spaces a level, tabs too" {
    assert fmt("func f() {\nif a {\n\t\treturn 1\n}\n}\n") == "func f() {\n    if a {\n        return 1\n    }\n}\n"
    assert fmt("        let X: int64 = 1\n") == "let X: int64 = 1\n"
}

test "a line that opens a bracket indents the next by one level, however many it opens" {
    assert body("f(g([\n1,\n2]),\n3)\n") == "f(g([\n    1,\n    2]),\n    3)\n"
    assert body("let r = run(func() {\nwork()\n}, stdin: \"x\")\n") == "let r = run(func() {\n    work()\n}, stdin: \"x\")\n"
    assert body("let xs = [\n1,\n2,\n]\n") == "let xs = [\n    1,\n    2,\n]\n"
}

test "one space between tokens, none inside brackets or before commas" {
    assert body("let  x=a+b*  c\n") == "let x = a + b * c\n"
    assert body("f( a ,b )\n") == "f(a, b)\n"
    assert body("xs [ 1 ] = [ 1, 2 ]\n") == "xs[1] = [1, 2]\n"
    assert body("if (a)and(b) {\n}\n") == "if (a) and (b) {\n}\n"
    assert body("let f = func (x: int64) -> int64 { return x }\n") == "let f = func(x: int64) -> int64 { return x }\n"
    assert fmt("func g() {}\n") == "func g() {}\n"
}

test "dots, ranges and question marks take no spaces; an implicit variant takes one before" {
    assert body("a . b . c(  )\n") == "a.b.c()\n"
    assert body("for i in 0 .. n {\n}\n") == "for i in 0..n {\n}\n"
    assert body("let s = xs[i+1 .. len(xs)-1]\n") == "let s = xs[i + 1..len(xs) - 1]\n"
    assert body("let c: Color=.Red\n") == "let c: Color = .Red\n"
    assert body("let v = x ? or 0\n") == "let v = x? or 0\n"
    assert body("let n = p ?.name\n") == "let n = p?.name\n"
}

test "a prefix minus attaches; an infix one is spaced" {
    assert body("let a = - 1\n") == "let a = -1\n"
    assert body("return - (x + 1)\n") == "return -(x + 1)\n"
    assert body("f(- x, a-b, xs[- 1])\n") == "f(-x, a - b, xs[-1])\n"
}

test "a colon has a space after it, except a :name shorthand" {
    assert fmt("func f(x : int64, y:str) -> none {\n}\n") == "func f(x: int64, y: str) -> none {\n}\n"
    assert body("f(a : 1, : b,: c)\n") == "f(a: 1, :b, :c)\n"
    assert body("f(: b)\n") == "f(:b)\n"
}

test "comments: a line comment is indented, an end-of-line one keeps its gap" {
    assert fmt("func f() {\n// why\nlet x = 1   // what\n}\n") == "func f() {\n    // why\n    let x = 1   // what\n}\n"
}

test "a gap of two or more spaces in a one-line braced body stays two" {
    assert body("let v = match o { Some(x) -> x     none -> 0 }\n") == "let v = match o { Some(x) -> x  none -> 0 }\n"
    assert fmt("type C = enum { Red  Green }\n") == "type C = enum { Red  Green }\n"
    assert body("let v  =  1\n") == "let v = 1\n"
}

test "blank lines: one at most, none at the ends or before a closing bracket" {
    assert fmt("\n\nlet A: int64 = 1\n\n\n\nlet B: int64 = 2\n\n\n") == "let A: int64 = 1\n\nlet B: int64 = 2\n"
    assert fmt("func f() {\n    let a = 1\n\n}\n") == "func f() {\n    let a = 1\n}\n"
    assert fmt("let A: int64 = 1   \t\n") == "let A: int64 = 1\n"
    assert fmt("let A: int64 = 1") == "let A: int64 = 1\n"
    assert fmt("") == ""
}

test "a multi-line string moves with its line and keeps its value" {
    let src = "func f() -> str {\n\t\treturn \"\"\"\n\t\t\thello\n\t\t\t  world\n\t\t\t\"\"\"\n}\n"
    let want = "func f() -> str {\n    return \"\"\"\n        hello\n          world\n        \"\"\"\n}\n"
    assert fmt(src) == want
    // An empty content line stays empty, and a closing `"""` at the line's own level stays there.
    assert fmt("let S: str = \"\"\"\n    a\n\n    b\n    \"\"\"\n") == "let S: str = \"\"\"\n    a\n\n    b\n    \"\"\"\n"
    assert body("  run(\"\"\"\n      x\n  \"\"\")\n") == "run(\"\"\"\n    x\n\"\"\")\n"
    // A line of only the indent, or an empty one when the closing `"""` has none, stays empty.
    assert fmt("func f() -> str {\nreturn \"\"\"\n  a\n  \n  b\n  \"\"\"\n}\n") == "func f() -> str {\n    return \"\"\"\n      a\n\n      b\n      \"\"\"\n}\n"
    assert fmt("func f() -> str {\nreturn \"\"\"\na\n\nb\n\"\"\"\n}\n") == "func f() -> str {\n    return \"\"\"\n    a\n\n    b\n    \"\"\"\n}\n"
}

test "a syntax error is an error, with where it is" {
    let r = formatting.format("func f( {\n", path: "bad.kod")
    if r is Err(e) {
        assert e.to_str().contains("bad.kod:1:")
    } else {
        fail("formatted a file that doesn't parse")
    }
}

test "formatting formatted text changes nothing" {
    let once = fmt("type P = struct {\nx:int64\n\n\n  func get(self)->int64 {\nreturn self.x*-1   // neg\n}\n}\n")
    assert fmt(once) == once
}

test "a top-level declaration after a multi-line one gets a blank line before it and its comments" {
    assert fmt("func a() {\n}\nfunc b() {\n}\n// c does c\nfunc c() {\n}\n") == "func a() {\n}\n\nfunc b() {\n}\n\n// c does c\nfunc c() {\n}\n"
    // One-line declarations stay together, and one blank line stays one.
    assert fmt("let A: int64 = 1\nlet B: int64 = 2\nfunc f() {\n}\n\nfunc g() {\n}\n") == "let A: int64 = 1\nlet B: int64 = 2\nfunc f() {\n}\n\nfunc g() {\n}\n"
    // Inside a body, code after a block is left as it is.
    assert body("if a {\n}\nlet x = 1\n") == "if a {\n}\nlet x = 1\n"
}

test "a list whose closing bracket starts a line ends with a comma" {
    assert body("f(\n1,\n2\n)\n") == "f(\n    1,\n    2,\n)\n"
    assert body("let xs = [\n1,\n2   // two\n]\n") == "let xs = [\n    1,\n    2,   // two\n]\n"
    assert fmt("func f(\na: int64,\nb: int64\n) -> int64 {\nreturn a\n}\n") == "func f(\n    a: int64,\n    b: int64,\n) -> int64 {\n    return a\n}\n"
    // Already there, empty, or closed on the same line: nothing added.
    assert body("f(\n1,\n)\n") == "f(\n    1,\n)\n"
    assert body("f(\n)\n") == "f(\n)\n"
    assert body("f(1,\n2)\n") == "f(1,\n    2)\n"
    // Only the first closing bracket of the line ends a list there.
    assert body("f([\n1,\n2\n])\n") == "f([\n    1,\n    2,\n])\n"
}
