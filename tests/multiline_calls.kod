// A call, a constructor, a parameter list or an enum variant's fields may be
// split across lines at the commas.

type Point = struct {
    x: int64
    y: int64

    func shifted(
        self,
        dx: int64,
        dy: int64 = 0,
    ) -> Point {
        return Point(
            x: self.x + dx,
            y: self.y + dy,
        )
    }
}

type Shape = enum {
    Circle(
        radius: int64,
        filled: bool,
    )
    Dot
}

func add(
    a: int64,
    b: int64,
    c: int64 = 100,
) -> int64 {
    return a + b + c
}

func join3(anon a: str, anon b: str, anon c: str) -> str {
    return a + b + c
}

func describe(anon s: Shape) -> str {
    match s {
        .Circle(radius, filled) -> return f"circle {radius} {filled}"
        .Dot -> return "dot"
    }
}

func area(anon p: Point?) -> int64 {
    let moved = p?.shifted(
        dx: 1,
        dy: 2,
    )
    return moved?.x? or -1
}

func main() -> int64 {
    print_int(add(
        a: 1,
        b: 2,
    ))
    print_int(add(
        a: 1,
        b: 2,
        c: 3,
    ))
    print_int(add(a: 1,
                  b: 2))
    print_int(add(
        // a comment between the parenthesis and the first argument
        a: 10, // and after an argument
        // and on a line of its own
        b: 20
    ))

    print(join3(
        "a",
        "b",
        "c",
    ))

    let p = Point(
        x: 1,
        y: 2,
    )
    let q = p.shifted(
        dx: 10,
    ).shifted(
        dx: 100,
        dy: 1000,
    )
    print(f"{q.x} {q.y}")

    let maybe: Point? = p
    print_int(area(maybe))
    print_int(area(none))

    print(describe(Shape.Circle(
        radius: 3,
        filled: true,
    )))
    print(describe(.Dot))

    // Nested calls, each opened and closed on its own lines.
    print_int(add(
        a: add(
            a: 1,
            b: 2,
            c: 3,
        ),
        b: add(a: 4, b: 5),
    ))

    // An empty argument list with a line break inside it.
    print_int(zero(
    ))

    // Still one call to an array of calls spread over lines.
    let xs = [
        add(a: 1, b: 1),
        add(
            a: 2,
            b: 2,
        ),
    ]
    print_int(len(xs))
    return 0
}

func zero() -> int64 {
    return 0
}

// expected output:
// 103
// 6
// 103
// 130
// abc
// 111 1002
// 2
// -1
// circle 3 true
// dot
// 215
// 0
// 2

// expected status:
// 0

// expected mode:
// run
