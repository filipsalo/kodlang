// A small HTTP server: each connection is a task of its own, so a slow
// request doesn't hold up the others (docs/http.md#serving).
//
//   kod run examples/hello_server.kod 8080
//
// GET /            hello
// GET /slow?ms=N   answers after N milliseconds (at most 10000)
// POST /echo       gives back the body
import "io"
import "net/http" { Incoming, Response, respond, serve }
import "net/tcp"
import "time"
import "time" { Duration }

// The value of `name` in the request's query, or "".
func query_value(anon req: Incoming, anon name: str) -> str {
    let q = req.target.find("?")
    if q is none {
        return ""
    }
    for pair in req.target[q + 1..len(req.target)].split("&") {
        if pair.starts_with(name + "=") {
            return pair[len(name) + 1..len(pair)]
        }
    }
    return ""
}

func handle(anon req: Incoming) -> Response or Error {
    let path = req.path()
    if path == "/" and req.method == "GET" {
        return respond(200, "hello\n")
    }
    if path == "/slow" and req.method == "GET" {
        mut ms = query_value(req, "ms").parse_int()? or 100
        if ms > 10000 {
            ms = 10000
        }
        time.sleep(Duration(ms: ms))
        return respond(200, f"slept {ms} ms\n")
    }
    if path == "/echo" and req.method == "POST" {
        return respond(200, req.text())
    }
    return respond(404, "not found\n")
}

func main(argv: [str]) -> int64 {
    mut port: int64 = 8080
    if len(argv) == 2 {
        port = argv[1].parse_int()? or -1
    }
    if len(argv) > 2 or port < 0 {
        io.write_stderr("usage: hello_server [PORT]\n")
        return 2
    }
    let l = tcp.listen("127.0.0.1", :port)
    if l is Err(e) {
        io.write_stderr(f"{e.to_str()}\n")
        return 1
    }
    print(f"listening on http://127.0.0.1:{l.port()}")
    if serve(l, handle) is Err(e) {
        io.write_stderr(f"{e.to_str()}\n")
        return 1
    }
    return 0
}
