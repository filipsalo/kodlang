// The interpreter reports `is m.E.V` where the module imported as `m`
// declares no `E`, rather than testing the variant alone.
import "./qualified_type_wrong_module_ka"
import "./qualified_type_wrong_module_kb"

func main() -> int64 {
    let kind: qualified_type_wrong_module_ka.E = .V
    let held = kind is qualified_type_wrong_module_kb.Nope.V
    if held {
        return 2
    }
    return 0
}

// expected status:
// 1
// expected stderr:
// 8:24: error: module `qualified_type_wrong_module_kb` has no type `Nope`
// expected mode:
// interpret
