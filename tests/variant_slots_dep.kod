type Tok = enum {
    Word(s: str)
    End
}

type Color = enum {
    Red
    Green
}

type Held = enum {
    Holds(t: Tok)
    Empty
}

type Cell = struct {
    t: Tok
    tag: Color = .Green
}

func count_words(anon ts: [Tok]) -> int64 {
    mut n = 0
    for t in ts {
        if t != .End {
            n += 1
        }
    }
    return n
}

func is_end(anon t: Tok) -> bool {
    return t == .End
}

func is_red(anon c: Color) -> bool {
    return c == .Red
}

