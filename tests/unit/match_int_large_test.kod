// An int arm takes any int64 literal, not only one that fits an
// instruction's immediate.
func name(anon n: int64) -> str {
    match n {
        0 -> return "zero"
        4095 -> return "4095"
        4096 -> return "4096"
        4097 -> return "4097"
        5000 -> return "5000"
        65535 -> return "65535"
        65536 -> return "65536"
        0x123456789 -> return "0x123456789"
        9223372036854775807 -> return "max"
        else -> return "other"
    }
}

func size(anon n: int64) -> int64 {
    return match n {
        1 -> 1
        70000 -> 2
        4294967296 -> 3
        else 0
    }
}

test "arms with large int literals" {
    let ns = [0, 4095, 4096, 4097, 5000, 65535, 65536, 0x123456789, 9223372036854775807]
    mut names: [str] = []
    for n in ns {
        names += [name(n)]
    }
    assert names == ["zero", "4095", "4096", "4097", "5000", "65535", "65536", "0x123456789", "max"]
    assert name(-1) == "other"
    assert name(-5000) == "other"
    assert name(-9223372036854775807 - 1) == "other"
    assert size(70000) + size(4294967296) * 10 + size(-70000) * 100 == 32
}
