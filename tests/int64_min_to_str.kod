// The smallest int64 has no positive counterpart, so its digits can't
// come from negating it first.
func main() -> int64 {
    let max = 9223372036854775807
    let min = 0 - max - 1
    print_int(min)
    print(f"{min}")
    print(str(min))
    print(min.to_str())
    print_int(min + 1)
    print_int(max)
    print_int(0 - 10)
    print_int(0 - 7)
    print_int(-9223372036854775808)
    print_int(- 9223372036854775808)
    print_int(-0x8000000000000000 + 1)
    print_int(min - -9223372036854775808)
    return 0
}

// expected output:
// -9223372036854775808
// -9223372036854775808
// -9223372036854775808
// -9223372036854775808
// -9223372036854775807
// 9223372036854775807
// -10
// -7
// -9223372036854775808
// -9223372036854775808
// -9223372036854775807
// 0
