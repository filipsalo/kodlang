// Bytes from the operating system's cryptographic generator. See
// docs/crypto.md.
import "unsafe"

extern func getentropy(anon buf: int64, anon size: int64) -> int64

// Under a simulation the bytes come from its seed (splitmix64), so that a run
// repeats (stdlib/tasks.kod sets it): whether one is under way, and the state.
mut _sim_on: bool = false
mut _sim_state: int64 = 0

func sim_seed(on: bool, seed: int64) -> none {
    _sim_on = on
    _sim_state = seed ^ 0x5eed5eed5eed5eed
}

// `x >> k` as on an unsigned number.
func _shr(anon x: int64, anon k: int64) -> int64 {
    if k == 0 {
        return x
    }
    return (x >> k) & ((1 << (64 - k)) - 1)
}

// Fills `n` bytes at `buf` from the simulation's seed.
func _sim_fill(anon buf: int64, anon n: int64) -> none {
    mut state = _sim_state
    mut z = 0
    for i in 0..n {
        if i % 8 == 0 {
            state = state.wrapping_add(-7046029254386353131)
            z = state
            z = (z ^ _shr(z, 30)).wrapping_mul(-4658895280553007687)
            z = (z ^ _shr(z, 27)).wrapping_mul(-7723592293110705685)
            z = z ^ _shr(z, 31)
        }
        unsafe.store8(buf + i, _shr(z, 8 * (i % 8)) & 255)
    }
    _sim_state = state
}

// `n` random bytes, for keys and nonces; under a simulation (stdlib/sim.kod),
// from its seed.
func secure_bytes(anon n: int64) -> bytes {
    if n < 0 {
        panic(f"random.secure_bytes: {n} is negative")
    }
    if n == 0 {
        return b""
    }
    let buf = unsafe.alloc(n)
    // getentropy gives at most 256 bytes a call.
    mut at = 0
    if _sim_on {
        _sim_fill(buf, n)
        at = n
    }
    for at < n {
        let size = min(n - at, 256)
        if unsafe.c_int(getentropy(buf + at, size)) != 0 {
            unsafe.free(buf)
            panic("random.secure_bytes: getentropy failed")
        }
        at += size
    }
    let out = unsafe.copy_out(buf, n)
    unsafe.free(buf)
    return out
}
