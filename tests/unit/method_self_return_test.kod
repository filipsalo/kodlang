// Methods that return their own type, or one declared later.
type Box = shared struct {
    label: str

    func twice(self) -> Box {
        return Box(label: self.label + self.label)
    }

    func name(self) -> str {
        return self.label
    }

    func to_str(self) -> str {
        return f"Box({self.label})"
    }
}

type Holder = shared struct {
    seed: str

    func make(self) -> Later {
        return Later(pad: 0, s: self.seed)
    }
}

type Later = shared struct {
    pad: int64
    s: str
}

test "a method returning its own type" {
    let b = Box(label: "ab")
    assert b.twice().name() == "abab"
    assert f"{b.twice()}" == "Box(abab)"
}

test "a method returning a type declared after it" {
    let h = Holder(seed: "later")
    let l = h.make()
    assert l.s == "later"
}
