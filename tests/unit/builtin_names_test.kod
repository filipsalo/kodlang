// An unqualified `len`, `str`, `hash` or `panic` is a local or
// parameter first (but a local can't be `str`, the name of a type), then the module's own function or an import item, then
// the builtin.
import "./../builtin_names_dep"
import "./../builtin_names_dep" { str }

type Point = shared struct {
    x: int64
}

// What the last `panic` or `soft` call said.
mut said: str = ""

func hash(anon p: Point) -> int64 {
    return p.x * 10
}

func len(anon a: int64, anon b: int64) -> int64 {
    return a + b
}

func panic(anon m: str) -> none {
    said = f"own {m}"
}

func local_names() -> none {
    let panic = func(m: str) -> none {
        said = f"local {m}"
    }
    panic("x")
}

func param_names(anon hash: func(str) -> int64, anon panic: func(str) -> none) -> int64 {
    panic("y")
    return hash("abc")
}

func soft(anon m: str) -> none {
    said = f"soft {m}"
}

func seven(anon s: str) -> int64 {
    return 7
}

test "a module's own function hides the builtin" {
    assert hash(Point(x: 4)) == 40
    assert len(2, 3) == 5
    panic("call")
    assert said == "own call"
    assert str(12) == "num"
}

test "a local or parameter hides the function" {
    local_names()
    assert said == "local x"
    assert param_names(seven, soft) == 7
    assert said == "soft y"
}

test "a qualified name reaches the import's own function" {
    assert builtin_names_dep.hash("abc") == 7
    assert builtin_names_dep.len([1, 2]) == 99
    assert builtin_names_dep.str(5) == "num"
    builtin_names_dep.panic("q")
    assert builtin_names_dep.said == "dep q 2"
}
