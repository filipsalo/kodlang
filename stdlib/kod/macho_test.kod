// kod/macho writes a Mach-O object from the compiler's assembly. Byte
// compatibility with `as` is checked over the corpus by tools/as_diff.kod;
// these tests cover the reader's own rules.

import "kod/macho"

func le32(anon b: bytes, anon at: int64) -> int64 {
    return b[at] | b[at + 1] << 8 | b[at + 2] << 16 | b[at + 3] << 24
}

test "an object starts with the 64-bit Mach-O header for arm64" {
    let obj = must macho.assemble("\t.text\n\t.globl _f\n_f:\n\t.inst 0xd65f03c0 // ret\n")
    assert le32(obj, 0) == 0xFEEDFACF
    assert le32(obj, 4) == 0x0100000C
    // An object file, with four load commands.
    assert le32(obj, 12) == 1
    assert le32(obj, 16) == 4
}

test "a line it doesn't know is an error, with its number" {
    if macho.assemble("\t.text\n\tfrobnicate x0\n") is Error(e) {
        assert e.to_str() == "line 2: an instruction this can't assemble: frobnicate x0"
    } else {
        assert false
    }
    if macho.assemble("\t.text\n\tb Lnowhere\n") is Error(e) {
        assert e.to_str().contains("`Lnowhere` is never defined")
    } else {
        assert false
    }
}

test "comments, whole lines or after one, are skipped" {
    let obj = must macho.assemble("// a comment\n.text\n.globl _main\n_main:\n    ret // done\n\t.inst 0xd503201f //\tnop\n")
    assert le32(obj, 0) == 0xFEEDFACF
}

test "strings take the escapes as reads, octal ones included" {
    let obj = must macho.assemble("\t.data\nlstr:\n\t.asciz \"a\\n\\\"\\\\\\0\\101\"\n")
    // After the header and commands: a, newline, quote, backslash, NUL, A, NUL.
    let text = "a\n\"\\\u{0}A\u{0}"
    mut found = false
    for at in 0..len(obj) - len(text) {
        if obj[at..at + len(text)] == kod_str_to_bytes(text) {
            found = true
        }
    }
    assert found
}
