// Binary `+` on arrays builds a new array and leaves both operands
// unchanged; only `+=` appends in place. Compiled code used to append
// into the left operand, so `a + [3]` grew `a` and every later `a + ...`
// shared (and overwrote) the same header.

type Point = shared struct {
    x: int64
    y: int64
}

type Bag = shared struct {
    items: [int64]
}

func pair(anon n: int64) -> [int64] {
    return [n, n + 1]
}

test "+ leaves both operands unchanged" {
    let a: [int64] = [1, 2]
    let b: [int64] = a + [3]
    let c: [int64] = a + [99]
    assert a == [1, 2]
    assert b == [1, 2, 3]
    assert c == [1, 2, 99]

    let d: [int64] = [7] + a
    let e: [int64] = a + b + c
    assert d == [7, 1, 2]
    assert e == [1, 2, 1, 2, 3, 1, 2, 99]
    assert a == [1, 2]
    assert b == [1, 2, 3]

    let empty: [int64] = []
    let one: [int64] = empty + [1]
    let two: [int64] = empty + [2]
    assert empty == []
    assert one == [1]
    assert two == [2]

    mut grown: [int64] = a + [5]
    grown += [6]
    assert grown == [1, 2, 5, 6]
    assert a == [1, 2]
}

test "rebinding to x + [y] leaves a snapshot alone" {
    mut built: [int64] = []
    mut i = 0
    for i < 5 {
        built = built + [i * 10]
        i += 1
    }
    let snapshot: [int64] = built
    built = built + [50]
    assert built == [0, 10, 20, 30, 40, 50]
    assert snapshot == [0, 10, 20, 30, 40]
}

test "+= appends in place" {
    mut appended: [int64] = []
    mut j = 0
    for j < 1000 {
        appended += [j]
        j += 1
    }
    assert len(appended) == 1000
    assert appended[-1] == 999

    mut doubled: [int64] = [1, 2]
    doubled += doubled
    assert doubled == [1, 2, 1, 2]
}

test "+ on arrays of strings and structs" {
    let names: [str] = ["ann", "bob"]
    let more: [str] = names + ["cid"]
    let other: [str] = names + ["dee"]
    assert len(names) == 2
    assert more[2] == "cid"
    assert other[2] == "dee"
    assert len(more) == 3
    assert len(other) == 3

    let pts: [Point] = [Point(x: 1, y: 2)]
    let pts2: [Point] = pts + [Point(x: 3, y: 4)]
    let pts3: [Point] = pts + [Point(x: 8, y: 9)]
    let p2: Point = pts2[1]
    let p3: Point = pts3[1]
    assert len(pts) == 1
    assert len(pts2) == 2
    assert p2.x == 3
    assert p2.y == 4
    assert len(pts3) == 2
    assert p3.x == 8
    assert p3.y == 9
}

test "+ with fields, calls, slices and nested sums" {
    let a: [int64] = [1, 2]
    let b: [int64] = a + [3]
    mut bag = Bag(items: [1])
    bag.items += [2]
    let bigger: [int64] = bag.items + [3]
    assert bag.items == [1, 2]
    assert bigger == [1, 2, 3]

    let r1: [int64] = a + pair(5)
    let r2: [int64] = a + b[1..3]
    let r3: [int64] = a + (b + [9])
    let r4: [int64] = pair(1) + pair(3)
    assert r1 == [1, 2, 5, 6]
    assert r2 == [1, 2, 2, 3]
    assert r3 == [1, 2, 1, 2, 3, 9]
    assert r4 == [1, 2, 3, 4]
    mut xs: [int64] = [10]
    let ys: [int64] = [20]
    xs += ys + [1]
    xs += pair(7)
    assert xs == [10, 20, 1, 7, 8]
    assert ys == [20]
}
