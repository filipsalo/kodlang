// A struct gives operators a meaning with op_* methods.

type Dur = shared struct {
    ns: int64

    func op_add(self, other: Dur) -> Dur {
        return Dur(ns: self.ns + other.ns)
    }

    func op_sub(self, other: Dur) -> Dur {
        return Dur(ns: self.ns - other.ns)
    }

    func op_mul(self, k: int64) -> Dur {
        return Dur(ns: self.ns * k)
    }

    func op_rmul(self, k: int64) -> Dur {
        return Dur(ns: self.ns * k)
    }

    func op_rsub(self, k: int64) -> Dur {
        return Dur(ns: k - self.ns)
    }

    func op_div(self, k: int64) -> Dur {
        return Dur(ns: self.ns / k)
    }

    func op_mod(self, other: Dur) -> Dur {
        return Dur(ns: self.ns % other.ns)
    }

    func op_eq(self, other: Dur) -> bool {
        return self.ns == other.ns
    }

    func op_lt(self, other: Dur) -> bool {
        return self.ns < other.ns
    }
}

type Plain = shared struct {
    n: int64
}

mut trace: [str] = []

func d(anon n: int64) -> Dur {
    trace += [f"d({n})"]
    return Dur(ns: n)
}

func show(anon x: Dur) -> int64 {
    return x.ns
}

test "arithmetic operators" {
    let a = Dur(ns: 10)
    let b = Dur(ns: 4)
    assert (a + b).ns == 14
    assert (a - b).ns == 6
    assert (a * 3).ns == 30
    assert (3 * a).ns == 30
    assert (a / 2).ns == 5
    assert (a % b).ns == 2
    assert (-a).ns == -10

    // Precedence is the usual one, and the result can be an operand.
    assert (a + b * 2).ns == 18
    assert (2 * a + b).ns == 24
    assert show(a + b + a) == 24
    assert show(a - b - b) == 2
}

test "comparison operators" {
    let a = Dur(ns: 10)
    let b = Dur(ns: 4)
    assert f"{a == b} {a != b} {a == Dur(ns: 10)}" == "false true true"
    assert f"{a < b} {a > b} {a <= b} {a >= b}" == "false true false true"
    assert f"{b < a} {b > a} {b <= a} {b >= a}" == "true false true false"
    assert f"{a <= Dur(ns: 10)} {a >= Dur(ns: 10)}" == "true true"
    assert b < a and a != b
    assert b < a < Dur(ns: 20)
}

test "compound assignment" {
    let a = Dur(ns: 10)
    let b = Dur(ns: 4)
    mut c = a
    c += b
    c -= Dur(ns: 1)
    assert c.ns == 13
    assert a.ns == 10
}

test "operands are evaluated left to right" {
    assert (d(1) + d(2)).ns == 3
    assert trace == ["d(1)", "d(2)"]
    assert (d(3) * 2).ns == 6
    assert trace == ["d(1)", "d(2)", "d(3)"]
    assert (2 * d(5)).ns == 10
    assert trace == ["d(1)", "d(2)", "d(3)", "d(5)"]
    assert d(6) < d(7)
    assert trace == ["d(1)", "d(2)", "d(3)", "d(5)", "d(6)", "d(7)"]
    assert not (d(8) > d(9))
    assert trace == ["d(1)", "d(2)", "d(3)", "d(5)", "d(6)", "d(7)", "d(8)", "d(9)"]
}
