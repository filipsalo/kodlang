// The right side of `=` and `+=` takes a whole expression: `and`/`or` and
// arithmetic bind tighter than assignment.
test "assignment binds looser than and, or and arithmetic" {
    let n = 3
    mut ok = false
    ok = n > 1 and n < 5
    assert ok == true
    ok = n == 1 or n == 2
    assert ok == false
    mut total = 0
    total += n * 2 + 1
    assert total == 7
}
