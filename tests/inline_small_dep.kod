// Small functions and methods in another module, for inline_small.kod.

type Box = struct {
    w: int64
    h: int64
    _scale: int64 = 1

    func area(self) -> int64 {
        return self.w * self.h * self._scale
    }

    func wider_than(self, anon n: int64) -> bool {
        return self.w > n
    }
}

func make_box(w: int64, h: int64) -> Box {
    return Box(:w, :h)
}

func twice(anon n: int64) -> int64 {
    return n + n
}

func scaled(anon x: float64, by: float64 = 2.0) -> float64 {
    return x * by
}
