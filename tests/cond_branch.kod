// `if` and `for` conditions made of `and` and `or` branch between their
// operands: each operand is evaluated left to right, and only until the
// result is known, however they nest.

mut trace: [str] = []

func t(anon name: str, anon v: bool) -> bool {
    trace += [name]
    return v
}

func show(anon what: str, anon taken: bool) -> none {
    print(f"{what} {taken} {" ".join(trace)}")
    trace = []
}

func check(anon a: bool, anon b: bool, anon c: bool) -> none {
    mut taken = false
    if t("a", a) and t("b", b) or t("c", c) {
        taken = true
    }
    show(f"(a and b) or c [{a} {b} {c}]:", taken)
    taken = false
    if t("a", a) or t("b", b) and t("c", c) {
        taken = true
    }
    show(f"a or (b and c) [{a} {b} {c}]:", taken)
    taken = false
    if (t("a", a) or t("b", b)) and not t("c", c) {
        taken = true
    }
    show(f"(a or b) and not c [{a} {b} {c}]:", taken)
}

func main() -> int64 {
    check(true, false, true)
    check(false, true, false)
    check(false, false, false)
    check(true, true, true)
    // A loop whose condition is an `and` of a bound and a test.
    let xs = [3, 5, 8, 9, 12]
    mut i: int64 = 0
    for i < len(xs) and xs[i] % 2 == 1 {
        i += 1
    }
    print(f"first even at {i}")
    // `continue` re-checks the whole condition.
    mut n: int64 = 0
    mut odd: int64 = 0
    for n < 10 or odd < 2 {
        n += 1
        if n % 2 == 0 or n > 20 {
            continue
        }
        odd += 1
    }
    print(f"n {n} odd {odd}")
    // As a value, `and`/`or` still give a bool.
    let both = t("p", true) and t("q", false)
    let either = t("p", false) or t("q", true)
    show(f"values {both} {either}:", both or either)
    return 0
}

// expected output:
// (a and b) or c [true false true]: true a b c
// a or (b and c) [true false true]: true a
// (a or b) and not c [true false true]: false a c
// (a and b) or c [false true false]: false a c
// a or (b and c) [false true false]: false a b c
// (a or b) and not c [false true false]: true a b c
// (a and b) or c [false false false]: false a c
// a or (b and c) [false false false]: false a b
// (a or b) and not c [false false false]: false a b
// (a and b) or c [true true true]: true a b
// a or (b and c) [true true true]: true a
// (a or b) and not c [true true true]: false a c
// first even at 2
// n 10 odd 5
// values false true: true p q p q
