// An arm may call a function that never returns, and `return match` in a `-> none` function needs no value.
mut calls: str = ""

func a() -> none {
    calls += "a"
}
func b() -> none {
    calls += "b"
}
func pick(anon k: int64) -> none {
    return match k {
        1 -> a()
        else -> b()
    }
}
func die(anon msg: str) -> none {
    panic(msg)
}
func refuse(anon k: int64) -> none {
    if k > 0 {
        panic("positive")
    } else {
        panic("not positive")
    }
}

test "return match in a none function runs the arm" {
    pick(1)
    pick(2)
    assert calls == "ab"
}

test "an arm that never returns" {
    let k = 2
    let z = match k {
        2 -> 8
        else -> die("bad")
    }
    assert z == 8
    let w = match k {
        1 -> refuse(k)
        else -> 9
    }
    assert w == 9
}
