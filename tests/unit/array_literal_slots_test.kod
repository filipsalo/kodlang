// An array literal's elements are boxed or wrapped for every slot it's stored in.
interface Shape {
    func area(self) -> int64
}
type Sq = shared struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type Holder = shared struct {
    shapes: [Shape]
    opts: [int64?] = [none, 2]
}
type Bag = enum {
    Items(shapes: [Shape])
    Empty
}
type Shapes = [Shape]
func total(anon xs: [Shape]) -> int64 {
    mut t = 0
    for x in xs {
        t += x.area()
    }
    return t
}
func count(anon xs: [int64?]) -> int64 {
    mut t = 0
    for x in xs {
        t += x? or 100
    }
    return t
}
func defaulted(xs: [Shape] = [Sq(s: 11)]) -> int64 {
    return total(xs)
}
func ret_shapes() -> [Shape] {
    return [Sq(s: 2)]
}
func ret_opts() -> [int64?] {
    return [none, 3]
}
func ret_nested() -> [[int64?]] {
    return [[1, none], [none, 4]]
}
func ret_nested_shapes() -> [[Shape]] {
    return [[Sq(s: 3)], [Sq(s: 1), Sq(s: 2)]]
}
func ret_fallible() -> [Shape] or Error {
    return [Sq(s: 9)]
}
func ret_optional(anon k: int64) -> Shapes? {
    if k > 0 {
        return [Sq(s: 6)]
    }
    return none
}
func ret_match(anon k: int64) -> [Shape] {
    return match k {
        1 -> [Sq(s: 5)]
        else -> []
    }
}
test "locals, assignments and appends" {
    let a: [Shape] = [Sq(s: 1), Sq(s: 2)]
    assert total(a) == 5
    mut b: [Shape] = []
    b = [Sq(s: 3)]
    assert total(b) == 9
    b += [Sq(s: 4)]
    assert total(b) == 25
}

test "arguments and parameter defaults" {
    assert total([Sq(s: 5)]) == 25
    assert count([none, 7]) == 107
    assert defaulted() == 121
}

test "struct fields, their defaults and enum payloads" {
    mut h = Holder(shapes: [Sq(s: 6)])
    assert total(h.shapes) + count(h.opts) == 138
    h.shapes = [Sq(s: 8)]
    h.opts = [9, none]
    assert total(h.shapes) + count(h.opts) == 173
    let bag: Bag = .Items(shapes: [Sq(s: 10)])
    match bag {
        .Items(shapes) -> assert total(shapes) == 100
        .Empty -> fail("empty")
    }
}

test "return values" {
    assert total(ret_shapes()) == 4
    assert count(ret_opts()) == 103
    let n = ret_nested()
    assert count(n[0]) + count(n[1]) == 205
    let ns = ret_nested_shapes()
    assert total(ns[0]) + total(ns[1]) == 14
    assert total(must ret_fallible()) == 81
    assert total(must ret_optional(1)) == 36
    assert total(ret_match(1)) == 25
}

test "index stores and map values" {
    mut grid: [[Shape]] = [[Sq(s: 1)]]
    grid[0] = [Sq(s: 7)]
    assert total(grid[0]) == 49
    mut ogrid: [[int64?]] = [[1]]
    ogrid[0] = [none, 5]
    assert count(ogrid[0]) == 105
    mut m = Map[str, [Shape]]()
    m["k"] = [Sq(s: 3)]
    assert total(must m["k"]) == 9
    m.set("j", [Sq(s: 12)])
    assert total(must m["j"]) == 144
    mut om = Map[str, [int64?]]()
    om["o"] = [none, 1]
    assert count(must om["o"]) == 101
}
