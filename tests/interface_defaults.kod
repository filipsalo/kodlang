// A call through an interface fills an omitted argument from the interface.
interface Greeter {
    func greet(self, anon name: str, times: int64 = 2) -> str
}

type Dog = struct {
    sound: str

    func greet(self, anon name: str, times: int64 = 2) -> str {
        mut out = ""
        mut i = 0
        for i < times {
            out = out + self.sound
            i = i + 1
        }
        return f"{out} {name}"
    }
}

func main() -> int64 {
    let g: Greeter = Dog(sound: "woof")
    print(g.greet("cat"))
    print(g.greet("cat", times: 3))
    let gs: [Greeter] = [Dog(sound: "yip"), g]
    for each in gs {
        print(each.greet("owl"))
    }
    return 0
}

// expected output:
// woofwoof cat
// woofwoofwoof cat
// yipyip owl
// woofwoof owl
