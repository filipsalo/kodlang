}

test "a context-free implicit variant that several enums declare" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Figure = enum {
            Square(side: int64)
            Circle(r: int64)
            Dot
        }
        type Shape = enum {
            Circle(r: int64)
            Rect(w: int64, h: int64)
            Dot
        }
        type Ring = enum {
            Dot
        }
        func main() -> int64 {
            let u = .Circle(r: 1)
            let xs = [.Circle(r: 1)]
            match .Circle(r: 5) {
                .Circle(r) -> print_int(r)
                else -> print("other")
            }
            let same = .Circle(r: 1) == .Circle(r: 9)
            let a = .Circle(r: 1).area()
            let d = .Dot
            return 0
        }
        """)
    assert len(errs) == 6
    let circle = "error: `.Circle` is ambiguous: `Figure` and `Shape` both declare it; write `Shape.Circle` or give the value a type"
    assert errs[0].message == circle
    assert errs[0].line == 15
    assert errs[0].col == 13
    assert errs[1].message == circle
    assert errs[1].col == 15
    assert errs[2].message == circle
    assert errs[2].line == 17
    assert errs[2].col == 11
    assert errs[3].message == circle
    assert errs[3].line == 21
    assert errs[3].col == 16
    assert errs[4].message == circle
    assert errs[4].line == 22
    assert errs[5].message == "error: `.Dot` is ambiguous: `Figure`, `Shape` and `Ring` all declare it; write `Ring.Dot` or give the value a type"
}

test "an ambiguous variant's suggestion takes the payload written" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Mode = enum {
            Circle
            Slow
        }
        type Shape = enum {
            Circle(r: int64)
            Arc(r: int64, deg: int64)
        }
        type Curve = enum {
            Arc(r: int64)
        }
        func main() -> int64 {
            let a = .Circle
            let b = .Arc(r: 1, deg: 90)
            let c = .Arc(r: 1)
            return 0
        }
        """)
    assert len(errs) == 3
    assert errs[0].message == "error: `.Circle` is ambiguous: `Mode` and `Shape` both declare it; write `Mode.Circle` or give the value a type"
    assert errs[1].message == "error: `.Arc` is ambiguous: `Shape` and `Curve` both declare it; write `Shape.Arc` or give the value a type"
    assert errs[2].message == "error: `.Arc` is ambiguous: `Shape` and `Curve` both declare it; write `Curve.Arc` or give the value a type"
}

test "an ambiguous variant's error writes imported enums as the module does" {
    let r: process.ProcessResult = test_support.compile_source("""
        import "./tests/variant_ambiguous_xmod_dep"
        type Shape = enum {
            Circle(r: int64)
            Dot
        }
        type IBox = variant_ambiguous_xmod_dep.Box[int64]
        func main() -> int64 {
            let u = .Circle(r: 1)
            return IBox(v: 1).rank()
        }
        """)
    assert r.status != 0
    assert r.stderr.contains(".kod_compile_test.kod:8:13: error: `.Circle` is ambiguous: `variant_ambiguous_xmod_dep.Shape` and `Shape` both declare it; write `Shape.Circle` or give the value a type")
    assert r.stderr.contains("tests/variant_ambiguous_xmod_dep.kod:16:17: error: `.Fast` is ambiguous: `Mode` and `variant_ambiguous_xmod_base.Gear` both declare it; write `Mode.Fast` or give the value a type")
}

test "implicit variants with a type to go to when several enums declare them" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Figure = enum {
            Square(side: int64)
            Circle(r: int64)
            Dot
        }
        type Shape = enum {
            Circle(r: int64)
            Rect(w: int64, h: int64)
            Dot
        }
        type Holder = struct {
            s: Shape = .Dot
        }
        func area(anon s: Shape) -> int64 {
            match s {
                .Circle(r) -> return 3 * r * r
                .Rect(w, h) -> return w * h
                .Dot -> return 0
            }
        }
        func make() -> Shape {
            return .Circle(r: 2)
        }
        func main() -> int64 {
            let e: Shape = .Circle(r: 1)
            let d: Shape = .Dot
            let o: Shape? = none
            let xs: [Shape] = [.Circle(r: 1), .Dot]
            mut ys: [Shape] = []
            ys += [.Rect(w: 2, h: 3)]
            let m: Shape = match len(xs) {
                1 -> .Circle(r: 3)
                else -> .Dot
            }
            if e is .Circle(r) {
                print_int(r)
            }
            if d == .Dot {
                print("dot")
            }
            match Figure.Circle(r: 4) {
                .Circle(r) -> print_int(r)
                else -> print("other")
            }
            return area(.Circle(r: 2)) + area(make()) + area(Shape.Circle(r: 1)) + area(o? or .Dot) + area(m) + area(Holder().s) + len(ys)
        }
        """)
    assert len(errs) == 0
}
