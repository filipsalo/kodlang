// A struct-typed let evaluates whatever expression produces its value.

type Foo = shared struct {
    n: int64
}

type Oops = shared struct {
    func to_str(self) -> str {
        return "oops"
    }
}

mut trace: [str] = []

func mk(anon ok: bool) -> Foo? {
    if ok {
        return Foo(n: 10)
    }
    return none
}

func make(anon n: int64) -> Foo or Error {
    if n < 0 {
        throw Oops()
    }
    return Foo(n: n * 100)
}

func pick(anon k: int64) -> Foo {
    let f: Foo = match k {
        1 -> Foo(n: 1)
        else -> Foo(n: 2)
    }
    return f
}

func try_store(anon n: int64) -> int64 or Error {
    let h: Foo = try make(n)
    trace += [f"try-store {h.n}"]
    return h.n
}

test "match and unwrap into a struct-typed let" {
    assert pick(1).n == 1
    assert pick(5).n == 2
    let g: Foo = mk(true)? or Foo(n: 3)
    let g2: Foo = mk(false)? or Foo(n: 3)
    assert g.n == 10
    assert g2.n == 3
}

test "try into a struct-typed let" {
    let ok: int64 = must try_store(2)
    assert trace == ["try-store 200"]
    assert ok == 200
    match try_store(-1) {
        Ok(v) -> fail(f"should not reach {v}")
        Err(e) -> assert e.to_str() == "oops"
    }
    assert trace == ["try-store 200"]
}
