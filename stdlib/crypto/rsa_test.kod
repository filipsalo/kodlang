import "crypto/rsa" { PublicKey }
import "crypto/rsa"
import "crypto/sha2" { Algo }
import "encoding/hex"

func h(anon s: str) -> bytes {
    return must hex.decode(s)
}

func flip(anon b: bytes, anon at: int64) -> bytes {
    mut xs = [x for x in b]
    xs[at] = xs[at] ^ 1
    return kod_bytes_from_array(xs)
}

func check(anon n: str, anon e: str, anon algo: Algo, pkcs1: str, pss: str, pss_no_salt: str) -> none {
    let key = must PublicKey(n: h(n), e: h(e))
    let message = b"The quick brown fox jumps over the lazy dog"
    let other = b"The quick brown fox jumps over the lazy cat"
    let p1 = h(pkcs1)
    let ps = h(pss)
    assert rsa.verify_pkcs1(key, algo: algo, message: message, signature: p1)
    assert rsa.verify_pss(key, algo: algo, message: message, signature: ps)
    assert rsa.verify_pss(key, algo: algo, message: message, signature: h(pss_no_salt), salt_size: 0)
    assert not rsa.verify_pkcs1(key, algo: algo, message: other, signature: p1)
    assert not rsa.verify_pss(key, algo: algo, message: other, signature: ps)
    assert not rsa.verify_pkcs1(key, algo: algo, message: message, signature: ps)
    assert not rsa.verify_pss(key, algo: algo, message: message, signature: p1)
    assert not rsa.verify_pss(key, algo: algo, message: message, signature: h(pss_no_salt))
    assert not rsa.verify_pkcs1(key, algo: algo, message: message, signature: flip(p1, 7))
    assert not rsa.verify_pss(key, algo: algo, message: message, signature: flip(ps, len(ps) - 1))
    assert not rsa.verify_pkcs1(key, algo: algo, message: message, signature: p1[1..])
    assert not rsa.verify_pkcs1(key, algo: algo, message: message, signature: h(n))
    let wrong = if algo is .Sha256 { Algo.Sha384 } else { Algo.Sha256 }
    assert not rsa.verify_pkcs1(key, algo: wrong, message: message, signature: p1)
    assert not rsa.verify_pss(key, algo: wrong, message: message, signature: ps)
}

test "signatures OpenSSL made" {
    check("", "010001", .Sha256, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha384, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha512, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha256, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha384, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha512, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha256, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha384, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha512, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "03", .Sha256, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "03", .Sha384, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "03", .Sha512, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha256, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha384, pkcs1: "", pss: "", pss_no_salt: "")
    check("", "010001", .Sha512, pkcs1: "", pss: "", pss_no_salt: "")
}

test "keys refused" {
    assert PublicKey(n: h(""), e: h("010000")) is Error
    assert PublicKey(n: h(""), e: h("01")) is Error
    assert PublicKey(n: h(""), e: h("010001")) is Error
    assert PublicKey(n: h("ff"), e: h("010001")) is Error
    let key = must PublicKey(n: h(""), e: h("010001"))
    assert key.bits() == 2048
}
