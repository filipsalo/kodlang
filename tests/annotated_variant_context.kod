// An annotated match and an `==` operand build implicit variants as the expected enum.
interface Shape {
    func area(self) -> int64
}
type Sq = struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type A = enum {
    Up
    Hit(n: int64)
    Miss
}
type B = enum {
    Miss
    Hit(n: int64)
    Up
}
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}
func show(anon b: B) -> str {
    return match b {
        .Miss -> "miss"
        .Hit(n) -> f"hit {n}"
        .Up -> "up"
    }
}
func just(anon m: Maybe[int64]) -> str {
    return match m {
        .Just(v) -> f"just {v}"
        .Nothing -> "nothing"
    }
}
func main() -> int64 {
    let k = 1
    let mb: B = match k {
        1 -> .Hit(n: 5)
        else -> .Miss
    }
    print(show(mb))
    mut mc: B = .Up
    mc = match k {
        1 -> .Miss
        else -> .Up
    }
    print(show(mc))
    let ys: [Shape] = match k {
        1 -> [Sq(s: 6)]
        else -> []
    }
    print_int(ys[0].area())
    let m: Maybe[int64] = match k {
        1 -> .Just(value: 1)
        else -> .Nothing
    }
    print(just(m))
    let b: B = .Up
    print(f"{b == .Up} {.Up == b} {b != .Miss} {b == .Miss}")
    let n: Maybe[int64] = .Nothing
    print(f"{n == .Nothing} {.Nothing == n} {m != .Nothing} {m == .Nothing}")
    return 0
}

// expected output:
// hit 5
// miss
// 36
// just 1
// true true true false
// true true true false
