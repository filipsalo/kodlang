// Bitwise operators on int64: `&`, `|`, `^`, `<<`, `>>`.
//
// Precedence: shifts bind looser than addition; `&`, `^` and `|` bind
// looser than shifts and, unlike C, tighter than comparisons; everything
// binds tighter than boolean `and`/`or`.

test "bitwise operators" {
    assert (0xff & 0x0f) == 15
    assert (0xf0 | 0x0f) == 255
    assert (0xff ^ 0x0f) == 240
    assert 0x100 >> 4 == 16
    assert 0x10 << 4 == 256
}

test "precedence" {
    // `1 << 3 + 1` parses as `1 << (3 + 1)` = 16; would be 9 if shifts
    // bound tighter.
    let a = 1 << 3 + 1
    assert a == 16
    // `0x10 | 0x01 << 4` parses as `0x10 | (0x01 << 4)` = 0x10 | 0x10 = 16.
    let b = 0x10 | 0x01 << 4
    assert b == 16

    // The canonical CRC32-ish update: combine ldr + shift + xor + and.
    let crc: int64 = 0xfffffff0
    let byte: int64 = 0x0a
    let masked: int64 = (crc ^ byte) & 0xff
    assert masked == 250
}

test "bitwise operators bind tighter than comparisons" {
    let flags = 5
    assert flags & 1 != 0
    assert flags & 2 == 0
    assert flags | 2 == 7
    assert flags ^ 1 == 4
    // `&` binds tighter than `^`, and `^` than `|`.
    assert 1 | 6 & 3 == 3
    assert 1 ^ 3 & 2 == 3
    assert 4 | 1 ^ 1 == 4
    // A bitwise operand in a chained comparison, and under `not`.
    assert 0 < flags & 4 <= 4
    assert not flags & 2 != 0
    // Shifts still bind tighter: `a | b & c << 1` is `a | (b & (c << 1))`.
    assert 1 | 6 & 3 << 1 == 7
}
