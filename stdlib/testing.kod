// The test runner. `kod test` links this module into the test program: each
// module's `__run_tests` dispatcher (emitted by codegen) calls `module_begin`
// once, then `reset` and `report` around every test; `assert` inside a test and
// the builtin `fail` call `fail`; the program's `_main` calls `summary` last
// and exits with what it returns. See docs/testing.md.
//
// The result lines go to stdout and the failure detail to stderr. Stdout is
// block-buffered when it is a pipe or a log and stderr is not, so stdout is
// flushed after every line of the report and before any detail: the two
// streams then keep their order when they end up in one place (and what a
// test printed itself comes out with them).
import "io"
import "libc"
import "posix"
import "process"
import "term"
import "time"
import "unsafe"


mut _failed: bool = false
// Whether this process is a test's child (begin_case).
mut _in_child: bool = false
mut _total: int64 = 0
mut _failures: int64 = 0
// When the first test started (for the summary) and when this one did; -1
// before the first.
mut _start_ns: int64 = -1
mut _case_start_ns: int64 = -1
mut _group_seen: bool = false
// -1 until `_colour` has looked, then 0 or 1.
mut _colour_known: int64 = -1

// Whether the report is coloured: stdout is a terminal and colour isn't off.
func _colour() -> bool {
    if _colour_known < 0 {
        _colour_known = 0
        if term.colour(posix.stdout()) {
            _colour_known = 1
        }
    }
    return _colour_known == 1
}

// Prints a module's path as the header of its group of results, after a blank
// line unless it is the first.
func module_begin(anon path: str) -> none {
    if _group_seen {
        io.write_stdout("\n")
    }
    _group_seen = true
    io.write_stdout(f"{path}\n")
    io.flush_stdout()
}

// Starts a test's clock and its result.
func reset() -> none {
    let now = time.monotonic_ns()
    if _start_ns < 0 {
        _start_ns = now
    }
    _case_start_ns = now
    _failed = false
}

// Called before each test, which runs in a child process so that a panic or a
// crash fails only that test. True in the child, which runs the test and then
// `end_case`; false here, once the child has ended and its result is noted.
// Without a child (fork failed), true, and the test runs here.
func begin_case() -> bool {
    reset()
    io.flush_stdout()
    let pid = unsafe.c_int(libc.fork())
    if pid <= 0 {
        _in_child = pid == 0
        return true
    }
    mut status = -1
    if process.wait_status(pid, name: "test", hang: true) is int64(got) {
        status = got
    }
    let sig = status & 127
    if status < 0 {
        _failed = true
        fail("the test's process could not be waited for")
    } else if sig != 0 {
        _failed = true
        fail(f"killed by {process.signal_name(sig)}")
    } else if ((status >> 8) & 255) != 0 {
        // 2 from end_case: its failures are printed; else it panicked, and said so.
        _failed = true
    }
    return false
}

// Called after a test in its child: ends the child, telling begin_case whether
// the test failed.
func end_case() -> none {
    if not _in_child {
        return none
    }
    io.flush_stdout()
    mut code = 0
    if _failed {
        code = 2
    }
    libc.exit(code)
}

// What a function did in a process of its own (`run`).
type Ran = struct {
    // 0 when the function returned, 1 when it panicked (a failed `assert`
    // in it too), 2 when it called `fail`; -1 when a signal ended it.
    status: int64
    // The signal that ended it, else 0.
    signal: int64
    stdout: str
    stderr: str
}

mut _runs: int64 = 0

// Runs `body` in a child process with `stdin` as its standard input, and gives
// back its exit status and everything it wrote. The child's output goes to
// files, not pipes, so it can write any amount without waiting for this side.
func run(anon body: func() -> none, stdin: str = "") -> Ran {
    _runs += 1
    mut dir = "/tmp"
    if env_text("TMPDIR") is str(t) and len(t) > 0 {
        dir = t
        if dir.ends_with("/") {
            dir = dir[0..len(dir) - 1]
        }
    }
    let base = f"{dir}/kod-run-{libc.getpid()}-{_runs}"
    let in_path = base + ".in"
    let out_path = base + ".out"
    let err_path = base + ".err"
    if io.write_file(in_path, stdin) != 0 {
        return Ran(status: -1, signal: 0, stdout: "", stderr: f"testing.run: cannot write {in_path}")
    }
    // What either side buffered so far would otherwise come out twice.
    io.flush_stdout()
    let _flushed = libc.fflush(0)
    let pid = unsafe.c_int(libc.fork())
    if pid == 0 {
        _redirect(in_path, to: 0, write: false)
        _redirect(out_path, to: 1, write: true)
        _redirect(err_path, to: 2, write: true)
        _failed = false
        _in_child = false
        body()
        io.flush_stdout()
        mut code = 0
        if _failed {
            code = 2
        }
        libc.exit(code)
    }
    mut ran = Ran(status: -1, signal: 0, stdout: "", stderr: "testing.run: cannot start a process")
    if pid > 0 {
        mut status = -1
        if process.wait_status(pid, name: "run", hang: true) is int64(got) {
            status = got
        }
        ran.stdout = io.read_file(out_path)
        ran.stderr = io.read_file(err_path)
        let sig = status & 127
        if status >= 0 and sig == 0 {
            ran.status = (status >> 8) & 255
        } else if status >= 0 {
            ran.signal = sig
        }
    }
    for path in [in_path, out_path, err_path] {
        let _gone = libc.unlink(unsafe.c_str(path))
    }
    return ran
}

// In run's child: `path` as descriptor `to`, or the child ends saying why.
func _redirect(anon path: str, to: int64, write: bool) -> none {
    mut flags = 0
    if write {
        flags = 1537
    }
    // O_WRONLY | O_CREAT | O_TRUNC, mode 0644.
    let fd = unsafe.c_int(libc.open(unsafe.c_str(path), flags, 420))
    if fd < 0 or unsafe.c_int(libc.dup2(fd, to)) < 0 {
        kod_eprint(f"testing.run: cannot open {path}")
        libc.exit(3)
    }
    let _closed = libc.close(fd)
}

func env_text(anon name: str) -> str? {
    let value = libc.getenv(unsafe.c_str(name))
    if value == 0 {
        return none
    }
    return unsafe.str_at(value)
}

// Marks the current test failed and prints `msg` under it. The test goes on,
// so one run shows every failure.
func fail(anon msg: str) -> none {
    _failed = true
    io.flush_stdout()
    // Two spaces for the group, four more so the message belongs to the test.
    io.write_stderr(f"      {msg}\n")
}

// Called after each test: prints its `ok` or `FAIL` line with how long it took.
func report(anon name: str) -> none {
    _total += 1
    mut status = "ok  "
    if _failed {
        _failures += 1
        status = "FAIL"
    }
    mut took = "(" + format_duration(time.monotonic_ns() - _case_start_ns) + ")"
    if _colour() {
        took = term.dim(took)
        if _failed {
            status = term.red(term.bold(status))
        } else {
            status = term.green(status)
        }
    }
    io.write_stdout(f"  {status} {name} {took}\n")
    io.flush_stdout()
}

// Prints how many tests passed and returns the exit status: 1 if any failed.
func summary() -> int64 {
    mut elapsed: int64 = 0
    if _start_ns >= 0 {
        elapsed = time.monotonic_ns() - _start_ns
    }
    mut line = f"{_total - _failures}/{_total} passed in {format_duration(elapsed)}"
    if _colour() and _failures > 0 {
        line = term.red(term.bold(line))
    } else if _colour() {
        line = term.green(line)
    }
    io.write_stdout(f"\n{line}\n")
    io.flush_stdout()
    if _failures > 0 {
        return 1
    }
    return 0
}

// `ns` in μs, ms or s with three significant figures: 208 ns is "0.21 μs",
// 45678 ns "45.7 μs", 1234567 ns "1.23 ms". Microseconds is the finest unit,
// since the clock only resolves about 42 ns; a 0 ns reading (two reads in one
// tick) is reported as below that, "<0.04 μs".
func format_duration(anon ns: int64) -> str {
    if ns == 0 {
        return "<" + fixed(time.monotonic_res_ns(), unit_ns: 1000, decimals: 2) + " μs"
    }
    mut unit_ns: int64 = 1000000000
    mut unit = "s"
    if ns < 1000000 {
        unit_ns = 1000
        unit = "μs"
    } else if ns < 1000000000 {
        unit_ns = 1000000
        unit = "ms"
    }
    mut decimals: int64 = 0
    if ns < 10 * unit_ns {
        decimals = 2
    } else if ns < 100 * unit_ns {
        decimals = 1
    }
    return fixed(ns, :unit_ns, :decimals) + " " + unit
}

// `ns / unit_ns` rounded to `decimals` places (half up).
func fixed(anon ns: int64, unit_ns: int64, decimals: int64) -> str {
    mut scale: int64 = 1
    for _ in 0..decimals {
        scale = scale * 10
    }
    let scaled = (ns * scale * 2 + unit_ns) / (unit_ns * 2)
    let whole = scaled / scale
    if decimals == 0 {
        return f"{whole}"
    }
    mut frac = f"{scaled % scale}"
    for len(frac) < decimals {
        frac = "0" + frac
    }
    return f"{whole}.{frac}"
}
