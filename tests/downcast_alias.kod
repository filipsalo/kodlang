// A downcast may name a struct through an alias, or a generic instance
// through an alias of it.
interface Shape {
    func area(self) -> int64
}

type Pt = struct {
    x: int64

    func area(self) -> int64 {
        return self.x
    }
}

type P2 = Pt

type Box[T] = struct {
    v: T

    func area(self) -> int64 {
        return 1
    }
}

type IntBox = Box[int64]
type StrBox = Box[str]
// Two aliases of one instance name the same type, however its arguments are spelled.
type OptBox = Box[int64?]
type OptBox2 = Box[int64?]
type FnBox = Box[func(int64) -> int64]
type FnBox2 = Box[func(int64) -> int64]
type ArrOptBox = Box[[int64?]]
type ArrOptBox2 = Box[[int64?]]

func twice(anon n: int64) -> int64 {
    return n * 2
}

func main() -> int64 {
    let a: Shape = Pt(x: 2)
    let b: Shape = IntBox(v: 3)
    let c: Shape = StrBox(v: "s")
    print(f"{a is P2} {a is Pt} {a is IntBox} {b is IntBox} {c is IntBox} {c is StrBox}")
    let d: Shape = OptBox(v: 4)
    let e: Shape = FnBox(v: twice)
    let g: Shape = ArrOptBox(v: [5])
    print(f"{d is OptBox2} {e is FnBox2} {g is ArrOptBox2} {d is FnBox2} {g is OptBox2}")
    if a is P2(p) {
        print_int(p.x)
    }
    if b is IntBox(ib) {
        print_int(ib.v)
    }
    match c {
        IntBox(ib) -> print_int(ib.v)
        StrBox(sb) -> print(sb.v)
        else -> print("?")
    }
    return 0
}

// expected output:
// true true false true false true
// true true true false false
// 2
// 3
// s
