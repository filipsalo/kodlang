// A struct that declares `init` is built through it; inside the struct the field constructor stays.
import "./struct_init_dep"
import "./struct_init_dep" { Port }

type Celsius = struct {
    degrees: int64

    func init(kelvin: int64 = 0, offset: int64 = 0) -> Celsius {
        print("init")
        return Celsius(degrees: kelvin - 273 + offset)
    }

    func warmer(self, by: int64) -> Celsius {
        return Celsius(degrees: self.degrees + by)
    }
}

type Plain = struct {
    n: int64 = 7
}

type Pair = struct {
    left: Celsius
    right: Celsius = Celsius(kelvin: 283)
}

func open(anon n: int64) -> int64 or Error {
    let p = try Port(number: n)
    return p.number
}

func main() -> int64 {
    let a = Celsius(kelvin: 300)
    print_int(a.degrees)
    let b = Celsius(offset: 5)
    print_int(b.degrees)
    print_int(a.warmer(by: 10).degrees)
    let c: Celsius = Celsius(kelvin: 273)
    print_int(c.degrees)
    print_int(Plain().n)

    let pair = Pair(left: a)
    print_int(pair.right.degrees)

    print_int(must open(8080))
    if open(0) is Err(e) {
        print(e.to_str())
    }
    if open(70000) is Err(e) {
        print(e.to_str())
    }
    let p = must struct_init_dep.Port(number: 80)
    print_int(p.next().number)
    print_int(struct_init_dep.Temp(kelvin: 300).degrees)
    print_int(struct_init_dep.Temp(celsius: 5).degrees)
    return 0
}

// expected output:
// init
// 27
// init
// -268
// 37
// init
// 0
// 7
// init
// 10
// 8080
// bad port 0
// bad port 70000
// 81
// 27
// -268

// expected status:
// 0
