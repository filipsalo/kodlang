// Generic types that name themselves in fields, payloads and method sigs.
type Pair[A, B] = shared struct {
    first: A
    second: B

    func swap(self) -> Pair[B, A] {
        return Pair[B, A](first: self.second, second: self.first)
    }
}

type Tree[T] = shared struct {
    value: T
    kids: [Tree[T]]
}

type Unused[T] = shared struct {
    value: T
    kids: [Unused[T]]
}

type Chain[T] = enum {
    End
    Link(value: T, rest: Chain[T])
}

type UnusedChain[T] = enum {
    Stop
    More(value: T, rest: UnusedChain[T])
}

test "a struct method returns another instance of its own type" {
    let p: Pair[str, int64] = Pair[str, int64](first: "hello", second: 42)
    let q = p.swap()
    assert q.first == 42
    assert q.second == "hello"
    let r = q.swap()
    assert r.first == "hello"
    assert r.second == 42
}

test "a struct field holds its own type" {
    let leaf = Tree[int64](value: 2, kids: [])
    let t = Tree[int64](value: 1, kids: [leaf])
    assert t.value == 1
    assert t.kids[0].value == 2
}

test "an enum payload holds its own type" {
    let end: Chain[str] = .End
    let c: Chain[str] = .Link(value: "a", rest: end)
    if c is .Link(value, rest) {
        assert value == "a"
        assert rest is .End
    } else {
        fail("not a Link")
    }
}
