// Regression: flushing the buffered asm rewrote every `v<digits>` /
// `w<digits>` token to a physical register, including `.asciz` string
// data and mangled symbols, so `"GET /api/v1/users"` came out as
// `GET /api/x19/users` and a function named `v2` failed to link.
// The expected values are split so that no piece holds such a token.

interface Versioned {
    func v4(self) -> str
}

type Header = shared struct {
    name: str
    value: str
    func v4(self) -> str {
        return f"{self.name}: {self.value}"
    }
}

func v2(anon x: int64) -> int64 {
    return x + 2
}

func show(anon h: Versioned) -> str {
    return h.v4()
}

test "register-like tokens in strings and names are left alone" {
    assert "GET /api/v1/users HTTP/1.1" == "GET /api/v" + "1/users HTTP/1.1"
    assert "Accept: v2, w3" == "Accept: v" + "2, w" + "3"
    let s = "v1"
    assert s == "v" + "1"
    assert "w0 x v9" == "w" + "0 x v" + "9"
    let n = 7
    assert f"api/v1/items/{n} w3" == "api/v" + "1/items/7 w" + "3"
    assert "quote \"v1\" and \\ w2" == "quote \"v" + "1\" and \\ w" + "2"
    mut m: Map[str, str] = Map[str, str]()
    m.set("version", "v1")
    match m.get("version") {
        Some(v) -> assert v == "v" + "1"
        none -> fail("missing")
    }
    assert show(Header(name: "X-Version", value: "v3")) == "X-Version: v" + "3"
    assert v2(40).to_str() == "42"
}
