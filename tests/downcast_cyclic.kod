// A value boxed in a module that imports this one back still matches its
// struct with `is`. The interpreter can't load a cycle, so this runs
// compiled only.
import "./downcast_cyclic_dep"

interface Named {
    func name(self) -> str
}

type Pt = struct {
    x: int64

    func name(self) -> str {
        return f"pt{self.x}"
    }
}

type Oops = struct {
    code: int64

    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

func main() -> int64 {
    let m: Named = downcast_cyclic_dep.boxed()
    if m is Pt(p) {
        print_int(p.x)
    } else {
        print("not pt")
    }
    match downcast_cyclic_dep.fail(1) {
        Ok(v) -> print_int(v)
        Err(e) -> {
            if e is Oops(o) {
                print_int(o.code)
            } else {
                print(e.to_str())
            }
        }
    }
    return 0
}

// expected mode:
// run
// expected output:
// 42
// 11
