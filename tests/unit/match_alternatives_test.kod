// Patterns joined with `|` share an arm, in a match statement or expression.

type Op = enum {
    Add
    Sub
    Mul
    Lit(n: int64)
}

func kind(op: Op) -> str {
    match op {
        .Add | .Sub -> return "additive"
        Op.Mul | .Lit(_) -> return "other"
    }
}

func size(n: int64) -> str {
    return match n {
        1 | 2 | 3 -> "small"
        10 |
        20 -> "round"
        else "big"
    }
}

func opt(o: int64?) -> str {
    return match o {
        none | Some(_) -> "either"
    }
}

test "alternatives in a match statement" {
    assert kind(op: .Add) == "additive"
    assert kind(op: .Sub) == "additive"
    assert kind(op: .Mul) == "other"
    assert kind(op: .Lit(n: 4)) == "other"
    let name = "b"
    mut out = ""
    match name {
        "a" | "b" -> {
            let shout = name + "!"
            out = shout
        }
        else fail("no")
    }
    assert out == "b!"
    mut total = 0
    for op in [Op.Add, .Mul, .Sub] {
        match op {
            .Add | .Sub -> total += 1
            else none
        }
    }
    assert total == 2
}

test "alternatives in a match expression" {
    assert size(n: 2) == "small"
    assert size(n: 20) == "round"
    assert size(n: 7) == "big"
    assert opt(o: none) == "either"
}

test "| outside a pattern is bitwise or" {
    assert (1 | 2) == 3
}
