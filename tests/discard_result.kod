// `let _ = expr` evaluates a value and keeps nothing; a fallible result may be
// dropped only that way.

type Door = struct {
    open: bool

    func shut(self) -> none or Error {
        print("shut")
    }
}

func close() -> none or Error {
    print("closed")
}

func count() -> int64 {
    print("counted")
    return 3
}

func fails() -> int64 or Error {
    throw Oops(message: "no")
}

type Oops = struct {
    message: str
    func to_str(self) -> str { return self.message }
}

func main() -> int64 {
    let _ = close()
    let _ = close()
    let _ = count()
    let _ = fails()
    let door = Door(open: true)
    let _ = door.shut()
    count()
    must close()
    let n = count()
    print_int(n)
    return 0
}

// expected output:
// closed
// closed
// counted
// shut
// counted
// closed
// counted
// 3

// expected status:
// 0

// expected mode:
// run
