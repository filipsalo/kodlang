// `?` after an array or generic type makes it optional.

type Box[T] = struct {
    v: T
}

type Holder = struct {
    names: [str]?
    box: Box[int64]?

    func count(self) -> int64 {
        return len(self.names? or [])
    }
}

func find(anon n: int64) -> [int64]? {
    if n == 0 {
        return none
    }
    return [n, n + 1]
}

func total(anon xs: [int64]?) -> int64 {
    mut t: int64 = 0
    for x in xs? or [] {
        t += x
    }
    return t
}

func main() -> int64 {
    let a = find(0)
    if a is none {
        print("none")
    }
    let b = find(3)
    if b is Some(xs) {
        print_int(len(xs))
    }
    print_int(total(b))
    print_int(total(none))
    print_int(total([5, 6]))
    let h = Holder(names: ["a"], box: Box[int64](v: 4))
    print_int(h.count())
    print_int(Holder(names: none, box: none).count())
    if h.box is Some(bx) {
        print_int(bx.v)
    }
    let m = match b {
        Some(v) -> len(v)
        none -> 0
    }
    print_int(m)
    mut d: [int64]? = none
    d = [1, 2, 3]
    print_int(len(d? or []))
    return 0
}

// expected output:
// none
// 2
// 7
// 0
// 11
// 1
// 0
// 4
// 2
// 3

// expected status:
// 0

// expected mode:
// run
