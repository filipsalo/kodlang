}

test "a literal built as its first element's type checks the other elements" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s * self.s }
        }
        type Color = enum {
            Red
            Green
        }
