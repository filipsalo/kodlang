// The certificates are in testdata/, made by testdata/make_certs.sh (valid
// 2025 to 2035), and github_chain.pem is what github.com sent on 2026-11-26.
import "crypto/x509" { Certificate }
import "crypto/x509"
import "io"
import "posix" { open_read }
import "process"

func load(anon name: str) -> Certificate {
    let text = must io.read_file(f"stdlib/crypto/testdata/{name}.pem")
    let ders = must x509.pem_certificates(text)
    return must x509.parse(ders[0])
}

func load_all(anon name: str) -> [Certificate] {
    let text = must io.read_file(f"stdlib/crypto/testdata/{name}.pem")
    return [must x509.parse(d) for d in must x509.pem_certificates(text)]
}

func at(anon year: int64, anon month: int64, anon day: int64) -> int64 {
    return x509.days_from_civil(year, month, day) * 86400
}

func roots() -> [Certificate] {
    return [load("root_rsa"), load("root_ec")]
}

// Whether the chain verifies for `host` on 2026-06-01.
func ok(anon chain: [str], anon host: str) -> bool {
    let certs = [load(name) for name in chain]
    return x509.verify(certs, host: host, roots: roots(), now: at(2026, 6, 1)) is Ok(_)
}

// The message of the error the chain gives for `host`, or "" when it verifies.
func why(anon chain: [str], anon host: str) -> str {
    let certs = [load(name) for name in chain]
    let r = x509.verify(certs, host: host, roots: roots(), now: at(2026, 6, 1))
    if r is Error(e) {
        return e.to_str()
    }
    return ""
}

test "what a certificate says" {
    let leaf = load("leaf")
    assert leaf.common_name() == "leaf"
    assert leaf.dns_names == ["example.test", "*.example.test"]
    assert leaf.ip_addresses == [b"\x7f\x00\x00\x01"]
    assert not leaf.is_ca and leaf.key is .Ec(_)
    assert leaf.signature_algorithm == .Ecdsa(algo: .Sha256)
    assert leaf.not_before == at(2025, 1, 1) and leaf.not_after == at(2035, 1, 1)
    assert leaf.key_usage == [0]
    assert leaf.ext_key_usage == ["1.3.6.1.5.5.7.3.1"]
    let inter = load("inter")
    assert inter.is_ca and inter.path_len == 0 and inter.key_usage == [5, 6]
    let root = load("root_rsa")
    assert root.key is .Rsa(_) and root.is_ca and root.path_len == -1 and root.subject == root.issuer
    assert load("leaf_rsa").signature_algorithm == .Ecdsa(algo: .Sha384)
    assert load("leaf_sha512").key_usage is none and load("leaf_sha512").ext_key_usage is none
    assert load("odd_critical").unknown_critical == "1.2.3.4"
}

test "good chains" {
    assert ok(["leaf", "inter"], "example.test")
    assert ok(["leaf", "inter"], "www.example.test")
    assert ok(["leaf", "inter"], "WWW.Example.Test.")
    assert ok(["leaf", "inter"], "127.0.0.1")
    assert ok(["leaf_rsa"], "rsa.example.test")
    assert ok(["leaf_sha512"], "big.example.test")
    // Certificates that aren't on the way are passed over.
    assert ok(["leaf", "leaf_rsa", "not_ca", "inter"], "example.test")
    let path = x509.verify([load("leaf"), load("inter")], host: "example.test", roots: roots(), now: at(2026, 6, 1))
    assert [c.common_name() for c in must path] == ["leaf", "inter", "root_rsa"]
}

test "the wrong host" {
    assert why(["leaf", "inter"], "a.b.example.test") == "x509 verify: the certificate is for leaf, not a.b.example.test"
    assert not ok(["leaf", "inter"], "example.com")
    assert not ok(["leaf", "inter"], "test")
    assert not ok(["leaf", "inter"], "127.0.0.2")
    assert not ok(["leaf_rsa"], "example.test")
}

test "chains that don't verify" {
    assert why(["expired", "inter"], "example.test") == "x509 verify: the certificate for expired has expired"
    assert why(["not_yet", "inter"], "example.test") == "x509 verify: the certificate for not_yet isn't valid yet"
    assert why(["client_only", "inter"], "example.test") == "x509 verify: the certificate isn't for a server"
    assert why(["odd_critical", "inter"], "example.test") == "x509 verify: the certificate for odd_critical has an unknown critical extension 1.2.3.4"
    assert why(["no_sign", "inter"], "example.test") == "x509 verify: the certificate's key may not sign"
    // Missing the intermediate, issued by a certificate that isn't a CA,
    // and a CA below one whose path length is 0.
    assert why(["leaf"], "example.test") == "x509 verify: the certificate for leaf doesn't lead to a trusted root"
    assert not ok(["under_not_ca", "not_ca", "inter"], "example.test")
    assert not ok(["under_inter2", "inter2", "inter"], "example.test")
    assert x509.verify([], host: "example.test", roots: roots(), now: at(2026, 6, 1)) is Error
    // Not trusted, or trusted only after the root has expired.
    assert x509.verify([load("leaf"), load("inter")], host: "example.test", roots: [load("root_ec")], now: at(2026, 6, 1)) is Error
    assert x509.verify([load("leaf"), load("inter")], host: "example.test", roots: roots(), now: at(2035, 6, 1)) is Error
}

test "a changed byte breaks the signature" {
    let good = load("leaf")
    let der = good.raw
    // The last byte of the subject's name: "leaf" becomes "leag".
    mut at_name = -1
    for i in 0..len(der) - len(good.subject) {
        if der[i..i + len(good.subject)] == good.subject {
            at_name = i + len(good.subject) - 1
        }
    }
    mut changed = [b for b in der]
    changed[at_name] = changed[at_name] ^ 1
    let forged = must x509.parse(kod_bytes_from_array(changed))
    assert forged.common_name() == "leag"
    assert why(["leaf", "inter"], "example.test") == ""
    let r = x509.verify([forged, load("inter")], host: "example.test", roots: roots(), now: at(2026, 6, 1))
    assert r is Err(_)
}

test "github.com, 2026-11-26" {
    let chain = load_all("github_chain")
    let root = load("usertrust_ecc_root")
    let path = must x509.verify(chain, host: "github.com", roots: [root], now: at(2026, 11, 26))
    assert len(path) == 4 and path[3].common_name() == "USERTrust ECC Certification Authority"
    assert x509.verify(chain, host: "gitlab.com", roots: [root], now: at(2026, 11, 26)) is Error
    assert x509.verify(chain, host: "github.com", roots: [root], now: at(2027, 2, 1)) is Error
}

test "host names" {
    assert x509.host_matches("*.example.test", "a.example.test")
    assert not x509.host_matches("*.example.test", "example.test")
    assert not x509.host_matches("*.example.test", "a.b.example.test")
    assert not x509.host_matches("*.test", "a.test")
    assert not x509.host_matches("a*.example.test", "ab.example.test")
    assert x509.host_matches("Example.TEST", "example.test")
    assert x509.ipv4("10.0.0.255") == b"\x0a\x00\x00\xff"
    assert x509.ipv4("10.0.0.256") is none and x509.ipv4("10.0.0") is none and x509.ipv4("a.b.c.d") is none
}

test "the system's roots" {
    let all = must x509.system_roots()
    assert len(all) > 50
    for r in all {
        assert r.subject == r.issuer or len(r.subject) > 0
    }
    // macOS's root keychain has roots its /etc/ssl/cert.pem lacks, such as
    // the one example.com's chain ends at (2026-11-27).
    assert "SSL.com TLS ECC Root CA 2022" in [r.common_name() for r in all]
}

test "the certificates of a keychain, as `security` lists them" {
    let path = "/System/Library/Keychains/SystemRootCertificates.keychain"
    let file = must open_read(path)
    let data = must file.read_all()
    must file.close()
    let ders = must x509.keychain_certificates(data)
    let listed = must process.output(["/usr/bin/security", "find-certificate", "-a", "-p", path])
    assert ders == must x509.pem_certificates(listed.stdout)
    // What isn't a keychain is an error; one cut short gives an error or
    // some of its certificates, whole; one changed, no crash.
    assert x509.keychain_certificates(b"") is Error
    assert x509.keychain_certificates(b"not a keychain at all") is Error
    for n in [4, 16, 40, 100, 1000, 10000, len(data) / 2, len(data) - 1] {
        let got = x509.keychain_certificates(data[..n])
        if got is Ok(some) {
            assert len(some) <= len(ders)
            for d in some {
                assert d in ders
            }
        }
    }
    mut seed: int64 = 7
    for _i in 0..300 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let at = (seed / 64) % 4096
        let changed = data[..at] + kod_bytes_from_array([(seed / 7) % 256]) + data[at + 1..]
        let _ = x509.keychain_certificates(changed)
    }
}

test "DER that isn't strict" {
    let leaf = load("leaf")
    // Bytes after the certificate, and a length cut short.
    assert x509.parse(leaf.raw + b"\x00") is Error
    assert x509.parse(leaf.raw[..len(leaf.raw) - 1]) is Error
    assert x509.parse(b"") is Error
    assert x509.parse(b"\x30\x81\x05\x01\x01\x00\x01\x00") is Error
}
