// A function returning a str or none, matched by the caller.
func find(anon haystack: str, anon needle: int64) -> str? {
    mut i: int64 = 0
    for i < len(haystack) {
        if haystack[i] == needle {
            return haystack[i..i+1]
        }
        i = i + 1
    }
    return none
}

test "matching a found and a missing str" {
    let result: str? = find("hello", 'e')
    match result {
        none -> fail("not found")
        Some(c) -> assert c == "e"
    }
    let missing: str? = find("hello", 'z')
    match missing {
        none -> {}
        Some(c) -> fail(f"found {c}")
    }
}
