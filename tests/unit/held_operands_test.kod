// An operand, an argument or a receiver is the value it was when it was worked out, and
// is kept until it has been used, whatever working out the ones after it changes: the
// local it was in, the field of a shared struct, or the array it was an element of. The
// gates run this with freed memory poisoned too.

func set(mut s: str) -> str {
    s = "new" + s
    return "r"
}

func seta(mut xs: [str]) -> int64 {
    xs = ["n" + xs[0]]
    return 0
}

func two(anon a: str, anon b: str) -> str {
    for i in [1] { if i == 2 { return "" } }
    return f"{a}|{b}"
}

func app(anon a: [str], anon b: [str]) -> [str] { return a + b }
func setr(mut xs: [str]) -> [str] {
    xs = ["n" + xs[0]]
    return ["r"]
}

func mk(anon i: int64) -> str { return f"v{i}" }
func opt(mut o: str?) -> str {
    o = none
    return "r"
}

type SH = shared struct {
    s: str
    xs: [str]
    func chg(self) -> str {
        self.s = "new" + self.s
        self.xs = ["q" + self.s]
        return "r"
    }
    func idx(self) -> int64 {
        self.xs = ["q" + self.s]
        return 0
    }
    func m(self, anon a: str) -> str { return self.s + a }
    func late(self, anon a: str) -> str {
        self.s = "new" + self.s
        self.xs = ["w"]
        return a + "!"
    }
    func pair(self, anon a: str, anon b: str) -> str {
        for i in [1] { if i == 2 { return "" } }
        return f"{a}|{b}"
    }
    func lates(self, anon a: [str]) -> str {
        self.xs = ["new"]
        return f"{a}"
    }
}

interface Pairer {
    func pair(self, anon a: str, anon b: str) -> str
    func late(self, anon a: str) -> str
}

type E = enum {
    A(x: str, y: str)
    B
    func pair(self, anon a: str, anon b: str) -> str {
        for i in [1] { if i == 2 { return "" } }
        return f"{a}|{b}"
    }
}

mut gs: str = mk(1)
mut gxs: [str] = [mk(1)]
func glate(anon a: str) -> str {
    gs = "new" + gs
    return a + "!"
}

func glates(anon a: [str]) -> str {
    gxs = ["z"]
    return f"{a}"
}

func both(anon a: str, mut b: str) -> str {
    b = "chg" + b
    return f"{a}|{b}"
}

func bothr(mut b: str, a: str) -> str {
    b = "chg" + b
    return f"{a}|{b}"
}

func bothx(anon a: [str], mut b: [str]) -> str {
    b += ["q"]
    b = ["n"]
    return f"{a}|{b}"
}

type V = struct {
    s: str
    func show(self, anon a: str) -> str { return self.s + a }
    func chg(mut self) -> str {
        self.s = "new" + self.s
        return "r"
    }
}

func chv(mut v: V) -> str {
    v.s = "new" + v.s
    return "r"
}

func repl(mut v: V) -> str {
    v = V(s: mk(8) + "z")
    return "r"
}

func clo(anon k: int64) -> func(str) -> str {
    let t = mk(k)
    return func(anon a: str) -> str { return t + a }
}

func setf(mut f: func(str) -> str) -> str {
    f = clo(77)
    return "r"
}

// Form `k` of taking an operand that what comes after it changes.
func form(anon k: int64, i: int64) -> str {
    gs = mk(1)
    gxs = [mk(1)]
    for _ in 0..1 {
        mut s = mk(i)
        mut xs = [mk(i), mk(i + 1)]
        mut o: str? = mk(i)
        mut v = V(s: mk(i))
        let sh = SH(s: mk(i), xs: [mk(i)])
        mut f = clo(i)
        mut out = ""
        match k {
            0 -> out = two(s, set(s: mut s))
            1 -> out = s + set(s: mut s)
            2 -> out = f"{s < set(s: mut s)} {s}"
            3 -> out = f"{s}{set(s: mut s)}"
            4 -> out = two(s, if i >= 0 {
                s = mk(i + 10)
                s
            } else { "" })
            5 -> out = s + if i >= 0 {
                s = mk(i + 10)
                s
            } else { "" }
            6 -> out = xs[seta(xs: mut xs)]
            7 -> out = f"{xs + setr(xs: mut xs)}"
            8 -> out = f"{app(xs, setr(xs: mut xs))}"
            9 -> out = f"{xs == setr(xs: mut xs)}"
            10 -> out = s[seta(xs: mut xs)..len(set(s: mut s)) + 1]
            11 -> out = f"{[s, set(s: mut s), s]}"
            12 -> out = f"{(s, set(s: mut s), s)}"
            13 -> out = s.replace("v", to: set(s: mut s))
            14 -> out = xs[0] + f"{setr(xs: mut xs)}"
            15 -> out = two(xs[0], f"{setr(xs: mut xs)}")
            16 -> out = two(o? or "-", opt(o: mut o))
            17 -> out = sh.s + sh.chg()
            18 -> out = two(sh.s, sh.chg())
            19 -> out = sh.xs[sh.idx()]
            20 -> out = f"{sh.xs + [sh.chg()]}"
            21 -> out = f"{sh.xs == [sh.chg()]}"
            22 -> out = sh.xs[0] + sh.chg()
            23 -> out = v.show(chv(v: mut v))
            24 -> out = v.show(repl(v: mut v))
            25 -> out = v.s + repl(v: mut v)
            26 -> out = v.s + v.chg()
            27 -> out = f(setf(f: mut f))
            28 -> out = sh.xs[0][sh.idx()..]
            29 -> out = f"{s:>6}{set(s: mut s):>3}"
            30 -> {
                xs[seta(xs: mut xs)] = s
                out = f"{xs}"
            }
            31 -> {
                xs[seta(xs: mut xs)] += "q"
                out = f"{xs}"
            }
            32 -> out = two(a_of(s), set(s: mut s))
            33 -> out = f"{s == "v0" and set(s: mut s) == s}"
            34 -> out = ", ".join([s, set(s: mut s)])
            35 -> {
                for x in xs {
                    out += x + f"{seta(xs: mut xs)}"
                }
            }
            36 -> {
                match s {
                    "v0" -> out = set(s: mut s) + s
                    else -> {
                        s = mk(50)
                        out = s
                    }
                }
            }
            37 -> {
                if o is Some(q) {
                    o = none
                    out = q + "x"
                }
            }
            38 -> out = v.s + f"{v == V(s: repl(v: mut v))}"
            39 -> out = f"{v == V(s: repl(v: mut v))}"
            40 -> {
                s += set(s: mut s)
                out = s
            }
            41 -> {
                xs += setr(xs: mut xs)
                out = f"{xs}"
            }
            42 -> {
                v.s += repl(v: mut v)
                out = v.s
            }
            43 -> out = s.upper() + set(s: mut s) + s.lower()
            44 -> out = sh.late(sh.s)
            45 -> out = sh.pair(sh.s, sh.chg())
            46 -> out = sh.pair(s, set(s: mut s))
            47 -> out = sh.lates(sh.xs)
            48 -> {
                let pr: Pairer = sh
                out = pr.pair(sh.s, sh.chg()) + pr.late(sh.s)
            }
            49 -> {
                let e: E = .A(x: s, y: set(s: mut s))
                if e is .A(x, y) {
                    out = x + y + e.pair(s, set(s: mut s)) + e.pair(sh.s, sh.chg())
                }
            }
            50 -> out = glate(gs)
            51 -> out = glates(gxs)
            52 -> out = gs + glate("a") + gs
            53 -> out = both(s, b: mut s)
            54 -> out = bothr(b: mut s, a: s)
            55 -> out = bothx(xs, b: mut xs) + f"{xs}"
            56 -> {
                if s < set(s: mut s) and sh.s != sh.chg() {
                    out = s
                }
            }
            57 -> out = sh.late(sh.xs[0])
            58 -> {
                let g = func(anon a: str) -> str { return sh.late(a) }
                out = g(sh.s)
            }
            59 -> out = f"{E.A(x: sh.s, y: sh.chg()) is .A(_, _)}{SH(s: sh.s, xs: [sh.chg()]).s}"
            60 -> out = (if i > 0 { s } else { "z" }) + set(s: mut s)
            61 -> {
                for x in sh.xs {
                    out += x + sh.chg() + x
                }
            }
            62 -> {
                match sh.s {
                    "v0" -> out = sh.chg() + "m"
                    else -> out = sh.chg()
                }
            }
            63 -> {
                let t = sh.s
                out = sh.chg() + t
            }
            64 -> out = sh.xs[0..len(sh.chg())][0] + sh.xs[0]
            65 -> out = must_str(o) + opt(o: mut o)
            66 -> out = (must o) + opt(o: mut o)
            67 -> out = (o? or "-") + opt(o: mut o)
            68 -> out = two((must o), opt(o: mut o))
            else -> out = "none"
        }
        return out
    }
    return ""
}

func must_str(anon o: str?) -> str { return must o }
func a_of(anon s: str) -> str { return s }

let WANTED: [str] = [
    "v0|r",
    "v0r",
    "false newv0",
    "v0r",
    "v0|v10",
    "v0v10",
    "nv0",
    "[v0, v1, r]",
    "[v0, v1, r]",
    "false",
    "ne",
    "[v0, r, newv0]",
    "(v0, r, newv0)",
    "r0",
    "v0[r]",
    "v0|[r]",
    "v0|r",
    "v0r",
    "v0|r",
    "qv0",
    "[v0, r]",
    "false",
    "v0r",
    "v0r",
    "v0r",
    "v0r",
    "v0r",
    "v0r",
    "qv0",
    "    v0  r",
    "[v0]",
    "[nv0q]",
    "v0|r",
    "false",
    "v0, r",
    "v00v10",
    "rnewv0",
    "v0x",
    "v0false",
    "false",
    "v0r",
    "[nv0, r]",
    "v0r",
    "V0rnewv0",
    "v0!",
    "v0|r",
    "v0|r",
    "[v0]",
    "v0|rnewv0!",
    "v0rnewv0|rv0|r",
    "v1!",
    "[v1]",
    "v1a!newv1",
    "v0|chgv0",
    "v0|chgv0",
    "[v0, v1]|[n][n]",
    "",
    "v0!",
    "v0!",
    "truenewv0",
    "zr",
    "v0rv0",
    "rm",
    "rv0",
    "qnewv0qnewv0",
    "v0r",
    "v0r",
    "v0r",
    "v0|r",
]

test "every form gives what came first as it was" {
    for k, want in WANTED {
        assert f"{k} {form(k, i: 0)}" == f"{k} {want}"
    }
}

extern func rc_live_bytes() -> int64

test "what was kept is given up" {
    for k, _ in WANTED {
        for i in 0..30 {
            let _ = form(k, i: i % 3)
        }
        let before = rc_live_bytes()
        for i in 0..300 {
            let _ = form(k, i: i % 3)
        }
        assert rc_live_bytes() - before < 2000
    }
}

test "an index is worked out before the element is read" {
    mut xs = [10]
    assert xs[pushed(xs: mut xs, x: 20)] == 20
    assert xs[0..pushed(xs: mut xs, x: 30) + 1] == [10, 20, 30]
}

func pushed(mut xs: [int64], x: int64) -> int64 {
    xs += [x]
    return len(xs) - 1
}

type Num = struct {
    xs: [int64]

    func op_add(self, other: Num) -> Num {
        return Num(xs: self.xs + other.xs)
    }

    func op_rmul(self, k: int64) -> Num {
        return Num(xs: self.xs * k)
    }

    func op_div(self, other: Num) -> str {
        return f"{self.xs}"
    }
}

func sums(anon i: int64) -> int64 {
    let a = Num(xs: [i])
    mut b = a + a
    b += a
    b = 2 * b
    return len(b.xs) + len((a + b + a).xs) + len(a / b) + len(f"{b / a}")
}

test "what an operator of a struct's gives is given up" {
    mut n = sums(1)
    let before = rc_live_bytes()
    for i in 0..500 {
        n += sums(i)
    }
    assert n > 0 and rc_live_bytes() - before < 1000
}
