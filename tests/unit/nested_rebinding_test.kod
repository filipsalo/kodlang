// A block can bind a name that an enclosing block or a parameter still has
// bound. The outer binding keeps its own value and type, also on the paths
// where the block doesn't run.
type A = shared struct {
    x: int64

    func show(self) -> str {
        return f"A{self.x}"
    }
}

type B = shared struct {
    x: int64

    func show(self) -> str {
        return f"B{self.x}"
    }
}

mut log: [str] = []

func param_in_if(anon item: A, anon flag: bool) -> str {
    if flag {
        let item = B(x: 9)
        return item.show()
    }
    return item.show()
}

func let_in_if(anon n: int64) -> str {
    let r = A(x: 1)
    if n > 5 {
        let r = B(x: 2)
        log += [r.show()]
    }
    return r.show()
}

func arm_binding(anon o: str?) -> int64 {
    let x = 5
    match o {
        Some(x) -> log += [x]
        none -> log += ["none"]
    }
    return x + 1
}

func loop_var(anon xs: [str]) -> int64 {
    let x = 5
    for x in xs {
        log += [x]
    }
    return x + 1
}

func if_is_param(anon b: A, o: str?) -> int64 {
    if o is Some(b) {
        log += [b]
    }
    return b.x
}

func value_arm(anon n: int64?, m: int64?) -> int64 {
    return match n {
        Some(v) -> match m {
            Some(v) -> v
            none -> 0
        }
        none -> 1
    }
}

test "an inner binding leaves the outer one alone" {
    assert param_in_if(A(x: 1), false) == "A1"
    assert param_in_if(A(x: 1), true) == "B9"
    assert let_in_if(1) == "A1"
    assert arm_binding("hi") == 6
    assert loop_var(["a"]) == 6
    assert if_is_param(A(x: 3), o: "hi") == 3
    assert log == ["hi", "a", "hi"]
    assert value_arm(1, m: 2) == 2
}

test "a block that runs binds its own value" {
    assert let_in_if(6) == "A1"
    assert log == ["B2"]
}
