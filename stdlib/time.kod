// Time primitives backed by `clock_gettime` in stdlib/runtime.c.
//
// Two clocks, two contracts:
//
//   - `monotonic_ns()` — never goes backwards. Use for measuring
//     elapsed time (`let t0 = time.monotonic_ns(); do_work(); let
//     dt = time.monotonic_ns() - t0`). The origin is unspecified;
//     only differences are meaningful.
//
//   - `unix_ns()` — wall clock, nanoseconds since 1970-01-01 UTC.
//     Use for timestamps and for cross-process / cross-run
//     comparisons. Can jump backwards if the system clock is
//     adjusted; not safe for elapsed-time measurement.
//
// The clocks return int64 nanoseconds, which covers ~292 years. A `Duration`
// is a length of time, and `sleep` waits for one.
extern func kod_monotonic_ns() -> int64
extern func kod_unix_ns() -> int64
extern func kod_sleep_ns(anon ns: int64) -> none

func monotonic_ns() -> int64 {
    return kod_monotonic_ns()
}

func unix_ns() -> int64 {
    return kod_unix_ns()
}

// A length of time, in nanoseconds. See docs/time.md.
type Duration = struct {
    ns: int64

    // The units given add up: `Duration(minutes: 1, seconds: 30)`; write them largest first.
    func init(hours: int64 = 0, minutes: int64 = 0, seconds: int64 = 0, ms: int64 = 0, us: int64 = 0, ns: int64 = 0) -> Duration {
        return Duration(ns: ns + us * 1000 + ms * 1000000 + seconds * 1000000000 + minutes * 60000000000 + hours * 3600000000000)
    }

    func op_add(self, other: Duration) -> Duration {
        return Duration(ns: self.ns + other.ns)
    }

    func op_sub(self, other: Duration) -> Duration {
        return Duration(ns: self.ns - other.ns)
    }

    // `-d` is `0 - d`.
    func op_rsub(self, k: int64) -> Duration {
        return Duration(ns: k - self.ns)
    }

    func op_mul(self, k: int64) -> Duration {
        return Duration(ns: self.ns * k)
    }

    func op_rmul(self, k: int64) -> Duration {
        return Duration(ns: self.ns * k)
    }

    func op_div(self, k: int64) -> Duration {
        return Duration(ns: self.ns / k)
    }

    func op_eq(self, other: Duration) -> bool {
        return self.ns == other.ns
    }

    func op_lt(self, other: Duration) -> bool {
        return self.ns < other.ns
    }

    // Whole milliseconds, truncated toward zero.
    func as_ms(self) -> int64 {
        return self.ns / 1000000
    }

    // Milliseconds, rounded up: what a timeout in milliseconds needs, so that a short one is not 0.
    func ceil_ms(self) -> int64 {
        if self.ns > 0 {
            return (self.ns + 999999) / 1000000
        }
        return self.ns / 1000000
    }

    // Whole seconds, truncated toward zero.
    func as_seconds(self) -> int64 {
        return self.ns / 1000000000
    }

    // Whole hours, truncated toward zero.
    func as_hours(self) -> int64 {
        return self.ns / 3600000000000
    }

    // Whole 24-hour days, truncated toward zero.
    func as_days(self) -> int64 {
        return self.ns / 86400000000000
    }

    func to_str(self) -> str {
        if self.ns == 0 {
            return "0s"
        }
        mut n = self.ns
        mut sign = ""
        if n < 0 {
            sign = "-"
            n = 0 - n
        }
        if n < 1000 {
            return sign + n.to_str() + "ns"
        }
        if n < 1000000 {
            return sign + decimal(n / 1000, n % 1000, scale: 1000) + "us"
        }
        if n < 1000000000 {
            return sign + decimal(n / 1000000, n % 1000000, scale: 1000000) + "ms"
        }
        let whole_seconds = n / 1000000000
        let hours = whole_seconds / 3600
        let minutes = (whole_seconds % 3600) / 60
        let secs = decimal(whole_seconds % 60, n % 1000000000, scale: 1000000000) + "s"
        if hours > 0 {
            return sign + hours.to_str() + "h" + minutes.to_str() + "m" + secs
        }
        if minutes > 0 {
            return sign + minutes.to_str() + "m" + secs
        }
        return sign + secs
    }
}

// `whole` and `frac` of a unit worth `scale` (a power of ten) of the next one down, as `12.5`.
func decimal(anon whole: int64, anon frac: int64, scale: int64) -> str {
    if frac == 0 {
        return whole.to_str()
    }
    let digits = len(scale.to_str()) - 1
    let raw = frac.to_str()
    let padded = "0".repeat(digits - len(raw)) + raw
    mut end = len(padded)
    for end > 0 and padded[end - 1] == '0' {
        end -= 1
    }
    return whole.to_str() + "." + padded[0..end]
}

// Wait at least `d`; a signal doesn't cut it short, and zero or less returns at once.
func sleep(anon d: Duration) -> none {
    kod_sleep_ns(d.ns)
}

// A moment: `seconds` since 1970-01-01 UTC, negative before it, and `nanos`
// from 0 to 999999999 on top. See docs/time.md.
type Time = struct {
    seconds: int64
    nanos: int64 = 0

    func op_add(self, other: Duration) -> Time {
        mut whole = _floor_div(other.ns, 1000000000)
        mut nanos = self.nanos + (other.ns - whole * 1000000000)
        if nanos >= 1000000000 {
            nanos -= 1000000000
            whole += 1
        }
        return Time(seconds: self.seconds + whole, :nanos)
    }

    func op_sub(self, other: Time) -> Duration {
        return Duration(ns: (self.seconds - other.seconds) * 1000000000 + self.nanos - other.nanos)
    }

    func op_eq(self, other: Time) -> bool {
        return self.seconds == other.seconds and self.nanos == other.nanos
    }

    func op_lt(self, other: Time) -> bool {
        if self.seconds != other.seconds {
            return self.seconds < other.seconds
        }
        return self.nanos < other.nanos
    }

    func utc(self) -> Utc {
        let days = _floor_div(self.seconds, 86400)
        let rest = self.seconds - days * 86400
        // Howard Hinnant's civil_from_days: years run from March, in eras of 400.
        let z = days + 719468
        let era = _floor_div(z, 146097)
        let doe = z - era * 146097
        let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
        let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
        let mp = (5 * doy + 2) / 153
        let day = doy - (153 * mp + 2) / 5 + 1
        mut month = mp + 3
        mut year = yoe + era * 400
        if mp >= 10 {
            month = mp - 9
            year += 1
        }
        return Utc(:year, :month, :day, hour: rest / 3600, minute: rest % 3600 / 60, second: rest % 60)
    }

    func to_str(self) -> str {
        let u = self.utc()
        mut fraction = ""
        if self.nanos > 0 {
            mut digits = _pad(self.nanos, width: 9)
            mut end = len(digits)
            for digits[end - 1] == '0' {
                end -= 1
            }
            fraction = "." + digits[0..end]
        }
        return f"{_pad(u.year, width: 4)}-{_pad(u.month, width: 2)}-{_pad(u.day, width: 2)}T{_pad(u.hour, width: 2)}:{_pad(u.minute, width: 2)}:{_pad(u.second, width: 2)}{fraction}Z"
    }
}

// A `Time` as UTC calendar fields; `month` runs from 1 to 12.
type Utc = struct {
    year: int64
    month: int64
    day: int64
    hour: int64
    minute: int64
    second: int64
}

func now() -> Time {
    let ns = kod_unix_ns()
    return Time(seconds: ns / 1000000000, nanos: ns % 1000000000)
}

// The time of an RFC 3339 timestamp, or none if `s` isn't one.
func parse(anon s: str) -> Time? {
    // The shortest is `2026-01-02T03:04:05Z`.
    if len(s) < 20 or (s[10] != 'T' and s[10] != 't') or s[13] != ':' or s[16] != ':' {
        return none
    }
    let .Some(date) = parse_date(s[0..10]) else { return none }
    let .Some(hour) = _digits(s, at: 11, count: 2) else { return none }
    let .Some(minute) = _digits(s, at: 14, count: 2) else { return none }
    let .Some(second) = _digits(s, at: 17, count: 2) else { return none }
    if hour > 23 or minute > 59 or second > 60 {
        return none
    }
    // A fraction: at least one digit, and past the ninth they're dropped.
    mut i = 19
    mut nanos = 0
    if s[i] == '.' {
        i += 1
        let first = i
        mut scale = 100000000
        for i < len(s) and s[i] >= '0' and s[i] <= '9' {
            nanos += (s[i] - '0') * scale
            scale = scale / 10
            i += 1
        }
        if i == first {
            return none
        }
    }
    if i >= len(s) {
        return none
    }
    mut offset = 0
    if s[i] == 'Z' or s[i] == 'z' {
        i += 1
    } else {
        if (s[i] != '+' and s[i] != '-') or len(s) != i + 6 or s[i + 3] != ':' {
            return none
        }
        let .Some(off_hour) = _digits(s, at: i + 1, count: 2) else { return none }
        let .Some(off_minute) = _digits(s, at: i + 4, count: 2) else { return none }
        if off_hour > 23 or off_minute > 59 {
            return none
        }
        offset = off_hour * 3600 + off_minute * 60
        if s[i] == '-' {
            offset = 0 - offset
        }
        i += 6
    }
    if i != len(s) {
        return none
    }
    return Time(seconds: date.seconds + hour * 3600 + minute * 60 + second - offset, :nanos)
}

// Midnight UTC of a `YYYY-MM-DD` date, or none if `s` isn't one.
func parse_date(anon s: str) -> Time? {
    if len(s) != 10 or s[4] != '-' or s[7] != '-' {
        return none
    }
    let .Some(year) = _digits(s, at: 0, count: 4) else { return none }
    let .Some(month) = _digits(s, at: 5, count: 2) else { return none }
    let .Some(day) = _digits(s, at: 8, count: 2) else { return none }
    if month < 1 or month > 12 or day < 1 or day > _days_in_month(:year, :month) {
        return none
    }
    return Time(seconds: _days_from_civil(:year, :month, :day) * 86400)
}

// `count` decimal digits of `s` from `at`, which are in range, or none.
func _digits(anon s: str, at: int64, count: int64) -> int64? {
    mut n = 0
    for i in at..at + count {
        if s[i] < '0' or s[i] > '9' {
            return none
        }
        n = n * 10 + (s[i] - '0')
    }
    return n
}

func _days_in_month(year: int64, month: int64) -> int64 {
    if month == 2 {
        if year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) {
            return 29
        }
        return 28
    }
    if month == 4 or month == 6 or month == 9 or month == 11 {
        return 30
    }
    return 31
}

// Days since 1970-01-01 of a date: Howard Hinnant's days_from_civil.
func _days_from_civil(year: int64, month: int64, day: int64) -> int64 {
    mut y = year
    mut shifted = month - 3
    if month <= 2 {
        y -= 1
        shifted = month + 9
    }
    let era = _floor_div(y, 400)
    let yoe = y - era * 400
    let doy = (153 * shifted + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

func _floor_div(anon a: int64, anon b: int64) -> int64 {
    let q = a / b
    if a % b < 0 {
        return q - 1
    }
    return q
}

func _pad(anon n: int64, width: int64) -> str {
    let text = n.to_str()
    if len(text) >= width {
        return text
    }
    return "0".repeat(width - len(text)) + text
}
