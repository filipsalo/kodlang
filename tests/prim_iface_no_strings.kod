// Boxing primitives into an interface in a module without any string
// literal still emits their vtables.
interface Printable {
    func to_str(self) -> str
}

func show(anon x: Printable) -> none {
    print(x.to_str())
}

func main() -> int64 {
    show(42)
    show(true)
    return 0
}

// expected output:
// 42
// true
