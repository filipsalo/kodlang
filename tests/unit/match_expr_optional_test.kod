// A none or optional arm makes a match expression optional; each arm is wrapped or boxed for the match's type.
interface Shape {
    func area(self) -> int64
}
type Sq = shared struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type Circle = shared struct {
    r: int64
    func area(self) -> int64 { return 3 * self.r * self.r }
}
type Tag = shared struct {
    name: str
}

func mixed(anon k: int64, t: Tag?) -> str? {
    return match k {
        1 -> t?.name
        else -> "fallback"
    }
}

func maybe_num(anon k: int64) -> int64? {
    return match k {
        0 -> 0
        1 -> 10
        else -> none
    }
}

func zero(anon k: int64) -> int64? {
    return match k {
        1 -> 1
        else -> 0
    }
}

func pick(anon k: int64) -> Shape {
    return match k {
        1 -> Sq(s: 4)
        else -> Circle(r: 3)
    }
}

test "optional arms in returns and lets" {
    let t: Tag? = Tag(name: "red")
    assert (mixed(1, :t)? or "none") == "red"
    assert (mixed(2, :t)? or "none") == "fallback"
    assert (mixed(1, t: none)? or "none") == "none"
    let k = 2
    let a: str? = match k {
        1 -> "x"
        else -> none
    }
    assert (a? or "none") == "none"
    let b = match k {
        2 -> "y"
        else -> none
    }
    assert (b? or "-") == "y"
    let c = match k {
        1 -> "z"
        else -> none
    }
    assert c == none
}

test "optional int arms keep zero" {
    assert (maybe_num(0)? or -1) == 0
    assert (maybe_num(1)? or -1) == 10
    assert (maybe_num(2)? or -1) == -1
    assert (zero(5)? or -1) == 0
}

test "arms boxed for an interface" {
    let k = 2
    let s: Shape = match k {
        1 -> Sq(s: 2)
        else -> Circle(r: 1)
    }
    assert s.area() == 3
    let shapes: [Shape] = [match k {
        2 -> Sq(s: 3)
        else -> Circle(r: 2)
    }]
    assert shapes[0].area() == 9
    assert pick(1).area() == 16
    assert pick(2).area() == 27
}
