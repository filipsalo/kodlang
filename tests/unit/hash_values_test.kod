// `hash(x)` gives fixed values: djb2 over the
// bytes of a `str` or `bytes`, an `int64` itself, 0 or 1 for a `bool`, and
// an enum value's variant.

type Color = enum {
    Red
    Green
    Blue
}

test "hash of strings and bytes is djb2" {
    assert hash("") == 5381
    assert hash("a") == 177670
    assert hash("abc") == 193485963
    assert hash("the quick brown fox jumps over the lazy dog") == 1653687373046440190
    assert hash(b"abc") == 193485963
    assert hash(b"\n") == 177583
    assert "abc".hash() == 193485963
}

test "hash of an int64 is itself" {
    assert hash(0) == 0
    assert hash(-5) == -5
    assert hash(1 << 40) == 1099511627776
}

test "hash of a bool and an enum" {
    assert hash(true) == 1
    assert hash(false) == 0
    assert hash(Color.Red) == 1
    assert hash(Color.Green) == 2
    let c: Color = .Blue
    assert hash(c) == 3
}
