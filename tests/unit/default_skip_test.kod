// A label can jump over parameters that have defaults.
import "./../default_skip_dep"

// The labels `trace` was called with, in order.
mut traced: [str] = []

func trace(anon label: str, anon value: int64) -> int64 {
    traced += [label]
    return value
}

func three(a: int64 = 1, b: int64 = 2, c: int64 = 3) -> int64 {
    return a * 100 + b * 10 + c
}

func connect(anon host: str, port: int64 = 80, timeout_ms: int64 = 5000, tls: bool = false) -> str {
    return f"{host}:{port} {timeout_ms}ms tls={tls}"
}

func mixed(anon n: int64, delay: int64 = 100, tries: int64 = 3) -> int64 {
    return n * delay + tries
}

func ordered(a: int64, b: int64 = trace("default b", 2), c: int64 = trace("default c", 3)) -> int64 {
    return a * 100 + b * 10 + c
}

func anon_default(anon first: int64 = 7, second: int64 = 8) -> int64 {
    return first * 10 + second
}

type Counter = shared struct {
    value: int64

    func add(self, by: int64 = 1, times: int64 = 1, extra: int64 = 0) -> int64 {
        self.value = self.value + by * times + extra
        return self.value
    }
}

interface Greeter {
    func greet(self, anon name: str, times: int64 = 2, loud: bool = false) -> str
}

type Dog = shared struct {
    sound: str

    func greet(self, anon name: str, times: int64 = 2, loud: bool = false) -> str {
        mut out = ""
        mut i = 0
        for i < times {
            out = out + self.sound
            i = i + 1
        }
        if loud {
            return f"{out}! {name}"
        }
        return f"{out} {name}"
    }
}

test "free functions" {
    assert three() == 123
    assert three(c: 9) == 129
    assert three(b: 5) == 153
    assert three(a: 7, c: 9) == 729
    assert three(b: 5, c: 6) == 156
    assert three(a: 4, b: 5, c: 6) == 456
    assert connect("example.com") == "example.com:80 5000ms tls=false"
    assert connect("example.com", timeout_ms: 200) == "example.com:80 200ms tls=false"
    assert connect("example.com", tls: true) == "example.com:80 5000ms tls=true"
    assert connect("example.com", port: 8443, tls: true) == "example.com:8443 5000ms tls=true"
    assert connect("h", timeout_ms: 1) == "h:80 1ms tls=false"
}

test "anon first, labeled rest" {
    assert mixed(2) == 203
    assert mixed(2, tries: 9) == 209
    assert mixed(2, delay: 5) == 13
    let tries = 4
    assert mixed(2, :tries) == 204
}

test "an anon parameter with a default can be jumped over" {
    assert anon_default() == 78
    assert anon_default(second: 1) == 71
    assert anon_default(5) == 58
    assert anon_default(5, second: 1) == 51
}

test "methods" {
    mut c = Counter(value: 0)
    assert c.add() == 1
    assert c.add(times: 3) == 4
    assert c.add(extra: 10) == 15
    assert c.add(by: 2, extra: 1) == 18
}

test "interface methods" {
    let g: Greeter = Dog(sound: "woof")
    assert g.greet("cat") == "woofwoof cat"
    assert g.greet("cat", loud: true) == "woofwoof! cat"
    assert g.greet("cat", times: 1) == "woof cat"
    assert g.greet("cat", times: 1, loud: true) == "woof! cat"
}

test "another module" {
    assert default_skip_dep.scaled(3) == 31
    assert default_skip_dep.traced == ["dep offset default"]
    assert default_skip_dep.scaled(3, offset: 5) == 35
    assert default_skip_dep.scaled(3, factor: 2) == 7
    assert default_skip_dep.traced == ["dep offset default", "dep offset default"]
    let gauge = default_skip_dep.Gauge(base: 4)
    assert gauge.read() == 40
    assert gauge.read(shift: 2) == 42
}

test "evaluation order, parameter by parameter" {
    assert ordered(a: trace("arg a", 1), c: trace("arg c", 4)) == 124
    assert traced == ["arg a", "default b", "arg c"]
    traced = []
    assert ordered(a: trace("arg a", 1), b: trace("arg b", 5)) == 153
    assert traced == ["arg a", "arg b", "default c"]
    traced = []
    assert ordered(a: trace("only a", 1)) == 123
    assert traced == ["only a", "default b", "default c"]
}
