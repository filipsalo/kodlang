// An arm may call a function that never returns, and `return match` in a `-> none` function needs no value.
func a() -> none {
    print("a")
}
func b() -> none {
    print("b")
}
func pick(anon k: int64) -> none {
    return match k {
        1 -> a()
        else -> b()
    }
}
func die(anon msg: str) -> none {
    panic(msg)
}
func refuse(anon k: int64) -> none {
    if k > 0 {
        panic("positive")
    } else {
        panic("not positive")
    }
}
func main() -> int64 {
    pick(1)
    pick(2)
    let k = 2
    let z = match k {
        2 -> 8
        else -> die("bad")
    }
    print_int(z)
    let w = match k {
        1 -> refuse(k)
        else -> 9
    }
    print_int(w)
    return 0
}

// expected output:
// a
// b
// 8
// 9
