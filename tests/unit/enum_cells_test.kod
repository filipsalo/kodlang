// A variant without a payload is one cell in the program's data: making one
// allocates nothing, whatever else its enum's variants carry.
extern func rc_live_bytes() -> int64

type Dir = enum {
    Up
    Down

    func flip(self) -> Dir {
        return match self {
            .Up -> .Down
            .Down -> .Up
        }
    }
}

type Shape = enum {
    Empty
    Square(side: int64)
}

func area(anon s: Shape) -> int64 {
    return match s {
        .Empty -> 0
        .Square(side) -> side * side
    }
}

test "making a variant without a payload allocates nothing" {
    let before = rc_live_bytes()
    let up = Dir.Up
    let empty: Shape = .Empty
    assert rc_live_bytes() - before == 0
    mut d = up
    mut total = 0
    for _ in 0..1000 {
        d = d.flip()
        total += area(empty)
    }
    assert rc_live_bytes() - before == 0
    assert d == Dir.Up
    assert total == 0
}

test "variants with and without payloads mix in an array" {
    let shapes: [Shape] = [.Empty, .Square(side: 3), .Empty]
    mut sum = 0
    for s in shapes {
        sum += area(s)
    }
    assert sum == 9
}
