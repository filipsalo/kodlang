// A generic enum variant is built as the instance it's passed, returned or stored as.
interface Shape {
    func area(self) -> int64
}
type Sq = struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}
type MaybeShape = Maybe[Shape]
func area_of(anon m: Maybe[Shape]) -> int64 {
    match m {
        .Just(value) -> return value.area()
        .Nothing -> return -1
    }
}
func make(anon n: int64) -> Maybe[Shape] {
    if n > 0 {
        return .Just(value: Sq(s: n))
    }
    return Maybe.Nothing
}
func try_make(anon n: int64) -> Maybe[Shape] or Error {
    if n > 1 {
        return .Just(value: Sq(s: n))
    }
    if n > 0 {
        return Maybe.Just(value: Sq(s: 1))
    }
    return .Nothing
}
func try_list() -> [Maybe[Shape]] or Error {
    return [.Just(value: Sq(s: 10)), .Nothing]
}
func opt(anon n: int64) -> MaybeShape? {
    if n > 0 {
        return Maybe.Just(value: Sq(s: n))
    }
    return none
}
func main() -> int64 {
    print_int(area_of(.Just(value: Sq(s: 3))))
    print_int(area_of(Maybe.Just(value: Sq(s: 4))))
    print_int(area_of(make(5)))
    print_int(area_of(make(0)))
    let m: Maybe[Shape] = .Just(value: Sq(s: 6))
    print_int(area_of(m))
    let o: MaybeShape? = .Just(value: Sq(s: 7))
    print_int(area_of(o?))
    print_int(area_of(opt(8)?))
    if opt(0) is none {
        print("none")
    }
    print_int(area_of(must try_make(2)))
    print_int(area_of(must try_make(1)))
    print_int(area_of(must try_make(0)))
    for m in must try_list() {
        print_int(area_of(m))
    }
    let sh: Shape? = Sq(s: 9)
    let shv: Shape = sh?
    print_int(shv.area())
    return 0
}

// expected mode:
// run
// expected output:
// 9
// 16
// 25
// -1
// 36
// 49
// 64
// none
// 4
// 1
// -1
// 100
// -1
// 81
