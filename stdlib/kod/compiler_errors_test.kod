test "an uninferable value is reported where it's used" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        func take(anon n: int64) -> none {
            print_int(n)
        }
        func give() -> int64 {
            return Maybe.Just(value: 1)
        }
        func main() -> int64 {
            take(Maybe.Just(value: 2))
            mut n: int64 = 0
            n = Maybe.Nothing
            let xs = [1, Maybe.Just(value: 3)]
            return 0
        }
        """)
    assert len(errs) == 4
    for e in errs {
        assert e.message.contains("cannot infer the type of this expression")
    }
}

test "an implicit variant the expected enum doesn't declare" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Dir = enum {
            Left
            Right
        }
        type Move = enum {
            Up
            Down
        }
        func main() -> int64 {
            let d: Dir = .Up
            let o: Dir? = .Down
            let r: Result[int64, str] = .Some(value: 1)
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "enum `Dir` has no variant `Up`")
    assert test_support.any_message_contains(errs, needle: "enum `Dir` has no variant `Down`")
    assert test_support.any_message_contains(errs, needle: "enum `Result[int64, str]` has no variant `Some`")
}

test "try, must and ? need a fallible or optional value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f() -> int64 or Error {
            let n = 5
            let c = try n
            return c
        }
        func g(anon r: int64 or Error) -> int64 {
            return try r
        }
        func main() -> int64 {
            let n = 5
            let b = n? or 3
            let a = must n
            let o: int64? = 4
            let ok = must f() + (o? or 0) + o?
            return 0
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "`try` needs a `T or Error` value, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`try` only works in a function that returns `T or Error`")
    assert test_support.any_message_contains(errs, needle: "`?` needs an optional value, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`must` needs a `T or Error` value, got `int64`")
}

test "match expression arms of different types" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        type Circle = struct {
            r: int64
            func area(self) -> int64 { return self.r }
        }
        func main() -> int64 {
            let k = 1
            let x = match k {
                1 -> "a"
                else -> 2
            }
            let s = match k {
                1 -> Sq(s: 2)
                else -> Circle(r: 1)
            }
            let n: str = match k {
                1 -> "a"
                else -> none
            }
            let ok: Shape = match k {
                1 -> Sq(s: 2)
                else -> Circle(r: 1)
            }
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "expected `str`, got `int64`")
    assert test_support.any_message_contains(errs, needle: "expected `Sq`, got `Circle`")
    assert test_support.any_message_contains(errs, needle: "expected `str`, got `none`")
}

test "a pattern naming another enum" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(radius: int64)
            Rect(w: int64, h: int64)
        }
        type Other = enum {
            Square
            Circle(r: int64, extra: int64)
        }
        func main() -> int64 {
            let s: Shape = .Circle(radius: 5)
            match s {
                Other.Square -> print("square")
                Shape.Circle(r) -> print_int(r)
                else -> print("else")
            }
            if s is Other.Circle(r, e) {
                print_int(r + e)
            }
            let n = match s {
                Other.Square -> 1
                else -> 2
            }
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "`Other.Square` is not a variant of `Shape`")
    assert test_support.any_message_contains(errs, needle: "`Other.Circle` is not a variant of `Shape`")
}

test "an implicit variant pattern from another enum" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(radius: int64)
            Rect(w: int64, h: int64)
        }
        type Other = enum {
            Square
            Circle(r: int64, extra: int64)
        }
        func main() -> int64 {
            let s: Shape = .Circle(radius: 5)
            match s {
                .Square -> print("square")
                .Circle(r) -> print_int(r)
                else -> print("else")
            }
            let n = match s {
                .Square -> 1
                else -> 2
            }
            let .Square = s else { return 1 }
            return 0
        }
        """)
    assert len(errs) == 3
    for e in errs {
        assert e.message.contains("enum `Shape` has no variant `Square`")
    }
}

