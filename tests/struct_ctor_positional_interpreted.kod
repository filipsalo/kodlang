// The interpreter asks for a constructor value's label, as the compiler does.
type Point = struct {
    x: int64
    y: int64
}

func main() -> int64 {
    print_int(Point(x: 1, y: 2).x)
    let p = Point(3, y: 4)
    print_int(p.x)
    return 0
}

// expected mode:
// interpret
// expected output:
// 1
// expected stderr:
// 9:19: error: argument 1 of `Point` needs a field label (`x:`)
// expected status:
// 1
