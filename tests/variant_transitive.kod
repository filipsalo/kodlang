// A context-free `.Variant` that no enum the module sees declares belongs
// to an enum of another loaded module, here one only `mid` imports.
import "./variant_transitive_mid"

func main() -> int64 {
    let g = .High
    print(variant_transitive_mid.name(g))
    print(variant_transitive_mid.name(variant_transitive_mid.low()))
    return 0
}

// expected output:
// high
// low
