// Guards: `pattern if cond -> body` falls through to the next arm when the condition is false.

type Shape = enum {
    Circle(radius: int64)
    Rect(w: int64, h: int64)
    Dot
}

type Token = enum {
    Plus
    Minus
    Star
}

mut guards: str = ""

func counted(n: int64) -> bool {
    guards += f"guard {n};"
    return n > 0
}

func label(shape: Shape) -> str {
    match shape {
        .Circle(r) if r > 100 -> return "big circle"
        .Circle(r) -> return f"circle {r}"
        .Rect(w, h) if w == h -> return "square"
        .Rect(_, _) -> return "rect"
        .Dot -> return "dot"
    }
}

func by_value(n: int64, s: str, flag: bool, o: int64?) -> str {
    let number = match n {
        0 if flag -> "zero, flagged"
        0 -> "zero"
        else -> "other"
    }
    let text = match s {
        "a" if n > 0 -> "a, positive"
        "a" -> "a"
        else -> "text"
    }
    let opt = match o {
        Some(v) if v < 0 -> "negative"
        Some(_) -> "some"
        none if flag -> "none, flagged"
        none -> "none"
    }
    let truth = match flag {
        true if n > 0 -> "yes"
        true -> "maybe"
        false -> "no"
    }
    return f"{number}/{text}/{opt}/{truth}"
}

func statement_arms(n: int64, flag: bool) -> str {
    mut out = "none"
    match n {
        1 if flag -> out = "one, flagged"
        1 -> {
            let x = n + 1
            out = f"one, then {x}"
        }
        else if flag {
            out = "else if"
        }
    }
    return out
}

func tokens(t: Token, ready: bool) -> str {
    match t {
        .Plus | .Minus if ready -> return "additive, ready"
        .Plus | .Minus -> return "additive"
        .Star -> return "star"
    }
}

func nested(best: Shape?, limit: int64) -> str {
    return match best {
        Some(.Circle(r)) if r > limit -> f"over {r}"
        Some(.Circle(r)) -> f"under {r}"
        Some(_) -> "other"
        none -> "none"
    }
}

// A failed guard, with a call in it, must not disturb the tests of later arms.
func after_calls(a: int64, b: int64) -> str {
    match a {
        1 if counted(n: b) -> return "first"
        2 if counted(n: b) -> return "second"
        3 if counted(n: b) -> return "third"
        1 -> return "one"
        2 -> return "two"
        else -> return "rest"
    }
}

func strings(s: str, b: int64) -> str {
    match s {
        "x" if counted(n: b) -> return "x, passed"
        "y" if counted(n: b) -> return "y, passed"
        "x" -> return "x"
        "y" -> return "y"
        else -> return "?"
    }
}

func hides(x: int64, o: int64?) -> int64 {
    match o {
        Some(x) if x > 10 -> return x
        Some(_) -> return x
        none -> return 0
    }
}

test "guards on enum payloads" {
    assert label(shape: .Circle(radius: 500)) == "big circle"
    assert label(shape: .Circle(radius: 5)) == "circle 5"
    assert label(shape: .Rect(w: 2, h: 2)) == "square"
    assert label(shape: .Rect(w: 2, h: 3)) == "rect"
    assert label(shape: .Dot) == "dot"
}

test "guards on ints, strings, optionals and bools" {
    assert by_value(n: 0, s: "a", flag: true, o: -1) == "zero, flagged/a/negative/maybe"
    assert by_value(n: 1, s: "a", flag: false, o: 1) == "other/a, positive/some/no"
    assert by_value(n: 0, s: "b", flag: false, o: none) == "zero/text/none/no"
    assert by_value(n: 1, s: "b", flag: true, o: none) == "other/text/none, flagged/yes"
}

test "guards in match statements" {
    assert statement_arms(n: 1, flag: true) == "one, flagged"
    assert statement_arms(n: 1, flag: false) == "one, then 2"
    assert statement_arms(n: 2, flag: true) == "else if"
    assert statement_arms(n: 2, flag: false) == "none"
}

test "guards on alternatives and nested patterns" {
    assert tokens(t: .Plus, ready: true) == "additive, ready"
    assert tokens(t: .Minus, ready: true) == "additive, ready"
    assert tokens(t: .Minus, ready: false) == "additive"
    assert tokens(t: .Star, ready: true) == "star"
    assert nested(best: Shape.Circle(radius: 9), limit: 3) == "over 9"
    assert nested(best: Shape.Circle(radius: 2), limit: 3) == "under 2"
    assert nested(best: Shape.Dot, limit: 3) == "other"
    assert nested(best: none, limit: 3) == "none"
}

test "a failed guard with a call leaves later arms alone" {
    assert after_calls(a: 1, b: 1) == "first"
    assert guards == "guard 1;"
    assert after_calls(a: 1, b: 0) == "one"
    assert after_calls(a: 2, b: 0) == "two"
    assert after_calls(a: 3, b: 0) == "rest"
    assert guards == "guard 1;guard 0;guard 0;guard 0;"
    assert strings(s: "x", b: 0) == "x"
    assert strings(s: "y", b: 0) == "y"
    assert strings(s: "y", b: 1) == "y, passed"
    assert guards == "guard 1;guard 0;guard 0;guard 0;guard 0;guard 0;guard 1;"
}

test "a guard sees the pattern's binding, not the shadowed one" {
    assert hides(x: 1, o: 50) == 50
    assert hides(x: 1, o: 5) == 1
}
