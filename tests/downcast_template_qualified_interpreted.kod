// The interpreter reports a downcast to a generic type as written.
import "./downcast_generic_xmod_dep"

func main() -> int64 {
    let s: downcast_generic_xmod_dep.Shape = downcast_generic_xmod_dep.boxed()
    let held = s is downcast_generic_xmod_dep.Box
    if held {
        return 1
    }
    return 0
}

// expected status:
// 1
// expected stderr:
// 6:21: error: `downcast_generic_xmod_dep.Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = downcast_generic_xmod_dep.Box[int64]`
// expected mode:
// interpret
