import "crypto/der"

test "lengths" {
    let short = must der.parse(b"\x04\x02ab")
    assert short.tag == der.OCTET_STRING and short.start == 2 and short.end == 4
    let long = must der.parse(b"\x04\x81\x80" + kod_bytes_from_array([0] * 128))
    assert long.start == 3 and long.end == 131
    // The long form for a length under 128, a length with a leading 0
    // byte, an indefinite length, and a length past the end.
    assert der.parse(b"\x04\x81\x02ab") is none
    assert der.parse(b"\x04\x82\x00\x80" + kod_bytes_from_array([0] * 128)) is none
    assert der.parse(b"\x30\x80\x00\x00") is none
    assert der.parse(b"\x04\x03ab") is none
    assert der.parse(b"\x04\x01ab") is none
    assert der.parse(b"\x1f\x01\x00") is none
}

test "children" {
    let seq = must der.parse(b"\x30\x06\x02\x01\x05\x01\x01\xff")
    let parts = must der.inside(b"\x30\x06\x02\x01\x05\x01\x01\xff", seq)
    assert len(parts) == 2 and parts[0].tag == der.INTEGER and parts[1].tag == der.BOOLEAN
    assert der.children(b"\x02\x01\x05\x02", from: 0, to: 4) is none
}

test "OIDs and integers" {
    assert der.oid_text(b"\x2a\x86\x48\x86\xf7\x0d\x01\x01\x0b") == "1.2.840.113549.1.1.11"
    assert der.oid_text(b"\x55\x1d\x11") == "2.5.29.17"
    assert der.oid_text(b"\x2b\x81\x04\x00\x22") == "1.3.132.0.34"
    assert der.oid_text(b"\x2a\x86") == ""
    assert der.oid_text(b"\x2a\x80\x01") == ""
    assert der.small_int(b"\x00\x80") == 128
    assert der.small_int(b"\x00\x01") is none
    assert der.small_int(b"\x80") is none
    assert der.bits(b"\x00\xab") == b"\xab"
    assert der.bits(b"\x01\xab") is none
}
