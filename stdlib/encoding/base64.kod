// RFC 4648 base64, standard and URL-safe alphabets. See docs/encoding.md.
import "stream" { IoError }
import "strbuilder" { StrBuilder }

// The 64 characters of the alphabet, in value order.
func alphabet(anon url: bool) -> str {
    if url {
        return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    }
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

func encode(anon data: bytes, url: bool = false, pad: bool = true) -> str {
    let table = alphabet(url)
    let out = StrBuilder()
    let n = len(data)
    mut i: int64 = 0
    for i + 3 <= n {
        let word = (data[i] << 16) | (data[i + 1] << 8) | data[i + 2]
        out.append_byte(table[(word >> 18) & 63])
        out.append_byte(table[(word >> 12) & 63])
        out.append_byte(table[(word >> 6) & 63])
        out.append_byte(table[word & 63])
        i = i + 3
    }
    let rest = n - i
    if rest == 1 {
        let word = data[i] << 16
        out.append_byte(table[(word >> 18) & 63])
        out.append_byte(table[(word >> 12) & 63])
        if pad {
            out.append("==")
        }
    } else if rest == 2 {
        let word = (data[i] << 16) | (data[i + 1] << 8)
        out.append_byte(table[(word >> 18) & 63])
        out.append_byte(table[(word >> 12) & 63])
        out.append_byte(table[(word >> 6) & 63])
        if pad {
            out.append("=")
        }
    }
    return out.to_str()
}

func encode_str(anon s: str, url: bool = false, pad: bool = true) -> str {
    return encode(kod_str_to_bytes(s), url: url, pad: pad)
}

func bad(anon detail: str) -> IoError {
    return IoError(kind: .InvalidInput, op: "base64 decode", errno: 0, detail: detail)
}

// The value of a base64 character in the chosen alphabet, or -1.
func sextet(anon c: int64, anon url: bool) -> int64 {
    if c >= 65 and c <= 90 {
        return c - 65
    }
    if c >= 97 and c <= 122 {
        return c - 71
    }
    if c >= 48 and c <= 57 {
        return c + 4
    }
    if url {
        if c == 45 {
            return 62
        }
        if c == 95 {
            return 63
        }
    } else {
        if c == 43 {
            return 62
        }
        if c == 47 {
            return 63
        }
    }
    return -1
}

func decode(anon text: str, url: bool = false) -> bytes or Error {
    let n = len(text)
    mut body = n
    for body > 0 and text[body - 1] == 61 {
        body = body - 1
    }
    let padding = n - body
    if padding > 2 {
        throw bad(f"too much padding at offset {body}")
    }
    let rem = body % 4
    if rem == 1 {
        throw bad(f"a single character is left over at offset {body - 1}")
    }
    if padding > 0 and (body + padding) % 4 != 0 {
        throw bad(f"padding is wrong at offset {body}")
    }
    let out = StrBuilder()
    mut i: int64 = 0
    for i + 4 <= body {
        mut word: int64 = 0
        mut j: int64 = 0
        for j < 4 {
            let v = sextet(text[i + j], url)
            if v < 0 {
                throw bad(f"unexpected character at offset {i + j}")
            }
            word = (word << 6) | v
            j = j + 1
        }
        out.append_byte(word >> 16)
        out.append_byte((word >> 8) & 255)
        out.append_byte(word & 255)
        i = i + 4
    }
    if rem >= 2 {
        let a = sextet(text[i], url)
        let c = sextet(text[i + 1], url)
        if a < 0 {
            throw bad(f"unexpected character at offset {i}")
        }
        if c < 0 {
            throw bad(f"unexpected character at offset {i + 1}")
        }
        if rem == 2 {
            if (c & 15) != 0 {
                throw bad(f"the unused bits are not zero at offset {i + 1}")
            }
            out.append_byte((a << 2) | (c >> 4))
        } else {
            let d = sextet(text[i + 2], url)
            if d < 0 {
                throw bad(f"unexpected character at offset {i + 2}")
            }
            if (d & 3) != 0 {
                throw bad(f"the unused bits are not zero at offset {i + 2}")
            }
            out.append_byte((a << 2) | (c >> 4))
            out.append_byte(((c & 15) << 4) | (d >> 2))
        }
    }
    return out.to_bytes()
}

func decode_str(anon text: str, url: bool = false) -> str or Error {
    return kod_bytes_to_str(try decode(text, url: url))
}
