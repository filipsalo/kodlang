// Tasks that wait for I/O, timers and child processes let the others run
// (docs/tasks.md).

import "net/tcp"
import "process"
import "tasks"
import "time"
import "time" { Duration, monotonic_ns }

mut trace: [str] = []

func nap(anon ms: int64) -> int64 {
    time.sleep(Duration(ms: ms))
    return ms
}

func ms_since(anon t0: int64) -> int64 {
    return (monotonic_ns() - t0) / 1000000
}

test "tasks sleep at the same time" {
    let t0 = monotonic_ns()
    let a = spawn nap(100)
    let b = spawn nap(100)
    let c = spawn nap(100)
    assert a.wait() + b.wait() + c.wait() == 300
    let took = ms_since(t0)
    assert 100 <= took < 250
}

test "a task that gives way doesn't hold up one that sleeps" {
    let t0 = monotonic_ns()
    let sleeper = spawn nap(50)
    mut turns: int64 = 0
    for ms_since(t0) < 200 and turns < 100000000 {
        tasks.give_way()
        turns += 1
        if turns % 1000 == 0 {
            // The sleeper ends while this one is busy.
            if ms_since(t0) >= 60 {
                break
            }
        }
    }
    assert sleeper.wait() == 50
    assert ms_since(t0) < 200
}

func note(anon what: str) -> none {
    trace += [what]
}

func run_child() -> int64 or Error {
    let child = try process.start(["sleep", "0.2"], stdin: .Null, stdout: .Null, stderr: .Null)
    let status = try child.wait()
    note("child done")
    return status
}

func tick(anon n: int64) -> none {
    for i in 0..n {
        time.sleep(Duration(ms: 20))
        note(f"tick {i}")
    }
}

test "waiting for a child process lets the others run" {
    trace = []
    let t0 = monotonic_ns()
    let child = spawn run_child()
    spawn tick(3)
    assert must child.wait() == 0
    assert trace[0..3] == ["tick 0", "tick 1", "tick 2"]
    assert trace[3] == "child done"
    assert ms_since(t0) < 400
}

func serve_once(anon l: tcp.Listener) -> str or Error {
    let conn = try l.accept()
    let data = try conn.read(100)
    try conn.write(data)
    try conn.close()
    return kod_bytes_to_str(data)
}

test "a server and a client in one program" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let server = spawn serve_once(l)
    let conn = must tcp.connect("127.0.0.1", port: l.port())
    must conn.write(kod_str_to_bytes("ping"))
    // Without tasks waiting for I/O this read would hold up the server.
    let back = must conn.read(100)
    assert kod_bytes_to_str(back) == "ping"
    assert must server.wait() == "ping"
    must conn.close()
    must l.close()
}

test "with one task, a sleep just sleeps" {
    let t0 = monotonic_ns()
    time.sleep(Duration(ms: 30))
    assert ms_since(t0) >= 30
}
