// One of two modules that declare generic types of the same names.
type Pt = struct {
    x: int64
}

type Box[T] = struct {
    v: T
}

type Maybe[T] = enum {
    Just(v: T)
    Nothing
}

func boxed() -> Box[int64] {
    return Box[int64](v: 1)
}

func boxed_pts() -> Box[[Pt]] {
    return Box[[Pt]](v: [Pt(x: 1)])
}

func boxed_boxed() -> Box[Box[Pt]] {
    return Box[Box[Pt]](v: Box[Pt](v: Pt(x: 1)))
}

func maybe_pt() -> Maybe[Pt] {
    return .Just(v: Pt(x: 1))
}

func pts() -> [Pt] {
    return [Pt(x: 1)]
}

