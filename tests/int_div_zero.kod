// Integer division by zero panics instead of giving a number.
func ratio(anon a: int64, anon b: int64) -> int64 {
    return a / b
}

func main() -> int64 {
    print_int(ratio(7, 2))
    print_int(ratio(7, 0))
    print("not reached")
    return 0
}

// expected output:
// 3
// expected stderr:
// panic: integer division by zero
// expected status:
// 1
