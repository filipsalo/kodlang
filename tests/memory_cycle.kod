// A cycle keeps itself alive: what reference counting can't reclaim.
extern func rc_live_bytes() -> int64

type Node = struct {
    name: str
    other: Node?
}

func pair() -> none {
    let a = Node(name: "a" + "!", other: none)
    let b = Node(name: "b" + "!", other: a)
    a.other = b
}

func broken_pair() -> none {
    let a = Node(name: "a" + "!", other: none)
    let b = Node(name: "b" + "!", other: a)
    a.other = b
    a.other = none
}

func chain() -> none {
    let a = Node(name: "a" + "!", other: none)
    let _b = Node(name: "b" + "!", other: a)
}

func grows(anon f: func() -> none) -> bool {
    f()
    let start = rc_live_bytes()
    for _ in 0..1000 {
        f()
    }
    return (rc_live_bytes() - start) / 1000 > 0
}

func main() -> int64 {
    print(grows(chain))
    print(grows(broken_pair))
    print(grows(pair))
    return 0
}

// expected output:
// false
// false
// true
