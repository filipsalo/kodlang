// The compiler checks the type names a function body writes even in a
// function that never runs.
import "./downcast_generic_xmod_dep"

func holds(anon s: downcast_generic_xmod_dep.Shape) -> bool {
    return s is downcast_generic_xmod_dep.Box
}

func main() -> int64 {
    print("ran")
    return 0
}

// expected status:
// 1
// expected stderr:
// 6:12: error: `downcast_generic_xmod_dep.Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = downcast_generic_xmod_dep.Box[int64]`
