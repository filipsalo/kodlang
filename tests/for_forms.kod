// `for i in a..b`, `for i, x in xs` and a `for` condition that binds.

type Reader = struct {
    lines: [str]
    pos: int64 = 0

    func next_line(self) -> str? {
        if self.pos >= len(self.lines) {
            return none
        }
        self.pos += 1
        return self.lines[self.pos - 1]
    }
}

type Calls = struct {
    n: int64 = 0
}

func bound(c: Calls) -> int64 {
    c.n += 1
    return 3
}

func first_at_least(xs: [int64], n: int64) -> int64 {
    for i, x in xs {
        if x >= n {
            return i
        }
    }
    return -1
}

func main() -> int64 {
    for i in 0..3 {
        print_int(i)
    }
    for i in 2..2 {
        print_int(100 + i)
    }
    for i in 5..2 {
        print_int(100 + i)
    }
    for i in -1..1 {
        print_int(i)
    }
    // Bounds are evaluated once, and `continue` still moves on.
    mut n = 3
    for i in 0..n {
        n = 100
        if i == 1 {
            continue
        }
        print_int(i * 10)
    }
    let c = Calls()
    for _i in 0..bound(:c) {
        print_int(c.n)
    }
    // A bound sees the name from before the loop.
    let i = 2
    for i in 0..i {
        print_int(i + 50)
    }
    print_int(i)
    // Nested, with `break` leaving the inner loop only.
    for a in 0..2 {
        for b in 0..3 {
            if b == 1 {
                break
            }
            print(f"{a} {b}")
        }
    }
    for j, s in ["x", "y", "z"] {
        if j == 1 {
            continue
        }
        print(f"{j} {s}")
    }
    for _, s in ["p"] {
        print(s)
    }
    for k, _ in ["q", "r"] {
        print_int(k)
    }
    for _ in 0..2 {
        print("again")
    }
    print_int(first_at_least(xs: [1, 5, 9], n: 5))
    let r = Reader(lines: ["one", "", "three"])
    for r.next_line() is Some(line) and len(line) > 0 {
        print(line)
    }
    let r2 = Reader(lines: ["a", "skip", "b"])
    for r2.next_line() is Some(line) {
        if line == "skip" {
            continue
        }
        print(line)
    }
    let r3 = Reader(lines: ["c", "stop", "d"])
    for r3.next_line() is Some(line) {
        if line == "stop" {
            break
        }
        print(line)
    }
    mut left = 2
    for left > 0 and r3.next_line() is Some(line) {
        left -= 1
        print(line)
    }
    return 0
}

// expected output:
// 0
// 1
// 2
// -1
// 0
// 0
// 20
// 1
// 1
// 1
// 50
// 51
// 2
// 0 0
// 1 0
// 0 x
// 2 z
// p
// 0
// 1
// again
// again
// 1
// one
// a
// b
// c
// d
