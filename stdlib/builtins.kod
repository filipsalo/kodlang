// Open-addressing hash map laid out as in CPython's PEP 468 dict
// (3.6+): dense, insertion-ordered `_keys` / `_values` arrays plus a
// sparse `_indices` table mapping hash slots to entry positions.
//
// Lookup hashes the key, probes `_indices` until it finds an empty
// slot (miss) or a slot whose entry's key matches (hit). The probe
// sequence is Python's `(5*i + 1 + perturb)` recurrence so a single
// missing slot doesn't trigger a long linear scan.
//
// `remove` leaves a hole: the entry stays in `_keys` / `_values` marked dead
// in `_live`, and its slot is marked -2, which a probe passes over. Once
// holes are half the entries, `_rebuild` closes them.
//
// Keys are compared with `==` and hashed with `hash`, which agree for every key kind.
type Map[K, V] = struct {
    _keys: [K] = []
    _values: [V] = []
    _live: [bool] = []
    // How many entries are live.
    _count: int64 = 0
    // Sparse open-addressing index table: an entry's position, -1 for an
    // empty slot, -2 for a removed entry's. Always a power of two with
    // entries (holes included) at most ~2/3 of it. Empty until the first
    // insert.
    _indices: [int64] = []

    // A fresh `size`-slot indices table, all empty.
    func _empty_indices(self, anon size: int64) -> [int64] {
        return [-1] * size
    }

    // The slot in `_indices` of `key`'s entry; when it has none, where it
    // would go: the first removed entry's slot on the way, or else the empty
    // slot that ends the search. Assumes len(self._indices) > 0.
    func _probe(self, anon key: K) -> int64 {
        // The size is a power of two, so masking takes the slot; perturb is
        // kept non-negative, as CPython's unsigned one, so that shifting
        // brings it to 0 and the recurrence then visits every slot.
        let mask = len(self._indices) - 1
        let h = hash(key)
        mut perturb = h & 9223372036854775807
        mut slot = h & mask
        mut free = -1
        for true {
            let entry_idx = self._indices[slot]
            if entry_idx == -1 {
                if free >= 0 {
                    return free
                }
                return slot
            }
            if entry_idx == -2 {
                if free < 0 {
                    free = slot
                }
            } else if self._keys[entry_idx] == key {
                return slot
            }
            perturb = perturb >> 5
            // Below the table's size and 2^58, so this can't overflow.
            slot = 5.wrapping_mul(slot).wrapping_add(1).wrapping_add(perturb) & mask
        }
        return -1
    }

    // Close the holes, keeping the order, and lay out a `size`-slot table.
    func _rebuild(mut self, anon size: int64) -> none {
        if self._count < len(self._keys) {
            mut keys: [K] = []
            mut values: [V] = []
            mut live: [bool] = []
            for i in 0..len(self._keys) {
                if self._live[i] {
                    keys += [self._keys[i]]
                    values += [self._values[i]]
                    live += [true]
                }
            }
            self._keys = keys
            self._values = values
            self._live = live
        }
        self._indices = self._empty_indices(size)
        for i in 0..len(self._keys) {
            let slot = self._probe(self._keys[i])
            self._indices[slot] = i
        }
    }

    func get(self, anon key: K) -> V? {
        if len(self._indices) == 0 {
            return none
        }
        let entry_idx = self._indices[self._probe(key)]
        if entry_idx < 0 {
            return none
        }
        return self._values[entry_idx]
    }

    func set(mut self, anon key: K, anon value: V) -> none {
        if len(self._indices) == 0 {
            self._indices = self._empty_indices(8)
        }
        let slot = self._probe(key)
        let entry_idx = self._indices[slot]
        if entry_idx >= 0 {
            self._values[entry_idx] = value
            return none
        }
        self._insert_at(slot, key, value)
    }

    // `key`'s value; when the map doesn't have it, `value`, which it then
    // holds as `key`'s. One search either way.
    func get_or_set(mut self, anon key: K, anon value: V) -> V {
        if len(self._indices) == 0 {
            self._indices = self._empty_indices(8)
        }
        let slot = self._probe(key)
        let entry_idx = self._indices[slot]
        if entry_idx >= 0 {
            return self._values[entry_idx]
        }
        self._insert_at(slot, key, value)
        return value
    }

    // A new entry at `slot`, which _probe gave for `key`.
    func _insert_at(mut self, anon slot: int64, anon key: K, anon value: V) -> none {
        self._keys += [key]
        self._values += [value]
        self._live += [true]
        self._count += 1
        self._indices[slot] = len(self._keys) - 1
        // Past ~2/3 full, holes included: close the holes, and double the
        // table if the live entries alone are past it.
        let size = len(self._indices)
        if len(self._keys) * 3 > size * 2 {
            if self._count * 3 > size * 2 {
                self._rebuild(size * 2)
            } else {
                self._rebuild(size)
            }
        }
    }

    // The entry of `key`, or -1.
    func _entry(self, anon key: K) -> int64 {
        if len(self._indices) == 0 {
            return -1
        }
        return self._indices[self._probe(key)]
    }

    // `m[k, default: d]`: k's value, or `default` when k isn't in the map.
    func op_index_or(self, anon key: K, default: V) -> V {
        let entry_idx = self._entry(key)
        if entry_idx < 0 {
            return default
        }
        return self._values[entry_idx]
    }

    // For `m[k] += v` and the like: k's value, taken out of the map (its entry
    // holds nothing) until op_index_set puts it back, so it's the value's only
    // holder and changing it copies nothing. The compiler makes the calls.
    func op_index_take(mut self, anon key: K) -> V {
        let entry_idx = self._entry(key)
        if entry_idx < 0 {
            panic("key not in map")
        }
        return _take_at(self._values, entry_idx)
    }

    // For `m[k, default: d] += v`: as op_index_take, or `default`.
    func op_index_take_or(mut self, anon key: K, default: V) -> V {
        let entry_idx = self._entry(key)
        if entry_idx < 0 {
            return default
        }
        return _take_at(self._values, entry_idx)
    }

    func contains(self, anon key: K) -> bool {
        if len(self._indices) == 0 {
            return false
        }
        return self._indices[self._probe(key)] >= 0
    }

    // Take `key` out of the map: the value it had, or none.
    func remove(mut self, anon key: K) -> V? {
        if len(self._indices) == 0 {
            return none
        }
        let slot = self._probe(key)
        let entry_idx = self._indices[slot]
        if entry_idx < 0 {
            return none
        }
        let value = self._values[entry_idx]
        self._indices[slot] = -2
        self._live[entry_idx] = false
        self._count -= 1
        if (len(self._keys) - self._count) * 2 > len(self._keys) and len(self._keys) >= 8 {
            self._rebuild(len(self._indices))
        }
        return value
    }

    // The keys, in the order they were first set, as a new array.
    func keys(self) -> [K] {
        mut out: [K] = []
        for i in 0..len(self._keys) {
            if self._live[i] {
                out += [self._keys[i]]
            }
        }
        return out
    }

    // The values, in their keys' order, as a new array.
    func values(self) -> [V] {
        mut out: [V] = []
        for i in 0..len(self._values) {
            if self._live[i] {
                out += [self._values[i]]
            }
        }
        return out
    }

    func op_index(self, anon key: K) -> V? {
        return self.get(key)
    }

    func op_index_set(mut self, anon key: K, anon value: V) -> none {
        self.set(key, value)
    }

    // Number of entries. Reachable via the global `len(m)` — the
    // codegen dispatches `len(x)` to a struct's `len` method when the
    // struct defines one.
    func len(self) -> int64 {
        return self._count
    }

    // The entries in order as `{k: v, ...}`, each key and value as an
    // f-string shows it.
    func to_str(self) -> str {
        mut out = "{"
        mut first = true
        for i in 0..len(self._keys) {
            if self._live[i] {
                if not first {
                    out += ", "
                }
                first = false
                out += f"{self._keys[i]}: {self._values[i]}"
            }
        }
        return out + "}"
    }
}

// A `mut` local that a function literal captures lives in one of these: the
// Renamer (kod/parsing.kod) turns `mut n = v` into `let n = _mut_cell(v)` and each
// use of `n` into `n.value`. `mut v` copies an array, as `mut n = xs` does.
type _MutCell[T] = shared struct {
    value: T
}

func _mut_cell[T](anon value: T) -> _MutCell[T] {
    mut v = value
    return _MutCell[T](value: v)
}

// A fallible result: either an Ok payload of T, or an Err of E.
// The unified tagged-sum representation of `T or Error` — same
// {discriminant, payload} runtime layout, but spelled as a generic
// enum so it composes with the rest of the enum machinery (pattern
// matching, `is`, methods). The `T or Error` syntax remains as
// sugar for `Result[T, Error]`.
type Result[T, E] = enum {
    Ok(value: T)
    Err(error: E)
}

// Write `s` to stdout followed by a newline. Routed through the
// runtime's `kod_puts` (which uses fwrite + the embedded length)
// instead of libc puts, so embedded NULs print correctly and `s`
// can stay a `{ buf, len }` struct pointer.
extern func kod_puts(anon s: str) -> int64
// putchar takes a byte (no Kod string involved) so it stays bound
// to the libc symbol.
extern func putchar(anon c: int64) -> int64
// Pack a `[int64]` of byte values (low 8 bits of each entry) into a
// fresh `bytes`. The Kod-level operator `+` on bytes does whole-buffer
// copies, so accumulating arbitrary bytes through repeated concat is
// O(n²); collect into an int64 array, then convert in one shot.
extern func kod_bytes_from_array(anon arr: [int64]) -> bytes
// Reinterpret a `str` as `bytes` (and vice versa). Both types share
// the same runtime layout — these are zero-copy identity casts at the
// type-system level. Use at the boundary between text-shaped APIs
// (`str`) and raw-buffer APIs (`bytes`).
extern func kod_str_to_bytes(anon s: str) -> bytes
extern func kod_bytes_to_str(anon b: bytes) -> str
// The 8 bytes from `at` as one int64, the first byte lowest. The compiler
// compiles a call to a bounds check and one load (`emit_bytes_le64`).
extern func kod_bytes_le64(anon b: bytes, anon at: int64) -> int64
// The growable byte buffer behind `StrBuilder` and the str methods that
// build strings (stdlib/runtime.c). A handle is typed `str` to be counted, but isn't one.
extern func kod_sb_new() -> str
extern func kod_sb_append(anon sb: str, anon s: str) -> none
extern func kod_sb_append_byte(anon sb: str, anon b: int64) -> none
// Waits for a kevent event without holding up other tasks, or gives 0 when the
// caller should just block (stdlib/runtime.c; docs/tasks.md).
extern func kod_closing(anon fd: int64) -> none
extern func kod_wait_event(anon ident: int64, anon filter: int64, anon data: int64) -> int64
// After it gave 1 for a write: how much there is room for, 0 when not known.
extern func kod_wait_room() -> int64
extern func kod_sb_append_int(anon sb: str, anon n: int64) -> none
extern func kod_sb_len(anon sb: str) -> int64
extern func kod_sb_clear(anon sb: str) -> none
extern func kod_sb_to_str(anon sb: str) -> str
// Print `msg` to stderr (with a `panic: ` prefix) and a backtrace, and exit(1).
// Externs get a leading `_` added at codegen; this one is the C runtime's
// `kod_panic` (stdlib/runtime.c), as `extern_label` says.
extern func panic(anon msg: str) -> none
// Print to stderr without exiting; see stdlib/runtime.c.
extern func kod_eprint(anon msg: str) -> none
// Called by the codegen's array-bounds check when an index is out of
// range. Negative-index normalisation has already run, so any value
// reaching here is genuinely out of bounds.
extern func kod_index_oob(anon idx: int64, anon len: int64) -> none
extern func kod_div_zero() -> none

// Test framework: flip the current test's failure flag and print `msg`
// (indented, to stderr). A test program's `_main` defines this to call the
// runner in stdlib/testing.kod; anywhere else the runtime's panics.
extern func kod_test_fail(anon msg: str) -> none

func fail(anon msg: str) -> none {
    kod_test_fail(msg)
}

// A call is a header load; this body runs only through a function value.
func len(anon s: str) -> int64 {
    return len(s)
}

// Any type whose values can be rendered as a string. F-string
// interpolations of types other than `str` are lowered to to_str() calls.
// Primitives (int64, bool, str) participate implicitly via builtin
// conversions; user structs participate by declaring `func to_str(self) -> str`.
interface Stringable {
    func to_str(self) -> str
}

// Any value that can be `throw`n from a function declared `T or Error`.
// Errors must be displayable; users define their own error enums and
// implement to_str on each.
interface Error {
    func to_str(self) -> str
}

// Not consulted yet: an `Err` that `main` returns exits with status 1.
interface ExitCode {
    func exit_code(self) -> int64
}

func print(anon string: str) -> none {
    kod_puts(string)
}

// The smaller of two values, `a` when neither is.
func min[T](anon a: T, anon b: T) -> T {
    if b < a {
        return b
    }
    return a
}

// The larger of two values, `a` when neither is.
func max[T](anon a: T, anon b: T) -> T {
    if a < b {
        return b
    }
    return a
}

func print_int(anon arg: int64) -> none {
    print(arg.to_str())
}

// `a == b` on two arrays, which the compiler turns into a call to this: the
// same length, and each element `==` to the other's at its place.
// `x in xs`.
func _array_contains[T](anon xs: [T], anon x: T) -> bool {
    for item in xs {
        if item == x {
            return true
        }
    }
    return false
}

func _array_eq[T](anon a: [T], anon b: [T]) -> bool {
    if len(a) != len(b) {
        return false
    }
    for i in 0..len(a) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// `a == b` on a plain struct: the compiler makes `_fields_eq`, here and nowhere else, of
// the struct's fields.
func _struct_eq[T](anon a: T, anon b: T) -> bool {
    return _fields_eq(a, b)
}

func _fields_eq[T](anon _a: T, anon _b: T) -> bool {
    return false
}

// Two optional fields.
func _opt_eq[T](anon a: T?, anon b: T?) -> bool {
    if a is Some(x) {
        if b is Some(y) {
            return x == y
        }
        return false
    }
    return b is none
}

// `hash(x)` on a plain struct, an array and an optional field.
func _struct_hash[T](anon x: T) -> int64 {
    return _fields_hash(x)
}

func _fields_hash[T](anon _x: T) -> int64 {
    return 0
}

func _array_hash[T](anon xs: [T]) -> int64 {
    mut h = len(xs)
    for x in xs {
        h = _mix(h, hash(x))
    }
    return h
}

func _opt_hash[T](anon x: T?) -> int64 {
    if x is Some(value) {
        return _mix(1, hash(value))
    }
    return 0
}

// A hash made of `h`, what came before, and `k`, such that small numbers next to each
// other don't give what others give.
func _mix(anon h: int64, anon k: int64) -> int64 {
    let m = (h ^ k).wrapping_mul(0x2545f4914f6cdd1d)
    return m ^ (m >> 32)
}

// A plain struct as text, and an optional field.
func _struct_str[T](anon x: T) -> str {
    return _fields_str(x)
}

func _fields_str[T](anon _x: T) -> str {
    return ""
}

func _opt_str[T](anon x: T?) -> str {
    if x is Some(value) {
        return f"{value}"
    }
    return "none"
}

// An array as text, for f-strings, `str` and `print`, which the compiler turns
// into a call to this: its elements as f-strings show them, in brackets.
func _array_str[T](anon xs: [T]) -> str {
    mut out = "["
    for i, x in xs {
        if i > 0 {
            out += ", "
        }
        out += f"{x}"
    }
    return out + "]"
}

// The tuples `(A, B)`, `(A, B, C)` and so on, whose fields are named 0, 1, 2.
type _Tuple2[A, B] = struct {
    e0: A
    e1: B
}

type _Tuple3[A, B, C] = struct {
    e0: A
    e1: B
    e2: C
}

type _Tuple4[A, B, C, D] = struct {
    e0: A
    e1: B
    e2: C
    e3: D
}

type _Tuple5[A, B, C, D, E] = struct {
    e0: A
    e1: B
    e2: C
    e3: D
    e4: E
}

type _Tuple6[A, B, C, D, E, F] = struct {
    e0: A
    e1: B
    e2: C
    e3: D
    e4: E
    e5: F
}

type _Tuple7[A, B, C, D, E, F, G] = struct {
    e0: A
    e1: B
    e2: C
    e3: D
    e4: E
    e5: F
    e6: G
}

type _Tuple8[A, B, C, D, E, F, G, H] = struct {
    e0: A
    e1: B
    e2: C
    e3: D
    e4: E
    e5: F
    e6: G
    e7: H
}

// `a < b` on two tuples and its like: the compiler makes `_fields_lt` of their elements.
func _tuple_lt[T](anon a: T, anon b: T) -> bool {
    return _fields_lt(a, b)
}

func _tuple_gt[T](anon a: T, anon b: T) -> bool {
    return _fields_lt(b, a)
}

func _tuple_le[T](anon a: T, anon b: T) -> bool {
    return not _fields_lt(b, a)
}

func _tuple_ge[T](anon a: T, anon b: T) -> bool {
    return not _fields_lt(a, b)
}

func _fields_lt[T](anon _a: T, anon _b: T) -> bool {
    return false
}
