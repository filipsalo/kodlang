test "`is` binds tighter than `and` and `or`" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum {
            Red
            Green
        }
        func main() -> int64 {
            let f = true
            let o: int64? = none
            if f and o is none {
                print("both")
            }
            if o is not none or f {
                print("either")
            }
            let c: Color = .Red
            let red = c is .Red and o is none
            return 0
        }
        """)
    assert len(errs) == 0
}

test "an f-string's braces hold one expression, and print takes what they do" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func fails() -> int64 or Error {
            return 1
        }
        func main() -> int64 {
            let n = 3
            let o: int64? = 3
            print(f"{n:03}")
            print(f"{n n}")
            print(o)
            print([1])
            print(fails())
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "an f-string has no format specs")
    assert test_support.any_message_contains(errs, needle: "hold one expression, but this one goes on with identifier")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `int64?` to `str`")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `[int64]` to `str`")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `int64 or Error` to `str`")
}

test "alternatives can't bind, and each counts for exhaustiveness" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type T = enum {
            A(n: int64)
            B(n: int64)
            C
            D
        }
        func f(t: T) -> int64 {
            match t {
                .A(n) | .B(n) -> return n
                else return 0
            }
        }
        func g(t: T) -> int64 {
            match t {
                .A(_) | .B(_) -> return 1
                .C | .C -> return 2
            }
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "alternatives joined by `|` can't bind names")
    assert test_support.any_message_contains(errs, needle: "`D`")
}

test "a range's bounds must be `int64`, and a numbered loop takes an array" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            for i in 0.."a" {
                print_int(i)
            }
            for i in 0.5..2 {
                print_int(i)
            }
            for i, x in 0..3 {
                print_int(i)
            }
            for i, x in 5 {
                print_int(i)
            }
            for i in 0..3 {
                i = 4
            }
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "expected `int64`, got `str`")
    assert test_support.any_message_contains(errs, needle: "expected `int64`, got `float64`")
    assert test_support.any_message_contains(errs, needle: "`for i, x in` numbers an array; a range is already numbers, so write `for x in a..b`")
    assert test_support.any_message_contains(errs, needle: "cannot iterate over a value of type `int64`")
    assert test_support.any_message_contains(errs, needle: "cannot reassign immutable binding `i`")
}

test "`not` needs a `bool`, can't bind, and `!` isn't an operator" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n = 3
            let o: int64? = 3
            if not n {
                print("int")
            }
            if not o {
                print("optional")
            }
            if not (o is Some(v)) {
                print("binds")
            }
            let flag = true
            if !flag {
                print("bang")
            }
            return 0
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "`not` needs a `bool`, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`not` needs a `bool`, got `int64?`; test it with `is none`")
    assert test_support.any_message_contains(errs, needle: "`is` can't bind `v` here")
    assert test_support.any_message_contains(errs, needle: "`!` isn't an operator; negate a `bool` with `not`")
}

test "an `and` chain's bindings don't reach the else block, and `is not` in it can't bind" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let f = true
            let o: int64? = 3
            if o is Some(v) and v > 0 {
                print_int(v)
            } else {
                print_int(v)
            }
            if f and o is not Some(w) {
                print("none")
            }
            return 0
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "`v` is declared in a block that has ended")
    assert test_support.any_message_contains(errs, needle: "`is` can't bind `w` here")
}

test "an `is` pattern that binds inside a larger condition" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum {
            Red
            Green
        }
        func main() -> int64 {
            let f = true
            let o: int64? = 3
            mut v = 0
            if f or o is Some(v) {
                print_int(v)
            }
            let c: Color = .Red
            let r: int64 or Error = .Ok(value: 1)
            let a = c is .Blue
            let b = r is Some
            let d = o is .Ok
            return 0
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "`is` can't bind `v` here; a pattern binds names only in an `if` or `for` condition, alone or joined to the rest by `and`")
    assert test_support.any_message_contains(errs, needle: "enum `Color` has no variant `Blue`")
    assert test_support.any_message_contains(errs, needle: "`is` on a `T or Error` value takes `Ok` or `Err`")
    assert test_support.any_message_contains(errs, needle: "`is` on an optional takes `none` or `Some`")
}

test "function values match function types exactly" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        func sq_area(anon s: Sq) -> int64 {
            return s.s
        }
        func shape_area(anon s: Shape) -> int64 {
            return s.area()
        }
        func get_int() -> int64 {
            return 1
        }
        func main() -> int64 {
            let f: func(Shape) -> int64 = sq_area
            let g: func() -> int64? = get_int
            let h: func(Shape) -> int64 = shape_area
            let fs: [func() -> int64?] = [get_int]
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "expected `func(Shape) -> int64`, got `func(Sq) -> int64`")
    assert test_support.any_message_contains(errs, needle: "expected `func() -> int64?`, got `func() -> int64`")
}

test "an [int64] isn't another array type" {
