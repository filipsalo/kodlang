// A block's function value hides a function of its name only inside the block.
func twice(anon n: int64) -> int64 {
    return n * 2
}

func main() -> int64 {
    if true {
        let twice = func(anon n: int64) -> int64 {
            return n * 100
        }
        let len = func(anon s: str) -> int64 {
            return 0 - 1
        }
        print_int(twice(1))
        print_int(len("abc"))
    }
    print_int(twice(2))
    print_int(len("abc"))
    return 0
}

// expected output:
// 100
// -1
// 4
// 3
