// A binary min-heap: the smallest element by `<` comes out first.
//
// API: `Heap[T]()`, `push`, `pop`, `peek`, `len`, `is_empty`, `values`.
type Heap[T] = struct {
    items: [T] = []

    func push(mut self, anon item: T) -> none {
        self.items += [item]
        mut i = len(self.items) - 1
        for i > 0 {
            let parent = (i - 1) / 2
            if not (self.items[i] < self.items[parent]) {
                break
            }
            let held = self.items[i]
            self.items[i] = self.items[parent]
            self.items[parent] = held
            i = parent
        }
    }

    // The smallest element, taken out, or none when there are none.
    func pop(mut self) -> T? {
        let n = len(self.items)
        if n == 0 {
            return none
        }
        let top = self.items[0]
        self.items[0] = self.items[n - 1]
        self.items = self.items[..-1]
        let size = n - 1
        mut i = 0
        for true {
            let left = 2 * i + 1
            if left >= size {
                break
            }
            mut least = left
            let right = left + 1
            if right < size and self.items[right] < self.items[left] {
                least = right
            }
            if not (self.items[least] < self.items[i]) {
                break
            }
            let held = self.items[i]
            self.items[i] = self.items[least]
            self.items[least] = held
            i = least
        }
        return top
    }

    // The smallest element, left in, or none when there are none.
    func peek(self) -> T? {
        if len(self.items) == 0 {
            return none
        }
        return self.items[0]
    }

    func len(self) -> int64 {
        return len(self.items)
    }

    func is_empty(self) -> bool {
        return len(self.items) == 0
    }

    // The elements, in no particular order, as a new array.
    func values(self) -> [T] {
        return self.items
    }
}
