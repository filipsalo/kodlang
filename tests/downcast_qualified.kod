// A downcast names a struct of an imported module through the module's
// alias, as it does one imported as an item.
import "./downcast_qualified_dep" { NotFound }

func describe(anon key: str) -> str {
    match downcast_qualified_dep.find(key) {
        Ok(v) -> return f"ok {v}"
        Err(e) -> {
            if e is downcast_qualified_dep.NotFound(nf) {
                return f"missing {nf.key}"
            }
            if e is downcast_qualified_dep.BadInput {
                return "bad"
            }
            return "other"
        }
    }
}

func kind(anon e: Error) -> str {
    match e {
        downcast_qualified_dep.BadInput(b) -> return f"bad at {b.pos}"
        NotFound(nf) -> return f"nf {nf.key}"
        else -> return "else"
    }
}

func key_of(anon e: Error) -> str {
    return match e {
        downcast_qualified_dep.NotFound(nf) -> nf.key
        downcast_qualified_dep.BadInput -> "-"
        else "?"
    }
}

func main() -> int64 {
    print(describe("a"))
    print(describe("zz"))
    print(describe(""))
    let missing = downcast_qualified_dep.failure("q")
    let bad = downcast_qualified_dep.failure("")
    print(f"{kind(missing)} / {kind(bad)}")
    print(f"{key_of(missing)} / {key_of(bad)}")
    let a = missing is downcast_qualified_dep.NotFound
    let b = bad is downcast_qualified_dep.NotFound
    let c = bad is not downcast_qualified_dep.NotFound
    let d = missing is NotFound
    print(f"{a} {b} {c} {d}")
    if bad is not downcast_qualified_dep.BadInput(x) {
        print("not bad")
    } else {
        print(f"bad {x.pos}")
    }
    return 0
}

// expected output:
// ok 1
// missing zz
// bad
// nf q / bad at 0
// q / -
// true false true true
// bad 0
