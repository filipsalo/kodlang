// The interpreter reports a downcast to a generic type itself.
interface Shape {
    func area(self) -> int64
}

type Box[T] = struct {
    v: T

    func area(self) -> int64 {
        return 1
    }
}

func main() -> int64 {
    let s: Shape = Box[int64](v: 1)
    let held = s is Box
    if held {
        return 1
    }
    return 0
}

// expected status:
// 1
// expected stderr:
// 16:21: error: `Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = Box[int64]`
// expected mode:
// interpret
