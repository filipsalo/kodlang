// An enum's name before a `.`, and a generic type's name in a constructor,
// mean the type even where a local has that name, and after its block.
type Color = enum {
    Red
    Blue
    Mix(r: int64)
}

type Shade = enum {
    Light
    Dark
}

type Box[T] = struct {
    v: T
}

func name(anon c: Color) -> str {
    match c {
        .Red -> return "red"
        .Blue -> return "blue"
        .Mix(r) -> return f"mix{r}"
    }
}

func same_block() -> str {
    let Color = 3
    let c = Color.Mix(r: Color)
    let cs = [Color.Red] + [.Blue]
    return f"{name(Color.Blue)} {name(c)} {name(cs[1])}"
}

func params(anon Color: int64, anon Box: int64) -> str {
    let b = Box[int64](v: Color + Box)
    return f"{name(Color.Red)} {b.v}"
}

func ended(anon flag: bool) -> str {
    if flag {
        let Color = 4
        print_int(Color)
    }
    return name(Color.Blue)
}

func slot(anon s: Shade) -> int64 {
    match s {
        .Light -> return 0
        .Dark -> return 1
    }
}

func counts() -> int64 {
    let Shade = 2
    mut xs = [0, Shade]
    xs[slot(Shade.Dark)] += 5
    return xs[1]
}

func main() -> int64 {
    print(same_block())
    print(params(1, 2))
    print(ended(true))
    print(ended(false))
    print_int(counts())
    return 0
}

// expected output:
// blue mix3 blue
// red 3
// 4
// blue
// blue
// 7
