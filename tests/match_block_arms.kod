// An arm of a match expression may be a block whose last expression is its value.

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
    Dot
}

type Bad = struct {
    why: str

    func to_str(self) -> str {
        return self.why
    }
}

type Pair = struct {
    a: int64
    b: int64
}

func size(anon s: Shape) -> int64 {
    let x: int64 = match s {
        Shape.Circle(r) -> {
            let d = 2 * r
            print("circle")
            d * 3
        }
        Shape.Rect(w, h) -> w * h
        else {
            print("dot")
            0
        }
    }
    return x
}

func described(anon n: int64) -> str {
    return match n {
        1 -> "one"
        2 -> {
            let a = "tw"
            a + "o"
        }
        else -> {
            let a = n.to_str()
            "many " + a
        }
    }
}

func parse(anon s: str) -> int64 or Error {
    let n = match s {
        "x" -> {
            throw Bad(why: "bad x")
        }
        else -> {
            let v = s.parse_int()? or 0
            v + 1
        }
    }
    return n * 10
}

func early(anon n: int64) -> int64 {
    let r = match n {
        0 -> {
            return -1
        }
        else -> {
            let t = n + 1
            t
        }
    }
    return r * 2
}

func pair(anon n: int64) -> Pair {
    return match n {
        0 -> Pair(a: 0, b: 0)
        else -> {
            let h = n / 2
            Pair(a: h, b: n - h)
        }
    }
}

func nested(anon a: int64, anon b: int64) -> int64 {
    return match a {
        0 -> {
            let inner = match b {
                0 -> 100
                else -> {
                    let q = b * 2
                    q
                }
            }
            inner + 1
        }
        else -> a
    }
}

func maybe(anon n: int64) -> str? {
    return match n {
        0 -> none
        else -> {
            let s = n.to_str()
            s + "!"
        }
    }
}

func main() -> int64 {
    print_int(size(.Circle(r: 4)))
    print_int(size(.Rect(w: 3, h: 5)))
    print_int(size(.Dot))
    print(described(1))
    print(described(2))
    print(described(7))
    print_int(must parse("4"))
    if parse("x") is Err(e) {
        print(e.to_str())
    }
    print_int(early(0))
    print_int(early(5))
    let p = pair(9)
    print_int(p.a)
    print_int(p.b)
    print_int(nested(0, 0))
    print_int(nested(0, 4))
    print_int(nested(6, 4))
    if maybe(0) is none {
        print("none")
    }
    print(maybe(3)? or "")

    // Bindings made in an arm are gone after it, so the names can be reused.
    let k = 5
    let shadow = match k {
        5 -> {
            let k = 50
            k + 1
        }
        else -> 0
    }
    print_int(shadow)
    print_int(k)
    return 0
}

// expected output:
// circle
// 24
// 15
// dot
// 0
// one
// two
// many 7
// 50
// bad x
// -1
// 12
// 4
// 5
// 101
// 9
// 6
// none
// 3!
// 51
// 5

// expected status:
// 0
