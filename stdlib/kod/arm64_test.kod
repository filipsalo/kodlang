// arm64.encode gives the word `as` assembles each instruction's text to
// (docs/ir.md, step 9). Each expected word is what `as` made of the text in
// the comment beside it.

import "kod/arm64"
import "kod/regalloc"

func r(anon name: str) -> regalloc.Reg {
    return regalloc.reg_of(name)
}

// w0 is x5's 32-bit form and w1 x7's: vreg 0 lives in x5, vreg 1 in x7.
func phys() -> [regalloc.Reg] {
    return [r("x5"), r("x7")]
}

func word(anon insn: regalloc.Insn) -> int64 {
    return arm64.encode(insn, vreg_phys: phys())
}

test "loads and stores" {
    assert word(.Slot(store: false, reg: r("x1"), off: -8)) == 0xF85F83A1 // ldr x1, [fp, #-8]
    assert word(.Slot(store: true, reg: r("x2"), off: 0)) == 0xF90003A2 // str x2, [fp]
    assert word(.Mem(load: true, width: 8, reg: r("x3"), base: r("x4"), at: .Offset(off: 16))) == 0xF9400883 // ldr x3, [x4, #16]
    assert word(.Mem(load: true, width: 8, reg: r("x3"), base: r("x4"), at: .Offset(off: 12))) == 0xF840C083 // ldr x3, [x4, #12]
    assert word(.Mem(load: true, width: 4, reg: regalloc.wvreg(0), base: r("x6"), at: .Offset(off: 8))) == 0xB94008C5 // ldr w5, [x6, #8]
    assert word(.Mem(load: true, width: 1, reg: regalloc.wvreg(0), base: r("x6"), at: .Offset(off: 3))) == 0x39400CC5 // ldrb w5, [x6, #3]
    assert word(.Mem(load: false, width: 2, reg: regalloc.wvreg(0), base: r("x6"), at: .Base)) == 0x790000C5 // strh w5, [x6]
    assert word(.Mem(load: true, width: 8, reg: r("x7"), base: r("x8"), at: .Index(reg: r("x9"), scaled: false))) == 0xF8696907 // ldr x7, [x8, x9]
    assert word(.Mem(load: false, width: 1, reg: regalloc.wvreg(1), base: r("x8"), at: .Index(reg: r("x9"), scaled: false))) == 0x38296907 // strb w7, [x8, x9]
    assert word(.Mem(load: true, width: 8, reg: r("x7"), base: r("x8"), at: .Index(reg: r("x9"), scaled: true))) == 0xF8697907 // ldr x7, [x8, x9, lsl #3]
    assert word(.Mem(load: false, width: 8, reg: r("x7"), base: r("x8"), at: .Index(reg: r("x9"), scaled: true))) == 0xF8297907 // str x7, [x8, x9, lsl #3]
}

test "moves" {
    assert word(.Mov(dst: r("x0"), src: r("x19"))) == 0xAA1303E0 // mov x0, x19
    assert word(.Mov(dst: r("fp"), src: r("sp"))) == 0x910003FD // mov fp, sp
    assert word(.Mov(dst: r("sp"), src: r("fp"))) == 0x910003BF // mov sp, fp
    assert word(.Mov(dst: r("x0"), src: r("xzr"))) == 0xAA1F03E0 // mov x0, xzr
    assert word(regalloc.op(.Move, a: r("x10"), b: r("#4095"))) == 0xD281FFEA // mov x10, #4095
    assert word(regalloc.op(.Move, a: r("x10"), b: r("#-5"))) == 0x9280008A // mov x10, #-5
}

test "arithmetic, logic and shifts" {
    assert word(regalloc.op(.Add, a: r("x1"), b: r("x2"), c: r("#8"))) == 0x91002041 // add x1, x2, #8
    assert word(regalloc.op(.Sub, a: r("sp"), b: r("sp"), c: r("#32"))) == 0xD10083FF // sub sp, sp, #32
    let x1 = r("x1")
    let x2 = r("x2")
    let x3 = r("x3")
    assert word(regalloc.op(.Add, a: x1, b: x2, c: x3)) == 0x8B030041 // add x1, x2, x3
    assert word(regalloc.op(.Sub, a: x1, b: x2, c: x3)) == 0xCB030041 // sub x1, x2, x3
    assert word(regalloc.op(.Mul, a: x1, b: x2, c: x3)) == 0x9B037C41 // mul x1, x2, x3
    assert word(regalloc.op(.DivSigned, a: x1, b: x2, c: x3)) == 0x9AC30C41 // sdiv x1, x2, x3
    assert word(regalloc.op(.And, a: x1, b: x2, c: x3)) == 0x8A030041 // and x1, x2, x3
    assert word(regalloc.op(.Or, a: x1, b: x2, c: x3)) == 0xAA030041 // orr x1, x2, x3
    assert word(regalloc.op(.Xor, a: x1, b: x2, c: x3)) == 0xCA030041 // eor x1, x2, x3
    assert word(regalloc.op(.ShiftLeft, a: x1, b: x2, c: r("#3"))) == 0xD37DF041 // lsl x1, x2, #3
    assert word(regalloc.op(.ShiftRight, a: x1, b: x2, c: r("#3"))) == 0xD343FC41 // lsr x1, x2, #3
    assert word(regalloc.op(.ShiftLeft, a: x1, b: x2, c: x3)) == 0x9AC32041 // lsl x1, x2, x3
    assert word(regalloc.op(.ShiftRight, a: x1, b: x2, c: x3)) == 0x9AC32441 // lsr x1, x2, x3
}

test "compares and conditions" {
    let x1 = r("x1")
    assert word(regalloc.op(.Compare, a: x1, b: r("#7"))) == 0xF1001C3F // cmp x1, #7
    assert word(regalloc.op(.Compare, a: x1, b: r("x2"))) == 0xEB02003F // cmp x1, x2
    assert word(regalloc.op(.SetIf, a: x1, b: r("lt"))) == 0x9A9FA7E1 // cset x1, lt
    assert word(regalloc.op(.Select, a: x1, b: r("x2"), c: r("x3"), d: r("ne"))) == 0x9A831041 // csel x1, x2, x3, ne
}

test "pairs, calls and returns" {
    let fp = r("fp")
    let lr = r("lr")
    let sp = r("sp")
    assert word(.Pair(load: false, a: fp, b: lr, base: sp, mode: .Pre(off: -16))) == 0xA9BF7BFD // stp fp, lr, [sp, #-16]!
    assert word(.Pair(load: true, a: fp, b: lr, base: sp, mode: .Post(off: 16))) == 0xA8C17BFD // ldp fp, lr, [sp], #16
    assert word(.Pair(load: false, a: r("x28"), b: r("xzr"), base: sp, mode: .Pre(off: -16))) == 0xA9BF7FFC // stp x28, xzr, [sp, #-16]!
    assert word(.Pair(load: true, a: r("x19"), b: r("x20"), base: sp, mode: .At(off: 16))) == 0xA94153F3 // ldp x19, x20, [sp, #16]
    assert word(regalloc.op(.CallIndirect, a: r("x16"))) == 0xD63F0200 // blr x16
    assert word(regalloc.op(.Return)) == 0xD65F03C0 // ret
}

test "what has a label or a symbol, or no encoding here, stays text" {
    assert word(.Call(target: "_f")) == -1
    assert word(.Branch(kind: .Always, reg: regalloc.NO_REG, target: "L1")) == -1
    assert word(.Mem(load: true, width: 8, reg: r("x1"), base: r("x2"), at: .Symbol(name: "_g", got: false))) == -1
    // Too big for the 12-bit immediate, or too far below the base for ldur.
    assert word(regalloc.op(.Add, a: r("x1"), b: r("x2"), c: r("#4096"))) == -1
    assert word(.Mem(load: true, width: 8, reg: r("x1"), base: r("x2"), at: .Offset(off: -264))) == -1
    // xzr can't be a base, nor sp a register `orr` reads.
    assert word(.Mem(load: true, width: 8, reg: r("x1"), base: r("xzr"), at: .Base)) == -1
    assert word(regalloc.op(.And, a: r("x1"), b: r("sp"), c: r("x2"))) == -1
}

test "instructions given as text" {
    assert arm64.encode_text("\tfmov d0, x8") == 0x9E670100
    assert arm64.encode_text("\tfmov x8, d0") == 0x9E660008
    assert arm64.encode_text("\tfcmp d0, d1") == 0x1E612000
    assert arm64.encode_text("\tfneg d0, d0") == 0x1E614000
    assert arm64.encode_text("\tfabs d0, d0") == 0x1E60C000
    assert arm64.encode_text("\tfsqrt d0, d0") == 0x1E61C000
    assert arm64.encode_text("\tfrintm d0, d0") == 0x1E654000
    assert arm64.encode_text("\tfrintp d0, d0") == 0x1E64C000
    assert arm64.encode_text("\tfrinta d0, d0") == 0x1E664000
    assert arm64.encode_text("\tfadd d0, d0, d1") == 0x1E612800
    assert arm64.encode_text("\tfsub d0, d0, d1") == 0x1E613800
    assert arm64.encode_text("\tfmul d0, d0, d1") == 0x1E610800
    assert arm64.encode_text("\tfdiv d0, d0, d1") == 0x1E611800
    assert arm64.encode_text("\tscvtf d0, x0") == 0x9E620000
    assert arm64.encode_text("\tfcvtzs x0, d0") == 0x9E780000
    assert arm64.encode_text("\tldrsw x0, [x0]") == 0xB9800000
    assert arm64.encode_text("\tldrsb x0, [x0]") == 0x39800000
    assert arm64.encode_text("\tstr s0, [x0]") == 0xBD000000
    assert arm64.encode_text("\tstr b0, [x0]") == 0x3D000000
    assert arm64.encode_text("\tasr x0, x0, #32") == 0x9360FC00
    assert arm64.encode_text("\tlsl x0, x0, #32") == 0xD3607C00
    assert arm64.encode_text("\tumulh x0, x0, x1") == 0x9BC17C00
    assert arm64.encode_text("\tclz x0, x0") == 0xDAC01000
    assert arm64.encode_text("\trbit x0, x0") == 0xDAC00000
    assert arm64.encode_text("\tcnt v0.8b, v0.8b") == 0x0E205800
    assert arm64.encode_text("\taddv b0, v0.8b") == 0x0E31B800
    assert arm64.encode_text("\tand x0, x0, #0xff") == 0x92401C00
    assert arm64.encode_text("\tand x0, x0, #0x7fffffffffffffff") == 0x9240F800
    assert arm64.encode_text("\teor x0, x0, #0x7ff0000000000000") == 0xD24C2800
    assert arm64.encode_text("\tccmp x17, x16, #0, lo") == 0xFA503220
    assert arm64.encode_text("\tcset x0, vs") == 0x9A9F77E0
    assert arm64.encode_text("\tcmp x0, #0") == 0xF100001F
    assert arm64.encode_text("\tstr x0, [sp, #64]") == 0xF90023E0
    assert arm64.encode_text("\tldr x17, [sp, #72]") == 0xF94027F1
    assert arm64.encode_text("\tstp x29, x30, [sp, #-80]!") == 0xA9BB7BFD
    assert arm64.encode_text("\tldp x29, x30, [sp], #80") == 0xA8C57BFD
    assert arm64.encode_text("\tstp x1, x2, [sp, #16]") == 0xA9010BE1
    assert arm64.encode_text("\tmov x29, sp") == 0x910003FD
    assert arm64.encode_text("\tmov x0, x17") == 0xAA1103E0
    assert arm64.encode_text("\tmov x1, #16") == 0xD2800201
    assert arm64.encode_text("\tmov x10, #(9223372036854775807 & 0xffff)") == 0xD29FFFEA
    assert arm64.encode_text("\tmovk x10, #((9223372036854775807 >> 16) & 0xffff), lsl #16") == 0xF2BFFFEA
    assert arm64.encode_text("\tmovk x10, #((9223372036854775807 >> 48) & 0xffff), lsl #48") == 0xF2EFFFEA
    assert arm64.encode_text("\tmov x10, #(-9223372036854775808 & 0xffff)") == 0xD280000A
    assert arm64.encode_text("\tmovk x10, #((-9223372036854775808 >> 48) & 0xffff), lsl #48") == 0xF2F0000A
    assert arm64.encode_text("\tldrb w0, [x1]") == 0x39400020
    assert arm64.encode_text("\tldrb w1, [x2, x3]") == 0x38636841
    assert arm64.encode_text("\tret") == 0xD65F03C0
}

test "sp in register arithmetic, and a scaled index" {
    assert arm64.encode_text("\tsub sp, sp, x16") == 0xCB3063FF
    assert arm64.encode_text("\tadd sp, sp, x16") == 0x8B3063FF
    assert arm64.encode_text("\tadd x0, sp, x16") == 0x8B3063E0
    assert arm64.encode_text("\tldr x0, [x20, x22, lsl #3]") == 0xF8767A80
    assert arm64.encode_text("\tstr x0, [x21, x22, lsl #3]") == 0xF8367AA0
    assert arm64.encode_text("\tldr w0, [x1, x2, lsl #2]") == 0xB8627820
    // Scaled only by the access size.
    assert arm64.encode_text("\tldr x0, [x1, x2, lsl #2]") == -1
}

test "text this can't encode is -1" {
    assert arm64.encode_text("\tbl _f") == -1
    assert arm64.encode_text("\tb.eq L1") == -1
    assert arm64.encode_text("\tadrp x0, _g@PAGE") == -1
    assert arm64.encode_text("\tadd x0, x0, _g@PAGEOFF") == -1
    assert arm64.encode_text("\tand x0, x0, #0") == -1
    assert arm64.encode_text("\tfrobnicate x0") == -1
}

test "bitmask immediates" {
    assert arm64.bitmask_imm(0xff) == 0x1007
    assert arm64.bitmask_imm(0x5555555555555555) == 0x03C
    assert arm64.bitmask_imm(0) == -1
    assert arm64.bitmask_imm(-1) == -1
    assert arm64.bitmask_imm(5) == -1
}
