test "inverse" {
    let m = Modulus(h("7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffed"))
    assert hex.encode(bignum.to_bytes(m.from_mont(m.inverse(m.to_mont(n("29219ff8955cb6c624ed4cddbb7a343edd45cde156c0518d6b4f52d7b7857232")))), size: 32)) == "19c73665d62e36c2e956d849bf72affa85aabd3a478961a15846ec7c8427f4bd"
    assert hex.encode(bignum.to_bytes(m.from_mont(m.inverse(m.to_mont(n("508d0b4a7a5101584c451785d9d07c67258656f9873003e5595943d51b8f0c07")))), size: 32)) == "250831827dba1a65a630fa0f526d21e680e09ccfdc4b0f53b46d5f409c435f7d"
    assert hex.encode(bignum.to_bytes(m.from_mont(m.inverse(m.to_mont(n("055b94167e20e3a95ff472fe7257ed8dec024768dcf6a80726e557ec8a10f447")))), size: 32)) == "4d65c0782fadd6a49c57b64f3c92ea42bfbd015b604fcb4178dc5c44aa84cce9"
}

test "bytes" {
    assert bignum.from_bytes(h("0100"), k: 1) == [256]
    assert bignum.from_bytes(h("40000000"), k: 1) is none
    assert bignum.from_bytes(h("3fffffff"), k: 1) == [1073741823]
    assert bignum.from_bytes(h("0000000000ff"), k: 1) == [255]
    assert hex.encode(bignum.to_bytes([1073741823, 1], size: 5)) == "007fffffff"
    assert bignum.bit_length([0, 1]) == 31
}
