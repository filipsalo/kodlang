// Time primitives backed by `clock_gettime` in stdlib/runtime.c.
//
// Two clocks, two contracts:
//
//   - `monotonic_ns()` — never goes backwards. Use for measuring
//     elapsed time (`let t0 = time.monotonic_ns(); do_work(); let
//     dt = time.monotonic_ns() - t0`). The origin is unspecified;
//     only differences are meaningful.
//
//   - `unix_ns()` — wall clock, nanoseconds since 1970-01-01 UTC.
//     Use for timestamps and for cross-process / cross-run
//     comparisons. Can jump backwards if the system clock is
//     adjusted; not safe for elapsed-time measurement.
//
// The clocks return int64 nanoseconds, which covers ~292 years. A `Duration`
// is a length of time, and `sleep` waits for one.
extern func kod_monotonic_ns() -> int64
extern func kod_unix_ns() -> int64
extern func kod_sleep_ns(anon ns: int64) -> none

func monotonic_ns() -> int64 {
    return kod_monotonic_ns()
}

func unix_ns() -> int64 {
    return kod_unix_ns()
}

// A length of time, in nanoseconds. See docs/time.md.
type Duration = struct {
    ns: int64

    // The units given add up: `Duration(minutes: 1, seconds: 30)`; write them largest first.
    func init(hours: int64 = 0, minutes: int64 = 0, seconds: int64 = 0, ms: int64 = 0, us: int64 = 0, ns: int64 = 0) -> Duration {
        return Duration(ns: ns + us * 1000 + ms * 1000000 + seconds * 1000000000 + minutes * 60000000000 + hours * 3600000000000)
    }

    func op_add(self, other: Duration) -> Duration {
        return Duration(ns: self.ns + other.ns)
    }

    func op_sub(self, other: Duration) -> Duration {
        return Duration(ns: self.ns - other.ns)
    }

    // `-d` is `0 - d`.
    func op_rsub(self, k: int64) -> Duration {
        return Duration(ns: k - self.ns)
    }

    func op_mul(self, k: int64) -> Duration {
        return Duration(ns: self.ns * k)
    }

    func op_rmul(self, k: int64) -> Duration {
        return Duration(ns: self.ns * k)
    }

    func op_div(self, k: int64) -> Duration {
        return Duration(ns: self.ns / k)
    }

    func op_eq(self, other: Duration) -> bool {
        return self.ns == other.ns
    }

    func op_lt(self, other: Duration) -> bool {
        return self.ns < other.ns
    }

    // Whole milliseconds, truncated toward zero.
    func as_ms(self) -> int64 {
        return self.ns / 1000000
    }

    // Milliseconds, rounded up: what a timeout in milliseconds needs, so that a short one is not 0.
    func ceil_ms(self) -> int64 {
        if self.ns > 0 {
            return (self.ns + 999999) / 1000000
        }
        return self.ns / 1000000
    }

    // Whole seconds, truncated toward zero.
    func as_seconds(self) -> int64 {
        return self.ns / 1000000000
    }

    func to_str(self) -> str {
        if self.ns == 0 {
            return "0s"
        }
        mut n = self.ns
        mut sign = ""
        if n < 0 {
            sign = "-"
            n = 0 - n
        }
        if n < 1000 {
            return sign + n.to_str() + "ns"
        }
        if n < 1000000 {
            return sign + decimal(n / 1000, n % 1000, scale: 1000) + "us"
        }
        if n < 1000000000 {
            return sign + decimal(n / 1000000, n % 1000000, scale: 1000000) + "ms"
        }
        let whole_seconds = n / 1000000000
        let hours = whole_seconds / 3600
        let minutes = (whole_seconds % 3600) / 60
        let secs = decimal(whole_seconds % 60, n % 1000000000, scale: 1000000000) + "s"
        if hours > 0 {
            return sign + hours.to_str() + "h" + minutes.to_str() + "m" + secs
        }
        if minutes > 0 {
            return sign + minutes.to_str() + "m" + secs
        }
        return sign + secs
    }
}

// `whole` and `frac` of a unit worth `scale` (a power of ten) of the next one down, as `12.5`.
func decimal(anon whole: int64, anon frac: int64, scale: int64) -> str {
    if frac == 0 {
        return whole.to_str()
    }
    let digits = len(scale.to_str()) - 1
    let raw = frac.to_str()
    let padded = "0".repeat(digits - len(raw)) + raw
    mut end = len(padded)
    for end > 0 and padded[end - 1] == '0' {
        end -= 1
    }
    return whole.to_str() + "." + padded[0..end]
}

// Wait at least `d`; a signal doesn't cut it short, and zero or less returns at once.
func sleep(anon d: Duration) -> none {
    kod_sleep_ns(d.ns)
}
