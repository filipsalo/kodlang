// A generic function from another module: its body and defaults resolve names where they were written.

import "./../generic_func_dep"
import "./../generic_func_dep" { wrap }
import "./../generic_func_dep2"

func secret() -> str {
    return "the caller's"
}

test "names resolve where the generic function was written" {
    assert generic_func_dep.tag("a") == "the module's:a"
    assert generic_func_dep.tag(1) == "the module's:1"
    assert generic_func_dep.tag[str]("b") == "the module's:b"
    assert wrap(2).v == 2
    assert generic_func_dep.with_default(xs: ["x"]) == 2
    assert len(generic_func_dep.empty[int64]()) == 0
    assert secret() == "the caller's"
    assert generic_func_dep.literal_inside("l") == 2
    assert generic_func_dep2.tags() == "the module's:twothe module's:2"
}
