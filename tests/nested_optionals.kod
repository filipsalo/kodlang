// An `int64?` that goes where an optional `int64?` is expected becomes its
// value, so a stored `none` differs from a missing one.

type MaybeInt = int64?

type Slot = struct {
    v: MaybeInt?
}

type Box = enum {
    Full(v: MaybeInt?)
    Empty
}

func show(anon x: MaybeInt?) -> str {
    if x is Some(inner) {
        if inner is Some(n) {
            return f"some {n}"
        }
        return "some none"
    }
    return "none"
}

func lift(anon x: int64?) -> MaybeInt? {
    return x
}

func main() -> int64 {
    let m = Map[str, int64?]()
    m.set("k", 5)
    m["n"] = none
    let stored: int64? = none
    m["s"] = stored
    for key in ["k", "n", "s", "zz"] {
        print(f"{key}: {show(m.get(key))} {show(m[key])}")
    }
    let five: int64? = 5
    print(show(five))
    print(show(stored))
    print(show(none))
    print(show(lift(five)))
    print(show(lift(stored)))
    let s = Slot(v: stored)
    print(show(s.v))
    s.v = five
    print(show(s.v))
    s.v = none
    print(show(s.v))
    let boxes = [Box.Full(v: stored), Box.Full(v: five), Box.Empty]
    for b in boxes {
        match b {
            .Full(v) -> print(show(v))
            .Empty -> print("empty")
        }
    }
    let xs: [MaybeInt?] = [five, stored, none]
    for x in xs {
        print(show(x))
    }
    return 0
}

// expected output:
// k: some 5 some 5
// n: some none some none
// s: some none some none
// zz: none none
// some 5
// some none
// none
// some 5
// some none
// some none
// some 5
// none
// some none
// some 5
// empty
// some 5
// some none
// none
