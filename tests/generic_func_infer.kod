// Type arguments of a generic function are worked out from the call's arguments.

type Box[T] = struct {
    v: T

    func twice(self) -> [T] {
        return add(xs: [self.v], x: self.v)
    }
}

type Color = enum {
    Red
    Green
}

interface Named {
    func name(self) -> str
}

type Sq = struct {
    func name(self) -> str { return "sq" }
}

type Dot = struct {
    func name(self) -> str { return "dot" }
}

func first[T](anon xs: [T]) -> T? {
    if len(xs) == 0 {
        return none
    }
    return xs[0]
}

func map_all[T, U](anon xs: [T], f: func(T) -> U) -> [U] {
    mut out: [U] = []
    for x in xs {
        out += [f(x)]
    }
    return out
}

func id[T](anon x: T) -> T {
    return x
}

func unbox[T](anon b: Box[T]) -> T {
    return b.v
}

func or_else[T](anon x: T?, fallback: T) -> T {
    return x? or fallback
}

func add[T](xs: [T], x: T) -> [T] {
    return xs + [x]
}

func pair_up[A, B](a: A, b: B) -> Box[Box[A]] {
    let _ = b
    return Box[Box[A]](v: Box[A](v: a))
}

func show(anon n: int64) -> str {
    return f"#{n}"
}

func count[T](xs: [T], extra: [T] = []) -> int64 {
    return len(xs) + len(extra)
}

func color_of[T](anon x: T) -> T {
    let copy: T = x
    return copy
}

func depth[T](anon x: T, n: int64) -> int64 {
    if n == 0 {
        return 0
    }
    return 1 + depth(x, n: n - 1)
}

func main() -> int64 {
    print(first([1, 2])?)
    print(first(["a", "b"])?)
    let none_left: [str] = []
    print(first(none_left) is none)
    print(first([[1, 2], [3]])?[1])

    let strs = map_all([1, 2], f: show)
    print(strs[1] + "!")
    let lens = map_all(["ab", "c"], f: func(anon s: str) -> int64 { return len(s) })
    print(lens[0] + lens[1])

    print(id(7) + 1)
    print(id("x") + "y")
    print(id(true))
    print(id(1.5))
    print(unbox(Box[str](v: "boxed")))
    print(unbox(id(Box[int64](v: 4))) + 1)

    let maybe: int64? = none
    print(or_else(maybe, fallback: 3))
    print(or_else(5, fallback: 3))
    print(or_else(none, fallback: "z"))

    print(len(add(xs: [], x: 1)))
    print(add(xs: ["a"], x: "b")[1])
    print(pair_up(a: "deep", b: 2).v.v)
    print(count(xs: [1, 2]))
    print(count(xs: ["a"], extra: ["b", "c"]))

    let c = color_of(Color.Green)
    print(c is .Green)
    print(depth("s", n: 3))

    let shape: Named = id[Named](Sq())
    print(shape.name())
    print(id[Named](Dot()).name())
    let o = id[int64?](none)
    print(o is none)
    print(len(map_all[int64, str]([], f: show)))
    print(len(Box[str](v: "m").twice()))
    let id_str = id[str]
    print(id_str("value"))
    print(map_all([1], f: id[int64])[0])
    return 0
}

// expected output:
// 1
// a
// true
// 2
// #2!
// 3
// 8
// xy
// true
// 1.5
// boxed
// 5
// 3
// 5
// z
// 1
// b
// deep
// 2
// 3
// true
// 3
// sq
// dot
// true
// 0
// 2
// value
// 1
