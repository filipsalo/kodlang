import "crypto/sha2"
import "encoding/hex"

func pattern(anon n: int64) -> bytes {
    return kod_bytes_from_array([(i * 7 + 3) % 256 for i in 0..n])
}

func check(anon n: int64, anon want256: str, anon want384: str, anon want512: str) -> none {
    let data = pattern(n)
    assert hex.encode(sha2.sha256(data)) == want256
    assert hex.encode(sha2.sha384(data)) == want384
    assert hex.encode(sha2.sha512(data)) == want512
}

test "FIPS 180-4 examples" {
    assert hex.encode(sha2.sha256(b"abc")) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    assert hex.encode(sha2.sha256(b"")) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    assert hex.encode(sha2.sha384(b"abc")) == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"
    assert hex.encode(sha2.sha512(b"abc")) == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
    let two = b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    assert hex.encode(sha2.sha256(two)) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
}

