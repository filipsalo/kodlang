// Nested patterns: a payload position holds a pattern, tested after its parent, in every place a pattern binds.

type Shape = enum {
    Circle(radius: int64)
    Rect(w: int64, h: int64)
    Dot
}

interface Solid {
    func size(self) -> int64
}

type Sq = struct {
    s: int64

    func size(self) -> int64 {
        return self.s
    }
}

type Disc = struct {
    r: int64

    func size(self) -> int64 {
        return self.r
    }
}

type Item = enum {
    Pair(left: int64?, name: str)
    Boxed(shape: Shape?)
    Flag(on: bool, depth: Item?)
    Held(solid: Solid)
    Done(result: int64 or Error)
}

type Box[T] = enum {
    Full(value: T)
    Empty
}

type BadError = struct {
    message: str

    func to_str(self) -> str {
        return self.message
    }
}

func fail(msg: str) -> int64 or Error {
    throw BadError(message: msg)
}

func fine(n: int64) -> int64 or Error {
    return n
}

func literals(shape: Shape) -> str {
    match shape {
        .Rect(w, 0) -> return f"flat {w}"
        .Rect(0, h) -> return f"thin {h}"
        .Rect(w, h) -> return f"rect {w}x{h}"
        .Circle(1) -> return "unit"
        .Circle(r) -> return f"circle {r}"
        .Dot -> return "dot"
    }
}

func optional(best: Shape?) -> str {
    match best {
        Some(.Circle(r)) -> return f"circle {r}"
        Some(.Rect(w, h)) -> return f"rect {w}x{h}"
        Some(.Dot) -> return "dot"
        none -> return "nothing"
    }
}

func item(i: Item) -> str {
    match i {
        .Pair(Some(0), "zero") -> return "both zero"
        .Pair(Some(n), "zero") -> return f"named zero, {n}"
        .Pair(none, name) -> return f"no left, {name}"
        .Pair(Some(n), name) -> return f"{name} {n}"
        .Boxed(Some(.Circle(5))) -> return "boxed five"
        .Boxed(Some(.Circle(r))) -> return f"boxed {r}"
        .Boxed(Some(_)) -> return "boxed other"
        .Boxed(none) -> return "empty box"
        .Flag(true, Some(.Flag(false, none))) -> return "deep"
        .Flag(true, _) -> return "on"
        .Flag(false, _) -> return "off"
        .Held(Sq(sq)) -> return f"square {sq.s}"
        .Held(Disc) -> return "disc"
        .Held(_) -> return "solid"
        .Done(Ok(3)) -> return "three"
        .Done(Ok(n)) -> return f"ok {n}"
        .Done(Err(e)) -> return f"err {e.to_str()}"
    }
}

func as_value(best: Shape?) -> int64 {
    return match best {
        Some(.Rect(w, 0)) -> w
        Some(.Rect(w, h)) -> w * h
        Some(.Circle(r)) -> {
            let d = 2 * r
            d * 3
        }
        else -> -1
    }
}

func generic(b: Box[Box[str]]) -> str {
    match b {
        .Full(.Full("x")) -> return "x inside"
        .Full(.Full(s)) -> return f"{s} inside"
        .Full(.Empty) -> return "hollow"
        .Empty -> return "empty"
    }
}

func alternatives(shape: Shape) -> str {
    match shape {
        .Rect(0, _) | .Rect(_, 0) -> return "flat"
        .Circle(0) | .Dot -> return "point"
        else -> return "solid"
    }
}

func let_else(best: Shape?) -> int64 {
    let .Some(.Circle(r)) = best else { return -1 }
    return r
}

func in_if(best: Shape?) -> str {
    if best is Some(.Circle(r)) and r > 1 {
        return f"big {r}"
    } else if best is .Some(.Rect(_, 0)) {
        return "flat"
    } else if best is not Some(.Dot) {
        return "not a dot"
    }
    return "dot"
}

func in_for(xs: [Shape?]) -> int64 {
    mut i = 0
    mut total = 0
    for i < len(xs) and xs[i] is Some(.Circle(r)) {
        total += r
        i += 1
    }
    return total
}

func main() -> int64 {
    print(literals(shape: .Rect(w: 3, h: 0)))
    print(literals(shape: .Rect(w: 0, h: 4)))
    print(literals(shape: .Rect(w: 2, h: 5)))
    print(literals(shape: .Circle(radius: 1)))
    print(literals(shape: .Circle(radius: 9)))
    print(literals(shape: .Dot))
    print(optional(best: Shape.Circle(radius: 7)))
    print(optional(best: Shape.Rect(w: 1, h: 2)))
    print(optional(best: Shape.Dot))
    print(optional(best: none))
    print(item(i: .Pair(left: 0, name: "zero")))
    print(item(i: .Pair(left: 8, name: "zero")))
    print(item(i: .Pair(left: none, name: "a")))
    print(item(i: .Pair(left: 2, name: "b")))
    print(item(i: .Boxed(shape: Shape.Circle(radius: 5))))
    print(item(i: .Boxed(shape: Shape.Circle(radius: 6))))
    print(item(i: .Boxed(shape: Shape.Dot)))
    print(item(i: .Boxed(shape: none)))
    print(item(i: .Flag(on: true, depth: Item.Flag(on: false, depth: none))))
    print(item(i: .Flag(on: true, depth: Item.Flag(on: true, depth: none))))
    print(item(i: .Flag(on: false, depth: none)))
    print(item(i: .Held(solid: Sq(s: 2))))
    print(item(i: .Held(solid: Disc(r: 2))))
    print(item(i: .Done(result: fine(n: 3))))
    print(item(i: .Done(result: fine(n: 4))))
    print(item(i: .Done(result: fail(msg: "bad"))))
    print_int(as_value(best: Shape.Rect(w: 6, h: 0)))
    print_int(as_value(best: Shape.Rect(w: 6, h: 2)))
    print_int(as_value(best: Shape.Circle(radius: 2)))
    print_int(as_value(best: none))
    let inner: Box[str] = .Full(value: "x")
    let other: Box[str] = .Full(value: "y")
    let hollow: Box[str] = .Empty
    print(generic(b: .Full(value: inner)))
    print(generic(b: .Full(value: other)))
    print(generic(b: .Full(value: hollow)))
    print(generic(b: .Empty))
    print(alternatives(shape: .Rect(w: 0, h: 2)))
    print(alternatives(shape: .Rect(w: 2, h: 0)))
    print(alternatives(shape: .Rect(w: 2, h: 2)))
    print(alternatives(shape: .Circle(radius: 0)))
    print(alternatives(shape: .Dot))
    print_int(let_else(best: Shape.Circle(radius: 11)))
    print_int(let_else(best: Shape.Dot))
    print_int(let_else(best: none))
    print(in_if(best: Shape.Circle(radius: 2)))
    print(in_if(best: Shape.Circle(radius: 1)))
    print(in_if(best: Shape.Rect(w: 1, h: 0)))
    print(in_if(best: Shape.Dot))
    let shapes: [Shape?] = [Shape.Circle(radius: 1), Shape.Circle(radius: 2), none, Shape.Circle(radius: 4)]
    print_int(in_for(xs: shapes))
    return 0
}

// expected output:
// flat 3
// thin 4
// rect 2x5
// unit
// circle 9
// dot
// circle 7
// rect 1x2
// dot
// nothing
// both zero
// named zero, 8
// no left, a
// b 2
// boxed five
// boxed 6
// boxed other
// empty box
// deep
// on
// off
// square 2
// disc
// three
// ok 4
// err bad
// 6
// 12
// 12
// -1
// x inside
// y inside
// hollow
// empty
// flat
// flat
// solid
// point
// point
// 11
// -1
// -1
// big 2
// not a dot
// flat
// dot
// 3
