// The compiler reports a downcast through a module name a local hides.
import "./downcast_qualified_dep"

func f(anon e: Error) -> str {
    let downcast_qualified_dep = 3
    if e is downcast_qualified_dep.NotFound(nf) {
        return nf.key
    }
    return f"{downcast_qualified_dep}"
}

func main() -> int64 {
    print(f(downcast_qualified_dep.failure("q")))
    return 0
}

// expected stderr:
// 5:9: error: `downcast_qualified_dep` is the name of an import; give the local another name
// expected status:
// 1
