func f0(anon d: int64) -> none {
    if d > 0 {
        f1(d - 1)
        f2(d - 2)
        f3(d - 3)
    }
}

func f1(anon d: int64) -> none {
    if d > 0 {
        f2(d - 1)
        f3(d - 2)
        f4(d - 3)
