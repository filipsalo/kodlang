// A type argument written through a module alias means the module even
// where a local of that name is in force, also one that hides another binding.
import "./hidden_alias_dep"

type Box[T] = struct {
    v: T
}

func hiding(anon pt: hidden_alias_dep.Pt, anon c: hidden_alias_dep.Color, anon hidden_alias_dep: int64) -> int64 {
    mut sum = hidden_alias_dep
    if sum > 0 {
        let hidden_alias_dep = 10
        let one = Box[hidden_alias_dep.Pt](v: pt)
        let many = Box[[hidden_alias_dep.Pt]](v: [pt, pt])
        let maybe = Box[hidden_alias_dep.Pt?](v: none)
        let color = Box[hidden_alias_dep.Color](v: c)
        let by_name = Map[str, hidden_alias_dep.Pt]()
        if maybe.v is none and color.v is .Blue and len(by_name) == 0 {
            sum += hidden_alias_dep + one.v.x + len(many.v)
        }
    }
    for hidden_alias_dep in [100, 200] {
        let by_color = Map[str, hidden_alias_dep.Color]()
        sum += hidden_alias_dep + len(by_color)
    }
    return sum
}

func alone(anon pt: hidden_alias_dep.Pt) -> int64 {
    let hidden_alias_dep = 5
    let one = Box[hidden_alias_dep.Pt](v: pt)
    return hidden_alias_dep + one.v.x
}

func main() -> int64 {
    let pt = hidden_alias_dep.make(4)
    print_int(hiding(pt, .Blue, 1))
    print_int(alone(pt))
    return 0
}

// expected output:
// 317
// 9
