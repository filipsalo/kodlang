// A server that speaks HTTPS (docs/http.md#https).
import "io"
import "libc"
import "net/http" { BodyWriter, Client, Options, Request, Response, Router, Server, get, stream, text }
import "net/tcp"
import "net/tls"
import "posix" { Fd }
import "process"
import "stream" { IoError }
import "tasks"
import "time"
import "time" { Duration, monotonic_ns }

let CERT: str = "build/http_tls_test_cert.pem"
let KEY: str = "build/http_tls_test_key.pem"
let CERT2: str = "build/http_tls_test_cert2.pem"
let KEY2: str = "build/http_tls_test_key2.pem"

func make(anon cert: str, anon key: str) -> none {
    if io.is_file(cert) and io.is_file(key) {
        return
    }
    let k = f"{key}.{libc.getpid()}"
    let c = f"{cert}.{libc.getpid()}"
    let made = process.run(["/usr/bin/openssl", "ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", k])
    assert made.status == 0
    let signed = process.run(["/usr/bin/openssl", "req", "-x509", "-new", "-key", k, "-out", c, "-subj", "/CN=localhost", "-days", "30", "-addext", "subjectAltName=DNS:localhost", "-addext", "extendedKeyUsage=serverAuth"])
    assert signed.status == 0
    // Both at once: tests run at the same time.
    let _ = process.run(["mv", "-f", k, key])
    let _ = process.run(["mv", "-f", c, cert])
}

func big_text() -> str {
    mut s = "0123456789abcdef"
    for len(s) < 4000000 {
        s = s + s
    }
    return s
}

func hello(anon req: Request) -> Response or Error {
    return text(f"hello {req.secure} {req.path()}")
}

func big(anon _req: Request) -> Response or Error {
    return text(big_text())
}

func slow(anon _req: Request) -> Response or Error {
    time.sleep(Duration(ms: 100))
    return text("slow")
}

func count(anon req: Request) -> Response or Error {
    let data = try req.reader().read_all()
    return text(f"{len(data)}")
}

func ticks(anon _req: Request) -> Response or Error {
    return stream(func(anon w: BodyWriter) -> none or Error {
        for i in 0..3 {
            try w.write_str(f"{i}")
            try w.flush()
            time.sleep(Duration(ms: 40))
        }
    })
}

func echo(anon req: Request) -> Response or Error {
    let body = req.reader()
    return stream(func(anon w: BodyWriter) -> none or Error {
        let _ = try body.copy_to(w)
    })
}

type Fixture = shared struct {
    l: tcp.Listener
    server: Server

    func init() -> Fixture {
        make(CERT, KEY)
        let routes = Router()
        routes.get("/big", big)
        routes.get("/slow", slow)
        routes.get("/ticks", ticks)
        routes.put("/count", count, stream_body: true)
        routes.put("/echo", echo, stream_body: true)
        routes.get("/{rest...}", hello)
        let server = Server(
            : routes,
            identity: must tls.load_identity(CERT, KEY),
            header_timeout: Duration(ms: 200),
            idle_timeout: Duration(ms: 200),
            write_timeout: Duration(ms: 300),
        )
        return Fixture(l: must tcp.listen("127.0.0.1", port: 0), :server)
    }

    func url(self, anon path: str) -> str {
        return f"https://localhost:{self.l.port()}{path}"
    }

    func end(self, anon serving: tasks.Task[str]) -> none {
        self.server.stop()
        assert serving.wait() == "ok"
        must self.l.close()
    }
}

func serve(anon f: Fixture) -> str {
    if f.server.serve(f.l) is Err(e) {
        return e.to_str()
    }
    return "ok"
}

func ms_since(anon t0: int64) -> int64 {
    return (monotonic_ns() - t0) / 1000000
}

func rest(anon conn: Fd) -> str {
    let _ = tcp.set_timeout(conn, timeout: Duration(seconds: 3))
    mut out = ""
    for true {
        let data = conn.read(65536)
        if data is Err(e) {
            return out + f"[{e.to_str()}]"
        }
        let got = data
        if len(got) == 0 {
            return out
        }
        out += kod_bytes_to_str(got)
    }
    return out
}

test "requests over HTTPS, on one connection" {
    let f = Fixture()
    let serving = spawn serve(f)
    let client = Client(trust_file: CERT)
    for i in 0..5 {
        assert (must client.get(f.url(f"/a/{i}"))).text() == f"hello true /a/{i}"
    }
    assert len(client.pool) == 1
    assert len(f.server.conns) == 1
    assert (must client.get(f.url("/big"))).text() == big_text()
    assert (must client.fetch("HEAD", f.url("/big"))).status == 200
    let up = must client.put(f.url("/count"), kod_str_to_bytes(big_text()), content_type: "text/plain")
    assert up.text() == f"{len(big_text())}"
    client.close()
    f.end(serving)
}

test "bodies streamed both ways" {
    let f = Fixture()
    let serving = spawn serve(f)
    let client = Client(trust_file: CERT)
    let body = (must client.open("GET", f.url("/ticks"))).reader()
    let t0 = monotonic_ns()
    assert kod_bytes_to_str(must body.read(10)) == "0"
    assert ms_since(t0) < 35
    assert kod_bytes_to_str(must body.read_all()) == "12"
    let echoed = must client.put(f.url("/echo"), kod_str_to_bytes(big_text()[0..300000]), content_type: "text/plain")
    assert echoed.text() == big_text()[0..300000]
    client.close()
    f.end(serving)
}

func fetch_one(anon url: str) -> str {
    let got = get(url, options: Options(trust_file: CERT))
    if got is Err(e) {
        return e.to_str()
    }
    return got.text()
}

test "many clients at the same time" {
    let f = Fixture()
    let serving = spawn serve(f)
    let t0 = monotonic_ns()
    mut asked: [tasks.Task[str]] = []
    for _i in 0..20 {
        asked += [spawn fetch_one(f.url("/slow"))]
    }
    for a in asked {
        assert a.wait() == "slow"
    }
    assert ms_since(t0) < 1500
    f.end(serving)
}

test "a client that says nothing, half a handshake or plain HTTP" {
    let f = Fixture()
    let serving = spawn serve(f)
    let silent = must tcp.connect("127.0.0.1", port: f.l.port())
    let t0 = monotonic_ns()
    assert rest(silent) == ""
    assert 150 <= ms_since(t0) < 600
    let half = must tcp.connect("127.0.0.1", port: f.l.port())
    must half.write_all(b"\x16\x03\x01\x02\x00\x01\x00")
    let t1 = monotonic_ns()
    let _ = rest(half)
    assert 150 <= ms_since(t1) < 600
    let plain = must tcp.connect("127.0.0.1", port: f.l.port())
    must plain.write_str("GET / HTTP/1.1\r\nHost: a\r\n\r\n")
    assert not rest(plain).contains("hello")
    for c in [silent, half, plain] {
        must c.close()
    }
    // And the server goes on.
    assert fetch_one(f.url("/x")) == "hello true /x"
    time.sleep(Duration(ms: 30))
    assert len(f.server.conns) == 0
    f.end(serving)
}

test "a handshake and then nothing" {
    let f = Fixture()
    let serving = spawn serve(f)
    let t0 = monotonic_ns()
    let s = must tls.connect("localhost", port: f.l.port(), trust_file: CERT)
    // A close notice, when the time for both is over.
    assert len(must s.read(100)) == 0
    assert 150 <= ms_since(t0) < 350
    must s.close()
    f.end(serving)
}

test "half a request over TLS gets a 408" {
    let f = Fixture()
    let serving = spawn serve(f)
    let s = must tls.connect("localhost", port: f.l.port(), trust_file: CERT)
    must s.write_str("GET / HTTP/1.1\r\nHo")
    assert kod_bytes_to_str(must s.read(1000)).starts_with("HTTP/1.1 408 ")
    must s.close()
    let bad = must tls.connect("localhost", port: f.l.port(), trust_file: CERT)
    must bad.write_str("NOT HTTP\r\n\r\n")
    let got = kod_bytes_to_str(must bad.read_all())
    assert got.starts_with("HTTP/1.1 400 ")
    must bad.close()
    f.end(serving)
}

test "a client that doesn't read its response holds up nobody, and is dropped" {
    let f = Fixture()
    let serving = spawn serve(f)
    let s = must tls.connect("localhost", port: f.l.port(), trust_file: CERT)
    must s.write_str("GET /big HTTP/1.1\r\nHost: a\r\n\r\n")
    time.sleep(Duration(ms: 50))
    let t0 = monotonic_ns()
    assert fetch_one(f.url("/x")) == "hello true /x"
    assert ms_since(t0) < 150
    time.sleep(Duration(ms: 500))
    assert len(f.server.conns) == 0
    must s.close()
    f.end(serving)
}

test "stop lets a request finish" {
    let f = Fixture()
    let serving = spawn serve(f)
    let asked = spawn fetch_one(f.url("/slow"))
    time.sleep(Duration(ms: 50))
    f.server.stop()
    assert asked.wait() == "slow"
    assert serving.wait() == "ok"
    must f.l.close()
}

test "another certificate, from now on" {
    make(CERT2, KEY2)
    let f = Fixture()
    let serving = spawn serve(f)
    let old = Client(trust_file: CERT)
    assert (must old.get(f.url("/x"))).status == 200
    let before = f.server.identity
    f.server.identity = must tls.load_identity(CERT2, KEY2)
    // A connection that is open goes on, though its identity is freed.
    if before is tls.Identity(i) {
        i.close()
    }
    assert (must old.get(f.url("/x"))).status == 200
    let client = Client(trust_file: CERT2)
    assert (must client.get(f.url("/x"))).status == 200
    assert Client(trust_file: CERT).get(f.url("/x")) is Err(_)
    old.close()
    client.close()
    f.end(serving)
}
