// An ambiguous `.Variant` writes each enum the way the module would: its own
// by its bare name, an imported one through its alias.
import "./type_names_pa"

type Shape = enum {
    Circle(r: int64)
    Square(side: int64)
}

func main() -> int64 {
    let u = .Circle(r: 1)
    let v: Shape = .Circle(r: 1)
    return 0
}

// expected errors:
// 11:13: error: `.Circle` is ambiguous: `type_names_pa.Shape` and `Shape` both declare it; write `Shape.Circle` or give the value a type
