// A program that panics, for tests/debug_info_test.kod: under lldb it stops
// where it panicked (docs/debugging.md).

func pick(anon xs: [int64], anon i: int64) -> int64 {
    return xs[i]
}

func main() -> int64 {
    let xs = [1, 2, 3]
    print(f"{pick(xs, 1)}")
    print(f"{pick(xs, 7)}")
    return 0
}
