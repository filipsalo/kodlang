// A variable whose value needs itself, through a function, stops the program.
import "testing"

mut a: int64 = from_b()
mut b: int64 = a + 1

func from_b() -> int64 {
    return b * 2
}

test "a variable whose value needs itself panics" {
    let r = testing.run(func() {
        print("start")
        print_int(a)
    })
    assert r.status == 1
    assert r.stdout == "start\n"
    assert r.stderr.contains("panic: `a` is used while its value is being worked out")
}
