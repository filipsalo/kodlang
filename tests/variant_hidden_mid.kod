import "./implicit_variant_ambiguous_dep"
import "./variant_ambiguous_xmod_dep"

func radius(anon f: implicit_variant_ambiguous_dep.Figure) -> int64 {
    match f {
        .Square(side) -> return side
        .Circle(r) -> return r
    }
}

type Holder = struct {
    fs: [implicit_variant_ambiguous_dep.Figure] = []
}

type Bag = struct {
    fss: [[implicit_variant_ambiguous_dep.Figure]]

    func all(self) -> [[implicit_variant_ambiguous_dep.Figure]] {
        return self.fss
    }
}

func list() -> [implicit_variant_ambiguous_dep.Figure] {
    return [.Square(side: 1)]
}

func nested() -> [[implicit_variant_ambiguous_dep.Figure]] {
    return [[.Square(side: 14)]]
}

func total(anon fs: [implicit_variant_ambiguous_dep.Figure]) -> int64 {
    mut t = 0
    for f in fs {
        t += radius(f)
    }
    return t
}

