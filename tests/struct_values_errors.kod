type Point = struct {
    x: int64

    func reset(self) -> none {
        self.x = 0
    }

    func set(mut self, anon x: int64) -> none {
        self.x = x
    }
}

type Node = struct {
    weak up: Node?
}

type Graph = shared struct {
    func clear(mut self) -> none {
    }
}

interface Settable {
    func set(self, anon x: int64) -> none
}

func use(anon p: Point) -> none {
    p.x = 1
    p.set(2)
}

func main() -> int64 {
    let p = Point(x: 1)
    p.x = 2
    p.set(3)
    for q in [p] {
        q.x = 4
    }
    let s: Settable = Point(x: 0)
    return 0
}

