// A top-level `let NAME: T = value` is a constant.
import "./module_constants_dep"
import "./module_constants_dep" { LIMIT }

type Color = enum {
    Red
    Green
}

// A constant may use constants declared before or after it.
let SECONDS_PER_DAY: int64 = 24 * HOURS_PER_DAY_SECONDS
let HOURS_PER_DAY_SECONDS: int64 = 60 * 60
let GREETING: str = "hello, " + AUDIENCE + "!"
let AUDIENCE: str = "world"
let PRIMES: [int64] = [2, 3, 5, 7]
let FAVORITE: Color = Color.Green
let VERBOSE: bool = false
let NEGATIVE: int64 = -5
let MASK: int64 = (1 << 4) - 1
let SMALL: bool = 1 < 2 and 2 < 3
let LETTER: int64 = 'A'
let BLOB: bytes = b"\x01\x02"

// Doc comments go with a constant, as they do with a function.
let DOCUMENTED: int64 = 7

func area(anon side: int64 = SIDE) -> int64 {
    return side * side
}

let SIDE: int64 = 3

func color_name(anon c: Color) -> str {
    match c {
        .Red -> return "red"
        .Green -> return "green"
    }
}

func main() -> int64 {
    print_int(SECONDS_PER_DAY)
    print(GREETING)
    print_int(len(PRIMES))
    print_int(PRIMES[2])
    print(color_name(FAVORITE))
    if VERBOSE {
        print("verbose")
    }
    print_int(NEGATIVE)
    print_int(MASK)
    if SMALL {
        print("small")
    }
    print_int(LETTER)
    print_int(len(BLOB))
    print_int(DOCUMENTED)

    // As defaults, in expressions, and with annotations.
    print_int(area())
    print_int(area(4))
    let doubled: int64 = SIDE * 2
    print_int(doubled)
    let copy = SIDE
    print_int(copy)

    // Another module's, three ways.
    print_int(LIMIT)
    print_int(module_constants_dep.LIMIT)
    print(module_constants_dep.NAME)
    print_int(module_constants_dep.DOUBLE_LIMIT)
    print_int(module_constants_dep.DOUBLE_LIMIT + LIMIT)

    // A local hides a constant of the same name.
    let SIDE = 10
    print_int(SIDE)

    // An array constant is new at each use.
    mut mine = PRIMES
    mine[0] = 99
    print_int(PRIMES[0])
    print_int(mine[0])
    return 0
}

// expected output:
// 86400
// hello, world!
// 4
// 5
// green
// -5
// 15
// small
// 65
// 2
// 7
// 9
// 16
// 6
// 3
// 1000
// 1000
// limits
// 2000
// 3000
// 10
// 2
// 99

// expected status:
// 0
