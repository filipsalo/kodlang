// Methods declared in an enum body: on a local, a payload variant, an
// imported enum, through `?.`, chained, with defaults, and `to_str` in
// f-strings.
import "./enum_methods_dep" { Level }

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
    Empty

    func area(self) -> int64 {
        return match self {
            .Circle(r) -> 3 * r * r
            .Rect(w, h) -> w * h
            .Empty -> 0
        }
    }

    func scaled(self, by: int64) -> Shape {
        return match self {
            .Circle(r) -> .Circle(r: r * by)
            .Rect(w, h) -> .Rect(w: w * by, h: h * by)
            .Empty -> .Empty
        }
    }

    func bigger(self, than other: Shape) -> bool {
        return self.area() > other.area()
    }

    func to_str(self) -> str {
        return match self {
            .Circle(r) -> f"circle {r}"
            .Rect(w, h) -> f"rect {w}x{h}"
            .Empty -> "nothing"
        }
    }
}

type Dir = enum {
    North
    South

    func flip(self) -> Dir {
        return match self {
            .North -> .South
            .South -> .North
        }
    }
}

func pick(anon b: bool) -> Shape? {
    if b {
        return .Circle(r: 2)
    }
    return none
}

func main() {
    let s: Shape = .Rect(w: 2, h: 3)
    print(s.area())
    print(s.scaled(by: 2).area())
    print(s.bigger(than: .Circle(r: 1)))
    print(s)
    print(f"[{s.scaled(by: 3)}] [{Shape.Empty}]")
    let shapes: [Shape] = [.Circle(r: 1), .Empty, s]
    mut total = 0
    for sh in shapes {
        total += sh.area()
    }
    print(total)
    print(pick(true)?.area()? or -1)
    print(pick(false)?.area()? or -1)
    print(f"{Dir.North.flip()} {Dir.North.flip().flip()}")
    let l: Level = .High(by: 3)
    print(f"{l.weight()} {l.weight(base: 2)} {Level.Low.weight()}")
}

// expected output:
// 6
// 24
// true
// rect 2x3
// [rect 6x9] [nothing]
// 9
// 12
// -1
// South North
// 31 7 10
