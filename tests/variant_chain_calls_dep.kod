type Figure = enum {
    Circle(r: int64)
    Square(side: int64)
    Dot
}

type Holder = struct {
    fs: [Figure] = []

    func all(self) -> [Figure] {
        return self.fs
    }
}

func list() -> [Figure] {
    return [.Square(side: 1)]
}

type Figures = [Figure]

func maybe(anon some: bool) -> Figures? {
    if some {
        return [.Square(side: 2)]
    }
    return none
}

func fallible() -> [Figure] or Error {
    return [.Square(side: 3)]
}

func total(anon fs: [Figure]) -> int64 {
    mut t = 0
    for f in fs {
        if f == Figure.Dot {
            t += 10000
        }
        match f {
            .Circle(r) -> t += r * 100
            .Square(side) -> t += side
            .Dot -> t += 20000
        }
    }
    return t
}

