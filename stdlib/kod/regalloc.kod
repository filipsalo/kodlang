// Linear-scan register allocator over the buffered instruction stream
// of a single function. The codegen hands out alloc-time physicals
// while emitting (so the produced asm reads naturally), but those
// initial assignments stack-discipline-only — they don't reuse a
// phys once its previous holder's last use is past. This pass walks
// the buffered body to compute per-vreg live intervals, then
// reassigns each vreg from a per-class free pool, expiring intervals
// whose last_use is at-or-before the current def line.
//
// The pass is constrained: a callee-saved vreg can only be rewritten
// to another callee-saved phys, and same for caller-saved. That
// preservation matters because every emit-time decision that asked
// `is_callee_saved(vreg)` (e.g. `spill_across` skipping the stash
// when the value lives in a callee-saved reg) must still get the
// same answer after rewriting.
//
// `pack` is a small follow-up that collapses the chosen callee-saved
// set into a dense `x19..x{19+N-1}` prefix and returns the new
// callee-saved high-water mark; the function prologue saves exactly
// that many registers instead of over-saving to cover gaps.

import "arrays"

// The registers a target gives the allocator (see docs/ir.md). Everything
// else codegen names (arguments, scratch, the frame) is a role it spells as
// arm64 does, for a target's lowering to map.
type Target = struct {
    // Temporaries a call may clobber, in the order they are filled in.
    caller_saved: [Reg]
    // Temporaries a call keeps (the prologue saves them), likewise.
    callee_saved: [Reg]
    // The callee-saved registers in the order the prologue saves them, and a
    // pad that makes their number even.
    save_order: [Reg]
    // The registers calls pass arguments and results in, never in the pool.
    arg_regs: [Reg]
    // A register for a vreg nothing names, which therefore costs nothing.
    unused: Reg
}

mut ARM64: Target = Target(
    caller_saved: regs(["x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15"]),
    callee_saved: regs(["x19", "x20", "x21", "x22", "x23", "x24", "x25", "x26", "x27"]),
    save_order: regs(["x19", "x20", "x21", "x22", "x23", "x24", "x25", "x26", "x27", "x28"]),
    arg_regs: regs(["x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7"]),
    unused: reg_of("x8"),
)

// Each of `names` as a Reg.
func regs(anon names: [str]) -> [Reg] {
    mut out: [Reg] = []
    for name in names {
        out += [reg_of(name)]
    }
    return out
}

// The target being compiled for.
mut TARGET: Target = ARM64

// The first callee-saved register, which a vreg made to be allocated starts as.
func first_callee_saved() -> Reg {
    return TARGET.callee_saved[0]
}

// How many registers the prologue can save: `cs_reg` takes 0 up to this.
func save_order_len() -> int64 {
    return len(TARGET.save_order)
}

// The pool `reset` and `evict` start from: the caller-saved registers, then
// the callee-saved ones at the tail, so `alloc_reg` (which pops the tail)
// hands those out first.
func full_pool() -> [Reg] {
    let t = TARGET
    mut pool: [Reg] = []
    mut i = len(t.caller_saved) - 1
    for i >= 0 {
        pool += [t.caller_saved[i]]
        i -= 1
    }
    i = len(t.callee_saved) - 1
    for i >= 0 {
        pool += [t.callee_saved[i]]
        i -= 1
    }
    return pool
}

// A register or other operand of an instruction (docs/ir.md, step 8): 4n+1
// is vreg n (`v12`), 4n+2 its 32-bit form (`w12`), 4n+3 the immediate `#n`,
// and 4k the kth of NAMES. 0 is none.
type Reg = int64

let NO_REG: Reg = 0
// x0 to x30 are names 1 to 31, then fp, lr, sp, xzr.
let X0: Reg = 4
let X16: Reg = 68
let X28: Reg = 116
let FP: Reg = 128
let LR: Reg = 132
let SP: Reg = 136
let XZR: Reg = 140

// The text of each named operand, by number.
mut NAMES: [str] = first_names()
// The number of each of NAMES.
mut NAME_IDS: Map[str, int64] = name_ids()

func first_names() -> [str] {
    mut names: [str] = [""]
    for n in 0..31 {
        names += [f"x{n}"]
    }
    names += ["fp", "lr", "sp", "xzr"]
    return names
}

func name_ids() -> Map[str, int64] {
    let ids = Map[str, int64]()
    for k, name in NAMES {
        ids[name] = k
    }
    return ids
}

// Vreg `id`, and its 32-bit form.
func vreg(anon id: int64) -> Reg {
    return id * 4 + 1
}

func wvreg(anon id: int64) -> Reg {
    return id * 4 + 2
}

// The immediate `#value`, for 0 <= value.
func imm(anon value: int64) -> Reg {
    return value * 4 + 3
}

// The Reg for an operand as codegen writes it: `v12`, `w12`, `x3`, `#8`, `fp`, `eq`, ...
func reg_of(anon text: str) -> Reg {
    let n = len(text)
    if n == 0 {
        return NO_REG
    }
    let c = text[0]
    if n >= 2 and n <= 11 and (c == 'v' or c == 'w' or c == 'x' or c == '#') and (text[1] != '0' or n == 2) {
        mut v: int64 = 0
        mut digits = true
        for k in 1..n {
            let d = text[k]
            if d < '0' or d > '9' {
                digits = false
                break
            }
            v = v * 10 + d - '0'
        }
        if digits {
            if c == 'v' {
                return v * 4 + 1
            }
            if c == 'w' {
                return v * 4 + 2
            }
            if c == '#' {
                return v * 4 + 3
            }
            if v <= 30 {
                return (v + 1) * 4
            }
        }
    }
    if text == "fp" {
        return FP
    }
    if text == "sp" {
        return SP
    }
    return named(text)
}

// The number of `text` among NAMES, added if it isn't one yet.
func named(anon text: str) -> Reg {
    if NAME_IDS.get(text) is Some(k) {
        return k * 4
    }
    let k = len(NAMES)
    NAMES += [text]
    NAME_IDS[text] = k
    return k * 4
}

// An operand's text, as reg_of read it (a vreg as itself, not its register).
func reg_text(anon r: Reg) -> str {
    match r & 3 {
        1 -> return f"v{r >> 2}"
        2 -> return f"w{r >> 2}"
        3 -> return f"#{r >> 2}"
        else return NAMES[r >> 2]
    }
}

// The value of an immediate operand, or -1 for any other.
func imm_value(anon r: Reg) -> int64 {
    if (r & 3) == 3 {
        return r >> 2
    }
    return -1
}

// Whether `r` is an x vreg or one of x0 to x30.
func is_plain(anon r: Reg) -> bool {
    return (r & 3) == 1 or ((r & 3) == 0 and r >= X0 and r <= 124)
}

// One instruction of a function's buffer, the compiler's low-level IR (see
// docs/ir.md): operations on vregs (`v12`, or `w12` for its 32-bit form) and
// the registers codegen names by their arm64 roles. Codegen's arm64 lowering
// (format_insn) writes each as asm text when the function is output.
type Insn = enum {
    Label(name: str)
    // `ldr reg, [fp, #off]` (`[fp]` for off 0 or more), or `str` with
    // `store`, made without text: see `slot_text`. `reg` is a vreg (`v12`)
    // or a physical register.
    Slot(store: bool, reg: Reg, off: int64)
    // `mov dst, src` between registers (vregs or physical), made without text.
    Mov(dst: Reg, src: Reg)
    // A load into `reg` (or a store of it) of `width` bytes (1, 2, 4 or 8) at
    // the address `base` and `at` make. A 4-byte one has a `w` register, as
    // arm64 writes it.
    Mem(load: bool, width: int64, reg: Reg, base: Reg, at: MemAt)
    // A line that isn't an instruction: a directive, or a label of data.
    // Nothing reads it but the output.
    Data(text: str)
    // What a call to the function `label` does, done in place: the arguments
    // in the first argument registers and the result in the first, as for a
    // call (see arm64_intrinsic).
    Intrinsic(label: str)
    // `dst` gets a constant too big for one move: on arm64 a `mov` and three
    // `movk`s, which LOAD_CONST_LINES counts.
    LoadConst(dst: Reg, value: int64)
    // A load into (or a store of) two registers at once, at `base` per `mode`.
    Pair(load: bool, a: Reg, b: Reg, base: Reg, mode: PairMode)
    // `mn a, b, c, d` with the operands given (up to the first NO_REG): each a
    // register, an immediate, a condition or a symbol, never more than one
    // token (see codegen's emit_op).
    Op(op: Opcode, a: Reg, b: Reg, c: Reg, d: Reg, flags: int64)
    // `bl target`.
    Call(target: str)
    // A jump to `target`, when `kind` says; `reg` is the register tested by
    // `IfZero` and `IfNonzero`, NO_REG for the others.
    Branch(kind: BranchKind, reg: Reg, target: str)
}

// A condition on the flags a compare sets.
type Cond = enum {
    Eq
    Ne
    // Unsigned: at least, below, above, at most.
    Hs
    Lo
    Hi
    Ls
    Mi
    Pl
    Vs
    Vc
    Ge
    Lt
    Gt
    Le
}

// When a `Branch` jumps.
type BranchKind = enum {
    Always
    If(cond: Cond)
    IfZero
    IfNonzero
}

// The condition that holds when `c` doesn't.
func cond_opposite(anon c: Cond) -> Cond {
    match c {
        .Eq -> return .Ne
        .Ne -> return .Eq
        .Hs -> return .Lo
        .Lo -> return .Hs
        .Hi -> return .Ls
        .Ls -> return .Hi
        .Mi -> return .Pl
        .Pl -> return .Mi
        .Vs -> return .Vc
        .Vc -> return .Vs
        .Ge -> return .Lt
        .Lt -> return .Ge
        .Gt -> return .Le
        .Le -> return .Gt
    }
}

// The condition an arm64 name (or its alias `cs`, `cc`) is.
func cond_named(anon name: str) -> Cond? {
    match name {
        "eq" -> return .Eq
        "ne" -> return .Ne
        "hs" -> return .Hs
        "cs" -> return .Hs
        "lo" -> return .Lo
        "cc" -> return .Lo
        "hi" -> return .Hi
        "ls" -> return .Ls
        "mi" -> return .Mi
        "pl" -> return .Pl
        "vs" -> return .Vs
        "vc" -> return .Vc
        "ge" -> return .Ge
        "lt" -> return .Lt
        "gt" -> return .Gt
        "le" -> return .Le
        else return none
    }
}

// Where a `Mem` reads or writes, from its base register.
type MemAt = enum {
    // At the base.
    Base
    // At the base plus `off`.
    Offset(off: int64)
    // At the base plus the register `reg`, shifted left by log2 of the
    // access's width when `scaled` (`[x1, x2, lsl #3]` for 8 bytes).
    Index(reg: Reg, scaled: bool)
    // At the base plus a symbol's offset in its page (`got`: of its entry in
    // the global offset table), with the base the page an AddressPage gave.
    Symbol(name: str, got: bool)
}

// The lines a LoadConst takes on arm64.
let LOAD_CONST_LINES: int64 = 4

// An intrinsic's flags: none, as its lines name only the argument registers.
func intrinsic_flags(anon label: str) -> int64 {
    return 0
}

// Where a `Pair` reads or writes, and whether it moves its base.
type PairMode = enum {
    // At the base plus `off` (at the base for 0).
    At(off: int64)
    // At the base plus `off`, which the base then holds.
    Pre(off: int64)
    // At the base, which then moves on by `off`.
    Post(off: int64)
}

// Whether two `MemAt`s are the same place from the same base.
func same_at(anon a: MemAt, anon b: MemAt) -> bool {
    match a {
        .Base -> return b is .Base
        .Offset(off) -> {
            if b is .Offset(other) {
                return other == off
            }
            return false
        }
        .Index(reg, scaled) -> {
            if b is .Index(other, other_scaled) {
                return other == reg and other_scaled == scaled
            }
            return false
        }
        .Symbol(name, got) -> {
            if b is .Symbol(other, other_got) {
                return other == name and other_got == got
            }
            return false
        }
    }
}

// The index register of a `MemAt`, or NO_REG.
func at_reg(anon at: MemAt) -> Reg {
    if at is .Index(reg, _scaled) {
        return reg
    }
    return NO_REG
}

// The width of a 4- or 8-byte load or store of `reg`: 4 for a `w` register.
func reg_width(anon reg: Reg) -> int64 {
    if (reg & 3) == 2 or ((reg & 3) == 0 and reg > XZR and NAMES[reg >> 2][0] == 'w') {
        return 4
    }
    return 8
}

// Whether a `Mem` writes its register, as writer_at says for its mnemonic:
// a load, other than of 2 bytes (`ldrh` isn't on the list).
func mem_writes(load: bool, width: int64) -> bool {
    return load and width != 2
}

// What an `Op` does, whatever a target calls it (see docs/ir.md).
type Opcode = enum {
    // A register gets an immediate (or a value given as one token).
    Move
    Add
    Sub
    Mul
    DivSigned
    And
    Or
    Xor
    ShiftLeft
    // Logical: zeros come in.
    ShiftRight
    // Sets the flags from `a - b`.
    Compare
    // Compares when the condition in `d` holds, else sets the flags to `c`.
    CompareIf
    // `a` is 1 when the condition `b` holds, else 0.
    SetIf
    // `a` is `b` when the condition `d` holds, else `c`.
    Select
    // The 4 KB page a symbol is on (with an Add of its offset in the page).
    AddressPage
    FloatMove
    FloatAdd
    FloatSub
    FloatMul
    FloatDiv
    FloatNeg
    FloatCompare
    // Calls the address in `a`.
    CallIndirect
    Return
}

// Whether an opcode's first operand is one it writes, as writer_at says for
// its arm64 mnemonic (the float ops other than fmov, csel and ccmp aren't).
func writes_first_op(anon op: Opcode) -> bool {
    match op {
        .Move -> return true
        .Add -> return true
        .Sub -> return true
        .Mul -> return true
        .DivSigned -> return true
        .And -> return true
        .Or -> return true
        .Xor -> return true
        .ShiftLeft -> return true
        .ShiftRight -> return true
        .AddressPage -> return true
        .SetIf -> return true
        .FloatMove -> return true
        else return false
    }
}

// Whether an opcode reads its first operand (codegen's first_operand_read).
func reads_first_op(anon op: Opcode) -> bool {
    return op is .Compare
}

// An `Op`, with its flags worked out once.
func op(anon op: Opcode, a: Reg = NO_REG, b: Reg = NO_REG, c: Reg = NO_REG, d: Reg = NO_REG) -> Insn {
    return .Op(:op, :a, :b, :c, :d, flags: op_flags(:op, :a, :b, :c, :d))
}

// The flags one operand of an `Op` adds.
func operand_flags(anon operand: Reg) -> int64 {
    if reg_clobbers(operand) {
        return INFO_CLOBBERS
    }
    if operand == FP {
        return INFO_FP
    }
    return 0
}

// insn_flags of an `Op`.
func op_flags(op: Opcode, a: Reg, b: Reg, c: Reg, d: Reg) -> int64 {
    mut flags: int64 = 0
    match op {
        .Move -> flags = MN_MOV << 8
        .SetIf -> flags = MN_CSET << 8
        .Add -> flags = MN_ADD << 8
        .Sub -> flags = MN_SUB << 8
        .CallIndirect -> flags = INFO_CLOBBERS
        else none
    }
    flags = flags | operand_flags(a) | operand_flags(b) | operand_flags(c) | operand_flags(d)
    // An immediate add or sub can't encode past 4095 (codegen's big_immediate_at).
    if (op is .Add or op is .Sub) and d == NO_REG and imm_value(c) > 4095 {
        flags = flags | INFO_BIG_IMM
    }
    return flags
}

// The vreg `reg` is (`v12` or `w12`), or -1 for any other operand.
func reg_vreg(anon reg: Reg) -> int64 {
    let tag = reg & 3
    if tag == 1 or tag == 2 {
        return reg >> 2
    }
    return -1
}

// Whether `reg` is one of x8–x15, which an instruction naming counts as a clobber.
func reg_clobbers(anon reg: Reg) -> bool {
    return (reg & 3) == 0 and reg >= 36 and reg <= 64
}

// insn_flags of an instruction that calls something or names a caller-saved register outright.
let INFO_CLOBBERS: int64 = 1
// insn_flags of a line that isn't an instruction.
let INFO_NO_MNEMONIC: int64 = 2
// insn_flags of an instruction that names `fp` as a register.
let INFO_FP: int64 = 4
// insn_flags of an `add`, `sub`, `ldr` or `str` whose immediate may be too big
// to encode (see codegen's big_immediate_at, which says for sure).
let INFO_BIG_IMM: int64 = 8
// insn_flags `>> 8`: what the mnemonic is, for the ones passes look for.
let MN_OTHER: int64 = 0
let MN_MOV: int64 = 1
let MN_LDR: int64 = 2
let MN_STR: int64 = 3
let MN_CSET: int64 = 4
let MN_ADD: int64 = 5
let MN_SUB: int64 = 6

// The mnemonic code of a line's flags.
func mnemonic_code(anon flags: int64) -> int64 {
    return flags >> 8
}

// Whether insn_flags(insn) has INFO_FP, without working out the rest.
func names_fp(anon insn: Insn) -> bool {
    match insn {
        .Slot(_store, _reg, _off) -> return true
        .Mov(dst, src) -> return dst == FP or src == FP
        .Mem(_load, _width, reg, base, at) -> return reg == FP or base == FP or at_reg(at) == FP
        .Op(_op, _a, _b, _c, _d, flags) -> return (flags & INFO_FP) != 0
        .Pair(_load, a, b, base, _mode) -> return a == FP or b == FP or base == FP
        .Intrinsic(label) -> return (intrinsic_flags(label) & INFO_FP) != 0
        else return false
    }
}

// What the passes need to know of an instruction at a glance: the INFO_ bits
// and, from bit 8, its mnemonic code.
func insn_flags(anon insn: Insn) -> int64 {
    match insn {
        .Slot(store, reg, _off) -> {
            mut flags = (MN_LDR << 8) | INFO_FP
            if store {
                flags = (MN_STR << 8) | INFO_FP
            }
            if reg_clobbers(reg) {
                flags = flags | INFO_CLOBBERS
            }
            return flags
        }
        .Mov(dst, src) -> {
            mut flags = MN_MOV << 8
            if reg_clobbers(dst) or reg_clobbers(src) {
                flags = flags | INFO_CLOBBERS
            }
            if dst == FP or src == FP {
                flags = flags | INFO_FP
            }
            return flags
        }
        .Mem(load, width, reg, base, at) -> {
            let index = at_reg(at)
            mut flags: int64 = 0
            // `ldr` and `str`: a 4- or 8-byte access.
            let word = width >= 4
            if word and load {
                flags = MN_LDR << 8
            } else if word {
                flags = MN_STR << 8
            }
            if reg_clobbers(reg) or reg_clobbers(base) or reg_clobbers(index) {
                flags = flags | INFO_CLOBBERS
            }
            if reg == FP or base == FP or index == FP {
                flags = flags | INFO_FP
            }
            // As codegen's big_immediate_at reads `[base, #off]`.
            if at is .Offset(off) and word and off > 32760 {
                flags = flags | INFO_BIG_IMM
            }
            return flags
        }
        .Op(_op, _a, _b, _c, _d, flags) -> return flags
        .LoadConst(dst, _value) -> {
            if reg_clobbers(dst) {
                return INFO_CLOBBERS
            }
            return 0
        }
        .Intrinsic(label) -> return intrinsic_flags(label)
        .Data(_text) -> return INFO_NO_MNEMONIC
        .Pair(_load, a, b, base, _mode) -> {
            // Only fixed registers: the frame link and the callee-saved ones.
            mut flags: int64 = 0
            if reg_clobbers(a) or reg_clobbers(b) {
                flags = INFO_CLOBBERS
            }
            if a == FP or b == FP or base == FP {
                flags = flags | INFO_FP
            }
            return flags
        }
        .Call(target) -> {
            // A panic never comes back, so whatever it clobbers isn't read after it.
            if never_returns(target) {
                return 0
            }
            return INFO_CLOBBERS
        }
        .Branch(_kind, reg, _target) -> {
            if reg_clobbers(reg) {
                return INFO_CLOBBERS
            }
            return 0
        }
        .Label(_name) -> return 0
    }
}


type PoolState = struct {
    free_regs: [Reg]
    cs_in_use: int64
    live: [str]
    // The frame slot each of `live` is saved in.
    slots: [int64] = []
}

type RegPool = struct {
    // Indexed by vreg id; entries accumulate across all functions
    // in a module so `subst_vregs` at flush-out time can resolve
    // any vreg consistently. NOT reset by `reset` — the ids are
    // program-global by design.
    vreg_phys: [Reg] = []

    // Per-function state — `reset` clears these at the start of
    // every compile_func.
    free_regs: [Reg] = []
    cs_in_use: int64 = 0
    cs_high_water: int64 = 0
    // The vregs handed out and not yet freed, for `evict`.
    live: [str] = []
    // Whether `evict` ran in this function, so `run` must leave it alone.
    evicted: bool = false
    // After a strict `run` that failed: the local vreg ids (from its
    // `vreg_start`), all at or after its `droppable`, that it put back in
    // memory to make room, and whether some vreg got no register even so.
    dropped: [int64] = []
    stuck: bool = false

    // Reset per-function state. `vreg_phys` is intentionally left
    // alone — its ids stay valid across the whole module.
    func reset(self) -> none {
        self.free_regs = full_pool()
        self.cs_in_use = 0
        self.cs_high_water = 0
        self.live = []
        self.evicted = false
    }

    // Hand every register back, for code too deep to compile with what is
    // left. The caller saves `live` to the frame around it, then calls
    // `restore`. Vregs now share physicals with ones that stay in use
    // after it, each pair apart only by that save, which `run` can't see.
    func evict(self) -> PoolState {
        let state = PoolState(free_regs: self.free_regs, cs_in_use: self.cs_in_use, live: self.live)
        self.free_regs = full_pool()
        self.cs_in_use = 0
        self.live = []
        self.evicted = true
        return state
    }

    func restore(self, anon state: PoolState) -> none {
        self.free_regs = state.free_regs
        self.cs_in_use = state.cs_in_use
        self.live = state.live
    }

    // Allocate a fresh virtual register backed by a physical from
    // the free pool. The returned string is a vreg name (`v<id>`)
    // that the emit layer threads into asm; `subst_vregs` later
    // resolves it to `vreg_phys[id]`. The initial alloc-time
    // assignment is just whatever phys was at the tail of the pool;
    // `run` may rewrite it (within the same class) once the body
    // is buffered.
    func alloc_reg(self) -> str {
        let n = len(self.free_regs)
        if n == 0 {
            panic("compiler bug: out of registers; `compile_expr` evicts before this can happen, so a site is holding too many without compiling an expression")
        }
        mut phys = self.free_regs[-1]
        self.free_regs = self.free_regs[0..n - 1]
        if is_callee_saved_phys(phys) {
            self.cs_in_use = self.cs_in_use + 1
            if self.cs_in_use > self.cs_high_water {
                self.cs_high_water = self.cs_in_use
            }
        }
        let id: int64 = len(self.vreg_phys)
        self.vreg_phys += [phys]
        let name = f"v{id}"
        self.live += [name]
        return name
    }

    // Return a register to the pool. Accepts either a vreg name
    // (from `alloc_reg`) or a physical name passed in directly by
    // sites that hardcode ABI registers (e.g. freeing `x0` after a
    // `bl`). For the hardcoded path, x0-x7 are skipped — they hold
    // call args/results and never enter the pool.
    func free_reg(self, anon reg: str) -> none {
        let r = reg_of(reg)
        mut phys: Reg = r
        if (r & 3) == 1 {
            phys = self.vreg_phys[r >> 2]
            // In place, keeping the order (evict saves them in it), then one copy.
            let n = len(self.live)
            mut kept = 0
            for i in 0..n {
                let name = self.live[i]
                if name != reg {
                    self.live[kept] = name
                    kept += 1
                }
            }
            if kept < n {
                self.live = self.live[0..kept]
            }
        }
        if arrays.contains(TARGET.arg_regs, phys) {
            return
        }
        if is_callee_saved_phys(phys) {
            self.cs_in_use = self.cs_in_use - 1
        }
        self.free_regs += [phys]
    }

    // Whether the next alloc_reg hands out a register that survives a call.
    func next_is_callee_saved(self) -> bool {
        return len(self.free_regs) > 0 and is_callee_saved_phys(self.free_regs[-1])
    }

    // True if `reg` is (or resolves to) a callee-saved physical.
    // Accepts vreg names too — the alloc-time class is the one
    // recorded in `vreg_phys[id]`.
    func is_callee_saved(self, anon reg: str) -> bool {
        let r = reg_of(reg)
        mut phys: Reg = r
        if (r & 3) == 1 {
            phys = self.vreg_phys[r >> 2]
        }
        return is_callee_saved_phys(phys)
    }
}

// Mnemonics whose first operand is the destination — for those a
// vreg at op-position 0 (outside brackets) is a def, not a use.
// Everything else treats all vreg operands as reads. ldp/stp don't
// appear with vregs in our codegen (only hardcoded sp/fp/lr/cs regs).
//
// Missing an entry here causes a silent miscompile: regalloc never
// sees the destination as a def, so the def_line stays -1 and the
// vreg keeps its alloc-time phys — but downstream vregs may end up
// sharing that phys because regalloc thinks the slot is free.
func is_callee_saved_phys(anon phys: Reg) -> bool {
    let k = phys >> 2
    return (phys & 3) == 0 and k < len(CALLEE_SAVED) and CALLEE_SAVED[k]
}

// Whether each of NAMES is in TARGET.callee_saved, up to the last that is: the
// test above runs for most registers the allocator touches.
mut CALLEE_SAVED: [bool] = callee_saved_set()

func callee_saved_set() -> [bool] {
    mut top: int64 = 0
    for reg in TARGET.callee_saved {
        if reg >> 2 > top {
            top = reg >> 2
        }
    }
    mut set: [bool] = [false] * (top + 1)
    for reg in TARGET.callee_saved {
        set[reg >> 2] = true
    }
    return set
}

// Dense callee-saved name by 0-based slot. `pack` writes back via
// these so the prologue can save `cs_reg(0)..cs_reg(N-1)` in order.
func cs_reg(anon n: int64) -> Reg {
    return TARGET.save_order[n]
}

// Scan one Raw line, mutating `def_line` / `last_use` for any vreg
// tokens it contains. A vreg token is `v<digits>` or `w<digits>` not
// touching a symbol character (see `is_sym_char`) and outside string
// quotes; the `w` form is the 32-bit alias used by the single
// byte-load site. A vreg in the first operand of a writer mnemonic
// (outside brackets) is a def; everything else is a use.
// Returns whether the line calls something (`bl`, `blr`, but not a panic) or names one of
// the caller-saved x8-x15 itself, so a value in one of those doesn't
// survive it; and records in `first` the line each vreg is first named on.
func never_returns(anon target: str) -> bool {
    return target == "_kod_index_oob" or target == "_kod_div_zero" or target == "_kod_panic"
}

// How many times each of the function's vregs (ids vreg_start up to
// vreg_start + n_local) is named in `body`, as a def or a use.
func count_operand(anon operand: Reg, mut counts: [int64], vreg_start: int64, n_local: int64) -> none {
    let id = reg_vreg(operand)
    if id >= vreg_start and id < vreg_start + n_local {
        counts[id - vreg_start] += 1
    }
}

func vreg_counts(anon body: [Insn], vreg_start: int64, n_local: int64) -> [int64] {
    mut counts: [int64] = [0] * n_local
    for insn in body {
        match insn {
            .Slot(_store, reg, _off) -> count_operand(reg, :counts, :vreg_start, :n_local)
            .LoadConst(dst, _value) -> {
                // Named on each of its lines, as its text has it.
                for _ in 0..LOAD_CONST_LINES {
                    count_operand(dst, :counts, :vreg_start, :n_local)
                }
            }
            .Mem(_load, _width, reg, base, at) -> {
                count_operand(reg, :counts, :vreg_start, :n_local)
                count_operand(base, :counts, :vreg_start, :n_local)
                count_operand(at_reg(at), :counts, :vreg_start, :n_local)
            }
            .Branch(_kind, reg, _target) -> count_operand(reg, :counts, :vreg_start, :n_local)
            .Op(_op, a, b, c, d, _flags) -> {
                count_operand(a, :counts, :vreg_start, :n_local)
                count_operand(b, :counts, :vreg_start, :n_local)
                count_operand(c, :counts, :vreg_start, :n_local)
                count_operand(d, :counts, :vreg_start, :n_local)
            }
            .Mov(dst, src) -> {
                count_operand(dst, :counts, :vreg_start, :n_local)
                count_operand(src, :counts, :vreg_start, :n_local)
            }
            else none
        }
    }
    return counts
}

// An `Op` operand's part in the liveness `run` works out: first named, defined
// (when `written`), last used.
func note_operand(anon operand: Reg, written: bool, line_idx: int64, vreg_start: int64, n_local: int64, mut def_line: [int64], mut last_use: [int64], mut first: [int64]) -> none {
    let id = reg_vreg(operand)
    if id < vreg_start or id >= vreg_start + n_local {
        return
    }
    let local_id = id - vreg_start
    if first[local_id] < 0 {
        first[local_id] = line_idx
    }
    if written and def_line[local_id] == -1 {
        def_line[local_id] = line_idx
    }
    last_use[local_id] = line_idx
}

// Constrained linear scan for one function's vregs. Vregs are
// partitioned by alloc-time class; each class's pool is the set of
// distinct alloc-time physicals from that class. Walk vregs in
// def_line order; expire intervals that ended before the current
// def; pop a free phys (preferring reuse). Mutates `pool.vreg_phys`
// in place over `[vreg_start, len(pool.vreg_phys))`.
//
// `strict` is for a body whose vregs aren't all expression temporaries (see
// codegen's promote_locals): a vreg live at the top of a loop is kept to the
// loop's backward branch, every register is in the pools, and running out of
// them is a failure (false) instead of a fall back to the alloc-time
// register, which only temporaries can share safely.
func run(body_buf: [Insn], pool: RegPool, vreg_start: int64, strict: bool = false, droppable: int64 = -1) -> bool {
    let vreg_phys: [Reg] = pool.vreg_phys
    let vreg_end: int64 = len(vreg_phys)
    let n_local: int64 = vreg_end - vreg_start
    if n_local <= 0 {
        return true
    }

    mut def_line: [int64] = [-1] * n_local
    mut last_use: [int64] = [-1] * n_local
    mut first: [int64] = [-1] * n_local

    // clobbers_before[k]: how many lines before line k call something or
    // name a caller-saved register outright.
    mut clobbers_before: [int64] = [0] * (len(body_buf) + 1)
    mut line_idx: int64 = 0
    for insn in body_buf {
        mut clobbers = 0
        match insn {
            .Slot(store, reg, _off) -> {
                if reg_clobbers(reg) {
                    clobbers = 1
                }
                let id = reg_vreg(reg)
                if id >= vreg_start and id < vreg_start + n_local {
                    let local_id = id - vreg_start
                    if first[local_id] < 0 {
                        first[local_id] = line_idx
                    }
                    // A load writes its register; a store reads it.
                    if not store and def_line[local_id] == -1 {
                        def_line[local_id] = line_idx
                    }
                    last_use[local_id] = line_idx
                }
            }
            .Mov(dst, src) -> {
                if reg_clobbers(dst) or reg_clobbers(src) {
                    clobbers = 1
                }
                // As in its text: `dst` is written, then `src` read, on this line.
                let d = reg_vreg(dst)
                if d >= vreg_start and d < vreg_start + n_local {
                    let local_id = d - vreg_start
                    if first[local_id] < 0 {
                        first[local_id] = line_idx
                    }
                    if def_line[local_id] == -1 {
                        def_line[local_id] = line_idx
                    }
                    last_use[local_id] = line_idx
                }
                let r = reg_vreg(src)
                if r >= vreg_start and r < vreg_start + n_local {
                    let local_id = r - vreg_start
                    if first[local_id] < 0 {
                        first[local_id] = line_idx
                    }
                    last_use[local_id] = line_idx
                }
            }
            .Data(_text) -> {
                // Not an instruction.
            }
            .Intrinsic(label) -> {
                // Only the argument registers: no vregs.
                if (intrinsic_flags(label) & INFO_CLOBBERS) != 0 {
                    clobbers = 1
                }
            }
            .LoadConst(dst, _value) -> {
                if reg_clobbers(dst) {
                    clobbers = 1
                }
                // The `mov` writes it; the `movk`s after it read and write it.
                note_operand(dst, written: true, :line_idx, :vreg_start, :n_local, :def_line, :last_use, :first)
            }
            .Pair(_load, a, b, _base, _mode) -> {
                // No vregs: the frame link and the callee-saved registers.
                if reg_clobbers(a) or reg_clobbers(b) {
                    clobbers = 1
                }
            }
            .Mem(load, width, reg, base, at) -> {
                let index = at_reg(at)
                if reg_clobbers(reg) or reg_clobbers(base) or reg_clobbers(index) {
                    clobbers = 1
                }
                // As in its text: `reg` (written by a load), then `base`, read.
                let r = reg_vreg(reg)
                if r >= vreg_start and r < vreg_start + n_local {
                    let local_id = r - vreg_start
                    if first[local_id] < 0 {
                        first[local_id] = line_idx
                    }
                    if mem_writes(:load, :width) and def_line[local_id] == -1 {
                        def_line[local_id] = line_idx
                    }
                    last_use[local_id] = line_idx
                }
                note_operand(base, written: false, :line_idx, :vreg_start, :n_local, :def_line, :last_use, :first)
                note_operand(index, written: false, :line_idx, :vreg_start, :n_local, :def_line, :last_use, :first)
            }
            .Op(op, a, b, c, d, flags) -> {
                if (flags & INFO_CLOBBERS) != 0 {
                    clobbers = 1
                }
                note_operand(a, written: writes_first_op(op), :line_idx, :vreg_start, :n_local, :def_line, :last_use, :first)
                note_operand(b, written: false, :line_idx, :vreg_start, :n_local, :def_line, :last_use, :first)
                note_operand(c, written: false, :line_idx, :vreg_start, :n_local, :def_line, :last_use, :first)
                note_operand(d, written: false, :line_idx, :vreg_start, :n_local, :def_line, :last_use, :first)
            }
            .Call(target) -> {
                if not never_returns(target) {
                    clobbers = 1
                }
            }
            .Branch(_kind, reg, _target) -> {
                if reg_clobbers(reg) {
                    clobbers = 1
                }
                let id = reg_vreg(reg)
                if id >= vreg_start and id < vreg_start + n_local {
                    let local_id = id - vreg_start
                    if first[local_id] < 0 {
                        first[local_id] = line_idx
                    }
                    last_use[local_id] = line_idx
                }
            }
            .Label(_name) -> {
                // Label lines hold a symbol, not asm — no vregs.
            }
        }
        clobbers_before[line_idx + 1] = clobbers_before[line_idx] + clobbers
        line_idx = line_idx + 1
    }

    if strict {
        // A vreg named before its first def (a loop reading what the
        // previous time round set) is live from there.
        for k in 0..n_local {
            if first[k] >= 0 and (def_line[k] < 0 or first[k] < def_line[k]) {
                def_line[k] = first[k]
            }
        }
        extend_over_loops(body_buf, :def_line, :last_use)
    }

    // Snapshot alloc-time phys per local vreg; this is also the
    // pool we draw from (deduped, partitioned by class).
    let alloc_phys: [Reg] = vreg_phys[vreg_start..vreg_end]

    mut free_callee: [Reg] = []
    mut free_caller: [Reg] = []
    for k in 0..n_local {
        let p: Reg = alloc_phys[k]
        if is_callee_saved_phys(p) {
            if not arrays.contains(free_callee, p) {
                free_callee += [p]
            }
        } else {
            if not arrays.contains(free_caller, p) {
                free_caller += [p]
            }
        }
    }
    // A callee-saved vreg that no call or named scratch register comes
    // between the def and the last use of can take any caller-saved one,
    // which the prologue needn't save.
    let target = TARGET
    for p in target.caller_saved {
        if not arrays.contains(free_caller, p) {
            free_caller = [p] + free_caller
        }
    }
    if strict {
        for p in target.callee_saved {
            if not arrays.contains(free_callee, p) {
                free_callee = [p] + free_callee
            }
        }
    }
    mut ok = true
    pool.dropped = []
    pool.stuck = false

    // Vreg indices by def_line ascending, equal ones in index order. A
    // counting sort: def_line is -1 or a line index.
    mut top: int64 = 0
    for line in def_line {
        if line > top {
            top = line
        }
    }
    mut next: [int64] = [0] * (top + 3)
    for line in def_line {
        next[line + 2] += 1
    }
    for b in 1..top + 3 {
        next[b] += next[b - 1]
    }
    mut order: [int64] = [0] * n_local
    for k in 0..n_local {
        let b = def_line[k] + 1
        order[next[b]] = k
        next[b] += 1
    }

    // Walk vregs in def order; maintain active list (alive intervals).
    mut active_id: [int64] = []
    mut active_use: [int64] = []
    mut active_phys: [Reg] = []
    mut new_phys: [Reg] = vreg_phys[vreg_start..vreg_end]

    for oi in 0..n_local {
        let local_id: int64 = order[oi]
        let d: int64 = def_line[local_id]
        if d == -1 {
            // Allocated but never defined in the emitted body — keep
            // its alloc-time phys (the safe default), unless it isn't
            // named at all, when it needn't count as a register to save.
            if last_use[local_id] == -1 {
                new_phys[local_id] = target.unused
            }
            continue
        }
        mut cls_callee: bool = is_callee_saved_phys(alloc_phys[local_id])
        let u: int64 = last_use[local_id]
        if cls_callee and u > d and clobbers_before[u] - clobbers_before[d + 1] == 0 {
            cls_callee = false
        }

        // Expire actives whose last_use <= this def line. The `<=`
        // (vs `<`) lets a `mov vDst, vSrc` whose vSrc dies at the mov
        // hand its phys to vDst on the spot — the mov substitutes to
        // `mov xN, xN` (self-mov) which `flush_out` drops. ARM64 reads
        // all sources before writing the dest, so sharing a phys
        // between dying-source and just-defined-dest on the same line
        // is well-defined for every mnemonic we emit.
        // Compacted in place, in order; copied only when one expired.
        let n_active = len(active_id)
        mut kept = 0
        for ai in 0..n_active {
            if active_use[ai] <= d {
                let ap: Reg = active_phys[ai]
                if is_callee_saved_phys(ap) {
                    free_callee += [ap]
                } else {
                    free_caller += [ap]
                }
            } else {
                active_id[kept] = active_id[ai]
                active_use[kept] = active_use[ai]
                active_phys[kept] = active_phys[ai]
                kept += 1
            }
        }
        if kept < n_active {
            active_id = active_id[0..kept]
            active_use = active_use[0..kept]
            active_phys = active_phys[0..kept]
        }

        // Pop a phys from the matching class's free pool.
        mut chosen: Reg = NO_REG
        if cls_callee {
            if len(free_callee) > 0 {
                chosen = free_callee[len(free_callee) - 1]
                free_callee = free_callee[0..len(free_callee) - 1]
            }
        } else {
            if len(free_caller) > 0 {
                chosen = free_caller[len(free_caller) - 1]
                free_caller = free_caller[0..len(free_caller) - 1]
            }
        }
        if chosen == NO_REG and strict and droppable >= 0 {
            // Out of registers: of this vreg and the ones holding a register
            // of its class, the droppable one used least (droppable vregs
            // are numbered most used first) goes back to memory, and the
            // scan goes on as if it had.
            ok = false
            mut victim = -1
            if local_id >= droppable {
                victim = local_id
            }
            mut victim_at = -1
            for ai, aid in active_id {
                if aid >= droppable and is_callee_saved_phys(active_phys[ai]) == cls_callee and aid > victim {
                    victim = aid
                    victim_at = ai
                }
            }
            if victim >= 0 {
                pool.dropped += [victim]
                if victim == local_id {
                    new_phys[local_id] = alloc_phys[local_id]
                    continue
                }
                chosen = active_phys[victim_at]
                active_id = active_id[0..victim_at] + active_id[victim_at + 1..len(active_id)]
                active_use = active_use[0..victim_at] + active_use[victim_at + 1..len(active_use)]
                active_phys = active_phys[0..victim_at] + active_phys[victim_at + 1..len(active_phys)]
            }
        }
        if chosen == NO_REG {
            // Without `strict` this can't happen: pool size equals
            // alloc-time pressure. Fall back to the alloc-time phys.
            ok = false
            if strict {
                pool.stuck = true
            }
            chosen = alloc_phys[local_id]
        }
        new_phys[local_id] = chosen
        active_id += [local_id]
        active_use += [last_use[local_id]]
        active_phys += [chosen]
    }

    // Write back.
    for k in 0..n_local {
        pool.vreg_phys[vreg_start + k] = new_phys[k]
    }
    return ok or not strict
}

// A vreg live at a loop's top label, set before the loop, stays live to
// the loop's backward branch, which takes its value round again: the
// textual interval alone would end at its last use inside the loop.
func extend_over_loops(anon body: [Insn], def_line: [int64], mut last_use: [int64]) -> none {
    let label_line = Map[str, int64]()
    for i, insn in body {
        if insn is .Label(name) {
            label_line.set(name, i)
        }
    }
    mut tops: [int64] = []
    mut bottoms: [int64] = []
    for i, insn in body {
        if insn is .Branch(_kind, _reg, branch_to) {
            if label_line.get(branch_to) is Some(t) {
                if t <= i {
                    tops += [t]
                    bottoms += [i]
                }
            }
        }
    }
    if len(tops) == 0 {
        return none
    }
    // By top, so one pass per vreg is enough: its end only grows, and a loop
    // it skipped for starting after its end starts after every later end too.
    let nl = len(tops)
    for a in 1..nl {
        mut b = a
        for b > 0 and tops[b - 1] > tops[b] {
            let t = tops[b]
            tops[b] = tops[b - 1]
            tops[b - 1] = t
            let bt = bottoms[b]
            bottoms[b] = bottoms[b - 1]
            bottoms[b - 1] = bt
            b -= 1
        }
    }
    for k in 0..len(def_line) {
        let d = def_line[k]
        if d < 0 {
            continue
        }
        mut u = last_use[k]
        // The first loop starting after `d`.
        mut lo = 0
        mut hi = nl
        for lo < hi {
            let mid = (lo + hi) / 2
            if tops[mid] <= d {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        for e in lo..nl {
            if tops[e] > u {
                break
            }
            if u < bottoms[e] {
                u = bottoms[e]
            }
        }
        last_use[k] = u
    }
}

// Pack the function's actually-used callee-saved registers into a
// dense `x19..x{19+N-1}` prefix and return `N` (the new
// callee-saved high-water mark).
//
// The prologue/epilogue saves the FIRST `N` callee-saved registers
// (cs_reg(0)=x19, cs_reg(1)=x20, …); regalloc can leave gaps in that
// sequence (e.g. use x19 and x21 but skip x20), and the alloc-time
// high-water mark over-saves to cover them. Packing makes the saved
// set match the used set exactly, dropping unnecessary stp/ldp pairs
// from the prologue.
//
// Safe because all reassignments stay inside the callee-saved class —
// every site that asked `is_callee_saved(vreg)` at emit time still
// gets the same answer, so spill_across decisions remain correct.
func pack(pool: RegPool, vreg_start: int64) -> int64 {
    let vreg_phys: [Reg] = pool.vreg_phys
    let vreg_end: int64 = len(vreg_phys)
    mut used: [Reg] = []
    for i in vreg_start..vreg_end {
        let p: Reg = vreg_phys[i]
        if is_callee_saved_phys(p) and not arrays.contains(used, p) {
            used += [p]
        }
    }
    for i in vreg_start..vreg_end {
        let p: Reg = vreg_phys[i]
        if is_callee_saved_phys(p) {
            mut j: int64 = 0
            mut found: int64 = -1
            for j < len(used) and found < 0 {
                if used[j] == p {
                    found = j
                }
                j = j + 1
            }
            if found >= 0 {
                pool.vreg_phys[i] = cs_reg(found)
            }
        }
    }
    return len(used)
}
