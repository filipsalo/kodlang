// The same for a generic enum written by its template's name, which the
// interpreter can't construct that way.
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}

func same_block(anon n: int64) -> Maybe[int64] {
    let Maybe = 0
    if n > 0 {
        return .Just(value: n + Maybe)
    }
    return Maybe.Nothing
}

func hiding(anon n: int64, anon Maybe: int64) -> Maybe[int64] {
    if n > 0 {
        let Maybe = 7
        if n > 5 {
            return Maybe.Just(value: n + Maybe)
        }
        return Maybe.Nothing
    }
    return Maybe.Nothing
}

func just(anon m: Maybe[int64], anon Maybe: int64) -> bool {
    if Maybe == 0 {
        let Maybe = 7
        return m is Maybe.Just
    }
    return false
}

func main() -> int64 {
    let Maybe = 4
    let x: Maybe[int64] = Maybe.Just(value: 5)
    print(f"{just(x, 0)} {just(same_block(1), 0)} {just(same_block(0), 0)}")
    print(f"{just(hiding(9, 0), 0)} {just(hiding(2, 0), 0)} {just(hiding(0, 0), 0)}")
    print_int(Maybe)
    return 0
}

// expected mode:
// run
// expected output:
// true true false
// true false false
// 4
