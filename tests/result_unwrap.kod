// `?` on a `T or Error`: `r? or default`, `r?.field` and `r?.method()`.

type Oops = struct {
    code: int64

    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

type User = struct {
    name: str
    nick: str?

    func greet(self, excited: bool = false) -> str {
        if excited {
            return f"hi {self.name}!"
        }
        return f"hi {self.name}"
    }

    func note(self) -> none {
        print(f"noted {self.name}")
    }
}

func half(anon n: int64) -> int64 or Error {
    if n % 2 != 0 {
        throw Oops(code: n)
    }
    return n / 2
}

func load(anon id: int64) -> User or Error {
    if id < 0 {
        throw Oops(code: id)
    }
    if id == 0 {
        return User(name: "root", nick: "r")
    }
    return User(name: f"user{id}", nick: none)
}

func maybe(anon n: int64) -> int64? or Error {
    if n < 0 {
        throw Oops(code: n)
    }
    if n == 0 {
        return none
    }
    return n
}

func count(anon xs: [int64]) -> int64 {
    mut total = 0
    for x in xs {
        total += half(x)? or 100
    }
    return total
}

func main() -> int64 {
    print(half(4)? or -1)
    print(half(3)? or -1)
    print(count([2, 3, 4]))

    print(load(1)?.name? or "?")
    print(load(-1)?.name? or "?")
    print(load(0)?.nick? or "-")
    print(load(5)?.nick? or "-")
    print(load(2)?.greet(excited: true)? or "nobody")
    print(load(-2)?.greet()? or "nobody")
    load(3)?.note()
    load(-3)?.note()

    print(maybe(7)? or 0)
    print(maybe(0)? or 0)
    print(maybe(-7)? or 0)

    let r: int64 or Error = 12
    let doubled = (r? or 0) * 2
    print(doubled)
    return 0
}

// expected output:
// 2
// -1
// 103
// user1
// ?
// r
// -
// hi user2!
// nobody
// noted user3
// 7
// 0
// 0
// 24
