// A Mach-O object file from the compiler's assembly, without `as` (docs/ir.md,
// step 9). It reads what the compiler writes: labels, the directives it uses,
// `.inst` words, and the instructions that name a label or a symbol (any
// other instruction goes through arm64.encode_text). A line it doesn't know
// is an error, not a guess.
//
// Labels named L… are temporary: they are not symbols in the object. A
// reference to one in data is relocated against its section; an `adrp` or a
// page offset names the symbol its atom starts with, plus an ARM64_RELOC_ADDEND
// for the distance, as `as` does; a branch to one in its own atom is resolved
// here.

import "unsafe"
import "kod/arm64"
import "kod/regalloc"
import "strbuilder" { StrBuilder }

extern func kod_f64_bits(anon x: float64) -> int64
extern func uname(anon buf: int64) -> int64
extern func getenv(anon name: int64) -> int64

type Section = shared struct {
    segment: str
    name: str
    flags: int64
    // log2 of the alignment: the largest `.p2align` in the section.
    align: int64 = 0
    bytes: [int64] = []
    addr: int64 = 0
    // The section's atoms: where each defined symbol not named L… starts,
    // and that symbol, in order.
    atom_offsets: [int64] = []
    atom_symbols: [int64] = []
    // Its relocation entries, two words each (address, info).
    relocs: [int64] = []
}

type Symbol = shared struct {
    name: str
    // -1 while undefined.
    section: int64 = -1
    offset: int64 = 0
    global: bool = false
    private_extern: bool = false
    weak: bool = false
    // Named by a relocation, so it is in the symbol table even if undefined.
    used: bool = false
    // Its number in the symbol table.
    index: int64 = -1
}

// A place a symbol's address goes, resolved once every label is known.
type Fixup = shared struct {
    section: int64
    offset: int64
    kind: int64
    symbol: int64
    addend: int64 = 0
}

let FIX_BRANCH26: int64 = 0
let FIX_BRANCH19: int64 = 1
let FIX_PAGE21: int64 = 2
let FIX_PAGEOFF12: int64 = 3
let FIX_GOT_PAGE21: int64 = 4
let FIX_GOT_PAGEOFF12: int64 = 5
let FIX_QUAD: int64 = 6

// ARM64 relocation types.
let RELOC_UNSIGNED: int64 = 0
let RELOC_BRANCH26: int64 = 2
let RELOC_PAGE21: int64 = 3
let RELOC_PAGEOFF12: int64 = 4
let RELOC_GOT_LOAD_PAGE21: int64 = 5
let RELOC_GOT_LOAD_PAGEOFF12: int64 = 6
let RELOC_ADDEND: int64 = 10

type MachoError = struct {
    message: str

    func to_str(self) -> str {
        return self.message
    }
}

type Assembler = shared struct {
    sections: [Section] = []
    current: int64 = -1
    symbols: [Symbol] = []
    by_name: Map[str, int64]
    fixups: [Fixup] = []
    subsections: bool = false
    error: str = ""
    line_no: int64 = 0
    // (section, offset, target section, target offset) of each quad relocated
    // against a section, whose address is known once sections are laid out.
    quad_targets: [int64] = []

    // The symbol named `name`, made if it is new.
    func symbol(self, anon name: str) -> int64 {
        if self.by_name.get(name) is Some(k) {
            return k
        }
        let k = len(self.symbols)
        self.symbols += [Symbol(:name)]
        self.by_name[name] = k
        return k
    }

    // Makes the section `segment,name` current, made if it is new.
    func switch_to(self, anon segment: str, name: str, flags: int64) -> none {
        for k, s in self.sections {
            if s.segment == segment and s.name == name {
                self.current = k
                return none
            }
        }
        self.sections += [Section(:segment, :name, :flags)]
        self.current = len(self.sections) - 1
    }

    func fail(self, anon message: str) -> none {
        if len(self.error) == 0 {
            self.error = f"line {self.line_no}: {message}"
        }
    }

    // The current section, or none before the first `.text`/`.section`.
    func here(self) -> Section? {
        if self.current < 0 {
            self.fail("an instruction or data before any section")
            return none
        }
        return self.sections[self.current]
    }

    func emit_word(self, anon word: int64) -> none {
        if self.here() is Some(s) {
            // A section of code says it has some once it does.
            if (s.flags & 0x80000000) != 0 {
                s.flags = s.flags | 0x400
            }
            s.bytes += [word & 0xff]
            s.bytes += [(word >> 8) & 0xff]
            s.bytes += [(word >> 16) & 0xff]
            s.bytes += [(word >> 24) & 0xff]
        }
    }

    func emit_bytes(self, anon value: int64, count: int64) -> none {
        if self.here() is Some(s) {
            for k in 0..count {
                s.bytes += [(value >> (8 * k)) & 0xff]
            }
        }
    }

    // An instruction word whose field `kind` fills in from `name`'s address.
    func emit_fixup(self, anon word: int64, kind: int64, name: str, addend: int64 = 0) -> none {
        if self.here() is Some(s) {
            self.fixups += [Fixup(section: self.current, offset: len(s.bytes), :kind, symbol: self.symbol(name), :addend)]
            self.emit_word(word)
        }
    }

    func define(self, anon name: str) -> none {
        if self.here() is Some(s) {
            let k = self.symbol(name)
            let sym = self.symbols[k]
            if sym.section >= 0 {
                self.fail(f"`{name}` is defined twice")
                return none
            }
            sym.section = self.current
            sym.offset = len(s.bytes)
            if not is_temporary(name) {
                s.atom_offsets += [sym.offset]
                s.atom_symbols += [k]
            }
        }
    }

    // An instruction from the compiler as it is, without its text: a label
    // defined, a word encoded, and anything else read as the line the output
    // would have had (branches, calls, data, directives).
    func insn(self, anon insn: regalloc.Insn, vreg_phys: [regalloc.Reg]) -> none {
        self.line_no += 1
        if insn is .Label(name) {
            self.define(name)
            return none
        }
        let word = arm64.insn_word(insn, :vreg_phys)
        if word >= 0 {
            self.emit_word(word)
            return none
        }
        match insn {
            .Call(target) -> {
                self.emit_fixup(0x94000000, kind: FIX_BRANCH26, name: target)
                return none
            }
            .Branch(kind, reg, target) -> {
                match kind {
                    .Always -> {
                        self.emit_fixup(0x14000000, kind: FIX_BRANCH26, name: target)
                        return none
                    }
                    .If(cond) -> {
                        self.emit_fixup(0x54000000 | arm64.cond_code(cond), kind: FIX_BRANCH19, name: target)
                        return none
                    }
                    else {
                        let t = arm64.zr_num(reg, :vreg_phys)
                        if t >= 0 and t < 31 and regalloc.reg_width(arm64.phys_reg(reg, :vreg_phys)) == 8 {
                            mut op = 0xB4000000
                            if kind is .IfNonzero {
                                op = 0xB5000000
                            }
                            self.emit_fixup(op | t, kind: FIX_BRANCH19, name: target)
                            return none
                        }
                    }
                }
            }
            .Data(text) -> {
                // Most data is line tables and symbol tables: `.quad` and
                // `.long` of a number or a label, read here without the
                // general line's slicing.
                if text.starts_with("\t.long ") or text.starts_with("\t.quad ") {
                    let arg = text[7..len(text)]
                    mut size = 4
                    if text[2] == 'q' {
                        size = 8
                    }
                    self.data_value(arg, :size)
                    return none
                }
                if not text.contains("\n") {
                    self.line(text.trim())
                    return none
                }
            }
            else none
        }
        let out = StrBuilder()
        arm64.write_insn(insn, :vreg_phys, :out)
        for text in out.to_str().split("\n") {
            self.line(text.trim())
        }
    }

    func line(self, anon line: str) -> none {
        mut text = line
        // A comment, whole or after the line (not in a string).
        if not text.starts_with(".asciz") {
            if text.find("//") is Some(at) {
                text = text[0..at].trim()
            }
        }
        if len(text) == 0 {
            return none
        }
        if text.ends_with(":") and text[0] != '.' {
            self.define(text[0..len(text) - 1])
            return none
        }
        if text[0] == '.' {
            self.directive(text)
            return none
        }
        self.instruction(text)
    }

    func directive(self, anon text: str) -> none {
        mut space = len(text)
        for k in 0..len(text) {
            if text[k] == ' ' {
                space = k
                break
            }
        }
        let name = text[0..space]
        let arg = text[space..len(text)].trim()
        match name {
            ".text" -> self.switch_to("__TEXT", name: "__text", flags: 0x80000000)
            ".data" -> self.switch_to("__DATA", name: "__data", flags: 0)
            ".section" -> {
                let parts = arg.split(",")
                if len(parts) < 2 {
                    self.fail(f"a section needs a segment and a name: {text}")
                    return none
                }
                mut flags = 0
                if len(parts) >= 3 {
                    match parts[2] {
                        "regular" -> flags = 0
                        "cstring_literals" -> flags = 2
                        else -> {
                            self.fail(f"unknown section type `{parts[2]}`")
                            return none
                        }
                    }
                }
                if len(parts) >= 4 {
                    for attr in parts[3].split("+") {
                        match attr {
                            "no_dead_strip" -> flags = flags | 0x10000000
                            "pure_instructions" -> flags = flags | 0x80000000
                            else -> {
                                self.fail(f"unknown section attribute `{attr}`")
                                return none
                            }
                        }
                    }
                }
                self.switch_to(parts[0], name: parts[1], :flags)
            }
            ".globl" -> {
                let sym = self.symbols[self.symbol(arg)]
                sym.global = true
            }
            ".private_extern" -> {
                let sym = self.symbols[self.symbol(arg)]
                sym.global = true
                sym.private_extern = true
            }
            ".weak_definition" -> {
                let sym = self.symbols[self.symbol(arg)]
                sym.weak = true
            }
            ".subsections_via_symbols" -> self.subsections = true
            ".p2align" -> {
                if arm64.number_text(arg) is Some(n) {
                    if self.here() is Some(s) {
                        if n > s.align {
                            s.align = n
                        }
                        let size = 1 << n
                        // Code is padded with `nop`s, data with zeros.
                        let code = (s.flags & 0x80000000) != 0 and size >= 4
                        for len(s.bytes) % size != 0 {
                            if code {
                                self.emit_word(0xD503201F)
                            } else {
                                s.bytes += [0]
                            }
                        }
                    }
                } else {
                    self.fail(f"bad alignment: {text}")
                }
            }
            ".inst" -> {
                if arm64.number_text(arg) is Some(word) {
                    self.emit_word(word)
                } else {
                    self.fail(f"bad word: {text}")
                }
            }
            ".quad" -> self.data_value(arg, size: 8)
            ".long" -> self.data_value(arg, size: 4)
            ".short" -> self.data_value(arg, size: 2)
            ".byte" -> self.data_value(arg, size: 1)
            ".double" -> {
                if arg.parse_float() is Some(x) {
                    self.emit_bytes(kod_f64_bits(x), count: 8)
                } else {
                    self.fail(f"bad double: {text}")
                }
            }
            ".asciz" -> self.asciz(arg)
            else -> self.fail(f"unknown directive `{name}`")
        }
    }

    // A number, or (for 8 bytes) a symbol's address plus an optional `+N`.
    func data_value(self, anon arg: str, size: int64) -> none {
        if arm64.number_text(arg) is Some(v) {
            self.emit_bytes(v, count: size)
            return none
        }
        if size != 8 {
            self.fail(f"only a .quad can hold an address: {arg}")
            return none
        }
        mut name = arg
        mut addend: int64 = 0
        mut plus: [str] = []
        if arg.contains("+") {
            plus = arg.split("+")
        }
        if len(plus) == 2 {
            name = plus[0].trim()
            if arm64.number_text(plus[1].trim()) is Some(n) {
                addend = n
            } else {
                self.fail(f"bad address: {arg}")
                return none
            }
        }
        if self.here() is Some(s) {
            self.fixups += [Fixup(section: self.current, offset: len(s.bytes), kind: FIX_QUAD, symbol: self.symbol(name), :addend)]
            self.emit_bytes(0, count: 8)
        }
    }

    // A quoted string and its NUL, with the escapes `as` reads.
    func asciz(self, anon arg: str) -> none {
        if len(arg) < 2 or arg[0] != '"' or arg[len(arg) - 1] != '"' {
            self.fail(f"bad string: {arg}")
            return none
        }
        if self.here() is Some(s) {
            let end = len(arg) - 1
            mut k = 1
            for k < end {
                let c = arg[k]
                if c != '\\' {
                    s.bytes += [c]
                    k += 1
                    continue
                }
                k += 1
                if k >= end {
                    self.fail("a string ends in `\\`")
                    return none
                }
                let e = arg[k]
                if e >= '0' and e <= '7' {
                    // Up to three octal digits.
                    mut v = 0
                    mut digits = 0
                    for k < end and digits < 3 and arg[k] >= '0' and arg[k] <= '7' {
                        v = v * 8 + arg[k] - '0'
                        k += 1
                        digits += 1
                    }
                    s.bytes += [v & 0xff]
                    continue
                }
                match e {
                    'n' -> s.bytes += [10]
                    't' -> s.bytes += [9]
                    'r' -> s.bytes += [13]
                    '\\' -> s.bytes += ['\\']
                    '"' -> s.bytes += ['"']
                    else -> {
                        self.fail(f"unknown escape `\\{arg[k..k + 1]}`")
                        return none
                    }
                }
                k += 1
            }
            s.bytes += [0]
        }
    }

    func instruction(self, anon text: str) -> none {
        mut space = len(text)
        for k in 0..len(text) {
            if text[k] == ' ' {
                space = k
                break
            }
        }
        let mn = text[0..space]
        let ops = arm64.operands(text[space..len(text)])
        if mn == "bl" and len(ops) == 1 {
            self.emit_fixup(0x94000000, kind: FIX_BRANCH26, name: ops[0])
            return none
        }
        if mn == "b" and len(ops) == 1 {
            self.emit_fixup(0x14000000, kind: FIX_BRANCH26, name: ops[0])
            return none
        }
        if mn.starts_with("b.") and len(ops) == 1 {
            if regalloc.cond_named(mn[2..len(mn)]) is Some(cond) {
                self.emit_fixup(0x54000000 | arm64.cond_code(cond), kind: FIX_BRANCH19, name: ops[0])
                return none
            }
        }
        if (mn == "cbz" or mn == "cbnz") and len(ops) == 2 {
            let t = arm64.gp_text(ops, 0)
            if t >= 0 {
                mut word = 0xB4000000
                if mn == "cbnz" {
                    word = 0xB5000000
                }
                self.emit_fixup(word | t, kind: FIX_BRANCH19, name: ops[1])
                return none
            }
        }
        if mn == "adrp" and len(ops) == 2 {
            let d = arm64.gp_text(ops, 0)
            if d >= 0 and d != 31 {
                if ops[1].ends_with("@GOTPAGE") {
                    self.emit_fixup(0x90000000 | d, kind: FIX_GOT_PAGE21, name: ops[1][0..len(ops[1]) - 8])
                    return none
                }
                if ops[1].ends_with("@PAGE") {
                    self.emit_fixup(0x90000000 | d, kind: FIX_PAGE21, name: ops[1][0..len(ops[1]) - 5])
                    return none
                }
            }
        }
        if mn == "add" and len(ops) == 3 and ops[2].ends_with("@PAGEOFF") {
            let d = arm64.gp_text(ops, 0)
            let n = arm64.gp_text(ops, 1)
            if d >= 0 and n >= 0 {
                self.emit_fixup(0x91000000 | n << 5 | d, kind: FIX_PAGEOFF12, name: ops[2][0..len(ops[2]) - 8])
                return none
            }
        }
        if (mn == "ldr" or mn == "str") and len(ops) == 2 and ops[1].ends_with("OFF]") {
            let t = arm64.gp_text(ops, 0)
            let parts = arm64.operands(arm64.addr_inner(ops[1]))
            if t >= 0 and len(parts) == 2 and ops[0][0] == 'x' {
                let n = arm64.gp_text(parts, 0)
                mut word = 0xF9000000 | n << 5 | t
                if mn == "ldr" {
                    word = word | 0x400000
                }
                if n >= 0 and parts[1].ends_with("@GOTPAGEOFF") and mn == "ldr" {
                    self.emit_fixup(word, kind: FIX_GOT_PAGEOFF12, name: parts[1][0..len(parts[1]) - 11])
                    return none
                }
                if n >= 0 and parts[1].ends_with("@PAGEOFF") {
                    self.emit_fixup(word, kind: FIX_PAGEOFF12, name: parts[1][0..len(parts[1]) - 8])
                    return none
                }
            }
        }
        let word = arm64.encode_text(text)
        if word < 0 {
            self.fail(f"an instruction this can't assemble: {text}")
            return none
        }
        self.emit_word(word)
    }

    // The atom `offset` of section `k` is in: the symbol it starts with, or
    // -1 before the first.
    func atom_at(self, anon k: int64, offset: int64) -> int64 {
        let s = self.sections[k]
        mut lo = 0
        mut hi = len(s.atom_offsets)
        // The last atom starting at or before `offset`.
        for lo < hi {
            let mid = (lo + hi) / 2
            if s.atom_offsets[mid] <= offset {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        if lo == 0 {
            return -1
        }
        return s.atom_symbols[lo - 1]
    }

    // A symbol at the start of section `k`, for references into the part
    // before its first atom (`as` calls these ltmpN too).
    func section_start(self, anon k: int64) -> int64 {
        let name = f"ltmp{k}"
        let sym = self.symbol(name)
        if self.symbols[sym].section < 0 {
            self.symbols[sym].section = k
            self.symbols[sym].offset = 0
            let s = self.sections[k]
            s.atom_offsets = [0] + s.atom_offsets
            s.atom_symbols = [sym] + s.atom_symbols
        }
        return sym
    }

    func reloc(self, anon section: int64, address: int64, symbolnum: int64, pcrel: bool, length: int64, extern_: bool, kind: int64) -> none {
        mut info = symbolnum & 0xffffff | length << 25 | kind << 28
        if pcrel {
            info = info | 1 << 24
        }
        if extern_ {
            info = info | 1 << 27
        }
        self.sections[section].relocs += [address, info]
    }

    // Writes `value` into the 4-byte word at `offset` of section `k`, or-ed in.
    // (Through the section: an array in a local would be a copy.)
    func patch_word(self, anon k: int64, offset: int64, value: int64) -> none {
        let s = self.sections[k]
        for b in 0..4 {
            s.bytes[offset + b] = s.bytes[offset + b] | ((value >> (8 * b)) & 0xff)
        }
    }

    func patch_quad(self, anon k: int64, offset: int64, value: int64) -> none {
        let s = self.sections[k]
        for b in 0..8 {
            s.bytes[offset + b] = (value >> (8 * b)) & 0xff
        }
    }

    // Resolves each fixup to a field or a relocation. Symbols named by
    // relocations are marked used; relocation entries name symbols by their
    // index here, renumbered when the table is laid out (`number_relocs`).
    func resolve(self) -> none {
        for f in self.fixups {
            let sym = self.symbols[f.symbol]
            let temporary = is_temporary(sym.name)
            if temporary and sym.section < 0 {
                self.fail(f"`{sym.name}` is never defined")
                return none
            }
            match f.kind {
                0 | 1 -> {
                    // A branch within its own atom (to a label, or a function
                    // calling itself) is resolved; any other is a BRANCH26
                    // relocation.
                    if sym.section == f.section and self.atom_at(f.section, offset: f.offset) == self.atom_at(sym.section, offset: sym.offset) {
                        let delta = (sym.offset - f.offset) / 4
                        if f.kind == FIX_BRANCH26 {
                            self.patch_word(f.section, offset: f.offset, value: delta & 0x3ffffff)
                        } else {
                            if delta < -262144 or delta > 262143 {
                                self.fail(f"`{sym.name}` is out of reach of a conditional branch")
                                return none
                            }
                            self.patch_word(f.section, offset: f.offset, value: (delta & 0x7ffff) << 5)
                        }
                    } else if f.kind == FIX_BRANCH26 and not temporary {
                        sym.used = true
                        self.reloc(f.section, address: f.offset, symbolnum: f.symbol, pcrel: true, length: 2, extern_: true, kind: RELOC_BRANCH26)
                    } else {
                        self.fail(f"a branch to `{sym.name}` in another atom")
                        return none
                    }
                }
                6 -> {
                    if temporary {
                        // Against the target's section: the field holds the address.
                        self.reloc(f.section, address: f.offset, symbolnum: sym.section + 1, pcrel: false, length: 3, extern_: false, kind: RELOC_UNSIGNED)
                        self.quad_targets += [f.section, f.offset, sym.section, sym.offset + f.addend]
                    } else {
                        sym.used = true
                        self.reloc(f.section, address: f.offset, symbolnum: f.symbol, pcrel: false, length: 3, extern_: true, kind: RELOC_UNSIGNED)
                        self.patch_quad(f.section, offset: f.offset, value: f.addend)
                    }
                }
                else -> {
                    mut target = f.symbol
                    mut addend = f.addend
                    if temporary {
                        if f.kind == FIX_GOT_PAGE21 or f.kind == FIX_GOT_PAGEOFF12 {
                            self.fail(f"a GOT reference to the temporary `{sym.name}`")
                            return none
                        }
                        target = self.atom_at(sym.section, offset: sym.offset)
                        if target < 0 {
                            target = self.section_start(sym.section)
                        }
                        addend = addend + sym.offset - self.symbols[target].offset
                    }
                    self.symbols[target].used = true
                    if addend != 0 {
                        self.reloc(f.section, address: f.offset, symbolnum: addend, pcrel: false, length: 2, extern_: false, kind: RELOC_ADDEND)
                    }
                    match f.kind {
                        2 -> self.reloc(f.section, address: f.offset, symbolnum: target, pcrel: true, length: 2, extern_: true, kind: RELOC_PAGE21)
                        3 -> self.reloc(f.section, address: f.offset, symbolnum: target, pcrel: false, length: 2, extern_: true, kind: RELOC_PAGEOFF12)
                        4 -> self.reloc(f.section, address: f.offset, symbolnum: target, pcrel: true, length: 2, extern_: true, kind: RELOC_GOT_LOAD_PAGE21)
                        else -> self.reloc(f.section, address: f.offset, symbolnum: target, pcrel: false, length: 2, extern_: true, kind: RELOC_GOT_LOAD_PAGEOFF12)
                    }
                }
            }
        }
    }

}

// Whether a label is temporary: named L…, so not a symbol of the object.
func is_temporary(anon name: str) -> bool {
    return len(name) > 0 and name[0] == 'L'
}

// The object file for `text`, the assembly the compiler wrote.
func assemble(anon text: str) -> bytes or Error {
    let a = new_assembler()
    mut start = 0
    let n = len(text)
    for start < n {
        mut end = start
        for end < n and text[end] != '\n' {
            end += 1
        }
        a.line_no += 1
        // The common line, `\t.inst 0x12345678 //...`, without slicing it.
        if end - start >= 17 and text[start] == '\t' and text[start + 1] == '.' and text[start + 2] == 'i' and text[start + 3] == 'n' and text[start + 6] == ' ' and text[start + 7] == '0' and text[start + 8] == 'x' {
            mut word = 0
            mut ok = true
            for k in start + 9..start + 17 {
                let c = text[k]
                if c >= '0' and c <= '9' {
                    word = word * 16 + c - '0'
                } else if c >= 'a' and c <= 'f' {
                    word = word * 16 + c - 'a' + 10
                } else {
                    ok = false
                }
            }
            if ok {
                a.emit_word(word)
                start = end + 1
                continue
            }
        }
        a.line(text[start..end].trim())
        if len(a.error) > 0 {
            throw MachoError(message: a.error)
        }
        start = end + 1
    }
    return finish(a)
}

// An assembler for `Assembler.insn` and `line` to fill.
func new_assembler() -> Assembler {
    return Assembler(by_name: Map[str, int64]())
}

// The object file of what `a` was given, once its labels are resolved.
func finish(anon a: Assembler) -> bytes or Error {
    if len(a.error) > 0 {
        throw MachoError(message: a.error)
    }
    a.resolve()
    if len(a.error) > 0 {
        throw MachoError(message: a.error)
    }
    return write_object(a)
}

// The minimum macOS version objects are built for: MACOSX_DEPLOYMENT_TARGET,
// or else this machine's, as clang chooses it (its Darwin version's major).
// Encoded as Mach-O does: major << 16 | minor << 8 | patch.
func min_os() -> int64 {
    let target = getenv(unsafe.c_str("MACOSX_DEPLOYMENT_TARGET"))
    if target != 0 {
        let text = unsafe.str_at(target)
        if len(text) > 0 {
            return version_number(text)
        }
    }
    let buf = unsafe.alloc(1280)
    mut version = 0
    if uname(buf) == 0 {
        let release = unsafe.str_at(buf + 512)
        version = version_number(release.split(".")[0])
    }
    unsafe.free(buf)
    return version
}

// `major[.minor[.patch]]` as major << 16 | minor << 8 | patch.
func version_number(anon text: str) -> int64 {
    let parts = text.split(".")
    mut v = 0
    for k in 0..3 {
        mut part = 0
        if k < len(parts) {
            if arm64.number_text(parts[k]) is Some(n) {
                part = n
            }
        }
        v = v << 8 | part
    }
    return v
}

// The object's bytes as they are written.
type Out = shared struct {
    bytes: [int64] = []

    func put32(self, anon v: int64) -> none {
        for b in 0..4 {
            self.bytes += [(v >> (8 * b)) & 0xff]
        }
    }

    func put64(self, anon v: int64) -> none {
        for b in 0..8 {
            self.bytes += [(v >> (8 * b)) & 0xff]
        }
    }

    func byte(self, anon v: int64) -> none {
        self.bytes += [v & 0xff]
    }

    // `name` in a fixed 16-byte field.
    func name(self, anon name: str) -> none {
        for k in 0..16 {
            if k < len(name) {
                self.bytes += [name[k]]
            } else {
                self.bytes += [0]
            }
        }
    }

    // Zeros up to `size` bytes in all.
    func pad_to(self, anon size: int64) -> none {
        for len(self.bytes) < size {
            self.bytes += [0]
        }
    }
}

func align_up(anon v: int64, anon to: int64) -> int64 {
    return (v + to - 1) / to * to
}

// Lays out the sections and the symbol table and writes the object.
func write_object(anon a: Assembler) -> bytes {
    let nsects = len(a.sections)
    // Section addresses, each aligned, one after another.
    mut addr = 0
    for s in a.sections {
        addr = align_up(addr, 1 << s.align)
        s.addr = addr
        addr += len(s.bytes)
    }
    let vmsize = addr
    // Quads relocated against a section hold the target's address.
    mut q = 0
    for q < len(a.quad_targets) {
        let k = a.quad_targets[q]
        let off = a.quad_targets[q + 1]
        let target = a.sections[a.quad_targets[q + 2]].addr + a.quad_targets[q + 3]
        a.patch_quad(k, offset: off, value: target)
        q += 4
    }
    // The symbol table: locals, then defined globals by name, then undefined
    // ones by name; L… labels are not in it.
    mut locals: [int64] = []
    mut defined: [int64] = []
    mut undefined: [int64] = []
    for k, sym in a.symbols {
        if is_temporary(sym.name) {
            continue
        }
        if sym.section < 0 {
            if sym.used or sym.global {
                undefined += [k]
            }
        } else if sym.global {
            defined += [k]
        } else {
            locals += [k]
        }
    }
    defined = sorted_by_name(defined, a.symbols)
    undefined = sorted_by_name(undefined, a.symbols)
    mut order: [int64] = []
    for k in locals {
        order += [k]
    }
    for k in defined {
        order += [k]
    }
    for k in undefined {
        order += [k]
    }
    for i, k in order {
        a.symbols[k].index = i
    }
    // The string table: an empty name first, then each name and its NUL.
    mut strtab: [int64] = [0]
    mut strx: [int64] = []
    for k in order {
        strx += [len(strtab)]
        let name = a.symbols[k].name
        for c in 0..len(name) {
            strtab += [name[c]]
        }
        strtab += [0]
    }
    for len(strtab) % 8 != 0 {
        strtab += [0]
    }
    // Load commands: the segment, the build version, the symbol tables.
    let segment_size = 72 + 80 * nsects
    let sizeofcmds = segment_size + 24 + 24 + 80
    let fileoff = 32 + sizeofcmds
    // Relocations follow the section data; the symbol table follows them.
    mut reloff = fileoff + vmsize
    reloff = align_up(reloff, 4)
    mut rel_at: [int64] = []
    mut next = reloff
    for s in a.sections {
        rel_at += [next]
        next += len(s.relocs) / 2 * 8
    }
    let symoff = align_up(next, 8)
    let nsyms = len(order)
    let stroff = symoff + nsyms * 16

    let out = Out()
    // mach_header_64
    out.put32(0xFEEDFACF)
    out.put32(0x0100000C)
    out.put32(0)
    out.put32(1)
    out.put32(4)
    out.put32(sizeofcmds)
    mut flags = 0
    if a.subsections {
        flags = 0x2000
    }
    out.put32(flags)
    out.put32(0)
    // LC_SEGMENT_64
    out.put32(0x19)
    out.put32(segment_size)
    out.name("")
    out.put64(0)
    out.put64(vmsize)
    out.put64(fileoff)
    out.put64(vmsize)
    out.put32(7)
    out.put32(7)
    out.put32(nsects)
    out.put32(0)
    for k, s in a.sections {
        out.name(s.name)
        out.name(s.segment)
        out.put64(s.addr)
        out.put64(len(s.bytes))
        out.put32(fileoff + s.addr)
        out.put32(s.align)
        let nreloc = len(s.relocs) / 2
        if nreloc > 0 {
            out.put32(rel_at[k])
        } else {
            out.put32(0)
        }
        out.put32(nreloc)
        out.put32(s.flags)
        out.put32(0)
        out.put32(0)
        out.put32(0)
    }
    // LC_BUILD_VERSION: macOS, no SDK version, no tools.
    out.put32(0x32)
    out.put32(24)
    out.put32(1)
    out.put32(min_os())
    out.put32(0)
    out.put32(0)
    // LC_SYMTAB
    out.put32(2)
    out.put32(24)
    out.put32(symoff)
    out.put32(nsyms)
    out.put32(stroff)
    out.put32(len(strtab))
    // LC_DYSYMTAB
    out.put32(0xB)
    out.put32(80)
    out.put32(0)
    out.put32(len(locals))
    out.put32(len(locals))
    out.put32(len(defined))
    out.put32(len(locals) + len(defined))
    out.put32(len(undefined))
    for _ in 0..12 {
        out.put32(0)
    }
    // Section data.
    for s in a.sections {
        out.pad_to(fileoff + s.addr)
        for b in s.bytes {
            out.byte(b)
        }
    }
    out.pad_to(reloff)
    // Relocations, their symbols renumbered.
    for s in a.sections {
        mut r = 0
        for r < len(s.relocs) {
            mut info = s.relocs[r + 1]
            let is_extern = (info >> 27) & 1
            if is_extern == 1 {
                let sym = info & 0xffffff
                info = info - sym | a.symbols[sym].index
            }
            out.put32(s.relocs[r])
            out.put32(info)
            r += 2
        }
    }
    out.pad_to(symoff)
    // nlist_64 entries.
    for i, k in order {
        let sym = a.symbols[k]
        out.put32(strx[i])
        if sym.section < 0 {
            // Undefined and external: no section, no description, no value.
            out.byte(1)
            out.byte(0)
            out.byte(0)
            out.byte(0)
            out.put64(0)
            continue
        }
        mut n_type = 0x0E
        if sym.global {
            n_type = n_type | 1
        }
        if sym.private_extern {
            n_type = n_type | 0x10
        }
        out.byte(n_type)
        out.byte(sym.section + 1)
        mut desc = 0
        if sym.weak {
            desc = 0x80
        }
        out.byte(desc)
        out.byte(desc >> 8)
        out.put64(a.sections[sym.section].addr + sym.offset)
    }
    for b in strtab {
        out.byte(b)
    }
    return kod_bytes_from_array(out.bytes)
}

// `ks` sorted by their symbols' names.
func sorted_by_name(anon ks: [int64], anon symbols: [Symbol]) -> [int64] {
    mut sorted: [int64] = []
    for k in ks {
        sorted += [k]
    }
    // Insertion sort is enough for the globals and undefined of one module.
    for i in 1..len(sorted) {
        mut j = i
        for j > 0 and symbols[sorted[j - 1]].name > symbols[sorted[j]].name {
            let t = sorted[j]
            sorted[j] = sorted[j - 1]
            sorted[j - 1] = t
            j -= 1
        }
    }
    return sorted
}
