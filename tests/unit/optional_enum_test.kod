// `T?` where T is an enum: the cell should reuse T's layout (disc 0 = none),
// not allocate a separate wrapper cell. Verifies behaviour via pattern
// matching; the layout optimisation itself is internal but the test
// exercises the same paths.
type Color = enum {
    Red
    Green
    Blue
}

func first_color(anon n: int64) -> Color? {
    if n == 0 { return .Red }
    if n == 1 { return .Green }
    return none
}

test "an optional enum holding a variant" {
    let a: Color? = first_color(0)
    assert a is not none
    match a {
        none -> fail("a match none")
        Some(c) -> {
            assert c is .Red
            assert c is not .Green
            assert c is not .Blue
        }
    }
}

test "an optional enum holding none" {
    let b: Color? = first_color(99)
    assert b is none
    match b {
        none -> {}
        Some(c) -> fail("b match some")
    }
}
