import "panics"
import "testing"

extern func rc_live_bytes() -> int64

type Box = shared struct {
    name: str
    items: [str] = []
}

type Point = struct {
    x: int64
    label: str
}

type Shape = enum {
    Named(name: str, at: Point)
    Empty
}

interface Greeter {
    func greet(self, anon who: str) -> str
}

type Loud = shared struct {
    word: str

    func greet(self, anon who: str) -> str {
        step()
        return f"{self.word} {who}"
    }
}

// Where `step` panics: at the step it counts down to.
mut _left: int64 = 0

func step() -> none {
    _left -= 1
    if _left == 0 {
        panic(f"step of {_left}")
    }
}

func text(anon s: str) -> str {
    step()
    return s + "!"
}

func fail_with(anon s: str) -> str or Error {
    step()
    throw panics.Panic(message: s + "?", backtrace: "")
}

func index(anon xs: [int64], anon i: int64) -> int64 {
    return xs[i]
}

func div(anon a: int64, anon b: int64) -> int64 {
    return a / b
}

func caught(anon body: func() -> none) -> str {
    if panics.run(body) is panics.Panic(p) {
        return p.message
    }
    return "none"
}

test "run gives the panic, or none" {
    assert caught(func() { print("") }) == "none"
    assert caught(func() { let _ = index([1, 2], 7) }) == "index 7 out of bounds for array of length 2"
    assert caught(func() { let _ = div(1, 0) }) == "integer division by zero"
    assert caught(func() { panic("on purpose") }) == "on purpose"
    assert caught(func() { mut m = Map[str, int64]()
        m["x"] += 1
    }) == "key not in map"
    assert caught(func() { let _ = must fail_with("bad") }) == "panic: bad?"
}

test "the backtrace goes down to the catch" {
    let p = panics.run(func() { let _ = index([1], 3) })
    let Some(it) = p else {
        fail("no panic")
        return
    }
    let lines = it.backtrace.split("\n")
    assert lines[0] == "backtrace:"
    assert lines[1].starts_with("  #0  index (stdlib/panics_test.kod:")
    assert lines[2].starts_with("  #1  __lambda_")
    // It ends where it was caught.
    assert lines[3] == ""
    assert len(lines) == 4
    assert it.to_str() == "panic: index 3 out of bounds for array of length 1"
}

test "a caught panic prints nothing" {
    let r = testing.run(func() {
        let _p = panics.run(func() { panic("quiet") })
        print("on")
    })
    assert r.status == 0
    assert r.stdout == "on\n"
    assert r.stderr == ""
}

test "after a catch, a panic ends the program again" {
    let r = testing.run(func() {
        let _p = panics.run(func() { panic("first") })
        panic("second")
    })
    assert r.status == 1
    assert r.stderr.starts_with("panic: second\nbacktrace:\n")
}

test "a child process isn't under its parent's catch" {
    mut status: int64 = 0
    mut went_on = false
    let p = panics.run(func() {
        let r = testing.run(func() { panic("in the child") })
        status = r.status
        went_on = true
    })
    assert p is none
    assert went_on
    assert status == 1
}

test "catch gives the value, the error or the panic" {
    let ok = panics.catch(func() -> int64 or Error { return 5 })
    assert must ok == 5
    let err = panics.catch(func() -> str or Error { return try fail_with("no") })
    if err is Err(e) {
        assert e.to_str() == "panic: no?"
    } else {
        fail("no error")
    }
    match panics.catch(func() -> int64 or Error { return index([], 0) }) {
        Err(panics.Panic(p)) -> assert p.message == "index 0 out of bounds for array of length 0"
        Ok(_v) -> fail("a value")
        Err(_e) -> fail("another error")
    }
}

test "the innermost catch takes the panic" {
    mut inner = ""
    let outer = caught(func() {
        inner = caught(func() { panic("in") })
        panic("out")
    })
    assert inner == "in"
    assert outer == "out"
}

test "again goes on with the same panic" {
    mut first: panics.Panic? = none
    let second = panics.run(func() {
        if panics.run(func() { panic("once") }) is panics.Panic(p) {
            first = p
            panics.again(p)
        }
    })
    let Some(a) = first else {
        fail("no panic")
        return
    }
    let Some(b) = second else {
        fail("no second panic")
        return
    }
    assert b.message == "once"
    assert b.backtrace == a.backtrace
    let r = testing.run(func() {
        if panics.run(func() { panic("once") }) is panics.Panic(p) {
            panics.again(p)
        }
    })
    assert r.status == 1
    assert r.stderr.starts_with("panic: once\nbacktrace:\n")
}

test "the caller's variables are as they were" {
    mut total: int64 = 0
    let before = "kept" + "!"
    for i in 0..50 {
        let a = i * 3
        let b = i * 5
        let name = f"n{i}"
        if i % 2 == 0 {
            assert caught(func() { deep(i, "x") }) == f"deep x"
        }
        total += a + b
        assert name == f"n{i}"
    }
    assert total == 8 * (49 * 50 / 2)
    assert before == "kept!"
}

func deep(anon n: int64, anon s: str) -> none {
    if n == 0 {
        panic("deep " + s)
    }
    deep(n - 1, s)
    print("not here")
}

func grow(anon n: int64, mut xs: [str]) -> none {
    for i in 0..n {
        xs += [f"item {i}"]
    }
    panic("grown")
}

func grow_twice(mut xs: [str]) -> none {
    grow(3, xs: mut xs)
}

type Table = shared struct {
    rows: Rows = Rows()
}

test "a mut parameter keeps what it was changed to" {
    let t = Table()
    t.rows.add(0)
    for n in 2..6 {
        assert caught(func() { t.rows.add(n) }) == "too many"
        assert len(t.rows.rows) == n
        assert t.rows.rows[n - 1] == f"row {n}"
    }
    mut xs = ["first" + "!"]
    assert caught(func() {
        mut ys = xs
        grow_twice(xs: mut ys)
    }) == "grown"
    assert xs == ["first!"]
    assert caught(func() { xs += [no_more(2)] }) == "no more"
    assert xs == ["first!"]
}

mut _tries: int64 = 0
mut _worked_out: str = work_out()

func work_out() -> str {
    _tries += 1
    if _tries < 3 {
        panic(f"try {_tries}")
    }
    return f"tried {_tries}"
}

test "a module variable whose initializer panicked is worked out again" {
    assert caught(func() { print(_worked_out) }) == "try 1"
    assert caught(func() { print(_worked_out) }) == "try 2"
    assert _worked_out == "tried 3"
}

type Tally = shared struct {
    counts: Map[str, [str]] = Map[str, [str]]()
}

func no_more(anon n: int64) -> str {
    if n > 1 {
        panic("no more")
    }
    return f"n{n}"
}

type Rows = struct {
    rows: [str] = []

    func add(mut self, anon n: int64) -> none {
        self.rows += [f"row {n}"]
        if n > 1 {
            panic("too many")
        }
    }
}

type Score = struct {
    points: [int64]

    func op_add(self, anon other: Score) -> Score {
        if len(other.points) > 1 {
            panic("too many points")
        }
        return Score(points: self.points + other.points)
    }
}

type Scores = shared struct {
    by_name: Map[str, Score] = Map[str, Score]()
}

test "a map keeps the entry a panic interrupted a change of" {
    let t = Tally()
    t.counts["a"] = ["x" + "1"]
    for _ in 0..3 {
        assert caught(func() { t.counts["a"][4] = "y" + "2" }) == "index 4 out of bounds for array of length 1"
        assert caught(func() { t.counts["a"] += [no_more(2)] }) == "no more"
    }
    assert must t.counts["a"] == ["x1"]
    t.counts["a"] += [no_more(1)]
    assert must t.counts["a"] == ["x1", "n1"]
    let s = Scores()
    s.by_name["k"] = Score(points: [1])
    assert caught(func() { s.by_name["k"] += Score(points: [2, 3]) }) == "too many points"
    s.by_name["k"] += Score(points: [4])
    assert (must s.by_name["k"]).points == [1, 4]
}

// Code of many shapes, each with a `step` where a panic may come.
func shapes() -> none {
    let a = text("a")
    mut xs = [text("b"), text("c"), a]
    xs += [text("d")]
    xs[1] = text("e") + text("f")
    let b = Box(name: text("g"), items: [text("h"), text("i")])
    b.items += [text("j"), f"{text("k")} and {text("l")}"]
    let p = Point(x: 1, label: text("m"))
    mut q = p
    q.label = text("n")
    let shape = Shape.Named(name: text("o"), at: Point(x: len(text("p")), label: text("q")))
    match shape {
        .Named(name, at) -> {
            let _s = text(name) + text(at.label)
        }
        .Empty -> step()
    }
    let g: Greeter = Loud(word: text("r"))
    let _h = g.greet(text("s"))
    let joined = len([text("t"), text("u")]) + len(text("v"))
    mut m = Map[str, [str]]()
    m[text("w")] = [text("x")]
    m[text("w"), default: []] += [text("y")]
    for k in m {
        let _v = (must m[k])[0] + text(k)
    }
    let add = func(anon s: str) -> str { return s + a + text("z") }
    let _c = add(text("1")) + add(text("2"))
    let opt: str? = text("3")
    if opt is str(o) {
        let _o = text(o)
    }
    let _d = opt? or text("4")
    let r = fail_with(text("5"))
    match r {
        Ok(v) -> print(v)
        Err(e) -> {
            let _t = text(e.to_str())
        }
    }
    for x in xs {
        for y in b.items {
            if len(text(x)) > 100 and len(text(y)) > 100 {
                print(joined)
            }
        }
    }
    mut rows = Rows()
    rows.rows = [text("6")]
    rows.add(0)
    let _last = cat(text("7"), b: text("8"), c: [text("9"), rows.rows[0]])
    let _pair = text(text(text("10")))
    let _cond = if_text(len(text("11")) > 1)
}

func if_text(anon on: bool) -> str {
    if on {
        return text("on") + text("!")
    }
    return text("off")
}

func cat(anon a: str, b: str, c: [str]) -> str {
    mut out = a + b
    for s in c {
        out += text(s)
    }
    return out
}

test "what the abandoned functions held is freed, wherever the panic comes" {
    // How many steps there are.
    _left = 1000000
    shapes()
    let steps = 1000000 - _left
    assert steps > 60
    // The first round makes what stays (module variables, the tables).
    for round in 0..2 {
        for n in 1..steps + 1 {
            let before = rc_live_bytes()
            let held = n
            assert caught(func() {
                _left = held
                shapes()
            }) == "step of 0"
            let after = rc_live_bytes()
            if round == 1 and after != before {
                fail(f"a panic at step {n} of {steps} leaves {after - before} bytes")
            }
        }
    }
}

func catch_ten(anon body: func() -> none) -> none {
    for _ in 0..10 {
        assert caught(body) != "none"
    }
}

test "each kind of panic is freed" {
    let bodies = [
        func() { let _ = index([1, 2], 7) },
        func() { let _ = must fail_with("bad" + "!") },
        func() { panic("built " + "here") },
        func() { assert len("a" + "b") == 3 },
        func() {
            let o: str? = none
            print(must o)
        },
        func() {
            mut m = Map[str, [str]]()
            m["a" + "b"] += ["c" + "d"]
        },
        func() {
            mut m = Map[str, [str]]()
            m["a" + "b"] = ["c" + "d"]
            m["a" + "b"][3] = "e" + "f"
        },
        func() {
            let _r = panics.catch(func() -> str or Error { return must fail_with("in" + "!") })
            panic("out")
        },
    ]
    _left = 1000000
    for k, body in bodies {
        catch_ten(body)
        let before = rc_live_bytes()
        catch_ten(body)
        let left = rc_live_bytes() - before
        if left != 0 {
            fail(f"ten of panic {k} leave {left} bytes")
        }
    }
}
