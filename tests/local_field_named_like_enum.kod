// `x.E.V` with a local `x` in force reads the field `E` of the local and its
// field `V`, even where an enum `E` is visible here and `x` is also the name
// of an import alias.
import "./geo_is" { Shape }

type Inner = struct {
    Circle: int64
}

type Holder = struct {
    Shape: Inner
}

func hiding_the_alias() -> int64 {
    let geo_is = Holder(Shape: Inner(Circle: 9))
    return geo_is.Shape.Circle
}

func plain_local() -> int64 {
    let h = Holder(Shape: Inner(Circle: 7))
    mut total = h.Shape.Circle
    if total > 0 {
        let h = Holder(Shape: Inner(Circle: 20))
        total += h.Shape.Circle
    }
    return total
}

func hidden_twice(anon geo_is: Holder) -> int64 {
    if geo_is.Shape.Circle > 0 {
        let geo_is = Holder(Shape: Inner(Circle: 100))
        return geo_is.Shape.Circle
    }
    return 0
}

func the_module_again() -> int64 {
    let circle = geo_is.Shape.Circle(r: 2)
    let dot = geo_is.Shape.Dot
    if circle is .Circle(r) {
        if dot is .Dot {
            return r
        }
    }
    return 0
}

func main() -> int64 {
    print_int(hiding_the_alias())
    print_int(plain_local())
    print_int(hidden_twice(Holder(Shape: Inner(Circle: 1))))
    print_int(the_module_again())
    return 0
}

// expected output:
// 9
// 27
// 100
// 2
