// `x?.field` on a field that is itself optional, and `x?.method()` returning an
// optional, give that optional back as it is (`T??` is `T?`), so a chain of
// them reads through every level.
type C = struct {
    n: int64?
    label: str?
    func get(self) -> int64? {
        return self.n
    }
    func name(self) -> str? {
        return self.label
    }
}

type B = struct {
    c: C?
}

type A = struct {
    b: B?
}

func main() -> int64 {
    let a: A? = A(b: B(c: C(n: 5, label: "five")))
    print(f"{a?.b?.c?.n? or -1}")
    print(f"{a?.b?.c?.label? or "-"}")
    print(f"{a?.b?.c?.get()? or -1}")
    print(f"{a?.b?.c?.name()? or "-"}")
    let gone: A? = none
    print(f"{gone?.b?.c?.n? or -1}")
    print(f"{gone?.b?.c?.name()? or "-"}")
    let empty: A? = A(b: B(c: C(n: none, label: none)))
    print(f"{empty?.b?.c?.n? or -1}")
    print(f"{empty?.b?.c?.name()? or "-"}")
    let no_c: A? = A(b: B(c: none))
    print(f"{(no_c?.b?.c?.n) is none}")
    return 0
}

// expected output:
// 5
// five
// 5
// five
// -1
// -
// -1
// -
// true
