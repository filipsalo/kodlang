// The default of `x? or default` is built as the unwrapped type: boxed into
// an interface, or a variant of the optional's own enum.
interface Shape {
    func area(self) -> int64
}

type Sq = shared struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}

type A = enum {
    Hit(n: int64)
    Miss
    Up
}

type B = enum {
    Miss
    Up
    Hit(n: int64)
}

func maybe_shape(anon k: int64) -> Shape? {
    if k > 0 {
        return Sq(s: k)
    }
    return none
}

func maybe_b(anon k: int64) -> B? {
    if k > 0 {
        return .Hit(n: k)
    }
    return none
}

func show(anon b: B) -> str {
    match b {
        .Miss -> return "miss"
        .Up -> return "up"
        .Hit(n) -> return f"hit {n}"
    }
}

test "default boxed into an interface" {
    assert (maybe_shape(0)? or Sq(s: 3)).area() == 9
    assert (maybe_shape(2)? or Sq(s: 3)).area() == 4
}

test "default variant of the optional's own enum" {
    assert show(maybe_b(0)? or .Up) == "up"
    assert show(maybe_b(0)? or .Hit(n: 4)) == "hit 4"
    assert show(maybe_b(7)? or .Miss) == "hit 7"
}

test "default for an int64" {
    let n: int64? = none
    let v = n? or 5
    assert v == 5
}
