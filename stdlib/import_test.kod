// Cross-module import behaviour. Migrated from tests/import.kod
// (entry) + tests/import_me.kod (dep). The whole shape — relative
// `./` import, module-prefixed call on the import, both files
// linked together — lives in one kod test now via the MemFs
// + build_and_run_files pipeline.

import "fs"
import "process"
import "kod/test_support"

test "relative `./` import resolves and module-prefixed call works" {
    let files: fs.MemFs = fs.mem_fs()
    files.add("main.kod", """
import "./helper"

func foo() -> none {
    print("foo in main.kod")
}

func main() -> int64 {
    foo()
    helper.foo()
    return 0
}
""")
    files.add("helper.kod", """
func foo() -> none {
    print("foo in helper.kod")
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status == 0
    assert r.stdout == "foo in main.kod\nfoo in helper.kod\n"
}

func private_lib() -> fs.MemFs {
    let files: fs.MemFs = fs.mem_fs()
    files.add("lib.kod", """
let _LIMIT: int64 = 3

type _Slot = struct {
    n: int64

    func doubled(self) -> int64 {
        return self.n * 2
    }
}

func _clamp(anon n: int64) -> int64 {
    if n > _LIMIT {
        return _LIMIT
    }
    return n
}

func slot(anon n: int64) -> _Slot {
    return _Slot(n: _clamp(n))
}
""")
    return files
}

test "a module uses its private names, and importers use what its public ones return" {
    let files = private_lib()
    files.add("main.kod", """
import "./lib"

func main() -> int64 {
    let s = lib.slot(5)
    print_int(s.n)
    print_int(s.doubled())
    return 0
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status == 0
    assert r.stdout == "3\n6\n"
}

test "another module's private names can't be reached through it" {
    let files = private_lib()
    files.add("main.kod", """
import "./lib"

func call() -> int64 {
    return lib._clamp(5)
}

func build() -> int64 {
    return lib._Slot(n: 1).n
}

func typed(anon s: lib._Slot) -> int64 {
    return 0
}

func limit() -> int64 {
    return lib._LIMIT
}

func main() -> int64 {
    return 0
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status != 0
    assert r.stderr.contains("main.kod:4:16: error: `_clamp` is private to module `lib`")
    assert r.stderr.contains("main.kod:8:16: error: `_Slot` is private to module `lib`")
    assert r.stderr.contains("main.kod:11:24: error: `_Slot` is private to module `lib`")
    assert r.stderr.contains("main.kod:16:16: error: `_LIMIT` is private to module `lib`")
}

test "an import can't list another module's private names" {
    let files = private_lib()
    files.add("main.kod", """
import "./lib" { slot, _clamp }

func main() -> int64 {
    return 0
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status != 0
    assert r.stderr.contains("main.kod:1:24: error: `_clamp` is private to module `lib`")
}

test "a did-you-mean never suggests another module's private name" {
    let files = private_lib()
    files.add("main.kod", """
import "./lib"

func main() -> int64 {
    return lib.clamp(5)
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status != 0
    assert r.stderr.contains("module `lib` has no function `clamp`")
    assert not r.stderr.contains("_clamp")
}

func calc_lib() -> fs.MemFs {
    let files: fs.MemFs = fs.mem_fs()
    files.add("calc.kod", """
let LIMIT: int64 = 10

type Pt = struct {
    x: int64
}

func double(anon n: int64) -> int64 {
    return n * 2
}
""")
    return files
}

test "a module's function is a value through its alias" {
    let files = calc_lib()
    files.add("main.kod", """
import "./calc"

func apply(anon f: func(int64) -> int64, anon n: int64) -> int64 {
    return f(n)
}

func main() -> int64 {
    let f = calc.double
    let g: func(int64) -> int64 = calc.double
    print_int(f(4) + g(1) + apply(calc.double, 5) + calc.LIMIT)
    return 0
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status == 0
    assert r.stdout == "30\n"
}

test "a value a module doesn't declare names the module" {
    let files = calc_lib()
    files.add("main.kod", """
import "./calc"

func a() -> int64 {
    return calc.LIMT
}

func b() -> int64 {
    let f = calc.nope
    return 0
}

func main() -> int64 {
    return 0
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status != 0
    assert r.stderr.contains("main.kod:4:17: error: module `calc` has no function or constant `LIMT`; did you mean `LIMIT`?")
    assert r.stderr.contains("main.kod:8:18: error: module `calc` has no function or constant `nope`")
}

test "an import can't list a name the module doesn't declare" {
    let files = calc_lib()
    files.add("main.kod", """
import "./calc" { Pt, dobule, LIMIT, Nope }

func main() -> int64 {
    return 0
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status != 0
    assert r.stderr.contains("main.kod:1:23: error: module `calc` has no function, constant or type `dobule`; did you mean `double`?")
    assert r.stderr.contains("main.kod:1:38: error: module `calc` has no function, constant or type `Nope`")
}

test "a module exports only what it declares, and says where an imported name comes from" {
    let files: fs.MemFs = fs.mem_fs()
    files.add("b.kod", """
type Thing = struct {
    n: int64
}

func make() -> Thing {
    return Thing(n: 1)
}
""")
    files.add("a.kod", """
import "./b" { Thing, make }

func wrap() -> Thing {
    return make()
}
""")
    files.add("main.kod", """
import "./a" { Thing, wrap }
import "./a"

func typed() -> int64 {
    let t: a.Thing = wrap()
    return t.n
}

func called() -> int64 {
    return a.make().n
}

func main() -> int64 {
    return 0
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status != 0
    assert r.stderr.contains("main.kod:1:16: error: `Thing` is imported by `a`, not declared there; import it from ")
    assert r.stderr.contains("main.kod:5:14: error: `Thing` is imported by `a`, not declared there; import it from ")
    assert r.stderr.contains("main.kod:10:14: error: `make` is imported by `a`, not declared there; import it from ")
    assert r.stderr.contains("b.kod")
}

test "a value of a type a module only imports can be used without naming it" {
    let files: fs.MemFs = fs.mem_fs()
    files.add("b.kod", """
type Thing = struct {
    n: int64
}
""")
    files.add("a.kod", """
import "./b" { Thing }

func wrap() -> Thing {
    return Thing(n: 7)
}
""")
    files.add("main.kod", """
import "./a" { wrap }

func main() -> int64 {
    let t = wrap()
    print_int(t.n)
    return 0
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status == 0
    assert r.stdout == "7\n"
}

test "a module name after an import that only lists names says why it is unknown" {
    let files: fs.MemFs = fs.mem_fs()
    files.add("a.kod", """
type Thing = struct {
    n: int64
}

func make() -> Thing {
    return Thing(n: 1)
}
""")
    files.add("main.kod", """
import "./a" { make }

func typed(anon t: a.Thing) -> int64 {
    return t.n
}

func main() -> int64 {
    return a.make().n
}
""")
    let r: process.ProcessResult = test_support.build_and_run_files(:files, entry: "main.kod")
    assert r.status != 0
    assert r.stderr.contains("main.kod:3:22: error: unknown type `a.Thing`; an import that lists names binds no `a`, so add a plain import of it to write `a.`")
    assert r.stderr.contains("main.kod:8:12: error: unknown name `a`; an import that lists names binds no `a`, so add a plain import of it to write `a.`")
}
