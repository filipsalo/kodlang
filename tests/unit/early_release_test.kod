// Locals holding arrays, maps and value structs are released after their
// last use; what they borrowed or shared must still be right.
type Pt = struct {
    xs: [int64] = []
}

type Box = shared struct {
    items: [str] = []
}

func first_or(anon xs: [int64]?, anon d: int64) -> int64 {
    let .Some(found) = xs else { return d }
    let n = len(found)
    return found[0] + n
}

func fill(mut xs: [int64]) -> none {
    let extra = [7, 8]
    xs += extra
}

test "an alias that's done with leaves the other holder alone" {
    let b = Box()
    b.items += ["a"]
    let saved = b.items
    assert len(saved) == 1
    b.items += ["b"]
    b.items += ["c"]
    assert b.items == ["a", "b", "c"]
}

test "a let-else binding keeps what it borrows from alive" {
    let maybe: [int64]? = [5, 6]
    assert first_or(maybe, -1) == 7
}

test "a captured local lives as long as the closure" {
    let base = [1, 2, 3]
    let total = func() -> int64 {
        mut s = 0
        for x in base {
            s += x
        }
        return s
    }
    assert total() == 6
}

test "a local used in a loop is alive for the whole loop" {
    let steps = [1, 2, 3, 4]
    mut acc = 0
    for i in 0..10 {
        if i >= len(steps) {
            break
        }
        let local = [steps[i]] * 2
        acc += local[0] + local[1]
    }
    assert acc == 20
}

test "match bindings borrow from the subject for the statement" {
    let opt: Pt? = Pt(xs: [9])
    match opt {
        Some(p) -> assert p.xs == [9]
        none -> fail("none")
    }
}

test "nested blocks and a value struct copied before its last use" {
    mut p = Pt(xs: [1])
    if true {
        let q = p
        p.xs += [2]
        assert q.xs == [1]
        assert p.xs == [1, 2]
    }
}

test "a mut parameter's local copy and a local of the callee" {
    mut ys = [0]
    fill(xs: mut ys)
    assert ys == [0, 7, 8]
}

test "a name bound again in its block" {
    // Only the newest binding goes early.
    let x = 3
    let x = [x, 4]
    let x = len(x) + 1
    let x = [x] * 2
    assert x == [3, 3]
}

test "maps" {
    mut m = Map[str, [int64]]()
    let row = [1]
    m.set("r", row)
    m.set("s", [2])
    assert len(m) == 2
    assert (m.get("r")? or []) == [1]
}
