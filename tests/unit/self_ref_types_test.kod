// Self-referential types: a struct holding an array of itself, a struct
// holding an optional of itself, and an enum holding an array of itself.
type Node = shared struct {
    kids: [Node]
    name: str
}

type Link = shared struct {
    next: Link?
    label: str
}

type Tree = enum {
    Leaf(n: int64)
    Branch(kids: [Tree])
}

func show_next(anon l: Link) -> str {
    match l.next {
        Some(x) -> return x.label
        none -> return "no next"
    }
}

test "struct with an array of itself" {
    let leaf = Node(kids: [], name: "leaf")
    let root = Node(kids: [leaf], name: "root")
    assert root.kids[0].name == "leaf"
    assert f"first kid: {root.kids[0].name}" == "first kid: leaf"
}

test "struct with an optional of itself" {
    let tail = Link(next: none, label: "tail")
    let head = Link(next: tail, label: "head")
    assert show_next(head) == "tail"
    assert show_next(tail) == "no next"
}

test "enum with an array of itself" {
    let t: Tree = Tree.Branch(kids: [Tree.Leaf(n: 7)])
    mut found = 0
    if t is .Branch(kids) {
        if kids[0] is .Leaf(n) {
            found = n
        }
    }
    assert found == 7
}
