// A Map's entries stay in the order their keys were first set; `remove` takes
// one out (a removed key that is set again goes last); `for k in m` and
// `for k, v in m` go over the entries the map had when the loop started.

func joined(anon m: Map[str, int64]) -> str {
    mut parts: [str] = []
    for k, v in m {
        parts += [f"{k}={v}"]
    }
    return " ".join(parts)
}

mut made: int64 = 0

func make() -> Map[str, int64] {
    made += 1
    let m = Map[str, int64]()
    m.set("x", 1)
    m.set("y", 2)
    return m
}

func main() -> int64 {
    let m = Map[str, int64]()
    m.set("a", 1)
    m.set("b", 2)
    m.set("c", 3)
    m.set("d", 4)
    print(joined(m))
    // remove gives the value, or none for a key that isn't there.
    print(f"{m.remove("b")? or -1} {m.remove("b")? or -1} {m.remove("zz")? or -1} {len(m)}")
    print(f"{m.contains("b")} {m.get("c")? or -1} {m["d"]? or -1}")
    print(joined(m))
    // Setting again keeps the place; set after removal goes last.
    m.set("a", 10)
    m.set("b", 20)
    print(joined(m))

    // keys() and values() are snapshots.
    let ks = m.keys()
    let vs = m.values()
    m.set("e", 5)
    print(f"{" ".join(ks)} {len(vs)} {vs[0]} {len(m)}")

    // The loop goes over the entries it started with.
    mut seen: [str] = []
    for k in m {
        seen += [k]
        m.remove(k)
        m.set(k + k, 0)
    }
    print(" ".join(seen))
    print(joined(m))

    // break and continue.
    mut picked: [str] = []
    for k, v in make() {
        if v == 1 {
            continue
        }
        picked += [k]
        break
    }
    print(f"{" ".join(picked)} made {made}")

    // Many removals: lookups and order still hold after compaction.
    let big = Map[int64, int64]()
    for i in 0..1000 {
        big.set(i, i * i)
    }
    for i in 0..1000 {
        if i % 10 != 0 {
            big.remove(i)
        }
    }
    mut sum: int64 = 0
    mut last: int64 = -1
    mut ordered = true
    for k, v in big {
        sum += v
        if k <= last {
            ordered = false
        }
        last = k
    }
    print(f"{len(big)} {sum} {ordered} {big.get(990)? or -1} {big.get(991)? or -1}")
    for i in 0..1000 {
        big.remove(i)
    }
    big.set(7, 49)
    print(f"{len(big)} {big.keys()[0]} {big.get(7)? or -1}")

    // Nested loops, and a map of arrays.
    let groups = Map[str, [int64]]()
    groups.set("odd", [1, 3])
    groups.set("even", [2, 4, 6])
    for name, xs in groups {
        mut total: int64 = 0
        for x in xs {
            total += x
        }
        for k in groups {
            if k == name {
                print(f"{name} {total}")
            }
        }
    }

    // Bytes of a str or a bytes value.
    mut spaces: int64 = 0
    for b in "a b c" {
        if b == ' ' {
            spaces += 1
        }
    }
    mut positions: [int64] = []
    for i, b in "héllo" {
        if b > 127 {
            positions += [i]
        }
    }
    mut total: int64 = 0
    for b in kod_bytes_from_array([1, 2, 250]) {
        total += b
    }
    mut empty_runs: int64 = 0
    for _b in "" {
        empty_runs += 1
    }
    for _k in Map[str, int64]() {
        empty_runs += 1
    }
    print(f"{spaces} {positions[0]} {positions[1]} {total} {empty_runs}")
    return 0
}

// expected output:
// a=1 b=2 c=3 d=4
// 2 -1 -1 3
// false 3 4
// a=1 c=3 d=4
// a=10 c=3 d=4 b=20
// a c d b 4 10 5
// a c d b e
// aa=0 cc=0 dd=0 bb=0 ee=0
// y made 1
// 100 32835000 true 980100 -1
// 1 7 49
// odd 4
// even 12
// 2 1 2 253 0
