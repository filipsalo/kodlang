type Celsius = struct {
    degrees: int64
    func to_str(self) -> str {
        return f"{self.degrees}C"
    }
}

type Oops = struct {
    code: int64
    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

func fails() -> int64 or Error {
    throw Oops(code: 7)
}

func show(anon s: Stringable) -> str {
    return f"<{s}>"
}

func main() -> int64 {
    let t: Stringable = Celsius(degrees: 21)
    print(f"{t}")
    print(str(t))
    print(show(Celsius(degrees: -3)))
    print(show(42))
    print(show(true))
    match fails() {
        Ok(n) -> print(f"{n}")
        Err(e) -> print(f"error: {e}")
    }
    return 0
}

// expected output:
// 21C
// 21C
// <-3C>
// <42>
// <true>
// error: oops 7
