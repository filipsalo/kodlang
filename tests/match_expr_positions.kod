// A match expression's bindings get a slot wherever the match is written:
// a `for … in` array, a `for` condition, a match statement's subject and
// an assignment target.
func pick(anon n: int64) -> int64? {
    if n > 0 {
        return n
    }
    return none
}

func main() -> int64 {
    for x in match pick(3) { .Some(a) -> [a, a + 1]  none -> [0] } {
        print_int(x)
    }
    mut i = 0
    for match pick(i) { .Some(b) -> b < 2  none -> true } {
        i += 1
    }
    print_int(i)
    match match pick(2) { .Some(c) -> c * 10  none -> 0 } {
        20 -> print("twenty")
        else -> print("other")
    }
    mut xs = [0, 0, 0]
    xs[match pick(1) { .Some(d) -> d  none -> 0 }] = 5
    xs[match pick(2) { .Some(e) -> e  none -> 0 }] += 7
    print(f"{xs[0]} {xs[1]} {xs[2]}")
    let o = pick(4)
    for v in [match o { .Some(v) -> v  none -> 0 }] {
        print_int(v)
    }
    return 0
}

// expected output:
// 3
// 4
// 2
// twenty
// 0 5 7
// 4
