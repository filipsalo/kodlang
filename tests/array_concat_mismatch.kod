// The operands of an array `+` that aren't literals or matches must have one type.
interface Shape {
    func area(self) -> int64
}
type Sq = struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
func take(anon xs: [Shape]) -> int64 {
    return len(xs)
}
func main() -> int64 {
    let nums: [int64] = [1]
    let names: [str] = ["a"]
    let sqs = [Sq(s: 6)]
    let shapes: [Shape] = [Sq(s: 2)]
    let a = nums + names
    let b = sqs + shapes
    let c = [Sq(s: 1)] + shapes + sqs
    let d = nums + 1
    let e: [Shape] = sqs + [Sq(s: 1)]
    mut f: [Shape] = []
    f += [Sq(s: 1)] + sqs
    print_int(take(shapes + [Sq(s: 3)] + sqs))
    return 0
}

// expected errors:
// 17:20: error: cannot concatenate `[int64]` and `[str]`
// 18:19: error: cannot concatenate `[Sq]` and `[Shape]`
// 19:35: error: cannot concatenate `[Shape]` and `[Sq]`
// 20:20: error: cannot concatenate `[int64]` and `int64`
// 21:22: error: expected `[Shape]`, got `[Sq]`
// 23:23: error: cannot concatenate `[Shape]` and `[Sq]`
// 24:42: error: cannot concatenate `[Shape]` and `[Sq]`
