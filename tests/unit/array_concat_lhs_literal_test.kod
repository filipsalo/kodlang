// An array literal on the left of `+` is built as the right operand's element type.
interface Shape {
    func area(self) -> int64
}

type Sq = shared struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}

type A = enum {
    Hit(n: int64)
    Miss
}

type B = enum {
    Miss
    Hit(n: int64)
}

type Maybe[T] = enum {
    Just(value: T)
    Nothing
}

func show_b(anon b: B) -> str {
    return match b {
        .Miss -> "miss"
        .Hit(n) -> f"hit {n}"
    }
}

func show_m(anon m: Maybe[str]) -> str {
    return match m {
        .Just(value) -> f"just {value}"
        .Nothing -> "nothing"
    }
}

test "a generic variant on the left takes the right operand's type" {
    let ms: [Maybe[str]] = [.Nothing]
    let ys = [.Just(value: "z")] + ms
    assert len(ys) == 2
    assert show_m(ys[0]) == "just z"
    assert show_m(ys[1]) == "nothing"
}

test "a variant on the left takes the right operand's enum" {
    let bs: [B] = [.Miss]
    let ds = [.Hit(n: 3)] + bs
    assert len(ds) == 2
    assert show_b(ds[0]) == "hit 3"
    assert show_b(ds[1]) == "miss"
}

test "a struct on the left is boxed as the right operand's interface" {
    let shapes: [Shape] = [Sq(s: 2)]
    let zs = [Sq(s: 3)] + shapes
    assert len(zs) == 2
    assert zs[0].area() == 9
    assert zs[1].area() == 4
    assert len([Sq(s: 5)] + shapes) == 2
}
