}

test "an arm calling a function that may return still needs a value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func maybe_die(anon k: int64) -> none {
            if k > 1 {
                return
            }
            kod_panic("small")
        }
        func log(anon msg: str) -> none {
            print(msg)
        }
        func main() -> int64 {
            let k = 1
            let x = match k {
                1 -> maybe_die(k)
                else -> 5
            }
            let y = match k {
                1 -> log("one")
                else -> 6
            }
            return x + y
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "this arm has no value, but the match is used as a value")
}

test "deciding whether methods that call each other return stays fast" {
    mut src = "type Walker = struct {\n    depth: int64 = 0\n"
    mut i = 0
    for i < 30 {
        src = src + "    func on" + str(i) + "(self) -> none {\n        self.depth += 1\n"
        for k in [1, 2, 3] {
            src = src + "        if self.depth < " + str(k) + " {\n            self.on" + str((i + k) % 30) + "()\n        }\n"
        }
        src = src + "        self.depth -= 1\n    }\n"
        i += 1
    }
    src = src + "}\nfunc main() -> int64 {\n    let w = Walker()\n    w.on0()\n    return w.depth\n}\n"
    let start = time.monotonic_ns()
    let errs: [codegen.Diagnostic] = test_support.try_compile(src)
    assert len(errs) == 0
    assert time.monotonic_ns() - start < 1000000000
}

test "deciding where deeply nested `for true` loops end stays fast" {
    mut head = ""
    mut tail = ""
    mut i = 0
    for i < 26 {
        head = head + "for true {\nif c {\n"
        tail = "}\nbreak\n}\n" + tail
        i += 1
    }
    let start = time.monotonic_ns()
    let errs: [codegen.Diagnostic] = test_support.try_compile("func f(anon c: bool) -> int64 {\n" + head + "return 1\n" + tail + "return 0\n}\nfunc main() -> int64 {\n    return f(true)\n}\n")
    assert len(errs) == 0
    assert time.monotonic_ns() - start < 1000000000
}

// Pairwise, so a long generated source isn't copied once per part.
func joined(anon parts: [str]) -> str {
    mut level = parts
    for len(level) > 1 {
        mut merged: [str] = []
        mut i = 0
        for i < len(level) {
            if i + 1 < len(level) {
                merged += [level[i] + level[i + 1]]
            } else {
                merged += [level[i]]
            }
            i += 2
        }
        level = merged
    }
    return level[0]
}

test "a helper that never returns doesn't make unrelated callers be decided again" {
    let n = 2000
    mut parts = ["func c() -> bool {\n    return false\n}\nfunc x() -> none {\n"]
    mut i = 0
    for i < n {
        parts += ["    if c() {\n        h" + str(i) + "()\n    }\n"]
        i += 1
    }
    parts += ["}\n"]
    i = 0
    for i < n {
        parts += ["func h" + str(i) + "() -> none {\n    if c() {\n        p0()\n    }\n    kod_panic(\"h\")\n}\n"]
        parts += ["func p" + str(i) + "() -> none {\n    if c() {\n        p" + str(i + 1) + "()\n    }\n    if c() {\n        x()\n    }\n}\n"]
        i += 1
    }
    parts += ["func p" + str(n) + "() -> none {\n}\nfunc q() -> int64 {\n    x()\n}\nfunc main() -> int64 {\n    return 0\n}\n"]
    let start = time.monotonic_ns()
    let errs: [codegen.Diagnostic] = test_support.try_compile(joined(parts))
    assert len(errs) == 1
    assert errs[0].message.contains("`q` can reach its end without returning a value")
    assert time.monotonic_ns() - start < 1000000000
}

// Callers take the high bits: an LCG's low bits repeat in short cycles.
func next_seed(anon seed: int64) -> int64 {
    return (seed * 1103515245 + 12345) % 2147483648
}

test "deciding a dense call graph with few panics stays fast" {
    let n = 450
    mut seed = 7
    mut parts = ["func c() -> bool {\n    return false\n}\n"]
    // Per statement of f`owner`: `if c() { f`then`() } else { f`other`() }`, -1 for no else, `then` -1 for a panic.
    mut owners: [int64] = []
    mut thens: [int64] = []
    mut others: [int64] = []
    mut i = 0
    for i < n {
        parts += ["func f" + str(i) + "() -> none {\n"]
        seed = next_seed(seed)
        mut k = seed / 65536 % 7
        for k > 0 {
            seed = next_seed(seed)
            let then = seed / 65536 % n
            seed = next_seed(seed)
            mut other = -1
            if seed / 65536 % 3 == 0 {
                seed = next_seed(seed)
                other = seed / 65536 % n
                parts += ["    if c() {\n        f" + str(then) + "()\n    } else {\n        f" + str(other) + "()\n    }\n"]
            } else {
                parts += ["    if c() {\n        f" + str(then) + "()\n    }\n"]
            }
            owners += [i]
            thens += [then]
            others += [other]
            k -= 1
        }
        seed = next_seed(seed)
        if seed / 65536 % 40 == 0 {
            parts += ["    kod_panic(\"x\")\n"]
            owners += [i]
            thens += [-1]
            others += [-1]
        }
        parts += ["}\nfunc q" + str(i) + "() -> int64 {\n    f" + str(i) + "()\n}\n"]
        i += 1
    }
    parts += ["func main() -> int64 {\n    return 0\n}\n"]
    mut never: [bool] = []
    i = 0
    for i < n {
        never += [false]
        i += 1
    }
    mut changed = true
    for changed {
        changed = false
        mut s = 0
        for s < len(owners) {
            if not never[owners[s]] {
                if thens[s] == -1 or (others[s] >= 0 and never[thens[s]] and never[others[s]]) {
                    never[owners[s]] = true
                    changed = true
                }
            }
            s += 1
        }
    }
    mut returning = 0
    for v in never {
        if not v {
            returning += 1
        }
    }
    let start = time.monotonic_ns()
    let errs: [codegen.Diagnostic] = test_support.try_compile(joined(parts))
    assert len(errs) == returning
    assert returning < n
    assert time.monotonic_ns() - start < 500000000
}

test "a method that never returns needs no value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Reader = struct {
            v: int64
            func fail(self, anon msg: str) -> none {
                kod_panic(msg)
            }
            func maybe_fail(self) -> none {
                if self.v > 0 {
                    return
                }
                kod_panic("small")
            }
            func get(self) -> int64 {
                return self.fail("bad")
            }
            func pick(self, anon o: int64?) -> int64 {
                let .Some(v) = o else { self.fail("none") }
                let x = match v {
                    1 -> self.fail("one")
                    else -> v
                }
                return x
            }
            func later(self) -> int64 {
                return self.maybe_fail()
            }
        }
        func main() -> int64 {
            let r = Reader(v: 1)
            return r.get() + r.pick(2) + r.later()
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "expected `int64`, got `none`")
}

test "no local can be named like an import alias" {
    let r: process.ProcessResult = test_support.compile_source("""
        import "./tests/alias_local_dep"
        func f(anon alias_local_dep: int64, n: int64?) -> int64 {
            let alias_local_dep = 1
            mut alias_local_dep = 2
            for alias_local_dep in [3] {
            }
            if n is Some(alias_local_dep) {
                return alias_local_dep
            }
            return 0
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert r.status != 0
    for at in ["2:13", "3:9", "4:9", "5:9", "7:18"] {
        assert r.stderr.contains(f".kod_compile_test.kod:{at}: error: `alias_local_dep` is the name of an import; give the local another name")
    }
}

