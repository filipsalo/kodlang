// An interface value converts to an interface with a subset of its methods.

// How many times `File.close` ran.
mut closes: int64 = 0

interface Reader {
    func read(self) -> int64
}

interface Named {
    func name(self) -> str
}

interface ReadCloser {
    func close(self) -> none
    func name(self) -> str
    func read(self) -> int64
}

type File = shared struct {
    n: int64

    func read(self) -> int64 {
        return self.n
    }

    func name(self) -> str {
        return f"file{self.n}"
    }

    func close(self) -> none {
        closes += 1
    }
}

type Other = shared struct {
    func read(self) -> int64 {
        return 100
    }

    func name(self) -> str {
        return "other"
    }

    func close(self) -> none {
    }
}

type Holder = shared struct {
    r: Reader
}

func drain(anon r: Reader) -> int64 {
    return r.read()
}

func narrow(anon rc: ReadCloser) -> Reader {
    return rc
}

func maybe(anon rc: ReadCloser) -> Reader? {
    return rc
}

test "an interface value converts to a narrower interface" {
    let rc: ReadCloser = File(n: 7)
    assert drain(rc) == 7
    let r: Reader = rc
    assert r.read() == 7
    let n: Named = rc
    assert n.name() == "file7"

    // The new value is still the same File.
    if r is File(f) {
        assert f.n == 7
    } else {
        fail("not a File")
    }
    if r is Other {
        fail("wrong")
    }
    match n {
        File(f) -> assert f.n + 1 == 8
        else -> fail("wrong")
    }

    let other: ReadCloser = Other()
    let o: Reader = other
    if o is File {
        fail("wrong")
    }
    assert o is Other

    assert narrow(rc).read() == 7
    let m = maybe(rc)
    assert (m? or narrow(other)).read() == 7
    let h = Holder(r: rc)
    assert h.r.read() == 7

    // A converted value converts again.
    let back: Reader = narrow(rc)
    assert back.read() == 7

    // The original is untouched.
    rc.close()
    assert closes == 1
}
