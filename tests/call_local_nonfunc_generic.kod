// The type of a local that is no function is written as a type argument
// list too, each name qualified when another module declares it: a generic
// instance, its type arguments, a `T or Error`.
import "./generic_names_pa"
import "./generic_names_pb"

type Oops = struct {
    code: int64

    func to_str(self) -> str {
        return "oops"
    }
}

func might(anon n: int64) -> int64 or Error {
    if n == 0 {
        throw Oops(code: 1)
    }
    return n
}

func main() -> int64 {
    let a = generic_names_pa.boxed()
    let b = generic_names_pb.boxed_pts()
    let c = generic_names_pb.boxed_boxed()
    let d = generic_names_pa.maybe_pt()
    let e = generic_names_pb.pts()
    let f = might(1)
    print_int(a(1) + b(1) + c(1) + d(1) + e(1) + f(1))
    return 0
}

// expected errors:
// 29:15: error: `a` is a local of type `generic_names_pa.Box[int64]`, not a function
// 29:22: error: `b` is a local of type `generic_names_pb.Box[[generic_names_pb.Pt]]`, not a function
// 29:29: error: `c` is a local of type `generic_names_pb.Box[generic_names_pb.Box[generic_names_pb.Pt]]`, not a function
// 29:36: error: `d` is a local of type `generic_names_pa.Maybe[generic_names_pa.Pt]`, not a function
// 29:43: error: `e` is a local of type `[generic_names_pb.Pt]`, not a function
// 29:50: error: `f` is a local of type `int64 or Error`, not a function
