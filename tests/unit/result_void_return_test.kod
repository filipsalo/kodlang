// A `none or Error` function that ends or returns without a value returns Ok(none).
type Oops = shared struct {
    n: int64
    func to_str(self) -> str { return f"oops {self.n}" }
}

mut trace: [str] = []

func step(anon k: int64) -> none or Error {
    if k > 1 {
        throw Oops(n: k)
    }
    trace += [f"step {k}"]
}

func early(anon k: int64) -> none or Error {
    if k == 0 {
        return
    }
    trace += [f"early {k}"]
}

func chain() -> none or Error {
    let a = try step(0)
    let b = try early(0)
    let c = try step(5)
    trace += ["unreachable"]
}

test "none or Error functions return Ok(none) and propagate throws" {
    assert step(0) is Ok
    if step(2) is Err(e) {
        assert e.to_str() == "oops 2"
    } else {
        fail("step(2) did not throw")
    }
    let d = must step(1)
    let f = must early(0)
    let g = must early(3)
    if chain() is Err(e2) {
        assert e2.to_str() == "oops 5"
    } else {
        fail("chain did not throw")
    }
    assert trace == ["step 0", "step 1", "early 3", "step 0"]
}
