// SHA-256, SHA-384 and SHA-512 (FIPS 180-4). See docs/crypto.md.
//
// The blocks go to the CPU's SHA-256 and SHA-512 instructions
// (`kod_sha256_block` and `kod_sha512_block`, arm64 intrinsics), a run of
// them at a time. SHA-256's state is kept as 32-bit words in int64s,
// SHA-512's as the int64s themselves.

import "unsafe"

// One 64-byte block at `block` into the state at `ctx`: eight 32-bit words
// and then the 64 round constants (arm64.kod's sha256_lines).
extern func kod_sha256_block(anon ctx: int64, anon block: int64) -> none
// One 128-byte block, the same way: eight 64-bit words, then the 80 round
// constants (sha512_lines).
extern func kod_sha512_block(anon ctx: int64, anon block: int64) -> none

type Algo = enum {
    Sha256
    Sha384
    Sha512

    // The digest's length in bytes.
    func size(self) -> int64 {
        return match self {
            .Sha256 -> 32
            .Sha384 -> 48
            .Sha512 -> 64
        }
    }

    // The length of the blocks it hashes, which HMAC pads its key to.
    func block_size(self) -> int64 {
        return match self {
            .Sha256 -> 64
            else -> 128
        }
    }
}

let MASK32: int64 = 0xffffffff

let K256: [int64] = [
    1116352408, 1899447441, 3049323471, 3921009573,
