// A generic enum variant is built as the instance it's passed, returned or stored as.
interface Shape {
    func area(self) -> int64
}
type Sq = shared struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}
type MaybeShape = Maybe[Shape]
func area_of(anon m: Maybe[Shape]) -> int64 {
    match m {
        .Just(value) -> return value.area()
        .Nothing -> return -1
    }
}
func make(anon n: int64) -> Maybe[Shape] {
    if n > 0 {
        return .Just(value: Sq(s: n))
    }
    return Maybe.Nothing
}
func try_make(anon n: int64) -> Maybe[Shape] or Error {
    if n > 1 {
        return .Just(value: Sq(s: n))
    }
    if n > 0 {
        return Maybe.Just(value: Sq(s: 1))
    }
    return .Nothing
}
func try_list() -> [Maybe[Shape]] or Error {
    return [.Just(value: Sq(s: 10)), .Nothing]
}
func opt(anon n: int64) -> MaybeShape? {
    if n > 0 {
        return Maybe.Just(value: Sq(s: n))
    }
    return none
}
test "arguments, returns and locals" {
    assert area_of(.Just(value: Sq(s: 3))) == 9
    assert area_of(Maybe.Just(value: Sq(s: 4))) == 16
    assert area_of(make(5)) == 25
    assert area_of(make(0)) == -1
    let m: Maybe[Shape] = .Just(value: Sq(s: 6))
    assert area_of(m) == 36
}

test "optionals" {
    let o: MaybeShape? = .Just(value: Sq(s: 7))
    assert area_of(must o) == 49
    assert area_of(must opt(8)) == 64
    assert opt(0) is none
    let sh: Shape? = Sq(s: 9)
    let shv: Shape = must sh
    assert shv.area() == 81
}

test "fallible returns" {
    assert area_of(must try_make(2)) == 4
    assert area_of(must try_make(1)) == 1
    assert area_of(must try_make(0)) == -1
    mut areas: [int64] = []
    for each in must try_list() {
        areas += [area_of(each)]
    }
    assert areas == [100, -1]
}
