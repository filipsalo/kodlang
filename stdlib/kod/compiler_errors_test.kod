    assert errs[0].col == 18
    assert errs[1].message == "error: expected `Color`, got `int64`"
    assert errs[2].message == "error: expected `Shape`, got `Color`"
    assert errs[3].message == "error: expected `int64?`, got `str`"
    assert errs[3].line == 18
}

