import "./cyclic_import_generic"

type Cell[T] = struct {
    item: T
}

type PtBox = cyclic_import_generic.Box[cyclic_import_generic.Pt]
type PtCell = Cell[cyclic_import_generic.Pt]

func boxed(anon p: cyclic_import_generic.Pt) -> cyclic_import_generic.Box[cyclic_import_generic.Pt] {
    return PtBox(v: p)
}

func unbox(anon b: cyclic_import_generic.Box[cyclic_import_generic.Pt]) -> cyclic_import_generic.Pt {
    return b.v
}

func hold(anon ps: [cyclic_import_generic.Pt]) -> [Cell[cyclic_import_generic.Pt]] {
    mut out: [Cell[cyclic_import_generic.Pt]] = []
    for p in ps {
        out += [PtCell(item: p)]
    }
    return out
}

func first(anon cells: [Cell[cyclic_import_generic.Pt]]) -> cyclic_import_generic.Pt {
    return cells[0].item
}

