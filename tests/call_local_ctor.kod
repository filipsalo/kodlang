// A call goes to a struct of its name before a local of that name, and a
// local that holds no function leaves the module's function to the call.
type Pt = struct {
    x: int64
}

func double(anon n: int64) -> int64 {
    return n * 2
}

func stale(anon c: bool) -> int64 {
    if c {
        let Pt = 3
        print_int(Pt)
    }
    let p = Pt(x: 7)
    return p.x
}

func live() -> int64 {
    let Pt = 4
    print_int(Pt)
    let p = Pt(x: 8)
    return p.x
}

func value_local() -> int64 {
    let double = 5
    return double(double)
}

func main() -> int64 {
    print_int(stale(true))
    print_int(live())
    print_int(value_local())
    return 0
}

// expected output:
// 3
// 7
// 4
// 8
// 10
