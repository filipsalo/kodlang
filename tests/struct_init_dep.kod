// A module that exports structs with custom constructors.

type BadPort = struct {
    number: int64

    func to_str(self) -> str {
        return f"bad port {self.number}"
    }
}

type Port = struct {
    number: int64

    func init(number: int64) -> Port or Error {
        if number < 1 or number > 65535 {
            throw BadPort(number: number)
        }
        return Port(number: number)
    }

    func next(self) -> Port {
        return Port(number: self.number + 1)
    }
}

type Temp = struct {
    degrees: int64

    func init(kelvin: int64 = 0, celsius: int64 = 0) -> Temp {
        return Temp(degrees: celsius + kelvin - 273)
    }
}
