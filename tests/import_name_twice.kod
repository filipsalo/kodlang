// A module can't both declare a name and list it in an import, and two
// imports can't list the same name, whether it names a type or a function.
// "./import_name_twice_pb" is loaded twice, which is fine. An import that
// lists names binds no alias, so line 8's other `import_name_twice_pa` is too.
import "./import_name_twice_pa" { Num, scale }
import "./import_name_twice_pb" { Num, scale, shift }
import "./import_name_twice_pb" { scale }
import "./import_name_twice_dup/import_name_twice_pa"

type Num = int64

func shift(anon x: int64) -> int64 {
    return x + 1
}

func main() -> int64 {
    return 0
}

// expected errors:
// 6:35: error: `Num` is already imported on line 5
// 6:40: error: `scale` is already imported on line 5
// 7:35: error: `scale` is already imported on line 5
// 10:6: error: `Num` is already imported on line 5
// 12:6: error: `shift` is already imported on line 6
