// Comparisons, `and`/`or` and `is` produce a bool.

func presence(anon o: int64?) -> str {
    let w = o is not none
    return f"{w} {o is none}"
}

test "comparisons, and/or and is produce a bool" {
    let u = 3 == 3
    let v = true and false
    assert f"{u} {v}" == "true false"
    assert f"{1 == 1} {2 < 1} {1 != 1} {2 >= 2}" == "true false false true"
    let c = 1 < 2 < 3
    let o = false or u
    assert f"{c} {o.to_str()}" == "true true"
    assert presence(5) == "true false"
    assert presence(none) == "false true"
}
