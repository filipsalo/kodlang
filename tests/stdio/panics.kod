// Prints a line without flushing, then panics: with the argument `index` by
// indexing past the end of an array, otherwise by calling `kod_panic`.
// tests/stdio_test.py checks that the line comes out before the panic message
// when both go to one pipe.
func main(argv: [str]) -> int64 {
    print("before the panic")
    if argv[1] == "index" {
        let xs: [int64] = [1]
        return xs[len(xs) + 4]
    }
    kod_panic("boom")
}

// expected mode:
// skip
