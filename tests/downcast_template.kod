// A downcast names a struct or a generic instance, not a generic type itself.
interface Shape {
    func area(self) -> int64
}

type Box[T] = struct {
    v: T

    func area(self) -> int64 {
        return 1
    }
}

type Pair[A, B] = struct {
    a: A
    b: B

    func area(self) -> int64 {
        return 2
    }
}

func main() -> int64 {
    let s: Shape = Box[int64](v: 1)
    let held = s is Box
    if s is Box {
        return 1
    }
    if s is Box(b) {
        return 2
    }
    match s {
        Pair(p) -> return 3
        else -> return 0
    }
}

// expected errors:
// 25:16: error: `Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = Box[int64]`
// 26:8: error: `Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = Box[int64]`
// 29:8: error: `Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = Box[int64]`
// 32:11: error: `Pair` is generic; downcast to one of its instances through a type alias such as `type IntPair = Pair[int64, int64]`
