// A local's name can't be used before its `let` or after the block, arm
// or loop that bound it, unless a function of that name is there instead.
type P = struct {
    x: int64
}

func before() -> int64 {
    let y = later + 1
    let later = 3
    return y + later
}

func after_block(anon n: int64) -> int64 {
    if n > 0 {
        let r = n * 2
        print_int(r)
    } else {
        let r = 0
        print_int(r)
    }
    return r
}

func after_arm(anon o: int64?) -> int64 {
    match o {
        Some(v) -> print_int(v)
        none -> print("none")
    }
    return v
}

func after_loop(anon xs: [P]) -> int64 {
    for p in xs {
        print_int(p.x)
    }
    return p.x
}

func assign_after(anon n: int64) -> int64 {
    if n > 0 {
        mut total = n
        total += 1
    }
    total = 5
    return 0
}

func main() -> int64 {
    print_int(before())
    print_int(after_block(1))
    print_int(after_arm(2))
    print_int(after_loop([P(x: 3)]))
    print_int(assign_after(4))
    return 0
}

// expected errors:
// 8:13: error: `later` is read before its `let`
// 21:12: error: `r` is declared in a block that has ended; declare it outside the block to use it here
// 29:12: error: `v` is declared in a block that has ended; declare it outside the block to use it here
// 36:12: error: `p` is declared in a block that has ended; declare it outside the block to use it here
// 44:5: error: `total` is declared in a block that has ended; declare it outside the block to use it here
