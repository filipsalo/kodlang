// Regression: flushing the buffered asm rewrote every `v<digits>` /
// `w<digits>` token to a physical register, including `.asciz` string
// data and mangled symbols, so `"GET /api/v1/users"` printed as
// `GET /api/x19/users` and a function named `v2` failed to link.

interface Versioned {
	func v4(self) -> str
}

type Header = struct {
	name: str
	value: str
	func v4(self) -> str {
		return f"{self.name}: {self.value}"
	}
}

func v2(anon x: int64) -> int64 {
	return x + 2
}

func show(anon h: Versioned) -> none {
	print(h.v4())
}

func main() -> int64 {
	print("GET /api/v1/users HTTP/1.1")
	print("Accept: v2, w3")
	let s = "v1"
	print(s)
	print("w0 x v9")
	let n = 7
	print(f"api/v1/items/{n} w3")
	print("quote \"v1\" and \\ w2")
	let m: Map[str, str] = Map[str, str]()
	m.set("version", "v1")
	match m.get("version") {
		Some(v) -> print(v)
		none -> print("missing")
	}
	show(Header(name: "X-Version", value: "v3"))
	print(v2(40).to_str())
	return 0
}

// expected output:
// GET /api/v1/users HTTP/1.1
// Accept: v2, w3
// v1
// w0 x v9
// api/v1/items/7 w3
// quote "v1" and \ w2
// v1
// X-Version: v3
// 42
// expected status:
// 0
