// A weak field refers to a struct without keeping it alive.

type Node = struct {
    name: str
    children: [Node] = []
    weak parent: Node?
}

type Watch = struct {
    weak target: Node? = none
    weak other: Node?
}

func parent_name(anon n: Node) -> str {
    if n.parent is Node(p) {
        return p.name
    }
    return "none"
}

// The root goes when this returns: only the leaf's weak field refers to it.
func orphan() -> Node {
    let root = Node(name: "root" + "!")
    let leaf = Node(name: "leaf", parent: root)
    root.children += [leaf]
    print(parent_name(leaf))
    return leaf
}

func main() -> int64 {
    let leaf = orphan()
    print(parent_name(leaf))

    let a = Node(name: "a")
    let b = Node(name: "b")
    let w = Watch(target: a, other: a)
    print(w.target?.name? or "gone")
    w.target = b
    print(w.target?.name? or "gone")
    print(w.other?.name? or "gone")
    w.target = none
    print(w.target?.name? or "gone")

    // Many weak fields, one struct.
    mut kids: [Node] = []
    for i in 0..3 {
        kids += [Node(name: f"kid{i}", parent: a)]
    }
    for k in kids {
        print(f"{k.name} of {parent_name(k)}")
    }

    // A value read from a weak field keeps the struct alive while it is used.
    let held = Watch()
    hold_while_replaced(held)
    print(held.target?.name? or "gone")
    return 0
}

// The binding `t` keeps the struct alive until this returns (a local lasts
// until its function returns), though `keep` lets go of it first.
func hold_while_replaced(anon held: Watch) -> none {
    mut keep = Node(name: "keep" + "!")
    held.target = keep
    if held.target is Node(t) {
        keep = Node(name: "other")
        print(t.name)
    }
}

// expected output:
// root!
// none
// a
// b
// a
// gone
// kid0 of a
// kid1 of a
// kid2 of a
// keep!
// gone
// expected status:
// 0
