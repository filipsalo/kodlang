// A value boxed in a module that imports this one back still matches its
// struct with `is`.
import "./../downcast_cyclic_dep"

interface Named {
    func name(self) -> str
}

type Pt = shared struct {
    x: int64

    func name(self) -> str {
        return f"pt{self.x}"
    }
}

type Oops = shared struct {
    code: int64

    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

test "a value boxed across the cycle matches its struct" {
    let m: Named = downcast_cyclic_dep.boxed()
    if m is Pt(p) {
        assert p.x == 42
    } else {
        fail("not pt")
    }
    match downcast_cyclic_dep.fail(1) {
        Ok(_v) -> fail("ok")
        Err(e) -> {
            if e is Oops(o) {
                assert o.code == 11
            } else {
                fail(e.to_str())
            }
        }
    }
}
