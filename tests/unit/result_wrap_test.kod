// A `T` goes where a `T or Error` is declared as its `Ok`, in every typed position.

type Oops = shared struct {
    code: int64

    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

type Status = enum {
    Fine
    Failed(code: int64)
}

type Halved = int64 or Error

type Holder = shared struct {
    r: int64 or Error
}

func half(anon n: int64) -> int64 or Error {
    if n % 2 != 0 {
        throw Oops(code: n)
    }
    return n / 2
}

func show(anon r: int64 or Error) -> str {
    match r {
        Ok(v) -> return f"ok {v}"
        Err(e) -> return f"err {e.to_str()}"
    }
}

func show_status(anon r: Status or Error) -> str {
    match r {
        Ok(.Fine) -> return "fine"
        Ok(.Failed(code)) -> return f"failed {code}"
        Err(e) -> return e.to_str()
    }
}

func show_nested(anon r: Halved or Error) -> str {
    match r {
        Ok(inner) -> return f"outer ok, {show(inner)}"
        Err(e) -> return f"outer err {e.to_str()}"
    }
}

func pick(anon n: int64) -> Halved or Error {
    if n < 0 {
        throw Oops(code: 0)
    }
    if n == 0 {
        return half(1)
    }
    return n
}

func first[T](anon xs: [T]) -> T or Error {
    if len(xs) == 0 {
        throw Oops(code: -1)
    }
    return xs[0]
}

test "locals, assignments and arguments" {
    let r: int64 or Error = 3
    assert show(r) == "ok 3"
    mut m: int64 or Error = half(3)
    assert show(m) == "err oops 3"
    m = 8
    assert show(m) == "ok 8"
    assert show(5) == "ok 5"
    assert show(half(4)) == "ok 2"
}

test "array elements and fields" {
    let rs: [int64 or Error] = [1, half(5), 6]
    mut got: [str] = []
    for x in rs {
        got += [show(x)]
    }
    assert got == ["ok 1", "err oops 5", "ok 6"]

    let h = Holder(r: 7)
    assert show(h.r) == "ok 7"
    h.r = half(9)
    assert show(h.r) == "err oops 9"
}

test "enum values and nested results" {
    let s: Status or Error = .Failed(code: 2)
    assert show_status(s) == "failed 2"
    assert show_status(.Fine) == "fine"

    let n: Halved or Error = 4
    assert show_nested(n) == "outer ok, ok 4"
    assert show_nested(pick(3)) == "outer ok, ok 3"
    assert show_nested(pick(0)) == "outer ok, err oops 1"
    assert show_nested(pick(-1)) == "outer err oops 0"
}

test "optionals, match arms and Error or Error" {
    let o: int64? or Error = none
    if o is Ok(v) {
        assert v is none
    } else {
        fail("not Ok")
    }

    let rs: [int64 or Error] = [1, half(5), 6]
    let picked: int64 or Error = match len(rs) {
        3 -> 30
        else -> half(1)
    }
    assert show(picked) == "ok 30"

    let errs: [Error] = [Oops(code: 11)]
    let found: Error or Error = first(errs)
    match found {
        Ok(e) -> assert e.to_str() == "oops 11"
        Err(e) -> fail(f"none: {e.to_str()}")
    }
    let empty: [Error] = []
    match first(empty) {
        Ok(e) -> fail(f"found {e.to_str()}")
        Err(e) -> assert e.to_str() == "oops -1"
    }
    let as_ok: Error or Error = Oops(code: 12)
    assert as_ok is Ok(_)

    let made: int64 or Error = .Ok(value: 13)
    assert show(made) == "ok 13"
}
