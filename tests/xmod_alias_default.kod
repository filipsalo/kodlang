import "./xmod_alias_default_dep"
import "./xmod_alias_other"

func main() -> int64 {
    print(f"alias call: {xmod_alias_default_dep.f()}")
    print(f"alias variant: {xmod_alias_default_dep.level()}")
    print(f"alias unit variant: {xmod_alias_default_dep.low()}")
    print(f"alias constructor: {xmod_alias_default_dep.Cfg().p.a}")
    print(f"own import: {xmod_alias_other.seed()}")
    return 0
}

