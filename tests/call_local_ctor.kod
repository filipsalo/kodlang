// A local that holds no function leaves the module's function to the call.
func double(anon n: int64) -> int64 {
    return n * 2
}

func value_local() -> int64 {
    let double = 5
    return double(double)
}

func main() -> int64 {
    print_int(value_local())
    return 0
}

// expected output:
// 10
