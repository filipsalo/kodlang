// An indexed or sliced value is computed before its index and bounds, and
// a comparison chain computes its operands left to right, each once, and
// stops at the first comparison that is false.

type Log = shared struct {
    text: str = ""
    n: int64 = 0

    func at(self, anon s: str, anon v: int64) -> int64 {
        self.text = self.text + s
        return v
    }

    func word(self, anon s: str) -> str {
        self.text = self.text + s
        return s
    }

    func ages(self) -> Map[str, int64] {
        self.text = self.text + "m"
        mut m = Map[str, int64]()
        m["k"] = 7
        return m
    }

    func nums(self) -> [int64] {
        self.text = self.text + "a"
        return [10, 20, 30]
    }

    func tick(self) -> int64 {
        self.n += 1
        return self.n
    }

    func flush(self) -> str {
        let t = self.text
        self.text = ""
        return t
    }
}

type Grid = shared struct {
    w: int64

    func op_index(self, anon i: int64) -> int64 {
        return self.w * i
    }
}

func grid(anon log: Log) -> Grid {
    log.word("g")
    return Grid(w: 3)
}

test "the indexed value is computed before its index" {
    let l = Log()
    let a = l.nums()[l.at("i", 1)]
    assert a == 20
    assert l.flush() == "ai"
    let b = l.word("str")[l.at("i", 0)]
    assert b == 115
    assert l.flush() == "stri"
    let c = l.ages()[l.word("k")]? or 0
    assert c == 7
    assert l.flush() == "mk"
    let d = grid(l)[l.at("i", 2)]
    assert d == 6
    assert l.flush() == "gi"
}

test "the sliced value is computed before its bounds" {
    let l = Log()
    let a = len(l.nums()[l.at("lo", 0)..l.at("hi", 2)])
    assert a == 2
    assert l.flush() == "alohi"
    let b = l.word("str")[l.at("lo", 1)..]
    assert b == "tr"
    assert l.flush() == "strlo"
}

test "a comparison chain goes left to right and stops at the first false" {
    let l = Log()
    let a = l.at("a", 1) < l.at("b", 2) < l.at("c", 3)
    assert a == true
    assert l.flush() == "abc"
    let b = l.at("a", 3) < l.at("b", 2) < l.at("c", 3)
    assert b == false
    assert l.flush() == "ab"
    let c = l.at("a", 1) < l.at("b", 0) < l.at("c", 3) < l.at("d", 4)
    assert c == false
    assert l.flush() == "ab"
    let d = l.word("x") < l.word("y") <= l.word("z")
    assert d == true
    assert l.flush() == "xyz"
    let e = l.n < l.tick() < 5
    assert e == true
    assert l.n == 1
}
