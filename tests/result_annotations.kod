// `T or Error` as an annotation, parameter, field, alias and return type.

type Oops = struct {
    message: str
    func to_str(self) -> str { return self.message }
}

type Outcome = int64 or Error

type Attempt = struct {
    label: str
    result: int64 or Error
}

func half(anon n: int64) -> int64 or Error {
    if n % 2 == 1 {
        throw Oops(message: f"{n} is odd")
    }
    return n / 2
}

func quarter(anon n: int64) -> Outcome {
    let h = try half(n)
    if h == 0 {
        throw Oops(message: "nothing left")
    }
    return try half(h)
}

func show(anon r: int64 or Error) -> str {
    match r {
        Ok(v) -> return f"ok {v}"
        Err(e) -> return f"err {e.to_str()}"
    }
}

func main() -> int64 {
    let a: int64 or Error = half(4)
    print(show(a))
    let b: Outcome = half(3)
    print(show(b))
    let t = Attempt(label: "six", result: half(6))
    print(f"{t.label}: {show(t.result)}")
    print(show(quarter(8)))
    print(show(quarter(6)))
    print(show(quarter(0)))
    print(f"{must quarter(4)}")
    if quarter(5) is Err(e) {
        print(f"five: {e.to_str()}")
    }
    return 0
}

// expected output:
// ok 2
// err 3 is odd
// six: ok 3
// ok 2
// err 3 is odd
// err nothing left
// 1
// five: 5 is odd
