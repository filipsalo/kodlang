// Explicit type arguments on a generic constructor call pick the
// instantiation, so unannotated bindings get the instance's field kinds.
import "json"

type Pair[A, B] = struct {
    first: A
    second: B
}

type Cell[T] = struct {
    v: T?
}

type Wrap[T] = struct {
    item: T
}

func main() -> int64 {
    let p = Pair[str, int64](first: "a", second: 1)
    print(f"{p.first} {p.second}")
    let m = Map[str, int64]()
    m.set("ab", 2)
    let key = "a" + "b"
    print(f"{m.get(key)? or -1} {m.get("zz")? or -1}")
    let c = Cell[str](v: "boxed")
    print(f"{c.v? or "empty"}")
    let w = Wrap[[str]](item: ["x", "y"])
    print(f"{w.item[1]}")
    let nested = Pair[str, Pair[int64, str]](first: "outer", second: Pair[int64, str](first: 7, second: "inner"))
    print(f"{nested.first} {nested.second.first} {nested.second.second}")
    let maybe = Pair[str?, int64](first: none, second: 3)
    print(f"{maybe.first? or "no first"} {maybe.second}")
    let jw = Wrap[json.Value](item: json.Value.Str(value: "qualified"))
    match jw.item {
        .Str(value) -> print(value)
        else -> print("not a str")
    }
    return 0
}

// expected output:
// a 1
// 2 -1
// boxed
// y
// outer 7 inner
// no first 3
// qualified
// expected status:
// 0
