import "./xmod_item_default_dep"

type SBox = xmod_item_default_dep.Box[str]

func seed() -> int64 {
    return 2
}

func main() -> int64 {
    let bx = SBox(v: "x")
    print(f"item default: {xmod_item_default_dep.f()}")
    print(f"item in generic body: {bx.tag()}")
    print(f"own seed: {seed()}")
    return 0
}

// expected output:
// item default: 1
// item in generic body: 1
// own seed: 2

// expected mode:
// run
