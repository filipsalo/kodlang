// Run by tests/test_isolation_test.py with `kod test`: each test is in a
// process of its own, so the ones after a panic or a crash still run, and a
// module variable a test changes is as it was for the next one.
import "unsafe"

mut counter: int64 = 0

test "fails an assert" {
    counter += 1
    assert 1 == 2
}

test "panics" {
    counter += 1
    let xs = [1]
    assert xs[5] == 0
}

test "crashes" {
    let _ = unsafe.load64(8)
}

test "runs after them" {
    assert counter == 0
}

// expected mode:
// skip
