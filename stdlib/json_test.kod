import "json"

test "parse: null" {
    match must json.parse("null") {
        .Null -> {}
        else -> fail("expected Null")
    }
}

test "parse: true" {
    match must json.parse("true") {
        .Bool(b) -> assert b == true
        else -> fail("expected Bool")
    }
}

test "parse: false" {
    match must json.parse("false") {
        .Bool(b) -> assert b == false
        else -> fail("expected Bool")
    }
}

test "parse: positive integer" {
    match must json.parse("42") {
        .Number(n) -> assert n == 42
        else -> fail("expected Number")
    }
}

test "parse: negative integer" {
    match must json.parse("-7") {
        .Number(n) -> assert n == -7
        else -> fail("expected Number")
    }
}

test "parse: zero" {
    match must json.parse("0") {
        .Number(n) -> assert n == 0
        else -> fail("expected Number")
    }
}

test "parse: simple string" {
    match must json.parse("\"hello\"") {
        .Str(s) -> assert s == "hello"
        else -> fail("expected Str")
    }
}

test "parse: string with escapes" {
    match must json.parse("\"a\\nb\\tc\\\"d\"") {
        .Str(s) -> assert s == "a\nb\tc\"d"
        else -> fail("expected Str")
    }
}

test "parse: empty array" {
    match must json.parse("[]") {
        .Array(items) -> assert len(items) == 0
        else -> fail("expected Array")
    }
}

test "parse: array of numbers" {
    match must json.parse("[1, 2, 3]") {
        .Array(items) -> {
            assert len(items) == 3
            match items[0] {
                .Number(n) -> assert n == 1
                else -> fail("expected Number at [0]")
            }
            match items[1] {
                .Number(n) -> assert n == 2
                else -> fail("expected Number at [1]")
            }
            match items[2] {
                .Number(n) -> assert n == 3
                else -> fail("expected Number at [2]")
            }
        }
        else -> fail("expected Array")
    }
}

test "parse: empty object" {
    match must json.parse("{}") {
        .Object(keys, _values) -> assert len(keys) == 0
        else -> fail("expected Object")
    }
}

test "parse: object" {
    let v: json.Value = must json.parse("{\"name\": \"alice\", \"age\": 30}")
    match json.get(v, key: "name") {
        .Str(s) -> assert s == "alice"
        else -> fail("expected Str for name")
    }
    match json.get(v, key: "age") {
        .Number(n) -> assert n == 30
        else -> fail("expected Number for age")
    }
    match json.get(v, key: "missing") {
        .Null -> {}
        else -> fail("expected Null for missing key")
    }
}

test "parse: nested" {
    let v: json.Value = must json.parse("{\"items\": [1, 2, {\"k\": true}]}")
    match json.get(v, key: "items") {
        .Array(items) -> {
            assert len(items) == 3
            match items[0] {
                .Number(n) -> assert n == 1
                else -> fail("expected Number at [0]")
            }
            match json.get(items[2], key: "k") {
                .Bool(b) -> assert b == true
                else -> fail("expected Bool for k")
            }
        }
        else -> fail("expected Array")
    }
}

// Accessor coverage — the optional-wrap-on-zero codegen bug used to make
// `Some(0)` and `Some(false)` round-trip to `none`, so these cases stayed
// uncovered until ea0a0e9. The `match … { Some(v) -> …; none -> fail }`
// shape is used instead of `if … is Some(v) { … } else { … }` because the
// parser lowers an `if is` into a one-arm match and doesn't attach the
// trailing `else`.

test "as_int: positive" {
    match json.as_int(must json.parse("42")) {
        Some(p) -> assert p == 42
        none -> fail("expected Some")
    }
}

test "as_int: negative" {
    match json.as_int(must json.parse("-7")) {
        Some(n) -> assert n == -7
        none -> fail("expected Some")
    }
}

test "as_int: zero (regression: optional-wrap-on-zero)" {
    match json.as_int(must json.parse("0")) {
        Some(z) -> assert z == 0
        none -> fail("as_int(0) round-tripped to none")
    }
}

test "as_bool: true" {
    match json.as_bool(must json.parse("true")) {
        Some(tv) -> assert tv == true
        none -> fail("expected Some")
    }
}

test "as_bool: false (regression: optional-wrap-on-zero)" {
    match json.as_bool(must json.parse("false")) {
        Some(fv) -> assert fv == false
        none -> fail("as_bool(false) round-tripped to none")
    }
}

test "as_int / as_bool: wrong type returns none" {
    assert json.as_int(must json.parse("\"hi\"")) is none
    assert json.as_bool(must json.parse("0")) is none
}

test "as_str: returns string" {
    match json.as_str(must json.parse("\"hi\"")) {
        Some(sv) -> assert sv == "hi"
        none -> fail("expected Some")
    }
}

test "emit: null" {
    assert json.emit(json.Value.Null) == "null"
}

test "emit: true / false" {
    assert json.emit(json.Value.Bool(value: true)) == "true"
    assert json.emit(json.Value.Bool(value: false)) == "false"
}

test "emit: integers" {
    assert json.emit(json.Value.Number(value: 42)) == "42"
    assert json.emit(json.Value.Number(value: -7)) == "-7"
}

test "emit: simple string" {
    assert json.emit(json.Value.Str(value: "hi")) == "\"hi\""
}

test "emit: string escapes" {
    assert json.emit(json.Value.Str(value: "a\nb")) == "\"a\\nb\""
    assert json.emit(json.Value.Str(value: "x\"y")) == "\"x\\\"y\""
}

test "emit: array" {
    let items: [json.Value] = [json.Value.Number(value: 1), json.Value.Number(value: 2)]
    assert json.emit(json.Value.Array(:items)) == "[1,2]"
}

test "emit: object" {
    let keys: [str] = ["a"]
    let values: [json.Value] = [json.Value.Number(value: 1)]
    assert json.emit(json.Value.Object(:keys, :values)) == "{\"a\":1}"
}

test "round-trip: nested structure" {
    let src: str = "{\"name\":\"alice\",\"tags\":[\"a\",\"b\"],\"meta\":{\"n\":42}}"
    assert json.emit(must json.parse(src)) == src
}

// ---- errors as values, strictness ----

func fails(anon src: str) -> bool {
    return json.parse(src) is Err(_)
}

func failure(anon src: str) -> json.JsonError {
    let r = json.parse(src)
    if r is Err(e) {
        if e is json.JsonError(je) {
            return je
        }
    }
    return json.JsonError(message: "no error", offset: -1, line: 0, column: 0)
}

// The one-byte string with byte value `n`.
func c(anon n: int64) -> str {
    return kod_bytes_to_str(kod_bytes_from_array([n]))
}

func rejects(anon srcs: [str]) -> bool {
    for s in srcs {
        if fails(s) == false {
            return false
        }
    }
    return true
}

func accepts(anon srcs: [str]) -> bool {
    for s in srcs {
        if fails(s) {
            return false
        }
    }
    return true
}

test "errors: malformed input is a JsonError, not a panic" {
    assert fails("")
    assert fails("   ")
    assert fails("{")
    assert fails("[1,")
    assert fails("\"abc")
    assert fails("nul")
    let e = failure("[1, 2")
    assert e.message != "no error"
    assert e.offset == 5
}

test "errors: where it went wrong" {
    let a = failure("{\"a\": 1,\n  \"b\": ?}")
    assert a.line == 2 and a.column == 8 and a.offset == 16
    assert a.message == "unexpected character"
    let b = failure("[1 2]")
    assert b.offset == 3 and b.line == 1 and b.column == 4
    assert failure("").message == "unexpected end of input"
    assert failure("\"abc").message == "unterminated string"
    assert failure("1 x").message == "unexpected text after the value"
}

test "errors: to_str names the line and column" {
    let e = failure("[\n1,\n?]")
    assert e.to_str() == "json: unexpected character at line 3, column 1"
}

test "errors: the Error side can be downcast to JsonError" {
    let r = json.parse("[")
    assert r is Err(_)
    if r is Err(e) {
        assert e is json.JsonError(_)
        assert e.to_str().starts_with("json: ")
    }
}

test "strict: text after the value, commas, colons, brackets" {
    assert rejects(["1 2", "[] []", "{} x", "null null", "[1,]", "[,1]", "[1,,2]", "{\"a\":1,}", "{,}", "{\"a\"}", "{\"a\" 1}", "{\"a\":}", "{1:2}", "{\"a\":1 \"b\":2}", "[1 2]", "]", "}", "[}", "{]", ","])
    assert accepts(["[]", "{}", " [ ] ", "\n{\t}\r\n", "[1,2]", "{\"a\":1,\"b\":2}", " null "])
}

test "strict: no comments, single quotes, bare words" {
    assert rejects(["// c\n1", "[1 /* c */]", "'a'", "{a: 1}", "{'a': 1}", "undefined", "NaN", "Infinity", "-Infinity", "True", "NULL", "nulll", "tru", "falsey"])
}

test "strict: whitespace is only space, tab, LF and CR" {
    assert accepts([" \t\r\n1"])
    assert rejects([c(0) + "1", c(11) + "1", "1" + c(12), c(160) + "1"])
}

test "numbers: the grammar" {
    assert accepts(["0", "-0", "7", "-7", "10", "123456789", "0.5", "-0.5", "1.25", "1e5", "1E5", "1e+5", "1e-5", "1.5e10", "0e0", "-0.0e-0"])
    assert rejects(["01", "-01", "00", "-", "+1", "1.", ".5", "-.5", "1e", "1e+", "1e-", "1.e5", "0x10", "1_000", "1,5", "--1", "1.2.3", "1e5.5", "- 1"])
}

test "numbers: integers that fit are Number, -0 is 0" {
    match must json.parse("9223372036854775807") {
        .Number(n) -> assert n == 9223372036854775807
        else -> fail("expected Number")
    }
    match must json.parse("-9223372036854775808") {
        .Number(n) -> assert n == -9223372036854775807 - 1
        else -> fail("expected Number")
    }
    match must json.parse("-0") {
        .Number(n) -> assert n == 0
        else -> fail("expected Number")
    }
}

func decimal_text(anon src: str) -> str {
    match must json.parse(src) {
        .Decimal(text) -> return text
        else -> return "<not a Decimal>"
    }
}

test "numbers: fractions, exponents and big integers keep their text" {
    assert decimal_text("2.5") == "2.5"
    assert decimal_text("-0.0") == "-0.0"
    assert decimal_text("1e3") == "1e3"
    assert decimal_text("1.5E-10") == "1.5E-10"
    assert decimal_text("3.0") == "3.0"
    assert decimal_text("9223372036854775808") == "9223372036854775808"
    assert decimal_text("-9223372036854775809") == "-9223372036854775809"
    assert decimal_text("123456789012345678901234567890") == "123456789012345678901234567890"
    assert decimal_text("0.1234567890123456789012345678901234567890") == "0.1234567890123456789012345678901234567890"
}

test "numbers: as_int is none for a Decimal, as_number_text covers both" {
    assert json.as_int(must json.parse("3.0")) is none
    assert (json.as_number_text(must json.parse("3.0"))? or "!") == "3.0"
    assert (json.as_number_text(must json.parse("42"))? or "!") == "42"
    assert (json.as_number_text(must json.parse("-7"))? or "!") == "-7"
    assert json.as_number_text(must json.parse("\"1\"")) is none
}

test "numbers: inside containers" {
    let v = must json.parse("[1, 2.5, -3, 1e2]")
    assert json.emit(v) == "[1,2.5,-3,1e2]"
}

test "strings: every simple escape" {
    match must json.parse("\"\\\" \\\\ \\/ \\b \\f \\n \\r \\t\"") {
        .Str(s) -> assert s == "\" \\ / " + c(8) + " " + c(12) + " \n \r \t"
        else -> fail("expected Str")
    }
}

func str_of(anon src: str) -> str {
    match must json.parse(src) {
        .Str(s) -> return s
        else -> return "<not a Str>"
    }
}

func bytes_of(anon s: str) -> [int64] {
    mut out: [int64] = []
    mut i: int64 = 0
    for i < len(s) {
        out += [s[i]]
        i = i + 1
    }
    return out
}

test "strings: \\u escapes become UTF-8" {
    assert str_of("\"\\u0041\"") == "A"
    assert str_of("\"\\u00e9\"") == "é"
    assert str_of("\"\\u00E9\"") == "é"
    assert str_of("\"\\u20ac\"") == "€"
    assert str_of("\"a\\u0062c\"") == "abc"
    assert len(bytes_of(str_of("\"\\u00e9\""))) == 2
}

test "strings: surrogate pairs give one four-byte character" {
    let s = str_of("\"\\ud83d\\ude00\"")
    assert len(s) == 4
    assert s == "😀"
    assert str_of("\"\\uD834\\uDD1E\"") == "𝄞"
    assert str_of("\"x\\ud83d\\ude00y\"") == "x😀y"
}

test "strings: \\u0000 is a NUL byte, and raw UTF-8 passes through" {
    let s = str_of("\"a\\u0000b\"")
    assert len(s) == 3 and s[1] == 0
    assert str_of("\"héllo wörld €😀\"") == "héllo wörld €😀"
}

test "strings: bad escapes and bad unicode" {
    assert rejects(["\"\\x41\"", "\"\\a\"", "\"\\'\"", "\"\\U0041\"", "\"\\", "\"\\u\"", "\"\\u12\"", "\"\\u12g4\"", "\"\\u 041\"", "\"\\u+041\""])
    assert rejects(["\"\\ud800\"", "\"\\ud800x\"", "\"\\ud800\\u0041\"", "\"\\ud800\\ud800\"", "\"\\udc00\"", "\"\\ude00\\ud83d\""])
}

test "strings: a raw control character is an error" {
    assert rejects(["\"a\nb\"", "\"a\tb\"", "\"a\rb\"", "\"\0\"", "\"" + c(1) + "\"", "\"" + c(31) + "\""])
    assert accepts(["\"a\\nb\"", "\"" + c(127) + "\"", "\"" + c(128) + "\""])
}

test "strings: keys follow the same rules" {
    let v = must json.parse("{\"k\\u00e9y\": 1, \"a\\nb\": 2}")
    assert (json.as_int(json.get(v, key: "kéy"))? or -1) == 1
    assert (json.as_int(json.get(v, key: "a\nb"))? or -1) == 2
    assert fails("{\"a\\q\": 1}")
}

test "strings: a long string parses in linear time" {
    let src = "\"" + "ab\\n".repeat(50000) + "\""
    let s = str_of(src)
    assert len(s) == 150000
}

test "depth: nesting is bounded" {
    assert accepts(["[[[[1]]]]", "{\"a\":{\"b\":{\"c\":[]}}}"])
    let deep = "[".repeat(100000) + "]".repeat(100000)
    let r = json.parse(deep)
    assert r is Err(_)
    if r is Err(e) {
        assert e.to_str().contains("nesting too deep")
    }
    let objs = "{\"a\":".repeat(100000) + "1" + "}".repeat(100000)
    assert fails(objs)
}

test "depth: max_depth is the number of enclosing containers allowed" {
    assert (json.parse("1", max_depth: 0)) is Ok(_)
    assert fails_with_depth("[1]", 0)
    assert (json.parse("[1]", max_depth: 1)) is Ok(_)
    assert fails_with_depth("[[1]]", 1)
    assert (json.parse("[[1]]", max_depth: 2)) is Ok(_)
    assert fails_with_depth("{\"a\":[1]}", 1)
    assert (json.parse("[]", max_depth: 1)) is Ok(_)
    assert (json.parse("[[1],[2]]", max_depth: 2)) is Ok(_)
}

func empty_items() -> json.Items {
    let none_here: json.Items = []
    return none_here
}

func fails_with_depth(anon src: str, anon depth: int64) -> bool {
    return json.parse(src, max_depth: depth) is Err(_)
}

test "bom: a leading byte order mark is skipped" {
    let bom = kod_bytes_to_str(kod_bytes_from_array([239, 187, 191]))
    assert (json.parse(bom + "[1]")) is Ok(_)
    assert fails(bom + bom + "[1]")
    assert fails("[1]" + bom)
}

test "objects: order and repeated keys are kept, get finds the first" {
    let v = must json.parse("{\"b\":1,\"a\":2,\"b\":3}")
    assert json.emit(v) == "{\"b\":1,\"a\":2,\"b\":3}"
    assert (json.as_int(json.get(v, key: "b"))? or -1) == 1
}

test "accessors: at, as_array, is_null, and safe chaining" {
    let v = must json.parse("{\"xs\": [10, 20, 30], \"n\": null}")
    let xs = json.get(v, key: "xs")
    assert (json.as_int(json.at(xs, 1))? or -1) == 20
    assert json.is_null(json.at(xs, 3))
    assert json.is_null(json.at(xs, -1))
    assert json.is_null(json.at(v, 0))
    assert json.is_null(json.get(v, key: "n"))
    assert json.is_null(json.get(v, key: "missing"))
    assert json.is_null(json.get(json.get(v, key: "missing"), key: "deeper"))
    assert json.is_null(json.get(xs, key: "k"))
    let items = json.as_array(xs)
    assert items is none == false
    assert len(items? or empty_items()) == 3
    assert json.as_array(v) is none
}

// ---- emitting ----

test "emit: strings escape what JSON requires and nothing else" {
    assert json.emit(.Str(value: "a\"b\\c\n\r\t")) == "\"a\\\"b\\\\c\\n\\r\\t\""
    assert json.emit(.Str(value: c(8) + c(12))) == "\"\\b\\f\""
    assert json.emit(.Str(value: c(1) + c(31))) == "\"\\u0001\\u001f\""
    assert json.emit(.Str(value: "/é€😀" + c(127))) == "\"/é€😀" + c(127) + "\""
    assert json.emit(.Str(value: "")) == "\"\""
    assert json.emit(.Str(value: "a\0b")) == "\"a\\u0000b\""
}

test "emit: a Decimal is written verbatim, invalid text becomes null" {
    assert json.emit(.Decimal(text: "2.5")) == "2.5"
    assert json.emit(.Decimal(text: "-1e+10")) == "-1e+10"
    assert json.emit(.Decimal(text: "12345678901234567890")) == "12345678901234567890"
    assert json.emit(.Decimal(text: "")) == "null"
    assert json.emit(.Decimal(text: "NaN")) == "null"
    assert json.emit(.Decimal(text: "01")) == "null"
    assert json.emit(.Decimal(text: "1.")) == "null"
    assert json.emit(.Decimal(text: "1, 2")) == "null"
    assert json.emit(.Decimal(text: "1e5\"]")) == "null"
}

test "emit: round trip keeps the meaning" {
    let srcs = ["null", "true", "[]", "{}", "[1,[2,[3]]]", "{\"a\":{\"b\":[true,false,null]}}", "\"\\u00e9\\n\"", "[1.5,2e3,-0.25]", "{\"k\\\"ey\":\"v\\\\al\"}", "[\"😀\"]"]
    for s in srcs {
        let once = json.emit(must json.parse(s))
        let twice = json.emit(must json.parse(once))
        assert once == twice
    }
    assert json.emit(must json.parse(" [ 1 ,\n 2 ] ")) == "[1,2]"
    assert json.emit(must json.parse("\"\\u0041\\/\"")) == "\"A/\""
}

test "emit: a big structure in linear time" {
    mut items: [json.Value] = []
    mut i: int64 = 0
    for i < 20000 {
        items += [.Number(value: i)]
        i = i + 1
    }
    let out = json.emit(.Array(items: items))
    assert out.starts_with("[0,1,2,3") and out.ends_with("19998,19999]")
    let back = must json.parse(out)
    assert len(json.as_array(back)? or empty_items()) == 20000
}

test "emit_pretty: layout" {
    let v = must json.parse("{\"a\":[1,2],\"b\":{\"c\":null},\"d\":[],\"e\":{}}")
    let want = "{\n  \"a\": [\n    1,\n    2\n  ],\n  \"b\": {\n    \"c\": null\n  },\n  \"d\": [],\n  \"e\": {}\n}"
    assert json.emit_pretty(v) == want
}

test "emit_pretty: indent width, scalars, and no trailing newline" {
    assert json.emit_pretty(.Number(value: 5)) == "5"
    assert json.emit_pretty(.Array(items: [])) == "[]"
    assert json.emit_pretty(must json.parse("[1]"), indent: 4) == "[\n    1\n]"
    assert json.emit_pretty(must json.parse("[1]"), indent: 0) == "[\n1\n]"
    assert json.emit_pretty(must json.parse("{\"k\":\"v\"}")).ends_with("}")
}

test "emit_pretty: parses back to the same value as emit" {
    let v = must json.parse("{\"a\":[1,{\"b\":\"x\\ny\"},2.5],\"c\":true}")
    assert json.emit(must json.parse(json.emit_pretty(v))) == json.emit(v)
}

// ---- builders ----

test "ObjectBuilder: entries in order, every kind" {
    let b = json.ObjectBuilder()
    b.put_str("title", "a bug")
    b.put_int("priority", 2)
    b.put_bool("urgent", false)
    b.put_null("owner")
    b.put("labels", json.array_of([json.str_value("bug"), json.str_value("ui")]))
    assert json.emit(b.build()) == "{\"title\":\"a bug\",\"priority\":2,\"urgent\":false,\"owner\":null,\"labels\":[\"bug\",\"ui\"]}"
}

test "ObjectBuilder: empty, nested, repeated keys, reuse" {
    let b = json.ObjectBuilder()
    assert json.emit(b.build()) == "{}"
    let inner = json.ObjectBuilder()
    inner.put_int("n", 1)
    b.put("inner", inner.build())
    b.put_int("k", 1)
    b.put_int("k", 2)
    assert json.emit(b.build()) == "{\"inner\":{\"n\":1},\"k\":1,\"k\":2}"
    b.put_bool("more", true)
    assert json.emit(b.build()).ends_with(",\"more\":true}")
}

test "ObjectBuilder: a built value does not change when the builder does" {
    let b = json.ObjectBuilder()
    b.put_int("a", 1)
    let first = b.build()
    b.put_int("b", 2)
    assert json.emit(first) == "{\"a\":1}"
    assert json.emit(b.build()) == "{\"a\":1,\"b\":2}"
}

test "builders: scalars, arrays and special characters survive a round trip" {
    let b = json.ObjectBuilder()
    b.put_str("text", "line\nbreak \"quoted\" é")
    b.put("nums", json.array_of([json.int_value(1), json.int_value(-2), json.bool_value(true)]))
    let back = must json.parse(json.emit(b.build()))
    assert (json.as_str(json.get(back, key: "text"))? or "!") == "line\nbreak \"quoted\" é"
    assert (json.as_int(json.at(json.get(back, key: "nums"), 1))? or 0) == -2
    assert json.emit(json.array_of([])) == "[]"
}
