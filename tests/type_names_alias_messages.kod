// A message qualifies a type only when another module declares one of that
// name: an alias doesn't, whatever it stands for, as a message writes the type
// it stands for.
import "./type_names_alias_dep"
import "./type_names_pb"

func main() -> int64 {
    let a: int64 = type_names_pb.make(1, 2)
    let b: int64 = type_names_pb.Label(text: "x")
    let c: int64 = type_names_pb.Mode.On
    return 0
}

// expected errors:
// 8:20: error: expected `int64`, got `Pt`
// 9:20: error: expected `int64`, got `Label`
// 10:20: error: expected `int64`, got `Mode`
