// A call through an interface fills an omitted argument from the interface.
interface Greeter {
    func greet(self, anon name: str, times: int64 = 2) -> str
}

type Dog = shared struct {
    sound: str

    func greet(self, anon name: str, times: int64 = 2) -> str {
        mut out = ""
        mut i = 0
        for i < times {
            out = out + self.sound
            i = i + 1
        }
        return f"{out} {name}"
    }
}

test "an omitted argument comes from the interface" {
    let g: Greeter = Dog(sound: "woof")
    assert g.greet("cat") == "woofwoof cat"
    assert g.greet("cat", times: 3) == "woofwoofwoof cat"
    let gs: [Greeter] = [Dog(sound: "yip"), g]
    mut out: [str] = []
    for each in gs {
        out += [each.greet("owl")]
    }
    assert out == ["yipyip owl", "woofwoof owl"]
}
