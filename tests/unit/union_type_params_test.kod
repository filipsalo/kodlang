// Type parameters in unions: instances, inference, and type patterns that name
// a union or an optional.

type Id = int64 | str

type MaybeInt = int64?

type Slot[T] = shared struct {
    value: T | str

    func show(self) -> str {
        match self.value {
            str(s) -> return f"str {s}"
            T(t) -> return f"T {t}"
        }
    }
}

type Either[T] = enum {
    One(value: T | bool)
    Two
}

func label[T](anon x: T | str) -> str {
    match x {
        str(s) -> return f"str {s}"
        T(t) -> return f"T {t}"
    }
}

func pick[T](anon x: T, text: bool) -> T | str {
    if text {
        return "text"
    }
    return x
}

// `T` stays a `T`, whatever the instance holds besides.
func keep[T](anon x: T | str, fallback: T) -> T {
    if x is T(t) {
        return t
    }
    return fallback
}

func either_text[T](anon e: Either[T]) -> str {
    match e {
        .One(v) -> {
            if v is bool(b) {
                return f"bool {b}"
            }
            return "T"
        }
        .Two -> return "two"
    }
}

func count_ids(anon xs: [int64 | str | bool]) -> int64 {
    mut n = 0
    for x in xs {
        if x is Id(_id) {
            n += 1
        }
    }
    return n
}

func describe(anon x: int64 | str | bool) -> str {
    match x {
        Id(id) -> return f"id {id}"
        bool(b) -> return f"bool {b}"
    }
}

func maybe(anon x: int64 | str | none) -> str {
    match x {
        MaybeInt(n) -> {
            if n is none {
                return "nothing"
            }
            return f"int {n}"
        }
        str(s) -> return f"str {s}"
    }
}

test "a type parameter in a union, given and inferred" {
    assert label[int64](3) == "T 3"
    assert label[int64]("a") == "str a"
    assert label[str]("b") == "str b"
    assert label[int64 | bool](true) == "T true"
    assert label[int64 | bool]("c") == "str c"
    assert label(4) == "T 4"
    let u: bool | str = false
    assert label(u) == "T false"
}

test "returning T | str and keeping T" {
    assert f"{pick(5, text: false)}" == "5"
    assert f"{pick(5, text: true)}" == "text"
    let p: int64 | str = pick(6, text: false)
    assert f"{p}" == "6"

    assert keep[int64](8, fallback: 0) == 8
    assert keep[int64]("x", fallback: 9) == 9
    let kept: int64 | bool = keep[int64 | bool](true, fallback: 1)
    assert f"{kept}" == "true"
}

test "generic structs and enums with a union field" {
    assert Slot[int64](value: 7).show() == "T 7"
    assert Slot[str](value: "s").show() == "str s"
    assert Slot[int64 | bool](value: true).show() == "T true"

    let e1: Either[int64] = .One(value: true)
    let e2: Either[int64] = .One(value: 3)
    let e3: Either[int64] = .Two
    assert either_text(e1) == "bool true"
    assert either_text(e2) == "T"
    assert either_text(e3) == "two"
}

test "type patterns that name a union or an optional" {
    assert count_ids([1, "a", true, 2, false]) == 3
    assert describe(10) == "id 10"
    assert describe("k") == "id k"
    assert describe(true) == "bool true"
    assert maybe(none) == "nothing"
    assert maybe(11) == "int 11"
    assert maybe("m") == "str m"
}
