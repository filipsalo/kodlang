// An optional of an optional is that optional: `T?` is `T | none`, a set, so
// `none` means one thing however the type is spelled.
type MaybeInt = int64?

type Slot = shared struct {
    v: MaybeInt?
}

type Box = enum {
    Full(v: MaybeInt?)
    Empty
}

func show(anon x: MaybeInt?) -> str {
    match x {
        int64(n) -> return f"some {n}"
        none -> return "none"
    }
}

func lift(anon x: int64?) -> MaybeInt? {
    return x
}

func first[T](anon xs: [T]) -> T? {
    if len(xs) == 0 {
        return none
    }
    return xs[0]
}

test "a stored none and a missing key" {
    // A stored `none` and a missing key both read as `none`; `contains` tells them apart.
    mut m = Map[str, int64?]()
    m.set("k", 5)
    m["n"] = none
    mut lines: [str] = []
    for key in ["k", "n", "zz"] {
        lines += [f"{key}: {show(m.get(key))} {show(m[key])} {m.contains(key)}"]
    }
    assert lines == ["k: some 5 some 5 true", "n: none none true", "zz: none none false"]
    let got: int64 = m.get("k")? or 0
    assert got == 5
}

test "optionals of optionals in returns, fields, payloads and arrays" {
    let five: int64? = 5
    let stored: int64? = none
    assert show(lift(five)) == "some 5"
    assert show(lift(stored)) == "none"
    let s = Slot(v: stored)
    assert show(s.v) == "none"
    s.v = five
    assert show(s.v) == "some 5"
    let boxes = [Box.Full(v: stored), Box.Full(v: five), Box.Empty]
    mut shown: [str] = []
    for b in boxes {
        match b {
            .Full(v) -> shown += [show(v)]
            .Empty -> shown += ["empty"]
        }
    }
    assert shown == ["none", "some 5", "empty"]
    let xs: [MaybeInt?] = [five, stored, none]
    shown = []
    for x in xs {
        shown += [show(x)]
    }
    assert shown == ["some 5", "none", "none"]
}

test "a generic function returning T? for T = int64?" {
    let opts: [int64?] = [none, 3]
    let empty: [int64?] = []
    assert f"{show(first(opts))} {show(first(empty))}" == "none none"
    if first(opts) is not none {
        fail("first is not none")
    }
}
