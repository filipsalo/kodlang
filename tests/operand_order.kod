// F-string interpolations and the operands of string `+`, string
// comparisons and array `+` are evaluated left to right, so a call's side
// effects are seen by the parts after it.

type Counter = struct {
    n: int64
}

func bump(c: Counter) -> int64 {
    c.n = c.n + 10
    return c.n
}

type Log = struct {
    text: str = ""

    func add(self, anon s: str) -> str {
        self.text = self.text + s
        return s
    }

    func one(self, anon s: str) -> [str] {
        self.text = self.text + s
        return [s]
    }
}

func main() -> int64 {
    let c = Counter(n: 1)
    print(f"{bump(:c)} then {c.n}")
    let log = Log()
    print(log.add("a") + log.add("b") + log.add("c"))
    print(log.text)
    print(f"[{log.add("d")}{log.add("e")}]")
    print(log.text)
    if log.add("x") < log.add("y") {
        print(log.text)
    }
    let xs = log.one("1") + log.one("2") + log.one("3")
    print_int(len(xs))
    print(log.text)
    return 0
}

// expected output:
// 11 then 11
// abc
// abc
// [de]
// abcde
// abcdexy
// 3
// abcdexy123
