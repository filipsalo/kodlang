// The DWARF the compiler writes (docs/debugging.md), as macOS's own tools read
// it: lldb resolving breakpoints and dwarfdump checking the sections, and,
// where Developer Mode lets lldb run the program, the values it shows.
import "process"

let KOD: str = "build/apps/kod/kod"
let SOURCE: str = "tests/support/debug_target.kod"
let PROGRAM: str = "build/apps/debug_target/debug_target"
let OBJECT: str = "build/apps/debug_target/debug_target.obj/tests/support/debug_target.kod.o"

func build() -> none {
    let made = must process.output([KOD, "build", SOURCE])
    if made.status != 0 {
        fail(f"kod build {SOURCE}: {made.stdout}{made.stderr}")
    }
}

// What lldb prints for `commands`, run against the program without starting it.
func lldb(anon commands: [str]) -> str {
    mut argv = ["/usr/bin/lldb", "--batch", "--no-lldbinit"]
    for c in commands {
        argv += ["-o", c]
    }
    let ran = must process.output(argv + [PROGRAM])
    return ran.stdout + ran.stderr
}

test "the object's DWARF verifies" {
    build()
    let checked = must process.output(["/usr/bin/dwarfdump", "--verify", OBJECT])
    assert checked.status == 0
    assert checked.stdout.contains("No errors.")
}

test "breakpoints on Kod lines and functions" {
    build()
    let out = lldb(["b debug_target.kod:19", "b debug_target.kod:20", "b debug_target.kod:8"])
    assert out.contains("at debug_target.kod:19")
    assert out.contains("at debug_target.kod:20")
    assert out.contains("at debug_target.kod:8")
    // By name, at the function's first statement; a method by its type's
    // name and its own.
    let named = lldb(["b triple", "b Counter.bump"])
    assert named.contains("triple + ") and named.contains("at debug_target.kod:13")
    assert named.contains("Counter.bump + ") and named.contains("at debug_target.kod:8")
}

test "a line for every statement, in the right file" {
    build()
    let dumped = must process.output(["/usr/bin/dwarfdump", "--debug-line", OBJECT])
    let table = dumped.stdout
    assert table.contains("debug_target.kod")
    for line in [8, 18, 19, 20, 21] {
        mut found = false
        for row in table.lines() {
            let cols = row.split_whitespace()
            // Rows: address, line, column, file, ...
            if len(cols) > 2 and cols[0].starts_with("0x") and cols[1] == f"{line}" {
                found = true
            }
        }
        assert found
    }
}

test "an executable records where its objects are" {
    build()
    let symbols = must process.output(["/usr/bin/nm", "-ap", PROGRAM])
    // The debug map: a stab naming the program's object.
    assert symbols.stdout.contains("OSO")
    assert symbols.stdout.contains("debug_target.kod.o")
}

// Whether lldb may run a program here: Developer Mode is on.
func can_run() -> bool {
    let status = process.output(["/usr/sbin/DevToolsSecurity", "-status"])
    if status is Ok(out) {
        return out.stdout.contains("enabled")
    }
    return false
}

test "under lldb: the stack, stepping and the variables' values" {
    if not can_run() {
        print("  (Developer Mode is off: lldb can't run the program, so nothing is checked)")
        return
    }
    build()
    let out = lldb(["b debug_target.kod:8", "b debug_target.kod:35", "b debug_target.kod:50", "run", "bt", "frame variable", "next", "continue", "frame variable", "p xs.ptr[3]", "p *words.ptr[1]", "continue", "frame variable", "p *pet.tags->ptr[1]", "p *pet.owner", "kill"])
    // In Counter.bump, called from main, with self holding n = 1 before the bump.
    assert out.contains("Counter.bump(self=") and out.contains("at debug_target.kod:8")
    assert out.contains("main at debug_target.kod:19")
    assert out.contains("(Counter) self = (n = 1)")
    // `next` goes back to main's next line.
    assert out.contains("main at debug_target.kod:20")
    // In kinds: a str, an [int64] and a [str].
    assert out.contains("(str) name = (buf = \"kod\", len = 3)")
    assert out.contains("len = 4") and out.contains("(long) 42")
    assert out.contains("(buf = \"bc\", len = 2)")
    // In pets: a struct's fields, one a struct of its own.
    assert out.contains("(Pet) pet = {") and out.contains("age = 3") and out.contains("happy = true")
    assert out.contains("(buf = \"good\", len = 4)")
    assert out.contains("(Counter)  (n = 9)")
}

test "under lldb: a panic stops the program where it happened" {
    if not can_run() {
        print("  (Developer Mode is off: lldb can't run the program, so nothing is checked)")
        return
    }
    let made = must process.output([KOD, "build", "tests/support/debug_panic.kod"])
    assert made.status == 0
    let ran = must process.output(["/usr/bin/lldb", "--batch", "--no-lldbinit", "-o", "run", "-k", "bt", "-k", "kill", "build/apps/debug_panic/debug_panic"])
    let out = ran.stdout + ran.stderr
    assert out.contains("panic: index 7 out of bounds for array of length 3")
    assert out.contains("stop reason")
    assert out.contains("pick at debug_panic.kod:5")
    assert out.contains("main at debug_panic.kod:11")
    // Without a debugger it ends as ever.
    let alone = must process.output(["build/apps/debug_panic/debug_panic"])
    assert alone.status == 1 and alone.stderr.contains("panic: index 7")
}
