// main declared with an alias of `T or Error` still gets the Result unwrap.
type Oops = struct {
    message: str
    func to_str(self) -> str { return self.message }
}

type Exit = Code
type Code = int64 or Error

func check(anon n: int64) -> Exit {
    if n > 2 {
        throw Oops(message: f"{n} is too big")
    }
    return n
}

func main() -> Exit {
    let n = try check(1)
    print(f"got {n}")
    let m = try check(5)
    print(f"got {m}")
    return 0
}

// expected output:
// got 1
// expected status:
// 1
// expected stderr:
// panic: 5 is too big
