// A `-> none` helper that can't reach its end never returns, whether it
// ends in a panic, in another such helper declared later, a method, an
// imported module's function, or a `for true` loop without a `break`.
import "./never_returns_chain_dep"

type Reader = struct {
    pos: int64 = 0

    func get(self) -> int64 {
        if self.pos == 0 {
            return 5
        }
        self.fail("bad")
    }

    func fail(self, anon msg: str) -> none {
        self.die_at(msg)
    }

    func die_at(self, anon msg: str) -> none {
        kod_panic(f"{self.pos}: {msg}")
    }
}

func lookup(anon k: str) -> int64 {
    if k == "a" {
        return 1
    }
    fatal2(f"missing {k}")
}

func checked(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    return fatal2("negative")
}

func label(anon n: int64) -> str {
    let s = match n {
        1 -> "one"
        else -> serve()
    }
    return s
}

func first(anon o: int64?) -> int64 {
    let .Some(v) = o else { fatal2("empty") }
    return v
}

func wrapped(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    never_returns_chain_dep.die2("dep")
}

func served(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    serve()
}

func fatal2(anon msg: str) -> none {
    fatal(msg)
}

func fatal(anon msg: str) -> none {
    kod_panic(msg)
}

func serve() -> none {
    mut n = 0
    for true {
        n += 1
        if n > 3 {
            kod_panic("served")
        }
    }
}

func main() -> int64 {
    print_int(Reader().get() + lookup("a") + checked(2) + first(3) + wrapped(4) + served(5))
    print(label(1))
    print_int(lookup("zz"))
    return 0
}

// expected output:
// 20
// one
// expected status:
// 1
// expected stderr:
// panic: missing zz
