// The local's type is written the way the module would write it when two
// modules declare a type of that name.
import "./type_names_pa"
import "./type_names_pb"

func main() -> int64 {
    let g = type_names_pb.make(3, 4)
    let k = type_names_pa.make(1)
    print_int(g(1))
    return k(2)
}

// expected errors:
// 9:15: error: `g` is a local of type `type_names_pb.Pt`, not a function
// 10:12: error: `k` is a local of type `type_names_pa.Pt`, not a function
