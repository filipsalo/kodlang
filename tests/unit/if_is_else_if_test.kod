// `else if` after an `if` whose condition binds: it runs when the pattern fails and can bind its own names.

type Token = enum {
    Num(n: int64)
    Word(w: str)
    End
}

func show(t: Token) -> str {
    if t is .Num(n) {
        return f"num {n}"
    } else if t is .Word(w) and len(w) > 3 {
        return f"long {w}"
    } else if t is .Word(w) {
        return f"word {w}"
    } else {
        return "end"
    }
}

func small(t: Token) -> str {
    if t is .Num(n) and n < 10 {
        return f"small {n}"
    } else if t is .Num(n) {
        return f"big {n}"
    }
    return "other"
}

test "else if after a binding if" {
    assert show(t: .Num(n: 4)) == "num 4"
    assert show(t: .Word(w: "hello")) == "long hello"
    assert show(t: .Word(w: "hi")) == "word hi"
    assert show(t: .End) == "end"
    assert small(t: .Num(n: 3)) == "small 3"
    assert small(t: .Num(n: 30)) == "big 30"
    assert small(t: .End) == "other"
}

test "else if after is not" {
    let o: int64? = none
    mut ran = ""
    if o is not Some(v) {
        ran = "missing"
    } else if v > 0 {
        fail("bad")
    }
    assert ran == "missing"
}
