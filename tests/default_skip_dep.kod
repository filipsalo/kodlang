// A module whose functions have defaults that the caller skips: each default
// is evaluated here, in this module's scope, where `unit` and `trace` live.

func unit() -> int64 {
    return 10
}

func trace(anon label: str, anon value: int64) -> int64 {
    print(f"  {label}")
    return value
}

func scaled(anon n: int64, factor: int64 = unit(), offset: int64 = trace("dep offset default", 1)) -> int64 {
    return n * factor + offset
}

type Gauge = struct {
    base: int64

    func read(self, scale: int64 = unit(), shift: int64 = 0) -> int64 {
        return self.base * scale + shift
    }
}

