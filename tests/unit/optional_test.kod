// Comparing an optional with none, testing it with is, and matching it.
test "comparing and testing optionals" {
	let a: int64? = none
	let b: int64? = 42
	assert a == none
	assert b != none
	assert a is none
	assert b is Some
}

test "matching optionals" {
	let a: int64? = none
	let b: int64? = 42
	match a {
		none -> {}
		Some(v) -> fail(f"a is {v}")
	}
	match b {
		none -> fail("b is none")
		Some(v) -> assert v == 42
	}
}
