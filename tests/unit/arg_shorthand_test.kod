// Call-arg shorthand: `:name` is sugar for `name: name`. The explicit
// colon makes "pass variable as same-named label" visually distinct
// from passing an anonymous arg.

func greet(name: str, count: int64) -> [str] {
	mut lines: [str] = []
	mut i = 0
	for i < count {
		lines += [name]
		i = i + 1
	}
	return lines
}

test "shorthand passes each variable as its same-named label" {
	let name: str = "kod"
	let count: int64 = 2
	assert greet(:name, :count) == ["kod", "kod"]
}

test "shorthand mixes with full labels" {
	let count: int64 = 2
	assert greet(name: "explicit", :count) == ["explicit", "explicit"]
}
