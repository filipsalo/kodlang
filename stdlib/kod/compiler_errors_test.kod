    assert not test_support.any_message_contains(errs, needle: "bind it to an annotated")
}

test "a generic enum constructor takes its type from where it goes" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        type MaybeInt = Maybe[int64]
        func show(anon m: Maybe[int64]) -> none {
            if m is .Just(v) {
                print_int(v)
            }
        }
        func make(anon n: int64) -> Maybe[int64] {
            if n > 0 {
                return Maybe.Just(value: n)
            }
            return .Nothing
        }
        func parse(anon n: int64) -> int64 or Error {
            return .Ok(value: n)
        }
        func main() -> int64 {
            let a: Maybe[int64] = Maybe.Just(value: 41)
            let b: Maybe[int64] = .Just(value: 1)
            let c: MaybeInt? = .Just(value: 2)
            show(a)
            show(Maybe.Just(value: 3))
            show(.Nothing)
            show(make(4))
            let o: Option[int64] = Option.Some(value: 5)
            return must parse(1)
        }
        """)
    assert len(errs) == 0
}

test "an alias target with wrong type arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { x: int64 }
        type Pair[A, B] = struct {
            first: A
            second: B
        }
        type B = Map[str]
        type C = [Map[str]]
        type D = Box[int64]
        type P = Pair
        func main() -> int64 {
            let b: B = Map[str, int64]()
            b.set("a", 1)
            print_int(b.len())
            let c: C = []
            print_int(c[0].len())
            let d: D = Box(x: 1)
            print_int(d.x)
            let p: P = Pair[int64, int64](first: 1, second: 2)
            print_int(p.first)
            let q = Pair[P, int64](first: p, second: 1)
            let r: B? = none
            return 0
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "`Map` expects 2 type arguments, got 1")
    assert test_support.any_message_contains(errs, needle: "`Box` is not generic")
    assert test_support.any_message_contains(errs, needle: "generic struct `Pair` needs type arguments: write `Pair[A, B]`")
}

test "an unresolved alias isn't reported again where it's used" {
