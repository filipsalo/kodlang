// Native `kod` driver: `kod build|run|test|check`.
// The only build orchestrator. People start it as `./kod`, a link at the
// repository root to `build/apps/kod/kod`: started that way it first
// brings the toolchain up to date with `make` (`refresh_toolchain`). Started
// by its own path, as the tests and the test runner do, it doesn't.
//
// Pipeline:
//   1. Parse the entry, walk its imports transitively. Read what each
//      module declares in the comment lines at its top (`// kod:cc`,
//      `kod:link`, `kod:require`; docs/modules.md, "Link inputs"), and stop
//      at a mistake in them or a required file that is not there.
//   2. `sh_kodc _compile` each module to a .o, and compile each C file the
//      modules name (once, however many name it) with `CC` and `CFLAGS`.
//   3. `sh_kodc _emit-runtime-main` for the entry; `as` it to a .o.
//   4. Link everything together with the prebuilt stage0 .o set, with the
//      `LINK` command of link.cfg (`clang`), and the `kod:link` arguments
//      last.
//
// link.cfg (and link.local.cfg, which overrides single names on one
// machine) is read from the working directory: the Makefile includes the same
// file, so the compiler and every program are linked the same way. It also
// names the always-linked C files and Kod modules.
//
// `run` and `test` end by replacing this process with the program
// (`become`), so it has the terminal, its output streams as it is
// written and its exit status is what the shell sees. Nothing can run
// after it, so there is no driver epilogue and nothing to clean up.
//
// Assumes stage0 has been built (`make stage0`) and `build/stage1/sh_kodc`
// exists. Both are true after a normal `make stage1`. No incremental
// build today — every invocation does the full compile + link.
import "libc"
import "arrays"
import "io"
import "posix"
import "unsafe"
import "process"
import "kod/parsing"
import "kod/ast"
import "kod/build"
import "kod/formatting"
import "sort"

// A C file that modules of a program name, with the flags of the first
// `kod:cc` line that does, and where that line is (`path:line`).
type CcJob = shared struct {
    file: str
    flags: [str]
    origin: str
}

// A `kod:require` file and the line that asks for it.
type Need = struct {
    path: str
    line: int64
    file: str
    hint: str
}

// What the modules of a program declare, merged: the C files to compile,
// once each, the arguments for the link, in the order of the modules with a
// `-lname` once, and the files that must exist.
type LinkPlan = shared struct {
    jobs: [CcJob]
    link_args: [str]
    needs: [Need]
}

func main(argv: [str]) -> int64 {
    if len(argv) < 3 {
        return usage()
    }
    let cmd: str = argv[1]
    if cmd != "build" and cmd != "run" and cmd != "test" and cmd != "check" and cmd != "fmt" {
        return usage()
    }
    let refreshed = refresh_toolchain(argv)
    if refreshed >= 0 {
        return refreshed
    }
    // Formatting needs no build, so it runs anywhere.
    if cmd == "fmt" {
        return run_fmt(argv[2..len(argv)])
    }
    if require_repo_root() != 0 {
        return 1
    }
    let cfg: build.LinkVars = build.LinkVars(items: [])
    if not read_link_config(into: cfg) {
        return 1
    }
    if cmd != "check" and require_stage0_objects(cfg) != 0 {
        return 1
    }
    if cmd == "build" {
        let exe: str = build_executable(argv[2], :cfg)
        if len(exe) == 0 {
            return 1
        }
        return 0
    }
    if cmd == "run" {
        let exe: str = build_executable(argv[2], :cfg)
        if len(exe) == 0 {
            return 1
        }
        mut child_argv: [str] = [exe]
        for arg in argv[3..len(argv)] {
            child_argv += [arg]
        }
        return become(child_argv)
    }
    if cmd == "test" {
        return run_test(argv[2], :cfg)
    }
    return run_check_cmd(argv[2], stage0: stage0_modules(cfg), :cfg)
}

// The commands read `link.cfg` and run `build/stage1/sh_kodc`, both relative
// to the working directory: say so, rather than fail later with a tool that
// could not be run. Returns 0 in the repository root of a built tree.
func require_repo_root() -> int64 {
    if not io.is_file("link.cfg") {
        kod_eprint("kod: link.cfg not found; run kod from the repository root")
        return 1
    }
    if not io.is_file("build/stage1/sh_kodc") {
        kod_eprint("kod: build/stage1/sh_kodc not found; run make")
        return 1
    }
    return 0
}

extern func flock(anon fd: int64, anon operation: int64) -> int64
extern func mkdir(anon path: int64, anon mode: int64) -> int64

let LOCK_EX: int64 = 2
let EINTR: int64 = 4
// Set for the tool that `refresh_toolchain` has just rebuilt and replaced
// itself with, so that it doesn't look again; removed at once, so the
// programs it runs don't see it.
let FRESH_MARK: str = "KOD_TOOLCHAIN_FRESH"

// The repository root, the directory that holds `Makefile` and `kodc.kod`,
// when this process was started through the link `kod` there (`argv0` is
// `./kod` or another path to it); "" when it wasn't, as when started as
// `build/apps/kod/kod`, or through PATH (no `/`).
func launch_root(anon argv0: str) -> str {
    mut slash: int64 = -1
    for i in 0..len(argv0) {
        if argv0[i] == '/' {
            slash = i
        }
    }
    if slash < 0 {
        return ""
    }
    mut dir: str = argv0[0..slash]
    if slash == 0 {
        dir = "/"
    }
    if io.is_file(f"{dir}/Makefile") and io.is_file(f"{dir}/kodc.kod") {
        return dir
    }
    return ""
}

// The exit status from a raw wait status; 128 + the signal for one a signal
// ended.
func exit_status(anon raw: int64) -> int64 {
    let sig = raw & 127
    if sig == 0 {
        return (raw >> 8) & 255
    }
    return 128 + sig
}

// Run `argv` in `dir` with the environment `env` and wait for it: its exit
// status, or -1 when it could not be started. With `to_stderr`, what it
// writes to stdout goes to our stderr.
func run_make(anon argv: [str], dir: str, env: [str], to_stderr: bool) -> int64 {
    mut out: process.Stdio = .Inherit
    if to_stderr {
        out = .Pipe
    }
    let started = process.start(argv, stdout: out, :dir, :env)
    if started is Err(_) {
        return -1
    }
    let child = started
    if to_stderr {
        for true {
            let got = child.stdout.read(65536)
            if got is Err(_) {
                break
            }
            let data = got
            if len(data) == 0 {
                break
            }
            io.write_stderr(kod_bytes_to_str(data))
        }
        let _closed = child.stdout.close()
    }
    let raw = process.wait_status(child.pid, name: argv[0], hang: true)
    if raw is Err(_) {
        return 1
    }
    let status = raw
    return exit_status(status)
}

// Started through the link at the repository root (`./kod`), bring the
// toolchain up to date first, as `make -s stage1 kod` would: `sh_kodc`, the
// always-linked objects and this tool. Checking costs one `make -q`. A lock
// on `build/.toolchain.lock` keeps two of these from rebuilding at once; the
// rebuild's stdout goes to stderr, so a `kod run` program's output is its
// own. If something was rebuilt, the new tool takes this process's place
// with the same arguments. When `make` can't be run, nothing is checked.
// Returns -1 to carry on in this process, else the status to exit with: a
// failed rebuild's, or 127 when the new tool can't be executed.
func refresh_toolchain(anon argv: [str]) -> int64 {
    if len(_env(FRESH_MARK)) > 0 {
        libc.unsetenv(unsafe.c_str(FRESH_MARK))
        return -1
    }
    let root = launch_root(argv[0])
    if len(root) == 0 {
        return -1
    }
    // An outer `make test`'s flags aren't for us: -B would rebuild on every
    // call, -j print jobserver warnings, -i hide a failure.
    mut env: [str] = []
    for v in process.current_environment() {
        if not v.starts_with("MAKEFLAGS=") and not v.starts_with("MFLAGS=") and not v.starts_with("MAKELEVEL=") {
            env += [v]
        }
    }
    mkdir(unsafe.c_str(f"{root}/build"), 493)
    let lock_path = f"{root}/build/.toolchain.lock"
    let opened = posix.create(lock_path)
    if opened is Err(e) {
        kod_eprint(f"kod: cannot open {lock_path}: {e.to_str()}")
        return 1
    }
    let lock = opened
    for unsafe.c_int(flock(lock.fd, LOCK_EX)) != 0 {
        if unsafe.errno() != EINTR {
            kod_eprint(f"kod: cannot lock {lock_path}")
            let _ = lock.close()
            return 1
        }
    }
    let targets = ["stage1", "kod"]
    let fresh = run_make(["make", "-s", "-q"] + targets, dir: root, :env, to_stderr: false)
    if fresh <= 0 {
        // Up to date, or no `make`.
        let _ = lock.close()
        return -1
    }
    let status = run_make(["make", "-s"] + targets, dir: root, :env, to_stderr: true)
    let _ = lock.close()
    if status != 0 {
        kod_eprint("kod: failed to rebuild the toolchain")
        return status
    }
    libc.setenv(unsafe.c_str(FRESH_MARK), unsafe.c_str("1"), 1)
    mut again: [str] = [f"{root}/build/apps/kod/kod"]
    for arg in argv[1..len(argv)] {
        again += [arg]
    }
    return become(again)
}

// Read `link.cfg`, then `link.local.cfg` if there is one (it overrides single
// names), into `into`. Prints the first error and returns false. The names
// every build needs must be set.
func read_link_config(into: build.LinkVars) -> bool {
    let error = build.read_link_config(:into)
    if len(error) > 0 {
        kod_eprint(error)
        return false
    }
    return true
}

// `make` builds the always-linked objects, not the driver. Say so when the
// configuration names one that is not there (a module added to it since the
// last `make`), rather than let the link fail on it. Returns 0 when all are.
func require_stage0_objects(anon cfg: build.LinkVars) -> int64 {
    for o in stage0_objects(cfg) {
        if not io.is_file(o) {
            kod_eprint(f"kod: {o} not found; run make")
            return 1
        }
    }
    return 0
}

// The always-linked Kod modules (`STAGE0_KOD`), in link order. Each has a
// prebuilt `build/stage0/_<basename>.o`.
func stage0_modules(anon cfg: build.LinkVars) -> [str] {
    return build.split_words(build.link_value(cfg, name: "STAGE0_KOD"))
}

// Replace this process with `argv` (a path with a `/`, so no PATH search): the
// program is given our terminal, stdin, stdout and stderr, and its exit status
// or signal becomes the one the caller sees. Returns only if it can't be
// executed (127, as a shell says).
func become(anon argv: [str]) -> int64 {
    process.exec(argv)
    kod_eprint(f"kod: cannot execute {argv[0]}")
    return 127
}

func usage() -> int64 {
    kod_eprint("usage: kod build <file>")
    kod_eprint("       kod run <file> [args...]")
    kod_eprint("       kod test <file-or-dir>")
    kod_eprint("       kod check <file>")
    kod_eprint("       kod fmt [--check] <path>...")
    return 1
}

// Compile the entry and every transitive user import through sh_kodc,
// counting failures. No artifacts emitted — sh_kodc's asm goes to
// captured stdout and is discarded; stderr (the diagnostic) is
// forwarded so the user sees the error. The link directives at the top of
// the modules are checked too, but no C file is compiled and no `kod:require`
// file looked for. Exits 1 if any module failed, 0 otherwise. The pre-built
// stage0 modules are skipped (they were already typechecked when their .o
// was built).
func run_check_cmd(anon entry_path: str, stage0: [str], cfg: build.LinkVars) -> int64 {
    let modules: [str] = collect_user_modules(entry_path, :stage0)
    let sh_kodc: str = "build/stage1/sh_kodc"
    let plan: LinkPlan = LinkPlan(jobs: [], link_args: [], needs: [])
    mut errors: int64 = read_link_inputs(modules, :cfg, into: plan)
    mut shown: [str] = []
    for m in modules {
        let r: process.ProcessResult = process.run([sh_kodc, m] + modules)
        if r.status != 0 {
            // A failing importer's compile also shows its imports' errors.
            mut repeat = false
            for line in split_lines(r.stderr) {
                if line.contains(": error: ") {
                    repeat = arrays.contains(shown, line)
                    shown += [line]
                }
                if not repeat {
                    io.write_stderr(painted(line) + "\n")
                }
            }
            errors = errors + 1
        }
    }
    if errors > 0 {
        return 1
    }
    return 0
}

// The non-empty pieces of `s` between the bytes `sep`.
func split_at(anon s: str, sep: int64) -> [str] {
    mut result: [str] = []
    mut start: int64 = 0
    for i in 0..len(s) {
        if s[i] == sep {
            if i > start {
                result += [s[start..i]]
            }
            start = i + 1
        }
    }
    if start < len(s) {
        result += [s[start..len(s)]]
    }
    return result
}

func split_lines(anon s: str) -> [str] {
    return split_at(s, sep: '\n')
}

// `kod test <path>` — a `.kod` file is built as a single-module
// test executable; anything else is treated as a directory and
// walked recursively for `*_test.kod` files, which are built into one
// program. Either way the test binary then takes this process's place.
// The walk uses `find` to avoid a new io extern; results
// aren't sorted, since the test runner's `__run_tests` dispatchers
// don't care about order.
func run_test(anon path: str, cfg: build.LinkVars) -> int64 {
    if build.ends_with(path, suffix: ".kod") {
        return run_single_test(path, :cfg)
    }
    return run_dir_tests(path, :cfg)
}

func run_single_test(anon entry: str, cfg: build.LinkVars) -> int64 {
    let exe: str = build_test_executable(entry, :cfg)
    if len(exe) == 0 {
        return 1
    }
    return become([exe])
}

// The part of `path` below `dir`, as `find <dir>` printed it (`dir` itself
// first, then a `/`).
func below_dir(anon path: str, dir: str) -> str {
    if not build.starts_with(path, prefix: dir) {
        return path
    }
    mut start: int64 = len(dir)
    for start < len(path) and path[start] == '/' {
        start = start + 1
    }
    return path[start..len(path)]
}

// Is a file left out of `kod test <dir>` and `kod fmt <dir>`? One with a path
// component below `dir` that starts with `.` (worktrees under `.claude/`,
// editor files, scratch files such as `.kod_compile_test.kod`), or below a
// `build` directory directly in `dir`. (The tests' own finder skips the
// directories among these, not the files.)
func is_skipped_file(anon rel: str) -> bool {
    mut start: int64 = 0
    mut i: int64 = 0
    for i <= len(rel) {
        if i == len(rel) or rel[i] == '/' {
            if i > start and rel[start] == '.' {
                return true
            }
            if start == 0 and i < len(rel) and rel[0..i] == "build" {
                return true
            }
            start = i + 1
        }
        i = i + 1
    }
    return false
}

// The name of the program `kod test <dir>` builds: the directory with
// every byte outside letters, digits, `_` and `-` replaced by `_` (its
// last 200 bytes, so that the names derived from it fit a file name),
// then `_tests`.
func tests_stem(anon dir: str) -> str {
    mut stem: str = ""
    for i in 0..len(dir) {
        let c: int64 = dir[i]
        if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '-' {
            stem = stem + dir[i..i+1]
        } else {
            stem = stem + "_"
        }
    }
    if len(stem) > 200 {
        stem = stem[len(stem)-200..len(stem)]
    }
    return stem + "_tests"
}

func run_dir_tests(anon dir: str, cfg: build.LinkVars) -> int64 {
    // `find` takes an argument that starts with `-` for an option. Its paths
    // end at a NUL byte, not at a newline, which a file name can hold.
    mut root: str = dir
    if len(dir) > 0 and dir[0] == '-' {
        root = f"./{dir}"
    }
    let r: process.ProcessResult = process.run(["find", root, "!", "-type", "d", "-name", "*_test.kod", "-print0"])
    if r.status != 0 {
        io.write_stderr(r.stderr)
        return r.status
    }
    // `find` doesn't prune, so the paths to leave out are dropped here. A
    // directory named like a test file is not listed. Any other path that is
    // not a readable file (a dangling link) stops the run: a test that is
    // skipped without a word reads as one that passed.
    mut test_files: [str] = []
    for tf in split_at(r.stdout, sep: 0) {
        if not is_skipped_file(below_dir(tf, dir: root)) {
            if not io.is_file(tf) {
                kod_eprint(f"kod test: cannot read {tf}")
                return 1
            }
            test_files += [build.normalize_path(tf)]
        }
    }
    if len(test_files) == 0 {
        kod_eprint(f"kod test: no `*_test.kod` files under {dir}")
        return 1
    }
    // One program for all of them, so no temporary module is needed.
    let stem: str = tests_stem(dir)
    let exe: str = build_program(entries: test_files, app: stem, exe_name: f"{stem}_test", emit_main_cmd: "_emit-test-runtime-main", shim_kind: "testmain", :cfg)
    if len(exe) == 0 {
        return 1
    }
    return become([exe])
}

// `kod fmt [--check] <path>...` (docs/cli.md): formats each file, printing
// those that change, and with `--check` writes none and says 1 if any would.
// A file that doesn't parse is left alone and makes the status 1.
func run_fmt(anon args: [str]) -> int64 {
    mut check = false
    mut paths: [str] = []
    for a in args {
        if a == "--check" {
            check = true
        } else {
            paths += [a]
        }
    }
    if len(paths) == 0 {
        return usage()
    }
    mut files: [str] = []
    for p in paths {
        if io.is_file(p) {
            files += [p]
        } else {
            let found = kod_files_below(p)
            if found is none {
                return 1
            }
            files += found
        }
    }
    mut status: int64 = 0
    for f in files {
        let source = io.read_file(f)
        let formatted = formatting.format(source, path: f)
        if formatted is Err(e) {
            kod_eprint(e.to_str())
            status = 1
            continue
        }
        if formatted != source {
            print(f)
            if check {
                status = 1
            } else if io.write_file(f, formatted) != 0 {
                kod_eprint(f"kod fmt: cannot write {f}")
                status = 1
            }
        }
    }
    return status
}

// The `.kod` files below `dir`, sorted, but not those under a directory whose
// name starts with `.` or the top-level `build/`; none, after saying why, when
// `dir` is not a directory.
func kod_files_below(anon dir: str) -> [str]? {
    mut root: str = dir
    if len(dir) > 0 and dir[0] == '-' {
        root = f"./{dir}"
    }
    let r: process.ProcessResult = process.run(["find", root, "!", "-type", "d", "-name", "*.kod", "-print0"])
    if r.status != 0 {
        kod_eprint(f"kod fmt: no such file or directory: {dir}")
        return none
    }
    mut found: [str] = []
    for path in split_at(r.stdout, sep: 0) {
        if not is_skipped_file(below_dir(path, dir: root)) and io.is_file(path) {
            found += [build.normalize_path(path)]
        }
    }
    return sort.sorted(found)
}

// Walk the entry's import graph and return the full list of .kod
// files that need their own .o, in load order. The entry is the
// first element; the always-linked modules `stage0` (builtins, the
// primitives, io, process, time, ...) are *not* included — those already
// have prebuilt .o files under build/stage0/ and are added at link time.
func collect_user_modules(anon entry_path: str, stage0: [str]) -> [str] {
    let result = build.PathList(paths: [build.normalize_path(entry_path)])
    let p: parsing.Parser = build.parse_file(entry_path)
    let module: ast.Module = p.parse_module()
    add_runner_for(module, modules: result)
    walk_imports(module: module, importer_path: entry_path, :stage0, modules: result)
    // The runner, if a module brought it in, has imports of its own.
    let runner = "stdlib/testing.kod"
    if arrays.contains(result.paths, runner) {
        let rp: parsing.Parser = build.parse_file(runner)
        walk_imports(module: rp.parse_module(), importer_path: runner, :stage0, modules: result)
    }
    return result.paths
}

// A module's `test` blocks call the test runner, and every function is linked
// (the backtrace table keeps them all), so a program with one needs the runner
// even when it isn't a test program.
func add_runner_for(anon module: ast.Module, modules: build.PathList) -> none {
    if build.module_has_tests(module) and not arrays.contains(modules.paths, "stdlib/testing.kod") {
        modules.paths += ["stdlib/testing.kod"]
    }
}

func walk_imports(module: ast.Module, importer_path: str, stage0: [str], modules: build.PathList) -> none {
    for d in module.decls {
        match d {
            ast.Decl.Import(module_name, _local_name, _items) -> {
                if len(module_name) > 0 {
                    let resolved: build.Resolved = build.resolve_import(target_path: importer_path, :module_name)
                    // A missing file is reported by its importer's compile.
                    if not is_stage0(resolved.file, :stage0) and io.is_file(resolved.file) {
                        if not arrays.contains(modules.paths, resolved.file) {
                            modules.paths += [resolved.file]
                            let p: parsing.Parser = build.parse_file(resolved.file)
                            let im: ast.Module = p.parse_module()
                            add_runner_for(im, :modules)
                            walk_imports(module: im, importer_path: resolved.file, :stage0, :modules)
                        }
                    }
                }
            }
            else none
        }
    }
}

func is_stage0(anon path: str, stage0: [str]) -> bool {
    for s in stage0 {
        if s == path {
            return true
        }
    }
    return false
}

// Strip directory + `.kod` extension. `tests/hello.kod` → `hello`,
// `stdlib/primitives/int64.kod` → `int64`. Names the per-app output
// directory under `build/apps/<basename>/` and its executable; the
// stage0 objects `build/stage0/_<basename>.o` are named the same way.
func basename_no_ext(anon path: str) -> str {
    return basename_without(path, ext: ".kod")
}

// Strip directory + the extension `ext`, if the name has it.
func basename_without(anon path: str, ext: str) -> str {
    mut last_slash: int64 = -1
    for i in 0..len(path) {
        if path[i] == '/' {
            last_slash = i
        }
    }
    let after_slash: int64 = last_slash + 1
    mut end: int64 = len(path)
    // Strip the suffix if present.
    if end - after_slash >= len(ext) and path[end-len(ext)..end] == ext {
        end = end - len(ext)
    }
    return path[after_slash..end]
}

// -1 until `_colour` has looked, then 0 or 1.
mut _colour_known: int64 = -1
let BOLD: str = "\u{1b}[1m"
let RED: str = "\u{1b}[31m"
let RESET: str = "\u{1b}[0m"


// The SHA-256 of `data` as 64 lowercase hex digits, which names cached objects.
func _sha256_hex(anon data: str) -> str {
    // A CC_SHA256_CTX, then the digest.
    let ctx = unsafe.alloc(104 + 32)
    let digest = ctx + 104
    libc.CC_SHA256_Init(ctx)
    let start = unsafe.c_str(data)
    let n = len(data)
    mut at = 0
    // CommonCrypto takes a 32-bit length.
    for at < n {
        mut chunk = n - at
        if chunk > 0x40000000 {
            chunk = 0x40000000
        }
        libc.CC_SHA256_Update(ctx, start + at, chunk)
        at += chunk
    }
    libc.CC_SHA256_Final(digest, ctx)
    mut out = ""
    for i in 0..32 {
        out += f"{unsafe.load8(digest + i):02x}"
    }
    unsafe.free(ctx)
    return out
}

// An environment variable, or "" when it isn't set. The driver doesn't link
// stdlib/env.kod.
func _env(anon name: str) -> str {
    let value = libc.getenv(unsafe.c_str(name))
    if value == 0 {
        return ""
    }
    return unsafe.str_at(value)
}

// Whether errors are coloured: stderr is a terminal and colour isn't off, as
// stdlib/term.kod decides (the driver doesn't link it).
func _colour() -> bool {
    if _colour_known < 0 {
        _colour_known = 0
        let no_color = len(_env("NO_COLOR")) > 0
        if posix.stderr().is_terminal() and not no_color and _env("TERM") != "dumb" {
            _colour_known = 1
        }
    }
    return _colour_known == 1
}

// `line` coloured when errors are: in `path:line:col: error: message` the
// location and message bold and `error:` red, and a caret line red. Any other
// line as it is.
func painted(anon line: str) -> str {
    if not _colour() {
        return line
    }
    if line.contains(": error: ") {
        let k = line.find(": error: ")? or 0
        let head = line[0..k + 1]
        let message = line[k + 9..len(line)]
        return f"{BOLD}{head}{RESET} {BOLD}{RED}error:{RESET} {BOLD}{message}{RESET}"
    }
    mut caret = false
    for i in 0..len(line) {
        let b = line[i]
        if b == '^' {
            caret = true
        } else if b != ' ' {
            return line
        }
    }
    if caret {
        return f"{BOLD}{RED}{line}{RESET}"
    }
    return line
}

// A tool's stderr, each error line coloured when errors are.
func show_errors(anon text: str) -> none {
    if not _colour() {
        io.write_stderr(text)
        return
    }
    mut out: [str] = []
    for line in text.split("\n") {
        out += [painted(line)]
    }
    io.write_stderr("\n".join(out))
}

func eprint_error(anon line: str) -> none {
    kod_eprint(painted(line))
}

// Run a process, forwarding its stderr to ours when it fails so the
// user sees the underlying tool's diagnostic. Returns the exit
// status (0 on success).
func run_check(anon argv: [str]) -> int64 {
    let r: process.ProcessResult = process.run(argv)
    if r.status != 0 {
        show_errors(r.stderr)
    }
    if r.status == -1 {
        // It never ran, or was killed: it has said nothing.
        kod_eprint(f"kod: {argv[0]} could not be run (not found, killed, or its argument list too long)")
    }
    return r.status
}

// What names a module's object in `build/cache/` (docs/cli.md, step 3): the
// compiler, the module's path, and the path and text of each module its
// compile loads. One per build, so each file is read and parsed once.
type ObjectKeys = shared struct {
    // `sh_kodc`'s hash, then a line per `STAGE0_KOD` module.
    base: str
    stage0: [str]
    hashes: Map[str, str] = Map[str, str]()
    // The modules each one loads itself: its imports, and the runner if it has tests.
    loads: Map[str, [str]] = Map[str, [str]]()

    func hash(self, anon path: str) -> str {
        if self.hashes.get(path) is Some(h) {
            return h
        }
        let h = _sha256_hex(io.read_file(path))
        self.hashes.set(path, h)
        return h
    }

    func direct(self, anon path: str) -> [str] {
        if self.loads.get(path) is Some(known) {
            return known
        }
        let out = build.PathList()
        let module: ast.Module = build.parse_file(path).parse_module()
        add_runner_for(module, modules: out)
        for d in module.decls {
            if d is .Import(module_name, _local_name, _items) and len(module_name) > 0 {
                let file = build.resolve_import(target_path: path, :module_name).file
                if not is_stage0(file, stage0: self.stage0) and not arrays.contains(out.paths, file) {
                    out.paths += [file]
                }
            }
        }
        self.loads.set(path, out.paths)
        return out.paths
    }

    // `path`'s key, or "" for none: a module outside the project (an absolute
    // path, as a test's scratch file has, which would only fill the cache), or
    // one that loads a missing module (its compile says so).
    func key(self, anon path: str) -> str {
        if path.starts_with("/") {
            return ""
        }
        mut seen: [str] = [path]
        mut i = 0
        for i < len(seen) {
            if not io.is_file(seen[i]) {
                return ""
            }
            for next in self.direct(seen[i]) {
                if not arrays.contains(seen, next) {
                    seen += [next]
                }
            }
            i += 1
        }
        mut text = self.base
        for m in seen {
            text += f"{m} {self.hash(m)}\n"
        }
        return _sha256_hex(text)
    }
}

func object_keys(anon sh_kodc: str, stage0: [str]) -> ObjectKeys {
    let keys = ObjectKeys(base: "", :stage0)
    mut base = f"sh_kodc {keys.hash(sh_kodc)}\n"
    for m in stage0 {
        base += f"{m} {keys.hash(m)}\n"
    }
    keys.base = base
    return keys
}

// Copy the file at `from` to `to`; false if it can't be read or written.
func copy_file(anon from: str, to: str) -> bool {
    let data = io.read_file(from)
    return (len(data) > 0 or io.is_file(from)) and io.write_file(to, data) == 0
}

// Build an executable from `entries` and everything they import. `app`
// names the directory `build/apps/<app>/` that holds it and its objects,
// `exe_name` is the file dropped into it; `emit_main_cmd` is the
// sh_kodc subcommand that emits the runtime_main shim asm, and
// `shim_kind` (`main` or `testmain`) names the shim's files. Two
// callers: `build_executable` uses `_emit-runtime-main` (plain main
// shim, one entry), `build_test_executable` and `run_dir_tests` use
// `_emit-test-runtime-main` (the dispatcher that calls every module's
// `__run_tests` then prints the aggregate summary). The objects go to
// `build/apps/<app>/<app>.obj/`, in a tree that mirrors the source
// tree: a module's `<path>.o`, the object of a C file a module names
// (`<path>.c.o`). The C files are compiled on every build, as the modules
// are. `cfg` is the link configuration. Returns the executable path on
// success, "" on failure (the underlying tool already printed via
// `run_check`).
func build_program(entries: [str], app: str, exe_name: str, emit_main_cmd: str, shim_kind: str, cfg: build.LinkVars) -> str {
    if app == "" or app == "." or app == ".." {
        kod_eprint(f"kod: cannot name a program after {entries[0]}; rename the file")
        return ""
    }
    // A test program links the test runner, which its `_main` and every
    // module's `__run_tests` call.
    mut runner: [str] = []
    if shim_kind == "testmain" and not arrays.contains(entries, "stdlib/testing.kod") {
        runner = ["stdlib/testing.kod"]
    }
    let program_entries: [str] = entries + runner
    let app_dir: str = f"build/apps/{app}"
    let obj_root: str = f"{app_dir}/{app}.obj"
    let exe_path: str = f"{app_dir}/{exe_name}"
    let sh_kodc: str = "build/stage1/sh_kodc"

    // 1. User modules: the entries + transitive imports (skipping
    //    stage0), each to the object named after its source path.
    let stage0: [str] = stage0_modules(cfg)
    mut user_modules: [str] = []
    for entry in program_entries {
        for m in collect_user_modules(entry, :stage0) {
            if not arrays.contains(user_modules, m) {
                user_modules += [m]
            }
        }
    }
    // What the modules declare for the link; a mistake there, or a required
    // file that is not there, stops the build before anything is made.
    let plan: LinkPlan = LinkPlan(jobs: [], link_args: [], needs: [])
    if not plan_link_inputs(user_modules, :cfg, into: plan) {
        return ""
    }
    // The object of a C file goes beside the object of the module that names
    // it, so these are all the directories there are.
    mut c_objs: [str] = []
    for job in plan.jobs {
        c_objs += [build.obj_path(root: obj_root, source: job.file)]
    }
    mut obj_dirs: [str] = [obj_root]
    for m in user_modules {
        let dir: str = build.dirname(build.obj_path(root: obj_root, source: m))
        let bare_dir: str = dir[0..len(dir)-1]
        if not arrays.contains(obj_dirs, bare_dir) {
            obj_dirs += [bare_dir]
        }
    }
    mut mkdir_argv: [str] = ["mkdir", "-p"]
    for d in obj_dirs {
        mkdir_argv += [d]
    }
    if run_check(mkdir_argv) != 0 {
        return ""
    }
    // A module compiled before, in any program, comes from `build/cache/`.
    let keys = object_keys(sh_kodc, :stage0)
    let cache_dir = "build/cache"
    mut user_objs: [str] = []
    for m in user_modules {
        let obj: str = build.obj_path(root: obj_root, source: m)
        user_objs += [obj]
        let key = keys.key(m)
        let cached = f"{cache_dir}/{key}.o"
        if len(key) > 0 and io.is_file(cached) and copy_file(cached, to: obj) {
            // Its `.s` would be from an older compile.
            let asm = obj[0..len(obj) - 2] + ".s"
            if io.is_file(asm) {
                process.run(["rm", "-f", asm])
            }
            continue
        }
        let rc: int64 = run_check([sh_kodc, "_compile", m, obj] + user_modules)
        if rc != 0 {
            return ""
        }
        // Written beside it and renamed, so a build running alongside sees all of it or none.
        if len(key) > 0 {
            let tmp = f"{cached}.{app}.tmp"
            if process.run(["mkdir", "-p", cache_dir]).status == 0 and copy_file(obj, to: tmp) {
                process.run(["mv", "-f", tmp, cached])
            }
        }
    }
    // The C files the modules name.
    for job in plan.jobs {
        if not compile_c(job, :obj_root, :cfg) {
            return ""
        }
    }

    // 2. Runtime main shim — variant selected by `emit_main_cmd`, next
    //    to the first entry's object.
    let entry_obj: str = user_objs[0]
    let shim_base: str = entry_obj[0..len(entry_obj)-2]
    let main_s: str = f"{shim_base}.{shim_kind}.s"
    let main_o: str = f"{shim_base}.{shim_kind}.o"
    mut shim_argv: [str] = [sh_kodc, emit_main_cmd, program_entries[0], main_s]
    for more in program_entries[1..len(program_entries)] {
        shim_argv += [more]
    }
    let rc_main: int64 = run_check(shim_argv)
    if rc_main != 0 {
        return ""
    }
    let as_error = build.assemble(cfg, asm_path: main_s, obj_path: main_o)
    if len(as_error) > 0 {
        kod_eprint(as_error)
        return ""
    }

    // 3. Link: the program's objects, those of its C files and its shim,
    //    after the always-linked set that `make stage0` keeps fresh, and
    //    the arguments the modules give last.
    mut inputs: [str] = []
    for o in user_objs {
        inputs += [o]
    }
    for o in c_objs {
        inputs += [o]
    }
    inputs += [main_o]
    let rc_link: int64 = run_check(link_argv(cfg, :exe_path, objs: inputs, args: plan.link_args))
    if rc_link != 0 {
        return ""
    }
    return exe_path
}

// The objects every program links first, in link order: one per `RUNTIME_C`
// file (`build/stage0/<name>.o`) and one per `STAGE0_KOD` module
// (`build/stage0/_<basename>.o`), named as the Makefile names them. We don't
// try to rebuild them here; `make stage0` does.
func stage0_objects(anon cfg: build.LinkVars) -> [str] {
    mut objs: [str] = []
    for c in build.split_words(build.link_value(cfg, name: "RUNTIME_C")) {
        let name: str = basename_without(c, ext: ".c")
        objs += [f"build/stage0/{name}.o"]
    }
    for m in stage0_modules(cfg) {
        let name: str = basename_no_ext(m)
        objs += [f"build/stage0/_{name}.o"]
    }
    return objs
}

// The command that links `exe_path`: the `LINK` words, `-o exe_path`, the
// always-linked objects, then `objs`, the program's own in link order, and
// the arguments `args` that its modules ask for.
func link_argv(anon cfg: build.LinkVars, exe_path: str, objs: [str], args: [str]) -> [str] {
    mut argv: [str] = []
    for w in build.split_words(build.link_value(cfg, name: "LINK")) {
        argv += [w]
    }
    argv += ["-o", exe_path]
    for o in stage0_objects(cfg) {
        argv += [o]
    }
    for o in objs {
        argv += [o]
    }
    for a in args {
        argv += [a]
    }
    return argv
}

// Compile the C file of `job` to its object in the tree under `obj_root`,
// with `CC` and `CFLAGS` of the link configuration and then the flags of its
// `kod:cc` line. Always, since the modules are compiled on every build too and
// a C file is small. On failure the compiler has said why; false.
func compile_c(anon job: CcJob, obj_root: str, cfg: build.LinkVars) -> bool {
    mut argv: [str] = build.split_words(build.link_value(cfg, name: "CC"))
    if len(argv) == 0 {
        kod_eprint("kod: link.cfg and link.local.cfg set no CC")
        return false
    }
    for w in build.split_words(build.link_value(cfg, name: "CFLAGS")) {
        argv += [w]
    }
    for w in job.flags {
        argv += [w]
    }
    // The compiler takes a name that starts with `-` for an option (`-x.c` is
    // `-x .c`); in the root of the project the path is the bare name.
    mut source: str = job.file
    if source[0] == '-' {
        source = f"./{source}"
    }
    argv += ["-c", "-o", build.obj_path(root: obj_root, source: job.file), source]
    if run_check(argv) != 0 {
        kod_eprint(f"kod: compiling {job.file} failed")
        return false
    }
    return true
}

// An always-linked module cannot declare link inputs: make builds it without
// reading them, so they would be ignored and the link would fail for every
// program. Say so (`path:line:1: error: ...`); how many modules there are.
func reject_stage0_decls(anon cfg: build.LinkVars) -> int64 {
    mut rejected: int64 = 0
    for m in stage0_modules(cfg) {
        if io.is_file(m) {
            let decls: build.LinkDecls = build.parse_link_decls(path: m, source: io.read_file(m), vars: cfg)
            if decls.first > 0 {
                eprint_error(f"{m}:{decls.first}:1: error: a module in STAGE0_KOD cannot declare link inputs; make builds it without reading them")
                rejected = rejected + 1
            }
        }
    }
    return rejected
}

// Add the C file of `c`, declared by `module`, to the jobs of `plan`: once
// per file, however many modules name it, but only with the same flags. 1 if
// that is an error (printed), else 0.
func add_cc_job(anon c: build.CcDecl, module: str, plan: LinkPlan) -> int64 {
    let origin: str = f"{module}:{c.line}"
    for job in plan.jobs {
        if job.file == c.file {
            if arrays.equal(job.flags, c.flags) {
                return 0
            }
            eprint_error(f"{origin}:1: error: {c.file} is also compiled by the kod:cc line at {job.origin}, with other flags")
            return 1
        }
    }
    plan.jobs += [CcJob(file: c.file, flags: c.flags, :origin)]
    return 0
}

// Add the `kod:link` arguments `args` to `plan`, in order, but a `-lname`
// that is there already only once.
func add_link_args(anon args: [str], plan: LinkPlan) -> none {
    for a in args {
        let library: bool = len(a) > 2 and build.starts_with(a, prefix: "-l")
        if not library or not arrays.contains(plan.link_args, a) {
            plan.link_args += [a]
        }
    }
}

// Read what `modules` declare in the comment lines at their top into `into`,
// printing each mistake, and return how many there were: a directive that is
// wrong, a C file that is not there, one named with other flags by two modules,
// and a module in `STAGE0_KOD` that has directives at all.
func read_link_inputs(anon modules: [str], cfg: build.LinkVars, into: LinkPlan) -> int64 {
    mut errors: int64 = reject_stage0_decls(cfg)
    for m in modules {
        let decls: build.LinkDecls = build.parse_link_decls(path: m, source: io.read_file(m), vars: cfg)
        for e in decls.errors {
            eprint_error(e)
            errors = errors + 1
        }
        for c in decls.cc {
            if io.is_file(c.file) {
                errors = errors + add_cc_job(c, module: m, plan: into)
            } else {
                eprint_error(f"{m}:{c.line}:1: error: no such file {c.file}")
                errors = errors + 1
            }
        }
        add_link_args(decls.link, plan: into)
        for r in decls.require {
            into.needs += [Need(path: m, line: r.line, file: r.file, hint: r.hint)]
        }
    }
    return errors
}

// Print each file that a `kod:require` line asks for and that is not there;
// how many.
func missing_needs(anon plan: LinkPlan) -> int64 {
    mut missing: int64 = 0
    for n in plan.needs {
        if not io.is_file(n.file) {
            if len(n.hint) > 0 {
                eprint_error(f"{n.path}:{n.line}:1: error: needs {n.file} ({n.hint})")
            } else {
                eprint_error(f"{n.path}:{n.line}:1: error: needs {n.file}")
            }
            missing = missing + 1
        }
    }
    return missing
}

// What the modules declare, in `into`; false, with the reasons printed, if
// that has a mistake or a file that a `kod:require` line asks for is missing.
func plan_link_inputs(anon modules: [str], cfg: build.LinkVars, into: LinkPlan) -> bool {
    if read_link_inputs(modules, :cfg, :into) > 0 {
        return false
    }
    return missing_needs(into) == 0
}

// Are `a` and `b` one file or directory, whatever they are spelled like?
// (An absolute path, a link, another case on a volume that ignores case.)
func same_file(anon a: str, anon b: str) -> bool {
    let r: process.ProcessResult = process.run(["test", a, "-ef", b])
    return r.status == 0
}

// Would a program in `build/apps/<app>/` be written over the tool `tool`
// (`build/apps/kod/kod`, `build/apps/lsp/lsp`)? `make` would go on calling
// the tool up to date. It would if `app` is its name, or another name for
// its directory.
func names_tool(app: str, tool: str) -> bool {
    return app == tool or same_file(f"build/apps/{app}", f"build/apps/{tool}")
}

// An entry that would write its executable over the tool `kod` or `lsp` is
// refused. Only the tools' own sources, in any spelling, may do that.
func refuse_tool_names(app: str, entry: str) -> bool {
    if names_tool(:app, tool: "kod") and not same_file(entry, "tools/kod.kod") {
        kod_eprint(f"kod: an entry named {app} would replace the build tool")
        return true
    }
    if names_tool(:app, tool: "lsp") and not same_file(entry, "tools/lsp.kod") {
        kod_eprint(f"kod: an entry named {app} would replace the language server")
        return true
    }
    return false
}

func build_executable(anon entry_path: str, cfg: build.LinkVars) -> str {
    let stem: str = basename_no_ext(entry_path)
    if refuse_tool_names(app: stem, entry: entry_path) {
        return ""
    }
    return build_program(entries: [entry_path], app: stem, exe_name: stem, emit_main_cmd: "_emit-runtime-main", shim_kind: "main", :cfg)
}

func build_test_executable(anon entry_path: str, cfg: build.LinkVars) -> str {
    let stem: str = basename_no_ext(entry_path)
    return build_program(entries: [entry_path], app: stem, exe_name: f"{stem}_test", emit_main_cmd: "_emit-test-runtime-main", shim_kind: "testmain", :cfg)
}
