// String ==, != and string patterns in match check the lengths inline before
// comparing bytes: equal lengths with different bytes, different lengths,
// the empty string, and a literal with an escape and a multi-byte character.

func kind(anon s: str) -> str {
    match s {
        "" -> return "empty"
        "é\n" -> return "accent"
        "abc" -> return "abc"
        "abd" -> return "abd"
        else -> return "other"
    }
}

func main() -> int64 {
    let a = "abc"
    let b = "ab" + "c"
    let e = ""
    print(f"{a == b} {a != b} {a == "abd"} {a != "abd"} {a == "ab"} {e == ""} {e != ""} {a < "abd"} {"b" > a}")
    print(f"{kind("")} {kind("é\n")} {kind("abc")} {kind("abd")} {kind("ab")} {kind("é")}")
    mut n: int64 = 0
    for w in ["x", "", "abc", "abcd"] {
        match w {
            "" -> n += 1
            "abc" -> n += 10
            else -> n += 100
        }
    }
    print(n)
    return 0
}

// expected output:
// true false false true false true false true true
// empty accent abc abd other other
// 211
// expected status:
// 0
