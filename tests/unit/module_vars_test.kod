// Module-level variables: worked out once at first use, shared by every function,
// read from other modules, assigned only in their own.
import "./../module_vars_dep"
import "./../module_vars_dep" { hits }

type Mode = enum {
    Fast
    Safe
}

type Point = shared struct {
    x: int64
    y: int64
}

mut counter: int64 = 0
mut total: float64 = 0.5
mut label: str = "start"
mut items: [int64] = [1, 2]
mut seen: Map[str, int64] = Map[str, int64]()
mut origin: Point = Point(x: 1, y: 2)
mut mode: Mode = Mode.Fast
mut last: str? = none
mut ready: bool = false
mut order: [str] = []

// Initializers run at first use, in that order, whatever order they're declared in.
mut first: int64 = note("first", value: second + 1)
mut second: int64 = note("second", value: 10)

func add_one(anon n: int64) -> int64 {
    return n + 1
}

// A constant or variable that holds a function is called like one.
let STEP: func(int64) -> int64 = add_one
mut step: func(int64) -> int64 = add_one

func note(anon what: str, value: int64) -> int64 {
    order += [what]
    return value
}

func bump() -> int64 {
    counter += 1
    return counter
}

func remember(anon key: str) -> none {
    seen.set(key, len(seen))
    last = key
}

test "variables assigned in their own module" {
    bump()
    bump()
    assert bump() == 3
    total = total * 3.0
    assert f"{total}" == "1.5"
    label = label + "-" + "end"
    assert label == "start-end"
    items += [3]
    items[0] = 10
    assert items == [10, 2, 3]
    remember("a")
    remember("b")
    assert (seen.get("b")? or -1) == 1
    assert (last? or "none") == "b"
    origin.x = 5
    origin = Point(x: origin.x, y: 9)
    assert origin.x == 5
    assert origin.y == 9
    mode = .Safe
    assert str(mode is .Safe) == "true"
    ready = not ready
    assert str(ready) == "true"
}

test "initializers run at first use" {
    assert first == 11
    assert order == ["second", "first"]
}

test "another module's variables" {
    module_vars_dep.hit("x")
    assert module_vars_dep.hit("y") == 2
    assert hits == 2
    assert module_vars_dep.reset_hits() == 0
    assert module_vars_dep.hits == 0
    assert module_vars_dep.names == ["x", "y"]
    assert module_vars_dep.announced == 0
    assert module_vars_dep.greeting == "hello"
    assert module_vars_dep.announced == 1
    assert module_vars_dep.greeting == "hello"
    assert module_vars_dep.announced == 1
    module_vars_dep.set_secret("shown")
    assert module_vars_dep.secret() == "shown"
}

test "variables holding functions" {
    assert STEP(1) + step(2) == 5
    let offset = 100
    step = func(n: int64) -> int64 { return n + offset }
    assert step(2) == 102
    assert module_vars_dep.transform(5) == 10
    module_vars_dep.use_square()
    assert module_vars_dep.transform(5) == 25
}

test "a local hides the variable" {
    let counter = 100
    assert counter == 100
}
