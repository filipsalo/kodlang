// Arithmetic on big non-negative numbers modulo an odd modulus, for RSA and
// ECDSA (crypto/rsa, crypto/ecdsa).
//
// A number is an array of 64-bit limbs, the lowest first, as long as its
// modulus's. A limb is an int64 holding the word's bits: the arithmetic is
// unsigned, with wrapping_add and wrapping_mul, mul_high for the top half of
// a product, and carries and borrows worked out from the sign bits.
// Multiplication is Montgomery's.
//
// `from_bytes`, `to_bytes` and the arithmetic of a `Modulus` (mul, add, sub,
// pow_secret, and pow with a public exponent) do the same steps whatever the
// numbers are, so signing can use them on a private key; `compare`,
// `is_zero`, `bit_length` and `number` look at the values, and are for public
// ones.

let BITS: int64 = 64
let TOP: int64 = 1 << 63

// The limbs a number of `size` bytes takes.
func limbs(anon size: int64) -> int64 {
    return (size + 7) / 8
}

// The carry out of s = a + b (wrapping): 1 or 0.
func carry_of(anon a: int64, anon b: int64, anon s: int64) -> int64 {
    return ((a & b) | ((a | b) & (s ^ -1))) >> 63
}

// The borrow out of d = a - b (wrapping): 1 or 0.
func borrow_of(anon a: int64, anon b: int64, anon d: int64) -> int64 {
    let na = a ^ -1
    return ((na & b) | ((na | b) & d)) >> 63
}

// The number `b` holds, big-endian, in `k` limbs, or none when it needs more.
func from_bytes(anon b: bytes, k: int64) -> [int64]? {
    mut out = [0] * k
    // The bytes that would go above the top limb.
    mut over = 0
    for i in 0..len(b) {
        let at = len(b) - 1 - i
        let limb = i / 8
        if limb < k {
            out[limb] = out[limb] | (b[at] << (8 * (i % 8)))
        } else {
            over = over | b[at]
        }
    }
    if over != 0 {
        return none
    }
    return out
}

// `x` as `size` big-endian bytes; its high bits beyond those are dropped.
func to_bytes(anon x: [int64], size: int64) -> bytes {
    mut out = [0] * size
    for i in 0..size {
        let limb = i / 8
        if limb < len(x) {
            out[size - 1 - i] = (x[limb] >> (8 * (i % 8))) & 255
        }
    }
    return kod_bytes_from_array(out)
}

// -1, 0 or 1 as `a` is below, equal to or above `b` (of one length).
func compare(anon a: [int64], anon b: [int64]) -> int64 {
    for i in len(a) - 1..=0 step -1 {
        if a[i] != b[i] {
            return if (a[i] ^ TOP) < (b[i] ^ TOP) { -1 } else { 1 }
        }
    }
    return 0
}

func is_zero(anon a: [int64]) -> bool {
    for x in a {
        if x != 0 {
            return false
        }
    }
    return true
}

// a - b, for a >= b.
func sub(anon a: [int64], anon b: [int64]) -> [int64] {
    let (out, _borrow) = sub_borrow(a, b)
    return out
}

// a - b mod 2^(64 k), and 1 when that borrowed (a < b), else 0.
func sub_borrow(anon a: [int64], anon b: [int64]) -> ([int64], int64) {
    mut out = a
    mut borrow = 0
    for i in 0..len(a) {
        let x = a[i]
        let d = x.wrapping_sub(b[i])
        let d2 = d.wrapping_sub(borrow)
        borrow = borrow_of(x, b[i], d) | borrow_of(d, borrow, d2)
        out[i] = d2
    }
    return (out, borrow)
}

// x where `take_x` is 1, y where it is 0, by masks.
func choose(anon take_x: int64, anon x: [int64], anon y: [int64]) -> [int64] {
    let mask = 0 - take_x
    let keep = mask ^ -1
    mut out = y
    for i in 0..len(x) {
        out[i] = (x[i] & mask) | (y[i] & keep)
    }
    return out
}

// a + b and the carry out of the top limb.
func add_carry(anon a: [int64], anon b: [int64]) -> ([int64], int64) {
    mut out = a
    mut carry = 0
    for i in 0..len(a) {
        let x = a[i]
        let s = x.wrapping_add(b[i])
        let s2 = s.wrapping_add(carry)
        carry = carry_of(x, b[i], s) | carry_of(s, carry, s2)
        out[i] = s2
    }
    return (out, carry)
}

// The number of bits up to the highest one bit.
func bit_length(anon a: [int64]) -> int64 {
    for i in len(a) - 1..=0 step -1 {
        if a[i] != 0 {
            return i * BITS + 64 - a[i].leading_zeros()
        }
    }
    return 0
}

func bit(anon a: [int64], anon i: int64) -> int64 {
    return (a[i / BITS] >> (i % BITS)) & 1
}

// An odd modulus and what Montgomery multiplication by it needs. Numbers
// "in the Montgomery form" are x * R mod m, R = 2^(64 k).
type Modulus = struct {
    m: [int64]
    k: int64
    // -1 / m mod 2^64.
    m_inv: int64
    // R^2 mod m, to bring a number into the form.
    r2: [int64]

    func init(anon m: bytes) -> Modulus {
        let k = limbs(len(m))
        let ms = must from_bytes(m, k: k)
        if ms[0] & 1 == 0 {
            panic("bignum: the modulus is even")
        }
        // Newton's iteration doubles the bits that are right each time.
        mut inv = 1
        for _i in 0..6 {
            inv = inv.wrapping_mul(2.wrapping_sub(ms[0].wrapping_mul(inv)))
        }
        // R mod m, which is 1 in the form: 2^L - m for m of L bits, then
        // doubled up to 2^(64 k).
        let size = bit_length(ms)
        mut top = [0] * k
        mut one = top
        if size < BITS * k {
            top[size / BITS] = 1 << (size % BITS)
            one = sub(top, ms)
        } else {
            // 2^(64 k) - m, taken as its two's complement within k limbs.
            let (minus, _b) = sub_borrow(top, ms)
            one = minus
        }
        let base = Modulus(m: ms, k: k, m_inv: 0 - inv, r2: [])
        for _i in size..BITS * k {
            one = base.add(one, one)
        }
        // R^2 is R in the form: 2 in the form, raised to 64 k.
        let two = base.add(one, one)
        mut r = one
        let e = BITS * k
        for i in 63 - e.leading_zeros()..=0 step -1 {
            r = base.mul(r, r)
            if (e >> i) & 1 == 1 {
                r = base.mul(r, two)
            }
        }
        return Modulus(m: ms, k: k, m_inv: 0 - inv, r2: r)
    }

    // a * b / R mod m, for a and b below m.
    func mul(self, anon a: [int64], anon b: [int64]) -> [int64] {
        if self.k == 4 {
            return self.mul4(a, b)
        }
        return self.mul_loop(a, b)
    }

    // `mul` for any number of limbs.
    func mul_loop(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let k = self.k
        let m = self.m
        let m_inv = self.m_inv
        // All ones, for the carries: kept in a register rather than made each time.
        let ones = -1
        mut t = [0] * (k + 2)
        for i in 0..k {
            let bi = b[i]
            // t += a bi.
            mut carry = 0
            for j in 0..k {
                let aj = a[j]
                let lo = aj.wrapping_mul(bi)
                let hi = aj.mul_high(bi)
                let tj = t[j]
                let s = tj.wrapping_add(lo)
                let s2 = s.wrapping_add(carry)
                // Both carries can be 1, when `carry` is large.
                // Both carries can be 1, when the one coming in is large.
                let c = (((tj & lo) | ((tj | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
                t[j] = s2
                carry = hi.wrapping_add(c)
            }
            let tk = t[k]
            let top = tk.wrapping_add(carry)
            t[k] = top
            t[k + 1] = ((tk & carry) | ((tk | carry) & (top ^ ones))) >> 63
            // Add u m, which makes the lowest limb 0, and shift it out.
            let u = t[0].wrapping_mul(m_inv)
            let t0 = t[0]
            let lo0 = u.wrapping_mul(m[0])
            let s0 = t0.wrapping_add(lo0)
            carry = u.mul_high(m[0]).wrapping_add(((t0 & lo0) | ((t0 | lo0) & (s0 ^ ones))) >> 63)
            for j in 1..k {
                let mj = m[j]
                let lo = u.wrapping_mul(mj)
                let hi = u.mul_high(mj)
                let tj = t[j]
                let s = tj.wrapping_add(lo)
                let s2 = s.wrapping_add(carry)
                // Both carries can be 1, when `carry` is large.
                // Both carries can be 1, when the one coming in is large.
                let c = (((tj & lo) | ((tj | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
                t[j - 1] = s2
                carry = hi.wrapping_add(c)
            }
            let tk2 = t[k]
            let last = tk2.wrapping_add(carry)
            t[k - 1] = last
            t[k] = t[k + 1] + (((tk2 & carry) | ((tk2 | carry) & (last ^ ones))) >> 63)
        }
        // Below 2m: take m off unless that borrows (and nothing is above).
        let out = t[..k]
        let (less, borrow) = sub_borrow(out, m)
        return choose(t[k] | (borrow ^ 1), less, out)
    }

    // `mul` for 4 limbs, its loops written out: no array but the result. (For
    // 6, written out the same way, it spilled registers and was slower than
    // the loops.)
    func mul4(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let ones = -1
        let m_inv = self.m_inv
        let a0 = a[0]
        let a1 = a[1]
        let a2 = a[2]
        let a3 = a[3]
        let m0 = self.m[0]
        let m1 = self.m[1]
        let m2 = self.m[2]
        let m3 = self.m[3]
        mut t0 = 0
        mut t1 = 0
        mut t2 = 0
        mut t3 = 0
        mut t4 = 0
        mut t5 = 0
        mut carry = 0
        mut lo = 0
        mut s = 0
        mut s2 = 0
        mut c = 0
        // Row 0: t += a b[0], then t + u m, shifted down a limb.
        let b0 = b[0]
        carry = 0
        lo = a0.wrapping_mul(b0)
        s = t0.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t0 & lo) | ((t0 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t0 = s2
        let hi1 = a0.mul_high(b0)
        carry = hi1.wrapping_add(c)
        lo = a1.wrapping_mul(b0)
        s = t1.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t1 & lo) | ((t1 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t1 = s2
        let hi2 = a1.mul_high(b0)
        carry = hi2.wrapping_add(c)
        lo = a2.wrapping_mul(b0)
        s = t2.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t2 & lo) | ((t2 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t2 = s2
        let hi3 = a2.mul_high(b0)
        carry = hi3.wrapping_add(c)
        lo = a3.wrapping_mul(b0)
        s = t3.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t3 & lo) | ((t3 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t3 = s2
        let hi4 = a3.mul_high(b0)
        carry = hi4.wrapping_add(c)
        s = t4.wrapping_add(carry)
        t5 = (((t4 & carry) | ((t4 | carry) & (s ^ ones))) >> 63)
        t4 = s
        let u0 = t0.wrapping_mul(m_inv)
        lo = u0.wrapping_mul(m0)
        s = t0.wrapping_add(lo)
        let hi5 = u0.mul_high(m0)
        carry = hi5.wrapping_add((((t0 & lo) | ((t0 | lo) & (s ^ ones))) >> 63))
        lo = u0.wrapping_mul(m1)
        s = t1.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t1 & lo) | ((t1 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t0 = s2
        let hi6 = u0.mul_high(m1)
        carry = hi6.wrapping_add(c)
        lo = u0.wrapping_mul(m2)
        s = t2.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t2 & lo) | ((t2 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t1 = s2
        let hi7 = u0.mul_high(m2)
        carry = hi7.wrapping_add(c)
        lo = u0.wrapping_mul(m3)
        s = t3.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t3 & lo) | ((t3 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t2 = s2
        let hi8 = u0.mul_high(m3)
        carry = hi8.wrapping_add(c)
        s = t4.wrapping_add(carry)
        t3 = s
        t4 = t5 + (((t4 & carry) | ((t4 | carry) & (s ^ ones))) >> 63)
        // Row 1: t += a b[1], then t + u m, shifted down a limb.
        let b1 = b[1]
        carry = 0
        lo = a0.wrapping_mul(b1)
        s = t0.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t0 & lo) | ((t0 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t0 = s2
        let hi9 = a0.mul_high(b1)
        carry = hi9.wrapping_add(c)
        lo = a1.wrapping_mul(b1)
        s = t1.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t1 & lo) | ((t1 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t1 = s2
        let hi10 = a1.mul_high(b1)
        carry = hi10.wrapping_add(c)
        lo = a2.wrapping_mul(b1)
        s = t2.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t2 & lo) | ((t2 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t2 = s2
        let hi11 = a2.mul_high(b1)
        carry = hi11.wrapping_add(c)
        lo = a3.wrapping_mul(b1)
        s = t3.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t3 & lo) | ((t3 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t3 = s2
        let hi12 = a3.mul_high(b1)
        carry = hi12.wrapping_add(c)
        s = t4.wrapping_add(carry)
        t5 = (((t4 & carry) | ((t4 | carry) & (s ^ ones))) >> 63)
        t4 = s
        let u1 = t0.wrapping_mul(m_inv)
        lo = u1.wrapping_mul(m0)
        s = t0.wrapping_add(lo)
        let hi13 = u1.mul_high(m0)
        carry = hi13.wrapping_add((((t0 & lo) | ((t0 | lo) & (s ^ ones))) >> 63))
        lo = u1.wrapping_mul(m1)
        s = t1.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t1 & lo) | ((t1 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t0 = s2
        let hi14 = u1.mul_high(m1)
        carry = hi14.wrapping_add(c)
        lo = u1.wrapping_mul(m2)
        s = t2.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t2 & lo) | ((t2 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t1 = s2
        let hi15 = u1.mul_high(m2)
        carry = hi15.wrapping_add(c)
        lo = u1.wrapping_mul(m3)
        s = t3.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t3 & lo) | ((t3 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t2 = s2
        let hi16 = u1.mul_high(m3)
        carry = hi16.wrapping_add(c)
        s = t4.wrapping_add(carry)
        t3 = s
        t4 = t5 + (((t4 & carry) | ((t4 | carry) & (s ^ ones))) >> 63)
        // Row 2: t += a b[2], then t + u m, shifted down a limb.
        let b2 = b[2]
        carry = 0
        lo = a0.wrapping_mul(b2)
        s = t0.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t0 & lo) | ((t0 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t0 = s2
        let hi17 = a0.mul_high(b2)
        carry = hi17.wrapping_add(c)
        lo = a1.wrapping_mul(b2)
        s = t1.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t1 & lo) | ((t1 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t1 = s2
        let hi18 = a1.mul_high(b2)
        carry = hi18.wrapping_add(c)
        lo = a2.wrapping_mul(b2)
        s = t2.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t2 & lo) | ((t2 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t2 = s2
        let hi19 = a2.mul_high(b2)
        carry = hi19.wrapping_add(c)
        lo = a3.wrapping_mul(b2)
        s = t3.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t3 & lo) | ((t3 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t3 = s2
        let hi20 = a3.mul_high(b2)
        carry = hi20.wrapping_add(c)
        s = t4.wrapping_add(carry)
        t5 = (((t4 & carry) | ((t4 | carry) & (s ^ ones))) >> 63)
        t4 = s
        let u2 = t0.wrapping_mul(m_inv)
        lo = u2.wrapping_mul(m0)
        s = t0.wrapping_add(lo)
        let hi21 = u2.mul_high(m0)
        carry = hi21.wrapping_add((((t0 & lo) | ((t0 | lo) & (s ^ ones))) >> 63))
        lo = u2.wrapping_mul(m1)
        s = t1.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t1 & lo) | ((t1 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t0 = s2
        let hi22 = u2.mul_high(m1)
        carry = hi22.wrapping_add(c)
        lo = u2.wrapping_mul(m2)
        s = t2.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t2 & lo) | ((t2 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t1 = s2
        let hi23 = u2.mul_high(m2)
        carry = hi23.wrapping_add(c)
        lo = u2.wrapping_mul(m3)
        s = t3.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t3 & lo) | ((t3 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t2 = s2
        let hi24 = u2.mul_high(m3)
        carry = hi24.wrapping_add(c)
        s = t4.wrapping_add(carry)
        t3 = s
        t4 = t5 + (((t4 & carry) | ((t4 | carry) & (s ^ ones))) >> 63)
        // Row 3: t += a b[3], then t + u m, shifted down a limb.
        let b3 = b[3]
        carry = 0
        lo = a0.wrapping_mul(b3)
        s = t0.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t0 & lo) | ((t0 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t0 = s2
        let hi25 = a0.mul_high(b3)
        carry = hi25.wrapping_add(c)
        lo = a1.wrapping_mul(b3)
        s = t1.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t1 & lo) | ((t1 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t1 = s2
        let hi26 = a1.mul_high(b3)
        carry = hi26.wrapping_add(c)
        lo = a2.wrapping_mul(b3)
        s = t2.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t2 & lo) | ((t2 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t2 = s2
        let hi27 = a2.mul_high(b3)
        carry = hi27.wrapping_add(c)
        lo = a3.wrapping_mul(b3)
        s = t3.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t3 & lo) | ((t3 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t3 = s2
        let hi28 = a3.mul_high(b3)
        carry = hi28.wrapping_add(c)
        s = t4.wrapping_add(carry)
        t5 = (((t4 & carry) | ((t4 | carry) & (s ^ ones))) >> 63)
        t4 = s
        let u3 = t0.wrapping_mul(m_inv)
        lo = u3.wrapping_mul(m0)
        s = t0.wrapping_add(lo)
        let hi29 = u3.mul_high(m0)
        carry = hi29.wrapping_add((((t0 & lo) | ((t0 | lo) & (s ^ ones))) >> 63))
        lo = u3.wrapping_mul(m1)
        s = t1.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t1 & lo) | ((t1 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t0 = s2
        let hi30 = u3.mul_high(m1)
        carry = hi30.wrapping_add(c)
        lo = u3.wrapping_mul(m2)
        s = t2.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t2 & lo) | ((t2 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t1 = s2
        let hi31 = u3.mul_high(m2)
        carry = hi31.wrapping_add(c)
        lo = u3.wrapping_mul(m3)
        s = t3.wrapping_add(lo)
        s2 = s.wrapping_add(carry)
        c = (((t3 & lo) | ((t3 | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
        t2 = s2
        let hi32 = u3.mul_high(m3)
        carry = hi32.wrapping_add(c)
        s = t4.wrapping_add(carry)
        t3 = s
        t4 = t5 + (((t4 & carry) | ((t4 | carry) & (s ^ ones))) >> 63)
        // Below 2m: take m off unless that borrows (and nothing is above).
        mut borrow = 0
        let d0 = t0.wrapping_sub(m0)
        let e0 = d0.wrapping_sub(borrow)
        borrow = ((((t0 ^ ones) & m0) | (((t0 ^ ones) | m0) & d0)) >> 63) | ((((d0 ^ ones) & borrow) | (((d0 ^ ones) | borrow) & e0)) >> 63)
        let d1 = t1.wrapping_sub(m1)
        let e1 = d1.wrapping_sub(borrow)
        borrow = ((((t1 ^ ones) & m1) | (((t1 ^ ones) | m1) & d1)) >> 63) | ((((d1 ^ ones) & borrow) | (((d1 ^ ones) | borrow) & e1)) >> 63)
        let d2 = t2.wrapping_sub(m2)
        let e2 = d2.wrapping_sub(borrow)
        borrow = ((((t2 ^ ones) & m2) | (((t2 ^ ones) | m2) & d2)) >> 63) | ((((d2 ^ ones) & borrow) | (((d2 ^ ones) | borrow) & e2)) >> 63)
        let d3 = t3.wrapping_sub(m3)
        let e3 = d3.wrapping_sub(borrow)
        borrow = ((((t3 ^ ones) & m3) | (((t3 ^ ones) | m3) & d3)) >> 63) | ((((d3 ^ ones) & borrow) | (((d3 ^ ones) | borrow) & e3)) >> 63)
        let take = 0 - (t4 | (borrow ^ 1))
        let keep = take ^ ones
        return [(e0 & take) | (t0 & keep), (e1 & take) | (t1 & keep), (e2 & take) | (t2 & keep), (e3 & take) | (t3 & keep)]
    }

    // `add` for 4 limbs, written out.
    func add4(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let ones = -1
        mut carry = 0
        let x0 = a[0]
        let y0 = b[0]
        let s0 = x0.wrapping_add(y0)
        let r0 = s0.wrapping_add(carry)
        carry = (((x0 & y0) | ((x0 | y0) & (s0 ^ ones))) >> 63) | (((s0 & carry) | ((s0 | carry) & (r0 ^ ones))) >> 63)
        let x1 = a[1]
        let y1 = b[1]
        let s1 = x1.wrapping_add(y1)
        let r1 = s1.wrapping_add(carry)
        carry = (((x1 & y1) | ((x1 | y1) & (s1 ^ ones))) >> 63) | (((s1 & carry) | ((s1 | carry) & (r1 ^ ones))) >> 63)
        let x2 = a[2]
        let y2 = b[2]
        let s2 = x2.wrapping_add(y2)
        let r2 = s2.wrapping_add(carry)
        carry = (((x2 & y2) | ((x2 | y2) & (s2 ^ ones))) >> 63) | (((s2 & carry) | ((s2 | carry) & (r2 ^ ones))) >> 63)
        let x3 = a[3]
        let y3 = b[3]
        let s3 = x3.wrapping_add(y3)
        let r3 = s3.wrapping_add(carry)
        carry = (((x3 & y3) | ((x3 | y3) & (s3 ^ ones))) >> 63) | (((s3 & carry) | ((s3 | carry) & (r3 ^ ones))) >> 63)
        mut borrow = 0
        let m0 = self.m[0]
        let d0 = r0.wrapping_sub(m0)
        let e0 = d0.wrapping_sub(borrow)
        borrow = ((((r0 ^ ones) & m0) | (((r0 ^ ones) | m0) & d0)) >> 63) | ((((d0 ^ ones) & borrow) | (((d0 ^ ones) | borrow) & e0)) >> 63)
        let m1 = self.m[1]
        let d1 = r1.wrapping_sub(m1)
        let e1 = d1.wrapping_sub(borrow)
        borrow = ((((r1 ^ ones) & m1) | (((r1 ^ ones) | m1) & d1)) >> 63) | ((((d1 ^ ones) & borrow) | (((d1 ^ ones) | borrow) & e1)) >> 63)
        let m2 = self.m[2]
        let d2 = r2.wrapping_sub(m2)
        let e2 = d2.wrapping_sub(borrow)
        borrow = ((((r2 ^ ones) & m2) | (((r2 ^ ones) | m2) & d2)) >> 63) | ((((d2 ^ ones) & borrow) | (((d2 ^ ones) | borrow) & e2)) >> 63)
        let m3 = self.m[3]
        let d3 = r3.wrapping_sub(m3)
        let e3 = d3.wrapping_sub(borrow)
        borrow = ((((r3 ^ ones) & m3) | (((r3 ^ ones) | m3) & d3)) >> 63) | ((((d3 ^ ones) & borrow) | (((d3 ^ ones) | borrow) & e3)) >> 63)
        let take = 0 - (carry | (borrow ^ 1))
        let keep = take ^ ones
        return [(e0 & take) | (r0 & keep), (e1 & take) | (r1 & keep), (e2 & take) | (r2 & keep), (e3 & take) | (r3 & keep)]
    }

    // `sub` for 4 limbs, written out.
    func sub4(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let ones = -1
        mut borrow = 0
        let x0 = a[0]
        let y0 = b[0]
        let d0 = x0.wrapping_sub(y0)
        let r0 = d0.wrapping_sub(borrow)
        borrow = ((((x0 ^ ones) & y0) | (((x0 ^ ones) | y0) & d0)) >> 63) | ((((d0 ^ ones) & borrow) | (((d0 ^ ones) | borrow) & r0)) >> 63)
        let x1 = a[1]
        let y1 = b[1]
        let d1 = x1.wrapping_sub(y1)
        let r1 = d1.wrapping_sub(borrow)
        borrow = ((((x1 ^ ones) & y1) | (((x1 ^ ones) | y1) & d1)) >> 63) | ((((d1 ^ ones) & borrow) | (((d1 ^ ones) | borrow) & r1)) >> 63)
        let x2 = a[2]
        let y2 = b[2]
        let d2 = x2.wrapping_sub(y2)
        let r2 = d2.wrapping_sub(borrow)
        borrow = ((((x2 ^ ones) & y2) | (((x2 ^ ones) | y2) & d2)) >> 63) | ((((d2 ^ ones) & borrow) | (((d2 ^ ones) | borrow) & r2)) >> 63)
        let x3 = a[3]
        let y3 = b[3]
        let d3 = x3.wrapping_sub(y3)
        let r3 = d3.wrapping_sub(borrow)
        borrow = ((((x3 ^ ones) & y3) | (((x3 ^ ones) | y3) & d3)) >> 63) | ((((d3 ^ ones) & borrow) | (((d3 ^ ones) | borrow) & r3)) >> 63)
        // Below 0 it wrapped by 2^(64 k); adding m (where it borrowed) gives a - b + m.
        let mask = 0 - borrow
        mut carry = 0
        let m0 = self.m[0] & mask
        let s0 = r0.wrapping_add(m0)
        let q0 = s0.wrapping_add(carry)
        carry = (((r0 & m0) | ((r0 | m0) & (s0 ^ ones))) >> 63) | (((s0 & carry) | ((s0 | carry) & (q0 ^ ones))) >> 63)
        let m1 = self.m[1] & mask
        let s1 = r1.wrapping_add(m1)
        let q1 = s1.wrapping_add(carry)
        carry = (((r1 & m1) | ((r1 | m1) & (s1 ^ ones))) >> 63) | (((s1 & carry) | ((s1 | carry) & (q1 ^ ones))) >> 63)
        let m2 = self.m[2] & mask
        let s2 = r2.wrapping_add(m2)
        let q2 = s2.wrapping_add(carry)
        carry = (((r2 & m2) | ((r2 | m2) & (s2 ^ ones))) >> 63) | (((s2 & carry) | ((s2 | carry) & (q2 ^ ones))) >> 63)
        let m3 = self.m[3] & mask
        let s3 = r3.wrapping_add(m3)
        let q3 = s3.wrapping_add(carry)
        carry = (((r3 & m3) | ((r3 | m3) & (s3 ^ ones))) >> 63) | (((s3 & carry) | ((s3 | carry) & (q3 ^ ones))) >> 63)
        return [q0, q1, q2, q3]
    }

    // `add` for 6 limbs, written out.
    func add6(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let ones = -1
        mut carry = 0
        let x0 = a[0]
        let y0 = b[0]
        let s0 = x0.wrapping_add(y0)
        let r0 = s0.wrapping_add(carry)
        carry = (((x0 & y0) | ((x0 | y0) & (s0 ^ ones))) >> 63) | (((s0 & carry) | ((s0 | carry) & (r0 ^ ones))) >> 63)
        let x1 = a[1]
        let y1 = b[1]
        let s1 = x1.wrapping_add(y1)
        let r1 = s1.wrapping_add(carry)
        carry = (((x1 & y1) | ((x1 | y1) & (s1 ^ ones))) >> 63) | (((s1 & carry) | ((s1 | carry) & (r1 ^ ones))) >> 63)
        let x2 = a[2]
        let y2 = b[2]
        let s2 = x2.wrapping_add(y2)
        let r2 = s2.wrapping_add(carry)
        carry = (((x2 & y2) | ((x2 | y2) & (s2 ^ ones))) >> 63) | (((s2 & carry) | ((s2 | carry) & (r2 ^ ones))) >> 63)
        let x3 = a[3]
        let y3 = b[3]
        let s3 = x3.wrapping_add(y3)
        let r3 = s3.wrapping_add(carry)
        carry = (((x3 & y3) | ((x3 | y3) & (s3 ^ ones))) >> 63) | (((s3 & carry) | ((s3 | carry) & (r3 ^ ones))) >> 63)
        let x4 = a[4]
        let y4 = b[4]
        let s4 = x4.wrapping_add(y4)
        let r4 = s4.wrapping_add(carry)
        carry = (((x4 & y4) | ((x4 | y4) & (s4 ^ ones))) >> 63) | (((s4 & carry) | ((s4 | carry) & (r4 ^ ones))) >> 63)
        let x5 = a[5]
        let y5 = b[5]
        let s5 = x5.wrapping_add(y5)
        let r5 = s5.wrapping_add(carry)
        carry = (((x5 & y5) | ((x5 | y5) & (s5 ^ ones))) >> 63) | (((s5 & carry) | ((s5 | carry) & (r5 ^ ones))) >> 63)
        mut borrow = 0
        let m0 = self.m[0]
        let d0 = r0.wrapping_sub(m0)
        let e0 = d0.wrapping_sub(borrow)
        borrow = ((((r0 ^ ones) & m0) | (((r0 ^ ones) | m0) & d0)) >> 63) | ((((d0 ^ ones) & borrow) | (((d0 ^ ones) | borrow) & e0)) >> 63)
        let m1 = self.m[1]
        let d1 = r1.wrapping_sub(m1)
        let e1 = d1.wrapping_sub(borrow)
        borrow = ((((r1 ^ ones) & m1) | (((r1 ^ ones) | m1) & d1)) >> 63) | ((((d1 ^ ones) & borrow) | (((d1 ^ ones) | borrow) & e1)) >> 63)
        let m2 = self.m[2]
        let d2 = r2.wrapping_sub(m2)
        let e2 = d2.wrapping_sub(borrow)
        borrow = ((((r2 ^ ones) & m2) | (((r2 ^ ones) | m2) & d2)) >> 63) | ((((d2 ^ ones) & borrow) | (((d2 ^ ones) | borrow) & e2)) >> 63)
        let m3 = self.m[3]
        let d3 = r3.wrapping_sub(m3)
        let e3 = d3.wrapping_sub(borrow)
        borrow = ((((r3 ^ ones) & m3) | (((r3 ^ ones) | m3) & d3)) >> 63) | ((((d3 ^ ones) & borrow) | (((d3 ^ ones) | borrow) & e3)) >> 63)
        let m4 = self.m[4]
        let d4 = r4.wrapping_sub(m4)
        let e4 = d4.wrapping_sub(borrow)
        borrow = ((((r4 ^ ones) & m4) | (((r4 ^ ones) | m4) & d4)) >> 63) | ((((d4 ^ ones) & borrow) | (((d4 ^ ones) | borrow) & e4)) >> 63)
        let m5 = self.m[5]
        let d5 = r5.wrapping_sub(m5)
        let e5 = d5.wrapping_sub(borrow)
        borrow = ((((r5 ^ ones) & m5) | (((r5 ^ ones) | m5) & d5)) >> 63) | ((((d5 ^ ones) & borrow) | (((d5 ^ ones) | borrow) & e5)) >> 63)
        let take = 0 - (carry | (borrow ^ 1))
        let keep = take ^ ones
        return [(e0 & take) | (r0 & keep), (e1 & take) | (r1 & keep), (e2 & take) | (r2 & keep), (e3 & take) | (r3 & keep), (e4 & take) | (r4 & keep), (e5 & take) | (r5 & keep)]
    }

    // `sub` for 6 limbs, written out.
    func sub6(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let ones = -1
        mut borrow = 0
        let x0 = a[0]
        let y0 = b[0]
        let d0 = x0.wrapping_sub(y0)
        let r0 = d0.wrapping_sub(borrow)
        borrow = ((((x0 ^ ones) & y0) | (((x0 ^ ones) | y0) & d0)) >> 63) | ((((d0 ^ ones) & borrow) | (((d0 ^ ones) | borrow) & r0)) >> 63)
        let x1 = a[1]
        let y1 = b[1]
        let d1 = x1.wrapping_sub(y1)
        let r1 = d1.wrapping_sub(borrow)
        borrow = ((((x1 ^ ones) & y1) | (((x1 ^ ones) | y1) & d1)) >> 63) | ((((d1 ^ ones) & borrow) | (((d1 ^ ones) | borrow) & r1)) >> 63)
        let x2 = a[2]
        let y2 = b[2]
        let d2 = x2.wrapping_sub(y2)
        let r2 = d2.wrapping_sub(borrow)
        borrow = ((((x2 ^ ones) & y2) | (((x2 ^ ones) | y2) & d2)) >> 63) | ((((d2 ^ ones) & borrow) | (((d2 ^ ones) | borrow) & r2)) >> 63)
        let x3 = a[3]
        let y3 = b[3]
        let d3 = x3.wrapping_sub(y3)
        let r3 = d3.wrapping_sub(borrow)
        borrow = ((((x3 ^ ones) & y3) | (((x3 ^ ones) | y3) & d3)) >> 63) | ((((d3 ^ ones) & borrow) | (((d3 ^ ones) | borrow) & r3)) >> 63)
        let x4 = a[4]
        let y4 = b[4]
        let d4 = x4.wrapping_sub(y4)
        let r4 = d4.wrapping_sub(borrow)
        borrow = ((((x4 ^ ones) & y4) | (((x4 ^ ones) | y4) & d4)) >> 63) | ((((d4 ^ ones) & borrow) | (((d4 ^ ones) | borrow) & r4)) >> 63)
        let x5 = a[5]
        let y5 = b[5]
        let d5 = x5.wrapping_sub(y5)
        let r5 = d5.wrapping_sub(borrow)
        borrow = ((((x5 ^ ones) & y5) | (((x5 ^ ones) | y5) & d5)) >> 63) | ((((d5 ^ ones) & borrow) | (((d5 ^ ones) | borrow) & r5)) >> 63)
        // Below 0 it wrapped by 2^(64 k); adding m (where it borrowed) gives a - b + m.
        let mask = 0 - borrow
        mut carry = 0
        let m0 = self.m[0] & mask
        let s0 = r0.wrapping_add(m0)
        let q0 = s0.wrapping_add(carry)
        carry = (((r0 & m0) | ((r0 | m0) & (s0 ^ ones))) >> 63) | (((s0 & carry) | ((s0 | carry) & (q0 ^ ones))) >> 63)
        let m1 = self.m[1] & mask
        let s1 = r1.wrapping_add(m1)
        let q1 = s1.wrapping_add(carry)
        carry = (((r1 & m1) | ((r1 | m1) & (s1 ^ ones))) >> 63) | (((s1 & carry) | ((s1 | carry) & (q1 ^ ones))) >> 63)
        let m2 = self.m[2] & mask
        let s2 = r2.wrapping_add(m2)
        let q2 = s2.wrapping_add(carry)
        carry = (((r2 & m2) | ((r2 | m2) & (s2 ^ ones))) >> 63) | (((s2 & carry) | ((s2 | carry) & (q2 ^ ones))) >> 63)
        let m3 = self.m[3] & mask
        let s3 = r3.wrapping_add(m3)
        let q3 = s3.wrapping_add(carry)
        carry = (((r3 & m3) | ((r3 | m3) & (s3 ^ ones))) >> 63) | (((s3 & carry) | ((s3 | carry) & (q3 ^ ones))) >> 63)
        let m4 = self.m[4] & mask
        let s4 = r4.wrapping_add(m4)
        let q4 = s4.wrapping_add(carry)
        carry = (((r4 & m4) | ((r4 | m4) & (s4 ^ ones))) >> 63) | (((s4 & carry) | ((s4 | carry) & (q4 ^ ones))) >> 63)
        let m5 = self.m[5] & mask
        let s5 = r5.wrapping_add(m5)
        let q5 = s5.wrapping_add(carry)
        carry = (((r5 & m5) | ((r5 | m5) & (s5 ^ ones))) >> 63) | (((s5 & carry) | ((s5 | carry) & (q5 ^ ones))) >> 63)
        return [q0, q1, q2, q3, q4, q5]
    }

    func to_mont(self, anon a: [int64]) -> [int64] {
        return self.mul(a, self.r2)
    }

    func from_mont(self, anon a: [int64]) -> [int64] {
        mut one = [0] * self.k
        one[0] = 1
        return self.mul(a, one)
    }

    // 1 in the Montgomery form.
    func one(self) -> [int64] {
        mut one = [0] * self.k
        one[0] = 1
        return self.to_mont(one)
    }

    func add(self, anon a: [int64], anon b: [int64]) -> [int64] {
        if self.k == 4 {
            return self.add4(a, b)
        }
        if self.k == 6 {
            return self.add6(a, b)
        }
        return self.add_loop(a, b)
    }

    func add_loop(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let (sum, carry) = add_carry(a, b)
        let (less, borrow) = sub_borrow(sum, self.m)
        return choose(carry | (borrow ^ 1), less, sum)
    }

    func sub(self, anon a: [int64], anon b: [int64]) -> [int64] {
        if self.k == 4 {
            return self.sub4(a, b)
        }
        if self.k == 6 {
            return self.sub6(a, b)
        }
        return self.sub_loop(a, b)
    }

    func sub_loop(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let (diff, borrow) = sub_borrow(a, b)
        // Below 0 it wrapped by 2^(64 k); adding m and wrapping again gives a - b + m.
        let (plus, _carry) = add_carry(diff, self.m)
        return choose(borrow, plus, diff)
    }

    // base^e (base in the form, e an ordinary number of any length), in the form.
    func pow(self, anon base: [int64], anon e: [int64]) -> [int64] {
        mut r = self.one()
        for i in bit_length(e) - 1..=0 step -1 {
            r = self.mul(r, r)
            if bit(e, i) == 1 {
                r = self.mul(r, base)
            }
        }
        return r
    }

    // base^e (base in the form), in the form, for a secret `e` of at most
    // `bits` bits: 4 bits at a time, each a squaring four times and a
    // multiplication by the table's entry for them, which every entry is
    // looked at to pick. The steps are the same for every e.
    func pow_secret(self, anon base: [int64], anon e: [int64], bits: int64) -> [int64] {
        mut table = [self.one(), base]
        for i in 2..16 {
            table += [self.mul(table[i - 1], base)]
        }
        mut r = self.one()
        let digits = (bits + 3) / 4
        for d in digits - 1..=0 step -1 {
            for _s in 0..4 {
                r = self.mul(r, r)
            }
            mut digit = 0
            for b in 0..4 {
                let at = 4 * d + b
                if at < len(e) * BITS {
                    digit = digit | (bit(e, at) << b)
                }
            }
            mut pick = table[0]
            for j in 1..16 {
                pick = choose(((digit ^ j) - 1) >> 63, table[j], pick)
            }
            r = self.mul(r, pick)
        }
        return r
    }

    // `x`, of up to 2 k limbs (below R^2), mod m in the form: x's low and
    // high halves are each below R, which a multiplication by R^2 takes.
    func reduce_wide(self, anon x: [int64]) -> [int64] {
        let k = self.k
        mut low = [0] * k
        mut high = [0] * k
        for i in 0..min(len(x), 2 * k) {
            if i < k {
                low[i] = x[i]
            } else {
                high[i - k] = x[i]
            }
        }
        // low R / R * R^2 and high R^2 / R * R^2 / R: low and high R, in the form.
        let lo = self.mul(low, self.r2)
        let hi = self.mul(self.mul(high, self.r2), self.r2)
        return self.add(lo, hi)
    }

    // 1 / a mod m for a prime m (a in the form), by Fermat: a^(m - 2).
    func inverse(self, anon a: [int64]) -> [int64] {
        mut two = [0] * self.k
        two[0] = 2
        return self.pow(a, sub(self.m, two))
    }

    // `b`, big-endian and below m, as a number, or none when it is m or more.
    func number(self, anon b: bytes) -> [int64]? {
        let Some(x) = from_bytes(b, k: self.k) else { return none }
        if compare(x, self.m) >= 0 {
            return none
        }
        return x
    }

    // The bytes of m's length.
    func byte_size(self) -> int64 {
        return (bit_length(self.m) + 7) / 8
    }
}

// a b, as len(a) + len(b) limbs.
func mul_plain(anon a: [int64], anon b: [int64]) -> [int64] {
    mut out = [0] * (len(a) + len(b))
    for i in 0..len(a) {
        let ai = a[i]
        mut carry = 0
        for j in 0..len(b) {
            let lo = ai.wrapping_mul(b[j])
            let hi = ai.mul_high(b[j])
            let o = out[i + j]
            let s = o.wrapping_add(lo)
            let s2 = s.wrapping_add(carry)
            out[i + j] = s2
            carry = hi.wrapping_add(carry_of(o, lo, s) + carry_of(s, carry, s2))
        }
        out[i + len(b)] = carry
    }
    return out
}

// a + b, as long as the longer and one more limb.
func add_plain(anon a: [int64], anon b: [int64]) -> [int64] {
    let n = max(len(a), len(b)) + 1
    mut out = [0] * n
    mut carry = 0
    for i in 0..n {
        let x = if i < len(a) { a[i] } else { 0 }
        let y = if i < len(b) { b[i] } else { 0 }
        let s = x.wrapping_add(y)
        let s2 = s.wrapping_add(carry)
        out[i] = s2
        carry = carry_of(x, y, s) | carry_of(s, carry, s2)
    }
    return out
}
