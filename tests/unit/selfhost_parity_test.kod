// Exercises the statement lowering the compiler's own sources lean on
// (if/else chains, both `for` forms with break/continue, field / index /
// compound assignment, slices, string ==, and/or, match statements and
// expressions, let-else, enum payloads, generic structs).

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
    Empty
}

type Box[T] = shared struct {
    item: T
}

type Counter = shared struct {
    hits: int64
    misses: int64
}

func area(anon s: Shape) -> int64 {
    return match s {
        Shape.Circle(r) -> 3 * r * r
        Shape.Rect(w, h) -> w * h
        else 0
    }
}

func perimeter(anon s: Shape) -> int64 {
    match s {
        Shape.Rect(w, h) -> return 2 * (w + h)
        else -> return 0
    }
    return -1
}

func size_name(anon n: int64) -> str {
    return match n {
        0 -> "none"
        1 -> "one"
        else "many"
    }
}

func first_rect_width(anon shapes: [Shape]) -> int64 {
    for s in shapes {
        let .Rect(w, _h) = s else {
            continue
        }
        return w
    }
    return -1
}

test "match statements, expressions and let-else" {
    let shapes: [Shape] = [Shape.Circle(r: 2), Shape.Empty, Shape.Rect(w: 3, h: 4)]
    mut total: int64 = 0
    for s in shapes {
        total += area(s)
    }
    assert total == 24
    assert first_rect_width(shapes) == 3
    assert perimeter(shapes[2]) == 14
    assert size_name(len(shapes)) == "many"
    assert size_name(1) == "one"
}

test "index and compound assignment, break and continue" {
    mut xs: [int64] = [5, 1, 4]
    xs[1] = 9
    xs += [7]
    mut i: int64 = 0
    mut evens: int64 = 0
    for i < len(xs) {
        i = i + 1
        if xs[i - 1] % 2 == 1 {
            continue
        }
        evens = evens + 1
    }
    assert evens == 1
    mut seen: [int64] = []
    for x in xs {
        if x > 8 {
            break
        }
        seen += [x]
    }
    assert seen == [5]
}

test "field assignment, and/or and if/else chains" {
    let c: Counter = Counter(hits: 0, misses: 0)
    let words: [str] = ["alpha", "beta", "alpha"]
    for word in words {
        if word == "alpha" and len(word) > 2 {
            c.hits = c.hits + 1
        } else if word == "gamma" or len(word) == 0 {
            c.misses = c.misses + 10
        } else {
            c.misses = c.misses + 1
        }
    }
    assert c.hits == 2
    assert c.misses == 1
}

test "slices and generic structs" {
    let name: str = "kodlang"
    assert name[0..3] == "kod"
    let b: Box[str] = Box[str](item: name[3..7])
    assert b.item == "lang"
}
