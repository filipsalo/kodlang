// The smallest int64 has no positive counterpart, so its digits can't
// come from negating it first.
test "the smallest int64 to text" {
    let max = 9223372036854775807
    let min = 0 - max - 1
    assert f"{min}" == "-9223372036854775808"
    assert str(min) == "-9223372036854775808"
    assert min.to_str() == "-9223372036854775808"
    assert f"{min + 1}" == "-9223372036854775807"
    assert f"{max}" == "9223372036854775807"
    assert f"{0 - 10}" == "-10"
    assert f"{0 - 7}" == "-7"
}

test "literals of the smallest int64" {
    let max = 9223372036854775807
    let min = 0 - max - 1
    assert f"{-9223372036854775808}" == "-9223372036854775808"
    assert f"{- 9223372036854775808}" == "-9223372036854775808"
    assert f"{-0x8000000000000000 + 1}" == "-9223372036854775807"
    assert min - -9223372036854775808 == 0
    assert -9223372036854775808 == min
}
