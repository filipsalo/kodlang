// Type patterns on a `T or Error` test the success value; `Error(e)` is `Err(e)`.

type NotFound = shared struct {
    path: str

    func to_str(self) -> str {
        return f"missing {self.path}"
    }
}

interface Shape {
    func area(self) -> int64
}

type Sq = shared struct {
    side: int64

    func area(self) -> int64 {
        return self.side * self.side
    }
}

type Id = int64 | str

func parse(anon s: str) -> int64 | str | bool or Error {
    if s == "" {
        throw NotFound(path: "empty")
    }
    if s == "yes" {
        return true
    }
    if s[0] >= '0' and s[0] <= '9' {
        return s.parse_int()? or 0
    }
    return s
}

func describe(anon s: str) -> str {
    match parse(s) {
        int64(n) -> return f"int {n}"
        str(t) -> return f"str {t}"
        bool(b) -> return f"bool {b}"
        Error(e) -> return f"error {e.to_str()}"
    }
}

func ids(anon s: str) -> str {
    match parse(s) {
        Id(id) -> return f"id {id}"
        Err(NotFound(nf)) -> return f"not found {nf.path}"
        else -> return "other"
    }
}

func shape(anon n: int64) -> Shape or Error {
    if n < 0 {
        throw NotFound(path: "shape")
    }
    return Sq(side: n)
}

func maybe(anon n: int64) -> int64? or Error {
    if n < 0 {
        throw NotFound(path: "maybe")
    }
    if n == 0 {
        return none
    }
    return n
}

func generic_ok[T](anon r: T or Error) -> bool {
    return r is T(_t)
}

test "type patterns on a union success value" {
    assert describe("42") == "int 42"
    assert describe("abc") == "str abc"
    assert describe("yes") == "bool true"
    assert describe("") == "error missing empty"
    assert ids("7") == "id 7"
    assert ids("x") == "id x"
    assert ids("yes") == "other"
    assert ids("") == "not found empty"
}

test "type patterns on an interface success value" {
    let got = match shape(3) {
        Sq(sq) -> f"square {sq.side}"
        Shape(other) -> f"shape {other.area()}"
        Error(e) -> e.to_str()
    }
    assert got == "square 3"
    if shape(-1) is Error(e) {
        assert e.to_str() == "missing shape"
    } else {
        fail("shape(-1) did not throw")
    }
}

test "type patterns on an optional success value" {
    let got = match maybe(0) {
        none -> "none"
        int64(n) -> f"int {n}"
        Err(e) -> e.to_str()
    }
    assert got == "none"
    let m = maybe(5)
    if m is int64(n) {
        assert n == 5
    } else {
        fail("maybe(5) is not int64")
    }
}

test "is with a type, in generic code too" {
    assert generic_ok(parse("1"))
    assert not generic_ok(parse(""))
    assert parse("q") is str
    assert not (parse("") is str)

    let r = parse("9")
    if r is Error(e) {
        fail(e.to_str())
        return
    }
    if r is int64(n) {
        assert n + 1 == 10
    } else {
        fail("not int64")
    }
}
