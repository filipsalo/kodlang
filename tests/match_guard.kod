// Guards: `pattern if cond -> body` falls through to the next arm when the condition is false.

type Shape = enum {
    Circle(radius: int64)
    Rect(w: int64, h: int64)
    Dot
}

type Token = enum {
    Plus
    Minus
    Star
}

func counted(n: int64) -> bool {
    print(f"guard {n}")
    return n > 0
}

func label(shape: Shape) -> str {
    match shape {
        .Circle(r) if r > 100 -> return "big circle"
        .Circle(r) -> return f"circle {r}"
        .Rect(w, h) if w == h -> return "square"
        .Rect(_, _) -> return "rect"
        .Dot -> return "dot"
    }
}

func by_value(n: int64, s: str, flag: bool, o: int64?) -> str {
    let number = match n {
        0 if flag -> "zero, flagged"
        0 -> "zero"
        else -> "other"
    }
    let text = match s {
        "a" if n > 0 -> "a, positive"
        "a" -> "a"
        else -> "text"
    }
    let opt = match o {
        Some(v) if v < 0 -> "negative"
        Some(_) -> "some"
        none if flag -> "none, flagged"
        none -> "none"
    }
    let truth = match flag {
        true if n > 0 -> "yes"
        true -> "maybe"
        false -> "no"
    }
    return f"{number}/{text}/{opt}/{truth}"
}

func statement_arms(n: int64, flag: bool) -> str {
    mut out = "none"
    match n {
        1 if flag -> out = "one, flagged"
        1 -> {
            let x = n + 1
            out = f"one, then {x}"
        }
        else if flag {
            out = "else if"
        }
    }
    return out
}

func tokens(t: Token, ready: bool) -> str {
    match t {
        .Plus | .Minus if ready -> return "additive, ready"
        .Plus | .Minus -> return "additive"
        .Star -> return "star"
    }
}

func nested(best: Shape?, limit: int64) -> str {
    return match best {
        Some(.Circle(r)) if r > limit -> f"over {r}"
        Some(.Circle(r)) -> f"under {r}"
        Some(_) -> "other"
        none -> "none"
    }
}

// A failed guard, with a call in it, must not disturb the tests of later arms.
func after_calls(a: int64, b: int64) -> str {
    match a {
        1 if counted(n: b) -> return "first"
        2 if counted(n: b) -> return "second"
        3 if counted(n: b) -> return "third"
        1 -> return "one"
        2 -> return "two"
        else -> return "rest"
    }
}

func strings(s: str, b: int64) -> str {
    match s {
        "x" if counted(n: b) -> return "x, passed"
        "y" if counted(n: b) -> return "y, passed"
        "x" -> return "x"
        "y" -> return "y"
        else -> return "?"
    }
}

func hides(x: int64, o: int64?) -> int64 {
    match o {
        Some(x) if x > 10 -> return x
        Some(_) -> return x
        none -> return 0
    }
}

func main() -> int64 {
    print(label(shape: .Circle(radius: 500)))
    print(label(shape: .Circle(radius: 5)))
    print(label(shape: .Rect(w: 2, h: 2)))
    print(label(shape: .Rect(w: 2, h: 3)))
    print(label(shape: .Dot))
    print(by_value(n: 0, s: "a", flag: true, o: -1))
    print(by_value(n: 1, s: "a", flag: false, o: 1))
    print(by_value(n: 0, s: "b", flag: false, o: none))
    print(by_value(n: 1, s: "b", flag: true, o: none))
    print(statement_arms(n: 1, flag: true))
    print(statement_arms(n: 1, flag: false))
    print(statement_arms(n: 2, flag: true))
    print(statement_arms(n: 2, flag: false))
    print(tokens(t: .Plus, ready: true))
    print(tokens(t: .Minus, ready: true))
    print(tokens(t: .Minus, ready: false))
    print(tokens(t: .Star, ready: true))
    print(nested(best: Shape.Circle(radius: 9), limit: 3))
    print(nested(best: Shape.Circle(radius: 2), limit: 3))
    print(nested(best: Shape.Dot, limit: 3))
    print(nested(best: none, limit: 3))
    print(after_calls(a: 1, b: 1))
    print(after_calls(a: 1, b: 0))
    print(after_calls(a: 2, b: 0))
    print(after_calls(a: 3, b: 0))
    print(strings(s: "x", b: 0))
    print(strings(s: "y", b: 0))
    print(strings(s: "y", b: 1))
    print_int(hides(x: 1, o: 50))
    print_int(hides(x: 1, o: 5))
    return 0
}

// expected output:
// big circle
// circle 5
// square
// rect
// dot
// zero, flagged/a/negative/maybe
// other/a, positive/some/no
// zero/text/none/no
// other/text/none, flagged/yes
// one, flagged
// one, then 2
// else if
// none
// additive, ready
// additive, ready
// additive
// star
// over 9
// under 2
// other
// none
// guard 1
// first
// guard 0
// one
// guard 0
// two
// guard 0
// rest
// guard 0
// x
// guard 0
// y
// guard 1
// y, passed
// 50
// 1
