// A dep that imports this module back registers its enum a second time;
// both registrations are the same `Shape`.
import "./cyclic_import_enum_dep"

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
}

func area(anon s: Shape) -> int64 {
    match s {
        .Circle(r) -> return r
        .Rect(w, h) -> return w * h
    }
}

func main() -> int64 {
    let u = .Circle(r: 4)
    print_int(area(u) + cyclic_import_enum_dep.count())
    print_int(cyclic_import_enum_dep.measure(u))
    let v: Shape = .Rect(w: 2, h: 3)
    print_int(cyclic_import_enum_dep.measure(v))
    return 0
}

// expected output:
// 7
// 40
// 5
