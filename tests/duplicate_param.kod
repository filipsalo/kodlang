// Two parameters of one function, method, interface method, extern or
// function literal can't share a name.
type Pt = struct {
    x: int64

    func shift(self, anon by: int64, step by: int64) -> int64 {
        return self.x + by
    }
}

type Box[T] = struct {
    v: T

    func put(self, anon v: T, again v: T) -> none {
        self.v = v
    }
}

interface Shape {
    func area(self, anon k: int64, scale k: int64) -> int64
}

extern func c_measure(anon s: str, also s: str) -> int64

func pick(anon a: int64, b a: str) -> str {
    return a
}

func main() -> int64 {
    let f = func(anon n: int64, anon n: int64) -> int64 {
        return n
    }
    print(pick(1, b: "x"))
    print_int(Pt(x: 1).shift(2, step: 3))
    print_int(f(1, 2))
    return 0
}

// expected errors:
// 6:38: error: parameter `by` is declared twice; give one of them another name
// 14:31: error: parameter `v` is declared twice; give one of them another name
// 20:36: error: parameter `k` is declared twice; give one of them another name
// 23:36: error: parameter `s` is declared twice; give one of them another name
// 25:26: error: parameter `a` is declared twice; give one of them another name
// 30:33: error: parameter `n` is declared twice; give one of them another name
