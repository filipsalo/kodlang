            mut f: [Shape] = []
            f += [Sq(s: 1)] + more
            let sh: Shape = Sq(s: 2)
            let a: int64? = 3
            for y in [sh, Sq(s: 3), Circle(r: 1)] {
                print_int(y.area())
            }
            return len([a, 5, none]) + len(cs) + len(ys) + len(g) + len(f)
        }
