// HTTP/1.1: URLs, headers, writing a request and reading a response, and a
// Client that sends requests over TCP or TLS, with redirects. See docs/http.md.
import "stream" { IoError, BufReader, Reader, Writer, write_all, read_exact }
import "strbuilder" { StrBuilder }
import "encoding/base64"
import "net/tcp"
import "net/tls"
import "net/tls" { TlsStream }
import "compress/inflate"
import "posix" { Fd }
import "time"
import "time" { Duration }

type Header = struct {
    name: str
    value: str
}

type Headers = struct {
    items: [Header] = []

    func get(self, anon name: str) -> str? {
        let want = name.lower()
        for h in self.items {
            if h.name.lower() == want {
                return h.value
            }
        }
        return none
    }

    func all(self, anon name: str) -> [str] {
        let want = name.lower()
        mut out: [str] = []
        for h in self.items {
            if h.name.lower() == want {
                out += [h.value]
            }
        }
        return out
    }

    func has(self, anon name: str) -> bool {
        return self.get(name) is not none
    }

    func add(self, anon name: str, anon value: str) -> none {
        self.items += [Header(name: name, value: value)]
    }

    // Replaces the first header of that name in place and drops the others.
    func set(self, anon name: str, anon value: str) -> none {
        let want = name.lower()
        mut out: [Header] = []
        mut placed = false
        for h in self.items {
            if h.name.lower() != want {
                out += [h]
            } else if not placed {
                out += [Header(name: name, value: value)]
                placed = true
            }
        }
        if not placed {
            out += [Header(name: name, value: value)]
        }
        self.items = out
    }
}

type Url = struct {
    scheme: str
    host: str
    port: int64
    target: str

    func host_header(self) -> str {
        mut h = self.host
        if h.contains(":") {
            h = "[" + h + "]"
        }
        mut default_port: int64 = 80
        if self.scheme == "https" {
            default_port = 443
        }
        if self.port != default_port {
            h += ":" + self.port.to_str()
        }
        return h
    }
}

type Request = struct {
    method: str
    url: Url
    headers: Headers
    body: bytes
}

type Response = struct {
    status: int64
    reason: str
    headers: Headers
    body: bytes
    // The connection can carry another request: see docs/http.md.
    keep_alive: bool = false

    func text(self) -> str {
        return kod_bytes_to_str(self.body)
    }

    func ok(self) -> bool {
        return self.status >= 200 and self.status < 300
    }

    func header(self, anon name: str) -> str? {
        return self.headers.get(name)
    }
}

type Limits = struct {
    max_body: int64 = 16777216
    max_header_bytes: int64 = 65536
    max_headers: int64 = 100
}

func protocol(anon detail: str) -> IoError {
    return IoError(kind: .Protocol, op: "http", errno: 0, detail: detail)
}

func invalid(anon op: str, anon detail: str) -> IoError {
    return IoError(kind: .InvalidInput, op: op, errno: 0, detail: detail)
}

// ---- character classes ----

func is_digit(anon c: int64) -> bool {
    return c >= 48 and c <= 57
}

func is_alpha(anon c: int64) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

// A token character, as RFC 9110 defines it: names of methods and headers.
func is_token_char(anon c: int64) -> bool {
    if is_digit(c) or is_alpha(c) {
        return true
    }
    return "!#$%&'*+-.^_`|~".find(kod_bytes_to_str(kod_bytes_from_array([c]))) is not none
}

func is_token(anon s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    let n = len(s)
    mut i: int64 = 0
    for i < n {
        if not is_token_char(s[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

// No control characters (a tab is allowed) and no DEL.
func is_clean(anon s: str, tab_ok: bool) -> bool {
    let n = len(s)
    mut i: int64 = 0
    for i < n {
        let c = s[i]
        if c == 127 or (c < 32 and (c != 9 or not tab_ok)) {
            return false
        }
        i = i + 1
    }
    return true
}

func all_digits(anon s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    let n = len(s)
    mut i: int64 = 0
    for i < n {
        if not is_digit(s[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

// ---- URLs ----

func parse_port(anon text: str, op: str) -> int64 or Error {
    if not all_digits(text) or len(text) > 5 {
        throw invalid(op, f"bad port {text}")
    }
    let p = text.parse_int()? or 0
    if p < 1 or p > 65535 {
        throw invalid(op, f"port {text} out of range")
    }
    return p
}

func parse_url(anon s: str) -> Url or Error {
    let op = "parse url"
    if not is_clean(s, tab_ok: false) or s.contains(" ") {
        throw invalid(op, "URL has a space or control character")
    }
    let sep = s.find("://")
    if sep is none {
        throw invalid(op, "URL needs http:// or https://")
    }
    let at = sep? or 0
    let scheme = s[0..at].lower()
    if scheme != "http" and scheme != "https" {
        throw invalid(op, f"unsupported scheme {scheme}")
    }
    mut rest = s[at + 3..len(s)]
    let hash = rest.find("#")
    if hash is not none {
        rest = rest[0..hash]
    }
    mut end = len(rest)
    for mark in ["/", "?"] {
        let m = rest.find(mark)
        if m is not none and m < end {
            end = m
        }
    }
    let authority = rest[0..end]
    mut target = rest[end..len(rest)]
    if len(target) == 0 {
        target = "/"
    } else if target[0] == 63 {
        target = "/" + target
    }
    if authority.contains("@") {
        throw invalid(op, "credentials in a URL are not supported")
    }
    mut host = authority
    mut port: int64 = 80
    if scheme == "https" {
        port = 443
    }
    if authority.starts_with("[") {
        let close = authority.find("]")
        if close is none {
            throw invalid(op, "unterminated [ in host")
        }
        let c = close? or 0
        host = authority[1..c]
        let after = authority[c + 1..len(authority)]
        if len(after) > 0 {
            if after[0] != 58 {
                throw invalid(op, "text after ] in host")
            }
            port = try parse_port(after[1..len(after)], op: op)
        }
    } else {
        let colon = authority.find(":")
        if colon is not none {
            let c = colon
            host = authority[0..c]
            port = try parse_port(authority[c + 1..len(authority)], op: op)
        }
    }
    if len(host) == 0 {
        throw invalid(op, "URL has no host")
    }
    return Url(scheme: scheme, host: host.lower(), port: port, target: target)
}

// Remove "." and ".." segments from the path part of `target`; a query stays.
func normalize_target(anon target: str) -> str {
    mut path = target
    mut query = ""
    let q = target.find("?")
    if q is not none {
        path = target[0..q]
        query = target[q..len(target)]
    }
    let segments = path.split("/")
    mut out: [str] = []
    mut dir_end = false
    mut first = true
    for seg in segments {
        if first {
            first = false
        } else if seg == "." {
            dir_end = true
        } else if seg == ".." {
            if len(out) > 0 {
                out = out[0..len(out) - 1]
            }
            dir_end = true
        } else {
            out += [seg]
            dir_end = false
        }
    }
    mut joined = "/" + "/".join(out)
    if dir_end and not joined.ends_with("/") {
        joined += "/"
    }
    return joined + query
}

// Where a `Location` header sent from a response to `base` points.
func resolve(anon base: Url, anon location: str) -> Url or Error {
    let op = "resolve redirect"
    mut loc = location
    let hash = loc.find("#")
    if hash is not none {
        loc = loc[0..hash]
    }
    if len(loc) == 0 {
        throw invalid(op, "empty Location")
    }
    let lower = loc.lower()
    if lower.starts_with("http://") or lower.starts_with("https://") {
        return try parse_url(loc)
    }
    if loc.starts_with("//") {
        return try parse_url(base.scheme + ":" + loc)
    }
    let colon = loc.find(":")
    let slash = loc.find("/")
    if colon is not none {
        let c = colon
        if slash is none or c < (slash? or 0) {
            if not loc.starts_with("?") {
                throw invalid(op, f"unsupported Location {loc}")
            }
        }
    }
    mut target = loc
    if loc.starts_with("/") {
        target = normalize_target(loc)
    } else if loc.starts_with("?") {
        let q = base.target.find("?")
        mut path = base.target
        if q is not none {
            path = base.target[0..q]
        }
        target = path + loc
    } else {
        let q = base.target.find("?")
        mut path = base.target
        if q is not none {
            path = base.target[0..q]
        }
        mut dir = "/"
        let last = path.split("/")
        if len(last) > 1 {
            dir = path[0..len(path) - len(last[len(last) - 1])]
        }
        target = normalize_target(dir + loc)
    }
    return try parse_url(base.scheme + "://" + base.host_header() + target)
}

// ---- percent-encoding and query strings ----

func hex_upper(anon n: int64) -> int64 {
    if n < 10 {
        return 48 + n
    }
    return 55 + n
}

func hex_value(anon c: int64) -> int64 {
    if is_digit(c) {
        return c - 48
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    return -1
}

func is_unreserved(anon c: int64) -> bool {
    return is_digit(c) or is_alpha(c) or c == 45 or c == 46 or c == 95 or c == 126
}

// Every byte but A-Z a-z 0-9 - . _ ~ as %XX.
func percent_encode(anon s: str) -> str {
    let out = StrBuilder()
    let n = len(s)
    mut i: int64 = 0
    mut run: int64 = 0
    for i < n {
        let c = s[i]
        if not is_unreserved(c) {
            out.append(s[run..i])
            run = i + 1
            out.append_byte(37)
            out.append_byte(hex_upper(c >> 4))
            out.append_byte(hex_upper(c & 15))
        }
        i = i + 1
    }
    out.append(s[run..n])
    return out.to_str()
}

func percent_decode(anon s: str) -> str or Error {
    let out = StrBuilder()
    let n = len(s)
    mut i: int64 = 0
    for i < n {
        let c = s[i]
        if c != 37 {
            out.append_byte(c)
            i = i + 1
        } else {
            if i + 2 >= n {
                throw invalid("percent decode", "% needs two hex digits")
            }
            let hi = hex_value(s[i + 1])
            let lo = hex_value(s[i + 2])
            if hi < 0 or lo < 0 {
                throw invalid("percent decode", "% needs two hex digits")
            }
            out.append_byte(hi * 16 + lo)
            i = i + 3
        }
    }
    return out.to_str()
}

// Name and value pairs for a URL's query, encoded when written.
type Query = struct {
    items: [Header] = []

    func add(self, anon name: str, anon value: str) -> none {
        self.items += [Header(name: name, value: value)]
    }

    func to_str(self) -> str {
        let out = StrBuilder()
        mut first = true
        for h in self.items {
            if not first {
                out.append_byte(38)
            }
            first = false
            out.append(percent_encode(h.name))
            out.append_byte(61)
            out.append(percent_encode(h.value))
        }
        return out.to_str()
    }
}

// `url` with the query added after a `?` (or `&` if it has one), before any
// `#fragment`.
func with_query(anon url: str, anon q: Query) -> str {
    if len(q.items) == 0 {
        return url
    }
    mut base = url
    mut fragment = ""
    let hash = url.find("#")
    if hash is not none {
        base = url[0..hash]
        fragment = url[hash..len(url)]
    }
    mut sep = "?"
    if base.contains("?") {
        sep = "&"
        if base.ends_with("?") or base.ends_with("&") {
            sep = ""
        }
    }
    return base + sep + q.to_str() + fragment
}

// The value of an `Authorization` header for HTTP Basic authentication.
func basic_auth(anon user: str, anon password: str) -> str or Error {
    if user.contains(":") {
        throw invalid("basic auth", "the user name cannot contain a colon")
    }
    return "Basic " + base64.encode_str(user + ":" + password)
}

// ---- writing a request ----

func is_post_like(anon method: str) -> bool {
    return method == "POST" or method == "PUT" or method == "PATCH"
}

func own_header(anon name: str) -> bool {
    let n = name.lower()
    return n == "host" or n == "connection" or n == "content-length" or n == "transfer-encoding"
}

func write_request(anon w: Writer, anon req: Request, keep_alive: bool = false, accept_gzip: bool = false) -> none or Error {
    let op = "write request"
    if not is_token(req.method) {
        throw invalid(op, "bad method")
    }
    if not is_clean(req.url.target, tab_ok: false) or req.url.target.contains(" ") or not req.url.target.starts_with("/") {
        throw invalid(op, "bad request target")
    }
    for h in req.headers.items {
        if not is_token(h.name) {
            throw invalid(op, f"bad header name {h.name}")
        }
        if not is_clean(h.value, tab_ok: true) {
            throw invalid(op, f"bad value for header {h.name}")
        }
    }
    let out = StrBuilder()
    out.append(req.method + " " + req.url.target + " HTTP/1.1\r\n")
    out.append("Host: " + req.url.host_header() + "\r\n")
    for h in req.headers.items {
        if not own_header(h.name) {
            out.append(h.name + ": " + h.value + "\r\n")
        }
    }
    if not req.headers.has("User-Agent") {
        out.append("User-Agent: kod\r\n")
    }
    if not req.headers.has("Accept") {
        out.append("Accept: */*\r\n")
    }
    if accept_gzip and not req.headers.has("Accept-Encoding") {
        out.append("Accept-Encoding: gzip\r\n")
    }
    if len(req.body) > 0 or is_post_like(req.method) {
        out.append("Content-Length: " + len(req.body).to_str() + "\r\n")
    }
    if not keep_alive {
        out.append("Connection: close\r\n")
    }
    out.append("\r\n")
    out.append_bytes(req.body)
    try write_all(w, out.to_bytes())
}

// ---- reading a response ----

// What a response may still use up for its status line, headers and trailers.
type Budget = struct {
    left: int64
    headers: int64
}

func truncated(anon detail: str) -> IoError {
    return IoError(kind: .UnexpectedEof, op: "http", errno: 0, detail: detail)
}

// The next line without its line end. The stream ending first, or in the
// middle of the line, is a truncation; the budget running out is an error.
func next_line(anon br: BufReader, anon budget: Budget) -> str or Error {
    let got = br.read_line()
    if got is Err(e) {
        if e is IoError(io) {
            if io.kind == .InvalidInput and io.detail == "line too long" {
                throw protocol("headers too large")
            }
        }
        throw e
    }
    let line = try got
    if line is none {
        throw truncated("connection closed before the end of the message")
    }
    if br.ended {
        throw truncated("connection closed in the middle of a line")
    }
    let text = line? or ""
    budget.left = budget.left - len(text) - 2
    if budget.left < 0 {
        throw protocol("headers too large")
    }
    return text
}

type StatusLine = struct {
    code: int64
    reason: str
    minor: int64
}

func parse_status(anon line: str) -> StatusLine or Error {
    if not line.starts_with("HTTP/1.") or len(line) < 12 {
        throw protocol("bad status line")
    }
    if not is_digit(line[7]) or line[8] != 32 {
        throw protocol("bad status line")
    }
    let digits = line[9..12]
    if not all_digits(digits) or (len(line) > 12 and line[12] != 32) {
        throw protocol("bad status line")
    }
    let code = digits.parse_int()? or 0
    if code < 100 or code > 599 {
        throw protocol("bad status line")
    }
    mut reason = ""
    if len(line) > 13 {
        reason = line[13..len(line)]
    }
    return StatusLine(code: code, reason: reason, minor: line[7] - 48)
}

// Header lines up to the empty line that ends them, added to `into`.
func read_headers(anon br: BufReader, anon budget: Budget, anon into: Headers, max_headers: int64) -> none or Error {
    for true {
        let line = try next_line(br, budget)
        if len(line) == 0 {
            return
        }
        if line[0] == 32 or line[0] == 9 {
            throw protocol("header continuation lines are not supported")
        }
        let colon = line.find(":")
        if colon is none {
            throw protocol("malformed header line")
        }
        let c = colon? or 0
        let name = line[0..c]
        if not is_token(name) {
            throw protocol("bad header name")
        }
        let value = line[c + 1..len(line)].trim()
        if not is_clean(value, tab_ok: true) {
            throw protocol("bad header value")
        }
        budget.headers = budget.headers + 1
        if budget.headers > max_headers {
            throw protocol("too many headers")
        }
        into.add(name, value)
    }
}

func parse_hex(anon text: str) -> int64 or Error {
    if len(text) == 0 or len(text) > 15 {
        throw protocol("bad chunk size")
    }
    mut n: int64 = 0
    let len_text = len(text)
    mut i: int64 = 0
    for i < len_text {
        let c = text[i]
        mut d: int64 = -1
        if is_digit(c) {
            d = c - 48
        } else if c >= 97 and c <= 102 {
            d = c - 87
        } else if c >= 65 and c <= 70 {
            d = c - 55
        }
        if d < 0 {
            throw protocol("bad chunk size")
        }
        n = n * 16 + d
        i = i + 1
    }
    return n
}

func read_chunked(anon br: BufReader, anon budget: Budget, limits: Limits) -> bytes or Error {
    let out = StrBuilder()
    for true {
        let size_line = try next_line(br, Budget(left: 4096, headers: 0))
        mut size_text = size_line
        let semi = size_line.find(";")
        if semi is not none {
            size_text = size_line[0..semi]
        }
        let size = try parse_hex(size_text.trim())
        if size == 0 {
            break
        }
        if out.len() + size > limits.max_body {
            throw protocol("body too large")
        }
        out.append_bytes(try read_exact(br, size))
        let end = try read_exact(br, 2)
        if kod_bytes_to_str(end) != "\r\n" {
            throw protocol("chunk is missing its closing line break")
        }
    }
    try read_headers(br, budget, Headers(), max_headers: limits.max_headers)
    return out.to_bytes()
}

func read_length(anon headers: Headers, anon limits: Limits) -> int64 or Error {
    mut n: int64 = -1
    for v in headers.all("content-length") {
        let t = v.trim()
        if not all_digits(t) or len(t) > 18 {
            throw protocol("bad Content-Length")
        }
        let x = t.parse_int()? or -1
        if n >= 0 and x != n {
            throw protocol("conflicting Content-Length headers")
        }
        n = x
    }
    if n > limits.max_body {
        throw protocol("body too large")
    }
    return n
}

func read_body(anon br: BufReader, anon method: str, status: int64, headers: Headers, budget: Budget, limits: Limits) -> bytes or Error {
    if method == "HEAD" or status < 200 or status == 204 or status == 304 {
        return kod_str_to_bytes("")
    }
    let codings = headers.all("transfer-encoding")
    if len(codings) > 0 {
        for v in codings {
            if v.trim().lower() != "chunked" {
                throw protocol(f"unsupported Transfer-Encoding {v}")
            }
        }
        return try read_chunked(br, budget, limits: limits)
    }
    let n = try read_length(headers, limits)
    if n >= 0 {
        return try read_exact(br, n)
    }
    let out = StrBuilder()
    for true {
        let piece = try br.read(65536)
        if len(piece) == 0 {
            break
        }
        out.append_bytes(piece)
        if out.len() > limits.max_body {
            throw protocol("body too large")
        }
    }
    return out.to_bytes()
}

// Does a `Connection`-style header list `token` (case-insensitively)?
func has_token(anon headers: Headers, anon name: str, anon token: str) -> bool {
    for v in headers.all(name) {
        for part in v.split(",") {
            if part.trim().lower() == token {
                return true
            }
        }
    }
    return false
}

// Does the response say where its body ends, so that the connection can be
// used again after it?
func framed(anon method: str, status: int64, headers: Headers) -> bool {
    if method == "HEAD" or status < 200 or status == 204 or status == 304 {
        return true
    }
    return len(headers.all("transfer-encoding")) > 0 or len(headers.all("content-length")) > 0
}

func may_reuse(anon method: str, status: StatusLine, headers: Headers) -> bool {
    if not framed(method, status: status.code, headers: headers) {
        return false
    }
    if has_token(headers, "connection", "close") {
        return false
    }
    if status.minor >= 1 {
        return true
    }
    return has_token(headers, "connection", "keep-alive")
}

func read_one(anon br: BufReader, anon method: str, limits: Limits) -> Response or Error {
    mut interim: int64 = 0
    for true {
        let budget = Budget(left: limits.max_header_bytes, headers: 0)
        let status = try parse_status(try next_line(br, budget))
        let headers = Headers()
        try read_headers(br, budget, headers, max_headers: limits.max_headers)
        if status.code >= 200 {
            let body = try read_body(br, method, status: status.code, headers: headers, budget: budget, limits: limits)
            return Response(status: status.code, reason: status.reason, headers: headers, body: body, keep_alive: may_reuse(method, status: status, headers: headers))
        }
        interim = interim + 1
        if interim > 16 {
            throw protocol("too many interim responses")
        }
    }
    throw protocol("unreachable")
}

// One response from `br`. `method` is the request's, which decides whether a
// body follows. Lines longer than the header limit fail.
func read_response(anon br: BufReader, anon method: str, limits: Limits = Limits()) -> Response or Error {
    let old = br.limit
    br.limit = limits.max_header_bytes
    let r = read_one(br, method, limits: limits)
    br.limit = old
    return r
}

// The client: requests over TCP or TLS, with redirects.

// What one request may change about the Client it is sent through. A field left
// out means the Client's value.
type Options = struct {
    headers: Headers = Headers()
    body: bytes = kod_str_to_bytes("")
    trust_file: str? = none
    timeout: Duration? = none
    max_redirects: int64? = none
    limits: Limits? = none
    deadline: Duration? = none
    accept_gzip: bool? = none
}

// The values a request runs with: the Client's, with the Options laid over them.
type Settings = struct {
    headers: Headers
    body: bytes
    trust_file: str
    timeout: Duration
    max_redirects: int64
    limits: Limits
    deadline: Duration
    accept_gzip: bool
}

// `base` and `extra` together; a header of `extra` replaces those of `base` with its name.
func merged(anon base: Headers, anon extra: Headers) -> Headers {
    let out = Headers()
    for h in base.items {
        if not extra.has(h.name) {
            out.add(h.name, h.value)
        }
    }
    for h in extra.items {
        out.add(h.name, h.value)
    }
    return out
}

func deadline_error() -> IoError {
    return IoError(kind: .TimedOut, op: "http", errno: 0, detail: "deadline exceeded")
}

// How long the next wait may last: `timeout_ms`, or less when the deadline
// (a monotonic time in ns, 0 for none) is nearer. Fails when it has passed.
func wait_ms(timeout_ms: int64, deadline_ns: int64) -> int64 or Error {
    if deadline_ns == 0 {
        return timeout_ms
    }
    let left_ns = deadline_ns - time.monotonic_ns()
    if left_ns <= 0 {
        throw deadline_error()
    }
    let left_ms = (left_ns + 999999) / 1000000
    if left_ms < timeout_ms {
        return left_ms
    }
    return timeout_ms
}

// A wait that ended in `TimedOut` after the deadline is a deadline error.
func after_wait(anon e: Error, deadline_ns: int64) -> Error {
    if deadline_ns != 0 and time.monotonic_ns() >= deadline_ns {
        if e is IoError(io) {
            if io.kind == .TimedOut {
                return deadline_error()
            }
        }
    }
    return e
}

// What the client needs of a connection, plain or TLS.
interface Link {
    func read(self, anon max: int64) -> bytes or Error
    func write(self, anon data: bytes) -> int64 or Error
    func close(self) -> none or Error
    // Nothing is waiting to be read: the peer has not closed it or sent more.
    func idle(self) -> bool
    // Set the limits for the next request and forget what was received.
    func arm(self, anon timeout_ms: int64, anon deadline_ns: int64) -> none
    // Bytes read since `arm`.
    func received(self) -> int64
}

// A plain connection whose every read and write is limited by the deadline.
type TcpLink = struct {
    conn: Fd
    timeout_ms: int64
    deadline_ns: int64
    got: int64 = 0

    func read(self, anon max: int64) -> bytes or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try tcp.set_timeout(self.conn, timeout: Duration(ms: ms))
        let data = self.conn.read(max)
        if data is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        let bytes_read = try data
        self.got = self.got + len(bytes_read)
        return bytes_read
    }

    func write(self, anon data: bytes) -> int64 or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try tcp.set_timeout(self.conn, timeout: Duration(ms: ms))
        let put = self.conn.write(data)
        if put is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        return try put
    }

    func close(self) -> none or Error {
        return try self.conn.close()
    }

    func idle(self) -> bool {
        return tcp.is_idle(self.conn)
    }

    func arm(self, anon timeout_ms: int64, anon deadline_ns: int64) -> none {
        self.timeout_ms = timeout_ms
        self.deadline_ns = deadline_ns
        self.got = 0
    }

    func received(self) -> int64 {
        return self.got
    }
}

type TlsLink = struct {
    conn: TlsStream
    timeout_ms: int64
    deadline_ns: int64
    got: int64 = 0

    func read(self, anon max: int64) -> bytes or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try self.conn.set_timeout(timeout: Duration(ms: ms))
        let data = self.conn.read(max)
        if data is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        let bytes_read = try data
        self.got = self.got + len(bytes_read)
        return bytes_read
    }

    func write(self, anon data: bytes) -> int64 or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try self.conn.set_timeout(timeout: Duration(ms: ms))
        let put = self.conn.write(data)
        if put is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        return try put
    }

    func close(self) -> none or Error {
        return try self.conn.close()
    }

    func idle(self) -> bool {
        return tcp.is_idle(Fd(fd: self.conn.fd))
    }

    func arm(self, anon timeout_ms: int64, anon deadline_ns: int64) -> none {
        self.timeout_ms = timeout_ms
        self.deadline_ns = deadline_ns
        self.got = 0
    }

    func received(self) -> int64 {
        return self.got
    }
}

// A new connection to where `url` points, within `connect_ms`.
func open_link(anon url: Url, cfg: Settings, connect_ms: int64) -> Link or Error {
    if url.scheme == "https" {
        let conn = try tls.connect(url.host, port: url.port, trust_file: cfg.trust_file, timeout: Duration(ms: connect_ms))
        return TlsLink(conn: conn, timeout_ms: cfg.timeout.ceil_ms(), deadline_ns: 0)
    }
    let conn = try tcp.connect(url.host, port: url.port, timeout: Duration(ms: connect_ms))
    return TcpLink(conn: conn, timeout_ms: cfg.timeout.ceil_ms(), deadline_ns: 0)
}

// Methods that are safe to send again when a reused connection turns out to
// be dead.
func repeatable(anon method: str) -> bool {
    return method == "GET" or method == "HEAD" or method == "OPTIONS" or method == "PUT" or method == "DELETE" or method == "TRACE"
}

type Idle = struct {
    key: str
    link: Link
    since_ns: int64
}

// Close a connection that nothing more is wanted from.
func discard(anon link: Link) -> none {
    if link.close() is Err(_) {
        return
    }
}

type Acquired = struct {
    link: Link
    reused: bool
}

// A gzip-encoded body decoded, with the headers saying so removed; any other
// response as it is.
func decode_content(anon resp: Response, anon limits: Limits) -> Response or Error {
    let coding = resp.headers.get("content-encoding")
    if coding is none or len(resp.body) == 0 {
        return resp
    }
    let name = (coding? or "").trim().lower()
    if name != "gzip" and name != "x-gzip" {
        return resp
    }
    let decoded = inflate.gunzip(resp.body, max_output: limits.max_body)
    if decoded is Err(e) {
        if e is IoError(io) {
            if io.detail == "output too large" {
                throw IoError(kind: .Protocol, op: "http", errno: 0, detail: "body too large")
            }
            throw IoError(kind: .Protocol, op: "http", errno: 0, detail: "bad gzip body: " + io.detail)
        }
        throw e
    }
    let body = try decoded
    let headers = without(resp.headers, ["content-encoding", "content-length"])
    headers.add("Content-Length", len(body).to_str())
    return Response(status: resp.status, reason: resp.reason, headers: headers, body: body, keep_alive: resp.keep_alive)
}

// Write `req` and read its response.
func attempt(anon link: Link, anon br: BufReader, anon req: Request, cfg: Settings, keep_alive: bool) -> Response or Error {
    try write_request(link, req, keep_alive: keep_alive, accept_gzip: cfg.accept_gzip)
    return read_response(br, req.method, limits: cfg.limits)
}

// Connections kept between requests. See docs/http.md.
type Client = struct {
    headers: Headers = Headers()
    trust_file: str = ""
    timeout: Duration = Duration(seconds: 30)
    deadline: Duration = Duration()
    max_redirects: int64 = 5
    accept_gzip: bool = true
    limits: Limits = Limits()
    max_idle_per_host: int64 = 2
    idle: Duration = Duration(seconds: 30)
    pool: [Idle] = []

    // The settings for a request with `options`.
    func settings(self, anon options: Options) -> Settings {
        return Settings(
            headers: merged(self.headers, options.headers),
            body: options.body,
            trust_file: options.trust_file? or self.trust_file,
            timeout: options.timeout? or self.timeout,
            max_redirects: options.max_redirects? or self.max_redirects,
            limits: options.limits? or self.limits,
            deadline: options.deadline? or self.deadline,
            accept_gzip: options.accept_gzip? or self.accept_gzip,
        )
    }

    // An idle connection for `key`, or none. Ones that are too old or that the
    // server has closed are closed on the way.
    func take(self, anon key: str) -> Idle? {
        let now = time.monotonic_ns()
        mut kept: [Idle] = []
        mut found: Idle? = none
        for entry in self.pool {
            if now - entry.since_ns > self.idle.ns or not entry.link.idle() {
                discard(entry.link)
            } else if entry.key == key and found is none {
                found = entry
            } else {
                kept += [entry]
            }
        }
        self.pool = kept
        return found
    }

    // Keep `link` for `key`, closing the oldest of that host's if there are too many.
    func keep(self, anon key: str, anon link: Link) -> none {
        if self.max_idle_per_host <= 0 {
            discard(link)
            return
        }
        mut count: int64 = 0
        for entry in self.pool {
            if entry.key == key {
                count = count + 1
            }
        }
        mut kept: [Idle] = []
        mut drop = count - self.max_idle_per_host + 1
        for entry in self.pool {
            if entry.key == key and drop > 0 {
                drop = drop - 1
                discard(entry.link)
            } else {
                kept += [entry]
            }
        }
        kept += [Idle(key: key, link: link, since_ns: time.monotonic_ns())]
        self.pool = kept
    }

    // Close every idle connection.
    func close(self) -> none {
        for entry in self.pool {
            discard(entry.link)
        }
        let empty: [Idle] = []
        self.pool = empty
    }

    func acquire(self, anon key: str, anon url: Url, cfg: Settings, deadline_ns: int64) -> Acquired or Error {
        let kept = self.take(key)
        if kept is Some(entry) {
            return Acquired(link: entry.link, reused: true)
        }
        let connect_ms = try wait_ms(timeout_ms: cfg.timeout.ceil_ms(), deadline_ns: deadline_ns)
        let link = try open_link(url, cfg: cfg, connect_ms: connect_ms)
        return Acquired(link: link, reused: false)
    }

    // One request, on a kept connection if there is one, else on a new one.
    func exchange(self, anon req: Request, cfg: Settings, deadline_ns: int64) -> Response or Error {
        let url = req.url
        let key = f"{url.scheme}://{url.host}:{url.port}"
        let reuse = self.max_idle_per_host > 0
        mut repeated = false
        for true {
            let got = try self.acquire(key, url, cfg: cfg, deadline_ns: deadline_ns)
            let link = got.link
            link.arm(cfg.timeout.ceil_ms(), deadline_ns)
            let br = BufReader(inner: link, limit: cfg.limits.max_header_bytes)
            let outcome = attempt(link, br, req, cfg: cfg, keep_alive: reuse)
            if outcome is Err(e) {
                discard(link)
                if got.reused and not repeated and link.received() == 0 and repeatable(req.method) {
                    repeated = true
                    continue
                }
                throw e
            }
            let response = try outcome
            if reuse and response.keep_alive and br.pos >= len(br.buf) {
                self.keep(key, link)
            } else {
                discard(link)
            }
            return try decode_content(response, cfg.limits)
        }
        throw invalid("fetch", "unreachable")
    }

    func fetch(self, anon method: str, anon url: str, options: Options = Options()) -> Response or Error {
        let cfg = self.settings(options)
        if cfg.deadline < Duration() {
            throw invalid("fetch", "deadline cannot be negative")
        }
        mut deadline_ns: int64 = 0
        if cfg.deadline > Duration() {
            deadline_ns = time.monotonic_ns() + cfg.deadline.ns
        }
        mut current = try parse_url(url)
        mut verb = method
        mut payload = cfg.body
        mut headers = cfg.headers
        mut hops: int64 = 0
        for true {
            let req = Request(method: verb, url: current, headers: headers, body: payload)
            let resp = try self.exchange(req, cfg: cfg, deadline_ns: deadline_ns)
            let location = resp.header("location")
            if not is_redirect(resp.status) or location is none or cfg.max_redirects <= 0 {
                return resp
            }
            hops = hops + 1
            if hops > cfg.max_redirects {
                throw invalid("redirect", f"more than {cfg.max_redirects} redirects")
            }
            let next = try resolve(current, location? or "")
            if current.scheme == "https" and next.scheme == "http" {
                throw invalid("redirect", "refusing a redirect from https to http")
            }
            if resp.status != 307 and resp.status != 308 {
                if verb != "HEAD" {
                    verb = "GET"
                }
                payload = kod_str_to_bytes("")
                headers = without(headers, ["content-type"])
            }
            if next.host != current.host or next.port != current.port {
                headers = without(headers, ["authorization", "cookie", "proxy-authorization"])
            }
            current = next
        }
        throw invalid("redirect", "unreachable")
    }

    func get(self, anon url: str, options: Options = Options()) -> Response or Error {
        return try self.fetch("GET", url, options: options)
    }

    func delete(self, anon url: str, options: Options = Options()) -> Response or Error {
        return try self.fetch("DELETE", url, options: options)
    }

    func post(self, anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
        return try self.fetch("POST", url, options: with_body(options, body, content_type))
    }

    func put(self, anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
        return try self.fetch("PUT", url, options: with_body(options, body, content_type))
    }

    func patch(self, anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
        return try self.fetch("PATCH", url, options: with_body(options, body, content_type))
    }
}

// `options` with a body, and a `Content-Type` that replaces one of the same name.
func with_body(anon options: Options, anon body: bytes, anon content_type: str) -> Options {
    let headers = merged(options.headers, Headers())
    headers.set("Content-Type", content_type)
    return Options(
        headers: headers,
        body: body,
        trust_file: options.trust_file,
        timeout: options.timeout,
        max_redirects: options.max_redirects,
        limits: options.limits,
        deadline: options.deadline,
        accept_gzip: options.accept_gzip,
    )
}

func is_redirect(anon status: int64) -> bool {
    return status == 301 or status == 302 or status == 303 or status == 307 or status == 308
}

// `headers` without the named ones.
func without(anon headers: Headers, anon names: [str]) -> Headers {
    let out = Headers()
    for h in headers.items {
        mut drop = false
        for n in names {
            if h.name.lower() == n {
                drop = true
            }
        }
        if not drop {
            out.add(h.name, h.value)
        }
    }
    return out
}

// One request on its own connection, closed afterwards.
func fetch(anon method: str, anon url: str, options: Options = Options()) -> Response or Error {
    let client = Client(max_idle_per_host: 0)
    return try client.fetch(method, url, options: options)
}

func get(anon url: str, options: Options = Options()) -> Response or Error {
    return try fetch("GET", url, options: options)
}

func delete(anon url: str, options: Options = Options()) -> Response or Error {
    return try fetch("DELETE", url, options: options)
}

func post(anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
    return try fetch("POST", url, options: with_body(options, body, content_type))
}

func put(anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
    return try fetch("PUT", url, options: with_body(options, body, content_type))
}

func patch(anon url: str, anon body: bytes, content_type: str, options: Options = Options()) -> Response or Error {
    return try fetch("PATCH", url, options: with_body(options, body, content_type))
}
