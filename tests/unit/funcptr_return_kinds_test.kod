// A call through a function value has the function type's return kind.

type Holder = shared struct {
    fn: func(int64) -> str
}

func label(anon n: int64) -> str {
    return f"#{n}"
}

func shout(anon n: int64) -> int64 {
    return n * 100
}

func get_fn() -> func(int64) -> str {
    return label
}

test "calls through function values return str" {
    let f = label
    assert f"{f(1)}" == "#1"
    let fs = [label]
    assert f"{fs[0](2)}" == "#2"
    let h = Holder(fn: label)
    assert f"{h.fn(7)}" == "#7"
    assert f"{get_fn()(3)}" == "#3"
    let s = f(4)
    assert s + "!" == "#4!"
    let shout = label
    assert f"{shout(5)}" == "#5"
}
