// TLS 1.3 over a TCP connection, client and server, with Kod's own
// implementation (net/tls13). See docs/io.md#tls.

import "crypto/ecdsa"
import "crypto/rsa"
import "crypto/x509"
import "encoding/base64"
import "libc"
import "net/tcp"
import "net/tls13"
import "posix" { Fd, open_read }
import "stream" { IoError }
import "time" { Duration }
import "time"
import "unsafe"

let F_GETFL: int64 = 3
let F_SETFL: int64 = 4
let O_NONBLOCK: int64 = 4
// The most one read takes in, and the largest PEM file read.
let READ_MAX: int64 = 65536
let PEM_MAX: int64 = 16777216

func tls_error(anon op: str, anon detail: str) -> IoError {
    return IoError(kind: .Tls, op: op, errno: 0, detail: detail)
}

func closed(anon op: str) -> IoError {
    return IoError(kind: .InvalidInput, op: op, errno: 0, detail: "connection is closed")
}

type TlsStream = shared struct {
    // The connection, which is the stream's to close.
    conn: Fd
    session: tls13.Session
    // It is to be read no more, which the session needn't know: it can still write.
    cut: bool = false
    open: bool = true

    // At most `max` bytes, never more than 64 KiB; empty at the end of the
    // stream. A close between records, without a close notice, is the end too.
    func read(self, anon max: int64) -> bytes or Error {
        if not self.open {
            throw closed("read")
        }
        if self.cut {
            return b""
        }
        let got = self.session.read(min(max, READ_MAX))
        // Closed, and its connection with it, while this task waited.
        if not self.open {
            throw closed("read")
        }
        return try got
    }

    // Bytes written, at most 64 KiB of `data`: encrypted, they are held until
    // they have been sent.
    func write(self, anon data: bytes) -> int64 or Error {
        if not self.open {
            throw closed("write")
        }
        if len(data) == 0 {
            return 0
        }
        let sent = self.session.write(data[..min(len(data), READ_MAX)])
        if not self.open {
            throw closed("write")
        }
        return try sent
    }

    // Something can be read without waiting.
    func buffered(self) -> bool {
        return self.session.buffered()
    }

    // Nothing is waiting to be read, and the peer hasn't closed it.
    func is_idle(self) -> bool {
        return self.open and not self.session.buffered() and tcp.is_idle(self.conn)
    }

    func set_timeout(self, timeout: Duration) -> none or Error {
        try tcp.set_timeout(self.conn, :timeout)
    }

    // Send the close notice, as far as that doesn't have to wait.
    func end(self) -> none {
        let k = self.session
        if not k.peer.done() or k.flushing {
            return
        }
        let record = k.peer.close_notify()
        let fd = self.conn.fd
        let flags = libc.fcntl(fd, F_GETFL, 0)
        libc.fcntl(fd, F_SETFL, flags | O_NONBLOCK)
        libc.write(fd, unsafe.data(record), len(record))
        libc.fcntl(fd, F_SETFL, flags)
    }

    // Send the close notice and close the connection.
    func close(self) -> none or Error {
        if not self.open {
            throw closed("close")
        }
        self.open = false
        self.end()
        try self.conn.close()
    }
}

func connect(anon host: str, port: int64, trust_file: str = "", timeout: Duration = Duration(seconds: 10)) -> TlsStream or Error {
    let op = f"tls {host}:{port}"
    mut roots: [x509.Certificate] = []
    if len(trust_file) > 0 {
        let loaded = x509.load_roots(trust_file)
        if loaded is Error(e) {
            throw tls_error(op, f"could not read {trust_file}: {e.to_str()}")
        }
        roots = must loaded
        if len(roots) == 0 {
            throw tls_error(op, f"{trust_file} has no certificates")
        }
    } else {
        roots = try x509.system_roots()
    }
    let conn = try tcp.connect(host, port: port, timeout: timeout)
    try tcp.set_timeout(conn, timeout: timeout)
    let now = time.unix_ns() / 1000000000
    let session = tls13.connect(conn, host: host, roots: roots, now: now, op: op)
    if session is Error(e) {
        libc.close(conn.fd)
        throw e
    }
    try tcp.set_timeout(conn, timeout: Duration())
    return TlsStream(conn: conn, session: must session)
}

// ---- the server's side ----

// A certificate, those it was signed by, and its private key.
type Identity = shared struct {
    // The certificates, DER, the server's own first.
    chain: [bytes]
    key: tls13.SigningKey
    // False once closed: `accept` takes it no more.
    open: bool = true

    func close(self) -> none {
        self.open = false
    }
}

// One block of a PEM file.
type PemBlock = struct {
    label: str
    data: bytes
}

// The blocks of a PEM file; what is around them is left out.
func parse_pem(anon text: str, op: str) -> [PemBlock] or Error {
    mut out: [PemBlock] = []
    mut label = ""
    mut lines: [str] = []
    for raw in text.split("\n") {
        let line = raw.trim()
        if label == "" {
            if line.starts_with("-----BEGIN ") and line.ends_with("-----") and len(line) > 16 {
                label = line[11..len(line) - 5]
                lines = []
            }
        } else if line == f"-----END {label}-----" {
            let data = base64.decode("".join(lines))
            if data is Err(_) {
                throw tls_error(op, f"the {label} isn't base64")
            }
            out += [PemBlock(:label, :data)]
            label = ""
        } else {
            lines += [line]
        }
    }
    if label != "" {
        throw tls_error(op, f"the {label} has no end")
    }
    return out
}

// What is at the start of some DER: its tag, where its content is, and where it ends.
type Der = struct {
    tag: int64
    from: int64
    to: int64
}

// The element of `data` at `at`, which ends by `end`; none when that isn't one.
func der_at(anon data: bytes, anon at: int64, anon end: int64) -> Der? {
    if at + 2 > end or end > len(data) {
        return none
    }
    mut from = at + 2
    mut size = data[at + 1]
    if size >= 128 {
        let n = size - 128
        if n < 1 or n > 4 or from + n > end {
            return none
        }
        size = 0
        for k in 0..n {
            size = size << 8 | data[from + k]
        }
        from += n
    }
    if size > end - from {
        return none
    }
    return Der(tag: data[at], :from, to: from + size)
}

// The elements inside a sequence that is all of `data`.
func der_sequence(anon data: bytes) -> [Der] {
    if der_at(data, 0, len(data)) is Der(seq) and seq.tag == 0x30 {
        return der_parts(data, seq)
    }
    return []
}

// The elements inside `outer`, as far as they are whole.
func der_parts(anon data: bytes, anon outer: Der) -> [Der] {
    mut out: [Der] = []
    mut at = outer.from
    for at < outer.to {
        let Some(d) = der_at(data, at, outer.to) else {
            return out
        }
        out += [d]
        at = d.to
    }
    return out
}

// A private key: PKCS#1 for RSA; for EC, the public
// point and then the number.
type KeyData = struct {
    is_ec: bool
    data: bytes
}

// The key in a PKCS#8, PKCS#1 or SEC 1 block; none when it isn't one.
func key_data(anon block: PemBlock) -> KeyData? {
    if block.label == "RSA PRIVATE KEY" {
        return KeyData(is_ec: false, data: block.data)
    }
    if block.label == "EC PRIVATE KEY" {
        return ec_key(block.data)
    }
    // PKCS#8: a version, the algorithm, and the key in the form above.
    let data = block.data
    let parts = der_sequence(data)
    if len(parts) < 3 or parts[1].tag != 0x30 or parts[2].tag != 0x04 {
        return none
    }
    let algorithm = der_parts(data, parts[1])
    if len(algorithm) == 0 or algorithm[0].tag != 0x06 {
        return none
    }
    let oid = data[algorithm[0].from..algorithm[0].to]
    let inner = data[parts[2].from..parts[2].to]
    if oid == b"\x2a\x86\x48\x86\xf7\x0d\x01\x01\x01" {
        return KeyData(is_ec: false, data: inner)
    }
    if oid == b"\x2a\x86\x48\xce\x3d\x02\x01" {
        return ec_key(inner)
    }
    return none
}

// SEC 1: a version, the number, and (tagged 1) the public point.
func ec_key(anon data: bytes) -> KeyData? {
    let parts = der_sequence(data)
    if len(parts) < 2 or parts[1].tag != 0x04 {
        return none
    }
    for part in parts {
        if part.tag != 0xa1 {
            continue
        }
        let inner = der_parts(data, part)
        // A bit string of whole bytes, uncompressed: 4 and then two coordinates.
        if len(inner) != 1 or inner[0].tag != 0x03 or inner[0].to - inner[0].from < 4 or data[inner[0].from] != 0 {
            return none
        }
        let point = data[inner[0].from + 1..inner[0].to]
        let number = data[parts[1].from..parts[1].to]
        let size = (len(point) - 1) / 2
        if point[0] != 4 or len(number) > size {
            return none
        }
        return KeyData(is_ec: true, data: point + kod_bytes_from_array([0] * (size - len(number))) + number)
    }
    return none
}

func read_pem(anon path: str, op: str) -> [PemBlock] or Error {
    let file = try open_read(path)
    let data = file.read_all()
    try file.close()
    let pem = try data
    if len(pem) > PEM_MAX {
        throw tls_error(op, "the file is too large")
    }
    return try parse_pem(kod_bytes_to_str(pem), :op)
}

// A certificate and its private key, from PEM files: see docs/io.md#tls.
func load_identity(anon cert_file: str, anon key_file: str) -> Identity or Error {
    let cert_op = f"certificate {cert_file}"
    mut certs: [bytes] = []
    for block in try read_pem(cert_file, op: cert_op) {
        if block.label == "CERTIFICATE" {
            certs += [block.data]
        }
    }
    if len(certs) == 0 {
        throw tls_error(cert_op, "holds no certificate")
    }
    let key_op = f"key {key_file}"
    mut found: KeyData? = none
    for block in try read_pem(key_file, op: key_op) {
        if block.label == "ENCRYPTED PRIVATE KEY" {
            throw tls_error(key_op, "is encrypted")
        }
        if found is none and block.label.ends_with("PRIVATE KEY") {
            found = key_data(block)
            if found is none {
                throw tls_error(key_op, "isn't an RSA or EC private key")
            }
        }
    }
    let Some(key) = found else {
        throw tls_error(key_op, "holds no private key")
    }
    let parsed = x509.parse(certs[0])
    if parsed is Error {
        throw tls_error(cert_op, "isn't an X.509 certificate")
    }
    let leaf = must parsed
    if key.is_ec and leaf.key is .Other(oid) and len(oid) == 0 {
        throw tls_error(cert_op, "has an EC key whose curve isn't named")
    }
    let signing = try signing_key(key, leaf, :key_op)
    return Identity(chain: certs, key: signing)
}

// `key` as the TLS 1.3 server signs with it: RSA, or EC on P-256 or P-384,
// and the key of the certificate `leaf`.
func signing_key(anon key: KeyData, anon leaf: x509.Certificate, key_op: str) -> tls13.SigningKey or Error {
    let mismatch = tls_error(key_op, "isn't the key of the certificate")
    if not key.is_ec {
        let made = rsa.PrivateKey(key.data)
        if made is Error {
            throw tls_error(key_op, "isn't a valid key")
        }
        let private = must made
        // The certificate's key must check what this one signs.
        let probe = private.sign_pkcs1(algo: .Sha256, message: b"key check")
        if leaf.key is .Rsa(public) and rsa.verify_pkcs1(public, algo: .Sha256, message: b"key check", signature: probe) {
            return .Rsa(key: private)
        }
        throw mismatch
    }
    // An EC key: the point, then the scalar.
    let size = (len(key.data) - 1) / 3
    let curve = if size == 32 {
        ecdsa.Curve.P256
    } else if size == 48 {
        ecdsa.Curve.P384
    } else {
        throw tls_error(key_op, "is on a curve other than P-256 and P-384")
    }
    let point = key.data[..1 + 2 * size]
    let made = ecdsa.PrivateKey(curve, scalar: key.data[1 + 2 * size..])
    if made is Error {
        throw tls_error(key_op, "isn't a valid key")
    }
    let private = must made
    if not (leaf.key is .Ec(public) and public.point() == point and private.public_key().point() == point) {
        throw mismatch
    }
    return .Ec(key: private)
}

// The server's handshake on an accepted connection, which is the stream's from then on.
func accept(anon fd: Fd, anon identity: Identity) -> TlsStream or Error {
    let op = "tls accept"
    if not identity.open {
        let _ = fd.close()
        throw closed(op)
    }
    let session = tls13.server_session(fd, chain: identity.chain, key: identity.key, op: op)
    let shaken = session.handshake(op)
    if shaken is Err(e) {
        let _ = fd.close()
        throw e
    }
    return TlsStream(conn: fd, :session)
}
