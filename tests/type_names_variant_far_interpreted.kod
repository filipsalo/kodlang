// The interpreter names two enums of one name that the module can't write
// with their files, as the compiler does.
import "./type_names_both"

func main() -> int64 {
    let m = .On
    return type_names_both.total()
}

// expected status:
// 1
// expected stderr:
// 6:13: error: `.On` is ambiguous: `Mode (tests/type_names_pa.kod)` and `Mode (tests/type_names_pb.kod)` both declare it; give the value a type
// expected mode:
// interpret
