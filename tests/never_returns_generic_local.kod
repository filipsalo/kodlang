// A function of another module that ends in a method on a local of a
// generic instance never returns, though deciding that makes the
// instance in this module too.
import "./never_returns_generic_local_dep"

func pick(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    never_returns_generic_local_dep.die("negative")
}

func main() -> int64 {
    print_int(pick(1))
    print_int(pick(-1))
    return 0
}

// expected output:
// 1
// expected status:
// 1
// expected stderr:
// panic: negative
