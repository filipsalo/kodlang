// A default follows the block rules too: a match arm's binding in a
// parameter, field, method or interface method default hides the same name
// bound by an enclosing arm, and that one is back after the inner match.
func one() -> int64? {
    return 1
}

func two() -> int64? {
    return 20
}

func f(x: int64 = match one() {
    .Some(v) -> match two() {
        .Some(v) -> v
        else -> 0
    } + v
    else -> 0
}) -> int64 {
    return x
}

interface Sized {
    func size(self, by: int64 = match one() { .Some(v) -> match two() { .Some(v) -> v  else -> 0 } + v  else -> 0 }) -> int64
}

type Box = struct {
    n: int64 = match one() {
        .Some(v) -> match two() {
            .Some(v) -> v
            else -> 0
        } + v
        else -> 0
    }

    func size(self, by: int64 = match one() { .Some(v) -> match two() { .Some(v) -> v  else -> 0 } + v  else -> 0 }) -> int64 {
        return by
    }
}

func main() -> int64 {
    print_int(f())
    print_int(Box().n)
    let s: Sized = Box()
    print_int(s.size())
    return 0
}

// expected output:
// 21
// 21
// 21
