// \xHH is one byte; \u{H...} is a Unicode character written as UTF-8.

func bytes_of(anon s: str) -> str {
    mut out = ""
    mut i = 0
    for i < len(s) {
        out = out + f"{s[i]}"
        if i + 1 < len(s) {
            out = out + " "
        }
        i = i + 1
    }
    return out
}

test "hex and unicode escapes" {
    assert "\x41\x42\x43" == "ABC"
    assert bytes_of("\x00\x7f\x80\xff") == "0 127 128 255"
    assert bytes_of("\xC3\xA9") == "195 169"
    assert "\xC3\xA9" == "é"
    assert "\u{e9}" == "é"
    assert bytes_of("\u{41}") == "65"
    assert bytes_of("\u{e9}") == "195 169"
    assert bytes_of("\u{20AC}") == "226 130 172"
    assert bytes_of("\u{1F600}") == "240 159 152 128"
    assert bytes_of("\u{0}") == "0"
    // A NUL before a digit stays two bytes: the assembly's `\0` mustn't take
    // the digit as part of an octal escape.
    assert bytes_of("\u{0}1\u{0}77") == "0 49 0 55 55"
    assert bytes_of("\u{000041}") == "65"
    assert bytes_of("\u{10FFFF}") == "244 143 191 191"
    assert bytes_of("\u{7FF}\u{800}") == "223 191 224 160 128"
    assert "a\u{e9}b\x21" == "aéb!"
    assert "\u{1F600}" == "😀"
}

test "an escaped backslash and unknown escapes" {
    // A backslash escaped first is not the start of an escape.
    assert bytes_of("\\x41") == "92 120 52 49"
    assert bytes_of("\\u{e9}") == "92 117 123 101 57 125"
    assert len("\\x41") == 4

    // Unknown simple escapes are still dropped.
    assert len("\q") == 0
}

test "escapes in triple-quoted, byte and f-strings" {
    let block = """
        tab\x09here
        \u{e9}
        """
    assert bytes_of(block) == "116 97 98 9 104 101 114 101 10 195 169 10"

    let raw = b"\xFF\x00\u{e9}"
    assert len(raw) == 4
    let n = 2
    assert f"\u{e9}{n + 1}" == "é3"
    assert f"{n}\u{41}{n}" == "2A2"
    assert f"\x41{n}\u{1F600}" == "A2😀"
    assert f"{n}" + "\u{e9}" == "2é"
}
