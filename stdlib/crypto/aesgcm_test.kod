test "open refuses anything changed" {
    let key = aesgcm.Key(h("82483ae0263e4082b9881ce174f177ed595284bc67db0f1789aed574bd3802ef"))
    let nonce = h("a53faeebfdc6289dfa6cda82")
    let sealed = key.seal(b"attack at dawn", nonce: nonce, aad: b"header")
    assert key.open(sealed, nonce: nonce, aad: b"header") == b"attack at dawn"
    for i in 0..len(sealed) {
        mut changed = [b for b in sealed]
        changed[i] = changed[i] ^ 1
        assert key.open(kod_bytes_from_array(changed), nonce: nonce, aad: b"header") is none
    }
    assert key.open(sealed, nonce: nonce, aad: b"headers") is none
    assert key.open(sealed[..15], nonce: nonce, aad: b"header") is none
    assert key.open(sealed, nonce: h("1625b9addbbc836433804184"), aad: b"header") is none
}
