// A key-value service over HTTP (service.kod has the routes):
//
//   kod run examples/kv_service/kv_service.kod DIR [PORT]
//
// keeps its data in DIR (made if missing) and listens on PORT, 8080 if left
// out. Ctrl-C ends it, once the requests being answered are done.
import "io"
import "kv"
import "net/http"
import "./service"

func main(argv: [str]) -> int64 {
    if len(argv) < 2 or len(argv) > 3 {
        io.write_stderr("usage: kv_service DIR [PORT]\n")
        return 2
    }
    mut port: int64 = 8080
    if len(argv) == 3 {
        port = argv[2].parse_int()? or -1
    }
    if port < 0 {
        io.write_stderr("the port is a number\n")
        return 2
    }
    let db = kv.open(argv[1])
    if db is Err(e) {
        io.write_stderr(f"{e.to_str()}\n")
        return 1
    }
    print(f"listening on http://127.0.0.1:{port}, keeping {argv[1]}")
    if http.Server(:port, routes: service.routes(db), access_log: true).run() is Err(e) {
        io.write_stderr(f"{e.to_str()}\n")
        return 1
    }
    return 0
}
