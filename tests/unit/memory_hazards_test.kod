// Values a call could free from under its caller, and shapes that are easy to get wrong.
import "testing"

type Holder = shared struct {
    s: str
    h: Holder?
    xs: [str] = []
}

func clobber(anon h: Holder) -> str {
    h.s = "other" + "!"
    h.xs = []
    return "x" + "y"
}

func two(anon a: str, anon b: str) -> str {
    return a + b
}

func callee_clobbers(anon a: str, h: Holder) -> str {
    h.s = "gone" + "!"
    return a
}

func rebinds(anon a: str) -> str {
    let a = a + "1"
    return a
}

func mut_param(mut a: str) -> str {
    a = a + "2"
    a = a + "3"
    return a
}

type Shape = enum {
    Circle(name: str)
    Square(name: str, side: int64)
}

func name_of(anon s: Shape) -> str {
    return match s {
        .Circle(name) -> name
        .Square(name, _s) -> name
    }
}

interface Named {
    func name(self) -> str
}

type N = shared struct {
    n: str

    func name(self) -> str {
        return self.n
    }

    func me(self) -> N {
        return self
    }
}

func opt(anon on: bool) -> str? {
    if on {
        return "yes" + "!"
    }
    return none
}

func fallible(anon on: bool) -> str or Error {
    if on {
        return "ok" + "!"
    }
    throw E(m: "bad" + "!")
}

type E = shared struct {
    m: str

    func to_str(self) -> str {
        return self.m
    }
}

func chain() -> str or Error {
    let a = try fallible(true)
    let b = try fallible(false)
    return a + b
}

// An int64 in the middle of the address range the heap uses, in a name that held a reference.
func retyped() -> int64 {
    let x = "a" + "b"
    if len(x) > 0 {
        let x = 52776558133264
        print(x)
    }
    print(x)
    let x = 52776558133264
    return x
}

// A value in a slot past what a header's mask covers outlives the frame that made it.
type Far = shared struct {
    f0: int64 = 0
    f1: int64 = 0
    f2: int64 = 0
    f3: int64 = 0
    f4: int64 = 0
    f5: int64 = 0
    f6: int64 = 0
    f7: int64 = 0
    f8: int64 = 0
    f9: int64 = 0
    f10: int64 = 0
    f11: int64 = 0
    f12: int64 = 0
    f13: int64 = 0
    f14: int64 = 0
    f15: int64 = 0
    f16: int64 = 0
    f17: int64 = 0
    f18: int64 = 0
    f19: int64 = 0
    f20: int64 = 0
    f21: int64 = 0
    f22: int64 = 0
    f23: int64 = 0
    f24: int64 = 0
    f25: int64 = 0
    f26: int64 = 0
    f27: int64 = 0
    f28: int64 = 0
    f29: int64 = 0
    s: str = ""
    next: Far? = none
}

func far() -> Far {
    return Far(s: "far" + "!", next: Far(s: "next" + "!"))
}

test "a call can't free an argument from under its caller" {
    let h = Holder(s: "first" + "!", h: none)
    assert two(h.s, clobber(h)) == "first!xy"
    h.s = "second" + "!"
    assert callee_clobbers(h.s, :h) == "second!"
    assert rebinds("a" + "b") == "ab1"
    mut cd = "c" + "d"
    assert mut_param(a: mut cd) == "cd23"
}

test "a for loop keeps the array it walks" {
    let h = Holder(s: "first" + "!", h: none)
    h.xs = ["p" + "q", "r" + "s"]
    mut seen: [str] = []
    for x in h.xs {
        h.xs = []
        seen += [x]
    }
    assert seen == ["pq", "rs"]
}

test "enums, interfaces, optionals and results keep their strings" {
    assert name_of(.Circle(name: "circle" + "!")) == "circle!"
    assert name_of(.Square(name: "square" + "!", side: 2)) == "square!"

    let n: Named = N(n: "named" + "!")
    assert n.name() == "named!"
    assert N(n: "chain" + "!").me().me().name() == "chain!"

    mut got = ""
    if opt(true) is Some(v) {
        got = v
    }
    assert got == "yes!"
    assert (opt(false)? or "default" + "!") == "default!"

    let r = chain()
    mut msg = ""
    if r is Err(e) {
        msg = e.to_str()
    }
    assert msg == "bad!"
}

test "a string shared by two holders outlives one dropping it" {
    let shared = "shared" + "!"
    let a = Holder(s: shared, h: none)
    let b = Holder(s: shared, h: a)
    a.s = "changed" + "!"
    assert b.s == "shared!"
    assert (b.h? or a).s == "changed!"
}

test "a long list goes without taking the stack with it" {
    mut head = Holder(s: "0", h: none)
    for i in 1..200000 {
        head = Holder(s: "n", h: head)
    }
    head = Holder(s: "end", h: none)
    assert head.s == "end"
}

test "an alias keeps its value through slices, growth and overwriting" {
    mut xs: [str] = []
    for i in 0..100 {
        xs += [i.to_str()]
    }
    let alias = xs
    let tail = xs[90..]
    xs[95] = "changed" + "!"
    xs = []
    assert alias[95] == "95"
    assert tail[5] == "95"
    assert len(alias) == 100
}

test "a map keeps its values" {
    mut m = Map[str, str]()
    for i in 0..100 {
        m.set(i.to_str(), f"v{i}")
    }
    m.set("7", "seven" + "!")
    assert (m.get("7")? or "none") == "seven!"
    assert (m.get("99")? or "none") == "v99"
}

test "an int64 in a name that held a reference is not released" {
    let r = testing.run(func() {
        print(retyped())
    })
    assert r.status == 0
    assert r.stdout == "52776558133264\nab\n52776558133264\n"
}

test "a value past a header's mask outlives the frame that made it" {
    let fr = far()
    assert fr.s == "far!"
    assert (fr.next?.s? or "") == "next!"
}
