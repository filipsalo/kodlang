import "./type_names_cyclic"

interface Named {
    func name(self) -> str
}

type Pt = struct {
    y: int64

    func name(self) -> str {
        return f"dep pt {self.y}"
    }
}

type Shape = enum {
    Circle(r: int64)
    Dot
}

func boxed() -> type_names_cyclic.Named {
    return Pt(y: 42)
}

func show(anon p: type_names_cyclic.Pt) -> str {
    return p.name()
}

func show_own(anon p: Pt) -> str {
    return p.name()
}

func area(anon s: Shape) -> int64 {
    match s {
        .Circle(r) -> return r * 3
        .Dot -> return 0
    }
}

func area_main(anon s: type_names_cyclic.Shape) -> int64 {
    match s {
        .Circle(r) -> return r * 5
        .Dot -> return 1
    }
}

func sum(anon m: Map[str, type_names_cyclic.Pt], anon n: Map[str, Pt]) -> int64 {
    mut total = 0
    if m["a"] is Some(a) {
        total += a.x
    }
    if n["a"] is Some(b) {
        total += b.y
    }
    return total
}

