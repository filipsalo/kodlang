// An error in a generic body names the instance, once per line of the template.

type Color = enum {
    Red
    Green
}

func largest[T](a: T, b: T) -> T {
    if a < b {
        return b
    }
    return a
}

func unused[T](anon x: T) -> T {
    return x.no_such_method()
}

func main() -> int64 {
    let c = largest(a: Color.Red, b: Color.Green)
    let d = largest(a: Color.Green, b: Color.Red)
    print(c is .Red and d is .Red)
    print(largest(a: 1, b: 2))
    return 0
}

// expected errors:
// 9:8: error: `<` doesn't take `Color` operands (in `largest[Color]`)
