// A call through a function value whose type another module writes is
// reported at the call, whatever this module reports itself.
import "./param_limit_xmod_dep"

func own(anon a: int64, anon b: int64, anon c: int64, anon d: int64, anon e: int64, anon f: int64, anon g: int64, anon h: int64, anon i: int64) -> int64 {
    return a
}

type Holder[T] = struct {
    f: T

    func run(self) -> int64 {
        let g = self.f
        return g(1, 2, 3, 4, 5, 6, 7, 8, 9)
    }
}

func main() -> int64 {
    let h = param_limit_xmod_dep.get()
    let k = Holder[param_limit_xmod_dep.G9](f: h)
    return h(1, 2, 3, 4, 5, 6, 7, 8, 9) + k.run()
}

// expected errors:
// 5:6: error: `own` takes 9 parameters, but a function can take at most 8
// 14:16: error: `g` takes 9 parameters, but a function can take at most 8 (in `Holder[func(int64, int64, int64, int64, int64, int64, int64, int64, int64) -> int64]`)
// 21:12: error: `h` takes 9 parameters, but a function can take at most 8
