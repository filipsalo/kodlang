// Sorting. Both functions return a new array and are stable.

func _before[T](anon a: T, anon b: T) -> bool {
    return a < b
}

// Orders by `<`: `str`s by byte, structs by their `op_lt`.
func sorted[T](anon xs: [T]) -> [T] {
    return sorted_by(xs, less: _before[T])
}

// Bottom-up merge sort. `less(a, b)` says whether `a` goes before `b`.
func sorted_by[T](anon xs: [T], less: func(T, T) -> bool) -> [T] {
    let n = len(xs)
    mut cur: [T] = []
    for x in xs {
        cur += [x]
    }
    mut run = 1
    for run < n {
        mut next: [T] = []
        mut lo = 0
        for lo < n {
            let mid = _smaller(lo + run, n)
            let hi = _smaller(lo + run + run, n)
            mut i = lo
            mut j = mid
            // A right element goes first only if it's strictly before, which keeps the sort stable.
            for i < mid or j < hi {
                if j >= hi or (i < mid and not less(cur[j], cur[i])) {
                    next += [cur[i]]
                    i += 1
                } else {
                    next += [cur[j]]
                    j += 1
                }
            }
            lo = hi
        }
        cur = next
        run = run + run
    }
    return cur
}

func _smaller(anon a: int64, anon b: int64) -> int64 {
    if a < b {
        return a
    }
    return b
}
