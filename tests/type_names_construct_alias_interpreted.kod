// An alias of the same name in another module doesn't make the interpreter
// qualify a struct in its errors.
import "./type_names_alias_dep"
import "./type_names_pb"

func main() -> int64 {
    let p = type_names_pb.Pt(z: 3)
    return 0
}

// expected status:
// 1
// expected stderr:
// 7:30: error: struct `Pt` has no field `z`
// expected mode:
// interpret
