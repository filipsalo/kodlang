import "./../xmod_lambda_default_dep"

test "lambda defaults from another module" {
    let nine = func() -> int64 { return 9 }
    assert xmod_lambda_default_dep.run_lambda() == 7
    assert xmod_lambda_default_dep.run() == 1
    assert xmod_lambda_default_dep.run(cb: nine) == 9
    assert xmod_lambda_default_dep.bumped() == 2
}
