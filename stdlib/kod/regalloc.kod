// Linear-scan register allocator over the buffered instruction stream
// of a single function. The codegen hands out alloc-time physicals
// while emitting (so the produced asm reads naturally), but those
// initial assignments stack-discipline-only — they don't reuse a
// phys once its previous holder's last use is past. This pass walks
// the buffered body to compute per-vreg live intervals, then
// reassigns each vreg from a per-class free pool, expiring intervals
// whose last_use is at-or-before the current def line.
//
// The pass is constrained: a callee-saved vreg can only be rewritten
// to another callee-saved phys, and same for caller-saved. That
// preservation matters because every emit-time decision that asked
// `is_callee_saved(vreg)` (e.g. `spill_across` skipping the stash
// when the value lives in a callee-saved reg) must still get the
// same answer after rewriting.
//
// `pack` is a small follow-up that collapses the chosen callee-saved
// set into a dense `x19..x{19+N-1}` prefix and returns the new
// callee-saved high-water mark; the function prologue saves exactly
// that many registers instead of over-saving to cover gaps.

import "arrays"
import "kod/lexing"

// One line in a function's instruction buffer. `Label` lines hold a
// symbol, not asm, so the scan skips them; `Raw` lines hold the
// actual asm text and are what `subst_vregs` later rewrites at flush
// time. The variant is here (rather than alongside the codegen
// emitters that produce it) because the allocator is the only thing
// that has to *look at* the line structure — emitters just append.
type Insn = enum {
    Label(name: str)
    Raw(text: str)
}

// The pool of physical registers handed out as virtual registers
// during emission, plus the alloc-time mapping that the linear-scan
// pass (`run`) later refines. One `RegPool` lives on the codegen
// across the whole module; `reset` clears per-function state at the
// start of every `compile_func`.
//
// The free-pool order is intentional: callee-saved x19-x27 sit at
// the tail so `alloc_reg` (popping the tail) hands them out first.
// A value parked in a callee-saved reg survives any `bl` for free
// (the callee restores it), so the common shallow expressions never
// need a spill. Only deeper expressions spill into the caller-saved
// x8-x15 at the front, which still get stack-spilled around calls.
type PoolState = struct {
    free_regs: [str]
    cs_in_use: int64
    live: [str]
    // The frame slot each of `live` is saved in.
    slots: [int64] = []
}

type RegPool = struct {
    // Indexed by vreg id; entries accumulate across all functions
    // in a module so `subst_vregs` at flush-out time can resolve
    // any vreg consistently. NOT reset by `reset` — the ids are
    // program-global by design.
    vreg_phys: [str] = []

    // Per-function state — `reset` clears these at the start of
    // every compile_func.
    free_regs: [str] = []
    cs_in_use: int64 = 0
    cs_high_water: int64 = 0
    // The vregs handed out and not yet freed, for `evict`.
    live: [str] = []
    // Whether `evict` ran in this function, so `run` must leave it alone.
    evicted: bool = false

    // Reset per-function state. `vreg_phys` is intentionally left
    // alone — its ids stay valid across the whole module.
    func reset(self) -> none {
        self.free_regs = ["x15", "x14", "x13", "x12", "x11", "x10", "x9", "x8", "x27", "x26", "x25", "x24", "x23", "x22", "x21", "x20", "x19"]
        self.cs_in_use = 0
        self.cs_high_water = 0
        self.live = []
        self.evicted = false
    }

    // Hand every register back, for code too deep to compile with what is
    // left. The caller saves `live` to the frame around it, then calls
    // `restore`. Vregs now share physicals with ones that stay in use
    // after it, each pair apart only by that save, which `run` can't see.
    func evict(self) -> PoolState {
        let state = PoolState(free_regs: self.free_regs, cs_in_use: self.cs_in_use, live: self.live)
        self.free_regs = ["x15", "x14", "x13", "x12", "x11", "x10", "x9", "x8", "x27", "x26", "x25", "x24", "x23", "x22", "x21", "x20", "x19"]
        self.cs_in_use = 0
        self.live = []
        self.evicted = true
        return state
    }

    func restore(self, anon state: PoolState) -> none {
        self.free_regs = state.free_regs
        self.cs_in_use = state.cs_in_use
        self.live = state.live
    }

    // Allocate a fresh virtual register backed by a physical from
    // the free pool. The returned string is a vreg name (`v<id>`)
    // that the emit layer threads into asm; `subst_vregs` later
    // resolves it to `vreg_phys[id]`. The initial alloc-time
    // assignment is just whatever phys was at the tail of the pool;
    // `run` may rewrite it (within the same class) once the body
    // is buffered.
    func alloc_reg(self) -> str {
        let n = len(self.free_regs)
        if n == 0 {
            panic("compiler bug: out of registers; `compile_expr` evicts before this can happen, so a site is holding too many without compiling an expression")
        }
        mut phys = self.free_regs[-1]
        mut new_regs: [str] = []
        for i in 0..n - 1 {
            new_regs += [self.free_regs[i]]
        }
        self.free_regs = new_regs
        if self.is_callee_saved(phys) {
            self.cs_in_use = self.cs_in_use + 1
            if self.cs_in_use > self.cs_high_water {
                self.cs_high_water = self.cs_in_use
            }
        }
        let id: int64 = len(self.vreg_phys)
        self.vreg_phys += [phys]
        let name = f"v{id}"
        self.live += [name]
        return name
    }

    // Return a register to the pool. Accepts either a vreg name
    // (from `alloc_reg`) or a physical name passed in directly by
    // sites that hardcode ABI registers (e.g. freeing `x0` after a
    // `bl`). For the hardcoded path, x0-x7 are skipped — they hold
    // call args/results and never enter the pool.
    func free_reg(self, anon reg: str) -> none {
        mut phys: str = reg
        if self.is_vreg_name(reg) {
            phys = self.vreg_phys[self.parse_vreg_id(reg)]
            mut still_live: [str] = []
            for name in self.live {
                if name != reg {
                    still_live += [name]
                }
            }
            self.live = still_live
        }
        if phys == "x0" or phys == "x1" or phys == "x2" or phys == "x3" or phys == "x4" or phys == "x5" or phys == "x6" or phys == "x7" {
            return
        }
        if self.is_callee_saved(phys) {
            self.cs_in_use = self.cs_in_use - 1
        }
        self.free_regs += [phys]
    }

    // Whether the next alloc_reg hands out a register that survives a call.
    func next_is_callee_saved(self) -> bool {
        return len(self.free_regs) > 0 and is_callee_saved_phys(self.free_regs[-1])
    }

    // True if `reg` is (or resolves to) a callee-saved physical.
    // Accepts vreg names too — the alloc-time class is the one
    // recorded in `vreg_phys[id]`.
    func is_callee_saved(self, anon reg: str) -> bool {
        mut phys: str = reg
        if self.is_vreg_name(reg) {
            phys = self.vreg_phys[self.parse_vreg_id(reg)]
        }
        return is_callee_saved_phys(phys)
    }

    // True if `s` is a vreg name (the `v<digits>` form `alloc_reg`
    // returns). Anything else — a physical register name, an asm
    // literal — falls through unchanged.
    func is_vreg_name(self, anon s: str) -> bool {
        if len(s) < 2 or s[0] != 'v' {
            return false
        }
        for i in 1..len(s) {
            if not lexing.is_digit(s[i]) {
                return false
            }
        }
        return true
    }

    func parse_vreg_id(self, anon vreg: str) -> int64 {
        mut id: int64 = 0
        for i in 1..len(vreg) {
            id = id * 10 + vreg[i] - '0'
        }
        return id
    }
}

// Mnemonics whose first operand is the destination — for those a
// vreg at op-position 0 (outside brackets) is a def, not a use.
// Everything else treats all vreg operands as reads. ldp/stp don't
// appear with vregs in our codegen (only hardcoded sp/fp/lr/cs regs).
//
// Missing an entry here causes a silent miscompile: regalloc never
// sees the destination as a def, so the def_line stays -1 and the
// vreg keeps its alloc-time phys — but downstream vregs may end up
// sharing that phys because regalloc thinks the slot is free.
func is_writer_mnemonic(anon mn: str) -> bool {
    return mn == "mov" or mn == "add" or mn == "sub" or mn == "mul" or mn == "sdiv" or mn == "lsl" or mn == "lsr" or mn == "asr" or mn == "and" or mn == "orr" or mn == "eor" or mn == "adrp" or mn == "cset" or mn == "ldr" or mn == "ldrb" or mn == "fmov"
}

func is_callee_saved_phys(anon phys: str) -> bool {
    return phys == "x19" or phys == "x20" or phys == "x21" or phys == "x22" or phys == "x23" or phys == "x24" or phys == "x25" or phys == "x26" or phys == "x27"
}

// Dense callee-saved name by 0-based slot. `pack` writes back via
// these so the prologue can save `cs_reg(0)..cs_reg(N-1)` in order.
func cs_reg(anon n: int64) -> str {
    let names: [str] = ["x19", "x20", "x21", "x22", "x23", "x24", "x25", "x26", "x27", "x28"]
    return names[n]
}

// Mangled labels join user names with `$` (`$main$v2`), so a
// `v<digits>` run touching any symbol character is not a vreg.
func is_sym_char(anon c: int64) -> bool {
    return lexing.is_alnum(c) or c == '$' or c == '.'
}

// Index just past the quoted string opening at `text[start]` (with
// `emit_asciz`'s escapes); string data never holds vregs.
func skip_quoted(anon text: str, start: int64) -> int64 {
    let n: int64 = len(text)
    mut j: int64 = start + 1
    for j < n and text[j] != '"' {
        if text[j] == '\\' {
            j = j + 1
        }
        j = j + 1
    }
    if j >= n {
        return n
    }
    return j + 1
}

// Scan one Raw line, mutating `def_line` / `last_use` for any vreg
// tokens it contains. A vreg token is `v<digits>` or `w<digits>` not
// touching a symbol character (see `is_sym_char`) and outside string
// quotes; the `w` form is the 32-bit alias used by the single
// byte-load site. A vreg in the first operand of a writer mnemonic
// (outside brackets) is a def; everything else is a use.
// Returns whether the line calls something (`bl`, `blr`, but not a panic) or names one of
// the caller-saved x8-x15 itself, so a value in one of those doesn't
// survive it; and records in `first` the line each vreg is first named on.
func never_returns(anon target: str) -> bool {
    return target == "_kod_index_oob" or target == "_kod_div_zero" or target == "_kod_panic"
}

func scan_line(anon text: str, line_idx: int64, vreg_start: int64, n_local: int64, def_line: [int64], last_use: [int64], first: [int64]) -> bool {
    let n: int64 = len(text)
    mut i: int64 = 0
    for i < n and (text[i] == '\t' or text[i] == ' ') {
        i = i + 1
    }
    let mn_start: int64 = i
    for i < n and lexing.is_alpha(text[i]) {
        i = i + 1
    }
    if i == mn_start {
        return false
    }
    let mnemonic: str = text[mn_start..i]
    // A panic never comes back, so whatever it clobbers isn't read after it.
    mut clobbers = mnemonic == "blr" or (mnemonic == "bl" and not never_returns(text[i..n].trim()))
    let writes_first: bool = is_writer_mnemonic(mnemonic)
    mut op_index: int64 = 0
    mut bracket_depth: int64 = 0
    for i < n {
        let c: int64 = text[i]
        if c == '[' {
            bracket_depth = bracket_depth + 1
            i = i + 1
        } else if c == ']' {
            bracket_depth = bracket_depth - 1
            i = i + 1
        } else if c == ',' and bracket_depth == 0 {
            op_index = op_index + 1
            i = i + 1
        } else if c == '"' {
            i = skip_quoted(text, start: i)
        } else if (c == 'v' or c == 'w') and i + 1 < n and lexing.is_digit(text[i + 1]) {
            mut boundary: bool = true
            if i > 0 and is_sym_char(text[i - 1]) {
                boundary = false
            }
            if not boundary {
                i = i + 1
                continue
            }
            mut j: int64 = i + 1
            mut id: int64 = 0
            for j < n and lexing.is_digit(text[j]) {
                id = id * 10 + text[j] - '0'
                j = j + 1
            }
            mut ends_clean: bool = true
            if j < n and is_sym_char(text[j]) {
                ends_clean = false
            }
            if not ends_clean or id < vreg_start or id >= vreg_start + n_local {
                i = j
                continue
            }
            let local_id: int64 = id - vreg_start
            if first[local_id] < 0 {
                first[local_id] = line_idx
            }
            let is_def: bool = writes_first and op_index == 0 and bracket_depth == 0
            if is_def and def_line[local_id] == -1 {
                def_line[local_id] = line_idx
            }
            last_use[local_id] = line_idx
            i = j
        } else if c == 'x' and i + 1 < n and lexing.is_digit(text[i + 1]) and (i == 0 or not is_sym_char(text[i - 1])) {
            mut j: int64 = i + 1
            mut num: int64 = 0
            for j < n and lexing.is_digit(text[j]) {
                num = num * 10 + text[j] - '0'
                j = j + 1
            }
            if (j == n or not is_sym_char(text[j])) and num >= 8 and num <= 15 {
                clobbers = true
            }
            i = j
        } else {
            i = i + 1
        }
    }
    return clobbers
}

// How many times each of the function's vregs (ids vreg_start up to
// vreg_start + n_local) is named in `body`, as a def or a use.
func vreg_counts(anon body: [Insn], vreg_start: int64, n_local: int64) -> [int64] {
    mut counts: [int64] = []
    for _ in 0..n_local {
        counts += [0]
    }
    for insn in body {
        let .Raw(text) = insn else { continue }
        let n = len(text)
        mut i: int64 = 0
        for i < n {
            let c = text[i]
            if c == '"' {
                i = skip_quoted(text, start: i)
            } else if (c == 'v' or c == 'w') and i + 1 < n and lexing.is_digit(text[i + 1]) and (i == 0 or not is_sym_char(text[i - 1])) {
                mut j = i + 1
                mut id: int64 = 0
                for j < n and lexing.is_digit(text[j]) {
                    id = id * 10 + text[j] - '0'
                    j += 1
                }
                if (j == n or not is_sym_char(text[j])) and id >= vreg_start and id < vreg_start + n_local {
                    counts[id - vreg_start] += 1
                }
                i = j
            } else {
                i += 1
            }
        }
    }
    return counts
}

// Constrained linear scan for one function's vregs. Vregs are
// partitioned by alloc-time class; each class's pool is the set of
// distinct alloc-time physicals from that class. Walk vregs in
// def_line order; expire intervals that ended before the current
// def; pop a free phys (preferring reuse). Mutates `pool.vreg_phys`
// in place over `[vreg_start, len(pool.vreg_phys))`.
//
// `strict` is for a body whose vregs aren't all expression temporaries (see
// codegen's promote_locals): a vreg live at the top of a loop is kept to the
// loop's backward branch, every register is in the pools, and running out of
// them is a failure (false) instead of a fall back to the alloc-time
// register, which only temporaries can share safely.
func run(body_buf: [Insn], pool: RegPool, vreg_start: int64, strict: bool = false) -> bool {
    let vreg_phys: [str] = pool.vreg_phys
    let vreg_end: int64 = len(vreg_phys)
    let n_local: int64 = vreg_end - vreg_start
    if n_local <= 0 {
        return true
    }

    mut def_line: [int64] = []
    mut last_use: [int64] = []
    mut first: [int64] = []
    for k in 0..n_local {
        def_line += [-1]
        last_use += [-1]
        first += [-1]
    }

    // clobbers_before[k]: how many lines before line k call something or
    // name a caller-saved register outright.
    mut clobbers_before: [int64] = [0]
    mut line_idx: int64 = 0
    for insn in body_buf {
        mut clobbers = 0
        match insn {
            .Raw(text) -> {
                if scan_line(text, :line_idx, :vreg_start, :n_local, :def_line, :last_use, :first) {
                    clobbers = 1
                }
            }
            .Label(_name) -> {
                // Label lines hold a symbol, not asm — no vregs.
            }
        }
        clobbers_before += [clobbers_before[line_idx] + clobbers]
        line_idx = line_idx + 1
    }

    if strict {
        // A vreg named before its first def (a loop reading what the
        // previous time round set) is live from there.
        for k in 0..n_local {
            if first[k] >= 0 and (def_line[k] < 0 or first[k] < def_line[k]) {
                def_line[k] = first[k]
            }
        }
        extend_over_loops(body_buf, :def_line, :last_use)
    }

    // Snapshot alloc-time phys per local vreg; this is also the
    // pool we draw from (deduped, partitioned by class).
    mut alloc_phys: [str] = []
    for k in 0..n_local {
        alloc_phys += [vreg_phys[vreg_start + k]]
    }

    mut free_callee: [str] = []
    mut free_caller: [str] = []
    for k in 0..n_local {
        let p: str = alloc_phys[k]
        if is_callee_saved_phys(p) {
            if not arrays.contains(free_callee, p) {
                free_callee += [p]
            }
        } else {
            if not arrays.contains(free_caller, p) {
                free_caller += [p]
            }
        }
    }
    // A callee-saved vreg that no call or named scratch register comes
    // between the def and the last use of can take any caller-saved one,
    // which the prologue needn't save.
    for p in ["x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15"] {
        if not arrays.contains(free_caller, p) {
            free_caller = [p] + free_caller
        }
    }
    if strict {
        for p in ["x19", "x20", "x21", "x22", "x23", "x24", "x25", "x26", "x27"] {
            if not arrays.contains(free_callee, p) {
                free_callee = [p] + free_callee
            }
        }
    }
    mut ok = true

    // Sort vreg indices by def_line ascending. Insertion sort; n_local
    // is typically small per function.
    mut order: [int64] = []
    for k in 0..n_local {
        order += [k]
    }
    for s in 1..n_local {
        mut t: int64 = s
        for t > 0 and def_line[order[t - 1]] > def_line[order[t]] {
            let tmp: int64 = order[t]
            order[t] = order[t - 1]
            order[t - 1] = tmp
            t = t - 1
        }
    }

    // Walk vregs in def order; maintain active list (alive intervals).
    mut active_id: [int64] = []
    mut active_use: [int64] = []
    mut active_phys: [str] = []
    mut new_phys: [str] = []
    for k in 0..n_local {
        new_phys += [alloc_phys[k]]
    }

    for oi in 0..n_local {
        let local_id: int64 = order[oi]
        let d: int64 = def_line[local_id]
        if d == -1 {
            // Allocated but never defined in the emitted body — keep
            // its alloc-time phys (the safe default), unless it isn't
            // named at all, when it needn't count as a register to save.
            if last_use[local_id] == -1 {
                new_phys[local_id] = "x8"
            }
            continue
        }
        mut cls_callee: bool = is_callee_saved_phys(alloc_phys[local_id])
        let u: int64 = last_use[local_id]
        if cls_callee and u > d and clobbers_before[u] - clobbers_before[d + 1] == 0 {
            cls_callee = false
        }

        // Expire actives whose last_use <= this def line. The `<=`
        // (vs `<`) lets a `mov vDst, vSrc` whose vSrc dies at the mov
        // hand its phys to vDst on the spot — the mov substitutes to
        // `mov xN, xN` (self-mov) which `flush_out` drops. ARM64 reads
        // all sources before writing the dest, so sharing a phys
        // between dying-source and just-defined-dest on the same line
        // is well-defined for every mnemonic we emit.
        mut na_id: [int64] = []
        mut na_use: [int64] = []
        mut na_phys: [str] = []
        for ai in 0..len(active_id) {
            if active_use[ai] <= d {
                let ap: str = active_phys[ai]
                if is_callee_saved_phys(ap) {
                    free_callee += [ap]
                } else {
                    free_caller += [ap]
                }
            } else {
                na_id += [active_id[ai]]
                na_use += [active_use[ai]]
                na_phys += [active_phys[ai]]
            }
        }
        active_id = na_id
        active_use = na_use
        active_phys = na_phys

        // Pop a phys from the matching class's free pool.
        mut chosen: str = ""
        if cls_callee {
            if len(free_callee) > 0 {
                chosen = free_callee[len(free_callee) - 1]
                mut nfc: [str] = []
                mut fi: int64 = 0
                for fi < len(free_callee) - 1 {
                    nfc += [free_callee[fi]]
                    fi = fi + 1
                }
                free_callee = nfc
            }
        } else {
            if len(free_caller) > 0 {
                chosen = free_caller[len(free_caller) - 1]
                mut nfc2: [str] = []
                mut fi2: int64 = 0
                for fi2 < len(free_caller) - 1 {
                    nfc2 += [free_caller[fi2]]
                    fi2 = fi2 + 1
                }
                free_caller = nfc2
            }
        }
        if len(chosen) == 0 {
            // Without `strict` this can't happen: pool size equals
            // alloc-time pressure. Fall back to the alloc-time phys.
            ok = false
            chosen = alloc_phys[local_id]
        }
        new_phys[local_id] = chosen
        active_id += [local_id]
        active_use += [last_use[local_id]]
        active_phys += [chosen]
    }

    // Write back.
    for k in 0..n_local {
        vreg_phys[vreg_start + k] = new_phys[k]
    }
    return ok or not strict
}

// The label a branch jumps to (`b L`, `beq L`, `b.ne L`, `cbz x1, L`,
// `tbnz x1, #3, L`), or "" for anything else, a call included.
func branch_target(anon text: str) -> str {
    let n = len(text)
    mut i: int64 = 0
    for i < n and (text[i] == '\t' or text[i] == ' ') {
        i += 1
    }
    let start = i
    for i < n and (lexing.is_alpha(text[i]) or text[i] == '.') {
        i += 1
    }
    let mn = text[start..i]
    mut is_branch = mn == "b" or mn == "cbz" or mn == "cbnz" or mn == "tbz" or mn == "tbnz"
    if not is_branch and len(mn) >= 3 and mn[0] == 'b' {
        mut cond = mn[1..len(mn)]
        if cond[0] == '.' {
            cond = cond[1..len(cond)]
        }
        is_branch = arrays.contains(["eq", "ne", "hs", "cs", "lo", "cc", "mi", "pl", "vs", "vc", "hi", "ls", "ge", "lt", "gt", "le"], cond)
    }
    if not is_branch {
        return ""
    }
    mut j = n
    for j > i and (text[j - 1] == ' ' or text[j - 1] == '\t') {
        j -= 1
    }
    mut k = j
    for k > i and text[k - 1] != ' ' and text[k - 1] != ',' and text[k - 1] != '\t' {
        k -= 1
    }
    return text[k..j]
}

// A vreg live at a loop's top label, set before the loop, stays live to
// the loop's backward branch, which takes its value round again: the
// textual interval alone would end at its last use inside the loop.
func extend_over_loops(anon body: [Insn], def_line: [int64], last_use: [int64]) -> none {
    let label_line = Map[str, int64]()
    for i, insn in body {
        if insn is .Label(name) {
            label_line.set(name, i)
        }
    }
    mut tops: [int64] = []
    mut bottoms: [int64] = []
    for i, insn in body {
        if insn is .Raw(text) {
            let target = branch_target(text)
            if len(target) > 0 {
                if label_line.get(target) is Some(t) {
                    if t <= i {
                        tops += [t]
                        bottoms += [i]
                    }
                }
            }
        }
    }
    if len(tops) == 0 {
        return none
    }
    mut changed = true
    for changed {
        changed = false
        for k in 0..len(def_line) {
            let d = def_line[k]
            if d < 0 {
                continue
            }
            for e in 0..len(tops) {
                let u = last_use[k]
                if d < tops[e] and u >= tops[e] and u < bottoms[e] {
                    last_use[k] = bottoms[e]
                    changed = true
                }
            }
        }
    }
}

// Pack the function's actually-used callee-saved registers into a
// dense `x19..x{19+N-1}` prefix and return `N` (the new
// callee-saved high-water mark).
//
// The prologue/epilogue saves the FIRST `N` callee-saved registers
// (cs_reg(0)=x19, cs_reg(1)=x20, …); regalloc can leave gaps in that
// sequence (e.g. use x19 and x21 but skip x20), and the alloc-time
// high-water mark over-saves to cover them. Packing makes the saved
// set match the used set exactly, dropping unnecessary stp/ldp pairs
// from the prologue.
//
// Safe because all reassignments stay inside the callee-saved class —
// every site that asked `is_callee_saved(vreg)` at emit time still
// gets the same answer, so spill_across decisions remain correct.
func pack(pool: RegPool, vreg_start: int64) -> int64 {
    let vreg_phys: [str] = pool.vreg_phys
    let vreg_end: int64 = len(vreg_phys)
    mut used: [str] = []
    for i in vreg_start..vreg_end {
        let p: str = vreg_phys[i]
        if is_callee_saved_phys(p) and not arrays.contains(used, p) {
            used += [p]
        }
    }
    for i in vreg_start..vreg_end {
        let p: str = vreg_phys[i]
        if is_callee_saved_phys(p) {
            mut j: int64 = 0
            mut found: int64 = -1
            for j < len(used) and found < 0 {
                if used[j] == p {
                    found = j
                }
                j = j + 1
            }
            if found >= 0 {
                vreg_phys[i] = cs_reg(found)
            }
        }
    }
    return len(used)
}
