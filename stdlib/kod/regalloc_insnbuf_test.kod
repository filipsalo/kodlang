// regalloc.InsnBuf keeps instructions as numbers and a string table, and
// gives each back exactly as it was pushed (docs/ir.md, step 12).

import "kod/regalloc"

func r(anon name: str) -> regalloc.Reg {
    return regalloc.reg_of(name)
}

func bool_text(anon b: bool) -> str {
    if b {
        return "true"
    }
    return "false"
}

func at_text(anon at: regalloc.MemAt) -> str {
    match at {
        .Base -> return "Base"
        .Offset(off) -> return f"Offset({off})"
        .Index(reg, scaled) -> return f"Index({reg}, {bool_text(scaled)})"
        .Symbol(name, got) -> return f"Symbol({name}, {bool_text(got)})"
    }
}

func mode_text(anon mode: regalloc.PairMode) -> str {
    match mode {
        .At(off) -> return f"At({off})"
        .Pre(off) -> return f"Pre({off})"
        .Post(off) -> return f"Post({off})"
    }
}

func kind_text(anon kind: regalloc.BranchKind) -> str {
    match kind {
        .Always -> return "Always"
        .If(cond) -> return f"If({regalloc.cond_number(cond)})"
        .IfZero -> return "IfZero"
        .IfNonzero -> return "IfNonzero"
    }
}

// Every field of `insn`, so two texts are equal only for equal instructions.
func text(anon insn: regalloc.Insn) -> str {
    match insn {
        .Label(name) -> return f"Label({name})"
        .Slot(store, reg, off) -> return f"Slot({bool_text(store)}, {reg}, {off})"
        .Mov(dst, src) -> return f"Mov({dst}, {src})"
        .Mem(load, width, reg, base, at) -> return f"Mem({bool_text(load)}, {width}, {reg}, {base}, {at_text(at)})"
        .Data(t) -> return f"Data({t})"
        .Intrinsic(label) -> return f"Intrinsic({label})"
        .LoadConst(dst, value) -> return f"LoadConst({dst}, {value})"
        .Pair(load, a, b, base, mode) -> return f"Pair({bool_text(load)}, {a}, {b}, {base}, {mode_text(mode)})"
        .Op(op, a, b, c, d, flags) -> return f"Op({regalloc.opcode_number(op)}, {a}, {b}, {c}, {d}, {flags})"
        .Call(target) -> return f"Call({target})"
        .Branch(kind, reg, target) -> return f"Branch({kind_text(kind)}, {reg}, {target})"
    }
}

func all_conds() -> [regalloc.Cond] {
    return [.Eq, .Ne, .Hs, .Lo, .Hi, .Ls, .Mi, .Pl, .Vs, .Vc, .Ge, .Lt, .Gt, .Le]
}

func all_opcodes() -> [regalloc.Opcode] {
    return [.Move, .Add, .Sub, .Mul, .DivSigned, .And, .Or, .Xor, .ShiftLeft, .ShiftRight, .ShiftRightSigned, .Compare, .CompareIf, .SetIf, .Select, .AddressPage, .FloatMove, .FloatAdd, .FloatSub, .FloatMul, .FloatDiv, .FloatNeg, .FloatCompare, .CallIndirect, .Return]
}

// One of every variant and every shape of the enums inside them.
func samples() -> [regalloc.Insn] {
    let big: int64 = 9223372036854775807
    let low: int64 = -9223372036854775807 - 1
    mut out: [regalloc.Insn] = [
        .Label(name: "Lstart"),
        .Label(name: ""),
        .Slot(store: false, reg: r("x1"), off: -8),
        .Slot(store: true, reg: regalloc.vreg(12), off: 0),
        .Slot(store: true, reg: regalloc.NO_REG, off: big),
        .Mov(dst: r("x0"), src: r("x19")),
        .Mov(dst: regalloc.NO_REG, src: regalloc.wvreg(70000)),
        .Data(text: "\t.quad 0"),
        .Intrinsic(label: "_kod_str_len"),
        .LoadConst(dst: regalloc.vreg(3), value: big),
        .LoadConst(dst: r("x9"), value: low),
        .LoadConst(dst: r("x9"), value: -1),
        .Call(target: "_rc_retain_stub"),
        .Branch(kind: .Always, reg: regalloc.NO_REG, target: "Lend"),
        .Branch(kind: .IfZero, reg: regalloc.vreg(5), target: "Lz"),
        .Branch(kind: .IfNonzero, reg: r("x17"), target: "Lnz"),
    ]
    for load in [false, true] {
        for width in [1, 2, 4, 8] {
            out += [.Mem(:load, :width, reg: regalloc.wvreg(1), base: r("x8"), at: .Base)]
            out += [.Mem(:load, :width, reg: r("x3"), base: r("fp"), at: .Offset(off: -32768))]
            out += [.Mem(:load, :width, reg: r("x3"), base: r("x4"), at: .Offset(off: big))]
            out += [.Mem(:load, :width, reg: r("x7"), base: r("x8"), at: .Index(reg: r("x9"), scaled: false))]
            out += [.Mem(:load, :width, reg: r("x7"), base: r("x8"), at: .Index(reg: regalloc.vreg(9), scaled: true))]
            out += [.Mem(:load, :width, reg: r("x7"), base: r("x8"), at: .Symbol(name: "_kod_global", got: false))]
            out += [.Mem(:load, :width, reg: r("x7"), base: r("x8"), at: .Symbol(name: "_kod_other", got: true))]
        }
        out += [.Pair(:load, a: r("fp"), b: r("lr"), base: r("sp"), mode: .At(off: 0))]
        out += [.Pair(:load, a: r("x19"), b: r("x20"), base: r("sp"), mode: .Pre(off: -16))]
        out += [.Pair(:load, a: r("x21"), b: r("x22"), base: r("sp"), mode: .Post(off: 16))]
        out += [.Pair(:load, a: regalloc.NO_REG, b: regalloc.NO_REG, base: r("x1"), mode: .At(off: low))]
    }
    for cond in all_conds() {
        out += [.Branch(kind: .If(:cond), reg: regalloc.NO_REG, target: "Lif")]
    }
    for op in all_opcodes() {
        out += [regalloc.op(op, a: r("x1"), b: r("x2"), c: r("#4096"), d: r("eq"))]
        out += [.Op(:op, a: regalloc.NO_REG, b: regalloc.NO_REG, c: regalloc.NO_REG, d: regalloc.NO_REG, flags: 0)]
        out += [.Op(:op, a: regalloc.vreg(1), b: low, c: big, d: -4, flags: -1)]
    }
    return out
}

test "every instruction round-trips through push and at" {
    let insns = samples()
    let buf = regalloc.InsnBuf()
    for insn in insns {
        buf.push(insn)
    }
    assert buf.len() == len(insns)
    for i, insn in insns {
        assert text(buf.at(i)) == text(insn)
    }
    let back = buf.to_insns()
    assert len(back) == len(insns)
    for i, insn in insns {
        assert text(back[i]) == text(insn)
    }
}

test "insn_buf and set" {
    let insns = samples()
    let buf = regalloc.insn_buf(insns)
    assert buf.len() == len(insns)
    // Each instruction written over every other one's place.
    for i in 0..len(insns) {
        let j = len(insns) - 1 - i
        buf.set(i, insn: insns[j])
    }
    for i in 0..len(insns) {
        assert text(buf.at(i)) == text(insns[len(insns) - 1 - i])
    }
}

test "an empty buffer" {
    let buf = regalloc.InsnBuf()
    assert buf.len() == 0
    assert len(buf.to_insns()) == 0
}

// `insn` through the field-level push of its variant.
func push_fields(anon buf: regalloc.InsnBuf, insn: regalloc.Insn) -> none {
    match insn {
        .Label(name) -> buf.push_label(name)
        .Slot(store, reg, off) -> buf.push_slot(:store, :reg, :off)
        .Mov(dst, src) -> buf.push_mov(:dst, :src)
        .Mem(load, width, reg, base, at) -> {
            match at {
                .Base -> buf.push_mem(:load, :width, :reg, :base)
                .Offset(off) -> buf.push_mem_offset(:load, :width, :reg, :base, :off)
                .Index(index, scaled) -> buf.push_mem_index(:load, :width, :reg, :base, :index, :scaled)
                .Symbol(name, got) -> buf.push_mem_symbol(:load, :width, :reg, :base, :name, :got)
            }
        }
        .Data(t) -> buf.push_data(t)
        .Intrinsic(label) -> buf.push_intrinsic(label)
        .LoadConst(dst, value) -> buf.push_load_const(:dst, :value)
        .Pair(load, a, b, base, mode) -> buf.push_pair(:load, :a, :b, :base, :mode)
        .Op(op, a, b, c, d, flags) -> buf.push_op(op, :a, :b, :c, :d, :flags)
        .Call(target) -> buf.push_call(target)
        .Branch(kind, reg, target) -> {
            match kind {
                .If(cond) -> buf.push_branch_if(cond, :reg, :target)
                else buf.push_branch(:kind, :reg, :target)
            }
        }
    }
}

test "each field-level push stores what push of the same Insn does" {
    let insns = samples()
    for insn in insns {
        let whole = regalloc.InsnBuf()
        whole.push(insn)
        let fields = regalloc.InsnBuf()
        push_fields(fields, insn: insn)
        assert fields.len() == 1
        assert fields.tags[0] == whole.tags[0]
        assert fields.fa[0] == whole.fa[0]
        assert fields.fb[0] == whole.fb[0]
        assert fields.fc[0] == whole.fc[0]
        assert fields.fd[0] == whole.fd[0]
        assert fields.fe[0] == whole.fe[0]
        assert len(fields.strs) == len(whole.strs)
        for k, t in whole.strs {
            assert fields.strs[k] == t
        }
        assert text(fields.at(0)) == text(insn)
    }
    // All of them in one buffer, past several grows.
    let buf = regalloc.InsnBuf()
    for insn in insns {
        push_fields(buf, insn: insn)
    }
    assert buf.len() == len(insns)
    for i, insn in insns {
        assert text(buf.at(i)) == text(insn)
    }
}

test "clear keeps nothing but the room" {
    let buf = regalloc.insn_buf(samples())
    buf.clear()
    assert buf.len() == 0
    assert len(buf.strs) == 0
    buf.push_label("Lagain")
    buf.push_call("_f")
    assert buf.len() == 2
    assert text(buf.at(0)) == "Label(Lagain)"
    assert text(buf.at(1)) == "Call(_f)"
}

test "push_from, pop and label" {
    let insns = samples()
    let src = regalloc.insn_buf(insns)
    let buf = regalloc.InsnBuf()
    buf.push_label("Lfirst")
    for i in 0..src.len() {
        buf.push_from(src, :i)
    }
    buf.push_call("_extra")
    buf.pop()
    assert buf.len() == len(insns) + 1
    assert buf.label(0) == "Lfirst"
    for i, insn in insns {
        assert text(buf.at(i + 1)) == text(insn)
        if insn is .Label(name) {
            assert buf.label(i + 1) == name
        } else {
            assert buf.label(i + 1) == ""
        }
    }
}
