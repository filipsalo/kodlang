test "an unannotated generic enum constructor can't be inferred" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        func main() -> int64 {
            let m = Maybe.Just(value: 41)
            match m {
                .Just(value) -> print_int(value + 1)
                .Nothing -> print("nothing")
            }
            let c = .Just(value: 7)
            let n = Maybe.Nothing
            let r = Result.Ok(5)
            let o = Option.Some(3)
            if o is .Some(x) {
                print_int(x * 3)
            }
            match Maybe.Just(value: 1) {
                .Just(v) -> print_int(v)
                else -> {}
            }
            return 0
        }
        """)
    assert len(errs) == 6
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `m`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `c`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `n`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `r`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `o`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of this expression; bind it to an annotated `let` first")
}

test "a value going to a declared type isn't told to get an annotation" {
