// Environment variables. See docs/builtins.md.

import "unsafe"

extern func getenv(anon name: int64) -> int64
extern func setenv(anon name: int64, anon value: int64, anon overwrite: int64) -> int64
extern func unsetenv(anon name: int64) -> int64

// A name an environment can hold: not empty, no `=`, no NUL byte.
func valid_name(anon name: str) -> bool {
    if len(name) == 0 {
        return false
    }
    let n = len(name)
    mut i: int64 = 0
    for i < n {
        if name[i] == 61 or name[i] == 0 {
            return false
        }
        i = i + 1
    }
    return true
}

func has_nul(anon s: str) -> bool {
    let n = len(s)
    mut i: int64 = 0
    for i < n {
        if s[i] == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

func get(anon name: str) -> str? {
    if not valid_name(name) {
        return none
    }
    let value = getenv(unsafe.c_str(name))
    if value == 0 {
        return none
    }
    return unsafe.str_at(value)
}

func set(anon name: str, anon value: str) -> none or Error {
    if not valid_name(name) {
        throw InvalidName(name: name)
    }
    if has_nul(value) {
        throw InvalidValue(name: name)
    }
    if unsafe.c_int(setenv(unsafe.c_str(name), unsafe.c_str(value), 1)) < 0 {
        throw InvalidName(name: name)
    }
}

func unset(anon name: str) -> none {
    if valid_name(name) {
        unsetenv(unsafe.c_str(name))
    }
}

type InvalidName = struct {
    name: str

    func to_str(self) -> str {
        return "env: " + self.name + " is not a valid variable name"
    }
}

type InvalidValue = struct {
    name: str

    func to_str(self) -> str {
        return "env: the value for " + self.name + " has a NUL byte"
    }
}
