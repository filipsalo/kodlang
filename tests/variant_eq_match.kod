// A `match` beside `==` or `!=` builds its arms as the other side's enum.
import "./variant_eq_match_dep"

type Mark = enum {
    Red
    End
}

type Log = struct {
    text: str = ""

    func at(self, anon n: int64) -> int64 {
        self.text = self.text + f"{n},"
        return n
    }

    func color(self, anon n: int64) -> variant_eq_match_dep.Color {
        self.text = self.text + f"c{n},"
        return variant_eq_match_dep.red()
    }
}

func main() -> int64 {
    let log = Log()
    let c = variant_eq_match_dep.red()
    let d = variant_eq_match_dep.red()
    let r1 = c == match log.at(1) {
        1 -> .Red
        else .Green
    }
    let r2 = match log.at(2) {
        1 -> .Red
        else .Green
    } != log.color(3)
    let r3 = log.color(4) == match log.at(5) {
        5 -> .Red
        else .Green
    } != match log.at(6) {
        6 -> .Green
        else .Red
    }
    let r4 = match log.at(7) {
        7 -> .Red
        else .Green
    } == c == d
    let m = Mark.End
    let r5 = m == match log.at(8) {
        8 -> .End
        else .Red
    } == Mark.End
    print(f"{r1} {r2} {r3} {r4} {r5}")
    print(log.text)
    return 0
}

// expected output:
// true true true true true
// 1,2,c3,c4,5,6,7,8,
