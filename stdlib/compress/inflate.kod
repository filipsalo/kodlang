// Decompression of gzip, zlib and raw deflate data (RFCs 1952, 1950, 1951).
// See docs/encoding.md. Error details use zlib's wording.

import "bytebuffer" { ByteBuffer }
// The length and distance tables of RFC 1951 §3.2.5.
import "compress/tables" { LEN_BASE, LEN_EXTRA, DIST_BASE, DIST_EXTRA }
import "hash/crc32"
import "stream" { IoError, Reader }

// The CRC-32 state and the Adler-32 sum after builder bytes start..end,
// continuing from `crc` / `sum` (stdlib/runtime.c). A ByteBuffer's handle
// is such a builder.
extern func kod_crc32_sb(anon crc: int64, anon sb: str, anon start: int64, anon end: int64) -> int64
extern func kod_adler32_sb(anon sum: int64, anon sb: str, anon start: int64, anon end: int64) -> int64

// A canonical Huffman code as a lookup table. Index it with the next `bits`
// bits of input, in stream order, to get `symbol << 4 | code length`, or 0 for
// bits that no code starts with.
type Huffman = shared struct {
    table: [int64]
    bits: int64
}

func zeros(anon n: int64) -> [int64] {
    return [0] * n
}

// `code`'s low `n` bits in reverse order.
func reversed(anon code: int64, anon n: int64) -> int64 {
    mut out: int64 = 0
    for i in 0..n {
        out = (out << 1) | ((code >> i) & 1)
    }
    return out
}

func fixed_lengths() -> [int64] {
    mut out: [int64] = []
    for i in 0..288 {
        if i < 144 {
            out += [8]
        } else if i < 256 {
            out += [9]
        } else if i < 280 {
            out += [7]
        } else {
            out += [8]
        }
    }
    return out
}

func fives() -> [int64] {
    return [5] * 32
}

// What comes next in the input.
type Step = enum {
    // The header of a gzip member or a zlib stream.
    Head
    // A block.
    Block
    // Literals and back-references, or the bytes of a stored block.
    Symbols
    Stored
    // A block has ended.
    After
    // The checksum, and then maybe another gzip member.
    Tail
    Next
    Done
}

// How much compressed data is read at a time, and how much output is made
// before it is asked for.
let PIECE: int64 = 65536
// As far back as a back-reference goes.
let WINDOW: int64 = 32768

// Decodes a stream a step at a time. Without a `source` the input is `data`, and
// the output all of it. With one, `data` is what has been read of it and not
// used, and decoding pauses, between two symbols, when there is output enough
// or when it would wait for the source with output still to be given.
type Inflater = shared struct {
    data: bytes
    // gzip (0), zlib (1), raw deflate (2), or whichever of zlib and raw it is (3).
    mode: int64
    max_output: int64
    source: Reader? = none
    // No more input will come.
    ended: bool = true
    // `refill` isn't to be used: what happens without is undone.
    held: bool = false
    source_failed: Error? = none
    step: Step = .Head
    // The block's codes, whether it is the last one, and how much of a stored
    // one is left.
    lit: Huffman = Huffman(table: [], bits: 0)
    dist: Huffman = Huffman(table: [], bits: 0)
    last: bool = false
    left: int64 = 0
    // The output length to pause at (with a source), or not to go past.
    limit: int64 = 0
    paused: bool = false
    // How much of the output has been given.
    given: int64 = 0
    // The checksum of this stream's output, up to `checked`.
    sum: int64 = 0
    checked: int64 = 0
    // The next input byte, and the bits read from earlier ones but not used
    // yet, oldest in the lowest bit. When the input runs out, `need` adds
    // zero bits on top and counts them in `pad`, and using any of them is the
    // error `truncated`.
    pos: int64 = 0
    buf: int64 = 0
    count: int64 = 0
    pad: int64 = 0
    // The first error; once it is set, every loop stops.
    err: str = ""
    // The output so far; a back-reference copies from it. `out_len` is its
    // length.
    out: ByteBuffer = ByteBuffer()
    out_len: int64 = 0
    // Output of the current gzip member or stream.
    stream_len: int64 = 0
    crc_table: [int64] = crc32.make_table()
    header_crc: int64 = 0xFFFFFFFF
    fixed_lit: Huffman = Huffman(table: [], bits: 0)
    fixed_dist: Huffman = Huffman(table: [], bits: 0)

    func fail(self, anon message: str) -> none {
        if self.err == "" {
            self.err = message
        }
    }

    // Make at least `n` bits available in `buf`.
    func need(self, anon n: int64) -> none {
        for self.count < n {
            if self.pos < len(self.data) or self.refill() {
                self.buf = self.buf | (self.data[self.pos] << self.count)
                self.pos += 1
            } else {
                self.pad += 8
            }
            self.count += 8
        }
    }

    // Adds to the input from the source; false when there is no more.
    func refill(self) -> bool {
        if self.ended or self.held {
            return false
        }
        let from = must self.source
        let got = from.read(PIECE)
        if got is Err(e) {
            self.source_failed = e
            self.fail("source failed")
            self.ended = true
            return false
        }
        let more = got
        if len(more) == 0 {
            self.ended = true
            return false
        }
        if self.pos < len(self.data) {
            self.data = self.data[self.pos..len(self.data)] + more
        } else {
            self.data = more
        }
        self.pos = 0
        return true
    }

    // Whether the next `n` bits aren't there without waiting for the source, and
    // there is output to give first; then it pauses.
    func starved(self, anon n: int64) -> bool {
        if not self.ended and self.given < self.out_len and self.count - self.pad + 8 * (len(self.data) - self.pos) < n {
            self.paused = true
        }
        return self.paused
    }

    func drop(self, anon n: int64) -> none {
        self.buf = self.buf >> n
        self.count -= n
        if self.count < self.pad {
            self.fail("truncated")
        }
    }

    func bits(self, anon n: int64) -> int64 {
        self.need(n)
        let v = self.buf & ((1 << n) - 1)
        self.drop(n)
        return v
    }

    // Skip to the start of the next byte.
    func align(self) -> none {
        self.drop(self.count % 8)
    }

    // Whether input is left after the current byte.
    func more_input(self) -> bool {
        return self.count - self.pad >= 8 or self.pos < len(self.data) or self.refill()
    }

    func byte(self) -> int64 {
        return self.bits(8)
    }

    func le16(self) -> int64 {
        let lo = self.byte()
        return lo | (self.byte() << 8)
    }

    func le32(self) -> int64 {
        let lo = self.le16()
        return lo | (self.le16() << 16)
    }

    // A byte of a gzip header, which an optional header CRC covers.
    func header_byte(self) -> int64 {
        let b = self.byte()
        self.header_crc = (self.header_crc >> 8) ^ self.crc_table[(self.header_crc ^ b) & 0xff]
        return b
    }

    func start_stream(self) -> none {
        self.stream_len = 0
        self.sum = 0xFFFFFFFF
        if self.mode == 1 {
            self.sum = 1
        }
        self.checked = self.out_len
        self.step = .Block
    }

    // Brings the checksum up to date.
    func sum_up(self) -> none {
        if self.mode == 0 {
            self.sum = kod_crc32_sb(self.sum, self.out.handle, self.checked, self.out_len)
        } else if self.mode == 1 {
            self.sum = kod_adler32_sb(self.sum, self.out.handle, self.checked, self.out_len)
        }
        self.checked = self.out_len
    }

    // A byte of output.
    func put(self, anon b: int64) -> none {
        if self.err != "" {
            return
        }
        if self.out_len == self.max_output {
            self.fail("output too large")
            return
        }
        self.out.push(b)
        self.out_len += 1
        self.stream_len += 1
    }

    // The Huffman code with these code lengths, one per symbol (0 for a
    // symbol that has no code). `what` names it in errors.
    func code(self, anon lengths: [int64], anon what: str) -> Huffman {
        mut counts = zeros(16)
        mut longest: int64 = 0
        for n in lengths {
            counts[n] += 1
            if n > longest {
                longest = n
            }
        }
        counts[0] = 0
        // Too many codes of some length is never valid; too few only for a
        // code with a single 1-bit code, as zlib allows.
        mut left: int64 = 1
        for n in 1..16 {
            left = left * 2 - counts[n]
            if left < 0 {
                self.fail(f"invalid {what} set")
                return Huffman(table: [0, 0], bits: 1)
            }
        }
        if longest == 0 {
            return Huffman(table: [0, 0], bits: 1)
        }
        if left > 0 and (what == "code lengths" or longest != 1) {
            self.fail(f"invalid {what} set")
            return Huffman(table: [0, 0], bits: 1)
        }
        mut next = zeros(16)
        mut c: int64 = 0
        for n in 1..16 {
            c = (c + counts[n - 1]) << 1
            next[n] = c
        }
        let size: int64 = 1 << longest
        mut table = zeros(size)
        for symbol, n in lengths {
            if n != 0 {
                mut at = reversed(next[n], n)
                next[n] += 1
                for at < size {
                    table[at] = (symbol << 4) | n
                    at += 1 << n
                }
            }
        }
        return Huffman(table: table, bits: longest)
    }

    // The next symbol in code `h`, or -1 after an error.
    func decode(self, anon h: Huffman) -> int64 {
        self.need(h.bits)
        let entry = h.table[self.buf & ((1 << h.bits) - 1)]
        if entry == 0 {
            if self.count - self.pad < h.bits {
                self.fail("truncated")
            } else {
                self.fail("invalid code")
            }
            return -1
        }
        self.drop(entry & 15)
        if self.err != "" {
            return -1
        }
        return entry >> 4
    }

    // The literals and back-references of one block, up to its end marker or a
    // pause. While at least 8 input bytes are left, the bit buffer is kept in
    // locals and topped up to 56 bits or more whenever it has fewer than
    // 48, which cover a literal/length code (15), its extra bits (5), a
    // distance code (15) and its extra bits (13). The output length is kept
    // in a local too. Near the end of the input, `symbols_near_end` reads
    // bit by bit and tells running out from a bad code.
    func symbols(self) -> none {
        for self.err == "" and not self.paused and self.step is .Symbols {
            self.symbols_far()
            self.symbols_near_end()
        }
    }

    func symbols_far(self) -> none {
        let lit = self.lit
        let dist = self.dist
        let data = self.data
        let n = len(data)
        let lit_mask = (1 << lit.bits) - 1
        let dist_mask = (1 << dist.bits) - 1
        let limit = self.limit
        let pausing = self.source is not none
        // Where the stream's output starts; a back-reference can't go
        // further back. (Below 0 once output has been dropped.)
        let stream_start = self.out_len - self.stream_len
        let out = self.out
        mut buf = self.buf
        mut count = self.count
        mut pos = self.pos
        mut olen = self.out_len
        mut near_end = self.pad != 0
        for not near_end {
            if pos + 8 > n {
                near_end = true
                break
            }
            // The next 8 input bytes at once, when fewer than 48 bits are
            // left: as many whole bytes as fit below bit 63 count. Bits
            // above `count` hold the following input already, so writing
            // them again leaves them the same; bit 63 stays clear, so `>>`
            // shifts in zeros.
            if count < 48 {
                buf = buf | ((kod_bytes_le64(data, pos) << count) & 0x7fffffffffffffff)
                pos += (63 - count) >> 3
                count = count | 56
            }
            let entry = lit.table[buf & lit_mask]
            if entry == 0 {
                self.fail("invalid code")
                break
            }
            buf = buf >> (entry & 15)
            count -= entry & 15
            let symbol = entry >> 4
            if symbol < 256 {
                if olen >= limit {
                    if not pausing {
                        self.fail("output too large")
                        break
                    }
                    out.push(symbol)
                    olen += 1
                    self.paused = true
                    break
                }
                out.push(symbol)
                olen += 1
                continue
            }
            if symbol == 256 {
                self.step = .After
                break
            }
            let i = symbol - 257
            if i >= 29 {
                self.fail("invalid literal/length code")
                break
            }
            let len_extra = LEN_EXTRA[i]
            let length = LEN_BASE[i] + (buf & ((1 << len_extra) - 1))
            buf = buf >> len_extra
            count -= len_extra
            let dist_entry = dist.table[buf & dist_mask]
            if dist_entry == 0 {
                self.fail("invalid code")
                break
            }
            buf = buf >> (dist_entry & 15)
            count -= dist_entry & 15
            let d = dist_entry >> 4
            if d >= 30 {
                self.fail("invalid distance code")
                break
            }
            let dist_extra = DIST_EXTRA[d]
            let distance = DIST_BASE[d] + (buf & ((1 << dist_extra) - 1))
            buf = buf >> dist_extra
            count -= dist_extra
            if distance > olen - stream_start {
                self.fail("invalid distance too far back")
                break
            }
            if length > limit - olen {
                mut m = length
                if pausing {
                    self.paused = true
                } else {
                    m = limit - olen
                    self.fail("output too large")
                }
                out.copy_back(:distance, length: m)
                olen += m
                break
            }
            out.copy_back(:distance, :length)
            olen += length
        }
        self.buf = buf
        self.count = count
        self.pos = pos
        self.stream_len = olen - stream_start
        self.out_len = olen
    }

    // As symbols_far, as long as fewer than 8 input bytes are left.
    func symbols_near_end(self) -> none {
        for self.err == "" and not self.paused and self.step is .Symbols and (self.pos + 8 > len(self.data) or self.pad != 0) {
            if self.source is not none and self.out_len >= self.limit {
                self.paused = true
                return
            }
            if self.ended {
                self.symbol()
                continue
            }
            // A symbol that is all there is decoded before more is waited for.
            let buf = self.buf
            let count = self.count
            let pos = self.pos
            self.held = true
            self.symbol()
            self.held = false
            if self.err == "truncated" {
                self.err = ""
                self.buf = buf
                self.count = count
                self.pos = pos
                self.pad = 0
                if self.given < self.out_len {
                    self.paused = true
                    return
                }
                let _ = self.refill()
            } else {
                // Zeros it was looked up with and didn't use.
                self.count -= self.pad
                self.pad = 0
            }
        }
    }

    // A literal, a back-reference or the end of the block.
    func symbol(self) -> none {
        let symbol = self.decode(self.lit)
        if symbol < 0 {
            return
        }
        if symbol == 256 {
            self.step = .After
            return
        }
        if symbol < 256 {
            self.put(symbol)
            return
        }
        let i = symbol - 257
        if i >= 29 {
            self.fail("invalid literal/length code")
            return
        }
        let length = LEN_BASE[i] + self.bits(LEN_EXTRA[i])
        let d = self.decode(self.dist)
        if d < 0 {
            return
        }
        if d >= 30 {
            self.fail("invalid distance code")
            return
        }
        let distance = DIST_BASE[d] + self.bits(DIST_EXTRA[d])
        if self.err != "" {
            return
        }
        if distance > self.stream_len {
            self.fail("invalid distance too far back")
            return
        }
        self.copy(distance: distance, length: length)
    }

    // A back-reference: `length` bytes copied from `distance` back, which
    // callers check is no further back than the stream's output goes.
    func copy(self, distance: int64, length: int64) -> none {
        mut n = length
        if n > self.max_output - self.out_len {
            n = self.max_output - self.out_len
        }
        self.out.copy_back(:distance, length: n)
        self.out_len += n
        self.stream_len += n
        if n < length {
            self.fail("output too large")
        }
    }

    func stored(self) -> none {
        self.align()
        let n = self.le16()
        if n != (self.le16() ^ 0xffff) {
            self.fail("invalid stored block lengths")
            return
        }
        self.left = n
        self.step = .Stored
    }

    // The bytes of a stored block, up to its end or a pause.
    func stored_bytes(self) -> none {
        for self.left > 0 and self.err == "" {
            if self.source is not none and self.out_len >= self.limit {
                self.paused = true
                return
            }
            if self.starved(8) {
                return
            }
            mut n = self.left
            for most in [len(self.data) - self.pos, self.limit - self.out_len] {
                if n > most {
                    n = most
                }
            }
            if self.count > 0 or n <= 0 {
                // A byte in the bit buffer, or one that has to be read first, or is
                // too many.
                self.put(self.byte())
                self.left -= 1
                continue
            }
            self.out.push_bytes(self.data[self.pos..self.pos + n])
            self.out_len += n
            self.stream_len += n
            self.left -= n
            self.pos += n
            // Bits above `count` are those of the next byte, which is another now.
            self.buf = 0
        }
        self.step = .After
    }

    // A block that sends its own codes, as code lengths that are themselves
    // Huffman coded.
    func dynamic(self) -> none {
        let nlit = self.bits(5) + 257
        let ndist = self.bits(5) + 1
        let nlen = self.bits(4) + 4
        if nlit > 286 or ndist > 30 {
            self.fail("too many length or distance symbols")
            return
        }
        let order: [int64] = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]
        mut len_lengths = zeros(19)
        for i in 0..nlen {
            len_lengths[order[i]] = self.bits(3)
        }
        let lens = self.code(len_lengths, "code lengths")
        mut lengths: [int64] = []
        for self.err == "" and len(lengths) < nlit + ndist {
            let symbol = self.decode(lens)
            if symbol < 0 {
                return
            }
            if symbol < 16 {
                lengths += [symbol]
                continue
            }
            mut value: int64 = 0
            mut repeat: int64 = 0
            if symbol == 16 {
                if len(lengths) == 0 {
                    self.fail("invalid bit length repeat")
                    return
                }
                value = lengths[len(lengths) - 1]
                repeat = 3 + self.bits(2)
            } else if symbol == 17 {
                repeat = 3 + self.bits(3)
            } else {
                repeat = 11 + self.bits(7)
            }
            if len(lengths) + repeat > nlit + ndist {
                self.fail("invalid bit length repeat")
                return
            }
            lengths += [value] * repeat
        }
        if self.err != "" {
            return
        }
        if lengths[256] == 0 {
            self.fail("invalid code -- missing end-of-block")
            return
        }
        self.lit = self.code(lengths[0..nlit], "literal/lengths")
        self.dist = self.code(lengths[nlit..nlit + ndist], "distances")
        self.step = .Symbols
    }

    // The start of a block, up to what it holds.
    func block(self) -> none {
        self.last = self.bits(1) == 1
        let kind = self.bits(2)
        if self.err != "" {
            return
        }
        if kind == 0 {
            self.stored()
        } else if kind == 1 {
            if len(self.fixed_lit.table) == 0 {
                self.fixed_lit = self.code(fixed_lengths(), "literal/lengths")
                self.fixed_dist = self.code(fives(), "distances")
            }
            self.lit = self.fixed_lit
            self.dist = self.fixed_dist
            self.step = .Symbols
        } else if kind == 2 {
            self.dynamic()
        } else {
            self.fail("invalid block type")
        }
    }

    func skip_zero_terminated(self) -> none {
        for self.err == "" {
            if self.header_byte() == 0 {
                return
            }
        }
    }

    func gzip_head(self) -> none {
        self.header_crc = 0xFFFFFFFF
        let id1 = self.header_byte()
        let id2 = self.header_byte()
        if self.err != "" {
            return
        }
        if id1 != 0x1f or id2 != 0x8b {
            self.fail("incorrect header check")
            return
        }
        if self.header_byte() != 8 {
            self.fail("unknown compression method")
            return
        }
        let flags = self.header_byte()
        if (flags & 0xe0) != 0 {
            self.fail("unknown header flags set")
            return
        }
        // mtime, extra flags, os
        for _ in 0..6 {
            self.header_byte()
        }
        if (flags & 4) != 0 {
            let lo = self.header_byte()
            let n = lo | (self.header_byte() << 8)
            for _ in 0..n {
                if self.err != "" {
                    return
                }
                self.header_byte()
            }
        }
        if (flags & 8) != 0 {
            self.skip_zero_terminated()
        }
        if (flags & 16) != 0 {
            self.skip_zero_terminated()
        }
        if (flags & 2) != 0 {
            let want = (self.header_crc ^ 0xFFFFFFFF) & 0xffff
            if self.le16() != want and self.err == "" {
                self.fail("header crc mismatch")
                return
            }
        }
        self.start_stream()
    }

    func gzip_tail(self) -> none {
        self.align()
        let crc = self.le32()
        let size = self.le32()
        if self.err != "" {
            return
        }
        self.sum_up()
        if crc != (self.sum ^ 0xFFFFFFFF) {
            self.fail("incorrect data check")
        } else if size != (self.stream_len & 0xFFFFFFFF) {
            self.fail("incorrect length check")
        }
    }

    func zlib_head(self) -> none {
        let cmf = self.byte()
        let flags = self.byte()
        if self.err != "" {
            return
        }
        if (cmf * 256 + flags) % 31 != 0 {
            self.fail("incorrect header check")
            return
        }
        if (cmf & 15) != 8 {
            self.fail("unknown compression method")
            return
        }
        if (cmf >> 4) > 7 {
            self.fail("invalid window size")
            return
        }
        if (flags & 0x20) != 0 {
            self.fail("needs a preset dictionary")
            return
        }
        self.start_stream()
    }

    func zlib_tail(self) -> none {
        self.align()
        mut sum: int64 = 0
        for _ in 0..4 {
            sum = (sum << 8) | self.byte()
        }
        if self.err != "" {
            return
        }
        self.sum_up()
        if sum != self.sum {
            self.fail("incorrect data check")
        }
    }

    func head(self) -> none {
        if self.mode == 3 {
            self.need(16)
            self.mode = 2
            if zlib_header(self.buf & 255, (self.buf >> 8) & 255) {
                self.mode = 1
            }
        }
        if self.mode == 0 {
            self.gzip_head()
        } else if self.mode == 1 {
            self.zlib_head()
        } else {
            self.start_stream()
        }
    }

    // The bits of the end of a stream, at most.
    func tail_bits(self) -> int64 {
        if self.mode == 0 {
            return 64
        }
        if self.mode == 1 {
            return 32
        }
        return 0
    }

    func tail(self) -> none {
        self.step = .Done
        if self.mode == 0 {
            self.gzip_tail()
            // Members one after another give their output joined.
            self.step = .Next
        } else if self.mode == 1 {
            self.zlib_tail()
        }
    }

    // Goes on until the end, an error or a pause.
    func run(self) -> none {
        self.paused = false
        for self.err == "" and not self.paused and self.step is not .Done {
            match self.step {
                .Head -> self.head()
                .Block -> {
                    if not self.starved(3) {
                        self.block()
                    }
                }
                .Symbols -> self.symbols()
                .Stored -> self.stored_bytes()
                .After -> {
                    self.step = .Block
                    if self.last {
                        self.step = .Tail
                    }
                }
                .Tail -> {
                    if not self.starved(self.tail_bits()) {
                        self.tail()
                    }
                }
                .Next -> {
                    if not self.starved(8) {
                        self.step = .Done
                        if self.more_input() {
                            self.step = .Head
                        }
                    }
                }
                .Done -> none
            }
        }
    }

    // Drops output that has been given and is too far back to be copied.
    func forget(self) -> none {
        let n = self.out_len - WINDOW
        if n >= 3 * WINDOW {
            self.sum_up()
            self.out.drop_front(n)
            self.out_len -= n
            self.given -= n
            self.checked -= n
        }
    }
}

// Whether a stream that starts with these two bytes is a zlib stream: deflate, a
// window of at most 32 KiB, and a check that makes the two a multiple of 31.
func zlib_header(anon cmf: int64, anon flags: int64) -> bool {
    return (cmf & 15) == 8 and cmf >> 4 <= 7 and (cmf * 256 + flags) % 31 == 0
}

func run(anon op: str, anon data: bytes, anon mode: int64, anon max_output: int64) -> bytes or Error {
    if max_output < 0 {
        throw IoError(kind: .InvalidInput, op: op, errno: 0, detail: "max_output cannot be negative")
    }
    let inflater = Inflater(data: data, mode: mode, max_output: max_output, limit: max_output)
    inflater.run()
    if inflater.err != "" {
        throw IoError(kind: .InvalidInput, op: op, errno: 0, detail: inflater.err)
    }
    return inflater.out.to_bytes()
}

func gunzip(anon data: bytes, max_output: int64 = 16777216) -> bytes or Error {
    return try run("gunzip", data, 0, max_output)
}

func inflate_zlib(anon data: bytes, max_output: int64 = 16777216) -> bytes or Error {
    return try run("inflate_zlib", data, 1, max_output)
}

func inflate_raw(anon data: bytes, max_output: int64 = 16777216) -> bytes or Error {
    return try run("inflate_raw", data, 2, max_output)
}

// What is decompressed of a Reader: see docs/encoding.md#piece-by-piece.
type InflateReader = shared struct {
    inflater: Inflater

    func read(self, anon max: int64) -> bytes or Error {
        let it = self.inflater
        if max <= 0 {
            return kod_str_to_bytes("")
        }
        if it.given == it.out_len and it.err == "" {
            it.forget()
            it.limit = it.out_len + PIECE
            it.run()
        }
        if it.given < it.out_len {
            mut end = it.given + max
            if end > it.out_len {
                end = it.out_len
            }
            let piece = it.out.slice(it.given, end)
            it.given = end
            return piece
        }
        if it.source_failed is Some(e) {
            throw e
        }
        if it.err != "" {
            throw IoError(kind: .InvalidInput, op: "inflate", errno: 0, detail: it.err)
        }
        return kod_str_to_bytes("")
    }
}

func reader(anon from: Reader, anon mode: int64) -> InflateReader {
    return InflateReader(inflater: Inflater(data: kod_str_to_bytes(""), mode: mode, max_output: 9223372036854775807, source: from, ended: false))
}

func gunzip_reader(anon from: Reader) -> InflateReader {
    return reader(from, 0)
}

func zlib_reader(anon from: Reader) -> InflateReader {
    return reader(from, 1)
}

func raw_reader(anon from: Reader) -> InflateReader {
    return reader(from, 2)
}

// A zlib stream, or a raw one when it doesn't start as a zlib stream does.
func deflate_reader(anon from: Reader) -> InflateReader {
    return reader(from, 3)
}
