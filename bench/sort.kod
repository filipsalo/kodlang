// Merge sort over a moderately-large array of pseudo-random ints. Exercises array
// indexing and appends, and a call through a function value per comparison.

import "time"
import "sort"

func main() -> int64 {
    let n: int64 = 20000
    mut xs: [int64] = []
    mut i: int64 = 0
    for i < n {
        // Linear-congruential mixing for a reproducible scramble.
        xs += [(i * 1664525 + 1013904223) % 65536]
        i = i + 1
    }
    let t0: int64 = time.monotonic_ns()
    let s: [int64] = sort.sorted(xs)
    let dt_ms: int64 = (time.monotonic_ns() - t0) / 1000000
    print(f"sorted {n} ints  [{dt_ms} ms]  first={s[0]} last={s[n - 1]}")
    return 0
}
