import "./xmod_default_scope_dep"

// Aliases here must not rebind the dep's method bodies to this module.
type C2 = xmod_default_scope_dep.Counter
type SBox = xmod_default_scope_dep.Box[str]

func helper() -> int64 {
    return 2
}

func other() -> int64 {
    return 3
}

func main() -> int64 {
    let helper = other
    let bx = SBox(v: "x")
    print(f"param default: {xmod_default_scope_dep.f()}")
    print(f"field default: {xmod_default_scope_dep.Cfg().n}")
    print(f"method default: {xmod_default_scope_dep.Counter(base: 0).bump()}")
    print(f"generic body: {bx.tag()}")
    print(f"method body: {xmod_default_scope_dep.Counter(base: 0).step()}")
    print(f"aliased method body: {C2(base: 0).step()}")
    return 0
}

// expected output:
// param default: 1
// field default: 1
// method default: 1
// generic body: 1
// method body: 1
// aliased method body: 1

// expected mode:
// interpret
