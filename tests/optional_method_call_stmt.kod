// An optional-chained method call written as a statement runs the method
// when there is a value and skips it, arguments included, when there is
// `none`, interpreted as well as compiled.
type Bell = struct {
    tag: str

    func ring(self, anon times: int64) -> none {
        print(f"{self.tag} x{times}")
    }
}

func count(anon n: int64) -> int64 {
    print_int(n)
    return n
}

func poke(anon b: Bell?, anon times: int64) -> none {
    b?.ring(count(times))
    print("poked")
}

func main() -> int64 {
    poke(Bell(tag: "a"), 2)
    poke(none, 5)
    let o: Bell? = Bell(tag: "b")
    o?.ring(1)
    return 0
}

// expected output:
// 2
// a x2
// poked
// poked
// b x1
