import "crypto/bignum" { Modulus }
import "crypto/bignum"
import "encoding/hex"

func h(anon s: str) -> bytes {
    return must hex.decode(if len(s) % 2 == 1 { "0" + s } else { s })
}

func check(anon m: str, anon a: str, anon b: str, anon e: str, anon want_pow: str, anon want_mul: str, anon want_add: str, anon want_sub: str) -> none {
    let mod = Modulus(h(m))
    let size = len(h(m))
    let x = must mod.number(h(a))
    let y = must mod.number(h(b))
    let ex = must bignum.from_bytes(h(e), k: len(h(e)) / 3 + 1)
    let xm = mod.to_mont(x)
    let ym = mod.to_mont(y)
    assert mod.from_mont(xm) == x
    assert hex.encode(bignum.to_bytes(mod.from_mont(mod.pow(xm, ex)), size: size)) == want_pow
    assert hex.encode(bignum.to_bytes(mod.from_mont(mod.mul(xm, ym)), size: size)) == want_mul
    assert hex.encode(bignum.to_bytes(mod.add(x, y), size: size)) == want_add
    assert hex.encode(bignum.to_bytes(mod.sub(x, y), size: size)) == want_sub
    assert mod.number(h(m)) is none
}

func n(anon s: str) -> [int64] {
    return must bignum.from_bytes(h(s), k: 9)
}

test "against Python's integers" {
    check("03", "00", "02", "bd6a", "00", "00", "02", "01")
    check("03", "02", "01", "1", "02", "02", "00", "01")
    check("03", "01", "01", "622c", "01", "01", "02", "00")
    check("03", "02", "01", "1", "02", "02", "00", "01")
    check("14733f05", "04d1d988", "076be7b0", "1bc70", "04cd1dbf", "01a5932e", "0c3dc138", "11d930dd")
