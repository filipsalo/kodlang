import "net/http" { Client, Options, Headers, Response, Limits, fetch, get, post, put, patch, delete }
import "net/tcp"
import "stream" { IoError, IoKind }
import "process"
import "io"
import "time"
import "time" { Duration }

// These tests talk to tests/support/http_fixture.py, a scripted local server,
// and (for https) to `openssl s_server`.

type Server = struct {
    pid: int64
    port: int64
}

func start_fixture() -> Server {
    return start_fixture_with([])
}

// `extra` is more arguments for the fixture: a certificate and key for TLS.
func start_fixture_with(anon extra: [str]) -> Server {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let port = l.port()
    must l.close()
    let pid = process.spawn(["python3", "tests/support/http_fixture.py", f"{port}"] + extra)
    assert pid > 0
    mut tries: int64 = 0
    for tries < 100 {
        let c = tcp.connect("127.0.0.1", port: port)
        if c is Ok(conn) {
            must conn.close()
            return Server(pid: pid, port: port)
        }
        time.sleep(Duration(ms: 50))
        tries = tries + 1
    }
    assert false
    return Server(pid: pid, port: port)
}

func stop(anon sv: Server) -> none {
    process.kill(sv.pid)
}

func url(anon sv: Server, anon path: str) -> str {
    return f"http://127.0.0.1:{sv.port}{path}"
}

type Failure = struct {
    kind: IoKind
    detail: str
}

func why(anon r: Response or Error) -> Failure? {
    if r is Err(e) {
        if e is io_err: IoError {
            return Failure(kind: io_err.kind, detail: io_err.detail)
        }
        return Failure(kind: .Other, detail: e.to_str())
    }
    return none
}

func fails(anon r: Response or Error, anon kind: IoKind, anon part: str) -> bool {
    let f = why(r)
    if f is none {
        return false
    }
    let w = f? or Failure(kind: .Other, detail: "")
    return w.kind == kind and w.detail.contains(part)
}

func b(anon text: str) -> bytes {
    return kod_str_to_bytes(text)
}

test "get: status, headers and body" {
    let sv = start_fixture()
    let r = must get(url(sv, "/hello"))
    assert r.status == 200 and r.reason == "OK" and r.ok()
    assert r.text() == "hello"
    assert (r.header("content-type")? or "!") == "text/plain"
    assert len(r.headers.all("x-a")) == 2
    stop(sv)
}

test "the request line, Host and default headers reach the server" {
    let sv = start_fixture()
    let r = must get(url(sv, "/echo?a=1&b=2"))
    let text = r.text()
    assert text.starts_with("GET /echo?a=1&b=2\n")
    assert text.contains(f"Host: 127.0.0.1:{sv.port}\n")
    assert text.contains("User-Agent: kod\n")
    assert text.contains("Accept: */*\n")
    assert text.contains("Connection: close\n")
    stop(sv)
}

test "post sends a body with its length and type" {
    let sv = start_fixture()
    let r = must post(url(sv, "/echo"), b("{\"k\": 1}"), content_type: "application/json")
    let text = r.text()
    assert text.starts_with("POST /echo\n")
    assert text.contains("Content-Type: application/json\n")
    assert text.contains("Content-Length: 8\n")
    assert text.ends_with("\n\n{\"k\": 1}")
    stop(sv)
}

test "fetch: any method, extra headers" {
    let sv = start_fixture()
    let options = Options()
    options.headers.add("X-Token", "abc")
    options.headers.add("User-Agent", "mine")
    let r = must fetch("DELETE", url(sv, "/echo"), options: options)
    let text = r.text()
    assert text.starts_with("DELETE /echo\n")
    assert text.contains("X-Token: abc\n")
    assert text.contains("User-Agent: mine\n")
    assert not text.contains("User-Agent: kod")
    stop(sv)
}

test "statuses other than 200 come back as responses, not errors" {
    let sv = start_fixture()
    let a = must get(url(sv, "/missing"))
    assert a.status == 404 and not a.ok() and a.text() == "nope"
    let c = must get(url(sv, "/created"))
    assert c.status == 201 and c.ok()
    stop(sv)
}

test "chunked, close-delimited, HEAD, 204 and interim responses" {
    let sv = start_fixture()
    assert (must get(url(sv, "/chunked"))).text() == "Wikipedia in\r\n\r\nchunks."
    assert (must get(url(sv, "/close"))).text() == "until close"
    let h = must fetch("HEAD", url(sv, "/head"))
    assert len(h.body) == 0 and (h.header("content-length")? or "!") == "10"
    assert len((must get(url(sv, "/nocontent"))).body) == 0
    assert (must get(url(sv, "/interim"))).text() == "after interim"
    stop(sv)
}

test "302 and 303 turn a POST into a GET without a body" {
    let sv = start_fixture()
    let a = must post(url(sv, "/302"), b("data"), content_type: "text/plain")
    assert a.text().starts_with("GET /echo\n")
    assert not a.text().contains("Content-Type")
    assert a.text().ends_with("\n\n")
    let c = must post(url(sv, "/303"), b("data"), content_type: "text/plain")
    assert c.text().starts_with("GET /echo\n")
    let m = must post(url(sv, "/301"), b("data"), content_type: "text/plain")
    assert m.text().starts_with("GET /echo\n")
    stop(sv)
}

test "307 and 308 keep the method and the body" {
    let sv = start_fixture()
    let a = must post(url(sv, "/307"), b("data"), content_type: "text/plain")
    assert a.text().starts_with("POST /echo\n")
    assert a.text().contains("Content-Type: text/plain\n")
    assert a.text().ends_with("\n\ndata")
    let c = must post(url(sv, "/308"), b("data"), content_type: "text/plain")
    assert c.text().ends_with("\n\ndata")
    stop(sv)
}

test "HEAD stays HEAD across a 302" {
    let sv = start_fixture()
    let r = must fetch("HEAD", url(sv, "/302"))
    assert r.status == 200 and len(r.body) == 0
    stop(sv)
}

test "relative, dotted and absolute Locations are followed" {
    let sv = start_fixture()
    assert (must get(url(sv, "/relative"))).text() == "hello"
    assert (must get(url(sv, "/dir/relative"))).text() == "hello"
    assert (must get(url(sv, "/absolute"))).text() == "hello"
    assert (must get(url(sv, "/chain"))).text().starts_with("GET /echo\n")
    stop(sv)
}

test "credentials do not follow a redirect to another host" {
    let sv = start_fixture()
    let options = Options()
    options.headers.add("Authorization", "Bearer secret")
    options.headers.add("Cookie", "a=b")
    options.headers.add("X-Keep", "yes")
    let same = must fetch("GET", url(sv, "/302"), options: options)
    assert same.text().contains("Authorization: Bearer secret\n")
    assert same.text().contains("Cookie: a=b\n")
    let other = must fetch("GET", url(sv, "/cross-host"), options: options)
    assert other.status == 200
    assert not other.text().contains("Authorization")
    assert not other.text().contains("Cookie")
    assert other.text().contains("X-Keep: yes\n")
    assert other.text().contains(f"Host: localhost:{sv.port}\n")
    stop(sv)
}

test "max_redirects 0 returns the redirect itself" {
    let sv = start_fixture()
    let options = Options(max_redirects: 0)
    let r = must fetch("GET", url(sv, "/302"), options: options)
    assert r.status == 302 and (r.header("location")? or "!") == "/echo"
    stop(sv)
}

test "a redirect loop or a long chain stops with an error" {
    let sv = start_fixture()
    assert fails(get(url(sv, "/loop")), .InvalidInput, "redirects")
    let short = Options(max_redirects: 1)
    assert fails(fetch("GET", url(sv, "/chain"), options: short), .InvalidInput, "redirects")
    let enough = Options(max_redirects: 2)
    assert (fetch("GET", url(sv, "/chain"), options: enough)) is Ok(_)
    stop(sv)
}

test "a redirect without Location, or to another scheme, is not followed blindly" {
    let sv = start_fixture()
    let r = must get(url(sv, "/no-location"))
    assert r.status == 302 and r.text() == "nowhere"
    assert fails(get(url(sv, "/to-ftp")), .InvalidInput, "Location")
    stop(sv)
}

test "bad URLs are InvalidInput errors" {
    assert fails(get("not a url"), .InvalidInput, "URL")
    assert fails(get("ftp://example.com/"), .InvalidInput, "scheme")
    assert fails(get("http://user:pw@example.com/"), .InvalidInput, "credentials")
}

test "a server that is not there" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let port = l.port()
    must l.close()
    assert fails(get(f"http://127.0.0.1:{port}/"), .ConnectionRefused, "")
    assert fails(get("http://no-such-host.invalid/"), .HostNotFound, "")
}

test "a slow server hits the timeout" {
    let sv = start_fixture()
    let options = Options(timeout: Duration(ms: 200))
    assert fails(fetch("GET", url(sv, "/slow"), options: options), .TimedOut, "")
    let patient = Options(timeout: Duration(ms: 5000))
    assert (must fetch("GET", url(sv, "/slow"), options: patient)).text() == "late"
    stop(sv)
}

test "broken responses are errors with a kind" {
    let sv = start_fixture()
    assert fails(get(url(sv, "/truncated")), .UnexpectedEof, "")
    assert fails(get(url(sv, "/garbage")), .Protocol, "status line")
    assert fails(get(url(sv, "/bomb")), .Protocol, "too many headers")
    stop(sv)
}

test "limits cap the body a server can send" {
    let sv = start_fixture()
    assert (must get(url(sv, "/big"))).status == 200
    let small = Options(limits: Limits(max_body: 1000000, max_header_bytes: 65536, max_headers: 100))
    assert fails(fetch("GET", url(sv, "/big"), options: small), .Protocol, "body too large")
    let few = Options(limits: Limits(max_body: 1000, max_header_bytes: 65536, max_headers: 10))
    assert fails(fetch("GET", url(sv, "/bomb"), options: few), .Protocol, "too many headers")
    stop(sv)
}

// ---- deadlines ----

test "deadline: a request that finishes in time is untouched" {
    let sv = start_fixture()
    let options = Options(deadline: Duration(ms: 5000))
    assert (must fetch("GET", url(sv, "/hello"), options: options)).text() == "hello"
    stop(sv)
}

test "deadline: a slow answer is cut off, though no single wait is long" {
    let sv = start_fixture()
    let options = Options(deadline: Duration(ms: 300))
    let r = fetch("GET", url(sv, "/slow"), options: options)
    assert fails(r, .TimedOut, "deadline exceeded")
    stop(sv)
}

test "deadline: a body that dribbles in is cut off while every read progresses" {
    let sv = start_fixture()
    let slow = Options(deadline: Duration(ms: 300))
    assert fails(fetch("GET", url(sv, "/dribble"), options: slow), .TimedOut, "deadline exceeded")
    let whole = Options()
    assert len((must fetch("GET", url(sv, "/dribble"), options: whole)).body) == 20
    let patient = Options(deadline: Duration(ms: 5000))
    assert len((must fetch("GET", url(sv, "/dribble"), options: patient)).body) == 20
    stop(sv)
}

test "deadline: redirects share one deadline" {
    let sv = start_fixture()
    let tight = Options(deadline: Duration(ms: 600))
    assert fails(fetch("GET", url(sv, "/hop1"), options: tight), .TimedOut, "deadline exceeded")
    let roomy = Options(deadline: Duration(ms: 5000))
    assert (must fetch("GET", url(sv, "/hop1"), options: roomy)).text() == "hello"
    stop(sv)
}

test "deadline: the elapsed time is near the deadline, not the server's delay" {
    let sv = start_fixture()
    let t0 = time.monotonic_ns()
    let r = fetch("GET", url(sv, "/slow"), options: Options(deadline: Duration(ms: 250)))
    let ms = (time.monotonic_ns() - t0) / 1000000
    assert r is Err(_)
    assert ms >= 200 and ms < 1000
    stop(sv)
}

test "deadline: a deadline shorter than timeout wins, a longer one loses" {
    let sv = start_fixture()
    let by_timeout = Options(timeout: Duration(ms: 200), deadline: Duration(ms: 5000))
    assert fails(fetch("GET", url(sv, "/slow"), options: by_timeout), .TimedOut, "")
    stop(sv)
}

test "deadline: Duration(ms: 0) means none, a negative value is refused" {
    let sv = start_fixture()
    assert (must fetch("GET", url(sv, "/hello"), options: Options(deadline: Duration(ms: 0)))).status == 200
    assert fails(fetch("GET", url(sv, "/hello"), options: Options(deadline: Duration(ms: -1))), .InvalidInput, "deadline")
    stop(sv)
}

test "deadline: a connection refused is still ConnectionRefused" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let port = l.port()
    must l.close()
    assert fails(fetch("GET", f"http://127.0.0.1:{port}/", options: Options(deadline: Duration(ms: 5000))), .ConnectionRefused, "")
}

// ---- client-level settings ----

func echo_of(anon r: Response or Error) -> str {
    return body(r)
}

test "Client.headers are sent with every request" {
    let sv = start_fixture()
    let client = Client()
    client.headers.add("X-Api-Key", "k1")
    client.headers.add("Accept", "application/json")
    let a = echo_of(client.get(url(sv, "/echo")))
    assert a.contains("X-Api-Key: k1\n") and a.contains("Accept: application/json\n")
    assert not a.contains("Accept: */*")
    let c = echo_of(client.post(url(sv, "/echo"), b("x"), content_type: "text/plain"))
    assert c.contains("X-Api-Key: k1\n") and c.contains("Content-Type: text/plain\n")
    stop(sv)
}

test "request headers are added, and win over the client's of the same name" {
    let sv = start_fixture()
    let client = Client()
    client.headers.add("X-Api-Key", "client")
    client.headers.add("X-Keep", "yes")
    let options = Options()
    options.headers.add("x-api-key", "request")
    options.headers.add("X-Extra", "1")
    let text = echo_of(client.get(url(sv, "/echo"), options: options))
    assert text.contains("x-api-key: request\n")
    assert not text.contains("X-Api-Key: client")
    assert text.contains("X-Keep: yes\n") and text.contains("X-Extra: 1\n")
    assert echo_of(client.get(url(sv, "/echo"))).contains("X-Api-Key: client\n")
    stop(sv)
}

test "the client's headers are not changed by a request's" {
    let sv = start_fixture()
    let client = Client()
    client.headers.add("A", "1")
    let options = Options()
    options.headers.add("B", "2")
    options.headers.add("A", "other")
    must client.get(url(sv, "/echo"), options: options)
    assert len(client.headers.items) == 1
    assert (client.headers.get("A")? or "!") == "1"
    stop(sv)
}

test "client-level Authorization does not follow a redirect to another host" {
    let sv = start_fixture()
    let client = Client()
    client.headers.add("Authorization", "Bearer secret")
    assert echo_of(client.get(url(sv, "/302"))).contains("Authorization: Bearer secret\n")
    let other = echo_of(client.get(url(sv, "/cross-host")))
    assert not other.contains("Authorization")
    stop(sv)
}

test "Client.deadline applies to every request, and a request can change it" {
    let sv = start_fixture()
    let client = Client(deadline: Duration(ms: 300))
    assert fails(client.get(url(sv, "/slow")), .TimedOut, "deadline exceeded")
    assert echo_of(client.get(url(sv, "/hello"))) == "hello"
    assert fails(client.get(url(sv, "/slow"), options: Options(deadline: Duration(ms: 200))), .TimedOut, "deadline exceeded")
    assert echo_of(client.get(url(sv, "/slow"), options: Options(deadline: Duration(ms: 0)))) == "late"
    assert echo_of(client.get(url(sv, "/slow"), options: Options(deadline: Duration(ms: 5000)))) == "late"
    stop(sv)
}

test "Client.timeout and a request's timeout" {
    let sv = start_fixture()
    let client = Client(timeout: Duration(ms: 200))
    assert fails(client.get(url(sv, "/slow")), .TimedOut, "")
    assert echo_of(client.get(url(sv, "/slow"), options: Options(timeout: Duration(ms: 5000)))) == "late"
    stop(sv)
}

test "Client.accept_gzip, max_redirects and limits, and their overrides" {
    let sv = start_fixture()
    let plain = Client(accept_gzip: false)
    assert not echo_of(plain.get(url(sv, "/echo"))).contains("Accept-Encoding")
    assert echo_of(plain.get(url(sv, "/echo"), options: Options(accept_gzip: true))).contains("Accept-Encoding: gzip")
    let stay = Client(max_redirects: 0)
    assert (must stay.get(url(sv, "/302"))).status == 302
    assert (must stay.get(url(sv, "/302"), options: Options(max_redirects: 5))).status == 200
    let small = Client(limits: Limits(max_body: 1000000, max_header_bytes: 65536, max_headers: 100))
    assert fails(small.get(url(sv, "/big")), .Protocol, "body too large")
    let roomy = Options(limits: Limits(max_body: 4000000, max_header_bytes: 65536, max_headers: 100))
    assert len((must small.get(url(sv, "/big"), options: roomy)).body) == 3000000
    stop(sv)
}

test "get, delete, put, patch and post take options" {
    let sv = start_fixture()
    let client = Client()
    let options = Options()
    options.headers.add("X-Mark", "m")
    let g = echo_of(client.get(url(sv, "/echo"), options: options))
    assert g.starts_with("GET /echo\n") and g.contains("X-Mark: m\n")
    assert echo_of(client.delete(url(sv, "/echo"), options: options)).starts_with("DELETE /echo\n")
    let u = echo_of(client.put(url(sv, "/echo"), b("body"), content_type: "text/plain", options: options))
    assert u.starts_with("PUT /echo\n") and u.ends_with("\n\nbody") and u.contains("X-Mark: m\n")
    let pa = echo_of(client.patch(url(sv, "/echo"), b("p"), content_type: "application/merge-patch+json"))
    assert pa.starts_with("PATCH /echo\n") and pa.contains("Content-Type: application/merge-patch+json\n")
    let po = echo_of(client.post(url(sv, "/echo"), b("q"), content_type: "text/plain", options: options))
    assert po.starts_with("POST /echo\n") and po.contains("X-Mark: m\n")
    stop(sv)
}

test "the module's functions take options and a body method too" {
    let sv = start_fixture()
    let options = Options()
    options.headers.add("X-Mark", "m")
    assert echo_of(get(url(sv, "/echo"), options: options)).contains("X-Mark: m\n")
    assert echo_of(delete(url(sv, "/echo"))).starts_with("DELETE /echo\n")
    assert echo_of(put(url(sv, "/echo"), b("z"), content_type: "text/plain")).ends_with("\n\nz")
    assert echo_of(patch(url(sv, "/echo"), b("z"), content_type: "text/plain")).starts_with("PATCH /echo\n")
    assert echo_of(post(url(sv, "/echo"), b("z"), content_type: "text/plain", options: options)).contains("X-Mark: m\n")
    stop(sv)
}

test "a request's own body option is used by fetch, post's body argument wins" {
    let sv = start_fixture()
    let client = Client()
    let options = Options(body: b("from options"))
    assert echo_of(client.fetch("POST", url(sv, "/echo"), options: options)).ends_with("\n\nfrom options")
    assert echo_of(client.post(url(sv, "/echo"), b("argument"), content_type: "text/plain", options: options)).ends_with("\n\nargument")
    stop(sv)
}

// ---- connection reuse ----

func body(anon r: Response or Error) -> str {
    if r is Err(e) {
        return "error: " + e.to_str()
    }
    return (must r).text()
}

func pause(anon ms: int64) -> none {
    time.sleep(Duration(ms: ms))
}

test "Client: requests share one connection" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/conn-id"))) == "conn 1 req 1"
    assert body(client.get(url(sv, "/conn-id"))) == "conn 1 req 2"
    assert body(client.get(url(sv, "/conn-id"))) == "conn 1 req 3"
    client.close()
    stop(sv)
}

test "the free functions open a connection for each request" {
    let sv = start_fixture()
    assert body(get(url(sv, "/conn-id"))) == "conn 1 req 1"
    assert body(get(url(sv, "/conn-id"))) == "conn 2 req 1"
    stop(sv)
}

test "max_idle_per_host 0 turns reuse off" {
    let sv = start_fixture()
    let client = Client(max_idle_per_host: 0)
    assert body(client.get(url(sv, "/conn-id"))) == "conn 1 req 1"
    assert body(client.get(url(sv, "/conn-id"))) == "conn 2 req 1"
    stop(sv)
}

test "each host and port has its own connection" {
    let a = start_fixture()
    let b = start_fixture()
    let client = Client()
    assert body(client.get(url(a, "/conn-id"))) == "conn 1 req 1"
    assert body(client.get(url(b, "/conn-id"))) == "conn 1 req 1"
    assert body(client.get(url(a, "/conn-id"))) == "conn 1 req 2"
    assert body(client.get(url(b, "/conn-id"))) == "conn 1 req 2"
    client.close()
    stop(a)
    stop(b)
}

test "a redirect within a host stays on the connection" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/redir-id"))) == "conn 1 req 2"
    stop(sv)
}

test "Connection: close ends the connection's life" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/close-after"))) == "bye"
    assert body(client.get(url(sv, "/conn-id"))) == "conn 2 req 1"
    stop(sv)
}

test "HTTP/1.0 is reused only with keep-alive" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/http10"))) == "ok"
    assert body(client.get(url(sv, "/conn-id"))) == "conn 2 req 1"
    let keep = Client()
    assert body(keep.get(url(sv, "/http10-keep"))) == "ok"
    assert body(keep.get(url(sv, "/conn-id"))) == "conn 3 req 2"
    stop(sv)
}

test "the headers decide, not whether the socket happens to be open" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/lies"))) == "lies"
    assert body(client.get(url(sv, "/conn-id"))) == "conn 2 req 1"
    assert body(client.get(url(sv, "/lies10"))) == "lies"
    assert body(client.get(url(sv, "/conn-id"))) == "conn 3 req 1"
    stop(sv)
}

test "a response that ends with the connection is not reused" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/close"))) == "until close"
    assert body(client.get(url(sv, "/conn-id"))) == "conn 2 req 1"
    stop(sv)
}

test "chunked, HEAD and 204 responses leave the connection reusable" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/chunked"))) == "Wikipedia in\r\n\r\nchunks."
    assert (must client.fetch("HEAD", url(sv, "/head"))).status == 200
    assert (must client.get(url(sv, "/nocontent"))).status == 204
    assert body(client.get(url(sv, "/conn-id"))) == "conn 1 req 4"
    stop(sv)
}

test "a connection the server closed meanwhile is replaced, whatever the method" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/silent-close"))) == "closing"
    pause(200)
    assert body(client.get(url(sv, "/conn-id"))) == "conn 2 req 1"
    assert body(client.get(url(sv, "/silent-close"))) == "closing"
    pause(200)
    let posted = client.post(url(sv, "/echo"), b("data"), content_type: "text/plain")
    assert body(posted).starts_with("POST /echo")
    stop(sv)
}

test "idle: an old idle connection is not used" {
    let sv = start_fixture()
    let client = Client(idle: Duration(ms: 100))
    assert body(client.get(url(sv, "/conn-id"))) == "conn 1 req 1"
    pause(300)
    assert body(client.get(url(sv, "/conn-id"))) == "conn 2 req 1"
    stop(sv)
}

test "the Client works after close" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/conn-id"))) == "conn 1 req 1"
    client.close()
    client.close()
    assert body(client.get(url(sv, "/conn-id"))) == "conn 2 req 1"
    stop(sv)
}

test "a connection that dropped the request is retried for a GET" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/hello"))) == "hello"
    assert body(client.get(url(sv, "/flaky"))) == "recovered"
    assert body(get(url(sv, "/flaky-count"))) == "2"
    stop(sv)
}

test "the retry happens once, so a request dropped twice fails" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/hello"))) == "hello"
    assert fails(client.get(url(sv, "/drop")), .UnexpectedEof, "")
    assert body(get(url(sv, "/drops"))) == "2"
    stop(sv)
}

test "a POST is not repeated" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/hello"))) == "hello"
    assert fails(client.post(url(sv, "/drop"), b("x"), content_type: "text/plain"), .UnexpectedEof, "")
    assert body(get(url(sv, "/drops"))) == "1"
    stop(sv)
}

test "a request on a new connection is not repeated either" {
    let sv = start_fixture()
    let client = Client()
    assert fails(client.get(url(sv, "/drop")), .UnexpectedEof, "")
    assert body(get(url(sv, "/drops"))) == "1"
    stop(sv)
}

test "after an error the connection is not reused" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/conn-id"))) == "conn 1 req 1"
    assert fails(client.get(url(sv, "/truncated")), .UnexpectedEof, "")
    assert body(client.get(url(sv, "/conn-id"))) == "conn 2 req 1"
    stop(sv)
}

test "deadlines and timeouts apply to a reused connection" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/hello"))) == "hello"
    let r = client.fetch("GET", url(sv, "/slow"), options: Options(deadline: Duration(ms: 300)))
    assert fails(r, .TimedOut, "deadline exceeded")
    assert body(client.get(url(sv, "/hello"))) == "hello"
    let t = client.fetch("GET", url(sv, "/slow"), options: Options(timeout: Duration(ms: 200)))
    assert fails(t, .TimedOut, "")
    stop(sv)
}

test "a big body followed by another request" {
    let sv = start_fixture()
    let client = Client()
    assert len((must client.get(url(sv, "/big"))).body) == 3000000
    assert body(client.get(url(sv, "/conn-id"))) == "conn 1 req 2"
    stop(sv)
}

// ---- compression ----

test "gzip: a response is decoded and its headers describe the decoded body" {
    let sv = start_fixture()
    let r = must get(url(sv, "/gzip"))
    assert r.text() == "hello gzip"
    assert r.header("content-encoding") is none
    assert (r.header("content-length")? or "!") == "10"
    stop(sv)
}

test "gzip: Accept-Encoding is sent unless turned off or set by the caller" {
    let sv = start_fixture()
    assert body(get(url(sv, "/echo"))).contains("Accept-Encoding: gzip\n")
    let off = Options(accept_gzip: false)
    assert not body(fetch("GET", url(sv, "/echo"), options: off)).contains("Accept-Encoding")
    let mine = Options()
    mine.headers.add("Accept-Encoding", "identity")
    let echoed = body(fetch("GET", url(sv, "/echo"), options: mine))
    assert echoed.contains("Accept-Encoding: identity\n")
    assert not echoed.contains("gzip")
    stop(sv)
}

test "gzip: a response that says gzip is decoded even when we did not ask" {
    let sv = start_fixture()
    let off = Options(accept_gzip: false)
    assert body(fetch("GET", url(sv, "/gzip"), options: off)) == "hello gzip"
    stop(sv)
}

test "gzip: chunked, x-gzip, empty and UTF-8 bodies" {
    let sv = start_fixture()
    assert body(get(url(sv, "/gzip-chunked"))) == "hello gzip"
    assert body(get(url(sv, "/x-gzip"))) == "hello gzip"
    assert body(get(url(sv, "/gzip-empty"))) == ""
    assert body(get(url(sv, "/gzip-utf8"))) == "Café ☕"
    stop(sv)
}

test "gzip: a body that is not gzip is a Protocol error" {
    let sv = start_fixture()
    assert fails(get(url(sv, "/gzip-bad")), .Protocol, "bad gzip body")
    stop(sv)
}

test "gzip: a body that inflates past max_body is refused, not decoded" {
    let sv = start_fixture()
    assert fails(get(url(sv, "/gzip-bomb")), .Protocol, "body too large")
    let small = Options(limits: Limits(max_body: 1000000, max_header_bytes: 65536, max_headers: 100))
    assert fails(fetch("GET", url(sv, "/gzip-big"), options: small), .Protocol, "body too large")
    let roomy = Options(limits: Limits(max_body: 5000000, max_header_bytes: 65536, max_headers: 100))
    assert len((must fetch("GET", url(sv, "/gzip-big"), options: roomy)).body) == 4800000
    stop(sv)
}

test "gzip: other codings and lists of codings are left as they came" {
    let sv = start_fixture()
    let br = must get(url(sv, "/br"))
    assert (br.header("content-encoding")? or "!") == "br"
    assert len(br.body) == 9
    let list = must get(url(sv, "/gzip-list"))
    assert (list.header("content-encoding")? or "!") == "gzip, br"
    assert list.body[0] == 31 and list.body[1] == 139
    stop(sv)
}

test "gzip: a HEAD response has no body to decode" {
    let sv = start_fixture()
    let r = must fetch("HEAD", url(sv, "/gzip"))
    assert len(r.body) == 0
    assert (r.header("content-encoding")? or "!") == "gzip"
    stop(sv)
}

test "gzip: the connection stays usable after a decoded response" {
    let sv = start_fixture()
    let client = Client()
    assert body(client.get(url(sv, "/gzip"))) == "hello gzip"
    assert body(client.get(url(sv, "/gzip-chunked"))) == "hello gzip"
    assert body(client.get(url(sv, "/conn-id"))) == "conn 1 req 3"
    stop(sv)
}

// ---- https ----

func cert_path() -> str {
    return "build/client_test_cert.pem"
}

func key_path() -> str {
    return "build/client_test_key.pem"
}

func make_certificate() -> none {
    if not io.is_file(cert_path()) or not io.is_file(key_path()) {
        let made = process.run(["/usr/bin/openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout", key_path(), "-out", cert_path(), "-subj", "/CN=localhost", "-days", "30", "-addext", "subjectAltName=DNS:localhost", "-addext", "extendedKeyUsage=serverAuth"])
        assert made.status == 0
    }
}

// The fixture server speaking TLS 1.2 with the test certificate.
func start_tls_fixture() -> Server {
    make_certificate()
    return start_fixture_with([cert_path(), key_path()])
}

// The command line of `openssl s_server -www` on `port`; the perl wrapper stops
// it after two minutes if a test dies.
func s_server(anon port: int64, version: str) -> [str] {
    return ["perl", "-e", "alarm 120; exec @ARGV", "/usr/bin/openssl", "s_server", "-accept", f"{port}", "-cert", cert_path(), "-key", key_path(), "-www", "-quiet", version]
}

func start_tls_server() -> Server {
    make_certificate()
    let l = must tcp.listen("127.0.0.1", port: 0)
    let port = l.port()
    must l.close()
    let pid = process.spawn(s_server(port, version: "-tls1_2"))
    assert pid > 0
    mut tries: int64 = 0
    for tries < 100 {
        let c = tcp.connect("127.0.0.1", port: port)
        if c is Ok(conn) {
            must conn.close()
            return Server(pid: pid, port: port)
        }
        time.sleep(Duration(ms: 50))
        tries = tries + 1
    }
    assert false
    return Server(pid: pid, port: port)
}

test "https with a trusted certificate" {
    let sv = start_tls_server()
    let options = Options(trust_file: cert_path())
    let r = must fetch("GET", f"https://localhost:{sv.port}/", options: options)
    assert r.status == 200
    assert r.text().contains("</HTML>")
    stop(sv)
}

test "https with an untrusted certificate is an error" {
    let sv = start_tls_server()
    assert fails(get(f"https://localhost:{sv.port}/"), .Tls, "")
    stop(sv)
}

test "https connections are kept too" {
    let sv = start_tls_fixture()
    let options = Options(trust_file: cert_path())
    let client = Client()
    let a = must client.fetch("GET", f"https://localhost:{sv.port}/conn-id", options: options)
    let b2 = must client.fetch("GET", f"https://localhost:{sv.port}/conn-id", options: options)
    assert a.text() == "conn 1 req 1"
    assert b2.text() == "conn 1 req 2"
    let c = must client.fetch("GET", f"https://localhost:{sv.port}/chunked", options: options)
    assert c.text() == "Wikipedia in\r\n\r\nchunks."
    client.close()
    stop(sv)
}

test "https: a connection that dropped the request is retried" {
    let sv = start_tls_fixture()
    let options = Options(trust_file: cert_path())
    let client = Client()
    let first = must client.fetch("GET", f"https://localhost:{sv.port}/hello", options: options)
    assert first.status == 200
    let second = must client.fetch("GET", f"https://localhost:{sv.port}/flaky", options: options)
    assert second.text() == "recovered"
    stop(sv)
}

test "https: the client's trust_file and a request's" {
    let sv = start_tls_fixture()
    let client = Client(trust_file: cert_path())
    let r = must client.get(f"https://localhost:{sv.port}/hello")
    assert r.text() == "hello"
    let stranger = Client()
    assert fails(stranger.get(f"https://localhost:{sv.port}/hello"), .Tls, "")
    let ok = must stranger.get(f"https://localhost:{sv.port}/hello", options: Options(trust_file: cert_path()))
    assert ok.status == 200
    stop(sv)
}
