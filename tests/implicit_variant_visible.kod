// A context-free `.Variant` counts only the enums of its own module, the
// modules it imports and the builtins: the dep's generic methods keep their
// `Mode` variants though this module declares `Fast` too, and `.Turbo` here
// isn't ambiguous with the `Gear` of a module only the dep imports.
import "./implicit_variant_visible_dep"

type Speed = enum {
    Fast
    Turbo
}

type IBox = implicit_variant_visible_dep.Box[int64]

func name(anon s: Speed) -> str {
    match s {
        .Fast -> return "fast"
        .Turbo -> return "turbo"
    }
}

func main() -> int64 {
    let b = IBox(v: 1)
    print_int(b.fast_rank())
    print_int(b.modes())
    let s = .Turbo
    print(name(s))
    return 0
}

// expected output:
// 1
// 11
// turbo
