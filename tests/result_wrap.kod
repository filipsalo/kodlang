// A `T` goes where a `T or Error` is declared as its `Ok`, in every typed position.

type Oops = struct {
    code: int64

    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

type Status = enum {
    Fine
    Failed(code: int64)
}

type Halved = int64 or Error

type Holder = struct {
    r: int64 or Error
}

func half(anon n: int64) -> int64 or Error {
    if n % 2 != 0 {
        throw Oops(code: n)
    }
    return n / 2
}

func show(anon r: int64 or Error) -> str {
    match r {
        Ok(v) -> return f"ok {v}"
        Err(e) -> return f"err {e.to_str()}"
    }
}

func show_status(anon r: Status or Error) -> str {
    match r {
        Ok(.Fine) -> return "fine"
        Ok(.Failed(code)) -> return f"failed {code}"
        Err(e) -> return e.to_str()
    }
}

func show_nested(anon r: Halved or Error) -> str {
    match r {
        Ok(inner) -> return f"outer ok, {show(inner)}"
        Err(e) -> return f"outer err {e.to_str()}"
    }
}

func pick(anon n: int64) -> Halved or Error {
    if n < 0 {
        throw Oops(code: 0)
    }
    if n == 0 {
        return half(1)
    }
    return n
}

func first[T](anon xs: [T]) -> T or Error {
    if len(xs) == 0 {
        throw Oops(code: -1)
    }
    return xs[0]
}

func main() -> int64 {
    let r: int64 or Error = 3
    print(show(r))
    mut m: int64 or Error = half(3)
    print(show(m))
    m = 8
    print(show(m))
    print(show(5))
    print(show(half(4)))

    let rs: [int64 or Error] = [1, half(5), 6]
    for x in rs {
        print(show(x))
    }

    let h = Holder(r: 7)
    print(show(h.r))
    h.r = half(9)
    print(show(h.r))

    let s: Status or Error = .Failed(code: 2)
    print(show_status(s))
    print(show_status(.Fine))

    let n: Halved or Error = 4
    print(show_nested(n))
    print(show_nested(pick(3)))
    print(show_nested(pick(0)))
    print(show_nested(pick(-1)))

    let o: int64? or Error = none
    if o is Ok(v) {
        print(v is none)
    }

    let picked: int64 or Error = match len(rs) {
        3 -> 30
        else -> half(1)
    }
    print(show(picked))

    let errs: [Error] = [Oops(code: 11)]
    let found: Error or Error = first(errs)
    match found {
        Ok(e) -> print(f"found {e.to_str()}")
        Err(e) -> print(f"none: {e.to_str()}")
    }
    let empty: [Error] = []
    match first(empty) {
        Ok(e) -> print(f"found {e.to_str()}")
        Err(e) -> print(f"none: {e.to_str()}")
    }
    let as_ok: Error or Error = Oops(code: 12)
    print(as_ok is Ok(_))

    let made: int64 or Error = .Ok(value: 13)
    print(show(made))
    return 0
}

// expected output:
// ok 3
// err oops 3
// ok 8
// ok 5
// ok 2
// ok 1
// err oops 5
// ok 6
// ok 7
// err oops 9
// failed 2
// fine
// outer ok, ok 4
// outer ok, ok 3
// outer ok, err oops 1
// outer err oops 0
// true
// ok 30
// found oops 11
// none: oops -1
// true
// ok 13
