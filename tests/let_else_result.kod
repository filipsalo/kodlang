// `let .Variant(...) = value else` looks the variant up in the value's
// own enum: a Result instance for `T or Error`, and the right enum when
// another one declares a variant of the same name.

type Oops = struct {
    func to_str(self) -> str {
        return "oops"
    }
}

type Shade = enum {
    Dark(level: int64)
}

type Paint = enum {
    Gloss(name: str)
    Dark(name: str)
}

func parse(anon s: str) -> str or Error {
    if s == "" {
        throw Oops()
    }
    return s + s
}

func run(anon s: str) -> int64 {
    let .Ok(v) = parse(s) else { return 1 }
    print(f"{v}!")
    return 0
}

func paint_name(anon p: Paint) -> str {
    let .Dark(name) = p else { return "not dark" }
    return f"dark {name}"
}

func main() -> int64 {
    print(f"run x: {run("x")}")
    print(f"run empty: {run("")}")
    print(paint_name(Paint.Dark(name: "ink")))
    print(paint_name(Paint.Gloss(name: "wax")))
    let s: Shade = Shade.Dark(level: 3)
    let .Dark(level) = s else { return 1 }
    print(f"shade {level}")
    return 0
}

// expected output:
// xx!
// run x: 0
// run empty: 1
// dark ink
// not dark
// shade 3
// expected status:
// 0
