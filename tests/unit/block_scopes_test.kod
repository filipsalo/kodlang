// Every block has its own scope: a binding may hide one still in force,
// whatever kind either is, and the hidden one is back after the block with
// its own value, type and mutability.
import "./../alias_local_dep"

type A = shared struct {
    x: int64

    func show(self) -> str {
        return f"A{self.x}"
    }

    func swap(self, anon flag: bool) -> str {
        if flag {
            let self = B(x: self.x + 1)
            return self.show()
        }
        return self.show()
    }
}

type B = shared struct {
    x: int64

    func show(self) -> str {
        return f"B{self.x}"
    }
}

interface Shape {
    func area(self) -> int64
}

type Pt = shared struct {
    x: int64

    func area(self) -> int64 {
        return self.x
    }
}

func pick(anon n: int64) -> int64? {
    if n > 0 {
        return n
    }
    return none
}

func param(anon item: A, anon flag: bool) -> str {
    if flag {
        let item = B(x: 9)
        return item.show()
    }
    return item.show()
}

func levels(anon n: int64) -> str {
    mut x = 1
    mut out = ""
    if n > 0 {
        let x = "two"
        out += x
        if n > 1 {
            mut x = 3
            x += 1
            out += f"{x}"
        }
        out += x
    }
    x = x + 10
    return f"{out} {x}"
}

func siblings(anon n: int64) -> int64 {
    let v = 100
    mut total = 0
    if n > 0 {
        let v = "abc"
        total += len(v)
    }
    if n > 1 {
        let v = n * 2
        total += v
    }
    return total + v
}

func sibling_mut(anon n: int64) -> str {
    mut a = 0
    mut out = ""
    if n > 5 {
        let a = 7
        out += f"{a} "
    }
    for a in [1, 2] {
        a = a * 10
        out += f"{a} "
    }
    match pick(n) {
        Some(a) -> {
            a += 100
            out += f"{a} "
        }
        none -> out += "none "
    }
    a = a + 1
    return f"{out}{a}"
}

func loop_break(anon xs: [int64]) -> int64 {
    let x = 7
    mut seen = 0
    for v in xs {
        let x = v * 10
        if x > 20 {
            break
        }
        seen += x
    }
    return seen + x
}

func loops(anon x: [str]) -> int64 {
    mut sum = 0
    for x in x {
        for x in [1, 2] {
            sum += x
        }
        sum += len(x) * 10
    }
    return sum + len(x)
}

func if_is(anon o: int64?) -> int64 {
    if o is Some(o) {
        return o + 1
    } else {
        assert o is none
    }
    return 0
}

func arms(anon v: int64?) -> str {
    let w = "outer"
    match v {
        Some(w) -> {
            if w > 3 {
                let w = f"big{w}"
                return w
            }
            return f"small{w}"
        }
        none -> return w
    }
}

func let_else(anon v: int64?) -> str {
    let s = "start"
    if true {
        let .Some(s) = v else {
            return f"none after {s}"
        }
        return f"got {s}"
    }
    return s
}

func match_values(anon v: int64?) -> int64 {
    let q = 5
    let r = match v {
        Some(q) -> match pick(q - 1) {
            Some(q) -> q * 100
            none -> q
        }
        none -> q
    }
    return r + q
}

func alias(anon flag: bool) -> int64 {
    let dep = A(x: 1)
    if flag {
        let dep = dep.x + 1
        return dep
    }
    return dep.x
}

func alias_back() -> int64 {
    return alias_local_dep.value()
}

func label(x: int64) -> str {
    return f"x={x}"
}

func args(anon x: int64) -> str {
    mut out = label(:x)
    if x > 0 {
        mut x = x * 10
        x += 1
        out += f" {label(:x)} {x}"
    }
    return out
}

func downcast(anon s: Shape, anon pt: int64) -> str {
    if pt > 0 {
        let pt = 7
        if s is Pt {
            return f"is Pt {pt}"
        }
    }
    return f"{pt}"
}

func under(anon a: int64?, anon b: int64?) -> int64 {
    match a {
        .Some(_) -> {
            match b {
                .Some(_) -> return 1
                else -> return 2
            }
        }
        else -> return 3
    }
}

test "a binding hides self and parameters" {
    assert A(x: 1).swap(true) == "B2"
    assert A(x: 1).swap(false) == "A1"
    assert param(A(x: 1), true) == "B9"
    assert param(A(x: 1), false) == "A1"
}

test "nested and sibling blocks" {
    assert levels(0) == " 11"
    assert levels(1) == "twotwo 11"
    assert levels(2) == "two4two 11"
    assert siblings(2) == 107
    assert sibling_mut(1) == "10 20 101 1"
    assert sibling_mut(9) == "7 10 20 109 1"
}

test "loops" {
    assert loop_break([1, 2, 3]) == 37
    assert loops(["a", "bb"]) == 38
}

test "if-is, match arms and let-else" {
    assert if_is(4) == 5
    assert if_is(none) == 0
    assert arms(5) == "big5"
    assert arms(2) == "small2"
    assert arms(none) == "outer"
    assert let_else(7) == "got 7"
    assert let_else(none) == "none after start"
    assert match_values(4) == 305
    assert match_values(1) == 6
    assert match_values(none) == 10
}

test "module aliases, labels, downcasts and wildcards" {
    assert alias(true) == 2
    assert alias(false) == 1
    assert alias_back() == 1
    assert args(2) == "x=2 x=21 21"
    assert downcast(Pt(x: 2), 1) == "is Pt 7"
    assert downcast(Pt(x: 2), 0) == "0"
    assert under(1, 2) == 1
    assert under(1, none) == 2
    assert under(none, 1) == 3
}
