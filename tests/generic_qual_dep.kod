type Pt = struct {
    x: int64
}

type Box[T] = struct {
    v: T

    func get(self) -> T {
        return self.v
    }
}

type Pair[A, B] = struct {
    a: A
    b: B
}

type Opt[T] = enum {
    Yes(v: T)
    No
}

func fns() -> [func(int64) -> int64] {
    return [func(anon n: int64) -> int64 {
        return n + 1
    }]
}

func first[T](anon xs: [T]) -> T {
    return xs[0]
}

func add_one(anon n: int64) -> int64 {
    return n + 1
}

let TABLE: [func(int64) -> int64] = [add_one]

type _Hidden[T] = struct {
    v: T
}
