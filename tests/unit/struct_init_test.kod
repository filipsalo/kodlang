// A struct that declares `init` is built through it; inside the struct the field constructor stays.
import "./../struct_init_dep"
import "./../struct_init_dep" { Port }

mut inits: int64 = 0

type Celsius = shared struct {
    degrees: int64

    func init(kelvin: int64 = 0, offset: int64 = 0) -> Celsius {
        inits += 1
        return Celsius(degrees: kelvin - 273 + offset)
    }

    func warmer(self, by: int64) -> Celsius {
        return Celsius(degrees: self.degrees + by)
    }
}

type Plain = shared struct {
    n: int64 = 7
}

type Pair = shared struct {
    left: Celsius
    right: Celsius = Celsius(kelvin: 283)
}

func open(anon n: int64) -> int64 or Error {
    let p = try Port(number: n)
    return p.number
}

test "init builds the struct; the field constructor inside it does not" {
    let a = Celsius(kelvin: 300)
    assert inits == 1
    assert a.degrees == 27
    let b = Celsius(offset: 5)
    assert inits == 2
    assert b.degrees == -268
    assert a.warmer(by: 10).degrees == 37
    let c: Celsius = Celsius(kelvin: 273)
    assert inits == 3
    assert c.degrees == 0
    assert Plain().n == 7

    let pair = Pair(left: a)
    assert inits == 4
    assert pair.right.degrees == 10
}

test "a throwing init and inits in another module" {
    assert must open(8080) == 8080
    if open(0) is Err(e) {
        assert e.to_str() == "bad port 0"
    } else {
        fail("open(0) did not throw")
    }
    if open(70000) is Err(e) {
        assert e.to_str() == "bad port 70000"
    } else {
        fail("open(70000) did not throw")
    }
    let p = must struct_init_dep.Port(number: 80)
    assert p.next().number == 81
    assert struct_init_dep.Temp(kelvin: 300).degrees == 27
    assert struct_init_dep.Temp(celsius: 5).degrees == -268
}
