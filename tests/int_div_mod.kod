// Integer `/` and `%` truncate toward zero (C-style, matching ARM64 sdiv),
// so the remainder takes the dividend's sign, on negative operands too.
func main() -> int64 {
    print_int((0 - 7) / 2)        // -3, not -4
    print_int((0 - 7) % 3)        // -1, not 2
    print_int(7 % (0 - 3))        // 1, not -2
    print_int((0 - 7) / (0 - 2))  // 3
    print_int(7 / 2)              // 3
    // The one quotient that doesn't fit wraps; its remainder is 0.
    let min = -9223372036854775808
    let minus_one = 0 - 1
    print_int(min / minus_one)
    print_int(min % minus_one)
    // A nonzero divisor, literal or not, never panics.
    print_int(min / 2)
    return 0
}

// expected output:
// -3
// -1
// 1
// 3
// 3
// -9223372036854775808
// 0
// -4611686018427387904
