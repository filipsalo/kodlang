func count_true(anon flags: [bool]) -> int64 {
    mut n = 0
    for f in flags {
        if f {
            n += 1
        }
    }
    return n
}

func main() -> int64 {
    let flags: [bool] = [true, false, true]
    print(f"{flags[0]} {flags[1]}")
    if flags[1] == false {
        print("second is false")
    }
    print(f"{count_true(flags)}")
    let more = [false, true]
    print(f"{more[1]} {len(flags + more)}")

    let grid: [[int64]] = [[1, 2], [3]]
    for row in grid {
        mut total = 0
        for x in row {
            total += x
        }
        print(f"{len(row)} {total}")
    }
    print(f"{grid[0][1]} {grid[-1][0]}")
    let wider = grid + [[4, 5, 6]]
    print(f"{len(wider)} {wider[2][2]}")
    let head = grid[0..1]
    print(f"{len(head)} {head[0][0]}")

    let words = [["a", "b"], ["c"]]
    print(words[0][1] + words[1][0])
    for ws in words {
        for w in ws {
            print(w)
        }
    }
    return 0
}

// expected output:
// true false
// second is false
// 2
// true 5
// 2 3
// 1 3
// 2 3
// 3 6
// 1 1
// bc
// a
// b
// c
