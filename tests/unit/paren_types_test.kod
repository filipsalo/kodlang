// Parentheses group a type: an optional union, a function in a union, a nested result.

type Oops = shared struct {
    func to_str(self) -> str {
        return "oops"
    }
}

func show(anon x: (int64 | str)?) -> str {
    match x {
        int64(n) -> return f"int {n}"
        str(s) -> return f"str {s}"
        none -> return "none"
    }
}

type Thunk = func() -> int64

func run(anon f: (func() -> int64) | str) -> str {
    match f {
        str(s) -> return s
        Thunk(g) -> return f"ran {g()}"
    }
}

func seven() -> int64 {
    return 7
}

func nested(anon n: int64) -> (int64 or Error) or Error {
    if n < 0 {
        throw Oops()
    }
    if n == 0 {
        let inner: int64 or Error = .Err(error: Oops())
        return inner
    }
    return n
}

func flat(anon n: int64) -> int64 or Error or Error {
    return n
}

func describe(anon r: (int64 or Error) or Error) -> str {
    match r {
        Ok(Ok(n)) -> return f"ok ok {n}"
        Ok(Err(_e)) -> return "ok err"
        Err(_e) -> return "err"
    }
}

test "an optional union" {
    assert show(3) == "int 3"
    assert show("a") == "str a"
    assert show(none) == "none"
    let xs: [(int64 | str)?] = [1, none, "b"]
    mut shown: [str] = []
    for x in xs {
        shown += [show(x)]
    }
    assert shown == ["int 1", "none", "str b"]
}

test "a function in a union" {
    assert run(seven) == "ran 7"
    assert run("text") == "text"
}

test "a nested result" {
    assert describe(nested(4)) == "ok ok 4"
    assert describe(nested(0)) == "ok err"
    assert describe(nested(-1)) == "err"
    let plain: int64 or Error = flat(5)
    assert (plain? or 0) == 5
}

test "parentheses around a plain type" {
    let p: ((int64)) = 8
    assert p == 8
}
