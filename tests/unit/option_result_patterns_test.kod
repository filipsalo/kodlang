// .Some/.None on a T? and .Ok/.Err on a T or Error match in match, is and let-else.
type Oops = shared struct {
    message: str
    func to_str(self) -> str { return self.message }
}
type Color = enum {
    Red
    Green
}
func half(anon n: int64) -> int64 or Error {
    if n % 2 == 1 {
        throw Oops(message: "odd")
    }
    return n / 2
}
func first(anon n: int64) -> Color? {
    if n == 0 {
        return .Red
    }
    return none
}
test ".Some and .None on an optional" {
    let o: int64? = 5
    if o is .Some(v) {
        assert v == 5
    } else {
        fail("o is not some")
    }
    match o {
        .Some(v) -> assert f"match some {v}" == "match some 5"
        .None -> fail("match none")
    }
    let n: int64? = none
    match n {
        .Some(v) -> fail(f"n some {v}")
        .None -> {}
    }
    assert n is .None
    let label = match o {
        .Some(v) -> f"label {v}"
        .None -> "label none"
    }
    assert label == "label 5"
    let isn = n is .None
    let iss = o is .Some
    assert f"{isn} {iss} {o is .None} {n is not .None}" == "true true false false"
    let c = first(0)
    match c {
        .Some(col) -> assert col is .Red
        .None -> fail("no color")
    }
}

test ".Ok and .Err on a result" {
    let r = half(8)
    match r {
        .Ok(v) -> assert v == 4
        .Err(e) -> fail(f"err {e.to_str()}")
    }
    if r is .Ok(v) {
        assert v == 4
    } else {
        fail("r is not ok")
    }
    let q = half(3)
    let msg = match q {
        .Ok(v) -> f"ok {v}"
        .Err(e) -> f"err {e.to_str()}"
    }
    assert msg == "err odd"
    assert f"{r is .Ok} {q is .Ok} {q is .Err} {r is not .Err}" == "true false true true"
    let made: int64 or Error = .Ok(value: 3)
    match made {
        Ok(v) -> assert v == 3
        Err(e) -> fail("made err")
    }
    assert must made == 3
}
