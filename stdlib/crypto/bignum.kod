// Arithmetic on big non-negative numbers modulo an odd modulus, for RSA and
// ECDSA (crypto/rsa, crypto/ecdsa).
//
// A number is an array of 64-bit limbs, the lowest first, as long as its
// modulus's. A limb is an int64 holding the word's bits: the arithmetic is
// unsigned, with wrapping_add and wrapping_mul, mul_high for the top half of
// a product, and carries and borrows worked out from the sign bits.
// Multiplication is Montgomery's.
//
// `from_bytes`, `to_bytes` and the arithmetic of a `Modulus` (mul, add, sub,
// pow_secret, and pow with a public exponent) do the same steps whatever the
// numbers are, so signing can use them on a private key; `compare`,
// `is_zero`, `bit_length` and `number` look at the values, and are for public
// ones.

let BITS: int64 = 64
let TOP: int64 = 1 << 63

// The limbs a number of `size` bytes takes.
func limbs(anon size: int64) -> int64 {
    return (size + 7) / 8
}

// The carry out of s = a + b (wrapping): 1 or 0.
func carry_of(anon a: int64, anon b: int64, anon s: int64) -> int64 {
    return ((a & b) | ((a | b) & (s ^ -1))) >> 63
}

// The borrow out of d = a - b (wrapping): 1 or 0.
func borrow_of(anon a: int64, anon b: int64, anon d: int64) -> int64 {
    let na = a ^ -1
    return ((na & b) | ((na | b) & d)) >> 63
}

// The number `b` holds, big-endian, in `k` limbs, or none when it needs more.
func from_bytes(anon b: bytes, k: int64) -> [int64]? {
    mut out = [0] * k
    // The bytes that would go above the top limb.
    mut over = 0
    for i in 0..len(b) {
        let at = len(b) - 1 - i
        let limb = i / 8
        if limb < k {
            out[limb] = out[limb] | (b[at] << (8 * (i % 8)))
        } else {
            over = over | b[at]
        }
    }
    if over != 0 {
        return none
    }
    return out
}

// `x` as `size` big-endian bytes; its high bits beyond those are dropped.
func to_bytes(anon x: [int64], size: int64) -> bytes {
    mut out = [0] * size
    for i in 0..size {
        let limb = i / 8
        if limb < len(x) {
            out[size - 1 - i] = (x[limb] >> (8 * (i % 8))) & 255
        }
    }
    return kod_bytes_from_array(out)
}

// -1, 0 or 1 as `a` is below, equal to or above `b` (of one length).
func compare(anon a: [int64], anon b: [int64]) -> int64 {
    for i in len(a) - 1..=0 step -1 {
        if a[i] != b[i] {
            return if (a[i] ^ TOP) < (b[i] ^ TOP) { -1 } else { 1 }
        }
    }
    return 0
}

func is_zero(anon a: [int64]) -> bool {
    for x in a {
        if x != 0 {
            return false
        }
    }
    return true
}

// a - b, for a >= b.
func sub(anon a: [int64], anon b: [int64]) -> [int64] {
    let (out, _borrow) = sub_borrow(a, b)
    return out
}

// a - b mod 2^(64 k), and 1 when that borrowed (a < b), else 0.
func sub_borrow(anon a: [int64], anon b: [int64]) -> ([int64], int64) {
    mut out = a
    mut borrow = 0
    for i in 0..len(a) {
        let x = a[i]
        let d = x.wrapping_sub(b[i])
        let d2 = d.wrapping_sub(borrow)
        borrow = borrow_of(x, b[i], d) | borrow_of(d, borrow, d2)
        out[i] = d2
    }
    return (out, borrow)
}

// x where `take_x` is 1, y where it is 0, by masks.
func choose(anon take_x: int64, anon x: [int64], anon y: [int64]) -> [int64] {
    let mask = 0 - take_x
    let keep = mask ^ -1
    mut out = y
    for i in 0..len(x) {
        out[i] = (x[i] & mask) | (y[i] & keep)
    }
    return out
}

// a + b and the carry out of the top limb.
func add_carry(anon a: [int64], anon b: [int64]) -> ([int64], int64) {
    mut out = a
    mut carry = 0
    for i in 0..len(a) {
        let x = a[i]
        let s = x.wrapping_add(b[i])
        let s2 = s.wrapping_add(carry)
        carry = carry_of(x, b[i], s) | carry_of(s, carry, s2)
        out[i] = s2
    }
    return (out, carry)
}

// The number of bits up to the highest one bit.
func bit_length(anon a: [int64]) -> int64 {
    for i in len(a) - 1..=0 step -1 {
        if a[i] != 0 {
            return i * BITS + 64 - a[i].leading_zeros()
        }
    }
    return 0
}

func bit(anon a: [int64], anon i: int64) -> int64 {
    return (a[i / BITS] >> (i % BITS)) & 1
}

// An odd modulus and what Montgomery multiplication by it needs. Numbers
// "in the Montgomery form" are x * R mod m, R = 2^(64 k).
type Modulus = struct {
    m: [int64]
    k: int64
    // -1 / m mod 2^64.
    m_inv: int64
    // R^2 mod m, to bring a number into the form.
    r2: [int64]

    func init(anon m: bytes) -> Modulus {
        let k = limbs(len(m))
        let ms = must from_bytes(m, k: k)
        if ms[0] & 1 == 0 {
            panic("bignum: the modulus is even")
        }
        // Newton's iteration doubles the bits that are right each time.
        mut inv = 1
        for _i in 0..6 {
            inv = inv.wrapping_mul(2.wrapping_sub(ms[0].wrapping_mul(inv)))
        }
        // R mod m, which is 1 in the form: 2^L - m for m of L bits, then
        // doubled up to 2^(64 k).
        let size = bit_length(ms)
        mut top = [0] * k
        mut one = top
        if size < BITS * k {
            top[size / BITS] = 1 << (size % BITS)
            one = sub(top, ms)
        } else {
            // 2^(64 k) - m, taken as its two's complement within k limbs.
            let (minus, _b) = sub_borrow(top, ms)
            one = minus
        }
        let base = Modulus(m: ms, k: k, m_inv: 0 - inv, r2: [])
        for _i in size..BITS * k {
            one = base.add(one, one)
        }
        // R^2 is R in the form: 2 in the form, raised to 64 k.
        let two = base.add(one, one)
        mut r = one
        let e = BITS * k
        for i in 63 - e.leading_zeros()..=0 step -1 {
            r = base.mul(r, r)
            if (e >> i) & 1 == 1 {
                r = base.mul(r, two)
            }
        }
        return Modulus(m: ms, k: k, m_inv: 0 - inv, r2: r)
    }

    // a * b / R mod m, for a and b below m.
    func mul(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let k = self.k
        let m = self.m
        let m_inv = self.m_inv
        // All ones, for the carries: kept in a register rather than made each time.
        let ones = -1
        mut t = [0] * (k + 2)
        for i in 0..k {
            let bi = b[i]
            // t += a bi.
            mut carry = 0
            for j in 0..k {
                let aj = a[j]
                let lo = aj.wrapping_mul(bi)
                let hi = aj.mul_high(bi)
                let tj = t[j]
                let s = tj.wrapping_add(lo)
                let s2 = s.wrapping_add(carry)
                // Both carries can be 1, when `carry` is large.
                // Both carries can be 1, when the one coming in is large.
                let c = (((tj & lo) | ((tj | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
                t[j] = s2
                carry = hi.wrapping_add(c)
            }
            let tk = t[k]
            let top = tk.wrapping_add(carry)
            t[k] = top
            t[k + 1] = ((tk & carry) | ((tk | carry) & (top ^ ones))) >> 63
            // Add u m, which makes the lowest limb 0, and shift it out.
            let u = t[0].wrapping_mul(m_inv)
            let t0 = t[0]
            let lo0 = u.wrapping_mul(m[0])
            let s0 = t0.wrapping_add(lo0)
            carry = u.mul_high(m[0]).wrapping_add(((t0 & lo0) | ((t0 | lo0) & (s0 ^ ones))) >> 63)
            for j in 1..k {
                let mj = m[j]
                let lo = u.wrapping_mul(mj)
                let hi = u.mul_high(mj)
                let tj = t[j]
                let s = tj.wrapping_add(lo)
                let s2 = s.wrapping_add(carry)
                // Both carries can be 1, when `carry` is large.
                // Both carries can be 1, when the one coming in is large.
                let c = (((tj & lo) | ((tj | lo) & (s ^ ones))) >> 63) + (((s & carry) | ((s | carry) & (s2 ^ ones))) >> 63)
                t[j - 1] = s2
                carry = hi.wrapping_add(c)
            }
            let tk2 = t[k]
            let last = tk2.wrapping_add(carry)
            t[k - 1] = last
            t[k] = t[k + 1] + (((tk2 & carry) | ((tk2 | carry) & (last ^ ones))) >> 63)
        }
        // Below 2m: take m off unless that borrows (and nothing is above).
        let out = t[..k]
        let (less, borrow) = sub_borrow(out, m)
        return choose(t[k] | (borrow ^ 1), less, out)
    }

    func to_mont(self, anon a: [int64]) -> [int64] {
        return self.mul(a, self.r2)
    }

    func from_mont(self, anon a: [int64]) -> [int64] {
        mut one = [0] * self.k
        one[0] = 1
        return self.mul(a, one)
    }

    // 1 in the Montgomery form.
    func one(self) -> [int64] {
        mut one = [0] * self.k
        one[0] = 1
        return self.to_mont(one)
    }

    func add(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let (sum, carry) = add_carry(a, b)
        let (less, borrow) = sub_borrow(sum, self.m)
        return choose(carry | (borrow ^ 1), less, sum)
    }

    func sub(self, anon a: [int64], anon b: [int64]) -> [int64] {
        let (diff, borrow) = sub_borrow(a, b)
        // Below 0 it wrapped by 2^(64 k); adding m and wrapping again gives a - b + m.
        let (plus, _carry) = add_carry(diff, self.m)
        return choose(borrow, plus, diff)
    }

    // base^e (base in the form, e an ordinary number of any length), in the form.
    func pow(self, anon base: [int64], anon e: [int64]) -> [int64] {
        mut r = self.one()
        for i in bit_length(e) - 1..=0 step -1 {
            r = self.mul(r, r)
            if bit(e, i) == 1 {
                r = self.mul(r, base)
            }
        }
        return r
    }

    // base^e (base in the form), in the form, for a secret `e` of at most
    // `bits` bits: 4 bits at a time, each a squaring four times and a
    // multiplication by the table's entry for them, which every entry is
    // looked at to pick. The steps are the same for every e.
    func pow_secret(self, anon base: [int64], anon e: [int64], bits: int64) -> [int64] {
        mut table = [self.one(), base]
        for i in 2..16 {
            table += [self.mul(table[i - 1], base)]
        }
        mut r = self.one()
        let digits = (bits + 3) / 4
        for d in digits - 1..=0 step -1 {
            for _s in 0..4 {
                r = self.mul(r, r)
            }
            mut digit = 0
            for b in 0..4 {
                let at = 4 * d + b
                if at < len(e) * BITS {
                    digit = digit | (bit(e, at) << b)
                }
            }
            mut pick = table[0]
            for j in 1..16 {
                pick = choose(((digit ^ j) - 1) >> 63, table[j], pick)
            }
            r = self.mul(r, pick)
        }
        return r
    }

    // `x`, of up to 2 k limbs (below R^2), mod m in the form: x's low and
    // high halves are each below R, which a multiplication by R^2 takes.
    func reduce_wide(self, anon x: [int64]) -> [int64] {
        let k = self.k
        mut low = [0] * k
        mut high = [0] * k
        for i in 0..min(len(x), 2 * k) {
            if i < k {
                low[i] = x[i]
            } else {
                high[i - k] = x[i]
            }
        }
        // low R / R * R^2 and high R^2 / R * R^2 / R: low and high R, in the form.
        let lo = self.mul(low, self.r2)
        let hi = self.mul(self.mul(high, self.r2), self.r2)
        return self.add(lo, hi)
    }

    // 1 / a mod m for a prime m (a in the form), by Fermat: a^(m - 2).
    func inverse(self, anon a: [int64]) -> [int64] {
        mut two = [0] * self.k
        two[0] = 2
        return self.pow(a, sub(self.m, two))
    }

    // `b`, big-endian and below m, as a number, or none when it is m or more.
    func number(self, anon b: bytes) -> [int64]? {
        let Some(x) = from_bytes(b, k: self.k) else { return none }
        if compare(x, self.m) >= 0 {
            return none
        }
        return x
    }

    // The bytes of m's length.
    func byte_size(self) -> int64 {
        return (bit_length(self.m) + 7) / 8
    }
}

// a b, as len(a) + len(b) limbs.
func mul_plain(anon a: [int64], anon b: [int64]) -> [int64] {
    mut out = [0] * (len(a) + len(b))
    for i in 0..len(a) {
        let ai = a[i]
        mut carry = 0
        for j in 0..len(b) {
            let lo = ai.wrapping_mul(b[j])
            let hi = ai.mul_high(b[j])
            let o = out[i + j]
            let s = o.wrapping_add(lo)
            let s2 = s.wrapping_add(carry)
            out[i + j] = s2
            carry = hi.wrapping_add(carry_of(o, lo, s) + carry_of(s, carry, s2))
        }
        out[i + len(b)] = carry
    }
    return out
}

// a + b, as long as the longer and one more limb.
func add_plain(anon a: [int64], anon b: [int64]) -> [int64] {
    let n = max(len(a), len(b)) + 1
    mut out = [0] * n
    mut carry = 0
    for i in 0..n {
        let x = if i < len(a) { a[i] } else { 0 }
        let y = if i < len(b) { b[i] } else { 0 }
        let s = x.wrapping_add(y)
        let s2 = s.wrapping_add(carry)
        out[i] = s2
        carry = carry_of(x, y, s) | carry_of(s, carry, s2)
    }
    return out
}
