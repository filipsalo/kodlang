type Box = shared struct {
    xs: [int64]
}

func add(mut xs: [int64]) -> none {
    xs += [1]
}

func pair(mut a: [int64], mut b: [int64]) -> none {
    a += b
}

func plain(xs: [int64]) -> int64 {
    return len(xs)
}

func main() -> int64 {
    mut xs = [1]
    let ys = [2]
    let box = Box(xs: [3])
    add(:xs)
    add(xs: mut ys)
    add(xs: mut box.xs)
    print(plain(xs: mut xs))
    pair(a: mut xs, b: mut xs)
    let f = add
    return 0
}

// expected errors:
// 21:10: error: `xs` is a `mut` parameter of `add`: pass `mut xs`
// 22:17: error: cannot pass `ys` as `mut`: it's an immutable binding; declare it with `mut`
// 23:17: error: only a `mut` local or parameter can be passed as `mut`; copy `box.xs` into a `mut` local and assign it back
// 24:25: error: `xs` isn't a `mut` parameter of `plain`; remove the `mut`
// 25:28: error: `xs` is passed as `mut` twice in this call
// 26:13: error: `add` has a `mut` parameter, so it can only be called by name
