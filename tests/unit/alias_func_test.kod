// A function named like an import alias doesn't hide the module.
import "./../alias_func_dep"

func alias_func_dep() -> int64 {
    return 5
}

func high() -> alias_func_dep.Tone {
    return .High
}

func bumped(n: int64 = alias_func_dep.value() + 1) -> int64 {
    return n
}

type Holder = shared struct {
    a: int64 = alias_func_dep.value()
}

func checked(anon n: int64) -> alias_func_dep.R {
    if n < 0 {
        throw alias_func_dep.Oops(code: n)
    }
    return n * 2
}

func doubled(anon n: int64) -> alias_func_dep.R {
    let v = try checked(n)
    return v + 1
}

test "a local function named like the alias leaves the module reachable" {
    assert alias_func_dep() == 5
    assert alias_func_dep.value() == 1
    let p: alias_func_dep.Pt = alias_func_dep.make(7)
    assert p.x == 7
    assert alias_func_dep.rank(high()) == 2
    let f = alias_func_dep
    assert f() == 5
}

test "defaults and field defaults call through the alias" {
    assert bumped() + Holder().a == 3
}

test "results and errors typed through the alias" {
    match checked(4) {
        .Ok(v) -> assert v == 8
        .Err(e) -> fail(f"err {e}")
    }
    match doubled(-3) {
        .Ok(v) -> fail(f"got {v}")
        .Err(e) -> assert f"{e}" == "oops -3"
    }
}
