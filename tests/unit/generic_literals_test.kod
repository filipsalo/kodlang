// Function literals in generic functions and in methods of generic types:
// compiled per instance, so they can name `T` and capture.
import "tasks"
import "./../generic_literals_dep"

func pair_of[T](anon x: T) -> [T] {
    let f = func(anon y: T) -> [T] {
        return [y, y]
    }
    return f(x)
}

func repeater[T](anon x: T) -> func(int64) -> [T] {
    return func(anon n: int64) -> [T] {
        return [x] * n
    }
}

func nested[T](anon x: T) -> func() -> func() -> T {
    return func() -> func() -> T {
        return func() -> T {
            return x
        }
    }
}

func counter[T](anon step: T) -> func() -> [T] {
    mut seen: [T] = []
    return func() -> [T] {
        seen += [step]
        return seen
    }
}

type Box[T] = shared struct {
    v: T

    func getter(self) -> func() -> T {
        return func() -> T {
            return self.v
        }
    }

    func mapped(self, anon f: func(T) -> T) -> func() -> T {
        return func() -> T {
            return f(self.v)
        }
    }
}

type Maybe[T] = enum {
    Just(value: T)
    Nothing

    func or_else(self, anon fallback: T) -> func() -> T {
        return func() -> T {
            match self {
                .Just(v) -> return v
                .Nothing -> return fallback
            }
        }
    }
}

test "a literal in a generic function can name T" {
    assert pair_of(3) == [3, 3]
    assert pair_of("a") == ["a", "a"]
}

test "a literal in a generic function captures, per instance" {
    assert repeater(7)(3) == [7, 7, 7]
    assert repeater("ab")(2) == ["ab", "ab"]
    assert nested(1.5)()() == 1.5
    assert nested("x")()() == "x"
}

test "a literal in a generic function shares a captured mut" {
    let next = counter(2)
    let _ = next()
    assert next() == [2, 2]
    let words = counter("w")
    assert words() == ["w"]
}

test "a literal in a generic type's method captures self" {
    let b = Box[int64](v: 4)
    let get = b.getter()
    b.v = 5
    assert get() == 5
    assert Box[str](v: "s").getter()() == "s"
    assert Box[int64](v: 3).mapped(func(anon n: int64) -> int64 { return n * 10 })() == 30
}

test "a literal in a generic enum's method captures self" {
    let one: Maybe[int64] = .Just(value: 1)
    let get = one.or_else(9)
    assert get() == 1
    let nothing: Maybe[str] = .Nothing
    let fallback = nothing.or_else("none")
    assert fallback() == "none"
}

test "a literal in another module's generic function" {
    assert generic_literals_dep.labeller(3)("n") == "dep:n:3"
    assert generic_literals_dep.labeller("s")("t") == "dep:t:s"
}

func doubled_by_literal[T](anon xs: [T]) -> [T] {
    return generic_literals_dep.apply_to(xs, func(anon ys: [T]) -> [T] {
        return ys + ys
    })
}

test "an instance two modules make, and a literal passed to a generic function" {
    assert generic_literals_dep.labelled_here() == "dep:here:3"
    assert generic_literals_dep.labeller(3)("there") == "dep:there:3"
    assert doubled_by_literal([1]) == [1, 1]
    assert doubled_by_literal(["a"]) == ["a", "a"]
}

func twice[T](anon x: T) -> [T] {
    return [x, x]
}

func spawn_twice[T](anon x: T) -> [T] {
    let t = spawn twice(x)
    return t.wait()
}

func spawn_all[T](anon xs: [T]) -> [[T]] {
    mut ts: [tasks.Task[[T]]] = []
    for x in xs {
        ts += [spawn twice(x)]
    }
    mut out: [[T]] = []
    for t in ts {
        out += [t.wait()]
    }
    return out
}

test "spawn in a generic function" {
    assert spawn_twice(4) == [4, 4]
    assert spawn_twice("k") == ["k", "k"]
    assert spawn_all([1, 2]) == [[1, 1], [2, 2]]
}

func each_twice[T](anon xs: [T]) -> tasks.Channel[T] {
    for x in xs {
        yield x
        yield x
    }
}

type Stack[T] = shared struct {
    items: [T]

    func popped(self) -> tasks.Channel[T] {
        for i in 0..len(self.items) {
            yield self.items[len(self.items) - 1 - i]
        }
    }
}

test "yield in a generic function and a generic type's method" {
    mut got: [str] = []
    for s in each_twice(["a", "b"]) {
        got += [s]
    }
    assert got == ["a", "a", "b", "b"]
    mut nums: [int64] = []
    for n in each_twice([5]) {
        nums += [n]
    }
    assert nums == [5, 5]
    mut back: [int64] = []
    for n in Stack[int64](items: [1, 2, 3]).popped() {
        back += [n]
    }
    assert back == [3, 2, 1]
}
