// Type arguments naming the enclosing generic's parameters (compiled only).

type Pair[A, B] = shared struct {
    first: A
    second: B
}

type Duo[A, B] = shared struct {
    a: A
    b: B

    func flipped(self) -> Pair[B, A] {
        return Pair[B, A](first: self.b, second: self.a)
    }

    func listed(self) -> Pair[[A], B] {
        return Pair[[A], B](first: [self.a, self.a], second: self.b)
    }
}

test "type arguments naming the enclosing generic's parameters" {
    let d = Duo[str, int64](a: "a", b: 1)
    let q = d.flipped()
    assert q.first == 1
    assert q.second == "a"
    let r = d.listed()
    assert r.first[1] == "a"
    assert len(r.first) == 2
    assert r.second == 1
}
