// Functions declared in a function's body: `func name(...)` that can call itself.
extern func rc_live_bytes() -> int64

type Tree = shared struct {
    val: int64
    kids: [Tree] = []

    func total(self) -> int64 {
        func walk(anon t: Tree) -> int64 {
            mut n = t.val
            for k in t.kids {
                n += walk(k)
            }
            return n
        }
        return walk(self)
    }
}

func fact_of(anon n: int64) -> int64 {
    func fact(anon k: int64) -> int64 {
        if k <= 1 {
            return 1
        }
        return k * fact(k - 1)
    }
    return fact(n)
}

func count_ways(coins: [int64], total: int64) -> int64 {
    func ways(anon left: int64, from: int64) -> int64 {
        if left == 0 {
            return 1
        }
        mut n = 0
        for i in from..len(coins) {
            if coins[i] <= left {
                n += ways(left - coins[i], from: i)
            }
        }
        return n
    }
    return ways(total, from: 0)
}

func down_to(floor: int64) -> func(int64) -> int64 {
    func down(anon n: int64) -> int64 {
        if n <= floor {
            return n
        }
        return down(n - 1)
    }
    return down
}

func find_first[T](anon xs: [T], pred: func(T) -> bool) -> int64 {
    func go(anon i: int64) -> int64 {
        if i >= len(xs) {
            return -1
        }
        if pred(xs[i]) {
            return i
        }
        return go(i + 1)
    }
    return go(0)
}

func with_helpers(n: int64) -> int64 {
    mut calls = 0
    let base = 10
    func step(anon x: int64, by: int64) -> int64 {
        return x * by + base
    }
    func rec(anon k: int64) -> int64 {
        calls += 1
        if k == 0 {
            return 0
        }
        return step(rec(k - 1), by: 2)
    }
    let r = rec(n)
    return r * 100 + calls
}

func twice(anon f: func(int64) -> int64, anon x: int64) -> int64 {
    return f(f(x))
}

func double(anon x: int64) -> int64 {
    return x * 2
}

test "a local function calls itself" {
    assert fact_of(10) == 3628800
    func fib(anon n: int64) -> int64 {
        if n < 2 {
            return n
        }
        return fib(n - 1) + fib(n - 2)
    }
    assert fib(20) == 6765
}

test "a local function reads the locals around it and takes labels" {
    assert count_ways(coins: [1, 2, 5], total: 5) == 4
    assert count_ways(coins: [2], total: 3) == 0
}

test "a local function shares a `mut` and calls one declared before it" {
    // rec(0) = 0, then x * 2 + 10 three times: 10, 30, 70; rec runs 4 times.
    assert with_helpers(n: 3) == 7004
}

test "a local function is a value that outlives its function" {
    let f = down_to(floor: 3)
    assert f(100) == 3
    assert f(2) == 2
    func inc(anon x: int64) -> int64 {
        return x + 1
    }
    assert twice(inc, 5) == 7
}

test "in a method, a generic function and a loop" {
    let t = Tree(val: 1, kids: [Tree(val: 2), Tree(val: 3, kids: [Tree(val: 4)])])
    assert t.total() == 10
    assert find_first([1, 5, 9], pred: func(anon x: int64) -> bool { return x > 4 }) == 1
    assert find_first(["a", "b"], pred: func(anon x: str) -> bool { return x == "b" }) == 1
    mut sums: [int64] = []
    for limit in [3, 4] {
        func sum(anon n: int64) -> int64 {
            if n > limit {
                return 0
            }
            return n + sum(n + 1)
        }
        sums += [sum(1)]
    }
    assert sums == [6, 10]
}

test "a local function hides a module function of its name" {
    func double(anon x: int64) -> int64 {
        if x > 100 {
            return x
        }
        return double(x * 3)
    }
    assert double(2) == 162
}

test "local functions inside local functions" {
    func outer(anon n: int64) -> int64 {
        func inner(anon k: int64) -> int64 {
            if k == 0 {
                return 0
            }
            return n + inner(k - 1)
        }
        if n == 0 {
            return 0
        }
        return inner(n) + outer(n - 1)
    }
    // 1 + 4 + 9
    assert outer(3) == 14
}

test "recursing deeply keeps no closure per call" {
    func depth(anon n: int64) -> int64 {
        if n == 0 {
            return 0
        }
        return 1 + depth(n - 1)
    }
    assert depth(100000) == 100000
    let start = rc_live_bytes()
    for i in 0..200 {
        assert with_helpers(n: 3) == 7004
        assert down_to(floor: i)(i + 5) == i
    }
    assert rc_live_bytes() - start <= 0
}
