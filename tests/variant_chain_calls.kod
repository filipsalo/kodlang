// A `+` chain's `.Variant`s take its type from a constructor's method or
// field, a generic one's, `must`, `try` or `x? or`, as the first typed operand.
import "./variant_chain_calls_dep"

type Ring = enum {
    Circle(r: int64)
    Square(side: int64)
    Dot
}

type Box[T] = struct {
    v: T

    func get(self) -> T {
        return self.v
    }
}

func tried() -> [variant_chain_calls_dep.Figure] or Error {
    let xs = [.Dot] + try variant_chain_calls_dep.fallible()
    return xs
}

func main() -> int64 {
    let fs = variant_chain_calls_dep.list()
    let a = [.Circle(r: 1), .Dot] + variant_chain_calls_dep.Holder(:fs).all()
    let b = [.Dot] + variant_chain_calls_dep.Holder(:fs).fs
    let c = [.Dot] + Box[[variant_chain_calls_dep.Figure]](v: fs).get()
    let o = variant_chain_calls_dep.maybe(false)
    let d = [.Dot] + (o? or variant_chain_calls_dep.list())
    let e = [.Dot] + must variant_chain_calls_dep.fallible()
    for xs in [a, b, c, d, e, must tried()] {
        print_int(variant_chain_calls_dep.total(xs))
    }
    let ring: Ring = .Dot
    print_int(match ring { .Dot -> 1 else 0 })
    return 0
}

// expected output:
// 30101
// 30001
// 30001
// 30001
// 30003
// 30003
// 1
