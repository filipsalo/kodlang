// Checking ECDSA signatures (FIPS 186-5) on P-256 and P-384. See
// docs/crypto.md.
//
// Points are in Jacobian coordinates (x / z^2, y / z^3), with every
// coordinate in Montgomery form; z = 0 is the point at infinity. This works
// on public values only (a key, a message and a signature), so it branches
// on them freely.
import "crypto/bignum" { Modulus }
import "crypto/bignum"
import "crypto/hmac"
import "crypto/sha2" { Algo }
import "crypto/sha2"
import "encoding/hex"
import "stream" { IoError }

type Curve = enum {
    P256
    P384

    // The length in bytes of a coordinate, and of a scalar.
    func size(self) -> int64 {
        return match self {
            .P256 -> 32
            .P384 -> 48
        }
    }
}

// A curve's numbers: y^2 = x^3 - 3x + b over the integers mod p, and the
// order n of its generator g.
type CurveData = struct {
    p: Modulus
    n: Modulus
    b: [int64]
    g: Point
    size: int64
}

type Point = struct {
    x: [int64]
    y: [int64]
    z: [int64]
}

func curve_data(anon size: int64, p: str, n: str, b: str, gx: str, gy: str) -> CurveData {
    let pm = Modulus(must hex.decode(p))
    let field = func(anon text: str) -> [int64] {
        return pm.to_mont(must pm.number(must hex.decode(text)))
    }
    return CurveData(p: pm, n: Modulus(must hex.decode(n)), b: field(b), g: Point(x: field(gx), y: field(gy), z: pm.one()), size: size)
}

mut P256_DATA: CurveData = curve_data(32, p: "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff", n: "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551", b: "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b", gx: "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296", gy: "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5")
mut P384_DATA: CurveData = curve_data(48, p: "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff", n: "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973", b: "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef", gx: "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7", gy: "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f")

func data(anon curve: Curve) -> CurveData {
    return match curve {
        .P256 -> P256_DATA
        .P384 -> P384_DATA
    }
}

func double(anon c: CurveData, anon q: Point) -> Point {
    let f = c.p
    if bignum.is_zero(q.z) {
        return q
    }
    let delta = f.mul(q.z, q.z)
    let gamma = f.mul(q.y, q.y)
    let beta = f.mul(q.x, gamma)
    let t = f.mul(f.sub(q.x, delta), f.add(q.x, delta))
    let alpha = f.add(f.add(t, t), t)
    let beta2 = f.add(beta, beta)
    let beta4 = f.add(beta2, beta2)
    let beta8 = f.add(beta4, beta4)
    let x3 = f.sub(f.mul(alpha, alpha), beta8)
    let yz = f.add(q.y, q.z)
    let z3 = f.sub(f.sub(f.mul(yz, yz), gamma), delta)
    let g2 = f.mul(gamma, gamma)
    let g4 = f.add(g2, g2)
    let g8 = f.add(f.add(g4, g4), f.add(g4, g4))
    let y3 = f.sub(f.mul(alpha, f.sub(beta4, x3)), g8)
    return Point(x: x3, y: y3, z: z3)
}

func add(anon c: CurveData, anon a: Point, anon b: Point) -> Point {
    let f = c.p
    if bignum.is_zero(a.z) {
        return b
    }
    if bignum.is_zero(b.z) {
        return a
    }
    let z1z1 = f.mul(a.z, a.z)
    let z2z2 = f.mul(b.z, b.z)
    let u1 = f.mul(a.x, z2z2)
    let u2 = f.mul(b.x, z1z1)
    let s1 = f.mul(f.mul(a.y, b.z), z2z2)
    let s2 = f.mul(f.mul(b.y, a.z), z1z1)
    let h = f.sub(u2, u1)
    let d = f.sub(s2, s1)
    if bignum.is_zero(h) {
        if bignum.is_zero(d) {
            return double(c, a)
        }
        return Point(x: f.one(), y: f.one(), z: [0] * f.k)
    }
    let r = f.add(d, d)
    let h2 = f.add(h, h)
    let i = f.mul(h2, h2)
    let j = f.mul(h, i)
    let v = f.mul(u1, i)
    let x3 = f.sub(f.sub(f.mul(r, r), j), f.add(v, v))
    let s1j = f.mul(s1, j)
    let y3 = f.sub(f.mul(r, f.sub(v, x3)), f.add(s1j, s1j))
    let zz = f.add(a.z, b.z)
    let z3 = f.mul(f.sub(f.sub(f.mul(zz, zz), z1z1), z2z2), h)
    return Point(x: x3, y: y3, z: z3)
}

type PublicKey = struct {
    curve: Curve
    _q: Point

    // The key whose point is `point`, uncompressed (0x04, then x and y).
    func init(anon curve: Curve, point: bytes) -> PublicKey or Error {
        let c = data(curve)
        let f = c.p
        let size = c.size
        if len(point) != 1 + 2 * size or point[0] != 4 {
            throw IoError(kind: .InvalidInput, op: "ecdsa key", errno: 0, detail: "not an uncompressed point")
        }
        let Some(x) = f.number(point[1..1 + size]) else { throw IoError(kind: .InvalidInput, op: "ecdsa key", errno: 0, detail: "x is out of range") }
        let Some(y) = f.number(point[1 + size..]) else { throw IoError(kind: .InvalidInput, op: "ecdsa key", errno: 0, detail: "y is out of range") }
        let xm = f.to_mont(x)
        let ym = f.to_mont(y)
        // y^2 = x^3 - 3x + b
        let x3 = f.mul(f.mul(xm, xm), xm)
        let rhs = f.add(f.sub(x3, f.add(f.add(xm, xm), xm)), c.b)
        if f.mul(ym, ym) != rhs {
            throw IoError(kind: .InvalidInput, op: "ecdsa key", errno: 0, detail: "the point is not on the curve")
        }
        return PublicKey(curve: curve, _q: Point(x: xm, y: ym, z: f.one()))
    }

    // The point, uncompressed: 0x04, then x and y.
    func point(self) -> bytes {
        let c = data(self.curve)
        return b"\x04" + bignum.to_bytes(c.p.from_mont(self._q.x), size: c.size) + bignum.to_bytes(c.p.from_mont(self._q.y), size: c.size)
    }

    // Whether `r` and `s`, big-endian, are this key's signature of `message`
    // hashed with `algo`.
    func verify_rs(self, algo: Algo, message: bytes, r: bytes, s: bytes) -> bool {
        let c = data(self.curve)
        let n = c.n
        let Some(rn) = n.number(r) else { return false }
        let Some(sn) = n.number(s) else { return false }
        if bignum.is_zero(rn) or bignum.is_zero(sn) {
            return false
        }
        // The digest's leftmost bits, as many as n has; below 2n, so one
        // subtraction brings it below n.
        let digest = sha2.digest(algo, message)
        let e_bytes = if len(digest) > c.size { digest[..c.size] } else { digest }
        mut e = must bignum.from_bytes(e_bytes, k: n.k)
        if bignum.compare(e, n.m) >= 0 {
            e = bignum.sub(e, n.m)
        }
        let w = n.inverse(n.to_mont(sn))
        let u1 = n.from_mont(n.mul(n.to_mont(e), w))
        let u2 = n.from_mont(n.mul(n.to_mont(rn), w))
        // u1 g + u2 q, both at once.
        let both = add(c, c.g, self._q)
        mut acc = Point(x: c.p.one(), y: c.p.one(), z: [0] * c.p.k)
        let top = max(bignum.bit_length(u1), bignum.bit_length(u2))
        for i in top - 1..=0 step -1 {
            acc = double(c, acc)
            let b1 = bignum.bit(u1, i)
            let b2 = bignum.bit(u2, i)
            if b1 == 1 and b2 == 1 {
                acc = add(c, acc, both)
            } else if b1 == 1 {
                acc = add(c, acc, c.g)
            } else if b2 == 1 {
                acc = add(c, acc, self._q)
            }
        }
        if bignum.is_zero(acc.z) {
            return false
        }
        let f = c.p
        let zinv = f.inverse(acc.z)
        let x = f.from_mont(f.mul(acc.x, f.mul(zinv, zinv)))
        // x mod n: x is below p, which is below 2n.
        mut v = x
        if bignum.compare(v, n.m) >= 0 {
            v = bignum.sub(v, n.m)
        }
        return v == rn
    }

    // Whether `signature`, DER (a SEQUENCE of the INTEGERs r and s), is this
    // key's signature of `message` hashed with `algo`.
    func verify(self, algo: Algo, message: bytes, signature: bytes) -> bool {
        let Some((r, s)) = parse_signature(signature) else { return false }
        return self.verify_rs(algo: algo, message: message, r: r, s: s)
    }
}

// r and s from a DER signature, or none when it isn't strict DER.
func parse_signature(anon der: bytes) -> (bytes, bytes)? {
    if len(der) < 8 or der[0] != 0x30 or der[1] != len(der) - 2 or der[1] >= 0x80 {
        return none
    }
    let Some((r, after_r)) = der_integer(der, 2) else { return none }
    let Some((s, after_s)) = der_integer(der, after_r) else { return none }
    if after_s != len(der) {
        return none
    }
    return (r, s)
}

// A positive DER INTEGER at `at`, without its sign byte, and where it ends.
func der_integer(anon der: bytes, anon at: int64) -> (bytes, int64)? {
    if at + 2 > len(der) or der[at] != 2 {
        return none
    }
    let size = der[at + 1]
    let start = at + 2
    if size == 0 or size >= 0x80 or start + size > len(der) {
        return none
    }
    // Negative, or a 0 byte that isn't needed for the sign.
    if der[start] >= 0x80 {
        return none
    }
    if der[start] == 0 and size > 1 and der[start + 1] < 0x80 {
        return none
    }
    mut from = start
    if der[start] == 0 and size > 1 {
        from += 1
    }
    return (der[from..start + size], start + size)
}

// ---- signing ----
//
// Everything below works on the private key or the nonce, so it does the same
// steps whatever they are: bignum's Modulus arithmetic, the complete
// addition formulas of Renes, Costello and Batina (2016, algorithm 4, for a =
// -3) in homogeneous coordinates (x / z, y / z), which have no special cases,
// and a multiplication by the nonce that adds one precomputed multiple of the
// generator per 4 bits, picked by masks from all 16.

// p + q, for any two points (equal ones, or the point at infinity (0, 1, 0)).
func complete_add(anon c: CurveData, anon p1: Point, anon p2: Point) -> Point {
    let f = c.p
    let b = c.b
    mut t0 = f.mul(p1.x, p2.x)
    mut t1 = f.mul(p1.y, p2.y)
    mut t2 = f.mul(p1.z, p2.z)
    mut t3 = f.add(p1.x, p1.y)
    mut t4 = f.add(p2.x, p2.y)
    t3 = f.mul(t3, t4)
    t4 = f.add(t0, t1)
    t3 = f.sub(t3, t4)
    t4 = f.add(p1.y, p1.z)
    mut x3 = f.add(p2.y, p2.z)
    t4 = f.mul(t4, x3)
    x3 = f.add(t1, t2)
    t4 = f.sub(t4, x3)
    x3 = f.add(p1.x, p1.z)
    mut y3 = f.add(p2.x, p2.z)
    x3 = f.mul(x3, y3)
    y3 = f.add(t0, t2)
    y3 = f.sub(x3, y3)
    mut z3 = f.mul(b, t2)
    x3 = f.sub(y3, z3)
    z3 = f.add(x3, x3)
    x3 = f.add(x3, z3)
    z3 = f.sub(t1, x3)
    x3 = f.add(t1, x3)
    y3 = f.mul(b, y3)
    t1 = f.add(t2, t2)
    t2 = f.add(t1, t2)
    y3 = f.sub(y3, t2)
    y3 = f.sub(y3, t0)
    t1 = f.add(y3, y3)
    y3 = f.add(t1, y3)
    t1 = f.add(t0, t0)
    t0 = f.add(t1, t0)
    t0 = f.sub(t0, t2)
    t1 = f.mul(t4, y3)
    t2 = f.mul(t0, y3)
    y3 = f.mul(x3, z3)
    y3 = f.add(y3, t2)
    x3 = f.mul(x3, t3)
    x3 = f.sub(x3, t1)
    z3 = f.mul(t4, z3)
    t1 = f.mul(t3, t0)
    z3 = f.add(z3, t1)
    return Point(x: x3, y: y3, z: z3)
}

// j 16^i g for each 4-bit digit position i and j from 0 to 15, made once
// for a curve the program signs with.
func base_table(anon c: CurveData) -> [[Point]] {
    let f = c.p
    let zero = [0] * f.k
    let infinity = Point(x: zero, y: f.one(), z: zero)
    mut table: [[Point]] = []
    mut base = c.g
    for _i in 0..c.size * 2 {
        mut row = [infinity]
        mut p = infinity
        for _j in 1..16 {
            p = complete_add(c, p, base)
            row += [p]
        }
        table += [row]
        // The next row's base is 16 times this one's.
        base = complete_add(c, p, base)
    }
    return table
}

mut P256_TABLE: [[Point]] = base_table(P256_DATA)
mut P384_TABLE: [[Point]] = base_table(P384_DATA)

// k times the generator, k an ordinary number below n, as affine (x, y),
// both ordinary numbers: one addition per 4 bits of k, of the table's entry
// for the digit, which every entry is looked at to pick.
func base_mult(anon c: CurveData, anon k: [int64]) -> ([int64], [int64]) {
    let f = c.p
    let table = if c.size == 32 { P256_TABLE } else { P384_TABLE }
    let zero = [0] * f.k
    mut r = Point(x: zero, y: f.one(), z: zero)
    for i in 0..c.size * 2 {
        let digit = (bignum.bit(k, 4 * i)) | (bignum.bit(k, 4 * i + 1) << 1) | (bignum.bit(k, 4 * i + 2) << 2) | (bignum.bit(k, 4 * i + 3) << 3)
        mut x = zero
        mut y = zero
        mut z = zero
        for j, entry in table[i] {
            // 1 when digit == j: (digit ^ j) - 1 is negative only for 0.
            let same = ((digit ^ j) - 1) >> 63
            x = bignum.choose(same, entry.x, x)
            y = bignum.choose(same, entry.y, y)
            z = bignum.choose(same, entry.z, z)
        }
        r = complete_add(c, r, Point(x: x, y: y, z: z))
    }
    let zinv = f.inverse(r.z)
    return (f.from_mont(f.mul(r.x, zinv)), f.from_mont(f.mul(r.y, zinv)))
}

// The leftmost bits of `digest`, as many as n has, as a number below n.
func digest_number(anon c: CurveData, anon digest: bytes) -> [int64] {
    let e_bytes = if len(digest) > c.size { digest[..c.size] } else { digest }
    let e = must bignum.from_bytes(e_bytes, k: c.n.k)
    let (less, borrow) = bignum.sub_borrow(e, c.n.m)
    return bignum.choose(borrow, e, less)
}

// A DER INTEGER of the big-endian `b`, which is positive.
func der_int(anon b: bytes) -> bytes {
    mut at = 0
    for at < len(b) - 1 and b[at] == 0 {
        at += 1
    }
    mut body = b[at..]
    if body[0] >= 0x80 {
        body = b"\x00" + body
    }
    return kod_bytes_from_array([2, len(body)]) + body
}

type PrivateKey = struct {
    curve: Curve
    _d: [int64]
    _d_bytes: bytes

    // The key whose scalar is `scalar`, big-endian and the curve's size,
    // above 0 and below n.
    func init(anon curve: Curve, scalar: bytes) -> PrivateKey or Error {
        let c = data(curve)
        if len(scalar) != c.size {
            throw IoError(kind: .InvalidInput, op: "ecdsa key", errno: 0, detail: f"the scalar is {len(scalar)} bytes, not {c.size}")
        }
        let Some(d) = c.n.number(scalar) else { throw IoError(kind: .InvalidInput, op: "ecdsa key", errno: 0, detail: "the scalar is n or more") }
        if bignum.is_zero(d) {
            throw IoError(kind: .InvalidInput, op: "ecdsa key", errno: 0, detail: "the scalar is 0")
        }
        return PrivateKey(curve: curve, _d: d, _d_bytes: scalar)
    }

    func public_key(self) -> PublicKey {
        let c = data(self.curve)
        let (x, y) = base_mult(c, self._d)
        let point = b"\x04" + bignum.to_bytes(x, size: c.size) + bignum.to_bytes(y, size: c.size)
        return must PublicKey(self.curve, point: point)
    }

    // The signature of `message` hashed with `algo`, DER, with the nonce of
    // RFC 6979 (so the same message always gets the same signature, and a
    // bad random generator can't give the key away).
    func sign(self, algo: Algo, message: bytes) -> bytes {
        let (r, s) = self.sign_rs(algo: algo, message: message)
        let seq = der_int(r) + der_int(s)
        return kod_bytes_from_array([0x30, len(seq)]) + seq
    }

    // r and s, each the curve's size, big-endian.
    func sign_rs(self, algo: Algo, message: bytes) -> (bytes, bytes) {
        let c = data(self.curve)
        let n = c.n
        let digest = sha2.digest(algo, message)
        let e = digest_number(c, digest)
        let e_bytes = bignum.to_bytes(e, size: c.size)
        // HMAC_DRBG seeded with the key and the digest (RFC 6979 3.2).
        let hlen = algo.size()
        mut v = kod_bytes_from_array([1] * hlen)
        mut key = kod_bytes_from_array([0] * hlen)
        key = hmac.mac(algo, key: key, data: v + b"\x00" + self._d_bytes + e_bytes)
        v = hmac.mac(algo, key: key, data: v)
        key = hmac.mac(algo, key: key, data: v + b"\x01" + self._d_bytes + e_bytes)
        v = hmac.mac(algo, key: key, data: v)
        let dm = n.to_mont(self._d)
        let em = n.to_mont(e)
        for true {
            mut t = b""
            for len(t) < c.size {
                v = hmac.mac(algo, key: key, data: v)
                t = t + v
            }
            let candidate = must bignum.from_bytes(t[..c.size], k: n.k)
            if not bignum.is_zero(candidate) and bignum.compare(candidate, n.m) < 0 {
                let (x, _y) = base_mult(c, candidate)
                let (less, borrow) = bignum.sub_borrow(x, n.m)
                let r = bignum.choose(borrow, x, less)
                if not bignum.is_zero(r) {
                    // s = (e + r d) / k mod n
                    let km = n.to_mont(candidate)
                    let sm = n.mul(n.inverse(km), n.add(em, n.mul(n.to_mont(r), dm)))
                    let s = n.from_mont(sm)
                    if not bignum.is_zero(s) {
                        return (bignum.to_bytes(r, size: c.size), bignum.to_bytes(s, size: c.size))
                    }
                }
            }
            key = hmac.mac(algo, key: key, data: v + b"\x00")
            v = hmac.mac(algo, key: key, data: v)
        }
        return (b"", b"")
    }
}
