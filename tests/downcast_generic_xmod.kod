// `is` on a generic instance holds wherever the value was boxed: in the
// module that declares the instance's alias or in one that names the same
// instance through an alias of its own.
import "./downcast_generic_xmod_dep"

type MyBox = downcast_generic_xmod_dep.Box[int64]
type StrBox = downcast_generic_xmod_dep.Box[str]

func main() -> int64 {
    let theirs = downcast_generic_xmod_dep.boxed()
    print(f"{theirs is _: downcast_generic_xmod_dep.IntBox} {theirs is _: MyBox} {theirs is _: StrBox}")
    if theirs is b: MyBox {
        print_int(b.v)
    }
    match theirs {
        b: downcast_generic_xmod_dep.IntBox -> print_int(b.v + 1)
        else -> print("not an IntBox")
    }
    let mine: downcast_generic_xmod_dep.Shape = MyBox(v: 5)
    let other: downcast_generic_xmod_dep.Shape = StrBox(v: "s")
    print(f"{downcast_generic_xmod_dep.holds_int_box(mine)} {downcast_generic_xmod_dep.holds_int_box(other)}")
    print_int(downcast_generic_xmod_dep.unbox(mine))
    print_int(downcast_generic_xmod_dep.unbox(other))
    return 0
}

// expected output:
// true true false
// 3
// 4
// true false
// 5
// -1
