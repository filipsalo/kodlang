// The compiler rejects labelled arguments out of parameter order, instead
// of binding them by position.
func move(x: int64, y: int64) -> int64 {
    return x * 10 + y
}

func main() -> int64 {
    print_int(move(x: 1, y: 2))
    print_int(move(y: 2, x: 1))
    return 0
}

// expected stderr:
// 9:20: error: parameter 0 of `move` expected label `x`, got `y`
// expected status:
// 1
