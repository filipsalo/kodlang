// Reads of a constant that can't change it share one copy; any other use is a copy of its own.
import "./../constant_sharing_dep"
import "./../constant_sharing_dep" { TITLE }

type Mode = enum {
    Fast
    Safe
}

let SQUARES: [int64] = [0, 1, 4, 9, 16]
let WORDS: [str] = ["zero", "one", "two"]
let FLAGS: [bool] = [true, false]
let HALVES: [float64] = [0.5, 1.5]
let MODES: [Mode] = [Mode.Fast, Mode.Safe]
let GRID: [[int64]] = [[1, 2], [3, 4]]
let GREETING: str = "hello" + ", " + "world"

func sum_squares() -> int64 {
    mut total: int64 = 0
    for i in 0..len(SQUARES) {
        total += SQUARES[i]
    }
    for s in SQUARES {
        total += s
    }
    return total
}

// A string constant handed out, as a function's result and kept in an array.
func greeting() -> str {
    return GREETING
}

test "reads share the constant" {
    mut kept: [str] = []
    for _ in 0..1000 {
        kept += [greeting()]
        kept += [TITLE]
    }
    mut total: int64 = 0
    for k in 0..1000 {
        total += SQUARES[k % 5] + constant_sharing_dep.CODES[k % 3]
    }
    assert kept[0] == "hello, world"
    assert kept[1999] == "the title"
    assert len(kept) == 2000
    assert total == 25990
    assert sum_squares() == 60
    assert sum_squares() == 60
    assert WORDS[2] + " " + str(len(WORDS)) == "two 3"
    mut seen: [str] = []
    for w in WORDS {
        seen += [w]
    }
    assert seen == ["zero", "one", "two"]
    assert str(FLAGS[1]) == "false"
    assert f"{HALVES[0] + HALVES[1]}" == "2.0"
    assert str(MODES[1] is .Safe) == "true"
    assert GREETING == "hello, world"
    assert TITLE + " " + str(len(constant_sharing_dep.TITLE)) == "the title 9"
    assert constant_sharing_dep.CODES[1] + len(constant_sharing_dep.CODES) == 23
}

test "a copy is its own" {
    // Changing it leaves the constant, and the shared copy, alone.
    mut mine = SQUARES
    mine[0] = 100
    assert mine[0] == 100
    assert SQUARES[0] == 0
    // So is an element array of an array constant.
    mut row = GRID[0]
    row[0] = 50
    assert GRID[0][0] == 1
    mut codes = constant_sharing_dep.CODES
    codes += [40]
    assert len(codes) == 4
    assert len(constant_sharing_dep.CODES) == 3
}
