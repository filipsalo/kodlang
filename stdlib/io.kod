// Files, standard input and standard output, over the C library through unsafe.

import "libc"
import "unsafe"

// What a file's mode says it is (S_IFMT), and a regular file (S_IFREG).
let MODE_TYPE: int64 = 61440
let MODE_REGULAR: int64 = 32768
// Where st_mode sits in a macOS struct stat, and the struct's size.
let STAT_MODE: int64 = 4
let STAT_SIZE: int64 = 144
// A directory's mode (S_IFDIR).
let MODE_DIRECTORY: int64 = 16384
// Where st_mtimespec and st_size sit in it.
let STAT_MODIFIED: int64 = 48
let STAT_LENGTH: int64 = 96
let POLLIN: int64 = 1

// C's stdin, stdout and stderr: FILE pointers, shared with `print`.
extern let __stdinp: int64
extern let __stdoutp: int64
extern let __stderrp: int64

// Read the file at `path` and return its contents. Pipes and FIFOs
// (e.g. "/dev/stdin") are read until EOF. Returns the empty string if
// the file can't be opened or read.
func read_file(anon path: str) -> str {
    let file = libc.fopen(unsafe.c_str(path), unsafe.c_str("rb"))
    if file == 0 {
        return ""
    }
    // Read until EOF into a buffer that doubles: fseek/ftell can't size a pipe.
    mut cap = 65536
    mut used = 0
    mut buf = unsafe.alloc(cap)
    for true {
        used += libc.fread(buf + used, 1, cap - used, file)
        if used < cap {
            break
        }
        cap = cap * 2
        let grown = libc.realloc(buf, cap)
        if grown == 0 {
            unsafe.free(buf)
            libc.fclose(file)
            return ""
        }
        buf = grown
    }
    let failed = unsafe.c_int(libc.ferror(file)) != 0
    libc.fclose(file)
    mut out = ""
    if not failed {
        out = str(unsafe.copy_out(buf, used))
    }
    unsafe.free(buf)
    return out
}

// True if `path` names an existing regular file.
func is_file(anon path: str) -> bool {
    let st = unsafe.alloc(STAT_SIZE)
    let found = unsafe.c_int(libc.stat(unsafe.c_str(path), st)) == 0
    let regular = found and (unsafe.load32(st + STAT_MODE) & MODE_TYPE) == MODE_REGULAR
    unsafe.free(st)
    return regular
}

// What is at a path: a regular file, a directory or (neither) something else, how
// long it is, and when it last changed, in nanoseconds since 1970.
type FileInfo = struct {
    is_file: bool
    is_dir: bool
    size: int64
    modified_ns: int64
}

func file_info(anon path: str) -> FileInfo? {
    let st = unsafe.alloc(STAT_SIZE)
    mut info: FileInfo? = none
    if unsafe.c_int(libc.stat(unsafe.c_str(path), st)) == 0 {
        let kind = unsafe.load32(st + STAT_MODE) & MODE_TYPE
        info = FileInfo(is_file: kind == MODE_REGULAR, is_dir: kind == MODE_DIRECTORY, size: unsafe.load64(st + STAT_LENGTH), modified_ns: unsafe.load64(st + STAT_MODIFIED) * 1000000000 + unsafe.load64(st + STAT_MODIFIED + 8))
    }
    unsafe.free(st)
    return info
}

// How long the regular file at `path` is; none when there is no such file.
func file_size(anon path: str) -> int64? {
    let st = unsafe.alloc(STAT_SIZE)
    mut size: int64? = none
    if unsafe.c_int(libc.stat(unsafe.c_str(path), st)) == 0 and (unsafe.load32(st + STAT_MODE) & MODE_TYPE) == MODE_REGULAR {
        size = unsafe.load64(st + STAT_LENGTH)
    }
    unsafe.free(st)
    return size
}

// Write `content` to a file at `path`, replacing it if it exists.
// Returns 0 on success, -1 on failure. The parent directory must
// already exist (no mkdir -p; caller's responsibility).
func write_file(anon path: str, anon content: str) -> int64 {
    let file = libc.fopen(unsafe.c_str(path), unsafe.c_str("wb"))
    if file == 0 {
        return -1
    }
    let written = libc.fwrite(unsafe.c_str(content), 1, len(content), file)
    libc.fclose(file)
    if written == len(content) {
        return 0
    }
    return -1
}

// Reopen stdout against `path` for the rest of the process. Subsequent
// `print` / `puts` calls write there instead of the terminal. Used by
// sh_kodc to capture codegen output to a .s file. Returns 0 on success,
// -1 on failure.
func redirect_stdout(anon path: str) -> int64 {
    if libc.freopen(unsafe.c_str(path), unsafe.c_str("w"), __stdoutp) == 0 {
        return -1
    }
    return 0
}

// Flush stdout to disk. Pair with `redirect_stdout` before invoking a
// subprocess that reads the captured file.
func flush_stdout() -> none {
    libc.fflush(__stdoutp)
}

// Return 1 if stdin has data ready (or EOF) within `timeout_ms`, 0 on
// timeout, -1 on error. Lets LSP-style loops detect idle periods —
// e.g. wait briefly after a didChange before doing the expensive
// compile so a burst of keystrokes coalesces.
func stdin_data_ready(anon timeout_ms: int64) -> int64 {
    let p = unsafe.alloc(8)
    unsafe.store32(p, 0)
    unsafe.store32(p + 4, POLLIN)
    let n = unsafe.c_int(libc.poll(p, 1, timeout_ms))
    unsafe.free(p)
    if n < 0 {
        return -1
    }
    if n > 0 {
        return 1
    }
    return 0
}

// Read one '\n'-terminated line from stdin. The trailing newline (and
// CR, if any) is stripped. Returns an empty string on EOF with no
// buffered bytes. Intended for LSP-style framing: read Content-Length
// headers line-by-line, then call `read_stdin_exact` for the body.
func read_stdin_line() -> str {
    // getline's buffer and its size, which it allocates and grows.
    let slots = unsafe.alloc(16)
    let n = libc.getline(slots, slots + 8, __stdinp)
    let line = unsafe.load64(slots)
    mut out = ""
    if n > 0 {
        mut size = n
        if unsafe.load8(line + size - 1) == 10 {
            size -= 1
        }
        if size > 0 and unsafe.load8(line + size - 1) == 13 {
            size -= 1
        }
        out = str(unsafe.copy_out(line, size))
    }
    unsafe.free(line)
    unsafe.free(slots)
    return out
}

// Read exactly `n` bytes from stdin and return them as a string. On a
// short read (EOF before n bytes), returns the truncated content;
// callers detect that by checking `len(result) == n`.
func read_stdin_exact(anon n: int64) -> str {
    if n <= 0 {
        return ""
    }
    let buf = unsafe.alloc(n)
    mut got = 0
    for got < n {
        let r = libc.fread(buf + got, 1, n - got, __stdinp)
        if r == 0 {
            break
        }
        got += r
    }
    let out = str(unsafe.copy_out(buf, got))
    unsafe.free(buf)
    return out
}

// Write `s` to stdout verbatim — no trailing newline, no flush. Use
// where you control framing (e.g. LSP message bodies). Pair with
// `flush_stdout` when downstream is reading immediately.
func write_stdout(anon s: str) -> none {
    libc.fwrite(unsafe.c_str(s), 1, len(s), __stdoutp)
}

// Same as `write_stdout` but to stderr. Used by the kod-side build /
// run driver to forward a child process's captured stderr without
// adding a trailing newline.
func write_stderr(anon s: str) -> none {
    libc.fwrite(unsafe.c_str(s), 1, len(s), __stderrp)
}
