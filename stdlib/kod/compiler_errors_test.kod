func escape_errors(anon literal: str) -> [codegen.Diagnostic] {
    return test_support.try_compile("func main() -> int64 {\n    let s = " + literal + "\n    return 0\n}\n")
}

test "a malformed \\x or \\u escape is an error, a good one is not" {
    assert len(escape_errors("\"\\x41\\u{e9}\\u{10FFFF}\\u{0}\\xFf\"")) == 0
    assert len(escape_errors("b\"\\xff\\u{41}\"")) == 0
    assert len(escape_errors("f\"\\u{e9}{1}\\x41\"")) == 0
    let x = escape_errors("\"a\\xZ1b\"")
    assert len(x) == 1
    assert x[0].message == "error: invalid escape `\\x`: it needs two hex digits"
    assert len(escape_errors("\"\\x4\"")) == 1
    assert len(escape_errors("\"\\x\"")) == 1
    let u = escape_errors("\"\\u41\"")
    assert len(u) == 1
    assert u[0].message == "error: invalid escape `\\u`: write the character as `\\u{...}`, for instance `\\u{1F600}`"
    let empty = escape_errors("\"\\u{}\"")
    assert len(empty) == 1
    assert empty[0].message == "error: invalid escape `\\u{...}`: it needs 1 to 6 hex digits between the braces"
    assert len(escape_errors("\"\\u{12\"")) == 1
    assert len(escape_errors("\"\\u{g}\"")) == 1
    assert len(escape_errors("\"\\u{1234567}\"")) == 1
    let big = escape_errors("\"\\u{110000}\"")
    assert len(big) == 1
    assert big[0].message == "error: invalid escape `\\u{...}`: not a Unicode scalar value (above 10FFFF, or a surrogate)"
    assert len(escape_errors("\"\\u{D800}\"")) == 1
    assert len(escape_errors("\"\\u{DFFF}\"")) == 1
    assert len(escape_errors("\"\\u{E000}\"")) == 0
    assert len(escape_errors("b\"\\xZZ\"")) == 1
    assert len(escape_errors("f\"{1}\\xZ\"")) == 1
    assert len(escape_errors("f\"\\u{110000}{1}\"")) == 1
}

test "a fallible result may not be dropped, but may be ignored with let _" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Closer {
            func shut(self) -> none or Error
        }
        type Door = struct {
            n: int64
            func shut(self) -> none or Error { return }
        }
        func close() -> none or Error { return }
        func parse() -> int64 or Error { return 1 }
        func main() -> int64 {
            let d = Door(n: 1)
            let c: Closer = d
            close()
            d.shut()
            c.shut()
            parse()
            return 0
        }
        """)
    assert len(errs) == 4
    assert errs[0].message == "error: the `none or Error` result of this call is dropped; handle it with `try`, `must` or `is Err(e)`, or write `let _ = ...` to ignore it"
    assert errs[0].line == 13
    assert errs[3].message == "error: the `int64 or Error` result of this call is dropped; handle it with `try`, `must` or `is Err(e)`, or write `let _ = ...` to ignore it"
    let ok: [codegen.Diagnostic] = test_support.try_compile("""
        func close() -> none or Error { return }
        func parse() -> int64 or Error { return 1 }
        func count() -> int64 { return 1 }
        func risky() -> none or Error {
            try close()
            let n = must parse()
            let _ = close()
            let _ = parse()
            let _ = count()
            let r = close()
            if r is Err(_) { return }
            count()
        }
        func main() -> int64 {
            let _ = risky()
            return 0
        }
        """)
    assert len(ok) == 0
}

test "the underscore binds nothing" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func count() -> int64 { return 1 }
        func main() -> int64 {
            let _ = count()
            let a = _
            return a
        }
        """)
    assert len(errs) > 0
    assert test_support.any_message_contains(errs, needle: "`_`")
}

test "a call split across lines compiles, and an unclosed one is an error" {
    let ok: [codegen.Diagnostic] = test_support.try_compile("""
        func f(a: int64, b: int64 = 2) -> int64 { return a + b }
        func main() -> int64 {
            return f(
                a: 1,
                b: 3,
            )
        }
        """)
    assert len(ok) == 0
    let open: [codegen.Diagnostic] = test_support.try_compile("""
        func f(a: int64, b: int64 = 2) -> int64 { return a + b }
        func main() -> int64 {
            let x = f(
                a: 1,
                b: 3
            let y = 2
            return x
        }
        """)
    assert len(open) == 1
    assert open[0].message == "error: expected `)`, got `let`"
    assert open[0].line == 6
}

test "a label can jump over defaults, and only over defaults" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f(a: int64, b: int64 = 1, c: int64 = 2) -> int64 { return a + b + c }
        func g(a: int64 = 1, b: int64 = 2, c: int64 = 3) -> int64 { return a + b + c }
        func h(anon x: int64 = 1, y: int64 = 2) -> int64 { return x + y }
        type Box = struct {
            n: int64
            func get(self, by: int64 = 1, more: int64 = 2) -> int64 { return self.n + by + more }
            func read(self, a: int64 = 1, b: int64 = 2) -> int64 { return a + b }
        }
        interface Reader {
            func read(self, a: int64 = 1, b: int64 = 2) -> int64
        }
        func main() -> int64 {
            let box = Box(n: 1)
            let r: Reader = box
            return f(a: 1, c: 5) + g(c: 9) + g(b: 1, c: 2) + h(y: 3) + box.get(more: 4) + r.read(b: 3)
        }
        """)
    assert len(errs) == 0
}

test "jumping over a parameter that has no default, or out of order, is still an error" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f(a: int64, b: int64 = 1, c: int64 = 2) -> int64 { return a + b + c }
        func g(a: int64 = 1, b: int64 = 2, c: int64 = 3) -> int64 { return a + b + c }
        func main() -> int64 {
            return f(c: 1) + g(b: 1, a: 2) + g(a: 1, a: 2) + g(z: 1) + g(c: 1, b: 2)
        }
        """)
    assert len(errs) == 5
    assert errs[0].message == "error: parameter 0 of `f` expected label `a`, got `c`"
    assert errs[1].message == "error: parameter 2 of `g` expected label `c`, got `a`"
    assert errs[2].message == "error: parameter 1 of `g` expected label `b`, got `a`"
    assert errs[3].message == "error: parameter 0 of `g` expected label `a`, got `z`"
    assert errs[4].message == "error: `g` has no parameter for argument 1"
}

test "a skipped parameter is not a missing one, but a missing one still is" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f(a: int64, b: int64 = 1) -> int64 { return a + b }
        func main() -> int64 {
            return f(b: 2)
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: parameter 0 of `f` expected label `a`, got `b`"
}

test "an unlabeled argument cannot skip, and an argument after the last parameter is too many" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f(a: int64 = 1, b: int64 = 2) -> int64 { return a + b }
        func g(anon n: int64, b: int64 = 1, c: int64 = 2) -> int64 { return n + b + c }
        func main() -> int64 {
            return f(2) + g(1, 2) + g(1, c: 3, 4)
        }
        """)
    assert len(errs) == 3
    assert errs[0].message == "error: parameter 0 of `f` requires label `a` (use `a:` or `:a` shorthand)"
    assert errs[1].message == "error: parameter 1 of `g` requires label `b` (use `b:` or `:b` shorthand)"
    assert errs[2].message == "error: `g` has no parameter for argument 2"
}

test "a default with the wrong type is reported where it is written" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f(x: int64 = "a") -> int64 { return x }
        func main() -> int64 {
            return f()
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: expected `int64`, got `str`"
    assert errs[0].line == 1
    assert errs[0].col == 19
}

test "arguments converted for their parameters" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s * self.s }
        }
        type Color = enum {
            Red
            Green
        }
        func shape(anon s: Shape) -> int64 { return s.area() }
        func opt(anon n: int64?) -> int64 { return n? or 0 }
        func col(anon c: Color) -> int64 { return 0 }
        func take(anon xs: [Shape]) -> int64 { return len(xs) }
        func dbl(anon x: int64) -> int64 { return x * 2 }
        func apply(anon f: func(int64) -> int64, anon x: int64) -> int64 { return f(x) }
        func main() -> int64 {
            let n = shape(Sq(s: 2)) + opt(5) + opt(none) + col(.Red) + col(Color.Green)
            return n + take([]) + take([Sq(s: 1)]) + apply(dbl, 3)
        }
        """)
    assert len(errs) == 0
}

test "a method argument must have its parameter's type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Scaler {
            func scale(self, anon by: int64) -> int64
        }
        type Box = struct {
            n: int64
            func scale(self, anon by: int64) -> int64 { return self.n * by }
            func bump(self, by: int64 = 1) -> int64 { return self.n + by }
            func label(self, anon s: str) -> str { return s }
        }
        func main() -> int64 {
            let m = Map[str, int64]()
            m.set(5, 1)
            let g = m.get(5)
            let b = Box(n: 1)
            b.label(3)
            let s: Scaler = b
            s.scale("a")
            let c: Box? = b
            c?.bump(by: "a")
            "a".contains(5)
            return 0
        }
        """)
    assert len(errs) == 6
    assert errs[0].message == "error: expected `str`, got `int64`"
    assert errs[0].line == 12
    assert errs[1].message == "error: expected `str`, got `int64`"
    assert errs[1].line == 13
    assert errs[2].message == "error: expected `str`, got `int64`"
    assert errs[2].line == 15
    assert errs[3].message == "error: expected `int64`, got `str`"
    assert errs[3].line == 17
    assert errs[4].message == "error: expected `int64`, got `str`"
    assert errs[4].line == 19
    assert errs[5].message == "error: expected `str`, got `int64`"
    assert errs[5].line == 20
}

test "method arguments converted for their parameters" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s * self.s }
        }
        func main() -> int64 {
            let a = Map[str, [int64]]()
            a.set("k", [1, 2])
            let b = Map[str, int64?]()
            b.set("k", 5)
            b.set("n", none)
            let c = Map[str, Shape]()
            c.set("k", Sq(s: 3))
            let d = Map[str, [Shape]]()
            d.set("k", [Sq(s: 2)])
            return 0
        }
        """)
    assert len(errs) == 0
}

test "a constructor field or payload must have its declared type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Foo = struct {
            name: str
            x: int64 = 0
        }
        type Msg = enum {
            Text(content: str)
            Move(x: int64, y: int64)
            Quit
        }
        type Either[L, R] = enum {
            Left(value: L)
            Right(value: R)
        }
        func main() -> int64 {
            let a = Foo(name: 5)
            let b = Foo(name: "a", x: 1, x: 2)
            let m: Msg = .Text(content: 5)
            let n = Msg.Move(x: "a", y: 1)
            let e = Either.Left(value: 1)
            return 0
        }
        """)
    assert len(errs) == 5
    assert errs[0].message == "error: expected `str`, got `int64`"
    assert errs[0].line == 15
    assert errs[1].message == "error: field `x` is given twice"
    assert errs[1].col == 34
    assert errs[2].message == "error: expected `str`, got `int64`"
    assert errs[2].line == 17
    assert errs[3].message == "error: expected `int64`, got `str`"
    assert errs[3].line == 18
    assert errs[4].message == "error: cannot infer the type of `e`; add a type annotation"
}

test "constructor fields and payloads converted for their types" {
