// An enum's name before a `.`, and a type's name as a type argument or a
// generic constructor, mean the type where a local of that name is in
// force, whether that local hides another one or not.
type Color = enum {
    Red
    Blue
    Mix(r: int64)
}

type Box[T] = struct {
    v: T
}

func name(anon c: Color) -> str {
    match c {
        .Red -> return "red"
        .Blue -> return "blue"
        .Mix(r) -> return f"mix{r}"
    }
}

func same_block() -> str {
    let Color = 3
    let b = Box[Color](v: Color.Mix(r: Color))
    return f"{name(Color.Blue)} {name(b.v)}"
}

func hiding(anon Color: int64, anon Box: int64) -> str {
    if Color > 0 {
        let Color = 4
        let Box = 5
        let b = Box[Color](v: Color.Mix(r: Color + Box))
        return f"{name(Color.Blue)} {name(b.v)}"
    }
    return "none"
}

func main() -> int64 {
    print(same_block())
    print(hiding(1, 2))
    return 0
}

// expected output:
// blue mix3
// blue mix9
