// A block may bind a name again itself, and so may a block after one
// whose binding of the name has ended.
func twice(anon n: int64) -> int64 {
    let n = n * 2
    return n
}

test "rebinding in the same block and in later blocks" {
    let x = 1
    let x = x + 1
    assert x == 2
    mut ran = 0
    if x > 0 {
        let y = "first"
        assert y == "first"
        ran += 1
    }
    if x > 1 {
        let y = 3
        assert y == 3
        ran += 1
    }
    assert ran == 2
    mut got: [str] = []
    for s in ["a", "b"] {
        let s = s + "!"
        got += [s]
    }
    assert got == ["a!", "b!"]
    mut ints: [int64] = []
    for s in [10] {
        ints += [s]
    }
    assert ints == [10]
    let o: int64? = 4
    match o {
        Some(v) -> {
            let v = v + 1
            assert v == 5
        }
        none -> fail("none")
    }
    assert twice(4) == 8
}
