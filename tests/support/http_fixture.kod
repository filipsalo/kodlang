// A scripted HTTP server for stdlib/net/http_client_test.kod.
//
// Usage: http_fixture PORT [CERT KEY]. It answers on 127.0.0.1:PORT, one raw
// response per path (see `route`), over TLS 1.2 when a certificate and key
// are given, and exits by itself after two minutes. A connection stays open
// for the next request unless the request or the route says otherwise.
//
// Each connection is served by a child process of its own, so connections
// are served at the same time. The counters that /conn-id, /drops and
// /flaky keep live in memory the children share. A child serves until its
// connection ends, and stops waiting for the next request once the server
// has ended. Compressed bodies come from the system's zlib, the library
// Python's zlib module wraps, so they are the bytes the Python version sent.
// For TLS the certificate and key go through `openssl pkcs12` once, and each
// child loads the result into memory (not into a keychain) for
// SecureTransport's server side.
// kod:link -framework Security -framework CoreFoundation -lz

import "io"
import "libc"
import "net/tcp"
import "posix"
import "posix" { Fd, open_read }
import "process"
import "stream" { BufReader, IoError, Reader, Writer }
import "strbuilder" { StrBuilder }
import "time"
import "time" { Duration, monotonic_ns }
import "unsafe"

extern func _exit(anon status: int64) -> none
extern func shutdown(anon fd: int64, anon how: int64) -> int64
extern func mmap(anon addr: int64, anon len: int64, anon prot: int64, anon flags: int64, anon fd: int64, anon offset: int64) -> int64
extern func OSAtomicAdd64Barrier(anon amount: int64, anon addr: int64) -> int64
extern func dlsym(anon handle: int64, anon name: int64) -> int64
// zlib.
extern func zlibVersion() -> int64
extern func deflateInit2_(anon strm: int64, anon level: int64, anon method: int64, anon wbits: int64, anon mem_level: int64, anon strategy: int64, anon version: int64, anon size: int64) -> int64
extern func deflateBound(anon strm: int64, anon n: int64) -> int64
extern func deflate(anon strm: int64, anon flush: int64) -> int64
extern func deflateEnd(anon strm: int64) -> int64
// SecureTransport and the CoreFoundation calls it needs.
extern func SecPKCS12Import(anon data: int64, anon options: int64, anon items: int64) -> int64
extern func CFDataCreate(anon alloc: int64, anon data: int64, anon len: int64) -> int64
extern func CFStringCreateWithCString(anon alloc: int64, anon s: int64, anon encoding: int64) -> int64
extern func CFDictionaryCreate(anon alloc: int64, anon keys: int64, anon values: int64, anon n: int64, anon key_callbacks: int64, anon value_callbacks: int64) -> int64
extern func CFDictionaryGetValue(anon dict: int64, anon key: int64) -> int64
extern func CFArrayCreate(anon alloc: int64, anon values: int64, anon n: int64, anon callbacks: int64) -> int64
extern func CFArrayGetCount(anon array: int64) -> int64
extern func CFArrayGetValueAtIndex(anon array: int64, anon i: int64) -> int64
extern func SSLCreateContext(anon alloc: int64, anon side: int64, anon kind: int64) -> int64
extern func SSLSetIOFuncs(anon ctx: int64, anon read: int64, anon write: int64) -> int64
extern func SSLSetConnection(anon ctx: int64, anon conn: int64) -> int64
extern func SSLSetProtocolVersionMin(anon ctx: int64, anon version: int64) -> int64
extern func SSLSetProtocolVersionMax(anon ctx: int64, anon version: int64) -> int64
extern func SSLSetCertificate(anon ctx: int64, anon certs: int64) -> int64
extern func SSLHandshake(anon ctx: int64) -> int64
extern func SSLRead(anon ctx: int64, anon data: int64, anon len: int64, anon processed: int64) -> int64
extern func SSLGetBufferedReadSize(anon ctx: int64, anon size: int64) -> int64
extern func SSLWrite(anon ctx: int64, anon data: int64, anon len: int64, anon processed: int64) -> int64

let LIFETIME_MS: int64 = 120000
// The macOS values of the C constants used here.
let SHUT_WR: int64 = 1
let PROT_READ_WRITE: int64 = 3
let MAP_SHARED_ANON: int64 = 4097
let WNOHANG: int64 = 1
let EINTR: int64 = 4
let RTLD_DEFAULT: int64 = -2
let Z_FINISH: int64 = 4
let Z_STREAM_SIZE: int64 = 112
let SERVER_SIDE: int64 = 0
let STREAM_TYPE: int64 = 0
let TLS_1_2: int64 = 8
let CLOSED_GRACEFUL: int64 = -9805
let CLOSED_ABORT: int64 = -9806
let CLOSED_NO_NOTIFY: int64 = -9816
let SEC_IO: int64 = -36
let UTF8: int64 = 134217984
let P12_PASSWORD: str = "kod"
// The counters the children share, at these offsets.
let CONNECTIONS: int64 = 0
let DROPS: int64 = 8
let FLAKY: int64 = 16

type Header = shared struct {
    name: str
    value: str
}

type Request = shared struct {
    method: str
    target: str
    headers: [Header]
    body: bytes
}

func b(anon text: str) -> bytes {
    return kod_str_to_bytes(text)
}

// `parts` one after another.
func cat(anon parts: [bytes]) -> bytes {
    let out = StrBuilder()
    for p in parts {
        out.append_bytes(p)
    }
    return out.to_bytes()
}

// `unit` `times` times over.
func repeat(anon unit: str, anon times: int64) -> bytes {
    let out = StrBuilder()
    mut block = unit
    mut left = times
    for left > 0 {
        if (left & 1) == 1 {
            out.append(block)
        }
        block = block + block
        left = left >> 1
    }
    return out.to_bytes()
}

// Python's str.strip() on a latin-1 line: its whitespace includes the
// separators 28-31, 133 and 160.
func is_py_space(anon c: int64) -> bool {
    return (c >= 9 and c <= 13) or (c >= 28 and c <= 32) or c == 133 or c == 160
}

func py_strip(anon s: str) -> str {
    mut i = 0
    mut j = len(s)
    for i < j and is_py_space(s[i]) {
        i += 1
    }
    for j > i and is_py_space(s[j - 1]) {
        j -= 1
    }
    return s[i..j]
}

// A line read as latin-1 and written out as UTF-8, as Python's echo did.
func utf8_of_latin1(anon s: str) -> bytes {
    let out = StrBuilder()
    for c in kod_str_to_bytes(s) {
        if c < 128 {
            out.append_byte(c)
        } else {
            out.append_byte(192 | (c >> 6))
            out.append_byte(128 | (c & 63))
        }
    }
    return out.to_bytes()
}

// ---- responses ----

func reply(anon status: str, anon body: bytes, headers: str = "", length: bool = true) -> bytes {
    mut head = f"HTTP/1.1 {status}\r\n{headers}"
    if length {
        head += f"Content-Length: {len(body)}\r\n"
    }
    return cat([b(head), b("\r\n"), body])
}

func redirect(anon status: str, anon location: str) -> bytes {
    return reply(status, b("moved"), headers: f"Location: {location}\r\n")
}

// Each part as a chunk, without the last chunk.
func chunks(anon parts: [bytes]) -> bytes {
    let out = StrBuilder()
    for p in parts {
        out.append(f"{len(p):x}\r\n")
        out.append_bytes(p)
        out.append("\r\n")
    }
    return out.to_bytes()
}

func chunked() -> bytes {
    let body = chunks([b("Wiki"), b("pedia"), b(" in\r\n\r\nchunks.")])
    return cat([b("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"), body, b("0\r\nX-Trailer: yes\r\n\r\n")])
}

func echo(anon r: Request) -> bytes {
    let text = StrBuilder()
    text.append_bytes(utf8_of_latin1(f"{r.method} {r.target}"))
    for h in r.headers {
        text.append("\n")
        text.append_bytes(utf8_of_latin1(f"{h.name}: {h.value}"))
    }
    text.append("\n\n")
    text.append_bytes(r.body)
    return reply("200 OK", text.to_bytes())
}

// `data` compressed by zlib at `level` (-1 for its default), framed as
// `wbits` says: 15 zlib, -15 raw, 31 gzip.
func zlib_compress(anon data: bytes, level: int64, wbits: int64) -> bytes {
    let strm = unsafe.alloc(Z_STREAM_SIZE)
    if unsafe.c_int(deflateInit2_(strm, level, 8, wbits, 8, 0, zlibVersion(), Z_STREAM_SIZE)) != 0 {
        panic("deflateInit2 failed")
    }
    let room = deflateBound(strm, len(data))
    let out = unsafe.alloc(room + 1)
    // next_in, avail_in, next_out, avail_out; total_out at 40.
    unsafe.store64(strm, unsafe.data(data))
    unsafe.store32(strm + 8, len(data))
    unsafe.store64(strm + 24, out)
    unsafe.store32(strm + 32, room)
    if unsafe.c_int(deflate(strm, Z_FINISH)) != 1 {
        panic("deflate did not finish")
    }
    let packed = unsafe.copy_out(out, unsafe.load64(strm + 40))
    deflateEnd(strm)
    unsafe.free(out)
    unsafe.free(strm)
    return packed
}

// Python's gzip.compress(data, mtime=0): level 9, and the OS byte 255.
func gzip(anon data: bytes) -> bytes {
    let z = zlib_compress(data, level: 9, wbits: 31)
    let out = StrBuilder()
    out.append_bytes(z[0..4])
    for _ in 0..4 {
        out.append_byte(0)
    }
    out.append_byte(z[8])
    out.append_byte(255)
    out.append_bytes(z[10..len(z)])
    return out.to_bytes()
}

// Responses with a Content-Encoding.
func encoded(anon method: str, anon path: str) -> bytes {
    mut plain = b("hello gzip")
    mut coding = "gzip"
    if path == "/gzip-empty" {
        plain = b("")
    } else if path == "/gzip-bomb" {
        plain = repeat("x", 20000000)
    } else if path == "/gzip-big" {
        plain = repeat("0123456789abcdef", 300000)
    } else if path == "/gzip-utf8" {
        plain = b("Café ☕")
    }
    mut body = gzip(plain)
    if path == "/gzip-bad" {
        body = b("this is not gzip data")
    } else if path == "/br" {
        coding = "br"
        let raw = StrBuilder()
        raw.append_byte(0x8b)
        raw.append_byte(0x02)
        raw.append_byte(0x80)
        raw.append("binary")
        body = raw.to_bytes()
    } else if path == "/gzip-list" {
        coding = "gzip, br"
    } else if path == "/x-gzip" {
        coding = "x-gzip"
    } else if path == "/deflate" {
        coding = "deflate"
        body = zlib_compress(plain, level: -1, wbits: 15)
    } else if path == "/deflate-raw" {
        coding = "deflate"
        body = zlib_compress(plain, level: -1, wbits: -15)
    } else if path == "/deflate-bad" {
        coding = "deflate"
        body = b("this is not deflate data")
    }
    let headers = f"Content-Encoding: {coding}\r\n"
    if path == "/gzip-chunked" {
        let half = len(body) / 2
        let framed = chunks([body[0..half], body[half..len(body)]])
        return cat([b(f"HTTP/1.1 200 OK\r\n{headers}Transfer-Encoding: chunked\r\n\r\n"), framed, b("0\r\n\r\n")])
    }
    if method == "HEAD" {
        return b(f"HTTP/1.1 200 OK\r\n{headers}Content-Length: {len(body)}\r\n\r\n")
    }
    return reply("200 OK", body, :headers)
}

// ---- TLS ----

// SecureTransport's read callback: `*len_at` bytes from the descriptor
// `fd` into `data`. It leaves in `*len_at` how many it got.
func _read_cb(anon fd: int64, anon data: int64, anon len_at: int64) -> int64 {
    let want = unsafe.load64(len_at)
    mut got = 0
    for got < want {
        let n = libc.read(fd, data + got, want - got)
        if n > 0 {
            got += n
        } else if n == 0 or unsafe.errno() != EINTR {
            unsafe.store64(len_at, got)
            if n == 0 {
                return CLOSED_GRACEFUL
            }
            return SEC_IO
        }
    }
    unsafe.store64(len_at, got)
    return 0
}

// SecureTransport's write callback, the same way round.
func _write_cb(anon fd: int64, anon data: int64, anon len_at: int64) -> int64 {
    let want = unsafe.load64(len_at)
    mut put = 0
    for put < want {
        let n = libc.write(fd, data + put, want - put)
        if n > 0 {
            put += n
        } else if n == 0 or unsafe.errno() != EINTR {
            unsafe.store64(len_at, put)
            return SEC_IO
        }
    }
    unsafe.store64(len_at, put)
    return 0
}

func tls_error(anon op: str, anon status: int64) -> IoError {
    return IoError(kind: .Tls, op: op, errno: 0, detail: f"OSStatus {status}")
}

// The value of the C global `name`, a pointer.
func global(anon name: str) -> int64 {
    return unsafe.load64(dlsym(RTLD_DEFAULT, unsafe.c_str(name)))
}

// The identity in the PKCS#12 data `p12`, in a CFArray for SSLSetCertificate,
// imported into memory only.
func identity(anon p12: bytes) -> int64 or Error {
    let data = CFDataCreate(0, unsafe.data(p12), len(p12))
    // Two keys, then their two values, then the import's result.
    let slots = unsafe.alloc(40)
    unsafe.store64(slots, global("kSecImportExportPassphrase"))
    unsafe.store64(slots + 8, global("kSecImportToMemoryOnly"))
    unsafe.store64(slots + 16, CFStringCreateWithCString(0, unsafe.c_str(P12_PASSWORD), UTF8))
    unsafe.store64(slots + 24, global("kCFBooleanTrue"))
    let callbacks = dlsym(RTLD_DEFAULT, unsafe.c_str("kCFTypeDictionaryKeyCallBacks"))
    let values = dlsym(RTLD_DEFAULT, unsafe.c_str("kCFTypeDictionaryValueCallBacks"))
    let options = CFDictionaryCreate(0, slots, slots + 16, 2, callbacks, values)
    let status = unsafe.c_int(SecPKCS12Import(data, options, slots + 32))
    let items = unsafe.load64(slots + 32)
    if status != 0 or items == 0 or CFArrayGetCount(items) == 0 {
        throw tls_error("import the certificate and key", status)
    }
    unsafe.store64(slots, CFDictionaryGetValue(CFArrayGetValueAtIndex(items, 0), global("kSecImportItemIdentity")))
    return CFArrayCreate(0, slots, 1, dlsym(RTLD_DEFAULT, unsafe.c_str("kCFTypeArrayCallBacks")))
}

// The server's side of a TLS 1.2 session on `fd`.
type TlsConn = shared struct {
    fd: int64
    ctx: int64

    // What has been decrypted and not yet read.
    func buffered(self) -> int64 {
        let size = unsafe.alloc(8)
        SSLGetBufferedReadSize(self.ctx, size)
        let n = unsafe.load64(size)
        unsafe.free(size)
        return n
    }

    // As soon as one byte is in, that and whatever else is decrypted, at
    // most `max` bytes; empty at the end of the stream, however it ended.
    func read(self, anon max: int64) -> bytes or Error {
        let buf = unsafe.alloc(max + 1)
        let done = unsafe.alloc(8)
        let status = unsafe.c_int(SSLRead(self.ctx, buf, 1, done))
        mut got = unsafe.load64(done)
        let more = self.buffered()
        if got > 0 and more > 0 and max > 1 {
            unsafe.store64(done, 0)
            mut ask = max - 1
            if more < ask {
                ask = more
            }
            SSLRead(self.ctx, buf + 1, ask, done)
            got += unsafe.load64(done)
        }
        let data = unsafe.copy_out(buf, got)
        unsafe.free(buf)
        unsafe.free(done)
        if got == 0 and status != CLOSED_GRACEFUL and status != CLOSED_NO_NOTIFY and status != CLOSED_ABORT {
            throw tls_error("read", status)
        }
        return data
    }

    func write(self, anon data: bytes) -> int64 or Error {
        let done = unsafe.alloc(8)
        let status = unsafe.c_int(SSLWrite(self.ctx, unsafe.data(data), len(data), done))
        let n = unsafe.load64(done)
        unsafe.free(done)
        if status != 0 {
            throw tls_error("write", status)
        }
        return n
    }
}

func accept_tls(anon fd: int64, p12: bytes) -> TlsConn or Error {
    let certs = try identity(p12)
    let ctx = SSLCreateContext(0, SERVER_SIDE, STREAM_TYPE)
    mut status = unsafe.c_int(SSLSetIOFuncs(ctx, unsafe.c_function(_read_cb), unsafe.c_function(_write_cb)))
    if status == 0 {
        status = unsafe.c_int(SSLSetConnection(ctx, fd))
    }
    if status == 0 {
        status = unsafe.c_int(SSLSetProtocolVersionMin(ctx, TLS_1_2))
    }
    if status == 0 {
        status = unsafe.c_int(SSLSetProtocolVersionMax(ctx, TLS_1_2))
    }
    if status == 0 {
        status = unsafe.c_int(SSLSetCertificate(ctx, certs))
    }
    if status == 0 {
        status = unsafe.c_int(SSLHandshake(ctx))
    }
    if status != 0 {
        throw tls_error("handshake", status)
    }
    return TlsConn(:fd, :ctx)
}

// The certificate and key as PKCS#12 data, from `openssl pkcs12`.
func pkcs12(anon cert: str, anon key: str) -> bytes or Error {
    let made = try process.output(["mktemp", "-t", "http_fixture"])
    let path = made.stdout.trim()
    let ran = try process.output(["/usr/bin/openssl", "pkcs12", "-export", "-in", cert, "-inkey", key, "-passout", f"pass:{P12_PASSWORD}", "-out", path])
    let file = try open_read(path)
    let data = file.read_all()
    try file.close()
    libc.unlink(unsafe.c_str(path))
    if ran.status != 0 {
        throw IoError(kind: .Other, op: "openssl pkcs12", errno: 0, detail: ran.stderr.trim())
    }
    return try data
}

// ---- a connection ----

type Handler = shared struct {
    port: int64
    // The shared counters.
    state: int64
    input: BufReader
    out: Writer
    // The TLS session, if there is one.
    tls: TlsConn?
    // Readable once the server has ended.
    server_gone: int64
    conn_id: int64 = 0
    requests: int64 = 0
    close_after: bool = false

    // The next line with its line ending taken off; "" at the end of the
    // stream, as Python's readline().rstrip("\r\n") gives.
    func line(self) -> str or Error {
        let got = try self.input.read_until(10)
        mut text = kod_bytes_to_str(got? or b(""))
        mut n = len(text)
        for n > 0 and (text[n - 1] == 13 or text[n - 1] == 10) {
            n -= 1
        }
        return text[0..n]
    }

    // Up to `n` bytes, fewer at the end of the stream; a negative `n` reads
    // to the end.
    func body(self, anon n: int64) -> bytes or Error {
        let out = StrBuilder()
        for n < 0 or out.len() < n {
            mut want = 65536
            if n >= 0 {
                want = n - out.len()
            }
            let piece = try self.input.read(want)
            if len(piece) == 0 {
                break
            }
            out.append_bytes(piece)
        }
        return out.to_bytes()
    }

    // The next request; none at the end of the connection, at an empty
    // request line, or at a request that can't be read.
    func read_request(self) -> Request? or Error {
        let first = try self.line()
        if first == "" {
            return none
        }
        let sp = first.find(" ")
        if sp is none {
            return none
        }
        let a = sp
        let sp2 = first.find(" ", from: a + 1)
        if sp2 is none {
            return none
        }
        let r = Request(method: first[0..a], target: first[a + 1..sp2], headers: [], body: b(""))
        for true {
            let text = try self.line()
            if text == "" {
                break
            }
            mut name = text
            mut value = ""
            if text.find(":") is int64(colon) {
                name = text[0..colon]
                value = py_strip(text[colon + 1..len(text)])
            }
            r.headers += [Header(:name, :value)]
        }
        mut length: int64 = 0
        for h in r.headers {
            if h.name.lower() == "content-length" {
                if py_strip(h.value).parse_int() is int64(n) {
                    length = n
                } else {
                    return none
                }
            }
        }
        if length != 0 {
            r.body = try self.body(length)
        }
        return r
    }

    func handle(self, anon fd: int64) -> none or Error {
        for true {
            if not self.wait(fd) {
                return
            }
            let got = try self.read_request()
            if got is none {
                return
            }
            let r = got
            if self.requests == 0 {
                self.conn_id = OSAtomicAdd64Barrier(1, self.state + CONNECTIONS)
            }
            self.requests += 1
            self.close_after = false
            mut path = r.target
            if r.target.find("?") is int64(q) {
                path = r.target[0..q]
            }
            let response = try self.route(r, :path)
            if response is none {
                return
            }
            let sent = response
            try self.out.write_all(sent)
            mut asked_close = false
            for h in r.headers {
                if h.name.lower() == "connection" and h.value.lower().contains("close") {
                    asked_close = true
                }
            }
            if asked_close or self.close_after or not framed(r.method, sent) {
                return
            }
        }
    }

    // Wait for the next request to start coming in. False when the server
    // has gone first.
    func wait(self, anon fd: int64) -> bool {
        if self.input.pos < len(self.input.buf) {
            return true
        }
        if self.tls is TlsConn(t) {
            if t.buffered() > 0 {
                return true
            }
        }
        let ready = posix.poll(read: [Fd(:fd), Fd(fd: self.server_gone)])
        if ready is Err(_) {
            return false
        }
        return ready.read[0] or not ready.read[1]
    }

    // A 20-byte body sent a byte at a time, 30 ms apart: every read makes
    // progress, the whole takes 0.6 s.
    func dribble(self) -> bytes or Error {
        try self.out.write_all(b("HTTP/1.1 200 OK\r\nContent-Length: 20\r\n\r\n"))
        for _ in 0..20 {
            time.sleep(Duration(ms: 30))
            try self.out.write_all(b("x"))
        }
        return b("")
    }

    func count(self, anon at: int64) -> int64 {
        return OSAtomicAdd64Barrier(1, self.state + at)
    }

    // The response to send; none to close the connection without one.
    func route(self, anon r: Request, path: str) -> bytes? or Error {
        let port = self.port
        if path == "/conn-id" {
            return reply("200 OK", b(f"conn {self.conn_id} req {self.requests}"))
        }
        if path == "/redir-id" {
            return redirect("302 Found", "/conn-id")
        }
        if path.starts_with("/gzip") or path.starts_with("/deflate") or path == "/x-gzip" or path == "/br" {
            return encoded(r.method, path)
        }
        if path == "/lies" {
            // Says close, which only the header tells the client. (The
            // Python version meant to leave the socket open here, but its
            // loop closed it on the header, as this one does.)
            return reply("200 OK", b("lies"), headers: "Connection: close\r\n")
        }
        if path == "/lies10" {
            return b("HTTP/1.0 200 OK\r\nContent-Length: 4\r\n\r\nlies")
        }
        if path == "/close-after" {
            return reply("200 OK", b("bye"), headers: "Connection: close\r\n")
        }
        if path == "/http10" {
            self.close_after = true
            return b("HTTP/1.0 200 OK\r\nContent-Length: 2\r\n\r\nok")
        }
        if path == "/http10-keep" {
            return b("HTTP/1.0 200 OK\r\nConnection: keep-alive\r\nContent-Length: 2\r\n\r\nok")
        }
        if path == "/silent-close" {
            self.close_after = true
            return reply("200 OK", b("closing"))
        }
        if path == "/drop" {
            self.count(DROPS)
            return none
        }
        if path == "/drops" {
            return reply("200 OK", b(str(unsafe.load64(self.state + DROPS))))
        }
        if path == "/flaky" {
            if self.count(FLAKY) % 2 == 1 {
                return none
            }
            return reply("200 OK", b("recovered"))
        }
        if path == "/flaky-count" {
            return reply("200 OK", b(str(unsafe.load64(self.state + FLAKY))))
        }
        if path == "/hello" {
            return reply("200 OK", b("hello"), headers: "Content-Type: text/plain\r\nX-A: 1\r\nX-A: 2\r\n")
        }
        if path == "/echo" {
            return echo(r)
        }
        if path == "/head" {
            return b("HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\n")
        }
        if path == "/chunked" {
            return chunked()
        }
        if path == "/close" {
            return reply("200 OK", b("until close"), length: false)
        }
        if path == "/nocontent" {
            return b("HTTP/1.1 204 No Content\r\n\r\n")
        }
        if path == "/interim" {
            return cat([b("HTTP/1.1 100 Continue\r\n\r\n"), reply("200 OK", b("after interim"))])
        }
        if path == "/302" {
            return redirect("302 Found", "/echo")
        }
        if path == "/301" {
            return redirect("301 Moved Permanently", "/echo")
        }
        if path == "/303" {
            return redirect("303 See Other", "/echo")
        }
        if path == "/307" {
            return redirect("307 Temporary Redirect", "/echo")
        }
        if path == "/308" {
            return redirect("308 Permanent Redirect", "/echo")
        }
        if path == "/relative" {
            return redirect("302 Found", "hello")
        }
        if path == "/dir/relative" {
            return redirect("302 Found", "../hello")
        }
        if path == "/absolute" {
            return redirect("302 Found", f"http://127.0.0.1:{port}/hello")
        }
        if path == "/cross-host" {
            return redirect("302 Found", f"http://localhost:{port}/echo")
        }
        if path == "/chain" {
            return redirect("302 Found", "/302")
        }
        if path == "/loop" {
            return redirect("302 Found", "/loop")
        }
        if path == "/no-location" {
            return reply("302 Found", b("nowhere"))
        }
        if path == "/to-ftp" {
            return redirect("302 Found", "ftp://example.com/")
        }
        if path == "/slow" {
            time.sleep(Duration(ms: 800))
            return reply("200 OK", b("late"))
        }
        if path == "/dribble" {
            return try self.dribble()
        }
        if path == "/hop1" {
            time.sleep(Duration(ms: 250))
            return redirect("302 Found", "/hop2")
        }
        if path == "/hop2" {
            time.sleep(Duration(ms: 250))
            return redirect("302 Found", "/hello")
        }
        if path == "/big" {
            return reply("200 OK", repeat("x", 3000000))
        }
        if path == "/truncated" {
            self.close_after = true
            return b("HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\nshort")
        }
        if path == "/garbage" {
            return b("NOT HTTP AT ALL\r\n\r\n")
        }
        if path == "/bomb" {
            let lines = StrBuilder()
            for i in 0..500 {
                lines.append(f"X-{i}: v\r\n")
            }
            return reply("200 OK", b(""), headers: lines.to_str())
        }
        if path == "/created" {
            return reply("201 Created", b("made"))
        }
        if path == "/missing" {
            return reply("404 Not Found", b("nope"))
        }
        return reply("404 Not Found", b("no such route"))
    }
}

// Whether the connection can carry another response after `response`, sent
// for a `method` request: its end is known from its head (up to the first
// blank line), as Python's version worked it out.
func framed(anon method: str, anon response: bytes) -> bool {
    let text = kod_bytes_to_str(response)
    mut head = text
    if text.find("\r\n\r\n") is int64(end) {
        head = text[0..end]
    }
    head = head.lower()
    mut status = ""
    if head.find(" ") is int64(a) {
        if head.find(" ", from: a + 1) is int64(c) {
            status = head[a + 1..c]
        }
    }
    let bodyless = method == "HEAD" or status == "204" or status == "304"
    let known = bodyless or head.contains("content-length:") or head.contains("transfer-encoding:")
    return known and not head.contains("connection: close")
}

// Serve the connection `fd` in this child process, then end it.
func serve(anon fd: int64, port: int64, state: int64, server_gone: int64, p12: bytes?) -> none {
    mut input: Reader = Fd(:fd)
    mut out: Writer = Fd(:fd)
    mut tls: TlsConn? = none
    if p12 is bytes(data) {
        let shaken = accept_tls(fd, p12: data)
        if shaken is Err(e) {
            io.write_stderr(f"http_fixture: {e.to_str()}\n")
            _exit(1)
        }
        let t = shaken? or TlsConn(fd: -1, ctx: 0)
        input = t
        out = t
        tls = t
    }
    let h = Handler(:port, :state, input: BufReader(inner: input, limit: 4611686018427387904), :out, :tls, :server_gone)
    let _ = h.handle(fd)
    // As Python's socketserver ends a connection: no TLS close notice.
    shutdown(fd, SHUT_WR)
    libc.close(fd)
    _exit(0)
}

func main(argv: [str]) -> int64 {
    if (len(argv) != 2 and len(argv) != 4) or argv[1].parse_int() is none {
        io.write_stderr("usage: http_fixture PORT [CERT KEY]\n")
        return 2
    }
    let port = argv[1].parse_int()? or 0
    mut p12: bytes? = none
    if len(argv) == 4 {
        let made = pkcs12(argv[2], argv[3])
        if made is Err(e) {
            io.write_stderr(f"http_fixture: {e.to_str()}\n")
            return 1
        }
        p12 = made
    }
    let listener = tcp.listen("127.0.0.1", :port)
    if listener is Err(e) {
        io.write_stderr(f"http_fixture: {e.to_str()}\n")
        return 1
    }
    let state = mmap(0, 4096, PROT_READ_WRITE, MAP_SHARED_ANON, -1, 0)
    // The children hold the reading end; it reads as ended once this
    // process, which alone holds the writing end, has ended.
    let ends = unsafe.alloc(8)
    libc.pipe(ends)
    let server_gone = unsafe.load32(ends)
    let alive = unsafe.load32(ends + 4)
    unsafe.free(ends)
    let deadline = monotonic_ns() + LIFETIME_MS * 1000000
    for true {
        // Children that have ended.
        for unsafe.c_int(libc.waitpid(-1, 0, WNOHANG)) > 0 {
        }
        let left = deadline - monotonic_ns()
        if left <= 0 {
            break
        }
        let ready = posix.poll(read: [Fd(fd: listener.fd)], timeout: Duration(ns: left))
        if ready is Err(_) {
            break
        }
        if not ready.read[0] {
            continue
        }
        let accepted = listener.accept()
        if accepted is Ok(conn) {
            let pid = unsafe.c_int(libc.fork())
            if pid == 0 {
                libc.close(listener.fd)
                libc.close(alive)
                serve(conn.fd, :port, :state, :server_gone, :p12)
            }
            libc.close(conn.fd)
        }
    }
    return 0
}

