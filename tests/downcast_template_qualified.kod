// A downcast to a generic type written through a module is reported as written.
// Checked by tests/compile_errors_test.kod.
import "./downcast_generic_xmod_dep"

func main() -> int64 {
    let s: downcast_generic_xmod_dep.Shape = downcast_generic_xmod_dep.boxed()
    let held = s is downcast_generic_xmod_dep.Box
    if s is downcast_generic_xmod_dep.Box(b) {
        return 1
    }
    match s {
        downcast_generic_xmod_dep.Box(b) -> return 2
        else -> return 0
    }
}

