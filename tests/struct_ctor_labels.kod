// A constructor binds each value to the field its label names, in any
// order, and a field left out takes its default.
type Opts = struct {
    x: int64 = 1
    y: int64 = 2
    z: int64 = 3
}

type Pt = struct {
    x: int64
    y: int64
}

type Two[T] = struct {
    a: T
    b: T
}

type Mixed = struct {
    name: str
    count: int64 = 7
    tags: [str] = []
    on: bool
}

type Log = struct {
    text: str = ""

    func at(self, anon tag: str, anon v: int64) -> int64 {
        self.text = self.text + tag
        return v
    }
}

func show(anon o: Opts) -> none {
    print(f"{o.x} {o.y} {o.z}")
}

func main() -> int64 {
    show(Opts(y: 5))
    show(Opts(z: 9, x: 4))
    show(Opts())
    let p = Pt(y: 2, x: 1)
    print(f"{p.x} {p.y}")
    let t = Two[str](b: "b", a: "a")
    print(f"{t.a}{t.b}")
    let m = Mixed(on: true, name: "m")
    print(f"{m.name} {m.count} {len(m.tags)} {m.on}")
    let l = Log()
    let q = Pt(y: l.at("y", 4), x: l.at("x", 3))
    print(f"{l.text} {q.x} {q.y}")
    return 0
}

// expected output:
// 1 5 3
// 4 2 9
// 1 2 3
// 1 2
// ab
// m 7 0 true
// yx 3 4
