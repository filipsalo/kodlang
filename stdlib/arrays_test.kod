import "arrays"

type Color = enum {
    Red
    Green
}

test "contains: compares by ==, with strs by content" {
    assert arrays.contains([1, 2], 2)
    assert not arrays.contains([1, 2], 3)
    let joined = "a" + "b"
    assert arrays.contains(["ab"], joined)
    assert not arrays.contains(["ab"], "a")
    assert arrays.contains([Color.Red, Color.Green], .Green)
}

test "contains: empty" {
    assert not arrays.contains([], 1)
    let none_here: [str] = []
    assert not arrays.contains(none_here, "a")
}

test "equal: length and elements in order" {
    assert arrays.equal([1, 2], [1, 2])
    assert not arrays.equal([1, 2], [2, 1])
    assert not arrays.equal([1], [1, 2])
    assert arrays.equal(["a"], ["a"])
    let no_strs: [str] = []
    assert arrays.equal(no_strs, [])
}

test "* repeats an array into a new one" {
    let flags = [false] * 4
    assert len(flags) == 4
    for f in flags {
        assert not f
    }
    assert arrays.equal([1, 2] * 3, [1, 2, 1, 2, 1, 2])
    assert len([7] * 0) == 0
    assert len([7] * -2) == 0
    let xs = [3, 4]
    let twice = xs * 2
    assert arrays.equal(twice, [3, 4, 3, 4])
    assert arrays.equal(xs, [3, 4])
    mut grown = [0] * 2
    grown += [1]
    assert arrays.equal(grown, [0, 0, 1])
}

test "* repeats counted elements, sharing them" {
    let words = ["a", "b"] * 3
    assert "".join(words) == "ababab"
    let rows = [[0]] * 2
    rows[0] += [1]
    assert len(rows[1]) == 2
}
