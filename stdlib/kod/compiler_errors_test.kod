    assert test_support.any_message_contains(errs, needle: "`Greet.hi` takes 1 arguments, got 2")
}

test "an indirect call with too few or too many arguments" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func dbl(anon x: int64) -> int64 {
