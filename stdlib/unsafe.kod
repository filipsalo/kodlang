// Raw memory and C strings, for calling C functions that take pointers.
// Nothing here is checked. See docs/unsafe.md.

// Each of these compiles to the instructions it stands for (codegen's
// inline_intrinsic); there is no C function behind them.
extern func kod_unsafe_load8(anon addr: int64) -> int64
extern func kod_unsafe_load32(anon addr: int64) -> int64
extern func kod_unsafe_load64(anon addr: int64) -> int64
extern func kod_unsafe_store8(anon addr: int64, anon value: int64) -> none
extern func kod_unsafe_store32(anon addr: int64, anon value: int64) -> none
extern func kod_unsafe_store64(anon addr: int64, anon value: int64) -> none
extern func kod_unsafe_c_int(anon x: int64) -> int64
// The address of the object a `str` or `bytes` value points at.
extern func kod_unsafe_str_ref(anon s: str) -> int64
extern func kod_unsafe_bytes_ref(anon b: bytes) -> int64

extern func kod_str_from_cstr(anon addr: int64) -> str
extern func kod_unsafe_copy_out(anon addr: int64, anon n: int64) -> bytes
extern func calloc(anon count: int64, anon size: int64) -> int64
extern func memcpy(anon dst: int64, anon src: int64, anon n: int64) -> int64
extern func __error() -> int64

// Give back what `alloc` returned; 0 does nothing.
extern func free(anon addr: int64) -> none

// `size` bytes of zeroed memory, from C's heap.
func alloc(anon size: int64) -> int64 {
    let addr = calloc(1, size)
    if addr == 0 and size > 0 {
        panic(f"unsafe.alloc: out of memory for {size} bytes")
    }
    return addr
}

// The byte at `addr`, 0 to 255.
func load8(anon addr: int64) -> int64 {
    return kod_unsafe_load8(addr)
}

// The 4 bytes at `addr`, as a signed C int.
func load32(anon addr: int64) -> int64 {
    return kod_unsafe_load32(addr)
}

func load64(anon addr: int64) -> int64 {
    return kod_unsafe_load64(addr)
}

func store8(anon addr: int64, anon value: int64) -> none {
    kod_unsafe_store8(addr, value)
}

func store32(anon addr: int64, anon value: int64) -> none {
    kod_unsafe_store32(addr, value)
}

func store64(anon addr: int64, anon value: int64) -> none {
    kod_unsafe_store64(addr, value)
}

// The low 4 bytes of `x`, as a signed C int: what a C function returning
// `int` meant.
func c_int(anon x: int64) -> int64 {
    return kod_unsafe_c_int(x)
}

// The bytes of `s` with a 0 byte after them, for as long as `s` lives.
func c_str(anon s: str) -> int64 {
    return kod_unsafe_load64(kod_unsafe_str_ref(s))
}

// The bytes of `b`, for as long as `b` lives.
func data(anon b: bytes) -> int64 {
    return kod_unsafe_load64(kod_unsafe_bytes_ref(b))
}

// A copy of the C string at `addr`, up to its 0 byte.
func str_at(anon addr: int64) -> str {
    return kod_str_from_cstr(addr)
}

// A copy of the `n` bytes at `addr`.
func copy_out(anon addr: int64, anon n: int64) -> bytes {
    return kod_unsafe_copy_out(addr, n)
}

// Write the bytes of `data` at `addr`.
func copy_in(anon addr: int64, anon data: bytes) -> none {
    if len(data) > 0 {
        memcpy(addr, data(data), len(data))
    }
}

// C's errno for this thread.
func errno() -> int64 {
    return kod_unsafe_load32(__error())
}

// The address of the top-level function `f`, for C to call back: write the
// function's name, as `unsafe.c_function(compare)`. Its parameters and result
// are int64 or bool. The compiler handles a call to this itself (codegen's
// compile_c_function); the body is never run. See docs/unsafe.md.
func c_function(anon f: int64) -> int64 {
    return f
}
