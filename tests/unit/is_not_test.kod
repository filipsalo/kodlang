// `is not Pat` — the negated `is`. Reads as one operator; works
// anywhere `is Pat` does (expression context + `if … is` form).

test "is not as an expression" {
    let a: int64? = none
    let b: int64? = 42
    let a_has: bool = a is not none
    let b_has: bool = b is not none
    assert a_has == false
    assert b_has == true
}

test "if is not runs the body when the pattern doesn't match" {
    let a: int64? = none
    let b: int64? = 42
    mut ran: [str] = []
    if a is not none {
        fail("a is not none unexpectedly")
    } else {
        ran += ["a is none branch"]
    }
    if b is not none {
        ran += ["b is not none branch"]
    } else {
        fail("b unexpectedly none")
    }
    assert ran == ["a is none branch", "b is not none branch"]
}
