func die(anon msg: str) -> none {
    panic(msg)
}

func visits() -> int64 {
    let w = Walker()
    w.on0()
    f0(3)
    return w.visits
}

func pick(anon o: int64?) -> int64 {
    let v = o? or die("no value")
    return v
}

func main() -> int64 {
    print_int(visits())
    print_int(pick(5))
    return 0
}

// expected output:
// 5
// 5
