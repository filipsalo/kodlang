// A helper that ends in a call through one of its locals.
type Reporter = struct {
    tag: str

    func fail(self, anon msg: str) -> none {
        kod_panic(f"{self.tag}: {msg}")
    }
}

func die(anon msg: str) -> none {
    let r = Reporter(tag: "die")
    r.fail(msg)
}

func die_typed(anon msg: str) -> none {
    let r: Reporter = Reporter(tag: "typed")
    r.fail(msg)
}

func die_int_local(anon msg: str) -> none {
    let kod_panic: int64 = 5
    print_int(kod_panic)
    kod_panic(msg)
}

func pick(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    die("negative")
}

func pick_typed(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    die_typed("negative")
}

func pick_int(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    die_int_local("negative")
}

func main() -> int64 {
    print_int(pick(1) + pick_typed(2) + pick_int(3))
    print_int(pick(-1))
    return 0
}

// expected output:
// 6
// expected status:
// 1
// expected stderr:
// panic: die: negative
