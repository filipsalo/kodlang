// `%` by zero panics like `/`, also with a literal zero.
import "testing"

test "% by a literal zero panics" {
    let n = 7
    assert n % 3 == 1
    let r = testing.run(func() {
        print_int(n % 0)
        print("not reached")
    })
    assert r.status == 1
    assert r.stdout == ""
    assert r.stderr.contains("panic: integer division by zero")
}
