// Regression: `arr[i] = SomeStruct(...)` used to clobber the index
// register across the constructor's `_rc_alloc` call, so the write
// landed at a random offset inside the array buf. Each slot should
// receive the value computed from its own loop index, not some other.

type Box = shared struct { x: int64 }

test "each slot gets the struct built from its own index" {
    mut arr: [Box] = [Box(x: 0), Box(x: 0), Box(x: 0)]
    mut i: int64 = 0
    for i < 3 {
        arr[i] = Box(x: i * 100 + 7)
        i = i + 1
    }
    assert arr[0].x == 7
    assert arr[1].x == 107
    assert arr[2].x == 207
}
