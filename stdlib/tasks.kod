// kod:cc tasks.c

// Tasks: calls that run on stacks of their own and take turns on the one
// thread (docs/tasks.md). The stacks and the switch are in tasks.c; which
// task runs next is decided here.

extern func kod_task_stack_new() -> int64
extern func kod_task_stack_free(anon base: int64) -> none
extern func kod_task_ctx_new() -> int64
extern func kod_task_ctx_free(anon ctx: int64) -> none
extern func kod_task_ctx_init(anon ctx: int64, anon base: int64) -> none
extern func kod_task_switch(anon from: int64, anon to: int64) -> none

// What a task runs: its Task, whatever its result's type.
interface Job {
    func run(self) -> none
}

// A task as the scheduler sees it: its saved registers, its stack (0 for the
// program's first one, which has the thread's own), what it runs, and the
// tasks waiting for it to end.
type Fiber = shared struct {
    ctx: int64
    stack: int64 = 0
    job: Job? = none
    done: bool = false
    waiters: [Fiber] = []
}

// The task that is running, made for the program's first one when first
// asked for.
mut _current: Fiber? = none

// Tasks ready to run, from `_head` on, in the order they became ready.
mut _ready: [Fiber] = []
mut _head: int64 = 0

// Tasks that have ended, whose stacks the next task to run frees.
mut _dead: [Fiber] = []

// The registers of the switch a task that ends makes: no reference stays in
// its frame, which never returns.
mut _leave_from: int64 = 0
mut _leave_to: int64 = 0

// A task started by `start`, and what it gave back once it has ended.
type Task[T] = shared struct {
    fiber: Fiber
    body: func() -> T
    // Empty until the task ends; then what it gave back.
    results: [T] = []

    func run(self) -> none {
        self.results = [self.body()]
    }

    // What the task gave back; until it has ended, this task waits for it.
    func wait(self) -> T {
        if not self.fiber.done {
            _wait_for(self.fiber)
        }
        return self.results[0]
    }
}

// Runs `body` as a new task, which first runs the next time this one waits
// or gives way. `spawn` calls it with the group of the function it is in
// (none for `spawn detached`).
func start[T](anon body: func() -> T, group: TaskGroup? = none) -> Task[T] {
    let fiber = _new_fiber()
    let task = Task[T](:fiber, :body)
    fiber.job = task
    _join(fiber, :group)
    _make_ready(fiber)
    return task
}

// A task started by `start_none`, whose body gives back nothing (`none` can't
// be a type argument, so it isn't a `Task[none]`).
type NoneTask = shared struct {
    fiber: Fiber
    body: func() -> none

    func run(self) -> none {
        self.body()
    }

    // Until the task has ended, this task waits for it.
    func wait(self) -> none {
        if not self.fiber.done {
            _wait_for(self.fiber)
        }
    }
}

// As `start`, for a body that gives back nothing.
func start_none(anon body: func() -> none, group: TaskGroup? = none) -> NoneTask {
    let fiber = _new_fiber()
    let task = NoneTask(:fiber, :body)
    fiber.job = task
    _join(fiber, :group)
    _make_ready(fiber)
    return task
}

// The tasks a function has started with `spawn`: codegen keeps the group in a
// hidden local (`#group`), made by the first `spawn` that runs, and waits for
// it where the function returns.
type TaskGroup = shared struct {
    fibers: [Fiber] = []
}

// `group`, or a new one when there is none yet. Optional both ways, as the
// hidden local that holds it is, which is none until the first `spawn` runs.
func group_of(anon group: TaskGroup?) -> TaskGroup? {
    if group is none {
        return TaskGroup()
    }
    return group
}

// Waits for each task in `group` that hasn't ended.
func wait_group(anon group: TaskGroup?) -> none {
    let g = group? or TaskGroup()
    for fiber in g.fibers {
        if not fiber.done {
            _wait_for(fiber)
        }
    }
    g.fibers = []
}

func _join(anon fiber: Fiber, group: TaskGroup?) -> none {
    if group is TaskGroup(g) {
        g.fibers += [fiber]
    }
}

// Lets the tasks that are ready run, then goes on.
func give_way() -> none {
    if _head == len(_ready) {
        return
    }
    let me = _running()
    _make_ready(me)
    _switch_from(me)
}

func _new_fiber() -> Fiber {
    let stack = kod_task_stack_new()
    if stack == 0 {
        panic("tasks: no room for another task's stack")
    }
    let fiber = Fiber(ctx: kod_task_ctx_new(), :stack)
    kod_task_ctx_init(fiber.ctx, stack)
    return fiber
}

func _running() -> Fiber {
    if _current is none {
        _current = Fiber(ctx: kod_task_ctx_new())
    }
    return must _current
}

func _make_ready(anon fiber: Fiber) -> none {
    _ready += [fiber]
}

// The next ready task, taken off the queue; when there is none, every task
// waits for another, and none can go on.
func _take_next() -> Fiber {
    if _head == len(_ready) {
        panic("all tasks are asleep: deadlock")
    }
    let next = _ready[_head]
    _head += 1
    // Drop what has been taken once it is most of the queue.
    if _head >= 64 and _head * 2 >= len(_ready) {
        _ready = _ready[_head..len(_ready)]
        _head = 0
    }
    return next
}

// Switches from `me`, the running task, to the next ready one, and comes
// back here when `me` runs again.
func _switch_from(anon me: Fiber) -> none {
    let next = _take_next()
    _current = next
    kod_task_switch(me.ctx, next.ctx)
    _reap()
}

// Frees the stacks of tasks that have ended; none of them is running.
func _reap() -> none {
    if len(_dead) == 0 {
        return
    }
    for fiber in _dead {
        kod_task_stack_free(fiber.stack)
        kod_task_ctx_free(fiber.ctx)
    }
    _dead = []
}

// Waits, as the running task, for `fiber` to end.
func _wait_for(anon fiber: Fiber) -> none {
    let me = _running()
    fiber.waiters += [me]
    _switch_from(me)
}

// A new task's first turn (tasks.c calls it on the task's stack): runs it,
// readies those waiting for it, and switches away for good.
func _run_current() -> none {
    _reap()
    _finish()
    kod_task_switch(_leave_from, _leave_to)
}

func _finish() -> none {
    let fiber = must _current
    let job = must fiber.job
    // The Task holds the Fiber; the Fiber lets go of the Task, so neither
    // keeps the other.
    fiber.job = none
    job.run()
    fiber.done = true
    for waiter in fiber.waiters {
        _make_ready(waiter)
    }
    fiber.waiters = []
    _dead += [fiber]
    let next = _take_next()
    _current = next
    _leave_from = fiber.ctx
    _leave_to = next.ctx
}

// Carries values from tasks that send to tasks that receive, in order
// (docs/tasks.md). A sender adds its value and then waits until at most
// `capacity` of the values sent up to its own are still to be received: with
// 0, until its own is.
type Channel[T] = shared struct {
    capacity: int64 = 0
    // Sent and not received: `items` from `head` on.
    items: [T] = []
    head: int64 = 0
    sent: int64 = 0
    taken: int64 = 0
    closed: bool = false
    // Tasks waiting to receive, and to have what they sent received.
    receivers: [Fiber] = []
    senders: [Fiber] = []

    func send(self, anon value: T) -> none {
        if self.closed {
            panic("send on a closed channel")
        }
        self.items += [value]
        self.sent += 1
        let ticket = self.sent
        self.receivers = _wake_all(self.receivers)
        for self.taken < ticket - self.capacity {
            if self.closed {
                panic("send on a closed channel")
            }
            self.senders += [_running()]
            _park()
        }
    }

    // The next value, once there is one; none once the channel is closed and
    // every value has been received.
    func receive(self) -> T? {
        if self.has_next() {
            return self.take()
        }
        return none
    }

    // Waits until a value can be received, or the channel is closed and empty;
    // whether one can. `for v in ch` is `has_next` and `take`: nothing runs
    // between them, since a task gives way only where it waits.
    func has_next(self) -> bool {
        for self.head == len(self.items) and not self.closed {
            self.receivers += [_running()]
            _park()
        }
        return self.head < len(self.items)
    }

    // The next value, which `has_next` said is there.
    func take(self) -> T {
        let value = self.items[self.head]
        self.head += 1
        self.taken += 1
        if self.head >= 64 and self.head * 2 >= len(self.items) {
            self.items = self.items[self.head..len(self.items)]
            self.head = 0
        }
        self.senders = _wake_all(self.senders)
        return value
    }

    func close(self) -> none {
        if self.closed {
            panic("close of a closed channel")
        }
        self.closed = true
        self.receivers = _wake_all(self.receivers)
        self.senders = _wake_all(self.senders)
    }
}

// Makes each of `fibers` ready; gives back the empty list to keep.
func _wake_all(anon fibers: [Fiber]) -> [Fiber] {
    for fiber in fibers {
        _make_ready(fiber)
    }
    return []
}

// Waits, as the running task, until something makes it ready again.
func _park() -> none {
    _switch_from(_running())
}
