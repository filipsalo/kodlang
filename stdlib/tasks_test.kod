import "stream" { IoError }
import "tasks"
import "testing"

mut trace: [str] = []

func note(anon what: str) -> none {
    trace += [what]
}

func double(anon n: int64) -> int64 {
    return n * 2
}

func greet(anon name: str) -> str {
    return f"hi {name}"
}

test "a spawned call's result comes back through wait" {
    let a = spawn double(21)
    let b = spawn greet("kod")
    assert a.wait() == 42
    assert b.wait() == "hi kod"
    // A result can be waited for again.
    assert a.wait() == 42
}

func count(anon xs: [str]) -> int64 {
    return len(xs)
}

test "the arguments are evaluated where spawn is" {
    mut x: int64 = 5
    let t = spawn double(x)
    x = 100
    assert t.wait() == 10
    mut names = ["a"]
    let n = spawn count(names)
    names += ["b"]
    assert n.wait() == 1
}

func step(anon name: str) -> none {
    note(f"{name}1")
    tasks.give_way()
    note(f"{name}2")
}

test "tasks run when the spawning one waits or gives way, in the order they became ready" {
    trace = []
    spawn step("a")
    spawn step("b")
    note("main")
    tasks.give_way()
    note("main again")
    tasks.give_way()
    assert trace == ["main", "a1", "b1", "main again", "a2", "b2"]
}

test "give_way with nothing else ready goes straight on" {
    tasks.give_way()
    tasks.give_way()
}

func start_two() -> none {
    spawn step("x")
    spawn step("y")
    note("started")
}

test "a function returns only once the tasks it spawned have ended" {
    trace = []
    start_two()
    note("returned")
    assert trace == ["started", "x1", "y1", "x2", "y2", "returned"]
}

func early(anon stop: bool) -> int64 {
    spawn step("e")
    if stop {
        return 1
    }
    return 2
}

func fails() -> int64 or Error {
    spawn step("f")
    throw IoError(kind: .InvalidInput, op: "fails", errno: 0, detail: "no")
}

test "an early return or an error still waits for the tasks" {
    trace = []
    assert early(true) == 1
    assert trace == ["e1", "e2"]
    trace = []
    assert fails() is Err(_)
    assert trace == ["f1", "f2"]
}

func spawn_detached() -> none {
    spawn detached step("d")
}

test "a detached task outlives the function that spawned it" {
    trace = []
    spawn_detached()
    note("returned")
    tasks.give_way()
    tasks.give_way()
    assert trace == ["returned", "d1", "d2"]
}

func loops(anon n: int64) -> none {
    for i in 0..n {
        spawn step(f"l{i}")
    }
}

test "every task a loop spawned is waited for at the end" {
    trace = []
    loops(3)
    assert len(trace) == 6
}

type Counter = shared struct {
    n: int64 = 0

    func add(self, anon k: int64) -> int64 {
        self.n += k
        return self.n
    }
}

func labelled(anon a: int64, b: int64, c: int64 = 100) -> int64 {
    return a + b + c
}

test "methods, labelled arguments and function values can be spawned" {
    let counter = Counter()
    let first = spawn counter.add(2)
    let second = spawn counter.add(3)
    assert first.wait() + second.wait() == 7
    assert counter.n == 5
    assert (spawn labelled(1, b: 2)).wait() == 103
    assert (spawn labelled(1, b: 2, c: 3)).wait() == 6
    let f = func(anon n: int64) -> int64 { return n + 1 }
    assert (spawn f(1)).wait() == 2
}

func sum_of_two() -> int64 {
    let a = spawn double(10)
    let b = spawn double(11)
    return a.wait() + b.wait()
}

test "a task can spawn tasks and wait for them" {
    assert (spawn sum_of_two()).wait() == 42
}

func slow() -> int64 {
    tasks.give_way()
    tasks.give_way()
    return 7
}

func times(anon t: tasks.Task[int64], by: int64) -> int64 {
    return t.wait() * by
}

test "several tasks can wait for one" {
    let s = spawn slow()
    let x = spawn times(s, by: 2)
    let y = spawn times(s, by: 3)
    assert x.wait() + y.wait() == 35
}

func echo(anon i: int64) -> int64 {
    tasks.give_way()
    return i
}

test "thousands of tasks" {
    mut all: [tasks.Task[int64]] = []
    for i in 0..5000 {
        all += [spawn echo(i)]
    }
    mut sum: int64 = 0
    for t in all {
        sum += t.wait()
    }
    assert sum == 5000 * 4999 / 2
}

func depth(anon n: int64) -> int64 {
    if n == 0 {
        return 0
    }
    return 1 + depth(n - 1)
}

test "a task's stack takes deep recursion" {
    assert (spawn depth(100000)).wait() == 100000
}

mut _self_task: tasks.Task[int64]? = none

// Waits for itself, once main has kept its handle.
func wait_self() -> int64 {
    tasks.give_way()
    return (must _self_task).wait()
}

test "waiting for a task that can't end is a deadlock" {
    let r = testing.run(func() {
        let t = spawn wait_self()
        _self_task = t
        print(t.wait())
    })
    assert r.status == 1
    assert r.stderr.contains("panic: all tasks are asleep: deadlock")
}

func boom() -> int64 {
    panic("in the task")
    return 0
}

func spawn_boom() -> int64 {
    return (spawn boom()).wait()
}

func spawn_spawn_boom() -> int64 {
    return (spawn spawn_boom()).wait()
}

test "a panic in a task stops the program, with where the task was spawned" {
    let r = testing.run(func() {
        print(spawn_spawn_boom())
    })
    assert r.status == 1
    assert r.stderr.contains("panic: in the task")
    // The task's own calls, then where it and the task that spawned it were.
    let parts = r.stderr.split("spawned at:\n")
    assert len(parts) == 3
    assert not parts[0].contains("_run_current")
    assert parts[1].starts_with("  #0  spawn_boom (stdlib/tasks_test.kod:")
    assert parts[2].starts_with("  #0  spawn_spawn_boom (stdlib/tasks_test.kod:")
}

func produce(anon out: tasks.Channel[int64], anon n: int64) -> none {
    for i in 0..n {
        out.send(i)
    }
    out.close()
}

test "for v in ch receives each value until the channel is closed" {
    let ch = tasks.Channel[int64]()
    spawn produce(ch, 5)
    mut got: [int64] = []
    for v in ch {
        got += [v]
    }
    assert got == [0, 1, 2, 3, 4]
    assert ch.receive() is none
}

func send_noting(anon ch: tasks.Channel[str], anon values: [str]) -> none {
    for v in values {
        ch.send(v)
        note(f"sent {v}")
    }
}

test "an unbuffered send waits for its receive" {
    trace = []
    let ch = tasks.Channel[str]()
    spawn send_noting(ch, ["a", "b"])
    tasks.give_way()
    note("receiving")
    note(f"got {must ch.receive()}")
    note(f"got {must ch.receive()}")
    tasks.give_way()
    assert trace == ["receiving", "got a", "sent a", "got b", "sent b"]
}

test "a buffered send waits only when the channel is full" {
    trace = []
    let ch = tasks.Channel[str](capacity: 2)
    spawn send_noting(ch, ["a", "b", "c"])
    tasks.give_way()
    // Two fit; the third waits for a receive.
    assert trace == ["sent a", "sent b"]
    assert must ch.receive() == "a"
    tasks.give_way()
    assert trace == ["sent a", "sent b", "sent c"]
    assert must ch.receive() == "b"
    assert must ch.receive() == "c"
}

func worker(anon jobs: tasks.Channel[int64], results: tasks.Channel[int64]) -> none {
    for j in jobs {
        results.send(j * j)
    }
}

test "several tasks can send to and receive from one channel" {
    let jobs = tasks.Channel[int64](capacity: 4)
    let results = tasks.Channel[int64](capacity: 100)
    spawn worker(jobs, :results)
    spawn worker(jobs, :results)
    spawn worker(jobs, :results)
    for i in 1..11 {
        jobs.send(i)
    }
    jobs.close()
    mut sum: int64 = 0
    for _ in 0..10 {
        sum += must results.receive()
    }
    assert sum == 385
}

test "a closed channel gives its values, then none" {
    let ch = tasks.Channel[str](capacity: 3)
    ch.send("x")
    ch.send("y")
    ch.close()
    assert must ch.receive() == "x"
    assert must ch.receive() == "y"
    assert ch.receive() is none
    assert ch.receive() is none
}

test "sending on a closed channel panics, and so does closing one twice" {
    let send = testing.run(func() {
        let ch = tasks.Channel[int64](capacity: 1)
        ch.close()
        ch.send(1)
    })
    assert send.status == 1
    assert send.stderr.contains("panic: send on a closed channel")
    let twice = testing.run(func() {
        let ch = tasks.Channel[int64]()
        ch.close()
        ch.close()
    })
    assert twice.status == 1
    assert twice.stderr.contains("panic: close of a closed channel")
}

test "receiving from a channel nothing will send to is a deadlock" {
    let r = testing.run(func() {
        let ch = tasks.Channel[int64]()
        print(ch.receive() is none)
    })
    assert r.status == 1
    assert r.stderr.contains("panic: all tasks are asleep: deadlock")
}

func countdown(anon n: int64) -> tasks.Channel[int64] {
    for i in 0..n {
        yield n - i
    }
}

test "a function with yield gives a channel its body sends on" {
    mut got: [int64] = []
    for k in countdown(3) {
        got += [k]
    }
    assert got == [3, 2, 1]
    let empty = countdown(0)
    assert empty.receive() is none
}

type Words = struct {
    text: str

    func each(self) -> tasks.Channel[str] {
        for w in self.text.split(" ") {
            if w == "stop" {
                return
            }
            yield w
        }
    }
}

test "a method can yield, and a return ends it" {
    mut got: [str] = []
    for w in Words(text: "a b stop c").each() {
        got += [w]
    }
    assert got == ["a", "b"]
}

func noting(anon n: int64) -> tasks.Channel[int64] {
    for i in 0..n {
        note(f"yield {i}")
        yield i
    }
    note("end")
}

test "a generator runs only as far ahead as its reader" {
    trace = []
    let g = noting(3)
    assert trace == []
    assert must g.receive() == 0
    note("got 0")
    assert must g.receive() == 1
    note("got 1")
    assert must g.receive() == 2
    assert g.receive() is none
    assert trace == ["yield 0", "got 0", "yield 1", "got 1", "yield 2", "end"]
}

func evens(anon xs: tasks.Channel[int64]) -> tasks.Channel[int64] {
    for x in xs {
        if x % 2 == 0 {
            yield x
        }
    }
}

test "generators chain" {
    mut got: [int64] = []
    for x in evens(countdown(6)) {
        got += [x]
    }
    assert got == [6, 4, 2]
}

// Something a generator's body holds, to see when the body has ended.
type Token = shared struct {
    n: int64 = 0
}

type Watch = shared struct {
    weak token: Token?
}

func counting(anon t: Token) -> tasks.Channel[int64] {
    for true {
        t.n += 1
        yield t.n
    }
}

// Reads the first value, then lets the body send the next before stopping:
// the body is left waiting for it to be received.
func first_one(anon w: Watch) -> int64 {
    let t = Token()
    w.token = t
    mut first: int64 = 0
    for k in counting(t) {
        first = k
        tasks.give_way()
        break
    }
    return first
}

test "a generator's body ends once nothing holds its channel" {
    let w = Watch()
    assert first_one(w) == 1
    // Its body waits in a `yield`; the next generator to start wakes it.
    tasks.give_way()
    assert w.token is Token(_)
    for _ in countdown(1) {
    }
    tasks.give_way()
    assert w.token is none
}

func passed_on() -> tasks.Channel[int64] {
    return countdown(3)
}

test "a generator's channel can be handed on" {
    mut got: [int64] = []
    for k in passed_on() {
        got += [k]
    }
    assert got == [3, 2, 1]
}

extern func rc_live_bytes() -> int64

func tiny(anon n: int64) -> int64 {
    return n + 1
}

func spawns_many(anon n: int64) -> int64 {
    for i in 0..n {
        spawn tiny(i)
        tasks.give_way()
    }
    return rc_live_bytes()
}

test "a function that keeps spawning keeps only the tasks that run" {
    let warm = spawns_many(5000)
    let few = spawns_many(1000)
    let many = spawns_many(50000)
    assert warm > 0
    assert many - few < 50000
}

func receive_then_close(anon ch: tasks.Channel[int64]) -> bool {
    let got = ch.receive()
    ch.close()
    return got is none
}

test "a cancelled task closes the channel it waited on, and ends" {
    let ch = tasks.Channel[int64]()
    let t = spawn receive_then_close(ch)
    tasks.give_way()
    t.cancel()
    assert t.wait()
    assert ch.closed
    // The task isn't run again.
    for _i in 0..5 {
        tasks.give_way()
    }
}
