// `not` negates a bool: looser than comparisons and `is`, tighter than `and` and `or`.

type Color = enum {
    Red
    Blue
}

func yes() -> bool {
    return true
}

func main() -> int64 {
    let a = true
    let b = false
    let c: Color = .Red
    let o: int64? = 3
    print(f"{not a}")
    print(f"{not b and a}")
    print(f"{not a or a}")
    print(f"{not 1 == 2}")
    print(f"{not 1 < 2 < 3}")
    print(f"{not c is .Blue}")
    print(f"{not (a and b)}")
    print(f"{not not a}")
    print(f"{not yes()}")
    print(f"{a == not b}")
    if not a {
        print("bad")
    } else if not b {
        print("else if")
    }
    if not b and o is Some(v) and not v == 4 {
        print(f"chain {v}")
    }
    let ok = not c is .Red
    print(f"{ok}")
    mut i = 0
    for not i == 2 {
        i += 1
    }
    print_int(i)
    return 0
}

// expected output:
// false
// true
// true
// true
// false
// true
// true
// true
// false
// true
// else if
// chain 3
// false
// 2
