// Slice 2 of first-class functions: anonymous function expressions.
// `func(params) -> R { body }` is a value, callable directly or
// passable as an argument. tests/closures.kod has the ones that capture.

func apply(anon f: func(int64) -> int64, anon x: int64) -> int64 {
    return f(x)
}

test "a lambda bound to a name" {
    let dbl: func(int64) -> int64 = func(x: int64) -> int64 { return x * 2 }
    assert dbl(21) == 42
}

test "a lambda passed as an argument" {
    assert apply(func(n: int64) -> int64 { return n + 100 }, 5) == 105
}

test "an array of lambdas" {
    // Multi-line form exercises the EOL-skipping inside `[...]`.
    let ops: [func(int64) -> int64] = [
        func(x: int64) -> int64 { return x + 1 },
        func(x: int64) -> int64 { return x * x },
    ]
    mut out: [int64] = []
    for f in ops {
        out += [f(4)]
    }
    assert out == [5, 16]
}
