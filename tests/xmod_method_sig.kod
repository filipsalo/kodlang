// Method and interface sigs in an imported module whose return type comes
// from a module that is only imported transitively.
import "./xmod_method_sig_a"

func via_iface(anon g: xmod_method_sig_a.Getter) -> none {
    let w = g.get()
    print(w.s)
}

func main() -> int64 {
    let v: xmod_method_sig_a.A = xmod_method_sig_a.A(s: "from b")
    let w = v.get()
    print(w.s)
    via_iface(v)
    return 0
}

// expected output:
// from b
// from b
// expected status:
// 0
