// A function returning an optional, matched by the caller.
func maybe(anon x: int64) -> int64? {
    if x > 0 {
        return x
    }
    return none
}

test "returning a value or none as an optional" {
    let a: int64? = maybe(5)
    match a {
        none -> fail("a is none")
        Some(v) -> assert v == 5
    }
    let b: int64? = maybe(-1)
    match b {
        none -> {}
        Some(v) -> fail(f"b is {v}")
    }
}
