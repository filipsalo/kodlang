type Dir = enum {
    North
    South
}

func name(anon n: int64) -> str {
    match n { 1 -> return "one" 2 -> return "two" else -> return "many" }
}

func main() -> int64 {
    let d: Dir = .North
    match d { .North -> print("north") else none }
    match d { .South -> print("south") else -> print("not south") }
    print(name(1))
    print(name(2))
    print(name(7))
    return 0
}

// expected output:
// north
// not south
// one
// two
// many
