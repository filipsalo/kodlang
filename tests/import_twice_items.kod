// A module may be imported more than once, with its item list split over
// the imports; every listed name is seen, and the module's name still works.
import "./item_import_type_dep" { Vec2 }
import "./item_import_type_dep" { Box, dot }

type IntBox = Box[int64]

func main() -> int64 {
    let v: Vec2 = Vec2(x: 3, y: 4)
    print_int(dot(v, v))
    let b: IntBox = IntBox(v: 7)
    print_int(b.get())
    let w: item_import_type_dep.Vec2 = item_import_type_dep.Vec2(x: 1, y: 2)
    print_int(item_import_type_dep.dot(w, w))
    return 0
}

// expected output:
// 25
// 7
// 5
