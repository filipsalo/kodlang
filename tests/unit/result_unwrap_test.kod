// `?` on a `T or Error`: `r? or default`, `r?.field` and `r?.method()`.

type Oops = shared struct {
    code: int64

    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

mut notes: [str] = []

type User = shared struct {
    name: str
    nick: str?

    func greet(self, excited: bool = false) -> str {
        if excited {
            return f"hi {self.name}!"
        }
        return f"hi {self.name}"
    }

    func note(self) -> none {
        notes += [f"noted {self.name}"]
    }
}

func half(anon n: int64) -> int64 or Error {
    if n % 2 != 0 {
        throw Oops(code: n)
    }
    return n / 2
}

func load(anon id: int64) -> User or Error {
    if id < 0 {
        throw Oops(code: id)
    }
    if id == 0 {
        return User(name: "root", nick: "r")
    }
    return User(name: f"user{id}", nick: none)
}

func maybe(anon n: int64) -> int64? or Error {
    if n < 0 {
        throw Oops(code: n)
    }
    if n == 0 {
        return none
    }
    return n
}

func count(anon xs: [int64]) -> int64 {
    mut total = 0
    for x in xs {
        total += half(x)? or 100
    }
    return total
}

test "r? or default" {
    let a = half(4)? or -1
    let b = half(3)? or -1
    assert a == 2
    assert b == -1
    assert count([2, 3, 4]) == 103
}

test "r?.field and r?.method()" {
    let n1 = load(1)?.name? or "?"
    let n2 = load(-1)?.name? or "?"
    let k1 = load(0)?.nick? or "-"
    let k2 = load(5)?.nick? or "-"
    let g1 = load(2)?.greet(excited: true)? or "nobody"
    let g2 = load(-2)?.greet()? or "nobody"
    assert n1 == "user1"
    assert n2 == "?"
    assert k1 == "r"
    assert k2 == "-"
    assert g1 == "hi user2!"
    assert g2 == "nobody"
    load(3)?.note()
    load(-3)?.note()
    assert notes == ["noted user3"]
}

test "an optional result and a parenthesised default" {
    let m1 = maybe(7)? or 0
    let m2 = maybe(0)? or 0
    let m3 = maybe(-7)? or 0
    assert m1 == 7
    assert m2 == 0
    assert m3 == 0

    let r: int64 or Error = 12
    let doubled = (r? or 0) * 2
    assert doubled == 24
}
