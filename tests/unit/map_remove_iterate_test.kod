// A Map's entries stay in the order their keys were first set; `remove` takes
// one out (a removed key that is set again goes last); `for k in m` and
// `for k, v in m` go over the entries the map had when the loop started.

func joined(anon m: Map[str, int64]) -> str {
    mut parts: [str] = []
    for k, v in m {
        parts += [f"{k}={v}"]
    }
    return " ".join(parts)
}

mut made: int64 = 0

func make() -> Map[str, int64] {
    made += 1
    mut m = Map[str, int64]()
    m.set("x", 1)
    m.set("y", 2)
    return m
}

test "remove, set again, snapshots and a loop over a changing map" {
    mut m = Map[str, int64]()
    m.set("a", 1)
    m.set("b", 2)
    m.set("c", 3)
    m.set("d", 4)
    assert joined(m) == "a=1 b=2 c=3 d=4"
    // remove gives the value, or none for a key that isn't there.
    assert (m.remove("b")? or -1) == 2
    assert (m.remove("b")? or -1) == -1
    assert (m.remove("zz")? or -1) == -1
    assert len(m) == 3
    assert m.contains("b") == false
    assert (m.get("c")? or -1) == 3
    assert (m["d"]? or -1) == 4
    assert joined(m) == "a=1 c=3 d=4"
    // Setting again keeps the place; set after removal goes last.
    m.set("a", 10)
    m.set("b", 20)
    assert joined(m) == "a=10 c=3 d=4 b=20"

    // keys() and values() are snapshots.
    let ks = m.keys()
    let vs = m.values()
    m.set("e", 5)
    assert ks == ["a", "c", "d", "b"]
    assert len(vs) == 4
    assert vs[0] == 10
    assert len(m) == 5

    // The loop goes over the entries it started with.
    mut seen: [str] = []
    for k in m {
        seen += [k]
        m.remove(k)
        m.set(k + k, 0)
    }
    assert seen == ["a", "c", "d", "b", "e"]
    assert joined(m) == "aa=0 cc=0 dd=0 bb=0 ee=0"
}

test "break and continue" {
    mut picked: [str] = []
    for k, v in make() {
        if v == 1 {
            continue
        }
        picked += [k]
        break
    }
    assert picked == ["y"]
    assert made == 1
}

test "many removals" {
    // Lookups and order still hold after compaction.
    mut big = Map[int64, int64]()
    for i in 0..1000 {
        big.set(i, i * i)
    }
    for i in 0..1000 {
        if i % 10 != 0 {
            big.remove(i)
        }
    }
    mut sum: int64 = 0
    mut last: int64 = -1
    mut ordered = true
    for k, v in big {
        sum += v
        if k <= last {
            ordered = false
        }
        last = k
    }
    assert len(big) == 100
    assert sum == 32835000
    assert ordered == true
    assert (big.get(990)? or -1) == 980100
    assert (big.get(991)? or -1) == -1
    for i in 0..1000 {
        big.remove(i)
    }
    big.set(7, 49)
    assert len(big) == 1
    assert big.keys()[0] == 7
    assert (big.get(7)? or -1) == 49
}

test "nested loops over a map of arrays" {
    mut groups = Map[str, [int64]]()
    groups.set("odd", [1, 3])
    groups.set("even", [2, 4, 6])
    mut out: [str] = []
    for name, xs in groups {
        mut total: int64 = 0
        for x in xs {
            total += x
        }
        for k in groups {
            if k == name {
                out += [f"{name} {total}"]
            }
        }
    }
    assert out == ["odd 4", "even 12"]
}

test "bytes of a str or a bytes value" {
    mut spaces: int64 = 0
    for b in "a b c" {
        if b == ' ' {
            spaces += 1
        }
    }
    mut positions: [int64] = []
    for i, b in "héllo" {
        if b > 127 {
            positions += [i]
        }
    }
    mut total: int64 = 0
    for b in kod_bytes_from_array([1, 2, 250]) {
        total += b
    }
    mut empty_runs: int64 = 0
    for _b in "" {
        empty_runs += 1
    }
    for _k in Map[str, int64]() {
        empty_runs += 1
    }
    assert spaces == 2
    assert positions[0] == 1
    assert positions[1] == 2
    assert total == 253
    assert empty_runs == 0
}
