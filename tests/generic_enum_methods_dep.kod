// A generic enum with methods, used by generic_enum_methods.kod.

type Tree[T] = enum {
    Leaf(value: T)
    Node(left: Tree[T], right: Tree[T])

    func count(self) -> int64 {
        return match self {
            .Leaf -> 1
            .Node(left, right) -> left.count() + right.count()
        }
    }

    func first(self) -> T {
        return match self {
            .Leaf(value) -> value
            .Node(left, _right) -> left.first()
        }
    }
}

func pair[T](anon a: T, anon b: T) -> Tree[T] {
    return .Node(left: .Leaf(value: a), right: .Leaf(value: b))
}

