// Every literal and match in an array `+` chain is built as the type the
// chain goes to, or else as its first operand that isn't a literal or match.
interface Shape {
    func area(self) -> int64
}

type Sq = shared struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}

type A = enum {
    Hit(n: int64)
    Miss
}

type B = enum {
    Miss
    Hit(n: int64)
}

type Dark = enum { Red  Green }
type Light = enum { Green  Red }
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}

type Holder = shared struct {
    ms: [Maybe[str]]
    shapes: [Shape] = [Sq(s: 1)] + [Sq(s: 2)]
}

func show_b(anon b: B) -> str {
    return match b {
        .Miss -> "miss"
        .Hit(n) -> f"hit {n}"
    }
}

func show_l(anon l: Light) -> str {
    return match l {
        .Green -> "green"
        .Red -> "red"
    }
}

func show_all(anon ms: [Maybe[str]]) -> str {
    mut out = ""
    for m in ms {
        match m {
            .Just(value) -> out += f" {value}"
            .Nothing -> out += " -"
        }
    }
    return out
}

func total(anon xs: [Shape]) -> int64 {
    mut t = 0
    for x in xs {
        t += x.area()
    }
    return t
}

func ret() -> [Maybe[str]] {
    return [.Just(value: "r")] + [.Nothing]
}

func ret_or(anon k: int64) -> [Maybe[str]] or Error {
    if k > 0 {
        return [.Just(value: "o")] + [.Nothing] + [.Just(value: "k")]
    }
    return [.Nothing] + [.Nothing]
}

func ret_shapes() -> [Shape] {
    return [Sq(s: 3)] + [Sq(s: 4)]
}

test "generic variants in every kind of + chain" {
    let ms: [Maybe[str]] = [.Nothing]
    mut s = ""
    for m in [.Just(value: "a")] + [.Just(value: "b")] + ms {
        s += show_all([m])
    }
    assert s == " a b -"
    let c: [Maybe[str]] = [.Just(value: "c")] + [.Nothing]
    assert show_all(c) == " c -"
    mut d: [Maybe[str]] = []
    d = [.Nothing] + [.Just(value: "d")] + ms
    assert show_all(d) == " - d -"
    assert show_all([.Just(value: "arg")] + [.Nothing]) == " arg -"
    assert show_all(ret()) == " r -"
    assert show_all(must ret_or(1)) == " o - k"
    assert show_all(must ret_or(0)) == " - -"
    mut acc: [Maybe[str]] = []
    acc += [.Just(value: "p1")] + [.Just(value: "p2")]
    acc += ms + [.Just(value: "p3")]
    assert show_all(acc) == " p1 p2 - p3"
    mut h = Holder(ms: [.Just(value: "f")] + [.Nothing])
    assert show_all(h.ms) == " f -"
    assert total(h.shapes) == 5
    h.ms = [.Nothing] + [.Just(value: "g")]
    assert show_all(h.ms) == " - g"
    mut grid: [[Maybe[str]]] = [[]]
    grid[0] = [.Just(value: "i")] + [.Nothing]
    assert show_all(grid[0]) == " i -"
    let k = 2
    let picked = match k {
        1 -> [.Just(value: "one")]
        else -> [.Nothing]
    } + [.Just(value: "m")] + ms
    assert show_all(picked) == " - m -"
}

test "variants take the first non-literal operand's enum" {
    let bs: [B] = [.Miss]
    mut hits = ""
    for b in [.Hit(n: 1)] + [.Hit(n: 2)] + bs {
        hits += f" {show_b(b)}"
    }
    assert hits == " hit 1 hit 2 miss"
    let ls: [Light] = [.Green]
    mut lights = ""
    for l in [.Red] + [.Red] + ls {
        lights += f" {show_l(l)}"
    }
    assert lights == " red red green"
}

test "structs in a + chain are boxed as the interface" {
    let shapes: [Shape] = [Sq(s: 2)]
    assert total([Sq(s: 1)] + [Sq(s: 5)] + shapes) == 30
    assert total(shapes + [Sq(s: 3)] + [Sq(s: 1)]) == 14
    assert total(ret_shapes()) == 25
    mut more: [Shape] = []
    more += [Sq(s: 6)] + [Sq(s: 1)]
    assert total(more) == 37
}

test "ints and none in a + chain become optionals" {
    let opts: [int64?] = [none]
    let all_opts = [1, none] + [2] + opts
    mut n = 0
    for o in all_opts {
        n += o? or 100
    }
    assert n == 203
}
