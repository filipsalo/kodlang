// `kod` in a project outside the checkout (docs/install.md, "Using kod in
// other projects"): its sources and what is built are the project's, the
// toolchain and the standard library the checkout's, and the programs it
// starts run in the project's directory.
import "io"
import "posix"
import "process"

let PROJECT: str = "build/kod_project_test"

// `kod args...` run in the project's directory, the tool by its own path
// (from the checkout, `$OLDPWD` once the shell has changed directory), so it
// doesn't refresh the toolchain, which `make test` has just built.
func in_project(anon args: str) -> process.ProcessResult {
    return process.run(["sh", "-c", f"cd {PROJECT} && exec perl -e 'alarm 120; exec @ARGV' \"$OLDPWD/build/apps/kod/kod\" {args}"])
}

func write(anon path: str, anon text: str) -> none {
    assert io.write_file(f"{PROJECT}/{path}", text) == 0
}

func fresh_project() -> none {
    process.run(["rm", "-rf", PROJECT])
    must posix.make_dir(PROJECT)
    must posix.make_dir(f"{PROJECT}/lib")
    write("data.txt", "the project\n")
    write("lib/greet.kod", "func greet(anon who: str) -> str {\n    return f\"hello from {who}\"\n}\n")
    write("lib/greet_test.kod", "import \"./greet\"\n\ntest \"greets\" {\n    assert greet.greet(\"x\") == \"hello from x\"\n}\n")
    write("main.kod", "import \"io\"\nimport \"./lib/greet\"\n\nfunc main() -> int64 {\n    let who = (io.read_file(\"data.txt\")? or \"nowhere\").trim()\n    print(greet.greet(who))\n    return 0\n}\n")
    write("broken.kod", "func main() -> int64 {\n    return nope\n}\n")
}

test "a project outside the checkout builds, runs and tests on its own" {
    fresh_project()
    // Run in the project: it reads the project's data.txt.
    let ran = in_project("run main.kod")
    assert ran.status == 0
    assert ran.stdout == "hello from the project\n"
    // Built into the project's build/, not the checkout's.
    let built = in_project("build main.kod")
    assert built.status == 0
    assert io.is_file(f"{PROJECT}/build/apps/main/main")
    // Its tests, found below the project's directory.
    let tested = in_project("test .")
    assert tested.status == 0
    assert tested.stdout.contains("greets")
    // An error names the project's file.
    let checked = in_project("check broken.kod")
    assert checked.status != 0
    assert checked.stderr.contains("/build/kod_project_test/broken.kod:2:")
}
