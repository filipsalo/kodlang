// A bare type name means a type of this module, one an import lists or a
// builtin, not one of a module imported without listing it or loaded only
// because another module imports it.
import "./type_bare_cross_module_dep"

func origin() -> Pt {
    return type_bare_cross_module_dep.Pt(x: 0)
}

func shift(anon g: Gear) -> int64 {
    return 0
}

func held(anon e: Error) -> bool {
    return e is Pt
}

type Pnx = int64

// The module sees `Mode`, so its error has no hint.
type Mode = enum {
    A
}

func is_mode(anon e: Error) -> bool {
    return e is Mode
}

func near(anon p: [Pnt]) -> Pnx {
    return 0
}

// An enum named bare in a value, an `is` or a pattern gets the same hint.
func moody() -> bool {
    let m = Mood.Up
    let d: type_bare_cross_module_dep.Mood = Mood.Down(by: 1)
    if d is Mood.Up {
        return true
    }
    match d {
        Mood.Down(by) -> return by > 0
        else -> return d == Mood.Up
    }
}

func main() -> int64 {
    let p = Pt(x: 1)
    let q: type_bare_cross_module_dep.Pt = type_bare_cross_module_dep.Pt(x: 2)
    return q.x
}

