// int64, bool and float64 constants made of literals are folded in at each
// use; their values must be what the getter would have given.

let SMALL: int64 = 7
let NEG: int64 = -5
let BIG: int64 = 1 << 52
let MASK: int64 = (1 << 52) - 1
let HEX: int64 = 0xff ^ 0x0f
let MIN: int64 = -9223372036854775808
let WRAP: int64 = 9223372036854775807 + 1
let PER_DAY: int64 = 24 * 60 * 60
let SHIFTED: int64 = -1 >> 60
let FLAG: bool = true
let OFF: bool = false
let HALF: float64 = 0.5
let DIV: int64 = 7 / 2
let FROM_OTHER: int64 = SMALL * 2

func main() -> int64 {
    mut t: int64 = 0
    for i in 0..3 {
        t += SMALL + i
    }
    print(f"{SMALL} {NEG} {BIG} {MASK} {HEX} {MIN} {WRAP} {PER_DAY} {SHIFTED} {t}")
    print(f"{FLAG} {OFF} {FLAG and not OFF} {HALF} {HALF * 3.0} {DIV} {FROM_OTHER}")
    if FLAG {
        print("flag")
    }
    return 0
}

// expected output:
// 7 -5 4503599627370496 4503599627370495 240 -9223372036854775808 -9223372036854775808 86400 15 24
// true false true 0.5 1.5 3 14
// flag
// expected status:
// 0
