// Explicit type arguments on a generic constructor pick the instantiation.
import "json"

type Pair[A, B] = shared struct {
    first: A
    second: B
}

type Cell[T] = shared struct {
    v: T?
}

type Wrap[T] = shared struct {
    item: T
}

test "explicit type arguments pick the instantiation" {
    let p = Pair[str, int64](first: "a", second: 1)
    assert p.first == "a"
    assert p.second == 1
    mut m = Map[str, int64]()
    m.set("ab", 2)
    let key = "a" + "b"
    assert (m.get(key)? or -1) == 2
    assert (m.get("zz")? or -1) == -1
    let c = Cell[str](v: "boxed")
    assert (c.v? or "empty") == "boxed"
    let w = Wrap[[str]](item: ["x", "y"])
    assert w.item[1] == "y"
    let nested = Pair[str, Pair[int64, str]](first: "outer", second: Pair[int64, str](first: 7, second: "inner"))
    assert nested.first == "outer"
    assert nested.second.first == 7
    assert nested.second.second == "inner"
    let maybe = Pair[str?, int64](first: none, second: 3)
    assert (maybe.first? or "no first") == "no first"
    assert maybe.second == 3
}

test "a qualified type argument" {
    let jw = Wrap[json.Value](item: json.Value.Str(value: "qualified"))
    match jw.item {
        .Str(value) -> assert value == "qualified"
        else -> fail("not a str")
    }
}
