test "`and` and `or` operands must be bool" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func main() -> int64 {
            let v = 7 or 0
            let w = "a" and true
            return 0
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "`or` needs `bool` operands, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`and` needs `bool` operands, got `str`")
}

test "`or` on an optional suggests a default" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func main() -> int64 {
            let o: int64? = 5
            let w = o or 5
            return 0
        }
        """)
    assert test_support.any_message_contains(errs, needle: "`or` needs `bool` operands, got `int64?`; did you mean `o? or default`?")
}

test "conditions must be bool" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func main() -> int64 {
            let n = 7
            let o: int64? = 5
            if n {
                print("n")
            }
            for o {
                break
            }
            assert n
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "an `if` condition must be a `bool`, got `int64`")
    assert test_support.any_message_contains(errs, needle: "a `for` condition must be a `bool`, got `int64?`; test it with `is not none`")
    assert test_support.any_message_contains(errs, needle: "`assert` needs a `bool`, got `int64`")
}

test "bool and int64 don't mix" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func main() -> int64 {
            let b = true
            if b == 1 {
                print("b")
            }
            let z = true + 1
            let q = b < true
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool` with `int64`")
    assert test_support.any_message_contains(errs, needle: "`+` doesn't take `bool` operands")
    assert test_support.any_message_contains(errs, needle: "`<` doesn't take `bool` operands")
}

test "a bit test without parentheses explains the precedence" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func main() -> int64 {
            let flags = 5
            if flags & 1 != 0 {
                print("odd")
            }
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "`&` doesn't take `bool` operands; `!=` binds tighter than `&`, so write `(a & b) != c`")
}

test "bool conditions and operands compile cleanly" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func main() -> int64 {
            let flags = 5
            let b = flags > 2
            let o: int64? = none
            if (flags & 1) != 0 and b == true {
                print("odd")
            }
            if (o is not none) or b != false {
                print("yes")
            }
            let n = o? or 3
            assert n == 3
            return 0
        }
        """)
    assert len(errs) == 0
}

test "interpolating an optional suggests unwrapping it" {
    let errs: [codegen.Error] = test_support.try_compile("""
        func main() -> int64 {
            let n: int64? = 5
            print(f"n = {n}")
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `int64?` to `str`; unwrap it first with `x?` or `x? or default`")
}

test "interpolating values that have no string form" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Color = enum {
            Red
            Green
        }
        type Plain = struct { x: int64 }
        interface Shape {
            func area(self) -> int64
        }
        type Square = struct {
            side: int64
            func area(self) -> int64 { return self.side * self.side }
        }
        func twice(anon n: int64) -> int64 { return n * 2 }
        func main() -> int64 {
            let c = Color.Red
            let xs = [1, 2]
            let p = Plain(x: 1)
            let sh: Shape = Square(side: 2)
            let f = twice
            print(f"{c}")
            print(f"{xs}")
            print(f"{p}")
            print(f"{sh}")
            print(str(f))
            return 0
        }
        """)
    assert len(errs) == 5
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `Color` to `str`")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `[int64]` to `str`")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `Plain` to `str`; `Plain` has no `to_str` method")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `Shape` to `str`; `Shape` doesn't declare `to_str`")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `func(int64) -> int64` to `str`")
}

test "interpolating an interface that declares to_str is not an error" {
    let errs: [codegen.Error] = test_support.try_compile("""
        type Celsius = struct {
            degrees: int64
            func to_str(self) -> str { return f"{self.degrees}C" }
        }
        func main() -> int64 {
            let t: Stringable = Celsius(degrees: 21)
            print(f"{t}")
            return 0
        }
        """)
    assert len(errs) == 0
}

