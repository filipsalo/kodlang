type Celsius = shared struct {
    degrees: int64
    func to_str(self) -> str {
        return f"{self.degrees}C"
    }
}

type Oops = shared struct {
    code: int64
    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

func fails() -> int64 or Error {
    throw Oops(code: 7)
}

func show(anon s: Stringable) -> str {
    return f"<{s}>"
}

test "an interface value interpolates through its to_str" {
    let t: Stringable = Celsius(degrees: 21)
    assert f"{t}" == "21C"
    assert str(t) == "21C"
    assert show(Celsius(degrees: -3)) == "<-3C>"
    assert show(42) == "<42>"
    assert show(true) == "<true>"
}

test "an error interpolates through its to_str" {
    match fails() {
        Ok(n) -> fail(f"{n}")
        Err(e) -> assert f"error: {e}" == "error: oops 7"
    }
}
