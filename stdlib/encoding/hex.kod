// Bytes as hex text, two digits each, and back. See docs/encoding.md.
import "strbuilder" { StrBuilder }
import "stream" { IoError }

func encode(anon data: bytes) -> str {
    let digits = "0123456789abcdef"
    let out = StrBuilder()
    for b in data {
        out.append_byte(digits[b >> 4])
        out.append_byte(digits[b & 15])
    }
    return out.to_str()
}

// The value of a hex digit, or -1.
func nibble(anon c: int64) -> int64 {
    if c >= '0' and c <= '9' {
        return c - '0'
    }
    if c >= 'a' and c <= 'f' {
        return c - 'a' + 10
    }
    if c >= 'A' and c <= 'F' {
        return c - 'A' + 10
    }
    return -1
}

func decode(anon text: str) -> bytes or Error {
    let n = len(text)
    if n % 2 != 0 {
        throw IoError(kind: .InvalidInput, op: "hex decode", errno: 0, detail: "the length is odd")
    }
    mut out: [int64] = []
    for i in 0..n step 2 {
        let hi = nibble(text[i])
        let lo = nibble(text[i + 1])
        if hi < 0 or lo < 0 {
            let at = if hi < 0 { i } else { i + 1 }
            throw IoError(kind: .InvalidInput, op: "hex decode", errno: 0, detail: f"unexpected character at offset {at}")
        }
        out += [hi << 4 | lo]
    }
    return kod_bytes_from_array(out)
}
