// A function named like an import alias doesn't hide the module.
import "./alias_func_dep"

func alias_func_dep() -> int64 {
    return 5
}

func high() -> alias_func_dep.Tone {
    return .High
}

func main() -> int64 {
    print_int(alias_func_dep())
    print_int(alias_func_dep.value())
    let p: alias_func_dep.Pt = alias_func_dep.make(7)
    print_int(p.x)
    print_int(alias_func_dep.rank(high()))
    let f = alias_func_dep
    print_int(f())
    return 0
}

// expected output:
// 5
// 1
// 7
// 2
// 5
