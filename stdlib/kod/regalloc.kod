// Linear-scan register allocator over the buffered instruction stream
// of a single function. The codegen hands out alloc-time physicals
// while emitting (so the produced asm reads naturally), but those
// initial assignments stack-discipline-only — they don't reuse a
// phys once its previous holder's last use is past. This pass walks
// the buffered body to compute per-vreg live intervals, then
// reassigns each vreg from a per-class free pool, expiring intervals
// whose last_use is at-or-before the current def line.
//
// The pass is constrained: a callee-saved vreg can only be rewritten
// to another callee-saved phys, and same for caller-saved. That
// preservation matters because every emit-time decision that asked
// `is_callee_saved(vreg)` (e.g. `spill_across` skipping the stash
// when the value lives in a callee-saved reg) must still get the
// same answer after rewriting.
//
// `pack` is a small follow-up that collapses the chosen callee-saved
// set into a dense `x19..x{19+N-1}` prefix and returns the new
// callee-saved high-water mark; the function prologue saves exactly
// that many registers instead of over-saving to cover gaps.

import "arrays"

// The registers a target gives the allocator (see docs/ir.md). Everything
// else codegen names (arguments, scratch, the frame) is a role it spells as
// arm64 does, for a target's lowering to map.
type Target = struct {
    // Temporaries a call may clobber, in the order they are filled in.
    caller_saved: [Reg]
    // Temporaries a call keeps (the prologue saves them), likewise.
    callee_saved: [Reg]
    // The callee-saved registers in the order the prologue saves them, and a
    // pad that makes their number even.
    save_order: [Reg]
    // The registers calls pass arguments and results in, never in the pool.
    arg_regs: [Reg]
    // A register for a vreg nothing names, which therefore costs nothing.
    unused: Reg
}

mut ARM64: Target = Target(
    caller_saved: regs(["x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15"]),
    callee_saved: regs(["x19", "x20", "x21", "x22", "x23", "x24", "x25", "x26", "x27"]),
    save_order: regs(["x19", "x20", "x21", "x22", "x23", "x24", "x25", "x26", "x27", "x28"]),
    arg_regs: regs(["x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7"]),
    unused: reg_of("x8"),
)

// Each of `names` as a Reg.
func regs(anon names: [str]) -> [Reg] {
    mut out: [Reg] = []
    for name in names {
        out += [reg_of(name)]
    }
    return out
}

// The target being compiled for.
mut TARGET: Target = ARM64

// The first callee-saved register, which a vreg made to be allocated starts as.
func first_callee_saved() -> Reg {
    return TARGET.callee_saved[0]
}

// How many registers the prologue can save: `cs_reg` takes 0 up to this.
func save_order_len() -> int64 {
    return len(TARGET.save_order)
}

// The pool `reset` and `evict` start from: the caller-saved registers, then
// the callee-saved ones at the tail, so `alloc_reg` (which pops the tail)
// hands those out first.
func full_pool() -> [Reg] {
    let t = TARGET
    mut pool: [Reg] = []
    mut i = len(t.caller_saved) - 1
    for i >= 0 {
        pool += [t.caller_saved[i]]
        i -= 1
    }
    i = len(t.callee_saved) - 1
    for i >= 0 {
        pool += [t.callee_saved[i]]
        i -= 1
    }
    return pool
}

// A register or other operand of an instruction (docs/ir.md, step 8): 4n+1
// is vreg n (`v12`), 4n+2 its 32-bit form (`w12`), 4n+3 the immediate `#n`,
// and 4k the kth of NAMES. 0 is none.
type Reg = int64

let NO_REG: Reg = 0
// x0 to x30 are names 1 to 31, then fp, lr, sp, xzr.
let X0: Reg = 4
let X16: Reg = 68
let X28: Reg = 116
let FP: Reg = 128
let LR: Reg = 132
let SP: Reg = 136
let XZR: Reg = 140

// The text of each named operand, by number.
mut NAMES: [str] = first_names()
// The number of each of NAMES.
mut NAME_IDS: Map[str, int64] = name_ids()

func first_names() -> [str] {
    mut names: [str] = [""]
    for n in 0..31 {
        names += [f"x{n}"]
    }
    names += ["fp", "lr", "sp", "xzr"]
    return names
}

func name_ids() -> Map[str, int64] {
    mut ids = Map[str, int64]()
    for k, name in NAMES {
        ids[name] = k
    }
    return ids
}

// Vreg `id`, and its 32-bit form.
func vreg(anon id: int64) -> Reg {
    return id * 4 + 1
}

func wvreg(anon id: int64) -> Reg {
    return id * 4 + 2
}

// The immediate `#value`, for 0 <= value.
func imm(anon value: int64) -> Reg {
    return value * 4 + 3
}

// The Reg for an operand as codegen writes it: `v12`, `w12`, `x3`, `#8`, `fp`, `eq`, ...
func reg_of(anon text: str) -> Reg {
    let n = len(text)
    if n == 0 {
        return NO_REG
    }
    let c = text[0]
    if n >= 2 and n <= 11 and (c == 'v' or c == 'w' or c == 'x' or c == '#') and (text[1] != '0' or n == 2) {
        mut v: int64 = 0
        mut digits = true
        for k in 1..n {
            let d = text[k]
            if d < '0' or d > '9' {
                digits = false
                break
            }
            v = v * 10 + d - '0'
        }
        if digits {
            if c == 'v' {
                return v * 4 + 1
            }
            if c == 'w' {
                return v * 4 + 2
            }
            if c == '#' {
                return v * 4 + 3
            }
            if v <= 30 {
                return (v + 1) * 4
            }
        }
    }
    if text == "fp" {
        return FP
    }
    if text == "sp" {
        return SP
    }
    return named(text)
}

// The number of `text` among NAMES, added if it isn't one yet.
func named(anon text: str) -> Reg {
    if NAME_IDS.get(text) is Some(k) {
        return k * 4
    }
    let k = len(NAMES)
    NAMES += [text]
    NAME_IDS[text] = k
    return k * 4
}

// An operand's text, as reg_of read it (a vreg as itself, not its register).
func reg_text(anon r: Reg) -> str {
    match r & 3 {
        1 -> return f"v{r >> 2}"
        2 -> return f"w{r >> 2}"
        3 -> return f"#{r >> 2}"
        else return NAMES[r >> 2]
    }
}

// The value of an immediate operand, or -1 for any other.
func imm_value(anon r: Reg) -> int64 {
    if (r & 3) == 3 {
        return r >> 2
    }
    return -1
}

// Whether `r` is an x vreg or one of x0 to x30.
func is_plain(anon r: Reg) -> bool {
    return (r & 3) == 1 or ((r & 3) == 0 and r >= X0 and r <= 124)
}

// One instruction of a function's buffer, the compiler's low-level IR (see
// docs/ir.md): operations on vregs (`v12`, or `w12` for its 32-bit form) and
// the registers codegen names by their arm64 roles. Codegen's arm64 lowering
// (format_insn) writes each as asm text when the function is output.
type Insn = enum {
    Label(name: str)
    // `ldr reg, [fp, #off]` (`[fp]` for off 0 or more), or `str` with
    // `store`, made without text: see `slot_text`. `reg` is a vreg (`v12`)
    // or a physical register.
    Slot(store: bool, reg: Reg, off: int64)
    // `mov dst, src` between registers (vregs or physical), made without text.
    Mov(dst: Reg, src: Reg)
    // A load into `reg` (or a store of it) of `width` bytes (1, 2, 4 or 8) at
    // the address `base` and `at` make. A 4-byte one has a `w` register, as
    // arm64 writes it.
    Mem(load: bool, width: int64, reg: Reg, base: Reg, at: MemAt)
    // A line that isn't an instruction: a directive, or a label of data.
    // Nothing reads it but the output.
    Data(text: str)
    // What a call to the function `label` does, done in place: the arguments
    // in the first argument registers and the result in the first, as for a
    // call (see arm64_intrinsic).
    Intrinsic(label: str)
    // `dst` gets a constant too big for one move: on arm64 a `mov` and three
    // `movk`s, which LOAD_CONST_LINES counts.
    LoadConst(dst: Reg, value: int64)
    // A load into (or a store of) two registers at once, at `base` per `mode`.
    Pair(load: bool, a: Reg, b: Reg, base: Reg, mode: PairMode)
    // `mn a, b, c, d` with the operands given (up to the first NO_REG): each a
    // register, an immediate, a condition or a symbol, never more than one
    // token (see codegen's emit_op).
    Op(op: Opcode, a: Reg, b: Reg, c: Reg, d: Reg, flags: int64)
    // `bl target`.
    Call(target: str)
    // A jump to `target`, when `kind` says; `reg` is the register tested by
    // `IfZero` and `IfNonzero`, NO_REG for the others.
    Branch(kind: BranchKind, reg: Reg, target: str)
}

// A condition on the flags a compare sets.
type Cond = enum {
    Eq
    Ne
    // Unsigned: at least, below, above, at most.
    Hs
    Lo
    Hi
    Ls
    Mi
    Pl
    Vs
    Vc
    Ge
    Lt
    Gt
    Le
}

// When a `Branch` jumps.
type BranchKind = enum {
    Always
    If(cond: Cond)
    IfZero
    IfNonzero
}

// The condition that holds when `c` doesn't.
func cond_opposite(anon c: Cond) -> Cond {
    match c {
        .Eq -> return .Ne
        .Ne -> return .Eq
        .Hs -> return .Lo
        .Lo -> return .Hs
        .Hi -> return .Ls
        .Ls -> return .Hi
        .Mi -> return .Pl
        .Pl -> return .Mi
        .Vs -> return .Vc
        .Vc -> return .Vs
        .Ge -> return .Lt
        .Lt -> return .Ge
        .Gt -> return .Le
        .Le -> return .Gt
    }
}

// The condition an arm64 name (or its alias `cs`, `cc`) is.
func cond_named(anon name: str) -> Cond? {
    match name {
        "eq" -> return .Eq
        "ne" -> return .Ne
        "hs" -> return .Hs
        "cs" -> return .Hs
        "lo" -> return .Lo
        "cc" -> return .Lo
        "hi" -> return .Hi
        "ls" -> return .Ls
        "mi" -> return .Mi
        "pl" -> return .Pl
        "vs" -> return .Vs
        "vc" -> return .Vc
        "ge" -> return .Ge
        "lt" -> return .Lt
        "gt" -> return .Gt
        "le" -> return .Le
        else return none
    }
}

// Where a `Mem` reads or writes, from its base register.
type MemAt = enum {
    // At the base.
    Base
    // At the base plus `off`.
    Offset(off: int64)
    // At the base plus the register `reg`, shifted left by log2 of the
    // access's width when `scaled` (`[x1, x2, lsl #3]` for 8 bytes).
    Index(reg: Reg, scaled: bool)
    // At the base plus a symbol's offset in its page (`got`: of its entry in
    // the global offset table), with the base the page an AddressPage gave.
    Symbol(name: str, got: bool)
}

// The lines a LoadConst takes on arm64.
let LOAD_CONST_LINES: int64 = 4

// An intrinsic's flags: none, as its lines name only the argument registers.
func intrinsic_flags(anon label: str) -> int64 {
    return 0
}

// Where a `Pair` reads or writes, and whether it moves its base.
type PairMode = enum {
    // At the base plus `off` (at the base for 0).
    At(off: int64)
    // At the base plus `off`, which the base then holds.
    Pre(off: int64)
    // At the base, which then moves on by `off`.
    Post(off: int64)
}

// Whether two `MemAt`s are the same place from the same base.
func same_at(anon a: MemAt, anon b: MemAt) -> bool {
    match a {
        .Base -> return b is .Base
        .Offset(off) -> {
            if b is .Offset(other) {
                return other == off
            }
            return false
        }
        .Index(reg, scaled) -> {
            if b is .Index(other, other_scaled) {
                return other == reg and other_scaled == scaled
            }
            return false
        }
        .Symbol(name, got) -> {
            if b is .Symbol(other, other_got) {
                return other == name and other_got == got
            }
            return false
        }
    }
}

// The index register of a `MemAt`, or NO_REG.
func at_reg(anon at: MemAt) -> Reg {
    if at is .Index(reg, _scaled) {
        return reg
    }
    return NO_REG
}

// The width of a 4- or 8-byte load or store of `reg`: 4 for a `w` register.
func reg_width(anon reg: Reg) -> int64 {
    if (reg & 3) == 2 or ((reg & 3) == 0 and reg > XZR and NAMES[reg >> 2][0] == 'w') {
        return 4
    }
    return 8
}

// Whether a `Mem` writes its register, as writer_at says for its mnemonic:
// a load, other than of 2 bytes (`ldrh` isn't on the list).
func mem_writes(load: bool, width: int64) -> bool {
    return load and width != 2
}

// What an `Op` does, whatever a target calls it (see docs/ir.md).
type Opcode = enum {
    // A register gets an immediate (or a value given as one token).
    Move
    Add
    Sub
    Mul
    DivSigned
    And
    Or
    Xor
    ShiftLeft
    // Logical: zeros come in.
    ShiftRight
    // Arithmetic: copies of the sign bit come in.
    ShiftRightSigned
    // Sets the flags from `a - b`.
    Compare
    // Compares when the condition in `d` holds, else sets the flags to `c`.
    CompareIf
    // `a` is 1 when the condition `b` holds, else 0.
    SetIf
    // `a` is `b` when the condition `d` holds, else `c`.
    Select
    // The 4 KB page a symbol is on (with an Add of its offset in the page).
    AddressPage
    FloatMove
    FloatAdd
    FloatSub
    FloatMul
    FloatDiv
    FloatNeg
    FloatCompare
    // Calls the address in `a`.
    CallIndirect
    Return
}

// Whether an opcode's first operand is one it writes, as writer_at says for
// its arm64 mnemonic (the float ops other than fmov, csel and ccmp aren't).
func writes_first_op(anon op: Opcode) -> bool {
    match op {
        .Move -> return true
        .Add -> return true
        .Sub -> return true
        .Mul -> return true
        .DivSigned -> return true
        .And -> return true
        .Or -> return true
        .Xor -> return true
        .ShiftLeft -> return true
        .ShiftRight -> return true
        .ShiftRightSigned -> return true
        .AddressPage -> return true
        .SetIf -> return true
        .FloatMove -> return true
        else return false
    }
}

// writes_first_op of the opcode numbered `n` (opcode_number).
func writes_first_op_number(anon n: int64) -> bool {
    // Move to ShiftRightSigned, SetIf, AddressPage and FloatMove.
    return n <= 10 or n == 13 or n == 15 or n == 16
}

// Whether an opcode reads its first operand (codegen's first_operand_read).
func reads_first_op(anon op: Opcode) -> bool {
    return op is .Compare
}

// An `Op`, with its flags worked out once.
func op(anon op: Opcode, a: Reg = NO_REG, b: Reg = NO_REG, c: Reg = NO_REG, d: Reg = NO_REG) -> Insn {
    return .Op(:op, :a, :b, :c, :d, flags: op_flags(:op, :a, :b, :c, :d))
}

// The flags one operand of an `Op` adds.
func operand_flags(anon operand: Reg) -> int64 {
    if reg_clobbers(operand) {
        return INFO_CLOBBERS
    }
    if operand == FP {
        return INFO_FP
    }
    return 0
}

// insn_flags of an `Op`.
func op_flags(op: Opcode, a: Reg, b: Reg, c: Reg, d: Reg) -> int64 {
    mut flags: int64 = 0
    match op {
        .Move -> flags = MN_MOV << 8
        .SetIf -> flags = MN_CSET << 8
        .Add -> flags = MN_ADD << 8
        .Sub -> flags = MN_SUB << 8
        .CallIndirect -> flags = INFO_CLOBBERS
        else none
    }
    flags = flags | operand_flags(a) | operand_flags(b) | operand_flags(c) | operand_flags(d)
    // An immediate add or sub can't encode past 4095 (codegen's big_immediate_at).
    if (op is .Add or op is .Sub) and d == NO_REG and imm_value(c) > 4095 {
        flags = flags | INFO_BIG_IMM
    }
    return flags
}

// The vreg `reg` is (`v12` or `w12`), or -1 for any other operand.
func reg_vreg(anon reg: Reg) -> int64 {
    let tag = reg & 3
    if tag == 1 or tag == 2 {
        return reg >> 2
    }
    return -1
}

// Whether `reg` is one of x8–x15, which an instruction naming counts as a clobber.
func reg_clobbers(anon reg: Reg) -> bool {
    return (reg & 3) == 0 and reg >= 36 and reg <= 64
}

// insn_flags of an instruction that calls something or names a caller-saved register outright.
let INFO_CLOBBERS: int64 = 1
// insn_flags of a line that isn't an instruction.
let INFO_NO_MNEMONIC: int64 = 2
// insn_flags of an instruction that names `fp` as a register.
let INFO_FP: int64 = 4
// insn_flags of an `add`, `sub`, `ldr` or `str` whose immediate may be too big
// to encode (see codegen's big_immediate_at, which says for sure).
let INFO_BIG_IMM: int64 = 8
// insn_flags `>> 8`: what the mnemonic is, for the ones passes look for.
let MN_OTHER: int64 = 0
let MN_MOV: int64 = 1
let MN_LDR: int64 = 2
let MN_STR: int64 = 3
let MN_CSET: int64 = 4
let MN_ADD: int64 = 5
let MN_SUB: int64 = 6

// The mnemonic code of a line's flags.
func mnemonic_code(anon flags: int64) -> int64 {
    return flags >> 8
}

// Whether insn_flags(insn) has INFO_FP, without working out the rest.
func names_fp(anon insn: Insn) -> bool {
    match insn {
        .Slot(_store, _reg, _off) -> return true
        .Mov(dst, src) -> return dst == FP or src == FP
        .Mem(_load, _width, reg, base, at) -> return reg == FP or base == FP or at_reg(at) == FP
        .Op(_op, _a, _b, _c, _d, flags) -> return (flags & INFO_FP) != 0
        .Pair(_load, a, b, base, _mode) -> return a == FP or b == FP or base == FP
        .Intrinsic(label) -> return (intrinsic_flags(label) & INFO_FP) != 0
        else return false
    }
}

// names_fp of instruction `i` of `body`.
func names_fp_at(anon body: InsnBuf, anon i: int64) -> bool {
    let tag = body.tags[i]
    let variant = tag & 255
    if variant == INSN_SLOT {
        return true
    }
    if variant == INSN_MOV {
        return body.fa[i] == FP or body.fb[i] == FP
    }
    if variant == INSN_MEM {
        return body.fa[i] == FP or body.fb[i] == FP or (((tag >> 9) & 3) == AT_INDEX and body.fc[i] == FP)
    }
    if variant == INSN_OP {
        return (body.fe[i] & INFO_FP) != 0
    }
    if variant == INSN_PAIR {
        return body.fa[i] == FP or body.fb[i] == FP or body.fc[i] == FP
    }
    if variant == INSN_INTRINSIC {
        return (intrinsic_flags(body.strs[body.fa[i]]) & INFO_FP) != 0
    }
    return false
}

// What the passes need to know of an instruction at a glance: the INFO_ bits
// and, from bit 8, its mnemonic code.
func insn_flags(anon insn: Insn) -> int64 {
    match insn {
        .Slot(store, reg, _off) -> {
            mut flags = (MN_LDR << 8) | INFO_FP
            if store {
                flags = (MN_STR << 8) | INFO_FP
            }
            if reg_clobbers(reg) {
                flags = flags | INFO_CLOBBERS
            }
            return flags
        }
        .Mov(dst, src) -> {
            mut flags = MN_MOV << 8
            if reg_clobbers(dst) or reg_clobbers(src) {
                flags = flags | INFO_CLOBBERS
            }
            if dst == FP or src == FP {
                flags = flags | INFO_FP
            }
            return flags
        }
        .Mem(load, width, reg, base, at) -> {
            let index = at_reg(at)
            mut flags: int64 = 0
            // `ldr` and `str`: a 4- or 8-byte access.
            let word = width >= 4
            if word and load {
                flags = MN_LDR << 8
            } else if word {
                flags = MN_STR << 8
            }
            if reg_clobbers(reg) or reg_clobbers(base) or reg_clobbers(index) {
                flags = flags | INFO_CLOBBERS
            }
            if reg == FP or base == FP or index == FP {
                flags = flags | INFO_FP
            }
            // As codegen's big_immediate_at reads `[base, #off]`.
            if at is .Offset(off) and word and off > 32760 {
                flags = flags | INFO_BIG_IMM
            }
            return flags
        }
        .Op(_op, _a, _b, _c, _d, flags) -> return flags
        .LoadConst(dst, _value) -> {
            if reg_clobbers(dst) {
                return INFO_CLOBBERS
            }
            return 0
        }
        .Intrinsic(label) -> return intrinsic_flags(label)
        .Data(_text) -> return INFO_NO_MNEMONIC
        .Pair(_load, a, b, base, _mode) -> {
            // Only fixed registers: the frame link and the callee-saved ones.
            mut flags: int64 = 0
            if reg_clobbers(a) or reg_clobbers(b) {
                flags = INFO_CLOBBERS
            }
            if a == FP or b == FP or base == FP {
                flags = flags | INFO_FP
            }
            return flags
        }
        .Call(target) -> {
            // A panic never comes back, so whatever it clobbers isn't read after it.
            if never_returns(target) or keeps_regs(target) {
                return 0
            }
            return INFO_CLOBBERS
        }
        .Branch(_kind, reg, _target) -> {
            if reg_clobbers(reg) {
                return INFO_CLOBBERS
            }
            return 0
        }
        .Label(_name) -> return 0
    }
}

// A function's instructions without a heap object each (docs/ir.md, step
// 12): parallel arrays, one slot per instruction in each. `tags` holds the
// variant (INSN_ below) in its low 8 bits and, from bit 8, the small
// enum-valued fields (see `push`); `fa` to `fe` hold the rest in the order
// the variant names them. A label, call or branch target, data line or
// intrinsic is an index into `strs`. The arrays have spare room past the
// first `n`, so pushing stores into them instead of growing each.
type InsnBuf = shared struct {
    n: int64 = 0
    tags: [int64] = []
    fa: [int64] = []
    fb: [int64] = []
    fc: [int64] = []
    fd: [int64] = []
    fe: [int64] = []
    strs: [str] = []

    func len(self) -> int64 {
        return self.n
    }

    // Empty, keeping the arrays' room for what comes next.
    func clear(self) -> none {
        self.n = 0
        self.strs = []
    }

    // Room for as many again (at least 64) in each array.
    func grow(self) -> none {
        mut more = len(self.tags)
        if more < 64 {
            more = 64
        }
        let zeros = [0] * more
        self.tags += zeros
        self.fa += zeros
        self.fb += zeros
        self.fc += zeros
        self.fd += zeros
        self.fe += zeros
    }

    // Appends `insn`. The fields each variant keeps:
    //   Label: fa name.  Data, Intrinsic, Call: fa the text.
    //   Slot: sub store; fa reg, fb off.  Mov: fa dst, fb src.
    //   Mem: sub load | at kind << 1 | (scaled or got) << 3; fa reg, fb base,
    //     fc the offset, index register or symbol, fd width.
    //   LoadConst: fa dst, fb value.
    //   Pair: sub load | mode kind << 1; fa a, fb b, fc base, fd off.
    //   Op: sub the opcode; fa a, fb b, fc c, fd d, fe flags.
    //   Branch: sub kind | cond << 2; fa reg, fb target.
    // The push_ methods below append one variant from its fields, with no
    // Insn made; `push` is the one of `insn`'s variant.
    func push(self, anon insn: Insn) -> none {
        match insn {
            .Label(name) -> self.push_label(name)
            .Slot(store, reg, off) -> self.push_slot(:store, :reg, :off)
            .Mov(dst, src) -> self.push_mov(:dst, :src)
            .Mem(load, width, reg, base, at) -> {
                match at {
                    .Base -> self.push_mem(:load, :width, :reg, :base)
                    .Offset(off) -> self.push_mem_offset(:load, :width, :reg, :base, :off)
                    .Index(index, scaled) -> self.push_mem_index(:load, :width, :reg, :base, :index, :scaled)
                    .Symbol(name, got) -> self.push_mem_symbol(:load, :width, :reg, :base, :name, :got)
                }
            }
            .Data(text) -> self.push_data(text)
            .Intrinsic(label) -> self.push_intrinsic(label)
            .LoadConst(dst, value) -> self.push_load_const(:dst, :value)
            .Pair(load, pa, pb, base, mode) -> self.push_pair(:load, a: pa, b: pb, :base, :mode)
            .Op(op, oa, ob, oc, od, flags) -> self.push_op(op, a: oa, b: ob, c: oc, d: od, :flags)
            .Call(target) -> self.push_call(target)
            .Branch(kind, reg, target) -> {
                match kind {
                    .If(cond) -> self.push_branch_if(cond, :reg, :target)
                    else self.push_branch(:kind, :reg, :target)
                }
            }
        }
    }

    // Appends an instruction of tag (variant and sub fields) `tag` and fields `a` to `e`.
    func put(self, anon tag: int64, a: int64 = 0, b: int64 = 0, c: int64 = 0, d: int64 = 0, e: int64 = 0) -> none {
        let k = self.n
        if k == len(self.tags) {
            self.grow()
        }
        self.tags[k] = tag
        self.fa[k] = a
        self.fb[k] = b
        self.fc[k] = c
        self.fd[k] = d
        self.fe[k] = e
        self.n = k + 1
    }

    func push_label(self, anon name: str) -> none {
        self.put(INSN_LABEL, a: self.add_str(name))
    }

    func push_data(self, anon text: str) -> none {
        self.put(INSN_DATA, a: self.add_str(text))
    }

    func push_intrinsic(self, anon label: str) -> none {
        self.put(INSN_INTRINSIC, a: self.add_str(label))
    }

    func push_call(self, anon target: str) -> none {
        self.put(INSN_CALL, a: self.add_str(target))
    }

    func push_slot(self, store: bool, reg: Reg, off: int64) -> none {
        self.put(INSN_SLOT | (bit(store) << 8), a: reg, b: off)
    }

    func push_mov(self, dst: Reg, src: Reg) -> none {
        self.put(INSN_MOV, a: dst, b: src)
    }

    func push_load_const(self, dst: Reg, value: int64) -> none {
        self.put(INSN_LOAD_CONST, a: dst, b: value)
    }

    // A Mem at `base` (MemAt.Base).
    func push_mem(self, load: bool, width: int64, reg: Reg, base: Reg) -> none {
        self.put(INSN_MEM | (bit(load) << 8), a: reg, b: base, d: width)
    }

    func push_mem_offset(self, load: bool, width: int64, reg: Reg, base: Reg, off: int64) -> none {
        self.put(INSN_MEM | ((bit(load) | (AT_OFFSET << 1)) << 8), a: reg, b: base, c: off, d: width)
    }

    func push_mem_index(self, load: bool, width: int64, reg: Reg, base: Reg, index: Reg, scaled: bool) -> none {
        self.put(INSN_MEM | ((bit(load) | (AT_INDEX << 1) | (bit(scaled) << 3)) << 8), a: reg, b: base, c: index, d: width)
    }

    func push_mem_symbol(self, load: bool, width: int64, reg: Reg, base: Reg, name: str, got: bool) -> none {
        self.put(INSN_MEM | ((bit(load) | (AT_SYMBOL << 1) | (bit(got) << 3)) << 8), a: reg, b: base, c: self.add_str(name), d: width)
    }

    func push_pair(self, load: bool, a: Reg, b: Reg, base: Reg, mode: PairMode) -> none {
        mut sub = bit(load)
        mut off: int64 = 0
        match mode {
            .At(o) -> off = o
            .Pre(o) -> {
                sub = sub | (MODE_PRE << 1)
                off = o
            }
            .Post(o) -> {
                sub = sub | (MODE_POST << 1)
                off = o
            }
        }
        self.put(INSN_PAIR | (sub << 8), :a, :b, c: base, d: off)
    }

    // An Op; `flags` as op_flags gives them.
    func push_op(self, anon op: Opcode, a: Reg, b: Reg, c: Reg, d: Reg, flags: int64) -> none {
        self.put(INSN_OP | (opcode_number(op) << 8), :a, :b, :c, :d, e: flags)
    }

    // A Branch of `kind`, other than If (see push_branch_if).
    func push_branch(self, kind: BranchKind, reg: Reg, target: str) -> none {
        mut sub: int64 = 0
        match kind {
            .Always -> none
            .If(cond) -> sub = BRANCH_IF | (cond_number(cond) << 2)
            .IfZero -> sub = BRANCH_IF_ZERO
            .IfNonzero -> sub = BRANCH_IF_NONZERO
        }
        self.put(INSN_BRANCH | (sub << 8), a: reg, b: self.add_str(target))
    }

    // A Branch of kind If(cond).
    func push_branch_if(self, anon cond: Cond, reg: Reg, target: str) -> none {
        self.put(INSN_BRANCH | ((BRANCH_IF | (cond_number(cond) << 2)) << 8), a: reg, b: self.add_str(target))
    }

    // The index of `text` in `strs`, added.
    func add_str(self, anon text: str) -> int64 {
        let k = len(self.strs)
        self.strs += [text]
        return k
    }

    // Instruction `i`, as `push` was given it.
    func at(self, anon i: int64) -> Insn {
        let tag = self.tags[i]
        let sub = tag >> 8
        let variant = tag & 255
        let a = self.fa[i]
        if variant == INSN_LABEL {
            return .Label(name: self.strs[a])
        }
        if variant == INSN_SLOT {
            return .Slot(store: sub == 1, reg: a, off: self.fb[i])
        }
        if variant == INSN_MOV {
            return .Mov(dst: a, src: self.fb[i])
        }
        if variant == INSN_MEM {
            let c = self.fc[i]
            let at_kind = (sub >> 1) & 3
            mut at: MemAt = .Base
            if at_kind == AT_OFFSET {
                at = .Offset(off: c)
            } else if at_kind == AT_INDEX {
                at = .Index(reg: c, scaled: (sub >> 3) == 1)
            } else if at_kind == AT_SYMBOL {
                at = .Symbol(name: self.strs[c], got: (sub >> 3) == 1)
            }
            return .Mem(load: (sub & 1) == 1, width: self.fd[i], reg: a, base: self.fb[i], :at)
        }
        if variant == INSN_DATA {
            return .Data(text: self.strs[a])
        }
        if variant == INSN_INTRINSIC {
            return .Intrinsic(label: self.strs[a])
        }
        if variant == INSN_LOAD_CONST {
            return .LoadConst(dst: a, value: self.fb[i])
        }
        if variant == INSN_PAIR {
            let off = self.fd[i]
            let mode_kind = sub >> 1
            mut mode: PairMode = .At(:off)
            if mode_kind == MODE_PRE {
                mode = .Pre(:off)
            } else if mode_kind == MODE_POST {
                mode = .Post(:off)
            }
            return .Pair(load: (sub & 1) == 1, :a, b: self.fb[i], base: self.fc[i], :mode)
        }
        if variant == INSN_OP {
            return .Op(op: opcode_of(sub), :a, b: self.fb[i], c: self.fc[i], d: self.fd[i], flags: self.fe[i])
        }
        if variant == INSN_CALL {
            return .Call(target: self.strs[a])
        }
        let branch = sub & 3
        mut kind: BranchKind = .Always
        if branch == BRANCH_IF {
            kind = .If(cond: cond_of(sub >> 2))
        } else if branch == BRANCH_IF_ZERO {
            kind = .IfZero
        } else if branch == BRANCH_IF_NONZERO {
            kind = .IfNonzero
        }
        return .Branch(:kind, reg: a, target: self.strs[self.fb[i]])
    }

    // Replaces instruction `i` by `insn` (its old strings stay in `strs`).
    func set(self, anon i: int64, insn: Insn) -> none {
        let one = InsnBuf()
        one.push(insn)
        self.tags[i] = one.tags[0]
        self.fa[i] = one.fa[0]
        self.fb[i] = one.fb[0]
        self.fc[i] = one.fc[0]
        self.fd[i] = one.fd[0]
        self.fe[i] = one.fe[0]
        self.own_str(i, src: one)
    }

    // Appends instruction `i` of `src`.
    func push_from(self, anon src: InsnBuf, i: int64) -> none {
        self.put(src.tags[i], a: src.fa[i], b: src.fb[i], c: src.fc[i], d: src.fd[i], e: src.fe[i])
        self.own_str(self.n - 1, src: src)
    }

    // Instruction `k`'s string field, if it has one, an index into `src.strs`
    // made one into this table.
    func own_str(self, anon k: int64, src: InsnBuf) -> none {
        let tag = self.tags[k]
        let variant = tag & 255
        if variant == INSN_LABEL or variant == INSN_DATA or variant == INSN_INTRINSIC or variant == INSN_CALL {
            self.fa[k] = self.add_str(src.strs[self.fa[k]])
        } else if variant == INSN_BRANCH {
            self.fb[k] = self.add_str(src.strs[self.fb[k]])
        } else if variant == INSN_MEM and ((tag >> 9) & 3) == AT_SYMBOL {
            self.fc[k] = self.add_str(src.strs[self.fc[k]])
        }
    }

    // Drops the last instruction.
    func pop(self) -> none {
        self.n = self.n - 1
    }

    // Whether instruction `i` is a Label whose name starts with `prefix`.
    func label_starts(self, anon i: int64, prefix: str) -> bool {
        return (self.tags[i] & 255) == INSN_LABEL and self.strs[self.fa[i]].starts_with(prefix)
    }

    // Appends an Op of opcode number `op`, its flags worked out (as `op` does).
    func push_new_op(self, anon op: int64, a: Reg = NO_REG, b: Reg = NO_REG, c: Reg = NO_REG, d: Reg = NO_REG) -> none {
        self.put(INSN_OP | (op << 8), :a, :b, :c, :d, e: op_flags(op: opcode_of(op), :a, :b, :c, :d))
    }

    // An empty InsnBuf for a pass to build from this one: it starts with this
    // one's strings, so copy_from can copy an instruction of this one as it is,
    // and room for as many instructions as this one has.
    func derived(self) -> InsnBuf {
        let room = self.n + 16
        return InsnBuf(tags: [0] * room, fa: [0] * room, fb: [0] * room, fc: [0] * room, fd: [0] * room, fe: [0] * room, strs: self.strs)
    }

    // A copy, sharing the arrays until either is written.
    func clone(self) -> InsnBuf {
        return InsnBuf(n: self.n, tags: self.tags, fa: self.fa, fb: self.fb, fc: self.fc, fd: self.fd, fe: self.fe, strs: self.strs)
    }

    // Appends instruction `i` of `src`, whose strings this one starts with
    // (see `derived`).
    func copy_from(self, anon src: InsnBuf, i: int64) -> none {
        self.put(src.tags[i], a: src.fa[i], b: src.fb[i], c: src.fc[i], d: src.fd[i], e: src.fe[i])
    }

    // Makes instruction `w` (which must have room) instruction `i` of `src`,
    // whose strings this one starts with: a pass that only drops and folds
    // instructions compacts its body in place this way.
    func move_from(self, anon w: int64, src: InsnBuf, i: int64) -> none {
        self.tags[w] = src.tags[i]
        self.fa[w] = src.fa[i]
        self.fb[w] = src.fb[i]
        self.fc[w] = src.fc[i]
        self.fd[w] = src.fd[i]
        self.fe[w] = src.fe[i]
    }

    // Makes instruction `w` (which must have room) an Op of opcode number
    // `op` and operands `a` to `c`, its flags worked out.
    func write_op(self, anon w: int64, op: int64, a: Reg, b: Reg, c: Reg) -> none {
        self.tags[w] = INSN_OP | (op << 8)
        self.fa[w] = a
        self.fb[w] = b
        self.fc[w] = c
        self.fd[w] = NO_REG
        self.fe[w] = op_flags(op: opcode_of(op), :a, :b, :c, d: NO_REG)
    }

    // Makes instruction `w` (which must have room) a Branch of sub fields
    // `sub` (see `push`), register `reg` and target `target` in `strs`.
    func write_branch(self, anon w: int64, sub: int64, reg: Reg, target: int64) -> none {
        self.tags[w] = INSN_BRANCH | (sub << 8)
        self.fa[w] = reg
        self.fb[w] = target
        self.fc[w] = 0
        self.fd[w] = 0
        self.fe[w] = 0
    }

    // Makes instruction `w` (which must have room) a Mov.
    func write_mov(self, anon w: int64, dst: Reg, src: Reg) -> none {
        self.tags[w] = INSN_MOV
        self.fa[w] = dst
        self.fb[w] = src
        self.fc[w] = 0
        self.fd[w] = 0
        self.fe[w] = 0
    }

    // Appends every instruction of `src`.
    func push_all(self, anon src: InsnBuf) -> none {
        for i in 0..src.n {
            self.push_from(src, :i)
        }
    }

    // The name of instruction `i` if it is a Label, else "".
    func label(self, anon i: int64) -> str {
        if (self.tags[i] & 255) == INSN_LABEL {
            return self.strs[self.fa[i]]
        }
        return ""
    }

    // Every instruction, in order.
    func to_insns(self) -> [Insn] {
        mut out: [Insn] = []
        for i in 0..self.n {
            out += [self.at(i)]
        }
        return out
    }
}

// An InsnBuf of `insns`.
func insn_buf(anon insns: [Insn]) -> InsnBuf {
    let buf = InsnBuf()
    for insn in insns {
        buf.push(insn)
    }
    return buf
}

// InsnBuf's variant tags.
let INSN_LABEL: int64 = 0
let INSN_SLOT: int64 = 1
let INSN_MOV: int64 = 2
let INSN_MEM: int64 = 3
let INSN_DATA: int64 = 4
let INSN_INTRINSIC: int64 = 5
let INSN_LOAD_CONST: int64 = 6
let INSN_PAIR: int64 = 7
let INSN_OP: int64 = 8
let INSN_CALL: int64 = 9
let INSN_BRANCH: int64 = 10
// A Mem's MemAt kind (Base is 0).
let AT_OFFSET: int64 = 1
let AT_INDEX: int64 = 2
let AT_SYMBOL: int64 = 3
// A Pair's PairMode kind (At is 0).
let MODE_PRE: int64 = 1
let MODE_POST: int64 = 2
// Opcode numbers (opcode_number) the passes look for.
let OP_MOVE: int64 = 0
let OP_ADD: int64 = 1
let OP_SUB: int64 = 2
let OP_COMPARE: int64 = 11
let OP_SET_IF: int64 = 13
let OP_CALL_INDIRECT: int64 = 23
let OP_RETURN: int64 = 24
// A Branch's BranchKind.
let BRANCH_ALWAYS: int64 = 0
let BRANCH_IF: int64 = 1
let BRANCH_IF_ZERO: int64 = 2
let BRANCH_IF_NONZERO: int64 = 3

func bit(anon b: bool) -> int64 {
    if b {
        return 1
    }
    return 0
}

// A condition's number in InsnBuf, in the order Cond lists them.
func cond_number(anon c: Cond) -> int64 {
    match c {
        .Eq -> return 0
        .Ne -> return 1
        .Hs -> return 2
        .Lo -> return 3
        .Hi -> return 4
        .Ls -> return 5
        .Mi -> return 6
        .Pl -> return 7
        .Vs -> return 8
        .Vc -> return 9
        .Ge -> return 10
        .Lt -> return 11
        .Gt -> return 12
        .Le -> return 13
    }
}

func cond_of(anon n: int64) -> Cond {
    match n {
        0 -> return .Eq
        1 -> return .Ne
        2 -> return .Hs
        3 -> return .Lo
        4 -> return .Hi
        5 -> return .Ls
        6 -> return .Mi
        7 -> return .Pl
        8 -> return .Vs
        9 -> return .Vc
        10 -> return .Ge
        11 -> return .Lt
        12 -> return .Gt
        else return .Le
    }
}

// An opcode's number in InsnBuf, in the order Opcode lists them.
func opcode_number(anon op: Opcode) -> int64 {
    match op {
        .Move -> return 0
        .Add -> return 1
        .Sub -> return 2
        .Mul -> return 3
        .DivSigned -> return 4
        .And -> return 5
        .Or -> return 6
        .Xor -> return 7
        .ShiftLeft -> return 8
        .ShiftRight -> return 9
        .ShiftRightSigned -> return 10
        .Compare -> return 11
        .CompareIf -> return 12
        .SetIf -> return 13
        .Select -> return 14
        .AddressPage -> return 15
        .FloatMove -> return 16
        .FloatAdd -> return 17
        .FloatSub -> return 18
        .FloatMul -> return 19
        .FloatDiv -> return 20
        .FloatNeg -> return 21
        .FloatCompare -> return 22
        .CallIndirect -> return 23
        .Return -> return 24
    }
}

func opcode_of(anon n: int64) -> Opcode {
    match n {
        0 -> return .Move
        1 -> return .Add
        2 -> return .Sub
        3 -> return .Mul
        4 -> return .DivSigned
        5 -> return .And
        6 -> return .Or
        7 -> return .Xor
        8 -> return .ShiftLeft
        9 -> return .ShiftRight
        10 -> return .ShiftRightSigned
        11 -> return .Compare
        12 -> return .CompareIf
        13 -> return .SetIf
        14 -> return .Select
        15 -> return .AddressPage
        16 -> return .FloatMove
        17 -> return .FloatAdd
        18 -> return .FloatSub
        19 -> return .FloatMul
        20 -> return .FloatDiv
        21 -> return .FloatNeg
        22 -> return .FloatCompare
        23 -> return .CallIndirect
        else return .Return
    }
}

type PoolState = shared struct {
    free_regs: [Reg]
    free_count: int64
    cs_in_use: int64
    live: [str]
    // The frame slot each of `live` is saved in.
    slots: [int64] = []
}

type RegPool = shared struct {
    // Indexed by vreg id; entries accumulate across all functions
    // in a module so `subst_vregs` at flush-out time can resolve
    // any vreg consistently. NOT reset by `reset` — the ids are
    // program-global by design.
    vreg_phys: [Reg] = []

    // Per-function state — `reset` clears these at the start of
    // every compile_func.
    // A stack: the first `free_count` are free; the rest are spare room, so
    // taking one and giving it back changes a count, not the array's length.
    free_regs: [Reg] = []
    free_count: int64 = 0
    cs_in_use: int64 = 0
    cs_high_water: int64 = 0
    // The vregs handed out and not yet freed, for `evict`.
    live: [str] = []
    // Whether `evict` ran in this function, so `run` must leave it alone.
    evicted: bool = false
    // After a strict `run` that failed: the local vreg ids (from its
    // `vreg_start`), all at or after its `droppable`, that it put back in
    // memory to make room, and whether some vreg got no register even so.
    dropped: [int64] = []
    stuck: bool = false

    // Reset per-function state. `vreg_phys` is intentionally left
    // alone — its ids stay valid across the whole module.
    func reset(self) -> none {
        self.free_regs = full_pool()
        self.free_count = len(self.free_regs)
        self.cs_in_use = 0
        self.cs_high_water = 0
        self.live = []
        self.evicted = false
    }

    // Hand every register back, for code too deep to compile with what is
    // left. The caller saves `live` to the frame around it, then calls
    // `restore`. Vregs now share physicals with ones that stay in use
    // after it, each pair apart only by that save, which `run` can't see.
    func evict(self) -> PoolState {
        let state = PoolState(free_regs: self.free_regs, free_count: self.free_count, cs_in_use: self.cs_in_use, live: self.live)
        self.free_regs = full_pool()
        self.free_count = len(self.free_regs)
        self.cs_in_use = 0
        self.live = []
        self.evicted = true
        return state
    }

    func restore(self, anon state: PoolState) -> none {
        self.free_regs = state.free_regs
        self.free_count = state.free_count
        self.cs_in_use = state.cs_in_use
        self.live = state.live
    }

    // Allocate a fresh virtual register backed by a physical from
    // the free pool. The returned string is a vreg name (`v<id>`)
    // that the emit layer threads into asm; `subst_vregs` later
    // resolves it to `vreg_phys[id]`. The initial alloc-time
    // assignment is just whatever phys was at the tail of the pool;
    // `run` may rewrite it (within the same class) once the body
    // is buffered.
    func alloc_reg(self) -> str {
        let n = self.free_count
        if n == 0 {
            panic("compiler bug: out of registers; `compile_expr` evicts before this can happen, so a site is holding too many without compiling an expression")
        }
        mut phys = self.free_regs[n - 1]
        self.free_count = n - 1
        if is_callee_saved_phys(phys) {
            self.cs_in_use = self.cs_in_use + 1
            if self.cs_in_use > self.cs_high_water {
                self.cs_high_water = self.cs_in_use
            }
        }
        let id: int64 = len(self.vreg_phys)
        self.vreg_phys += [phys]
        let name = f"v{id}"
        self.live += [name]
        return name
    }

    // Return a register to the pool. Accepts either a vreg name
    // (from `alloc_reg`) or a physical name passed in directly by
    // sites that hardcode ABI registers (e.g. freeing `x0` after a
    // `bl`). For the hardcoded path, x0-x7 are skipped — they hold
    // call args/results and never enter the pool.
    func free_reg(self, anon reg: str) -> none {
        let r = reg_of(reg)
        mut phys: Reg = r
        if (r & 3) == 1 {
            phys = self.vreg_phys[r >> 2]
            // In place, keeping the order (evict saves them in it), then one copy.
            let n = len(self.live)
            mut kept = 0
            for i in 0..n {
                let name = self.live[i]
                if name != reg {
                    self.live[kept] = name
                    kept += 1
                }
            }
            if kept < n {
                self.live = self.live[0..kept]
            }
        }
        if arrays.contains(TARGET.arg_regs, phys) {
            return
        }
        if is_callee_saved_phys(phys) {
            self.cs_in_use = self.cs_in_use - 1
        }
        if self.free_count < len(self.free_regs) {
            self.free_regs[self.free_count] = phys
        } else {
            self.free_regs += [phys]
        }
        self.free_count += 1
    }

    // Whether the next alloc_reg hands out a register that survives a call.
    func next_is_callee_saved(self) -> bool {
        return self.free_count > 0 and is_callee_saved_phys(self.free_regs[self.free_count - 1])
    }

    // True if `reg` is (or resolves to) a callee-saved physical.
    // Accepts vreg names too — the alloc-time class is the one
    // recorded in `vreg_phys[id]`.
    func is_callee_saved(self, anon reg: str) -> bool {
        let r = reg_of(reg)
        mut phys: Reg = r
        if (r & 3) == 1 {
            phys = self.vreg_phys[r >> 2]
        }
        return is_callee_saved_phys(phys)
    }
}

// Mnemonics whose first operand is the destination — for those a
// vreg at op-position 0 (outside brackets) is a def, not a use.
// Everything else treats all vreg operands as reads. ldp/stp don't
// appear with vregs in our codegen (only hardcoded sp/fp/lr/cs regs).
//
// Missing an entry here causes a silent miscompile: regalloc never
// sees the destination as a def, so the def_line stays -1 and the
// vreg keeps its alloc-time phys — but downstream vregs may end up
// sharing that phys because regalloc thinks the slot is free.
func is_callee_saved_phys(anon phys: Reg) -> bool {
    let k = phys >> 2
    return (phys & 3) == 0 and k < len(CALLEE_SAVED) and CALLEE_SAVED[k]
}

// Whether each of NAMES is in TARGET.callee_saved, up to the last that is: the
// test above runs for most registers the allocator touches.
mut CALLEE_SAVED: [bool] = callee_saved_set()

func callee_saved_set() -> [bool] {
    mut top: int64 = 0
    for reg in TARGET.callee_saved {
        if reg >> 2 > top {
            top = reg >> 2
        }
    }
    mut set: [bool] = [false] * (top + 1)
    for reg in TARGET.callee_saved {
        set[reg >> 2] = true
    }
    return set
}

// Dense callee-saved name by 0-based slot. `pack` writes back via
// these so the prologue can save `cs_reg(0)..cs_reg(N-1)` in order.
func cs_reg(anon n: int64) -> Reg {
    return TARGET.save_order[n]
}

// Scan one Raw line, mutating `def_line` / `last_use` for any vreg
// tokens it contains. A vreg token is `v<digits>` or `w<digits>` not
// touching a symbol character (see `is_sym_char`) and outside string
// quotes; the `w` form is the 32-bit alias used by the single
// byte-load site. A vreg in the first operand of a writer mnemonic
// (outside brackets) is a def; everything else is a use.
// Returns whether the line calls something (`bl`, `blr`, but not a panic) or names one of
// the caller-saved x8-x15 itself, so a value in one of those doesn't
// survive it; and records in `first` the line each vreg is first named on.
func never_returns(anon target: str) -> bool {
    return target == "_kod_index_oob" or target == "_kod_div_zero" or target == "_kod_panic" or target == "_kod_panic_owned"
}

// The runtime's stubs that change only x16, x17, lr and the flags, so a value
// can stay in any register across a call to one.
func keeps_regs(anon target: str) -> bool {
    return target == "_rc_retain_stub" or target == "_rc_release_stub" or target == "_kod_arr_unique_stub" or target == "_kod_obj_unique_stub"
}

// How many times each of the function's vregs (ids vreg_start up to
// vreg_start + n_local) is named in `body`, as a def or a use.
func vreg_counts(anon body: InsnBuf, vreg_start: int64, n_local: int64) -> [int64] {
    mut counts: [int64] = [0] * n_local
    for i in 0..body.n {
        let variant = body.tags[i] & 255
        // Op names fa to fd, Mem fa, fb and an index in fc, Mov fa and fb,
        // LoadConst, Slot and Branch fa.
        if variant == INSN_LABEL or variant == INSN_DATA or variant == INSN_CALL or variant == INSN_INTRINSIC or variant == INSN_PAIR {
            continue
        }
        // A LoadConst names it on each of its lines, as its text has it.
        mut times = 1
        if variant == INSN_LOAD_CONST {
            times = LOAD_CONST_LINES
        }
        let a = (body.fa[i] >> 2) - vreg_start
        if (body.fa[i] & 3) != 0 and (body.fa[i] & 3) != 3 and a >= 0 and a < n_local {
            counts[a] += times
        }
        if variant == INSN_SLOT or variant == INSN_BRANCH or variant == INSN_LOAD_CONST {
            continue
        }
        let b = (body.fb[i] >> 2) - vreg_start
        if (body.fb[i] & 3) != 0 and (body.fb[i] & 3) != 3 and b >= 0 and b < n_local {
            counts[b] += 1
        }
        if variant == INSN_MOV or (variant == INSN_MEM and ((body.tags[i] >> 9) & 3) != AT_INDEX) {
            continue
        }
        let c = (body.fc[i] >> 2) - vreg_start
        if (body.fc[i] & 3) != 0 and (body.fc[i] & 3) != 3 and c >= 0 and c < n_local {
            counts[c] += 1
        }
        if variant == INSN_MEM {
            continue
        }
        let d = (body.fd[i] >> 2) - vreg_start
        if (body.fd[i] & 3) != 0 and (body.fd[i] & 3) != 3 and d >= 0 and d < n_local {
            counts[d] += 1
        }
    }
    return counts
}

// An `Op` operand's part in the liveness `run` works out: first named, defined
// (when `written`), last used.
// Each local vreg's lines, as `run` works them out: where it's defined, last
// used and first named, -1 for none.
type Liveness = shared struct {
    def_line: [int64]
    last_use: [int64]
    first: [int64]
}

func note_operand(anon operand: Reg, written: bool, line_idx: int64, vreg_start: int64, n_local: int64, lv: Liveness) -> none {
    let id = reg_vreg(operand)
    if id < vreg_start or id >= vreg_start + n_local {
        return
    }
    let local_id = id - vreg_start
    if lv.first[local_id] < 0 {
        lv.first[local_id] = line_idx
    }
    if written and lv.def_line[local_id] == -1 {
        lv.def_line[local_id] = line_idx
    }
    // Never earlier: a cold block's line counts as its check's.
    if lv.last_use[local_id] < line_idx {
        lv.last_use[local_id] = line_idx
    }
}

// Constrained linear scan for one function's vregs. Vregs are
// partitioned by alloc-time class; each class's pool is the set of
// distinct alloc-time physicals from that class. Walk vregs in
// def_line order; expire intervals that ended before the current
// def; pop a free phys (preferring reuse). Mutates `pool.vreg_phys`
// in place over `[vreg_start, len(pool.vreg_phys))`.
//
// `strict` is for a body whose vregs aren't all expression temporaries (see
// codegen's promote_locals): a vreg live at the top of a loop is kept to the
// loop's backward branch, every register is in the pools, and running out of
// them is a failure (false) instead of a fall back to the alloc-time
// register, which only temporaries can share safely.
func run(body_buf: InsnBuf, pool: RegPool, vreg_start: int64, strict: bool = false, droppable: int64 = -1) -> bool {
    // Read through the pool: a second holder would make the write-back copy it.
    let vreg_end: int64 = len(pool.vreg_phys)
    let n_local: int64 = vreg_end - vreg_start
    if n_local <= 0 {
        return true
    }

    let lv = Liveness(def_line: [-1] * n_local, last_use: [-1] * n_local, first: [-1] * n_local)

    let body = body_buf
    let n = body.n
    // clobbers_before[k]: how many lines before line k call something or
    // name a caller-saved register outright.
    mut clobbers_before: [int64] = [0] * (n + 1)
    // A cold block (codegen's emit_index_check) runs only at its check, so
    // its lines count as the check's line: what it reads isn't kept live to
    // where it's laid out.
    let pos = cold_positions(body)
    for ri in 0..n {
        let line_idx = pos[ri]
        mut clobbers = 0
        let tag = body.tags[ri]
        let variant = tag & 255
        let sub = tag >> 8
        if variant == INSN_SLOT {
            let reg = body.fa[ri]
            if reg_clobbers(reg) {
                clobbers = 1
            }
            // A load writes its register; a store reads it.
            note_operand(reg, written: sub == 0, :line_idx, :vreg_start, :n_local, :lv)
        } else if variant == INSN_MOV {
            let dst = body.fa[ri]
            let src = body.fb[ri]
            if reg_clobbers(dst) or reg_clobbers(src) {
                clobbers = 1
            }
            // As in its text: `dst` is written, then `src` read, on this line.
            note_operand(dst, written: true, :line_idx, :vreg_start, :n_local, :lv)
            note_operand(src, written: false, :line_idx, :vreg_start, :n_local, :lv)
        } else if variant == INSN_INTRINSIC {
            // Only the argument registers: no vregs.
            if (intrinsic_flags(body.strs[body.fa[ri]]) & INFO_CLOBBERS) != 0 {
                clobbers = 1
            }
        } else if variant == INSN_LOAD_CONST {
            let dst = body.fa[ri]
            if reg_clobbers(dst) {
                clobbers = 1
            }
            // The `mov` writes it; the `movk`s after it read and write it.
            note_operand(dst, written: true, :line_idx, :vreg_start, :n_local, :lv)
        } else if variant == INSN_PAIR {
            // No vregs: the frame link and the callee-saved registers.
            if reg_clobbers(body.fa[ri]) or reg_clobbers(body.fb[ri]) {
                clobbers = 1
            }
        } else if variant == INSN_MEM {
            let reg = body.fa[ri]
            let base = body.fb[ri]
            mut index = NO_REG
            if ((sub >> 1) & 3) == AT_INDEX {
                index = body.fc[ri]
            }
            if reg_clobbers(reg) or reg_clobbers(base) or reg_clobbers(index) {
                clobbers = 1
            }
            // As in its text: `reg` (written by a load), then `base`, read.
            note_operand(reg, written: mem_writes(load: (sub & 1) == 1, width: body.fd[ri]), :line_idx, :vreg_start, :n_local, :lv)
            note_operand(base, written: false, :line_idx, :vreg_start, :n_local, :lv)
            note_operand(index, written: false, :line_idx, :vreg_start, :n_local, :lv)
        } else if variant == INSN_OP {
            if (body.fe[ri] & INFO_CLOBBERS) != 0 {
                clobbers = 1
            }
            note_operand(body.fa[ri], written: writes_first_op_number(sub), :line_idx, :vreg_start, :n_local, :lv)
            note_operand(body.fb[ri], written: false, :line_idx, :vreg_start, :n_local, :lv)
            note_operand(body.fc[ri], written: false, :line_idx, :vreg_start, :n_local, :lv)
            note_operand(body.fd[ri], written: false, :line_idx, :vreg_start, :n_local, :lv)
        } else if variant == INSN_CALL {
            let target = body.strs[body.fa[ri]]
            if not never_returns(target) and not keeps_regs(target) {
                clobbers = 1
            }
        } else if variant == INSN_BRANCH {
            let reg = body.fa[ri]
            if reg_clobbers(reg) {
                clobbers = 1
            }
            note_operand(reg, written: false, :line_idx, :vreg_start, :n_local, :lv)
        }
        // Label and Data lines name no register.
        clobbers_before[ri + 1] = clobbers_before[ri] + clobbers
    }

    if strict {
        // A vreg named before its first def (a loop reading what the
        // previous time round set) is live from there.
        for k in 0..n_local {
            if lv.first[k] >= 0 and (lv.def_line[k] < 0 or lv.first[k] < lv.def_line[k]) {
                lv.def_line[k] = lv.first[k]
            }
        }
        extend_over_loops(body_buf, :lv, :pos)
    }

    // Snapshot alloc-time phys per local vreg; this is also the
    // pool we draw from (deduped, partitioned by class).
    let alloc_phys: [Reg] = pool.vreg_phys[vreg_start..vreg_end]

    mut free_callee: [Reg] = []
    mut free_caller: [Reg] = []
    for k in 0..n_local {
        let p: Reg = alloc_phys[k]
        if is_callee_saved_phys(p) {
            if not arrays.contains(free_callee, p) {
                free_callee += [p]
            }
        } else {
            if not arrays.contains(free_caller, p) {
                free_caller += [p]
            }
        }
    }
    // A callee-saved vreg that no call or named scratch register comes
    // between the def and the last use of can take any caller-saved one,
    // which the prologue needn't save.
    let target = TARGET
    for p in target.caller_saved {
        if not arrays.contains(free_caller, p) {
            free_caller = [p] + free_caller
        }
    }
    if strict {
        for p in target.callee_saved {
            if not arrays.contains(free_callee, p) {
                free_callee = [p] + free_callee
            }
        }
    }
    mut ok = true
    pool.dropped = []
    pool.stuck = false

    // Vreg indices by def_line ascending, equal ones in index order. A
    // counting sort: def_line is -1 or a line index.
    mut top: int64 = 0
    for line in lv.def_line {
        if line > top {
            top = line
        }
    }
    mut next: [int64] = [0] * (top + 3)
    for line in lv.def_line {
        next[line + 2] += 1
    }
    for b in 1..top + 3 {
        next[b] += next[b - 1]
    }
    mut order: [int64] = [0] * n_local
    for k in 0..n_local {
        let b = lv.def_line[k] + 1
        order[next[b]] = k
        next[b] += 1
    }

    // Walk vregs in def order; maintain active list (alive intervals).
    // The lists and the free pools are stacks with a count: an element past
    // the count is spare room, so taking and expiring don't copy them.
    mut active_id: [int64] = []
    mut active_use: [int64] = []
    mut active_phys: [Reg] = []
    mut n_active = 0
    mut n_callee = len(free_callee)
    mut n_caller = len(free_caller)
    mut new_phys: [Reg] = pool.vreg_phys[vreg_start..vreg_end]

    for oi in 0..n_local {
        let local_id: int64 = order[oi]
        let d: int64 = lv.def_line[local_id]
        if d == -1 {
            // Allocated but never defined in the emitted body — keep
            // its alloc-time phys (the safe default), unless it isn't
            // named at all, when it needn't count as a register to save.
            if lv.last_use[local_id] == -1 {
                new_phys[local_id] = target.unused
            }
            continue
        }
        let may_callee: bool = is_callee_saved_phys(alloc_phys[local_id])
        mut cls_callee: bool = may_callee
        let u: int64 = lv.last_use[local_id]
        if cls_callee and u > d and clobbers_before[u] - clobbers_before[d + 1] == 0 {
            cls_callee = false
        }

        // Expire actives whose last_use <= this def line. The `<=`
        // (vs `<`) lets a `mov vDst, vSrc` whose vSrc dies at the mov
        // hand its phys to vDst on the spot — the mov substitutes to
        // `mov xN, xN` (self-mov) which `flush_out` drops. ARM64 reads
        // all sources before writing the dest, so sharing a phys
        // between dying-source and just-defined-dest on the same line
        // is well-defined for every mnemonic we emit.
        // Compacted in place, in order.
        mut kept = 0
        for ai in 0..n_active {
            if active_use[ai] <= d {
                let ap: Reg = active_phys[ai]
                if is_callee_saved_phys(ap) {
                    if n_callee < len(free_callee) {
                        free_callee[n_callee] = ap
                    } else {
                        free_callee += [ap]
                    }
                    n_callee += 1
                } else {
                    if n_caller < len(free_caller) {
                        free_caller[n_caller] = ap
                    } else {
                        free_caller += [ap]
                    }
                    n_caller += 1
                }
            } else {
                active_id[kept] = active_id[ai]
                active_use[kept] = active_use[ai]
                active_phys[kept] = active_phys[ai]
                kept += 1
            }
        }
        n_active = kept

        // Pop a phys from the matching class's free pool.
        mut chosen: Reg = NO_REG
        if cls_callee {
            if n_callee > 0 {
                n_callee -= 1
                chosen = free_callee[n_callee]
            }
        } else {
            if n_caller > 0 {
                n_caller -= 1
                chosen = free_caller[n_caller]
            } else if may_callee and n_callee > 0 {
                // No call comes between, so a caller-saved register would
                // do; with none free, a callee-saved one does as well.
                n_callee -= 1
                chosen = free_callee[n_callee]
            }
        }
        if chosen == NO_REG and strict and droppable >= 0 {
            // Out of registers: of this vreg and the ones holding a register
            // of its class, the droppable one used least (droppable vregs
            // are numbered most used first) goes back to memory, and the
            // scan goes on as if it had.
            ok = false
            mut victim = -1
            if local_id >= droppable {
                victim = local_id
            }
            mut victim_at = -1
            for ai in 0..n_active {
                let aid = active_id[ai]
                if aid >= droppable and is_callee_saved_phys(active_phys[ai]) == cls_callee and aid > victim {
                    victim = aid
                    victim_at = ai
                }
            }
            if victim >= 0 {
                pool.dropped += [victim]
                if victim == local_id {
                    new_phys[local_id] = alloc_phys[local_id]
                    continue
                }
                chosen = active_phys[victim_at]
                // Out of the active list, the rest moved down in order.
                for ai in victim_at + 1..n_active {
                    active_id[ai - 1] = active_id[ai]
                    active_use[ai - 1] = active_use[ai]
                    active_phys[ai - 1] = active_phys[ai]
                }
                n_active -= 1
            }
        }
        if chosen == NO_REG {
            // Without `strict` this can't happen: pool size equals
            // alloc-time pressure. Fall back to the alloc-time phys.
            ok = false
            if strict {
                pool.stuck = true
            }
            chosen = alloc_phys[local_id]
        }
        new_phys[local_id] = chosen
        if n_active < len(active_id) {
            active_id[n_active] = local_id
            active_use[n_active] = lv.last_use[local_id]
            active_phys[n_active] = chosen
        } else {
            active_id += [local_id]
            active_use += [lv.last_use[local_id]]
            active_phys += [chosen]
        }
        n_active += 1
    }

    // Write back.
    for k in 0..n_local {
        pool.vreg_phys[vreg_start + k] = new_phys[k]
    }
    return ok or not strict
}

// A vreg live at a loop's top label, set before the loop, stays live to
// the loop's backward branch, which takes its value round again: the
// textual interval alone would end at its last use inside the loop.
// Each line's position for liveness: its own, or for a line of a cold block
// (a label `Lcold...` some branch goes to, through its call to the panic)
// the line of that branch.
func cold_positions(anon body: InsnBuf) -> [int64] {
    let n = body.n
    mut pos: [int64] = [0] * n
    for i in 0..n {
        pos[i] = i
    }
    mut origin = Map[str, int64]()
    mut any = false
    for i in 0..n {
        if (body.tags[i] & 255) == INSN_BRANCH and body.strs[body.fb[i]].starts_with("Lcold") {
            let target = body.strs[body.fb[i]]
            if origin.get(target) is none {
                origin[target] = i
                any = true
            }
        }
    }
    if not any {
        return pos
    }
    mut at = -1
    for i in 0..n {
        let variant = body.tags[i] & 255
        if variant == INSN_LABEL and body.strs[body.fa[i]].starts_with("Lcold") {
            let name = body.strs[body.fa[i]]
            if not name.ends_with("_oob") {
                at = origin.get(name)? or -1
            }
        }
        if at >= 0 {
            pos[i] = at
            if variant == INSN_CALL {
                at = -1
            }
        }
    }
    return pos
}

func extend_over_loops(anon body: InsnBuf, lv: Liveness, pos: [int64]) -> none {
    let n = body.n
    mut label_line = Map[str, int64]()
    for i in 0..n {
        // A statement's line marker and the skip after a release are never
        // where a branch goes back to, and are most of the labels.
        if (body.tags[i] & 255) == INSN_LABEL and not body.strs[body.fa[i]].starts_with("Lline") and not body.strs[body.fa[i]].starts_with("Lrc") {
            label_line.set(body.strs[body.fa[i]], i)
        }
    }
    mut tops: [int64] = []
    mut bottoms: [int64] = []
    for i in 0..n {
        // A cold block's jump back is no loop.
        if (body.tags[i] & 255) == INSN_BRANCH and pos[i] == i {
            if label_line.get(body.strs[body.fb[i]]) is Some(t) {
                if t <= i {
                    tops += [t]
                    bottoms += [i]
                }
            }
        }
    }
    if len(tops) == 0 {
        return none
    }
    // By top, so one pass per vreg is enough: its end only grows, and a loop
    // it skipped for starting after its end starts after every later end too.
    let nl = len(tops)
    for a in 1..nl {
        mut b = a
        for b > 0 and tops[b - 1] > tops[b] {
            let t = tops[b]
            tops[b] = tops[b - 1]
            tops[b - 1] = t
            let bt = bottoms[b]
            bottoms[b] = bottoms[b - 1]
            bottoms[b - 1] = bt
            b -= 1
        }
    }
    for k in 0..len(lv.def_line) {
        let d = lv.def_line[k]
        if d < 0 {
            continue
        }
        mut u = lv.last_use[k]
        // The first loop starting after `d`.
        mut lo = 0
        mut hi = nl
        for lo < hi {
            let mid = (lo + hi) / 2
            if tops[mid] <= d {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        for e in lo..nl {
            if tops[e] > u {
                break
            }
            if u < bottoms[e] {
                u = bottoms[e]
            }
        }
        lv.last_use[k] = u
    }
}

// Pack the function's actually-used callee-saved registers into a
// dense `x19..x{19+N-1}` prefix and return `N` (the new
// callee-saved high-water mark).
//
// The prologue/epilogue saves the FIRST `N` callee-saved registers
// (cs_reg(0)=x19, cs_reg(1)=x20, …); regalloc can leave gaps in that
// sequence (e.g. use x19 and x21 but skip x20), and the alloc-time
// high-water mark over-saves to cover them. Packing makes the saved
// set match the used set exactly, dropping unnecessary stp/ldp pairs
// from the prologue.
//
// Safe because all reassignments stay inside the callee-saved class —
// every site that asked `is_callee_saved(vreg)` at emit time still
// gets the same answer, so spill_across decisions remain correct.
func pack(pool: RegPool, vreg_start: int64) -> int64 {
    let vreg_end: int64 = len(pool.vreg_phys)
    mut used: [Reg] = []
    for i in vreg_start..vreg_end {
        let p: Reg = pool.vreg_phys[i]
        if is_callee_saved_phys(p) and not arrays.contains(used, p) {
            used += [p]
        }
    }
    for i in vreg_start..vreg_end {
        let p: Reg = pool.vreg_phys[i]
        if is_callee_saved_phys(p) {
            mut j: int64 = 0
            mut found: int64 = -1
            for j < len(used) and found < 0 {
                if used[j] == p {
                    found = j
                }
                j = j + 1
            }
            if found >= 0 {
                pool.vreg_phys[i] = cs_reg(found)
            }
        }
    }
    return len(used)
}

// Loads made once (docs/ir.md, step 13). `reuse_loads` walks a function's
// body in vregs, in layout order, numbering values: a vreg gets a value
// number where it is written and keeps it while nothing writes it. A load is
// known by its address in value numbers; one whose value a vreg still holds
// becomes a `mov` from it. What is known about memory is a list of facts.

// How many changes of value numbers a join looks back over before it
// forgets everything instead.
let LOG_REACH: int64 = 512
// The most facts kept: past it, the oldest go.
let FACTS_CAP: int64 = 32
// A fact is FACT_WORDS numbers in a row: what its address is (FACT_ below),
// the base's value number, the offset, the index's value number (with the
// width, +16 when the index is scaled), the width, the value's number, and
// the local vreg holding it (-1 for none).
let FACT_WORDS: int64 = 7
// What a fact's address is: a field or header word (a base and an offset),
// an element (a base, an offset and an index), or a frame slot (an offset
// from fp).
let FACT_FIELD: int64 = 0
let FACT_ELEM: int64 = 1
let FACT_SLOT: int64 = 2
// What an instruction may change in memory, as a mask: the count words (a
// field at a negative offset, or any of 4 bytes), the elements, every field
// and header word (the count words too), the frame slots.
let KILL_COUNT: int64 = 1
let KILL_ELEM: int64 = 2
let KILL_FIELD: int64 = 4
let KILL_HEAP: int64 = 6
let KILL_SLOTS: int64 = 8
// The value number of the constant 1, a count once a copy-on-write check passed.
let VN_ONE: int64 = -3

// The value number of the constant `k` (0 or more): negative, so no fresh one
// is ever equal to it.
func const_vn(anon k: int64) -> int64 {
    return -(k + 2)
}

// Rewrites `body` (vregs `vreg_start` up to `vreg_start + n_local`) in place:
// each load whose value a vreg holds becomes a `mov` from it, and each
// copy-on-write check whose array is known to be its place's own goes.
// Returns how many lines changed.
func reuse_loads(anon body: InsnBuf, vreg_start: int64, n_local: int64) -> int64 {
    if n_local <= 0 {
        return 0
    }
    let r = LoadReuse(:body, :vreg_start, :n_local)
    if not r.prepare() {
        return 0
    }
    r.walk()
    r.compact()
    return r.changed
}

// Whether `body` changes an array in place (has a copy-on-write check):
// the code reuse_loads is for (see codegen's compile_func).
func changes_arrays(anon body: InsnBuf) -> bool {
    let tags = body.tags
    for i in 0..body.n {
        if (tags[i] & 255) == INSN_CALL and is_unique_stub(body.strs[body.fa[i]]) {
            return true
        }
    }
    return false
}

type LoadReuse = shared struct {
    body: InsnBuf
    vreg_start: int64
    n_local: int64
    changed: int64 = 0
    // The facts now: the first `nf` of `facts` (FACT_WORDS each), and their
    // version, which no other content of facts had (see meet_with).
    facts: [int64] = []
    nf: int64 = 0
    fver: int64 = 0
    vers: int64 = 0
    // Whether this line can be reached at all.
    reachable: bool = true
    // Per local vreg: its value number, valid while its epoch is `epoch`.
    reg_vn: [int64] = []
    reg_epoch: [int64] = []
    epoch: int64 = 1
    // Value numbers: an add of a constant is its base's base plus an offset.
    next_vn: int64 = 1
    vn_base: [int64] = []
    vn_off: [int64] = []
    // Each change of a local vreg's value number, by line, in order: the
    // first `n_log`.
    log_line: [int64] = []
    log_reg: [int64] = []
    n_log: int64 = 0
    // Per local vreg: the label line that last gave it a new value number.
    renewed_at: [int64] = []
    // Whether the function takes an address in its frame (other than a
    // copy-on-write check's place), so any store or call may write a slot.
    frame_addr: bool = false
    // Per line: a branch's target and a label's own number among the
    // labels (-1 for none).
    target: [int64] = []
    ord: [int64] = []
    // The lines dropped checks took: from each of drop_from up to its drop_to.
    drop_from: [int64] = []
    drop_to: [int64] = []
    // The line the walk goes on at, past a dropped check (-1: none).
    skip_to: int64 = -1
    // Per label, by its number: its line, how many branches go to it, the
    // lines of the first and last of them, and the first of the branches
    // back to it (an index into back_line, -1 for none).
    lab_line: [int64] = []
    refs: [int64] = []
    ref_first: [int64] = []
    ref_last: [int64] = []
    back_head: [int64] = []
    // The branches back to a label: their lines, each list linked by back_next.
    back_line: [int64] = []
    back_next: [int64] = []
    // Per label: the facts its forward branches had, met (with their count
    // and version), and the first of those branches (-1 for none yet).
    pend: [[int64]] = []
    pend_n: [int64] = []
    pend_ver: [int64] = []
    pend_line: [int64] = []
    // Per label closing a copy-on-write check: the place's fact (kind, base,
    // off), the array's vreg, and whether its count is then 1 (an array's
    // check; a struct's leaves a constant one as it is); kind -1 for none.
    uniq_kind: [int64] = []
    uniq_one: [bool] = []
    uniq_base: [int64] = []
    uniq_off: [int64] = []
    uniq_reg: [int64] = []
    // A store's slot, as slot_store leaves it: its offset and width (0: none).
    store_off: int64 = 0
    store_width: int64 = 0

    // Works out the labels and branches; false when the body has nothing to reuse.
    func prepare(self) -> bool {
        let b = self.body
        let n = b.n
        mut loads = 0
        mut nl = 0
        for i in 0..n {
            let tag = b.tags[i]
            let variant = tag & 255
            if variant == INSN_LABEL {
                nl += 1
            } else if variant == INSN_MEM and ((tag >> 8) & 1) == 1 and b.fb[i] != FP {
                loads += 1
            }
        }
        if loads < 2 {
            return false
        }
        // The labels by their names: a table of label numbers + 1, by a
        // hash of the name's end (labels differ in their numbers).
        mut size = 16
        for size < nl * 2 {
            size = size * 2
        }
        let mask = size - 1
        mut table = [0] * size
        self.ord = [-1] * n
        self.lab_line = [0] * nl
        mut k = 0
        for i in 0..n {
            if (b.tags[i] & 255) == INSN_LABEL {
                self.ord[i] = k
                self.lab_line[k] = i
                mut h = label_hash(b.strs[b.fa[i]]) & mask
                for table[h] != 0 {
                    h = (h + 1) & mask
                }
                table[h] = k + 1
                k += 1
            }
        }
        self.refs = [0] * nl
        self.ref_first = [-1] * nl
        self.ref_last = [-1] * nl
        self.back_head = [-1] * nl
        self.target = [-1] * n
        for i in 0..n {
            let tag = b.tags[i]
            let variant = tag & 255
            if variant == INSN_BRANCH {
                let t = self.label_named(b.strs[b.fb[i]], :table, :mask)
                self.target[i] = t
                if t >= 0 {
                    if self.refs[t] == 0 {
                        self.ref_first[t] = i
                    }
                    self.refs[t] += 1
                    self.ref_last[t] = i
                    if i > self.lab_line[t] {
                        self.back_line += [i]
                        self.back_next += [self.back_head[t]]
                        self.back_head[t] = len(self.back_line) - 1
                    }
                }
            } else if variant == INSN_OP {
                let a = b.fa[i]
                let ob = b.fb[i]
                let oc = b.fc[i]
                let od = b.fd[i]
                if (ob == FP or ob == SP or oc == FP or oc == SP or od == FP or od == SP) and a != FP and a != SP and not self.check_place_at(i) {
                    self.frame_addr = true
                }
                // A label as an operand (its address taken): reached from anywhere.
                self.note_label_operand(ob, :table, :mask)
                self.note_label_operand(oc, :table, :mask)
                self.note_label_operand(od, :table, :mask)
            } else if variant == INSN_MOV {
                let src = b.fb[i]
                let dst = b.fa[i]
                if (src == FP or src == SP) and dst != FP and dst != SP {
                    self.frame_addr = true
                }
            } else if variant == INSN_MEM {
                if b.fa[i] == FP or b.fa[i] == SP {
                    self.frame_addr = true
                }
                if ((tag >> 9) & 3) == AT_SYMBOL {
                    self.reached_anywhere(self.label_named(b.strs[b.fc[i]], :table, :mask))
                }
            }
        }
        self.facts = [0] * (FACTS_CAP * FACT_WORDS)
        self.reg_vn = [0] * self.n_local
        self.reg_epoch = [0] * self.n_local
        self.renewed_at = [-1] * self.n_local
        let room = n / 4 + 64
        self.vn_base = [0] * room
        self.vn_off = [0] * room
        self.log_line = [0] * room
        self.log_reg = [0] * room
        let none_yet: [int64] = []
        self.pend = [none_yet] * nl
        self.pend_n = [0] * nl
        self.pend_ver = [0] * nl
        self.pend_line = [-1] * nl
        self.uniq_kind = [-1] * nl
        self.uniq_base = [0] * nl
        self.uniq_off = [0] * nl
        self.uniq_reg = [0] * nl
        self.uniq_one = [false] * nl
        return true
    }

    // The number of the label named `name`, or -1.
    func label_named(self, anon name: str, table: [int64], mask: int64) -> int64 {
        let b = self.body
        mut h = label_hash(name) & mask
        for table[h] != 0 {
            let k = table[h] - 1
            if b.strs[b.fa[self.lab_line[k]]] == name {
                return k
            }
            h = (h + 1) & mask
        }
        return -1
    }

    // Label `t` (-1: none) can be reached from anywhere.
    func reached_anywhere(self, anon t: int64) -> none {
        if t >= 0 {
            self.refs[t] += 1
            self.ref_first[t] = 0
            self.ref_last[t] = self.body.n
            self.back_head[t] = -2
        }
    }

    // A label named as operand `r` can be reached from anywhere.
    func note_label_operand(self, anon r: Reg, table: [int64], mask: int64) -> none {
        if (r & 3) != 0 or r <= XZR {
            return
        }
        let name = NAMES[r >> 2]
        if len(name) > 0 and name[0] == 'L' {
            self.reached_anywhere(self.label_named(name, :table, :mask))
        }
    }

    // Whether line `i` is `sub x16, fp, #n` giving a copy-on-write stub its place.
    func check_place_at(self, anon i: int64) -> bool {
        let b = self.body
        if b.tags[i] != (INSN_OP | (OP_SUB << 8)) or b.fa[i] != X16 or b.fb[i] != FP or (b.fc[i] & 3) != 3 {
            return false
        }
        for k in i + 1..i + 3 {
            if k < b.n and (b.tags[k] & 255) == INSN_CALL and is_unique_stub(b.strs[b.fa[k]]) {
                return true
            }
        }
        return false
    }

    // The local id of vreg operand `reg`, or -1.
    func local(self, anon reg: Reg) -> int64 {
        let tag = reg & 3
        if tag != 1 and tag != 2 {
            return -1
        }
        let id = (reg >> 2) - self.vreg_start
        if id < 0 or id >= self.n_local {
            return -1
        }
        return id
    }

    // The facts changed: a new version.
    func bump(self) -> none {
        self.vers += 1
        self.fver = self.vers
    }

    func fresh(self) -> int64 {
        let v = self.next_vn
        self.next_vn = v + 1
        if v == len(self.vn_base) {
            let more = [0] * (v + 64)
            self.vn_base += more
            self.vn_off += more
        }
        self.vn_base[v] = v
        self.vn_off[v] = 0
        return v
    }

    // The value number `reg` has here: a local vreg's, a new one for
    // anything else (or a local vreg nothing is known of yet, which keeps it).
    func read(self, anon reg: Reg) -> int64 {
        let id = self.local(reg)
        if id < 0 {
            return self.fresh()
        }
        if self.reg_epoch[id] == self.epoch and self.reg_vn[id] != 0 {
            return self.reg_vn[id]
        }
        let v = self.fresh()
        self.reg_vn[id] = v
        self.reg_epoch[id] = self.epoch
        return v
    }

    // Local vreg `id` holds `v` from line `line` on.
    func set(self, anon id: int64, v: int64, line: int64) -> none {
        self.reg_vn[id] = v
        self.reg_epoch[id] = self.epoch
        let k = self.n_log
        if k == len(self.log_line) {
            let more = [0] * (k + 64)
            self.log_line += more
            self.log_reg += more
        }
        self.log_line[k] = line
        self.log_reg[k] = id
        self.n_log = k + 1
    }

    // `reg`, if a local vreg, gets a new value number at `line` (made when
    // it is read: 0 until then).
    func clobber(self, anon reg: Reg, line: int64) -> none {
        let id = self.local(reg)
        if id >= 0 {
            self.set(id, v: 0, :line)
        }
    }

    func canon_base(self, anon v: int64) -> int64 {
        if v < 0 {
            return v
        }
        return self.vn_base[v]
    }

    func canon_off(self, anon v: int64) -> int64 {
        if v < 0 {
            return 0
        }
        return self.vn_off[v]
    }

    // Nothing is known: no facts, and no vreg's value number holds.
    func forget_all(self) -> none {
        self.epoch += 1
        self.nf = 0
        self.bump()
    }

    // Drops fact `k` (the last takes its place).
    func drop_fact(self, anon k: int64) -> none {
        let last = self.nf - 1
        if k != last {
            let to = k * FACT_WORDS
            let from = last * FACT_WORDS
            for w in 0..FACT_WORDS {
                self.facts[to + w] = self.facts[from + w]
            }
        }
        self.nf = last
        self.bump()
    }

    // Drops the facts `mask` (KILL_) says may have changed.
    func kill(self, anon mask: int64) -> none {
        if mask == 0 or self.nf == 0 {
            return
        }
        mut k = 0
        for k < self.nf {
            let at = k * FACT_WORDS
            let kind = self.facts[at]
            mut gone = false
            if kind == FACT_FIELD {
                gone = (mask & KILL_FIELD) != 0 or ((mask & KILL_COUNT) != 0 and (self.facts[at + 2] < 0 or self.facts[at + 4] == 4))
            } else if kind == FACT_ELEM {
                gone = (mask & KILL_ELEM) != 0
            } else {
                gone = (mask & KILL_SLOTS) != 0
            }
            if gone {
                self.drop_fact(k)
            } else {
                k += 1
            }
        }
    }

    // Drops the slot facts a `width`-byte store at fp + `off` overlaps.
    func kill_slot(self, anon off: int64, width: int64) -> none {
        mut k = 0
        for k < self.nf {
            let at = k * FACT_WORDS
            if self.facts[at] == FACT_SLOT and self.facts[at + 2] < off + width and off < self.facts[at + 2] + self.facts[at + 4] {
                self.drop_fact(k)
            } else {
                k += 1
            }
        }
    }

    // The fact at an address, or -1.
    func find(self, kind: int64, base: int64, off: int64, index: int64, width: int64) -> int64 {
        let facts = self.facts
        for k in 0..self.nf {
            let at = k * FACT_WORDS
            if facts[at + 2] == off and facts[at + 1] == base and facts[at] == kind and facts[at + 3] == index and facts[at + 4] == width {
                return k
            }
        }
        return -1
    }

    func add(self, kind: int64, base: int64, off: int64, index: int64, width: int64, value: int64, holder: int64) -> none {
        mut k = self.find(:kind, :base, :off, :index, :width)
        if k < 0 {
            if self.nf == FACTS_CAP {
                self.drop_fact(0)
            }
            k = self.nf
            self.nf = k + 1
        }
        let at = k * FACT_WORDS
        self.facts[at] = kind
        self.facts[at + 1] = base
        self.facts[at + 2] = off
        self.facts[at + 3] = index
        self.facts[at + 4] = width
        self.facts[at + 5] = value
        self.facts[at + 6] = holder
        self.bump()
    }

    // Whether local vreg `h` (-1: none) still holds value number `v`.
    func holds(self, anon h: int64, v: int64) -> bool {
        return h >= 0 and self.reg_epoch[h] == self.epoch and self.reg_vn[h] == v
    }

    // Keeps only the facts `other` (`other_n` of them, version `other_ver`) has too.
    func meet_with(self, anon other: [int64], other_n: int64, other_ver: int64) -> none {
        if other_ver == self.fver {
            return
        }
        mut k = 0
        for k < self.nf {
            let at = k * FACT_WORDS
            mut found = false
            for j in 0..other_n {
                let o = j * FACT_WORDS
                if other[o + 2] == self.facts[at + 2] and other[o + 1] == self.facts[at + 1] and other[o + 5] == self.facts[at + 5] and other[o] == self.facts[at] and other[o + 3] == self.facts[at + 3] and other[o + 4] == self.facts[at + 4] {
                    found = true
                    break
                }
            }
            if found {
                k += 1
            } else {
                self.drop_fact(k)
            }
        }
    }

    // Takes the facts label `t` has pending as the state's own.
    func take_pending(self, anon t: int64) -> none {
        self.facts = self.pend[t]
        self.nf = self.pend_n[t]
        self.fver = self.pend_ver[t]
    }

    // Meets the state (or, with `have` false, replaces it) with what label
    // `t` has pending.
    func meet_pending(self, anon t: int64, have: bool) -> none {
        if have {
            self.meet_with(self.pend[t], other_n: self.pend_n[t], other_ver: self.pend_ver[t])
        } else {
            self.take_pending(t)
        }
    }

    // What line `j` may change in memory (KILL_ bits; a slot store's own
    // slot is slot_store's).
    func kills_at(self, anon j: int64) -> int64 {
        let b = self.body
        let tag = b.tags[j]
        let variant = tag & 255
        mut frame: int64 = 0
        // What a store to a slot may change besides it.
        mut via_slot: int64 = 0
        if self.frame_addr {
            frame = KILL_SLOTS
            via_slot = KILL_HEAP
        }
        if variant == INSN_SLOT {
            if (tag >> 8) == 1 {
                return via_slot
            }
            return 0
        }
        if variant == INSN_MEM {
            if ((tag >> 8) & 1) == 1 {
                return 0
            }
            let base = b.fb[j]
            let at_kind = (tag >> 9) & 3
            if base == FP or base == SP {
                if base == FP and at_kind == AT_OFFSET {
                    // A slot's store: slot_store.
                    return via_slot
                }
                return KILL_SLOTS | via_slot
            }
            if at_kind == AT_INDEX {
                return KILL_ELEM | frame
            }
            if at_kind == AT_SYMBOL {
                return KILL_HEAP | KILL_SLOTS
            }
            return KILL_HEAP | frame
        }
        if variant == INSN_CALL {
            let name = b.strs[b.fa[j]]
            if never_returns(name) {
                return 0
            }
            if name == "_rc_retain_stub" {
                return KILL_COUNT
            }
            return KILL_HEAP | frame
        }
        if variant == INSN_OP {
            if (tag >> 8) == OP_CALL_INDIRECT {
                return KILL_HEAP | frame
            }
            return 0
        }
        if variant == INSN_INTRINSIC {
            return KILL_HEAP | frame
        }
        if variant == INSN_PAIR {
            if ((tag >> 8) & 1) == 0 {
                return KILL_HEAP | KILL_SLOTS
            }
            return 0
        }
        if variant == INSN_DATA {
            return KILL_HEAP | KILL_SLOTS
        }
        return 0
    }

    // Whether line `j` stores to a slot, which it leaves in store_off and
    // store_width: a Slot's store, a store at `[fp, #off]`, and a
    // copy-on-write stub given `fp - n` as its place.
    func slot_store(self, anon j: int64) -> bool {
        let b = self.body
        let tag = b.tags[j]
        let variant = tag & 255
        if variant == INSN_SLOT and (tag >> 8) == 1 {
            self.store_off = b.fb[j]
            self.store_width = reg_width(b.fa[j])
            return true
        }
        if variant == INSN_MEM and ((tag >> 8) & 1) == 0 and b.fb[j] == FP and ((tag >> 9) & 3) == AT_OFFSET {
            self.store_off = b.fc[j]
            self.store_width = b.fd[j]
            return true
        }
        if variant == INSN_CALL and is_unique_stub(b.strs[b.fa[j]]) {
            for k in j - 2..j {
                if k >= 0 and self.check_place_at(k) {
                    self.store_off = 0 - imm_value(b.fc[k])
                    self.store_width = 8
                    return true
                }
            }
        }
        return false
    }

    // The local vregs line `j` writes each get a new value number at `line`.
    func clobber_written(self, anon j: int64, line: int64) -> none {
        let b = self.body
        let tag = b.tags[j]
        let variant = tag & 255
        let sub = tag >> 8
        if variant == INSN_SLOT {
            if sub == 0 {
                self.clobber(b.fa[j], :line)
            }
        } else if variant == INSN_MOV or variant == INSN_LOAD_CONST {
            self.clobber(b.fa[j], :line)
        } else if variant == INSN_MEM {
            if (sub & 1) == 1 {
                self.clobber(b.fa[j], :line)
            }
        } else if variant == INSN_OP {
            if not reads_only(sub) {
                self.clobber(b.fa[j], :line)
            }
        } else if variant == INSN_PAIR {
            if (sub & 1) == 1 {
                self.clobber(b.fa[j], :line)
                self.clobber(b.fb[j], :line)
            }
        }
    }

    // Lines `from` up to `to` may have run: what they write is forgotten (at `line`).
    func forget_range(self, from: int64, to: int64, line: int64) -> none {
        mut mask: int64 = 0
        let b = self.body
        let tags = b.tags
        let fa = b.fa
        let vs = self.vreg_start
        let nloc = self.n_local
        for j in from..to + 1 {
            let tag = tags[j]
            let variant = tag & 255
            let sub = tag >> 8
            mut written = NO_REG
            if variant == INSN_MOV or variant == INSN_LOAD_CONST {
                written = fa[j]
            } else if variant == INSN_OP {
                if reads_only(sub) {
                    mask = mask | self.kills_at(j)
                } else {
                    written = fa[j]
                }
            } else if variant == INSN_MEM {
                if (sub & 1) == 1 {
                    written = fa[j]
                } else {
                    mask = mask | self.kills_at(j)
                    if self.slot_store(j) {
                        self.kill_slot(self.store_off, width: self.store_width)
                    }
                }
            } else if variant == INSN_SLOT {
                if sub == 0 {
                    written = fa[j]
                } else {
                    mask = mask | self.kills_at(j)
                    self.kill_slot(b.fb[j], width: reg_width(fa[j]))
                }
            } else if variant == INSN_CALL {
                mask = mask | self.kills_at(j)
                if self.slot_store(j) {
                    self.kill_slot(self.store_off, width: self.store_width)
                }
            } else if variant != INSN_LABEL and variant != INSN_BRANCH {
                // Intrinsic, Pair, Data.
                mask = mask | self.kills_at(j)
                self.clobber_written(j, :line)
            }
            let id = (written >> 2) - vs
            if (written & 3) != 0 and (written & 3) != 3 and id >= 0 and id < nloc {
                self.set(id, v: 0, :line)
            }
        }
        self.kill(mask)
    }

    // The value number of the slot at `off` of `width` bytes, made one if
    // nothing is known of it.
    func slot_value(self, anon off: int64, width: int64) -> int64 {
        let k = self.find(kind: FACT_SLOT, base: 0, :off, index: 0, :width)
        if k >= 0 {
            return self.facts[k * FACT_WORDS + 5]
        }
        let v = self.fresh()
        self.add(kind: FACT_SLOT, base: 0, :off, index: 0, :width, value: v, holder: -1)
        return v
    }

    // A slot's load into `reg` at line `i`.
    func slot_load(self, anon reg: Reg, off: int64, width: int64, i: int64) -> none {
        let v = self.slot_value(off, :width)
        let id = self.local(reg)
        if id >= 0 {
            self.set(id, :v, line: i)
        }
    }

    // A slot's store of `reg`.
    func slot_store_of(self, anon reg: Reg, off: int64, width: int64) -> none {
        self.kill_slot(off, :width)
        if width == 8 {
            let v = self.read(reg)
            self.add(kind: FACT_SLOT, base: 0, :off, index: 0, :width, value: v, holder: -1)
        }
    }

    func walk(self) -> none {
        let b = self.body
        let tags = b.tags
        let fa = b.fa
        let fb = b.fb
        let n = b.n
        let vs = self.vreg_start
        let nloc = self.n_local
        mut i = 0
        for i < n {
            let tag = tags[i]
            let variant = tag & 255
            let sub = tag >> 8
            if variant == INSN_LABEL {
                if self.refs[self.ord[i]] != 0 {
                    self.at_label(i)
                }
                i += 1
                continue
            }
            if not self.reachable {
                i += 1
                continue
            }
            if variant == INSN_MOV {
                // A copy keeps its source's value number.
                let dst = fa[i]
                let id = (dst >> 2) - vs
                if (dst & 3) != 0 and (dst & 3) != 3 and id >= 0 and id < nloc {
                    let src = fb[i]
                    let sid = (src >> 2) - vs
                    if (dst & 3) == 1 and (src & 3) == 1 and sid >= 0 and sid < nloc {
                        self.set(id, v: self.read(src), line: i)
                    } else {
                        self.set(id, v: 0, line: i)
                    }
                }
            } else if variant == INSN_OP {
                self.op(i, opn: sub)
            } else if variant == INSN_MEM {
                if (sub & 1) == 1 {
                    let u = self.unique_label(i)
                    let place = fb[i]
                    self.load(i)
                    if u >= 0 {
                        self.check_unique(i, label: u, :place)
                    }
                } else {
                    if fb[i] == FP and ((sub >> 1) & 3) == AT_OFFSET {
                        self.slot_store_of(fa[i], off: b.fc[i], width: b.fd[i])
                    }
                    self.kill(self.kills_at(i))
                }
            } else if variant == INSN_SLOT {
                if sub == 1 {
                    self.slot_store_of(fa[i], off: fb[i], width: reg_width(fa[i]))
                    if self.frame_addr {
                        self.kill(KILL_HEAP)
                    }
                } else {
                    let u = self.unique_label(i)
                    self.slot_load(fa[i], off: fb[i], width: reg_width(fa[i]), :i)
                    if u >= 0 {
                        self.check_unique(i, label: u, place: NO_REG)
                    }
                }
            } else if variant == INSN_BRANCH {
                let t = self.target[i]
                if t >= 0 and self.lab_line[t] > i {
                    self.note_branch(t, line: i)
                }
                if (sub & 3) == BRANCH_ALWAYS {
                    self.reachable = false
                }
            } else if variant == INSN_CALL {
                let name = b.strs[fa[i]]
                if never_returns(name) {
                    self.reachable = false
                } else if name == "_rc_retain_stub" {
                    self.kill(KILL_COUNT)
                } else {
                    if is_unique_stub(name) and self.slot_store(i) {
                        self.kill_slot(self.store_off, width: self.store_width)
                    }
                    self.kill(self.kills_at(i))
                }
            } else if variant == INSN_DATA {
                self.forget_all()
            } else {
                // Intrinsic, LoadConst, Pair.
                self.kill(self.kills_at(i))
                self.clobber_written(i, line: i)
            }
            i += 1
            if self.skip_to >= 0 {
                i = self.skip_to
                self.skip_to = -1
            }
        }
    }

    // An Op at line `i`, of opcode number `opn`.
    func op(self, anon i: int64, opn: int64) -> none {
        let b = self.body
        if opn == OP_RETURN {
            self.reachable = false
            return
        }
        if opn == OP_CALL_INDIRECT {
            self.kill(self.kills_at(i))
            return
        }
        if reads_only(opn) {
            return
        }
        let a = b.fa[i]
        let id = self.local(a)
        if id < 0 {
            return
        }
        let src = b.fb[i]
        let c = b.fc[i]
        if (a & 3) == 1 and opn == OP_MOVE and (src & 3) == 3 and c == NO_REG {
            self.set(id, v: const_vn(imm_value(src)), line: i)
            return
        }
        if (a & 3) == 1 and (opn == OP_ADD or opn == OP_SUB) and (src & 3) == 1 and self.local(src) >= 0 and (c & 3) == 3 and b.fd[i] == NO_REG {
            let s = self.read(src)
            mut k = imm_value(c)
            if opn == OP_SUB {
                k = 0 - k
            }
            if k == 0 {
                self.set(id, v: s, line: i)
                return
            }
            let v = self.fresh()
            self.vn_base[v] = self.canon_base(s)
            self.vn_off[v] = self.canon_off(s) + k
            self.set(id, :v, line: i)
            return
        }
        self.set(id, v: 0, line: i)
    }

    // A load at line `i`: from a fact when one is known, else a new fact.
    func load(self, anon i: int64) -> none {
        let b = self.body
        let tag = b.tags[i]
        let dst = b.fa[i]
        let base = b.fb[i]
        let width = b.fd[i]
        let at_kind = (tag >> 9) & 3
        if base == FP and at_kind == AT_OFFSET {
            self.slot_load(dst, off: b.fc[i], :width, :i)
            return
        }
        let id = self.local(dst)
        if id < 0 or width == 2 or at_kind == AT_SYMBOL or self.local(base) < 0 {
            self.clobber(dst, line: i)
            return
        }
        let bv = self.read(base)
        mut kind = FACT_FIELD
        mut off = self.canon_off(bv)
        mut index: int64 = 0
        if at_kind == AT_OFFSET {
            off += b.fc[i]
        } else if at_kind == AT_INDEX {
            kind = FACT_ELEM
            if self.local(b.fc[i]) < 0 {
                self.clobber(dst, line: i)
                return
            }
            index = self.read(b.fc[i]) * 32 + width
            if ((tag >> 11) & 1) == 1 {
                index += 16
            }
        }
        let cb = self.canon_base(bv)
        let k = self.find(:kind, base: cb, :off, :index, :width)
        if k >= 0 {
            let v = self.facts[k * FACT_WORDS + 5]
            let h = self.facts[k * FACT_WORDS + 6]
            if self.holds(h, :v) {
                if h != id {
                    b.write_mov(i, dst: vreg(id + self.vreg_start), src: vreg(h + self.vreg_start))
                    self.changed += 1
                }
            } else {
                self.facts[k * FACT_WORDS + 6] = id
            }
            self.set(id, :v, line: i)
            return
        }
        let v = self.fresh()
        self.set(id, :v, line: i)
        self.add(:kind, base: cb, :off, :index, :width, value: v, holder: id)
    }

    // A forward branch at `line` to label `t`: what is known goes with it.
    func note_branch(self, anon t: int64, line: int64) -> none {
        if self.pend_line[t] < 0 {
            self.pend[t] = self.facts
            self.pend_n[t] = self.nf
            self.pend_ver[t] = self.fver
            self.pend_line[t] = line
            return
        }
        if self.pend_ver[t] == self.fver {
            return
        }
        // Met with what the earlier branches had: done on the state's own
        // facts, which are then put back.
        let mine = self.facts
        let mine_n = self.nf
        let mine_ver = self.fver
        self.take_pending(t)
        self.meet_with(mine, other_n: mine_n, other_ver: mine_ver)
        self.pend[t] = self.facts
        self.pend_n[t] = self.nf
        self.pend_ver[t] = self.fver
        self.facts = mine
        self.nf = mine_n
        self.fver = mine_ver
    }

    // The label at line `i`: what all ways to it know.
    func at_label(self, anon i: int64) -> none {
        let t = self.ord[i]
        if self.refs[t] == 0 {
            // Nothing branches here (a line marker): no join.
            return
        }
        mut have = self.reachable
        mut since = i
        if self.pend_line[t] >= 0 {
            self.meet_pending(t, :have)
            have = true
            since = self.pend_line[t]
        }
        if self.back_head[t] == -2 {
            // Its address is taken: anything may come here.
            self.forget_all()
            self.reachable = true
            return
        }
        if self.back_head[t] != -1 {
            // Branches back to it: from blocks only earlier branches reach,
            // or from a loop's body.
            mut detached = self.back_head[t] >= 0
            mut e = self.back_head[t]
            for e >= 0 {
                let c = self.block_start(self.back_line[e])
                if c < 0 or not self.detached(c, label: i) {
                    detached = false
                    break
                }
                e = self.back_next[e]
            }
            if detached {
                e = self.back_head[t]
                for e >= 0 {
                    let q = self.back_line[e]
                    let c = self.ord[self.block_start(q)]
                    if self.pend_line[c] >= 0 {
                        self.meet_pending(c, :have)
                        have = true
                        if self.pend_line[c] < since {
                            since = self.pend_line[c]
                        }
                        self.forget_range(from: self.lab_line[c] + 1, to: q, line: i)
                    }
                    e = self.back_next[e]
                }
            } else {
                let end = self.loop_end(i)
                if end < 0 {
                    self.forget_all()
                    self.reachable = true
                    return
                }
                self.forget_range(from: i + 1, to: end, line: i)
            }
        }
        if not have {
            self.forget_all()
            self.reachable = true
            return
        }
        self.reachable = true
        // A vreg written on some way here since the first branch to it has
        // a new value number.
        let last = self.n_log
        mut k = last - 1
        for k >= 0 and self.log_line[k] > since {
            k -= 1
            if last - k > LOG_REACH {
                self.forget_all()
                return
            }
        }
        for j in k + 1..last {
            let id = self.log_reg[j]
            if self.renewed_at[id] != i {
                self.renewed_at[id] = i
                self.set(id, v: 0, line: i)
            }
        }
        if self.uniq_kind[t] >= 0 and self.refs[t] == 1 {
            // After a copy-on-write check, either way: the place holds the
            // array, which is its own (its count is 1).
            let id = self.uniq_reg[t]
            let v = self.read(vreg(id + self.vreg_start))
            self.add(kind: self.uniq_kind[t], base: self.uniq_base[t], off: self.uniq_off[t], index: 0, width: 8, value: v, holder: id)
            if self.uniq_one[t] {
                self.add(kind: FACT_FIELD, base: self.canon_base(v), off: self.canon_off(v) - 8, index: 0, width: 4, value: VN_ONE, holder: -1)
            }
        }
    }

    // The line of the label that starts the block line `q` is in (scanning
    // back to it, past labels nothing branches to), or -1.
    func block_start(self, anon q: int64) -> int64 {
        let b = self.body
        mut c = q
        for c >= 0 and ((b.tags[c] & 255) != INSN_LABEL or self.refs[self.ord[c]] == 0) {
            c -= 1
        }
        return c
    }

    // Whether the block from the label at line `c` is reached only by
    // branches before the label at line `label`, and not by falling into it.
    func detached(self, anon c: int64, label: int64) -> bool {
        let t = self.ord[c]
        if c <= label or self.ref_last[t] >= label or self.refs[t] == 0 {
            return false
        }
        return self.ends_block(c - 1)
    }

    // Whether line `j` never falls through to the next.
    func ends_block(self, anon j: int64) -> bool {
        let b = self.body
        let tag = b.tags[j]
        let variant = tag & 255
        if variant == INSN_BRANCH {
            return ((tag >> 8) & 3) == BRANCH_ALWAYS
        }
        if variant == INSN_CALL {
            return never_returns(b.strs[b.fa[j]])
        }
        return variant == INSN_OP and (tag >> 8) == OP_RETURN
    }

    // Whether line `j` is a label some branch goes to.
    func is_target(self, anon j: int64) -> bool {
        return (self.body.tags[j] & 255) == INSN_LABEL and self.refs[self.ord[j]] > 0
    }

    // The last line of the loop whose top is the label at line `top`, or -1
    // when something outside it jumps into it: its last backward branch, then
    // the blocks after that only it reaches.
    func loop_end(self, anon top: int64) -> int64 {
        let b = self.body
        mut end = self.ref_last[self.ord[top]]
        mut grew = true
        for grew {
            grew = false
            // A block after it that only it branches to and that ends in a
            // panic (a bounds check's cold block) is the loop's too.
            let next = end + 1
            if next < b.n and self.is_target(next) and self.ends_block(end) and self.ref_first[self.ord[next]] > top and self.ref_last[self.ord[next]] < next {
                mut j = next + 1
                mut inside = true
                for j < b.n and not self.ends_block(j) {
                    if self.is_target(j) and (self.ref_first[self.ord[j]] <= top or self.ref_last[self.ord[j]] > j) {
                        inside = false
                    }
                    j += 1
                }
                if inside and j < b.n and (b.tags[j] & 255) == INSN_CALL and never_returns(b.strs[b.fa[j]]) {
                    end = j
                    grew = true
                }
            }
        }
        for j in top + 1..end + 1 {
            if self.is_target(j) and (self.ref_first[self.ord[j]] < top or self.ref_last[self.ord[j]] > end) {
                return -1
            }
        }
        return end
    }

    // At line `i`, the load of an array a copy-on-write check closed by the
    // label at line `label` follows (`place` the register holding its place,
    // NO_REG for a slot): when the array is known to be its place's own, the
    // check goes; else the label learns what holds after it.
    func check_unique(self, anon i: int64, label: int64, place: Reg) -> none {
        let b = self.body
        let u = self.ord[label]
        let arr = self.local(b.fa[i])
        let v = self.read(b.fa[i])
        let count = self.find(kind: FACT_FIELD, base: self.canon_base(v), off: self.canon_off(v) - 8, index: 0, width: 4)
        if count >= 0 and self.facts[count * FACT_WORDS + 5] == VN_ONE and self.refs[u] == 1 {
            self.drop_from += [i + 1]
            self.drop_to += [label]
            self.skip_to = label
            self.refs[u] = 0
            self.changed += 1
            return
        }
        if place == NO_REG {
            self.uniq_kind[u] = FACT_SLOT
            self.uniq_base[u] = 0
            self.uniq_off[u] = b.fb[i]
        } else {
            let pv = self.read(place)
            self.uniq_kind[u] = FACT_FIELD
            self.uniq_base[u] = self.canon_base(pv)
            self.uniq_off[u] = self.canon_off(pv)
        }
        self.uniq_reg[u] = arr
        self.uniq_one[u] = b.strs[b.fa[label - 2]] == "_kod_arr_unique_stub"
    }

    // The line of the label closing emit_unique's check when line `i` is its
    // array's load, or -1: `ldr h, [p]` (or `ldr h, [fp, #-n]`), the count's
    // load, `cmp`, `b.eq L`, `mov x16, p` (or `sub x16, fp, #n`), for an
    // array `mov x17, #width`, the stub, `mov h, x17`, `L:`.
    func unique_label(self, anon i: int64) -> int64 {
        let b = self.body
        if i + 8 >= b.n {
            return -1
        }
        let count = b.tags[i + 1]
        if count != (INSN_MEM | ((1 | (AT_OFFSET << 1)) << 8)) or b.fc[i + 1] != -8 {
            return -1
        }
        let tag = b.tags[i]
        let h = b.fa[i]
        if (h & 3) != 1 or self.local(h) < 0 {
            return -1
        }
        let slot = tag == INSN_SLOT
        if not slot and not (tag == (INSN_MEM | (1 << 8)) and b.fd[i] == 8 and self.local(b.fb[i]) >= 0) {
            return -1
        }
        if b.fd[i + 1] != 4 or b.fb[i + 1] != h {
            return -1
        }
        if b.tags[i + 2] != (INSN_OP | (OP_COMPARE << 8)) or b.fb[i + 2] != imm(1) or (b.fa[i + 2] >> 2) != (b.fa[i + 1] >> 2) or b.fc[i + 2] != NO_REG {
            return -1
        }
        if b.tags[i + 3] != (INSN_BRANCH | ((BRANCH_IF | (cond_number(.Eq) << 2)) << 8)) or self.target[i + 3] < 0 {
            return -1
        }
        let u = self.lab_line[self.target[i + 3]]
        if slot {
            if not self.check_place_at(i + 4) or imm_value(b.fc[i + 4]) != 0 - b.fb[i] {
                return -1
            }
        } else if b.tags[i + 4] != INSN_MOV or b.fa[i + 4] != X16 or b.fb[i + 4] != b.fb[i] {
            return -1
        }
        mut call = i + 5
        if (b.tags[call] & 255) == INSN_OP {
            if b.tags[call] != (INSN_OP | (OP_MOVE << 8)) or b.fa[call] != X17 {
                return -1
            }
            call += 1
        }
        if (b.tags[call] & 255) != INSN_CALL or not is_unique_stub(b.strs[b.fa[call]]) {
            return -1
        }
        if b.tags[call + 1] != INSN_MOV or b.fa[call + 1] != h or b.fb[call + 1] != X17 {
            return -1
        }
        if u != call + 2 {
            return -1
        }
        return u
    }

    // Drops the lines of the checks that went.
    func compact(self) -> none {
        if len(self.drop_from) == 0 {
            return
        }
        let b = self.body
        mut w = self.drop_from[0]
        mut d = 0
        mut i = w
        for i < b.n {
            if d < len(self.drop_from) and i == self.drop_from[d] {
                i = self.drop_to[d]
                d += 1
                continue
            }
            b.move_from(w, src: b, :i)
            w += 1
            i += 1
        }
        b.n = w
    }
}

// A hash of a label's name from its length and last bytes, where labels
// differ (their numbers).
func label_hash(anon name: str) -> int64 {
    let n = len(name)
    mut h = n
    mut j = n - 6
    if j < 0 {
        j = 0
    }
    for j < n {
        h = h * 31 + name[j]
        j += 1
    }
    return h & 0x3fffffff
}

let X17: Reg = 72

// Whether `target` is a copy-on-write stub (emit_unique's).
func is_unique_stub(anon target: str) -> bool {
    return target == "_kod_arr_unique_stub" or target == "_kod_obj_unique_stub"
}

// Whether an Op of opcode number `n` only reads its operands (it sets
// flags, calls or returns).
func reads_only(anon n: int64) -> bool {
    return n == OP_COMPARE or n == 12 or n == 22 or n == OP_CALL_INDIRECT or n == OP_RETURN
}
