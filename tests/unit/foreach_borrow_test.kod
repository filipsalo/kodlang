// `for x in xs` borrows each element from the array the loop holds: what the
// body does with the binding, the array or the variable it came from must
// still count right.
extern func rc_live_bytes() -> int64

type Box = shared struct {
    items: [str]
    last: str = ""
}

func first_long(anon xs: [str]) -> str {
    for x in xs {
        if len(x) > 2 {
            return x
        }
    }
    return ""
}

func run() -> int64 {
    mut words = ["a" + "b", "ccc" + "d", "e" + "f"]
    mut kept: [str] = []
    let b = Box(items: words)
    for w in words {
        kept += [w]
        b.last = w
        words = []
        b.items = []
    }
    mut n = len(kept) + len(b.last) + len(first_long(kept))
    for w in kept {
        if w == "cccd" {
            break
        }
        n += len(w)
    }
    for w in kept {
        n += len(w)
    }
    mut ys = ["x" + "y", "z" + "w"]
    for y in ys {
        ys += [y + "!"]
    }
    for y in ys {
        n += len(y)
    }
    for v in kept {
        v = v + "?"
        n += len(v)
    }
    return n
}

test "what the loop body does with a borrowed element counts right" {
    assert run() == 40
}

test "a borrowed element leaks nothing" {
    let _ = run()
    let before = rc_live_bytes()
    for _ in 0..1000 {
        let _ = run()
    }
    assert (rc_live_bytes() - before) / 1000 == 0
}
