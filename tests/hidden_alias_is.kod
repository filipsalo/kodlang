// The enum in an `is` through a module alias means the module even where a
// local of that name is in force, wherever the `is` is written.
import "./geo_is"

func forms(anon x: geo_is.Shape, anon geo_is: int64) -> int64 {
    mut n = geo_is
    if x is geo_is.Shape.Dot {
        n += 1
    }
    let dot = x is geo_is.Shape.Dot
    let not_dot = x is not geo_is.Shape.Dot
    let circle = x is geo_is.Shape.Circle
    if dot and not_dot == false and geo_is > 0 {
        n += 10
    }
    if circle or x is geo_is.Shape.Circle(_) {
        n += 100
    }
    print(f"{dot} {not_dot} {circle} {x is geo_is.Shape.Dot}")
    return n
}

func same_name(anon x: geo_is.Shape) -> bool {
    let geo_is = 7
    if geo_is > 0 {
        let geo_is = 8
        return x is geo_is.Shape.Dot and geo_is == 8
    }
    return false
}

func main() -> int64 {
    print_int(forms(.Dot, 4))
    print_int(forms(geo_is.make(2), 4))
    print(f"{same_name(.Dot)} {same_name(geo_is.make(1))}")
    return 0
}

// expected output:
// true false false true
// 15
// false true true false
// 104
// true false
