// `for i in a..b`, `for i, x in xs` and a `for` condition that binds.

type Reader = shared struct {
    lines: [str]
    pos: int64 = 0

    func next_line(self) -> str? {
        if self.pos >= len(self.lines) {
            return none
        }
        self.pos += 1
        return self.lines[self.pos - 1]
    }
}

type Calls = shared struct {
    n: int64 = 0
}

func bound(c: Calls) -> int64 {
    c.n += 1
    return 3
}

func first_at_least(xs: [int64], n: int64) -> int64 {
    for i, x in xs {
        if x >= n {
            return i
        }
    }
    return -1
}

test "for over a range" {
    mut seen: [int64] = []
    for i in 0..3 {
        seen += [i]
    }
    for i in 2..2 {
        seen += [100 + i]
    }
    for i in 5..2 {
        seen += [100 + i]
    }
    for i in -1..1 {
        seen += [i]
    }
    assert seen == [0, 1, 2, -1, 0]
}

test "bounds are evaluated once, and continue still moves on" {
    mut seen: [int64] = []
    mut n = 3
    for i in 0..n {
        n = 100
        if i == 1 {
            continue
        }
        seen += [i * 10]
    }
    assert seen == [0, 20]
    seen = []
    let c = Calls()
    for _i in 0..bound(:c) {
        seen += [c.n]
    }
    assert seen == [1, 1, 1]
}

test "a bound sees the name from before the loop" {
    mut seen: [int64] = []
    let i = 2
    for i in 0..i {
        seen += [i + 50]
    }
    assert seen == [50, 51]
    assert i == 2
}

test "nested loops, break and continue, index and element" {
    mut seen: [str] = []
    // Nested, with `break` leaving the inner loop only.
    for a in 0..2 {
        for b in 0..3 {
            if b == 1 {
                break
            }
            seen += [f"{a} {b}"]
        }
    }
    for j, s in ["x", "y", "z"] {
        if j == 1 {
            continue
        }
        seen += [f"{j} {s}"]
    }
    for _, s in ["p"] {
        seen += [s]
    }
    for k, _ in ["q", "r"] {
        seen += [f"{k}"]
    }
    for _ in 0..2 {
        seen += ["again"]
    }
    assert seen == ["0 0", "1 0", "0 x", "2 z", "p", "0", "1", "again", "again"]
    assert first_at_least(xs: [1, 5, 9], n: 5) == 1
}

test "a for condition that binds" {
    mut seen: [str] = []
    let r = Reader(lines: ["one", "", "three"])
    for r.next_line() is Some(line) and len(line) > 0 {
        seen += [line]
    }
    let r2 = Reader(lines: ["a", "skip", "b"])
    for r2.next_line() is Some(line) {
        if line == "skip" {
            continue
        }
        seen += [line]
    }
    let r3 = Reader(lines: ["c", "stop", "d"])
    for r3.next_line() is Some(line) {
        if line == "stop" {
            break
        }
        seen += [line]
    }
    mut left = 2
    for left > 0 and r3.next_line() is Some(line) {
        left -= 1
        seen += [line]
    }
    assert seen == ["one", "a", "b", "c", "d"]
}
