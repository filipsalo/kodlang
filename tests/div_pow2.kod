// `/` and `%` by a power of two literal round toward zero, as by any other number.
func main() -> int64 {
    let xs: [int64] = [0, 1, -1, 5, -5, 7, -7, 1023, -1023, 1024, -1024, 9223372036854775807, -9223372036854775807, -9223372036854775807 - 1]
    for x in xs {
        print(f"{x / 2} {x % 2}")
        print(f"{x / 4} {x % 4}")
        print(f"{x / 1024} {x % 1024}")
        print(f"{x / 4611686018427387904} {x % 4611686018427387904}")
    }
    return 0
}

