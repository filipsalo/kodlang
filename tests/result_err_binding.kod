// `Err(e)` on an explicit `Result[T, E]` binds an `E`.
type Oops = struct {
    code: int64
}
func main() -> int64 {
    let r: Result[int64, str] = .Err(error: "bad")
    match r {
        Ok(v) -> print_int(v)
        Err(e) -> print(e + "!")
    }
    if r is Err(e2) {
        print(e2 + "?")
    }
    let s = match r {
        Ok(v) -> "ok"
        Err(e3) -> e3
    }
    print(s)
    let q: Result[int64, Oops] = .Err(error: Oops(code: 7))
    match q {
        Ok(v) -> print_int(v)
        Err(o) -> print_int(o.code)
    }
    return 0
}

// expected output:
// bad!
// bad?
// bad
// 7
