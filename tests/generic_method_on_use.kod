// A generic type's method is compiled for an instance only when something uses it.

type Pt = struct {
    x: int64
    y: int64
}

type Box[T] = struct {
    items: [T]

    // Pt has no `==`, so this can't compile for Box[Pt].
    func has(self, anon v: T) -> bool {
        for item in self.items {
            if item == v {
                return true
            }
        }
        return false
    }

    func count(self) -> int64 {
        return len(self.items)
    }

    // Only a chain of calls reaches this one.
    func first_label(self) -> str {
        return self.label_of(self.items[0])
    }

    func label_of(self, anon v: T) -> str {
        return f"<{v}>"
    }

    // Grows without end if it is ever compiled.
    func wrapped(self) -> int64 {
        return Box[[T]](items: [self.items]).wrapped()
    }
}

// Every way a method gets used without a plain call on a struct value.
type Ops[T] = struct {
    v: T

    func op_add(self, other: Ops[T]) -> Ops[T] {
        return Ops[T](v: other.v)
    }

    func op_eq(self, other: Ops[T]) -> bool {
        return true
    }

    func op_lt(self, other: Ops[T]) -> bool {
        return false
    }

    func op_index(self, anon i: int64) -> int64 {
        return i + 1
    }

    func op_index_set(self, anon i: int64, anon v: int64) -> none {
        print(f"set {i} {v}")
    }

    func to_str(self) -> str {
        return "ops"
    }

    func len(self) -> int64 {
        return 7
    }

    func broken(self) -> T {
        return self.v.no_such_method()
    }
}

interface Counted {
    func count(self) -> int64
}

interface Named {
    func name(self) -> str
    func size(self) -> int64
}

// Boxed to an interface, so its methods are called through a vtable alone.
type Tag[T] = struct {
    v: T

    func name(self) -> str {
        return f"tag {self.v}"
    }

    func size(self) -> int64 {
        return self.helper()
    }

    func helper(self) -> int64 {
        return 3
    }

    func broken(self) -> int64 {
        return self.v.no_such_method()
    }
}

func show(anon n: Named) -> str {
    return f"{n.name()} {n.size()}"
}

func maybe_count(anon b: Box[Pt]?) -> int64? {
    return b?.count()
}

func main() -> int64 {
    let points = Box[Pt](items: [Pt(x: 1, y: 2), Pt(x: 3, y: 4)])
    print(points.count())

    // The same method compiles for an instance that can take it.
    let ints = Box[int64](items: [1, 2])
    print(ints.has(2))
    print(ints.has(3))
    print(ints.first_label())

    let a = Ops[int64](v: 1)
    let b = Ops[int64](v: 2)
    print((a + b).v)
    print(a == b)
    print(a != b)
    print(a < b)
    print(a[4])
    a[5] = 6
    print(f"{a}")
    print(len(a))

    print(show(Tag[int64](v: 9)))
    let counted: Counted = points
    print(counted.count())
    print(maybe_count(points)? or 0)
    return 0
}

// expected output:
// 2
// true
// false
// <1>
// 2
// true
// false
// false
// 5
// set 5 6
// ops
// 7
// tag 9 3
// 2
// 2
