// Methods on generic enums, compiled for each instance something calls them on.
import "./generic_enum_methods_dep"

type Either[L, R] = enum {
    Left(value: L)
    Right(value: R)

    func swapped(self) -> Either[R, L] {
        return match self {
            .Left(value) -> .Right(:value)
            .Right(value) -> .Left(:value)
        }
    }

    func left_or(self, anon fallback: L) -> L {
        if self is .Left(value) {
            return value
        }
        return fallback
    }

    func is_left(self) -> bool {
        return self._side() == "left"
    }

    func _side(self) -> str {
        return match self {
            .Left -> "left"
            .Right -> "right"
        }
    }

    func describe(self, prefix: str = "either") -> str {
        return f"{prefix} {self._side()}"
    }

    func to_str(self) -> str {
        return match self {
            .Left(value) -> f"L({value})"
            .Right(value) -> f"R({value})"
        }
    }
}

type Stack[T] = enum {
    Empty
    Push(top: T, rest: Stack[T])

    func push(self, anon value: T) -> Stack[T] {
        return .Push(top: value, rest: self)
    }

    func size(self) -> int64 {
        mut n = 0
        mut cur = self
        for cur is .Push(_top, rest) {
            n += 1
            cur = rest
        }
        return n
    }

    func peek(self) -> T? {
        if self is .Push(top, _rest) {
            return top
        }
        return none
    }

    func map_len(self, anon f: func(T) -> int64) -> Stack[int64] {
        return match self {
            .Empty -> .Empty
            .Push(top, rest) -> rest.map_len(f).push(f(top))
        }
    }
}

func show_left[A](anon e: Either[A, str]) -> str {
    return f"{e.is_left()} {e}"
}

func main() -> int64 {
    let a: Either[int64, str] = .Left(value: 4)
    let b: Either[int64, str] = .Right(value: "x")
    print(f"{a} {b} {a.swapped()} {b.swapped()}")
    print_int(a.left_or(0) + b.left_or(9))
    print(f"{a.is_left()} {b.is_left()} {a.describe()} {b.describe(prefix: "it's")}")
    let c: Either[str, bool] = .Left(value: "s")
    print(f"{c.swapped().swapped()} {c.left_or("d")}")
    print(show_left(a))
    let maybe: Either[int64, str]? = b
    print(maybe?.describe()? or "none")

    let empty: Stack[str] = .Empty
    let s = empty.push("a").push("bcd")
    print_int(s.size())
    print(s.peek()? or "-")
    print(empty.peek()? or "-")
    let lens = s.map_len(func(anon v: str) -> int64 { return len(v) })
    print(f"{lens.size()} {lens.peek()? or 0}")

    let t = generic_enum_methods_dep.pair(1, 2)
    let u: generic_enum_methods_dep.Tree[str] = .Node(left: generic_enum_methods_dep.pair("p", "q"), right: .Leaf(value: "r"))
    print(f"{t.count()} {t.first()} {u.count()} {u.first()}")
    return 0
}

// expected output:
// L(4) R(x) R(4) L(x)
// 13
// true false either left it's right
// L(s) s
// true L(4)
// either right
// 2
// bcd
// -
// 2 3
// 2 1 3 p
