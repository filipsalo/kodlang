// `==` and `!=` compare arrays element by element; f-strings and `str`
// show them as their elements in brackets.

type Color = enum {
    Red
    Green

    func to_str(self) -> str {
        match self {
            .Red -> return "red"
            .Green -> return "green"
        }
    }
}

type Point = shared struct {
    x: int64
    y: int64

    func to_str(self) -> str {
        return f"({self.x}, {self.y})"
    }

    func op_eq(self, anon other: Point) -> bool {
        return self.x == other.x and self.y == other.y
    }
}

test "== and != compare element by element" {
    assert [1, 2] == [1, 2]
    assert not ([1, 2] == [2, 1])
    assert not ([1, 2] == [1, 2, 3])
    assert not (["a", "b"] != ["a", "b"])
    assert [[1], [2, 3]] == [[1], [2, 3]]
    let none_yet: [int64] = []
    assert none_yet == []
    assert [Color.Red] == [Color.Red]
    assert [Point(x: 1, y: 2)] == [Point(x: 1, y: 2)]
    assert [true, false] != [true, true]
}

test "an array shows as its elements in brackets" {
    assert f"{[1, 2, 3]}" == "[1, 2, 3]"
    assert f"{["a", "b"]}" == "[a, b]"
    assert str([[1], []]) == "[[1], []]"
    let none_yet: [int64] = []
    assert f"{none_yet}" == "[]"
    assert f"{[Color.Red, Color.Green]}" == "[red, green]"
    assert str([Point(x: 1, y: 2)]) == "[(1, 2)]"
    assert f"flags {[true, false]} and {[1.5]}" == "flags [true, false] and [1.5]"
}
