// First-class functions, beyond Slice 1 — function-typed struct
// fields, arrays of function pointers, and general callee
// expressions (call results, indexing, struct-field access).

func double(x: int64) -> int64 { return x * 2 }
func triple(x: int64) -> int64 { return x * 3 }

type Handler = shared struct {
    fn: func(int64) -> int64
}

func get_doubler() -> func(int64) -> int64 {
    return double
}

test "a struct field of function type" {
    // `h.fn(7)` resolves to a field load + indirect call (NOT a method call).
    let h: Handler = Handler(fn: triple)
    assert h.fn(7) == 21
}

test "an array of functions" {
    // Index returns a function value; `(...)` after it dispatches indirectly.
    let ops: [func(int64) -> int64] = [double, triple]
    assert ops[0](10) == 20
    assert ops[1](10) == 30

    // for-each over `[func(...) -> R]` gives a function-typed
    // iteration variable.
    mut got: [int64] = []
    for f in ops {
        got += [f(5)]
    }
    assert got == [10, 15]
}

test "a call returning a function is a callee" {
    assert get_doubler()(50) == 100
}
