// Every literal and match in an array `+` chain is built as the type the
// chain goes to, or else as its first operand that isn't a literal or match.
interface Shape {
    func area(self) -> int64
}
type Sq = struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type A = enum {
    Hit(n: int64)
    Miss
}
type B = enum {
    Miss
    Hit(n: int64)
}
type Dark = enum { Red  Green }
type Light = enum { Green  Red }
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}
type Holder = struct {
    ms: [Maybe[str]]
    shapes: [Shape] = [Sq(s: 1)] + [Sq(s: 2)]
}
func show_b(anon b: B) -> str {
    return match b {
        .Miss -> "miss"
        .Hit(n) -> f"hit {n}"
    }
}
func show_l(anon l: Light) -> str {
    return match l {
        .Green -> "green"
        .Red -> "red"
    }
}
func show_all(anon ms: [Maybe[str]]) -> str {
    mut out = ""
    for m in ms {
        match m {
            .Just(value) -> out += f" {value}"
            .Nothing -> out += " -"
        }
    }
    return out
}
func total(anon xs: [Shape]) -> int64 {
    mut t = 0
    for x in xs {
        t += x.area()
    }
    return t
}
func ret() -> [Maybe[str]] {
    return [.Just(value: "r")] + [.Nothing]
}
func ret_or(anon k: int64) -> [Maybe[str]] or Error {
    if k > 0 {
        return [.Just(value: "o")] + [.Nothing] + [.Just(value: "k")]
    }
    return [.Nothing] + [.Nothing]
}
func ret_shapes() -> [Shape] {
    return [Sq(s: 3)] + [Sq(s: 4)]
}
func main() -> int64 {
    let ms: [Maybe[str]] = [.Nothing]
    mut s = ""
    for m in [.Just(value: "a")] + [.Just(value: "b")] + ms {
        s += show_all([m])
    }
    print(f"for:{s}")
    let c: [Maybe[str]] = [.Just(value: "c")] + [.Nothing]
    print(f"let:{show_all(c)}")
    mut d: [Maybe[str]] = []
    d = [.Nothing] + [.Just(value: "d")] + ms
    print(f"assign:{show_all(d)}")
    print(f"arg:{show_all([.Just(value: "arg")] + [.Nothing])}")
    print(f"return:{show_all(ret())}")
    print(f"or-error:{show_all(must ret_or(1))}{show_all(must ret_or(0))}")
    mut acc: [Maybe[str]] = []
    acc += [.Just(value: "p1")] + [.Just(value: "p2")]
    acc += ms + [.Just(value: "p3")]
    print(f"plus-assign:{show_all(acc)}")
    mut h = Holder(ms: [.Just(value: "f")] + [.Nothing])
    print(f"field:{show_all(h.ms)} {total(h.shapes)}")
    h.ms = [.Nothing] + [.Just(value: "g")]
    print(f"field-assign:{show_all(h.ms)}")
    mut grid: [[Maybe[str]]] = [[]]
    grid[0] = [.Just(value: "i")] + [.Nothing]
    print(f"index-set:{show_all(grid[0])}")
    let k = 2
    let picked = match k {
        1 -> [.Just(value: "one")]
        else -> [.Nothing]
    } + [.Just(value: "m")] + ms
    print(f"match:{show_all(picked)}")

    let bs: [B] = [.Miss]
    mut hits = ""
    for b in [.Hit(n: 1)] + [.Hit(n: 2)] + bs {
        hits += f" {show_b(b)}"
    }
    print(f"enum:{hits}")
    let ls: [Light] = [.Green]
    mut lights = ""
    for l in [.Red] + [.Red] + ls {
        lights += f" {show_l(l)}"
    }
    print(f"variant:{lights}")

    let shapes: [Shape] = [Sq(s: 2)]
    print_int(total([Sq(s: 1)] + [Sq(s: 5)] + shapes))
    print_int(total(shapes + [Sq(s: 3)] + [Sq(s: 1)]))
    print_int(total(ret_shapes()))
    mut more: [Shape] = []
    more += [Sq(s: 6)] + [Sq(s: 1)]
    print_int(total(more))
    let opts: [int64?] = [none]
    let all_opts = [1, none] + [2] + opts
    mut n = 0
    for o in all_opts {
        n += o? or 100
    }
    print_int(n)
    return 0
}

// expected output:
// for: a b -
// let: c -
// assign: - d -
// arg: arg -
// return: r -
// or-error: o - k - -
// plus-assign: p1 p2 - p3
// field: f - 5
// field-assign: - g
// index-set: i -
// match: - m -
// enum: hit 1 hit 2 miss
// variant: red red green
// 30
// 14
// 25
// 37
// 203
