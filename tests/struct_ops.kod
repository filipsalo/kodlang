// A struct gives operators a meaning with op_* methods.

type Dur = struct {
    ns: int64

    func op_add(self, other: Dur) -> Dur {
        return Dur(ns: self.ns + other.ns)
    }

    func op_sub(self, other: Dur) -> Dur {
        return Dur(ns: self.ns - other.ns)
    }

    func op_mul(self, k: int64) -> Dur {
        return Dur(ns: self.ns * k)
    }

    func op_rmul(self, k: int64) -> Dur {
        return Dur(ns: self.ns * k)
    }

    func op_rsub(self, k: int64) -> Dur {
        return Dur(ns: k - self.ns)
    }

    func op_div(self, k: int64) -> Dur {
        return Dur(ns: self.ns / k)
    }

    func op_mod(self, other: Dur) -> Dur {
        return Dur(ns: self.ns % other.ns)
    }

    func op_eq(self, other: Dur) -> bool {
        return self.ns == other.ns
    }

    func op_lt(self, other: Dur) -> bool {
        return self.ns < other.ns
    }
}

type Plain = struct {
    n: int64
}

func d(anon n: int64) -> Dur {
    print(f"d({n})")
    return Dur(ns: n)
}

func show(anon x: Dur) -> int64 {
    return x.ns
}

func main() -> int64 {
    let a = Dur(ns: 10)
    let b = Dur(ns: 4)
    print_int((a + b).ns)
    print_int((a - b).ns)
    print_int((a * 3).ns)
    print_int((3 * a).ns)
    print_int((a / 2).ns)
    print_int((a % b).ns)
    print_int((-a).ns)

    // Precedence is the usual one, and the result can be an operand.
    print_int((a + b * 2).ns)
    print_int((2 * a + b).ns)
    print_int(show(a + b + a))
    print_int(show(a - b - b))

    // Comparisons.
    print(f"{a == b} {a != b} {a == Dur(ns: 10)}")
    print(f"{a < b} {a > b} {a <= b} {a >= b}")
    print(f"{b < a} {b > a} {b <= a} {b >= a}")
    print(f"{a <= Dur(ns: 10)} {a >= Dur(ns: 10)}")
    if b < a and a != b {
        print("ordered")
    }
    if b < a < Dur(ns: 20) {
        print("chained")
    }

    // Compound assignment.
    mut c = a
    c += b
    c -= Dur(ns: 1)
    print_int(c.ns)
    print_int(a.ns)

    // Operands are evaluated left to right, however the method is reached.
    print_int((d(1) + d(2)).ns)
    print_int((d(3) * 2).ns)
    print_int((2 * d(5)).ns)
    print(f"{d(6) < d(7)}")
    print(f"{d(8) > d(9)}")
    return 0
}

// expected output:
// 14
// 6
// 30
// 30
// 5
// 2
// -10
// 18
// 24
// 24
// 2
// false true true
// false true false true
// true false true false
// true true
// ordered
// chained
// 13
// 10
// d(1)
// d(2)
// 3
// d(3)
// 6
// d(5)
// 10
// d(6)
// d(7)
// true
// d(8)
// d(9)
// false

// expected status:
// 0
