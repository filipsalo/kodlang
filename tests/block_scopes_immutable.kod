// A `let` in a block that hides an outer `mut` can't be reassigned there.
func main() -> int64 {
    mut x = 1
    x = 2
    if x > 1 {
        let x = 5
        print_int(x)
        x = 6
    }
    return 0
}

// expected stderr:
// 8:9: error: cannot reassign immutable binding `x`; declare it with `mut`
// expected status:
// 1
