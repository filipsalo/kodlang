// HTTP requests over TCP or TLS, with redirects. See docs/http.md.
import "net/http" { Headers, Request, Response, Limits, Url, parse_url, resolve, write_request, read_response, invalid }
import "net/tcp"
import "net/tls"
import "fd" { Fd }
import "net/tls" { TlsStream }
import "stream" { IoError, BufReader, Reader, Writer }
import "time"

type Options = struct {
    headers: Headers = Headers()
    body: bytes = kod_str_to_bytes("")
    trust_file: str = ""
    timeout_ms: int64 = 30000
    max_redirects: int64 = 5
    limits: Limits = Limits()
    deadline_ms: int64 = 0
}

func deadline_error() -> IoError {
    return IoError(kind: .TimedOut, op: "http", errno: 0, detail: "deadline exceeded")
}

// How long the next wait may last: `timeout_ms`, or less when the deadline
// (a monotonic time in ns, 0 for none) is nearer. Fails when it has passed.
func wait_ms(timeout_ms: int64, deadline_ns: int64) -> int64 or Error {
    if deadline_ns == 0 {
        return timeout_ms
    }
    let left_ns = deadline_ns - time.monotonic_ns()
    if left_ns <= 0 {
        throw deadline_error()
    }
    let left_ms = (left_ns + 999999) / 1000000
    if left_ms < timeout_ms {
        return left_ms
    }
    return timeout_ms
}

// A wait that ended in `TimedOut` after the deadline is a deadline error.
func after_wait(anon e: Error, deadline_ns: int64) -> Error {
    if deadline_ns != 0 and time.monotonic_ns() >= deadline_ns {
        if e is IoError(io) {
            if io.kind == .TimedOut {
                return deadline_error()
            }
        }
    }
    return e
}

// A plain connection whose every read and write is limited by the deadline.
type TcpLink = struct {
    conn: Fd
    timeout_ms: int64
    deadline_ns: int64

    func read(self, anon max: int64) -> bytes or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try tcp.set_timeout(self.conn, ms: ms)
        let got = self.conn.read(max)
        if got is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        return try got
    }

    func write(self, anon data: bytes) -> int64 or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try tcp.set_timeout(self.conn, ms: ms)
        let put = self.conn.write(data)
        if put is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        return try put
    }
}

type TlsLink = struct {
    conn: TlsStream
    timeout_ms: int64
    deadline_ns: int64

    func read(self, anon max: int64) -> bytes or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try self.conn.set_timeout(ms: ms)
        let got = self.conn.read(max)
        if got is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        return try got
    }

    func write(self, anon data: bytes) -> int64 or Error {
        let ms = try wait_ms(timeout_ms: self.timeout_ms, deadline_ns: self.deadline_ns)
        try self.conn.set_timeout(ms: ms)
        let put = self.conn.write(data)
        if put is Err(e) {
            throw after_wait(e, deadline_ns: self.deadline_ns)
        }
        return try put
    }
}

// Write `req` to `w` and read the response from `r`, which may be the same
// connection.
func talk(anon r: Reader, anon w: Writer, anon req: Request, options: Options) -> Response or Error {
    try write_request(w, req)
    let br = BufReader(inner: r, limit: options.limits.max_header_bytes)
    return read_response(br, req.method, limits: options.limits)
}

// One request on its own connection, closed afterwards.
func exchange(anon req: Request, options: Options, deadline_ns: int64) -> Response or Error {
    let url = req.url
    let connect_ms = try wait_ms(timeout_ms: options.timeout_ms, deadline_ns: deadline_ns)
    if url.scheme == "https" {
        let conn = try tls.connect(url.host, port: url.port, trust_file: options.trust_file, timeout_ms: connect_ms)
        let link = TlsLink(conn: conn, timeout_ms: options.timeout_ms, deadline_ns: deadline_ns)
        let result = talk(link, link, req, options: options)
        if conn.close() is Err(_) {
            return result
        }
        return result
    }
    let conn = try tcp.connect(url.host, port: url.port, timeout_ms: connect_ms)
    let link = TcpLink(conn: conn, timeout_ms: options.timeout_ms, deadline_ns: deadline_ns)
    let result = talk(link, link, req, options: options)
    if conn.close() is Err(_) {
        return result
    }
    return result
}

func is_redirect(anon status: int64) -> bool {
    return status == 301 or status == 302 or status == 303 or status == 307 or status == 308
}

// `headers` without the named ones.
func without(anon headers: Headers, anon names: [str]) -> Headers {
    let out = Headers()
    for h in headers.items {
        mut drop = false
        for n in names {
            if h.name.lower() == n {
                drop = true
            }
        }
        if drop == false {
            out.add(h.name, h.value)
        }
    }
    return out
}

func fetch(anon method: str, anon url: str, options: Options = Options()) -> Response or Error {
    if options.deadline_ms < 0 {
        throw invalid("fetch", "deadline_ms cannot be negative")
    }
    mut deadline_ns: int64 = 0
    if options.deadline_ms > 0 {
        deadline_ns = time.monotonic_ns() + options.deadline_ms * 1000000
    }
    mut current = try parse_url(url)
    mut verb = method
    mut payload = options.body
    mut headers = without(options.headers, [])
    mut hops: int64 = 0
    for true {
        let req = Request(method: verb, url: current, headers: headers, body: payload)
        let resp = try exchange(req, options: options, deadline_ns: deadline_ns)
        let location = resp.header("location")
        if is_redirect(resp.status) == false or location is none or options.max_redirects <= 0 {
            return resp
        }
        hops = hops + 1
        if hops > options.max_redirects {
            throw invalid("redirect", f"more than {options.max_redirects} redirects")
        }
        let next = try resolve(current, location? or "")
        if current.scheme == "https" and next.scheme == "http" {
            throw invalid("redirect", "refusing a redirect from https to http")
        }
        if resp.status != 307 and resp.status != 308 {
            if verb != "HEAD" {
                verb = "GET"
            }
            payload = kod_str_to_bytes("")
            headers = without(headers, ["content-type"])
        }
        if next.host != current.host or next.port != current.port {
            headers = without(headers, ["authorization", "cookie", "proxy-authorization"])
        }
        current = next
    }
    throw invalid("redirect", "unreachable")
}

func get(anon url: str) -> Response or Error {
    return try fetch("GET", url)
}

func post(anon url: str, anon body: bytes, content_type: str) -> Response or Error {
    let options = Options(body: body)
    options.headers.add("Content-Type", content_type)
    return try fetch("POST", url, options: options)
}
