type Point = shared struct {
    x: int64
    y: int64
}

func shift(anon p: Point, anon dx: int64) -> none {
    p.x = p.x + dx
}

test "shared struct is passed and copied by reference" {
    let p = Point(x: 3, y: 4)
    assert p.x == 3
    shift(p, 10)
    assert p.x == 13
    let q: Point = p
    q.y = 99
    assert p.y == 99
}
