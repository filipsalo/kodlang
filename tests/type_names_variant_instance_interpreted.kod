// The interpreter doesn't count an alias of a generic instance as an enum
// that declares the variant, as the compiler doesn't.
import "./type_names_pa"
import "./type_names_pb"

type PaMaybe = type_names_pa.Maybe[int64]
type PbMaybe = type_names_pb.Maybe[int64]

func main() -> int64 {
    let e = .Just(v: 3)
    return 0
}

// expected status:
// 1
// expected stderr:
// 10:13: error: `.Just` is ambiguous: `type_names_pa.Maybe` and `type_names_pb.Maybe` both declare it; write `type_names_pb.Maybe.Just` or give the value a type
// expected mode:
// interpret
