// A `.Variant` stored into an array or a field takes its enum from there.
import "./variant_hidden_mid"

func main() -> int64 {
    mut fs = variant_hidden_mid.list()
    fs += [.Circle(r: 2)]
    fs = fs + [.Square(side: 3)]
    fs[0] = .Circle(r: 6)
    fs = [.Circle(r: 10)] + fs
    mut h = variant_hidden_mid.Holder()
    h.fs += [.Circle(r: 4)]
    h.fs = h.fs + [.Square(side: 5)]
    h.fs[1] = .Circle(r: 8)
    print_int(variant_hidden_mid.total(fs))
    print_int(variant_hidden_mid.total(h.fs))
    return 0
}

// expected output:
// 21
// 12
