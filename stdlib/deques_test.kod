import "deques" { Deque }

test "both ends" {
    mut q = Deque[int64]()
    assert q.pop_front() is none
    assert q.pop_back() is none
    assert q.front() is none
    q.push_back(1)
    q.push_back(2)
    q.push_front(0)
    assert q.values() == [0, 1, 2]
    assert q.front() == 0
    assert q.back() == 2
    assert q.pop_front() == 0
    assert q.pop_back() == 2
    assert len(q) == 1
    assert q.pop_back() == 1
    assert q.is_empty()
    assert q.values() == []
}

test "growing while wrapped around keeps the order" {
    mut q = Deque[int64]()
    mut model: [int64] = []
    for i in 0..300 {
        if i % 3 == 0 {
            q.push_front(i)
            model = [i] + model
        } else {
            q.push_back(i)
            model += [i]
        }
        if i % 5 == 0 and len(model) > 0 {
            assert q.pop_front() == model[0]
            model = model[1..]
        }
        if i % 7 == 0 and len(model) > 0 {
            assert q.pop_back() == model[-1]
            model = model[..-1]
        }
    }
    assert q.values() == model
    assert len(q) == len(model)
}

test "a breadth-first walk" {
    let next = [[1, 2], [3], [3], []]
    mut seen = [false] * 4
    mut order: [int64] = []
    mut q = Deque[int64]()
    q.push_back(0)
    seen[0] = true
    for q.pop_front() is int64(at) {
        order += [at]
        for n in next[at] {
            if not seen[n] {
                seen[n] = true
                q.push_back(n)
            }
        }
    }
    assert order == [0, 1, 2, 3]
}

test "a deque is a value" {
    mut q = Deque[str]()
    q.push_back("a")
    q.push_back("b")
    let saved = q
    assert q.pop_front() == "a"
    assert saved.values() == ["a", "b"]
    assert q.values() == ["b"]
}

test "for goes over a deque front to back" {
    mut q = Deque[int64]()
    q.push_back(2)
    q.push_front(1)
    mut seen: [int64] = []
    for x in q {
        seen += [x]
    }
    assert seen == [1, 2]
    assert [x * 10 for x in q] == [10, 20]
    mut numbered: [str] = []
    for i, x in q {
        numbered += [f"{i}:{x}"]
    }
    assert numbered == ["0:1", "1:2"]
}
