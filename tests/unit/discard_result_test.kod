// `let _ = expr` evaluates a value and keeps nothing; a fallible result may be
// dropped only that way.

// What each call did, in order.
mut log: [str] = []

type Door = shared struct {
    open: bool

    func shut(self) -> none or Error {
        log += ["shut"]
    }
}

func close() -> none or Error {
    log += ["closed"]
}

func count() -> int64 {
    log += ["counted"]
    return 3
}

func fails() -> int64 or Error {
    throw Oops(message: "no")
}

type Oops = shared struct {
    message: str
    func to_str(self) -> str { return self.message }
}

test "let _ evaluates the value and keeps nothing" {
    let _ = close()
    let _ = close()
    let _ = count()
    let _ = fails()
    let door = Door(open: true)
    let _ = door.shut()
    count()
    must close()
    let n = count()
    assert log == ["closed", "closed", "counted", "shut", "counted", "closed", "counted"]
    assert n == 3
}
