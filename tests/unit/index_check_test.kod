// Indexing checks bounds with one compare when the index is in range; a
// negative index counts from the end, for reads, stores and `+=`, on arrays
// and strings, and one past either end panics with the index as counted.
import "testing"

test "a negative index counts from the end for reads, stores and +=" {
    mut a: [int64] = [10, 20, 30]
    let s = "abc"
    a[-1] = 33
    a[-3] += 1
    a[1] = a[-2] * 2
    assert a == [11, 40, 33]
    assert a[-1] == 33
    assert a[-3] == 11
    assert s[-1] == 99
    assert s[-3] == 97
    assert s[0] == 97
    assert s[2] == 99
    mut total: int64 = 0
    for i in 0..3 {
        total += a[i] + a[-1 - i]
    }
    assert total == 168
}

test "one past the start panics with the index as counted" {
    let r = testing.run(func() {
        mut a: [int64] = [10, 20, 30]
        a[-1] = 33
        a[-3] += 1
        let far = -4
        print(a[far])
    })
    assert r.status == 1
    assert r.stdout == ""
    assert r.stderr.contains("panic: index -1 out of bounds for array of length 3")
}
