// The interpreter reports `kb.T` for a `T` only another module declares.
import "./qualified_type_wrong_module_ka"
import "./qualified_type_wrong_module_kb"

func key_of(anon e: qualified_type_wrong_module_kb.NotFound) -> str {
    return e.key
}

func main() -> int64 {
    print(key_of(qualified_type_wrong_module_ka.NotFound(key: "k")))
    return 0
}

// expected status:
// 1
// expected stderr:
// 5:52: error: module `qualified_type_wrong_module_kb` has no type `NotFound`
// expected mode:
// interpret
