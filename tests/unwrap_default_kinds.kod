// The default of `x? or default` is built as the unwrapped type: boxed into
// an interface, or a variant of the optional's own enum.
interface Shape {
    func area(self) -> int64
}

type Sq = struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}

type A = enum {
    Hit(n: int64)
    Miss
    Up
}

type B = enum {
    Miss
    Up
    Hit(n: int64)
}

func maybe_shape(anon k: int64) -> Shape? {
    if k > 0 {
        return Sq(s: k)
    }
    return none
}

func maybe_b(anon k: int64) -> B? {
    if k > 0 {
        return .Hit(n: k)
    }
    return none
}

func show(anon b: B) -> str {
    match b {
        .Miss -> return "miss"
        .Up -> return "up"
        .Hit(n) -> return f"hit {n}"
    }
}

func main() -> int64 {
    print_int((maybe_shape(0)? or Sq(s: 3)).area())
    print_int((maybe_shape(2)? or Sq(s: 3)).area())
    print(show(maybe_b(0)? or .Up))
    print(show(maybe_b(0)? or .Hit(n: 4)))
    print(show(maybe_b(7)? or .Miss))
    let n: int64? = none
    print_int(n? or 5)
    return 0
}

// expected output:
// 9
// 4
// up
// hit 4
// hit 7
// 5
