// Type arguments of a generic function are worked out from the call's arguments.

type Box[T] = shared struct {
    v: T

    func twice(self) -> [T] {
        return add(xs: [self.v], x: self.v)
    }
}

type Color = enum {
    Red
    Green
}

interface Named {
    func name(self) -> str
}

type Sq = shared struct {
    func name(self) -> str { return "sq" }
}

type Dot = shared struct {
    func name(self) -> str { return "dot" }
}

func first[T](anon xs: [T]) -> T? {
    if len(xs) == 0 {
        return none
    }
    return xs[0]
}

func map_all[T, U](anon xs: [T], f: func(T) -> U) -> [U] {
    mut out: [U] = []
    for x in xs {
        out += [f(x)]
    }
    return out
}

func id[T](anon x: T) -> T {
    return x
}

func unbox[T](anon b: Box[T]) -> T {
    return b.v
}

func or_else[T](anon x: T?, fallback: T) -> T {
    return x? or fallback
}

func add[T](xs: [T], x: T) -> [T] {
    return xs + [x]
}

func pair_up[A, B](a: A, b: B) -> Box[Box[A]] {
    let _ = b
    return Box[Box[A]](v: Box[A](v: a))
}

func show(anon n: int64) -> str {
    return f"#{n}"
}

func count[T](xs: [T], extra: [T] = []) -> int64 {
    return len(xs) + len(extra)
}

func color_of[T](anon x: T) -> T {
    let copy: T = x
    return copy
}

func depth[T](anon x: T, n: int64) -> int64 {
    if n == 0 {
        return 0
    }
    return 1 + depth(x, n: n - 1)
}

test "inferred from arrays" {
    assert must first([1, 2]) == 1
    assert must first(["a", "b"]) == "a"
    let none_left: [str] = []
    assert first(none_left) is none
    assert (must first([[1, 2], [3]]))[1] == 2
}

test "inferred from function arguments" {
    let strs = map_all([1, 2], f: show)
    assert strs[1] + "!" == "#2!"
    let lens = map_all(["ab", "c"], f: func(anon s: str) -> int64 { return len(s) })
    assert lens[0] + lens[1] == 3
}

test "inferred from plain values, boxes and optionals" {
    assert id(7) + 1 == 8
    assert id("x") + "y" == "xy"
    assert id(true) == true
    assert id(1.5) == 1.5
    assert unbox(Box[str](v: "boxed")) == "boxed"
    assert unbox(id(Box[int64](v: 4))) + 1 == 5

    let maybe: int64? = none
    assert or_else(maybe, fallback: 3) == 3
    assert or_else(5, fallback: 3) == 5
    assert or_else(none, fallback: "z") == "z"
}

test "inferred from labeled arguments and defaults" {
    assert len(add(xs: [], x: 1)) == 1
    assert add(xs: ["a"], x: "b")[1] == "b"
    assert pair_up(a: "deep", b: 2).v.v == "deep"
    assert count(xs: [1, 2]) == 2
    assert count(xs: ["a"], extra: ["b", "c"]) == 3

    let c = color_of(Color.Green)
    assert c is .Green
    assert depth("s", n: 3) == 3
}

test "explicit type arguments" {
    let shape: Named = id[Named](Sq())
    assert shape.name() == "sq"
    assert id[Named](Dot()).name() == "dot"
    let o = id[int64?](none)
    assert o is none
    assert len(map_all[int64, str]([], f: show)) == 0
    assert len(Box[str](v: "m").twice()) == 2
    let id_str = id[str]
    assert id_str("value") == "value"
    assert map_all([1], f: id[int64])[0] == 1
}
