// A struct, enum or interface declared in the importing module wins over
// a same-named alias from an imported module.
import "./alias_shadow_dep"

type Label = struct {
    text: str
    width: int64
}

type Score = enum {
    Low
    High(points: int64)
}

func show(anon l: Label) -> str {
    return f"{l.text}:{l.width}"
}

func main() -> int64 {
    let l = Label(text: "hi", width: 3)
    print(show(l))
    let s: Score = .High(points: 7)
    match s {
        .Low -> print("low")
        .High(points) -> print(f"high {points}")
    }
    print(alias_shadow_dep.describe("x"))
    return 0
}

// expected output:
// hi:3
// high 7
// dep label x
