import "testing"

test "durations keep three significant figures" {
    assert testing.format_duration(208) == "0.21 μs"
    assert testing.format_duration(3920) == "3.92 μs"
    assert testing.format_duration(45678) == "45.7 μs"
    assert testing.format_duration(123456) == "123 μs"
    assert testing.format_duration(1234567) == "1.23 ms"
    assert testing.format_duration(12345678) == "12.3 ms"
    assert testing.format_duration(1234567890) == "1.23 s"
    assert testing.format_duration(61000000000) == "61.0 s"
}

test "a duration rounds half up" {
    assert testing.format_duration(1005) == "1.01 μs"
    assert testing.format_duration(9994) == "9.99 μs"
    assert testing.format_duration(999) == "1.00 μs"
}

test "a zero duration is below the clock's resolution" {
    let s = testing.format_duration(0)
    assert s.starts_with("<0.")
    assert s.ends_with(" μs")
}
