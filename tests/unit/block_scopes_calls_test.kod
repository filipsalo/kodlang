// A call in a block whose binding hides an outer one: a binding that holds
// no function leaves the call to the module's function or the builtin of
// its name, and a function value hides an outer one only inside
// the block, so the outer one is called again after it.
import "testing"

type Pt = shared struct {
    x: int64
}

func double(anon n: int64) -> int64 {
    return n * 2
}

func triple(anon n: int64) -> int64 {
    return n * 3
}

func fail(anon msg: str) -> none {
    panic(msg)
}

func intrinsics(anon len: int64, anon hash: int64) -> str {
    mut out = f"{len + hash}"
    if len > 0 {
        let len = "abc"
        let hash = "ab"
        out += f" {len(len)} {hash(hash) == "ab".hash()}"
    }
    return out
}

func module_fn(anon double: int64) -> int64 {
    if double > 0 {
        let double = double + 1
        return double(double)
    }
    return double
}

func builtin(anon print_int: str) -> none {
    if len(print_int) > 0 {
        let print_int = len(print_int)
        print_int(print_int)
    }
}

func values(anon n: int64) -> none {
    let f = double
    print_int(f(n))
    if n > 0 {
        let f = triple
        print_int(f(n))
        if n > 1 {
            let f = 7
            print_int(f)
        }
        print_int(f(n))
    }
    print_int(f(n))
}

func arm_value(anon o: int64?, anon panic: str) -> int64 {
    if len(panic) > 0 {
        let panic = 1
        let v = match o {
            Some(v) -> v + panic
            none -> panic("none")
        }
        return v + (o? or panic("none"))
    }
    return 0
}

func arm_fail(anon o: int64?, anon fail: int64) -> int64 {
    if fail > 0 {
        let fail = 2
        return match o {
            Some(v) -> v * fail
            none -> fail("none")
        }
    }
    return 0
}

func panics(anon panic: int64) -> none {
    if panic > 0 {
        let panic = "boom"
        panic(panic)
    }
}

test "a binding that holds no function leaves the call to the builtin" {
    assert intrinsics(1, 3) == "4 3 true"
}

test "a binding that holds no function leaves the call to the module's function" {
    assert module_fn(4) == 10
}

test "a binding that holds no function leaves print_int to the builtin" {
    let r = testing.run(func() { builtin("abcd") })
    assert r.status == 0
    assert r.stdout == "4\n"
}

test "a function value hides an outer one only inside the block" {
    let r = testing.run(func() { values(2) })
    assert r.status == 0
    assert r.stdout == "4\n6\n7\n6\n4\n"
}

test "a binding that holds no function leaves panic in a match arm to the builtin" {
    assert arm_value(4, "x") == 9
}

test "a binding that holds no function leaves the call to the module's fail" {
    assert arm_fail(4, 1) == 8
}

test "a binding that holds no function leaves panic to the builtin" {
    let r = testing.run(func() { panics(1) })
    assert r.status == 1
    assert r.stdout == ""
    assert r.stderr.contains("panic: boom")
}
