// The interpreter writes the enums of an ambiguous `.Variant` as the compiler
// does, so the module's own `Shape` and an imported one are told apart.
import "./type_names_pa"

type Shape = enum {
    Circle(r: int64)
    Square(side: int64)
}

func main() -> int64 {
    let v: Shape = .Circle(r: 1)
    let u = .Circle(r: 1)
    return 0
}

// expected status:
// 1
// expected stderr:
// 12:13: error: `.Circle` is ambiguous: `type_names_pa.Shape` and `Shape` both declare it; write `Shape.Circle` or give the value a type
// expected mode:
// interpret
