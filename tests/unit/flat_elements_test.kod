// Arrays of small plain structs and tuples keep their elements inline
// (docs/memory-layout.md): every array operation on them, and leaks.
import "arrays"
import "sets" { Set }
import "sort"

extern func rc_live_bytes() -> int64

type Dir = enum {
    Up
    Down
}

type Cell = struct {
    x: int64
    y: int64

    func sum(self) -> int64 {
        return self.x + self.y
    }

    func bump(mut self, by: int64) -> none {
        self.x += by
    }

    func reset(mut self) -> none {
        self = Cell(x: 0, y: 0)
    }
}

type Mixed = struct {
    on: bool
    w: float64
    d: Dir
    _n: int64 = 7

    func n(self) -> int64 {
        return self._n
    }

    func with_n(self, anon n: int64) -> Mixed {
        mut m = self
        m._n = n
        return m
    }
}

type Pair[A, B] = struct {
    a: A
    b: B
}

type Grid = struct {
    cells: [Cell] = []
}

func take(anon c: Cell) -> int64 {
    return c.x * 10 + c.y
}

func make_cells(anon n: int64) -> [Cell] {
    return [Cell(x: i, y: i * i) for i in 0..n]
}

func bump_at(anon xs: [Cell], at: int64) -> [Cell] {
    mut ys = xs
    ys[at].x += 100
    return ys
}

test "reading and writing elements" {
    mut xs = [Cell(x: 1, y: 2), Cell(x: 3, y: 4)]
    assert xs[0].x == 1 and xs[1].y == 4
    assert xs[-1] == Cell(x: 3, y: 4)
    let c = xs[1]
    assert take(c) == 34 and take(xs[0]) == 12
    assert xs[0].sum() == 3
    xs[0] = Cell(x: 5, y: 6)
    xs[1].y = 9
    xs[1].x += 1
    assert xs == [Cell(x: 5, y: 6), Cell(x: 4, y: 9)]
    assert c == Cell(x: 3, y: 4)
    (xs[0], xs[1]) = (xs[1], xs[0])
    assert xs == [Cell(x: 4, y: 9), Cell(x: 5, y: 6)]
    mut t = [(1, 2), (3, 4)]
    t[0].1 = 20
    t[1] = (t[0].0, t[1].0)
    assert t == [(1, 20), (1, 3)]
    assert str(t) == "[(1, 20), (1, 3)]"
}

test "a mut self method changes the element" {
    mut xs = [Cell(x: 1, y: 2), Cell(x: 3, y: 4)]
    xs[1].bump(by: 10)
    assert xs[1] == Cell(x: 13, y: 4)
    xs[0].reset()
    assert xs[0] == Cell(x: 0, y: 0)
    mut g = Grid(cells: make_cells(3))
    g.cells[2].bump(by: 1)
    g.cells[0].y = 5
    assert g.cells == [Cell(x: 0, y: 5), Cell(x: 1, y: 1), Cell(x: 3, y: 4)]
}

test "copies don't share elements" {
    let xs = make_cells(3)
    let ys = bump_at(xs, at: 1)
    assert xs[1].x == 1 and ys[1].x == 101
    mut zs = xs
    zs[0] = Cell(x: -1, y: -1)
    assert xs[0] == Cell(x: 0, y: 0)
    mut nested = [[Cell(x: 1, y: 1)], [Cell(x: 2, y: 2)]]
    let before = nested
    nested[1][0].x = 7
    assert before[1][0].x == 2 and nested[1][0].x == 7
}

test "growing, slicing and repeating" {
    mut xs: [Cell] = []
    for i in 0..100 {
        xs += [Cell(x: i, y: -i)]
    }
    xs += [Cell(x: 100, y: 0), Cell(x: 101, y: 0)]
    xs = xs + make_cells(2)
    assert len(xs) == 104 and xs[57] == Cell(x: 57, y: -57)
    assert xs[100..102] == [Cell(x: 100, y: 0), Cell(x: 101, y: 0)]
    assert xs[102..] == make_cells(2)
    let rep = [(1, 2)] * 3 + [(3, 4)]
    assert rep == [(1, 2), (1, 2), (1, 2), (3, 4)]
    assert arrays.pop(mut xs) == Cell(x: 1, y: 1)
    xs = xs[..3]
    assert xs == [Cell(x: 0, y: 0), Cell(x: 1, y: -1), Cell(x: 2, y: -2)]
    let squares = [(i, i * i) for i in 0..4 if i != 2]
    assert squares == [(0, 0), (1, 1), (3, 9)]
}

func cell_of(anon c: Cell) -> Cell {
    return Cell(x: c.y, y: c.x)
}

type Empty = shared struct {
    n: int64 = 0

    func to_str(self) -> str {
        return "empty"
    }
}

func first_x(anon xs: [Cell]) -> int64 or Error {
    if len(xs) == 0 {
        throw Empty()
    }
    return xs[0].x
}

func pushed(anon xs: [Cell]) -> int64 or Error {
    mut ys = xs
    ys += [Cell(x: try first_x(xs), y: len(ys))]
    return ys[-1].x + ys[-1].y
}

test "pushing a literal" {
    mut xs: [Cell] = []
    for i in 0..5 {
        // Fields that read the array, a literal inside a call, and both forms.
        xs += [Cell(x: len(xs), y: if len(xs) > 0 { xs[0].x + i } else { -1 })]
        xs = xs + [cell_of(Cell(x: i, y: 100))]
    }
    assert xs[0] == Cell(x: 0, y: -1) and xs[1] == Cell(x: 100, y: 0)
    assert xs[8] == Cell(x: 8, y: 4) and xs[9] == Cell(x: 100, y: 4)
    mut ms: [Mixed] = []
    ms += [Mixed(on: true, w: 0.25, d: .Up)]
    ms += [Mixed(on: false, w: 1.0, d: .Down).with_n(9)]
    assert ms[0].n() == 7 and ms[1].n() == 9 and ms[1].d is .Down and ms[0].w == 0.25
    mut ps: [Pair[int64, bool]] = []
    ps += [Pair[int64, bool](a: 4, b: true)]
    mut ts: [(int64, int64, int64)] = []
    for i in 0..3 {
        ts += [(i, ps[0].a, len(ts))]
    }
    assert ps[0].b and ts == [(0, 4, 0), (1, 4, 1), (2, 4, 2)]
    assert pushed([]) is Error and pushed([Cell(x: 3, y: 0)]) is int64(4)
}

test "for, in, index_of and sorting" {
    let xs = [(3, 1), (1, 2), (2, 0)]
    mut total = 0
    for (a, b) in xs {
        total += a * 10 + b
    }
    assert total == 31 + 12 + 20
    mut seen: [(int64, int64)] = []
    for i, p in xs {
        seen += [(i, p.0)]
    }
    assert seen == [(0, 3), (1, 1), (2, 2)]
    assert (1, 2) in xs and (2, 1) not in xs
    assert arrays.index_of(xs, (2, 0)) == 2
    assert sort.sorted(xs) == [(1, 2), (2, 0), (3, 1)]
    assert sort.sorted_by_key(xs, key: func(anon p: (int64, int64)) -> int64 { return p.1 }) == [(2, 0), (3, 1), (1, 2)]
    assert arrays.reversed(xs)[0] == (2, 0)
}

test "other field kinds" {
    mut ms = [Mixed(on: true, w: 1.5, d: .Down), Mixed(on: false, w: -2.0, d: .Up).with_n(3)]
    assert ms[0].on and ms[0].w == 1.5 and ms[0].d is .Down and ms[0].n() == 7
    assert not ms[1].on and ms[1].d is .Up and ms[1].n() == 3
    ms[1].on = true
    ms += [ms[0]]
    assert ms[1].on and ms[2] == ms[0]
    let ps = [Pair[int64, bool](a: 1, b: true), Pair[int64, bool](a: 2, b: false)]
    assert ps[1].a == 2 and not ps[1].b
    let fs: [(float64, bool, int64)] = [(0.5, true, 3)]
    assert fs[0].0 == 0.5 and fs[0].1 and fs[0].2 == 3
}

test "map and set keys" {
    mut s = Set[(int64, int64)]()
    for x in 0..50 {
        for y in 0..50 {
            s.add((x, y))
        }
    }
    assert len(s) == 2500 and (49, 0) in s and (50, 0) not in s
    for x in 0..50 {
        s.remove((x, x))
    }
    assert len(s) == 2450 and (3, 3) not in s and (3, 4) in s
    mut m = Map[Cell, str]()
    m[Cell(x: 1, y: 2)] = "a"
    m[Cell(x: 2, y: 1)] = "b"
    m[Cell(x: 1, y: 2)] += "c"
    assert m[Cell(x: 1, y: 2)] == "ac" and len(m) == 2
    mut keys: [Cell] = []
    for k, _v in m {
        keys += [k]
    }
    assert keys == [Cell(x: 1, y: 2), Cell(x: 2, y: 1)]
}

test "nothing leaks" {
    let start = rc_live_bytes()
    for round in 0..20 {
        mut xs = make_cells(50)
        xs[3].bump(by: round)
        xs += [Cell(x: round, y: 0)]
        let ys = xs[1..10] + xs[20..30]
        mut s = Set[(int64, int64)]()
        for c in ys {
            s.add((c.x, c.y))
        }
        assert len(s) == 19
        let c = xs[4]
        assert take(c) == 56
    }
    assert rc_live_bytes() - start <= 0
}
