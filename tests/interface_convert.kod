// An interface value converts to an interface with a subset of its methods.

interface Reader {
    func read(self) -> int64
}

interface Named {
    func name(self) -> str
}

interface ReadCloser {
    func close(self) -> none
    func name(self) -> str
    func read(self) -> int64
}

type File = struct {
    n: int64

    func read(self) -> int64 {
        return self.n
    }

    func name(self) -> str {
        return f"file{self.n}"
    }

    func close(self) -> none {
        print("closed")
    }
}

type Other = struct {
    func read(self) -> int64 {
        return 100
    }

    func name(self) -> str {
        return "other"
    }

    func close(self) -> none {
    }
}

type Holder = struct {
    r: Reader
}

func drain(anon r: Reader) -> int64 {
    return r.read()
}

func narrow(anon rc: ReadCloser) -> Reader {
    return rc
}

func maybe(anon rc: ReadCloser) -> Reader? {
    return rc
}

func main() -> int64 {
    let rc: ReadCloser = File(n: 7)
    print_int(drain(rc))
    let r: Reader = rc
    print_int(r.read())
    let n: Named = rc
    print(n.name())

    // The new value is still the same File.
    if r is File(f) {
        print_int(f.n)
    }
    if r is Other(_) {
        print("wrong")
    }
    match n {
        File(f) -> print_int(f.n + 1)
        else -> print("wrong")
    }

    let other: ReadCloser = Other()
    let o: Reader = other
    if o is File(_) {
        print("wrong")
    }
    if o is Other(_) {
        print("other")
    }

    print_int(narrow(rc).read())
    let m = maybe(rc)
    print_int((m? or narrow(other)).read())
    let h = Holder(r: rc)
    print_int(h.r.read())

    // A converted value converts again.
    let back: Reader = narrow(rc)
    print_int(back.read())

    // The original is untouched.
    rc.close()
    return 0
}

// expected output:
// 7
// 7
// file7
// 7
// 8
// other
// 7
// 7
// 7
// 7
// closed

// expected status:
// 0

// expected mode:
// run
