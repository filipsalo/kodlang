// A dep that imports this module back registers its structs and
// interfaces a second time; both registrations are the same type.
import "./../cyclic_import_struct_dep"

interface Named {
    func name(self) -> str
}

type Pt = shared struct {
    x: int64
    y: int64

    func name(self) -> str {
        return f"pt{self.x}"
    }
}

func total(anon p: Pt) -> int64 {
    return p.x + p.y
}

test "values passed to the dep" {
    let p = Pt(x: 1, y: 2)
    assert cyclic_import_struct_dep.sum(p) == 3
    assert cyclic_import_struct_dep.sum_all([p, Pt(x: 3, y: 4)]) == 10
    let o: Pt? = p
    assert cyclic_import_struct_dep.first_x(o) == 1
    mut m = Map[str, Pt]()
    cyclic_import_struct_dep.store(mut m, p)
    assert total(must m["a"]) == 3
    let n: Named = p
    assert cyclic_import_struct_dep.show(n) == "pt1"
    assert cyclic_import_struct_dep.show(Pt(x: 7, y: 0)) == "pt7"
}

test "values the dep makes" {
    let q: Pt = cyclic_import_struct_dep.make()
    assert total(q) == 11
    let qs: [Pt] = cyclic_import_struct_dep.make_all()
    assert len(qs) == 2
    let qo: Pt? = cyclic_import_struct_dep.make_opt()
    if qo is Some(v) {
        assert v.y == 6
    } else {
        fail("make_opt gave none")
    }
    let qm: Map[str, Pt] = cyclic_import_struct_dep.make_map()
    assert total(must qm["k"]) == 11
    let qn: Named = cyclic_import_struct_dep.make_named()
    assert qn.name() == "pt5"
}
