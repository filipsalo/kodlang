// String ==, != and string patterns in match check the lengths inline before
// comparing bytes: equal lengths with different bytes, different lengths,
// the empty string, and a literal with an escape and a multi-byte character.
// Against a "" literal, on either side, only the length is read.

type Holder = shared struct {
    err: str = ""
}

func made(anon n: int64) -> str {
    mut s = ""
    for _ in 0..n {
        s += "x"
    }
    return s
}

func kind(anon s: str) -> str {
    match s {
        "" -> return "empty"
        "é\n" -> return "accent"
        "abc" -> return "abc"
        "abd" -> return "abd"
        else -> return "other"
    }
}

test "== and != on strings" {
    let a = "abc"
    let b = "ab" + "c"
    let e = ""
    assert f"{a == b} {a != b} {a == "abd"} {a != "abd"} {a == "ab"} {e == ""} {e != ""} {a < "abd"} {"b" > a}" == "true false false true false true false true true"
}

test "string patterns in match" {
    assert f"{kind("")} {kind("é\n")} {kind("abc")} {kind("abd")} {kind("ab")} {kind("é")}" == "empty accent abc abd other other"
    mut n: int64 = 0
    for w in ["x", "", "abc", "abcd"] {
        match w {
            "" -> n += 1
            "abc" -> n += 10
            else -> n += 100
        }
    }
    assert n == 211
}

test "comparing with the empty string" {
    mut h = Holder()
    let before = h.err == ""
    h.err = made(2)
    assert f"{before} {h.err == ""} {"" == h.err} {h.err != ""} {"" != made(0)} {made(0) == ""} {made(1)[1..1] == ""}" == "true false false true false true true"
}
