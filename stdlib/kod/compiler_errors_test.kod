}

test "an optional, a mismatched element or bytes where a plain value is expected" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Any {}
        type Words = [str]
        func main() -> int64 {
            let m = Map[str, int64]()
            let n: int64 = m.get("k")
            let w: Words? = [1]
            let a: Any = b"x"
            return 0
        }
        """)
