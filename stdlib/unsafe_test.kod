import "unsafe"

extern func pipe(anon fds: int64) -> int64
extern func close(anon fd: int64) -> int64
extern func getenv(anon name: int64) -> int64
extern func strlen(anon s: int64) -> int64
extern func write(anon fd: int64, anon buf: int64, anon n: int64) -> int64
extern func read(anon fd: int64, anon buf: int64, anon n: int64) -> int64

test "alloc gives zeroed memory that loads and stores reach" {
    let p = unsafe.alloc(16)
    assert p != 0
    assert unsafe.load64(p) == 0
    assert unsafe.load64(p + 8) == 0
    unsafe.store64(p, 0x0102030405060708)
    assert unsafe.load64(p) == 0x0102030405060708
    assert unsafe.load8(p) == 8                 // little-endian
    assert unsafe.load8(p + 7) == 1
    assert unsafe.load32(p + 4) == 0x01020304
    unsafe.free(p)
    unsafe.free(0)
}

test "store8 and store32 write only their bytes" {
    let p = unsafe.alloc(8)
    unsafe.store64(p, -1)
    unsafe.store8(p, 0x1234)
    assert unsafe.load8(p) == 0x34
    assert unsafe.load8(p + 1) == 255
    unsafe.store32(p + 4, 7)
    assert unsafe.load32(p + 4) == 7
    assert unsafe.load32(p) == -204             // 0xffffff34
    unsafe.free(p)
}

test "load32 is signed, load8 is not" {
    let p = unsafe.alloc(8)
    unsafe.store32(p, -5)
    assert unsafe.load32(p) == -5
    unsafe.store8(p, -1)
    assert unsafe.load8(p) == 255
    unsafe.free(p)
}

test "c_int keeps the low four bytes, signed" {
    assert unsafe.c_int(0xffffffff) == -1
    assert unsafe.c_int(0x100000005) == 5
    assert unsafe.c_int(0x7fffffff) == 0x7fffffff
    assert unsafe.c_int(0x80000000) == -0x80000000
    assert unsafe.c_int(-3) == -3
}

test "c_str hands C the string's own bytes with a 0 after them" {
    let s = "hello"
    assert strlen(unsafe.c_str(s)) == 5
    let tail = "say hello"[4..9]
    assert strlen(unsafe.c_str(tail)) == 5
    assert strlen(unsafe.c_str("")) == 0
}

test "str_at copies a C string" {
    let s = "copied"
    assert unsafe.str_at(unsafe.c_str(s)) == "copied"
    assert getenv(unsafe.c_str("KOD_UNSAFE_TEST_UNSET_ON_PURPOSE")) == 0
    let path = getenv(unsafe.c_str("PATH"))
    assert path != 0
    assert len(unsafe.str_at(path)) > 0
}

test "copy_in and copy_out move bytes" {
    let p = unsafe.alloc(4)
    unsafe.copy_in(p, kod_str_to_bytes("abcd"))
    assert unsafe.load8(p + 2) == 'c'
    assert str(unsafe.copy_out(p + 1, 3)) == "bcd"
    assert len(unsafe.copy_out(p, 0)) == 0
    unsafe.free(p)
}

test "a pipe made and used through raw memory" {
    let fds = unsafe.alloc(8)
    assert unsafe.c_int(pipe(fds)) == 0
    let r = unsafe.load32(fds)
    let w = unsafe.load32(fds + 4)
    unsafe.free(fds)
    let msg = kod_str_to_bytes("through C")
    assert write(w, unsafe.data(msg), len(msg)) == len(msg)
    let buf = unsafe.alloc(64)
    let n = read(r, buf, 64)
    assert n == len(msg)
    assert str(unsafe.copy_out(buf, n)) == "through C"
    unsafe.free(buf)
    assert unsafe.c_int(close(w)) == 0
    assert unsafe.c_int(close(r)) == 0
}

test "errno says why a call failed" {
    assert unsafe.c_int(close(-1)) == -1
    assert unsafe.errno() == 9                  // EBADF
}
