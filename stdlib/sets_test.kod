import "sets" { Set }

type IntSet = Set[int64]
type StrSet = Set[str]

func empty_int_set() -> IntSet {
    return Set[int64]()
}

func empty_str_set() -> StrSet {
    return StrSet()
}

test "empty: len 0, contains nothing" {
    let s: IntSet = empty_int_set()
    assert len(s) == 0
    assert not s.contains(42)
}

test "add then contains" {
    let s: IntSet = empty_int_set()
    s.add(7)
    assert s.contains(7)
    assert not s.contains(8)
    assert len(s) == 1
}

test "adding the same element twice is idempotent" {
    let s: IntSet = empty_int_set()
    s.add(7)
    s.add(7)
    s.add(7)
    assert len(s) == 1
    assert s.contains(7)
}

test "many adds grow the underlying table" {
    let s: IntSet = empty_int_set()
    mut i: int64 = 0
    for i < 50 {
        s.add(i * 3)
        i = i + 1
    }
    assert len(s) == 50
    assert s.contains(0)
    assert s.contains(49 * 3)
    assert not s.contains(1)
}

test "Set[str] uses content equality, not pointer identity" {
    let s: StrSet = empty_str_set()
    s.add("hello")
    let lookup: str = "hel" + "lo"
    // Distinct buffer, same bytes — should still hit.
    assert s.contains(lookup)
    assert not s.contains("world")
}

test "each new set has its own items" {
    let a = Set[int64]()
    let b = Set[int64]()
    a.add(1)
    assert a.contains(1)
    assert not b.contains(1)
}

test "remove, values and for go in the order elements were first added" {
    let s = Set[str]()
    s.add("b")
    s.add("a")
    s.add("c")
    assert s.remove("a")
    assert not s.remove("a")
    assert not s.contains("a")
    assert len(s) == 2
    s.add("a")
    assert " ".join(s.values()) == "b c a"
    mut seen: [str] = []
    for x in s {
        seen += [x]
    }
    assert " ".join(seen) == "b c a"
}
