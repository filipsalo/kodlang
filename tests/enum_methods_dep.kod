// An enum with methods, used from tests/enum_methods.kod.

type Level = enum {
    Low
    High(by: int64)

    func weight(self, base: int64 = 10) -> int64 {
        return match self {
            .Low -> base
            .High(by) -> base * by + self._bonus()
        }
    }

    func _bonus(self) -> int64 {
        return 1
    }
}
