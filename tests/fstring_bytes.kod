// A `bytes` value interpolates as its contents, as `str(b)` converts it.

func main() -> int64 {
    let raw = b"raw"
    let empty = b""
    print(f"[{raw}] [{empty}] [{raw + b"!"}]")
    print(str(raw[1..3]))
    print(f"{len(raw)} {raw[0]}")
    return 0
}

// expected output:
// [raw] [] [raw!]
// aw
// 3 114
