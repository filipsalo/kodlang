// A local named like a generic type that another module declares is no
// generic constructor: indexing it and calling the result is a call of
// whatever it holds.
import "./type_bare_generic_ctor_dep"

func twice(anon x: int64) -> int64 {
    return x * 2
}

func main() -> int64 {
    let Box = [twice]
    print_int(Box[0](3))
    return 0
}

// expected output:
// 6
