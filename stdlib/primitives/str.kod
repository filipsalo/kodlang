// Methods on the str primitive type. The compiler dispatches
// `s.to_str()`, `s.hash()` etc. for str receivers to these functions.
//
// ── Encoding contract ──────────────────────────────────────────────
// A `str` is a sequence of bytes (UTF-8 by convention, but the runtime
// imposes no validation). The "raw" operations work in bytes:
//
//   - `len(s)`     → byte count
//   - `s[i]`       → the byte at offset i (an int64 in 0..255)
//   - `s[a..b]`    → byte-range slice
//   - `s == s'`    → bytewise compare
//
// The Unicode-aware operations work in code points and assume the
// bytes are valid UTF-8. They use a permissive decoder: any invalid
// byte sequence falls back to "emit the byte as a code point in
// 0..255 and advance by one." That means concatenating two valid
// UTF-8 strings is still well-defined, garbage stays garbage, and
// no operation ever panics on a malformed input.
//
//   - `s.code_points()`  → [int64] of decoded code points
//   - `s.char_count()`   → number of code points
//
// Long-term direction: `str` becomes Unicode-shaped (indexing and
// length speak code points by default, byte access moves to a
// separate type). The byte ops stay the source of truth until then;
// new code that handles user text should prefer `code_points`.

import "primitives/format" { format_text }

// The 8 bytes from `at`, lowest first, as kod_bytes_le64 reads them from bytes.
extern func kod_bytes_le64(anon s: str, anon at: int64) -> int64
// As in stdlib/unsafe.kod, which uses this module.
extern func kod_unsafe_load64(anon addr: int64) -> int64
extern func kod_unsafe_store8(anon addr: int64, anon value: int64) -> none
extern func kod_unsafe_store64(anon addr: int64, anon value: int64) -> none
extern func kod_unsafe_str_ref(anon s: str) -> int64
extern func kod_unsafe_copy_out(anon addr: int64, anon n: int64) -> bytes

func to_str(self: str) -> str {
    return self
}

// The text padded or cut as a format spec says, as `f"{s:spec}"` writes it
// (see docs/strings.md); a spec that doesn't fit text panics.
func format(self: str, anon spec: str) -> str {
    return format_text(self, :spec)
}

// djb2: small constants, no 64-bit literals required, decent
// distribution for the short strings we hash (mostly identifiers).
func hash(self: str) -> int64 {
    mut h: int64 = 5381
    mut i: int64 = 0
    let n: int64 = len(self)
    for i < n {
        h = h * 33 + self[i]
        i = i + 1
    }
    return h
}

// Internal: byte width (1..4) of the UTF-8 sequence starting at
// byte offset `i`. Returns 1 for any sequence we can't classify as
// valid — that's the permissive-decode contract: "consume one byte,
// emit it as its own code point, move on."
//
// Encoding (`b1` is the start byte; continuation bytes match
// `10xxxxxx` = decimal 128..192):
//
//     0xxxxxxx                     → 1 byte,  code points 0..127
//     110xxxxx 10xxxxxx            → 2 bytes, 128..2047
//     1110xxxx 10xxxxxx 10xxxxxx   → 3 bytes, 2048..65535
//     11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
//                                  → 4 bytes, 65536..1114111
func _utf8_width_at(self: str, anon i: int64) -> int64 {
    let n: int64 = len(self)
    let b: int64 = self[i]
    if b < 192 {
        // ASCII (< 128) or a bare continuation byte (128..192).
        return 1
    }
    if b < 224 {
        if i + 1 < n {
            let b2: int64 = self[i + 1]
            if b2 >= 128 and b2 < 192 {
                return 2
            }
        }
        return 1
    }
    if b < 240 {
        if i + 2 < n {
            let b2: int64 = self[i + 1]
            let b3: int64 = self[i + 2]
            if b2 >= 128 and b2 < 192 and b3 >= 128 and b3 < 192 {
                return 3
            }
        }
        return 1
    }
    if b < 248 {
        if i + 3 < n {
            let b2: int64 = self[i + 1]
            let b3: int64 = self[i + 2]
            let b4: int64 = self[i + 3]
            if b2 >= 128 and b2 < 192 and b3 >= 128 and b3 < 192 and b4 >= 128 and b4 < 192 {
                return 4
            }
        }
        return 1
    }
    return 1
}

// Internal: decode the code-point value at byte offset `i`, given the
// already-classified `width`. Caller must have obtained `width` from
// `_utf8_width_at` (or otherwise guaranteed its accuracy); passing a
// bogus width skips the classification and yields garbage.
func _utf8_value_at(self: str, anon i: int64, anon width: int64) -> int64 {
    let b: int64 = self[i]
    if width == 1 {
        return b
    }
    if width == 2 {
        return (b - 192) * 64 + (self[i + 1] - 128)
    }
    if width == 3 {
        return (b - 224) * 4096 + (self[i + 1] - 128) * 64 + (self[i + 2] - 128)
    }
    return (b - 240) * 262144 + (self[i + 1] - 128) * 4096 + (self[i + 2] - 128) * 64 + (self[i + 3] - 128)
}

// Decode `self` as UTF-8 and return the sequence of code points.
// See `_utf8_width_at` for the encoding sketch and the
// permissive-decode contract on invalid input.
func code_points(self: str) -> [int64] {
    mut result: [int64] = []
    let n: int64 = len(self)
    mut i: int64 = 0
    for i < n {
        let width: int64 = self._utf8_width_at(i)
        result += [self._utf8_value_at(i, width)]
        i = i + width
    }
    return result
}

// Count UTF-8 code points without materialising the array — only the
// per-code-point byte width is needed here, so the value-decoding
// arithmetic is skipped.
func char_count(self: str) -> int64 {
    let n: int64 = len(self)
    mut i: int64 = 0
    mut count: int64 = 0
    for i < n {
        i = i + self._utf8_width_at(i)
        count = count + 1
    }
    return count
}

// Return the `n`-th code point. Negative `n` counts from the end:
// `s.char_at(-1)` is the last code point. Out-of-bounds (after
// normalisation) routes through `kod_index_oob`, the same path
// byte-level `s[i]` uses on OOB.
//
// Two passes for negative indices (count, then walk); positive
// indices walk once until they hit `n`. UTF-8 isn't random-access in
// either direction without a sidecar index, and we don't carry one,
// so a constant-time `char_at` would need a different storage shape.
func char_at(self: str, anon index: int64) -> int64 {
    mut n = index
    if n < 0 {
        n = n + self.char_count()
    }
    let len_bytes: int64 = len(self)
    mut i: int64 = 0
    mut cur: int64 = 0
    for i < len_bytes {
        let width: int64 = self._utf8_width_at(i)
        if cur == n {
            return self._utf8_value_at(i, width)
        }
        cur = cur + 1
        i = i + width
    }
    // Walked off the end without hitting `n` — same OOB path as `s[i]`.
    kod_index_oob(n, cur)
    return 0
}

// Code-point-aware substring. Returns the segment from code-point
// index `a` (inclusive) to `b` (exclusive), the same shape as the
// byte slice `s[a..b]` but respecting UTF-8 boundaries. Negative
// indices count from the end; both ends clamp to the string's
// extent. `a >= b` (after clamping) returns "" — never panics on
// out-of-range bounds, matching Python's slice semantics.
//
// Walks the bytes once. For each code-point boundary we either
// (a) record the byte offset for `a` or `b`, or (b) keep walking.
func char_slice(self: str, anon start: int64, anon end: int64) -> str {
    mut a = start
    mut b = end
    let total: int64 = self.char_count()
    if a < 0 {
        a = a + total
    }
    if b < 0 {
        b = b + total
    }
    if a < 0 {
        a = 0
    }
    if b > total {
        b = total
    }
    if a >= b {
        return ""
    }

    let len_bytes: int64 = len(self)
    mut i: int64 = 0
    mut cur: int64 = 0
    mut a_byte: int64 = 0
    mut b_byte: int64 = len_bytes
    for i < len_bytes {
        if cur == a {
            a_byte = i
        }
        if cur == b {
            b_byte = i
            break
        }
        i = i + self._utf8_width_at(i)
        cur = cur + 1
    }
    return self[a_byte..b_byte]
}

// Levenshtein edit distance: minimum number of single-character
// insertions, deletions, or substitutions to transform `self` into
// `other`. Cost-1 per edit. Compares bytes; for ASCII identifiers
// (the typical caller — "did you mean X?" suggestions in the
// compiler's error messages) byte distance equals character
// distance, which is what we want.
//
// Iterative DP with two rolling rows: O(len(self) * len(other))
// time, O(len(other)) space.
func distance(self: str, anon other: str) -> int64 {
    let n: int64 = len(self)
    let m: int64 = len(other)
    if n == 0 {
        return m
    }
    if m == 0 {
        return n
    }
    // `prev[j]` holds the distance for `self[0..i-1]` → `other[0..j-1]`;
    // `cur[j]` is the same row shifted by one position in `self`.
    mut prev: [int64] = []
    mut p: int64 = 0
    for p <= m {
        prev += [p]
        p = p + 1
    }
    mut i: int64 = 0
    for i < n {
        mut cur: [int64] = [i + 1]
        mut j: int64 = 0
        for j < m {
            mut cost: int64 = 1
            if self[i] == other[j] {
                cost = 0
            }
            let del: int64 = prev[j + 1] + 1
            let ins: int64 = cur[j] + 1
            let sub: int64 = prev[j] + cost
            mut best: int64 = del
            if ins < best {
                best = ins
            }
            if sub < best {
                best = sub
            }
            cur += [best]
            j = j + 1
        }
        prev = cur
        i = i + 1
    }
    return prev[m]
}

// True if `needle` appears anywhere in `self`. Empty needle is always
// present; needle longer than self is never present. Naive byte-by-byte
// scan — fine for the short strings we use in tests and diagnostics.
func contains(self: str, anon needle: str) -> bool {
    return self._find(needle, 0) >= 0
}

// True if `needle` occurs in `self` starting exactly at byte `i`.
// The caller guarantees `i + len(needle) <= len(self)`.
func _matches_at(self: str, anon needle: str, anon i: int64) -> bool {
    let m: int64 = len(needle)
    mut j: int64 = 0
    for j + 8 <= m {
        if kod_bytes_le64(self, i + j) != kod_bytes_le64(needle, j) {
            return false
        }
        j += 8
    }
    for j < m {
        if self[i + j] != needle[j] {
            return false
        }
        j = j + 1
    }
    return true
}

func starts_with(self: str, anon prefix: str) -> bool {
    if len(prefix) > len(self) {
        return false
    }
    return self._matches_at(prefix, 0)
}

func ends_with(self: str, anon suffix: str) -> bool {
    let start: int64 = len(self) - len(suffix)
    if start < 0 {
        return false
    }
    return self._matches_at(suffix, start)
}

// Byte offset of the first occurrence of `needle` at or after `from`
// (clamped into 0..len), or none. An empty needle is found at `from`.
func find(self: str, anon needle: str, from: int64 = 0) -> int64? {
    let at = self._find(needle, from)
    if at < 0 {
        return none
    }
    return at
}

// As find; -1 for none. Eight places are looked at at once: where `needle`'s first
// byte is and, so far on, its last.
func _find(self: str, anon needle: str, anon from: int64) -> int64 {
    let n = len(self)
    let m = len(needle)
    mut i = from
    if i < 0 {
        i = 0
    }
    if i > n {
        i = n
    }
    if m == 0 {
        return i
    }
    let last = n - m
    if i > last {
        return -1
    }
    let ones = 0x0101010101010101
    let highs = ones << 7
    let first_byte = needle[0]
    let first = first_byte * ones
    let far = m - 1
    let end = needle[far] * ones
    for i + far + 8 <= n {
        // A byte of `x` is 0 where the first byte is. Its high bit is then set in
        // what `- ones` and `highs` leave, and maybe in some above it too.
        let x = kod_bytes_le64(self, i) ^ first
        mut hits = x - ones & (x ^ -1) & highs
        if hits != 0 and m > 1 {
            let y = kod_bytes_le64(self, i + far) ^ end
            hits = hits & y - ones & (y ^ -1)
        }
        for hits != 0 {
            let at = i + (hits.trailing_zeros() >> 3)
            if self[at] == first_byte and (m == 1 or self._matches_at(needle, at)) {
                return at
            }
            hits = hits & hits - 1
        }
        i += 8
    }
    for i <= last {
        if self[i] == first_byte and (m == 1 or self._matches_at(needle, i)) {
            return i
        }
        i += 1
    }
    return -1
}

func strip_prefix(self: str, anon prefix: str) -> str? {
    if self.starts_with(prefix) {
        return self[len(prefix)..len(self)]
    }
    return none
}

func strip_suffix(self: str, anon suffix: str) -> str? {
    if self.ends_with(suffix) {
        return self[0..len(self) - len(suffix)]
    }
    return none
}

// Pieces between occurrences of `sep`, empty ones kept. Always at least
// one piece; an empty `sep` doesn't split.
func split(self: str, anon sep: str) -> [str] {
    mut parts: [str] = []
    let m: int64 = len(sep)
    if m == 0 {
        parts += [self]
        return parts
    }
    mut start: int64 = 0
    for true {
        let i = self._find(sep, start)
        if i < 0 {
            break
        }
        parts += [self[start..i]]
        start = i + m
    }
    parts += [self[start..len(self)]]
    return parts
}

func _is_space(anon b: int64) -> bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

func trim_start(self: str) -> str {
    let n: int64 = len(self)
    mut i: int64 = 0
    for i < n and _is_space(self[i]) {
        i = i + 1
    }
    return self[i..n]
}

func trim_end(self: str) -> str {
    mut j: int64 = len(self)
    for j > 0 and _is_space(self[j - 1]) {
        j = j - 1
    }
    return self[0..j]
}

func trim(self: str) -> str {
    let n = len(self)
    mut i: int64 = 0
    for i < n and _is_space(self[i]) {
        i += 1
    }
    mut j = n
    for j > i and _is_space(self[j - 1]) {
        j -= 1
    }
    return self[i..j]
}

// `self` placed between the `parts`: ", ".join(["a", "b"]) is "a, b".
func join(self: str, anon parts: [str]) -> str {
    let sb: str = kod_sb_new()
    mut first: bool = true
    for p in parts {
        if not first {
            kod_sb_append(sb, self)
        }
        first = false
        kod_sb_append(sb, p)
    }
    return kod_sb_to_str(sb)
}

func repeat(self: str, anon n: int64) -> str {
    let sb: str = kod_sb_new()
    mut i: int64 = 0
    for i < n {
        kod_sb_append(sb, self)
        i = i + 1
    }
    return kod_sb_to_str(sb)
}

// Every non-overlapping `old`, scanning left to right, becomes `to`.
// An empty `old` replaces nothing.
func replace(self: str, anon old: str, to: str) -> str {
    let m: int64 = len(old)
    if m == 0 {
        return self
    }
    let sb: str = kod_sb_new()
    mut start: int64 = 0
    for true {
        let i = self._find(old, start)
        if i < 0 {
            break
        }
        kod_sb_append(sb, self[start..i])
        kod_sb_append(sb, to)
        start = i + m
    }
    kod_sb_append(sb, self[start..len(self)])
    return kod_sb_to_str(sb)
}

// ASCII only: other bytes, UTF-8 sequences included, are kept as they are.
func lower(self: str) -> str {
    return self._other_case(65)
}

func upper(self: str) -> str {
    return self._other_case(97)
}

// `self` with its ASCII letters of one case in the other: `from` is the first of
// them, an `A` or an `a`. Itself when there are none.
func _other_case(self: str, anon from: int64) -> str {
    let n = len(self)
    mut i: int64 = 0
    for i + 8 <= n and _letters(kod_bytes_le64(self, i), from) == 0 {
        i += 8
    }
    for i < n and not (from <= self[i] < from + 26) {
        i += 1
    }
    if i == n {
        return self
    }
    let out = kod_bytes_to_str(kod_unsafe_copy_out(kod_unsafe_load64(kod_unsafe_str_ref(self)), n))
    let to = kod_unsafe_load64(kod_unsafe_str_ref(out))
    for i + 8 <= n {
        let w = kod_bytes_le64(self, i)
        kod_unsafe_store64(to + i, w ^ (_letters(w, from) >> 2))
        i += 8
    }
    for i < n {
        let b = self[i]
        if from <= b < from + 26 {
            kod_unsafe_store8(to + i, b ^ 32)
        }
        i += 1
    }
    return out
}

// The high bit of each byte of `w` that is one of the 26 letters from `from`.
func _letters(anon w: int64, anon from: int64) -> int64 {
    let ones = 0x0101010101010101
    // No byte's sum carries out of it.
    let low = w & 0x7f7f7f7f7f7f7f7f
    let reach = low + (128 - from) * ones
    let pass = low + (102 - from) * ones
    return reach & ((pass | w) ^ -1) & ones << 7
}

// The number that eight digits make, the first one in the lowest byte; -1 when they
// aren't all digits.
func _eight_digits(anon w: int64) -> int64 {
    let x = w - 0x3030303030303030
    // A byte that is no digit has its high bit set in one of these, or makes the one
    // above it have.
    if (w + 0x4646464646464646 | x) & 0x0101010101010101 << 7 != 0 {
        return -1
    }
    // Pairs, then fours, then all eight.
    let pairs = x * 10 + (x >> 8)
    let low = (pairs & 0x000000ff000000ff) * 0x000f424000000064
    let high = (pairs >> 16 & 0x000000ff000000ff) * 0x0000271000000001
    return low + high >> 32
}

// An optional sign and one or more decimal digits, nothing else, within
// the int64 range. The value is accumulated negated, because -2^63 has no
// positive twin.
func parse_int(self: str) -> int64? {
    let n: int64 = len(self)
    mut i: int64 = 0
    mut negative: bool = false
    if n > 0 and (self[0] == 45 or self[0] == 43) {
        negative = self[0] == 45
        i = 1
    }
    if i == n {
        return none
    }
    mut acc: int64 = 0
    if n - i <= 18 {
        // Too few digits to overflow.
        for i + 8 <= n {
            let v = _eight_digits(kod_bytes_le64(self, i))
            if v < 0 {
                return none
            }
            acc = acc * 100000000 + v
            i += 8
        }
        for i < n {
            let d = self[i] - 48
            if d < 0 or d > 9 {
                return none
            }
            acc = acc * 10 + d
            i += 1
        }
        if negative {
            return -acc
        }
        return acc
    }
    let min: int64 = -9223372036854775807 - 1
    for i < n {
        let d: int64 = self[i] - 48
        if d < 0 or d > 9 {
            return none
        }
        if acc < -922337203685477580 {
            return none
        }
        acc = acc * 10
        if acc < min + d {
            return none
        }
        acc = acc - d
        i = i + 1
    }
    if negative {
        return acc
    }
    if acc == min {
        return none
    }
    return 0 - acc
}
