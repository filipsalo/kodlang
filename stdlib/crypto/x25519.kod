// X25519 (RFC 7748). See docs/crypto.md.
//
// A field element mod p = 2^255 - 19 is 10 limbs of 26 and 25 bits in turn,
// lowest first, as in ref10: a multiplication's sums of products stay below
// 2^62. Limbs may go negative between carries. The ladder swaps with masks,
// so nothing branches on, or indexes by, the private key.

// `x >> n` with the sign kept (Kod's `>>` shifts in zeros).
func asr(anon x: int64, anon n: int64) -> int64 {
    return (x >> n) | ((0 - (x >> 63)) << (64 - n))
}

// The width of limb i: 26 bits for an even one, 25 for an odd one, so that
// limb i starts at bit ceil(25.5 i).
func width(anon i: int64) -> int64 {
    return 26 - (i & 1)
}

// Each limb back to its width (rounding, so limbs may be negative), the
// carry out of the top one coming back in at the bottom times 19 (2^255 =
// 19 mod p), in ref10's order.
func carry(anon a: [int64]) -> [int64] {
    mut h = a
    for i in [0, 4, 1, 5, 2, 6, 3, 7, 4, 8, 9, 0] {
        let w = width(i)
        let c = asr(h[i] + (1 << (w - 1)), w)
        h[i] -= c << w
        if i == 9 {
            h[0] += 19 * c
        } else {
            h[i + 1] += c
        }
    }
    return h
}

func add(anon a: [int64], anon b: [int64]) -> [int64] {
    return [a[i] + b[i] for i in 0..10]
}

func sub(anon a: [int64], anon b: [int64]) -> [int64] {
    return [a[i] - b[i] for i in 0..10]
}

// a b mod p: limb i of a times limb j of b lands at limb i + j, times 2 when
// both are odd (their offsets add up to half a bit more), and above limb 9
// it comes back at i + j - 10 times 19. With limbs of 27 bits at most, each
// sum stays below 2^62.
func mul(anon a: [int64], anon b: [int64]) -> [int64] {
    mut b19 = [0] * 10
    for j in 0..10 {
        b19[j] = 19 * b[j]
    }
    mut h = [0] * 10
    for i in 0..10 {
        let ai = a[i]
        let ai2 = ai * (1 + (i & 1))
        for j in 0..10 - i {
            let x = if (i & j & 1) == 1 { ai2 } else { ai }
            h[i + j] += x * b[j]
        }
        for j in 10 - i..10 {
            let x = if (i & j & 1) == 1 { ai2 } else { ai }
            h[i + j - 10] += x * b19[j]
        }
    }
    return carry(h)
}

// a times a small number.
func mul_small(anon a: [int64], anon n: int64) -> [int64] {
    return carry([x * n for x in a])
}

func square(anon a: [int64]) -> [int64] {
    return mul(a, a)
}

// a^(p - 2), which is 1 / a; the exponent is public, so its bits may steer.
func invert(anon a: [int64]) -> [int64] {
    mut c = a
    for bit in 253..=0 step -1 {
        c = square(c)
        if bit != 2 and bit != 4 {
            c = mul(c, a)
        }
    }
    return c
}

// `p` and `q` swapped when `swap` is 1, as they were when it is 0.
func cswap(anon p: [int64], anon q: [int64], anon swap: int64) -> ([int64], [int64]) {
    let mask = 0 - swap
    mut x = p
    mut y = q
    for i in 0..10 {
        let t = mask & (x[i] ^ y[i])
        x[i] = x[i] ^ t
        y[i] = y[i] ^ t
    }
    return (x, y)
}

// The 255 low bits of the little-endian `b` as limbs.
func unpack(anon b: bytes) -> [int64] {
    mut out = [0] * 10
    mut start = 0
    for i in 0..10 {
        let w = width(i)
        mut v = 0
        for k in 0..w {
            let bit = start + k
            if bit < 255 {
                v = v | (((b[bit >> 3] >> (bit & 7)) & 1) << k)
            }
        }
        out[i] = v
        start += w
    }
    return out
}

// The 32 little-endian bytes of `n` reduced below p (ref10's fe_tobytes).
func pack(anon n: [int64]) -> bytes {
    mut h = carry(carry(n))
    // q is 1 when h is p or more, else 0.
    mut q = asr(19 * h[9] + (1 << 24), 25)
    for i in 0..10 {
        q = asr(h[i] + q, width(i))
    }
    h[0] += 19 * q
    for i in 0..9 {
        let c = asr(h[i], width(i))
        h[i + 1] += c
        h[i] -= c << width(i)
    }
    h[9] = h[9] & ((1 << 25) - 1)
    mut out = [0] * 32
    mut start = 0
    for i in 0..10 {
        let w = width(i)
        for k in 0..w {
            let bit = start + k
            out[bit >> 3] = out[bit >> 3] | (((h[i] >> k) & 1) << (bit & 7))
        }
        start += w
    }
    return kod_bytes_from_array(out)
}

func check_size(anon what: str, anon b: bytes) -> none {
    if len(b) != 32 {
        panic(f"x25519: the {what} is {len(b)} bytes, not 32")
    }
}

// The u coordinate of `scalar` times the point with u coordinate `point`.
func scalar_mult(anon scalar: bytes, anon point: bytes) -> bytes {
    check_size("scalar", scalar)
    check_size("point", point)
    mut z = [b for b in scalar]
    z[31] = (z[31] & 127) | 64
    z[0] = z[0] & 248
    let x = unpack(point)
    mut a = [0] * 10
    mut b = x
    mut c = [0] * 10
    mut d = [0] * 10
    a[0] = 1
    d[0] = 1
    for i in 254..=0 step -1 {
        let r = (z[i >> 3] >> (i & 7)) & 1
        (a, b) = cswap(a, b, r)
        (c, d) = cswap(c, d, r)
        mut e = add(a, c)
        a = sub(a, c)
        c = add(b, d)
        b = sub(b, d)
        d = square(e)
        let f = square(a)
        a = mul(c, a)
        c = mul(b, e)
        e = add(a, c)
        a = sub(a, c)
        b = square(a)
        c = sub(d, f)
        a = mul_small(c, 121665)
        a = add(a, d)
        c = mul(c, a)
        a = mul(d, f)
        d = mul(b, x)
        b = square(e)
        (a, b) = cswap(a, b, r)
        (c, d) = cswap(c, d, r)
    }
    return pack(mul(a, invert(c)))
}

func public_key(anon private: bytes) -> bytes {
    mut base = [0] * 32
    base[0] = 9
    return scalar_mult(private, kod_bytes_from_array(base))
}

// The shared secret of our `private` key and the `peer`'s public key, or none
// when it comes out all zeros: the peer sent a point of small order.
func shared(anon private: bytes, anon peer: bytes) -> bytes? {
    let s = scalar_mult(private, peer)
    mut any = 0
    for b in s {
        any = any | b
    }
    if any == 0 {
        return none
    }
    return s
}
