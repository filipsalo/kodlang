// The handshake of RFC 8448 section 3, byte for byte: the client's key and
// ClientHello as given there, the server's records fed in, and what the
// client derives and sends compared with the RFC's.
import "crypto/ecdsa" { PrivateKey }
import "crypto/ecdsa"
import "crypto/random"
import "crypto/x509"
import "encoding/hex"
import "io"
import "net/tls" { key_data, parse_pem }
import "net/tls13" { Client, Server }
import "net/tls13"

func h(anon s: str) -> bytes {
    return must hex.decode(s)
}

func feed(anon c: Client, anon record: str) -> none {
    let r = h(record)
    must c.receive(r[..5], r[5..])
}

test "RFC 8448: a simple 1-RTT handshake" {
    let c = Client(op: "rfc8448", host: "server", roots: [], now: 0, check_certificates: false, private_key: h("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005"), hello: h(""))
    assert hex.encode(c.start()) == ""
    feed(c, "160303005a020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")
    assert hex.encode(c.handshake_secret) == "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"
    assert hex.encode(c.client_hs) == "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"
    assert hex.encode(c.server_hs) == "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"
    feed(c, "")
    assert c.wait is .Done
    assert hex.encode(c.client_ap) == "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5"
    assert hex.encode(c.server_ap) == "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643"
    assert len(c.out) == 1 and hex.encode(c.out[0]) == "170303003575ec4dc238cce60b298044a71e219c56cc77b0517fe9b93c7a4bfc44d87f38f80338ac98fc46deb384bd1caeacab6867d726c40546"
    assert c.certificates[0].common_name() == "rsa"
    // A NewSessionTicket, then application data both ways.
    feed(c, "")
    feed(c, "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d")
    assert hex.encode(c.data) == "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"
    let sent = c.seal_data(h("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"))
    assert len(sent) == 1 and hex.encode(sent[0]) == "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4"
}

test "RFC 8448: a changed byte stops the handshake" {
    let c = Client(op: "rfc8448", host: "server", roots: [], now: 0, check_certificates: false, private_key: h("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005"), hello: h(""))
    let _hello = c.start()
    feed(c, "160303005a020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")
    let r = h("")
    mut changed = [b for b in r]
    changed[100] = changed[100] ^ 1
    let flipped = kod_bytes_from_array(changed)
    let got = c.receive(flipped[..5], flipped[5..])
    assert got is Err(_)
}

// ---- Kod's client against Kod's server, with no network ----

func testdata(anon name: str) -> str {
    return must io.read_file(f"stdlib/crypto/testdata/{name}")
}

func test_key(anon name: str) -> PrivateKey {
    let blocks = must parse_pem(testdata(name), op: "test")
    let Some(kd) = key_data(blocks[0]) else { panic("no key") }
    let size = (len(kd.data) - 1) / 3
    let curve = if size == 32 { ecdsa.Curve.P256 } else { ecdsa.Curve.P384 }
    return must PrivateKey(curve, scalar: kd.data[1 + 2 * size..])
}

func chain(anon names: [str]) -> [bytes] {
    mut out: [bytes] = []
    for n in names {
        out += must x509.pem_certificates(testdata(n))
    }
    return out
}

// Hands each side's records to the other until neither has more.
func pump(anon c: Client, anon s: Server) -> none or Error {
    for _round in 0..10 {
        let to_server = c.take_out()
        let to_client = s.take_out()
        if len(to_server) == 0 and len(to_client) == 0 {
            return
        }
        for r in to_server {
            try s.receive(r[..5], r[5..])
        }
        for r in to_client {
            try c.receive(r[..5], r[5..])
        }
    }
}

func pair(anon host: str, anon key: PrivateKey, anon certs: [bytes], anon suites: [int64]) -> (Client, Server) {
    let roots = [must x509.parse(d) for d in must x509.pem_certificates(testdata("root_rsa.pem") + testdata("root_ec.pem"))]
    let c = Client(op: "client", host: host, roots: roots, now: x509.days_from_civil(2026, 6, 1) * 86400, private_key: random.secure_bytes(32), suites: suites)
    let s = Server(op: "server", chain: certs, key: .Ec(key: key), private_key: random.secure_bytes(32))
    c.out += [c.start()]
    return (c, s)
}

test "every cipher suite, with a P-256 key and an intermediate" {
    for suite in [tls13.AES_128_GCM_SHA256, tls13.AES_256_GCM_SHA384, tls13.CHACHA20_POLY1305_SHA256] {
        let (c, s) = pair("www.example.test", test_key("leaf.key.pem"), chain(["leaf.pem", "inter.pem"]), [suite])
        must pump(c, s)
        assert c.done() and s.done() and c.suite == suite and s.suite == suite
        assert c.certificates[0].common_name() == "leaf" and s.server_name == "www.example.test"
        // Data both ways, a key update the client asks to be answered, and the close.
        for r in c.seal_data(b"ping") {
            must s.receive(r[..5], r[5..])
        }
        assert s.take_data() == b"ping"
        for r in s.seal_data(kod_bytes_from_array([7] * 40000)) {
            must c.receive(r[..5], r[5..])
        }
        assert len(c.take_data()) == 40000
        mut w = must c.write
        let update = w.seal(tls13.HANDSHAKE, b"\x18\x00\x00\x01\x01")
        c.write = w
        c.client_ap = tls13.expand_label(c.algo, secret: c.client_ap, label: "traffic upd", context: b"", length: c.algo.size())
        c.write = tls13.protection(c.suite, secret: c.client_ap)
        must s.receive(update[..5], update[5..])
        must pump(c, s)
        for r in c.seal_data(b"after") {
            must s.receive(r[..5], r[5..])
        }
        assert s.take_data() == b"after"
        for r in s.seal_data(b"back") {
            must c.receive(r[..5], r[5..])
        }
        assert c.take_data() == b"back"
        let bye = s.close_notify()
        must c.receive(bye[..5], bye[5..])
        assert c.peer_closed()
    }
}

test "a P-384 key, and a server certificate the client doesn't take" {
    let (c, s) = pair("big.example.test", test_key("leaf_sha512.key.pem"), chain(["leaf_sha512.pem"]), [tls13.AES_128_GCM_SHA256])
    must pump(c, s)
    assert c.done() and s.done()
    let (c2, s2) = pair("other.test", test_key("leaf_sha512.key.pem"), chain(["leaf_sha512.pem"]), [tls13.AES_128_GCM_SHA256])
    let r = pump(c2, s2)
    assert r is Err(_) and not c2.done()
}

test "a changed Finished from the client is refused" {
    let (c, s) = pair("example.test", test_key("leaf.key.pem"), chain(["leaf.pem", "inter.pem"]), [tls13.AES_128_GCM_SHA256])
    for r in c.take_out() {
        must s.receive(r[..5], r[5..])
    }
    for r in s.take_out() {
        must c.receive(r[..5], r[5..])
    }
    let fin = c.take_out()
    let last = fin[len(fin) - 1]
    mut changed = [b for b in last]
    changed[10] = changed[10] ^ 1
    let bad = kod_bytes_from_array(changed)
    assert s.receive(bad[..5], bad[5..]) is Err(_)
    assert not s.done()
}

test "a client without TLS 1.3 is told apart" {
    let s = Server(op: "server", chain: chain(["leaf.pem"]), key: .Ec(key: test_key("leaf.key.pem")), private_key: random.secure_bytes(32))
    // A TLS 1.2 ClientHello: no supported_versions.
    let body = b"\x03\x03" + kod_bytes_from_array([1] * 32) + b"\x00\x00\x02\xc0\x2b\x01\x00\x00\x00"
    let hello = b"\x01" + kod_bytes_from_array([0, 0, len(body)]) + body
    let record = b"\x16\x03\x01" + kod_bytes_from_array([0, len(hello)]) + hello
    let r = s.receive(record[..5], record[5..])
    assert r is Err(_) and s.seen == record
}
