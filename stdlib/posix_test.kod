import "io" { FileInfo, file_info, is_file, read_file, write_file }
import "posix"
import "posix" { Fd, open_read, create, append, stdin, stdout, stderr }
import "stream" { IoError, IoKind, BufReader }

func b(anon s: str) -> bytes {
    return kod_str_to_bytes(s)
}

func path(anon name: str) -> str {
    return f"build/posix_test_{name}.tmp"
}

func kind_of_open(anon p: str) -> IoKind {
    let r = open_read(p)
    if r is Err(e) {
        if e is IoError(io) {
            return io.kind
        }
    }
    return .Other
}

test "create, write, close, then read the file back" {
    let p = path("roundtrip")
    let w = must create(p)
    must w.write_str("hello\nworld\n")
    must w.close()
    let r = must open_read(p)
    assert kod_bytes_to_str(must r.read_all()) == "hello\nworld\n"
    must r.close()
}

test "create truncates and append extends" {
    let p = path("trunc")
    let w = must create(p)
    must w.write_str("long old content")
    must w.close()
    let w2 = must create(p)
    must w2.write_str("new")
    must w2.close()
    let a = must append(p)
    must a.write_str("+more")
    must a.close()
    let r = must open_read(p)
    assert kod_bytes_to_str(must r.read_all()) == "new+more"
    must r.close()
}

test "append creates a missing file" {
    let p = path("appendnew")
    let w = must create(p)
    must w.close()
    let a = must append(p)
    must a.write_str("x")
    must a.close()
    assert ((must open_read(p)).read(10)) is Ok(_)
}

test "a file larger than any single read" {
    let p = path("big")
    let w = must create(p)
    must w.write_all(kod_str_to_bytes("0123456789".repeat(30000)))
    must w.close()
    let r = must open_read(p)
    let data = must r.read_all()
    assert len(data) == 300000
    assert kod_bytes_to_str(data[299990..300000]) == "0123456789"
    must r.close()
}

test "bytes with NULs and high bits survive a round trip" {
    let p = path("binary")
    let raw = kod_bytes_from_array([0, 255, 10, 13, 0, 128])
    let w = must create(p)
    must w.write_all(raw)
    must w.close()
    let r = must open_read(p)
    assert (must r.read_all()) == raw
    must r.close()
}

test "an empty file reads as the end of the stream" {
    let p = path("empty")
    must (must create(p)).close()
    let r = must open_read(p)
    assert len(must r.read(10)) == 0
    must r.close()
}

test "opening a missing file is NotFound and names the path" {
    let p = path("does_not_exist")
    assert kind_of_open(p) == .NotFound
    let r = open_read(p)
    assert r is Err(_)
    if r is Err(e) {
        assert e.to_str().starts_with(f"open {p}: ")
    }
}

test "opening a directory for reading succeeds but reading it fails" {
    let d = open_read("build")
    if d is Ok(dir) {
        assert dir.read(10) is Err(_)
    }
}

test "creating in a missing directory is NotFound" {
    let r = create("build/no_such_dir_here/x.tmp")
    assert r is Err(_)
    if r is Err(e) {
        assert e is IoError
        if e is IoError(io) {
            assert io.kind == .NotFound
            assert io.errno == 2
        }
    }
}

test "creating where there is a directory fails" {
    assert create("build") is Err(_)
}

test "reading from a write-only descriptor and closing twice are errors" {
    let p = path("modes")
    let w = must create(p)
    assert w.read(4) is Err(_)
    must w.close()
    assert w.close() is Err(_)
    assert w.write(b("x")) is Err(_)
}

test "stdin, stdout and stderr wrap descriptors 0, 1 and 2" {
    assert stdin().fd == 0
    assert stdout().fd == 1
    assert stderr().fd == 2
}

test "a BufReader reads lines from a file" {
    let p = path("lines")
    let w = must create(p)
    must w.write_str("a\r\nb\nc")
    must w.close()
    let br = BufReader(inner: must open_read(p))
    assert ((must br.read_line())? or "!") == "a"
    assert ((must br.read_line())? or "!") == "b"
    assert ((must br.read_line())? or "!") == "c"
    assert (must br.read_line()) is none
}

test "seek" {
    let path = f"build/posix_test_seek.tmp"
    let out = must create(path)
    must out.write_str("0123456789")
    must out.seek(4)
    must out.write_str("xy")
    must out.close()
    let f = must open_read(path)
    must f.seek(3)
    assert kod_bytes_to_str(must f.read(4)) == "3xy6"
    must f.seek(0)
    assert kod_bytes_to_str(must f.read(2)) == "01"
    assert f.seek(-1) is Err(_)
    must f.close()
    assert f.seek(0) is Err(_)
}

func kind_of(anon r: none or Error) -> IoKind {
    if r is Err(e) and e is IoError(err) {
        return err.kind
    }
    return .Other
}

test "open_rw reads and writes one file, creating it but not truncating it" {
    let p = path("rw")
    let _ = posix.remove(p)
    let f = must posix.open_rw(p)
    must f.write_str("hello world")
    must f.seek(6)
    assert kod_bytes_to_str(must f.read(100)) == "world"
    must f.close()
    let g = must posix.open_rw(p)
    assert kod_bytes_to_str(must g.read(5)) == "hello"
    must g.write_str("!")
    must g.sync()
    assert (must g.size()) == 11
    must g.close()
    assert (must read_file(p)) == "hello!world"
}

test "truncate cuts a file short or lengthens it with zeros" {
    let p = path("truncate")
    let f = must create(p)
    must f.write_str("0123456789")
    must f.truncate(4)
    assert (must f.size()) == 4
    must f.truncate(6)
    must f.close()
    assert (must read_file(p)) == "0123\0\0"
    assert f.sync() is Err(_)
}

test "rename replaces, remove removes" {
    let a = path("rename_a")
    let b = path("rename_b")
    assert write_file(a, "new") == 0
    assert write_file(b, "old") == 0
    must posix.rename(a, b)
    assert not is_file(a)
    assert (must read_file(b)) == "new"
    must posix.remove(b)
    assert not is_file(b)
    assert kind_of(posix.remove(b)) == .NotFound
    assert kind_of(posix.rename(a, b)) == .NotFound
}

test "directories: made, listed sorted, synced and removed when empty" {
    let d = path("dir")
    for name in posix.list_dir(d)? or [] {
        let _ = posix.remove(f"{d}/{name}")
    }
    let _ = posix.remove_dir(d)
    must posix.make_dir(d)
    assert kind_of(posix.make_dir(d)) == .AlreadyExists
    assert (must posix.list_dir(d)) == []
    for name in ["b", "c", "a"] {
        assert write_file(f"{d}/{name}", name) == 0
    }
    must posix.sync_dir(d)
    assert (must posix.list_dir(d)) == ["a", "b", "c"]
    assert (file_info(d)? or FileInfo(is_file: false, is_dir: false, size: 0, modified_ns: 0)).is_dir
    assert posix.remove_dir(d) is Err(_)
    for name in ["a", "b", "c"] {
        must posix.remove(f"{d}/{name}")
    }
    must posix.remove_dir(d)
    assert kind_of(posix.remove_dir(d)) == .NotFound
    assert posix.list_dir(d) is Err(_)
    assert kind_of(posix.make_dir(path("no/such/dir"))) == .NotFound
}
