    aead("6e9f43166c56b8efa9efc6b5a003abf7aa740a7feb174a498bc48b2086b64711", "3066da32b9907948249baeb9", "", "7db3cfab1e", "40599c00e4299038f31eed7703b930c6")
    aead("aca5f6bc7c78b24d456903e8cfe4ca9a5621499a9d81ae2561285b9bb4efb6db", "22f8a3598d830b5489790a6f", "18cce5669032647b1d42182825ae4502", "608a07a50e6ca4a70df8cfac591dd417", "e1d2b71e563b3174dba7137df14bd351544891e6e2449d7642d2403b8e3309bc")
    aead("2cabfdcc83ed060da2a01cd4a8502f094f6b492eb7b9d8b04ea97584f4109ee8", "8eb98c438104f333b94d74cd", "2e0e443e1e685d84bb4c5a520eb37ce2ff6db0c7eb6ca50d370721cdb31e74c0d1c0720f800a86de7b76b568a6d98e98ff6e50f4884599902da902f87f52a3e7", "6c1a6bb817e05dde47980c394d", "e7387ba28e82658e24fd5335a0bced722875236800722400df815f9a4091c1ffd819af81385e4b6b3bb82bcbae01aaccd2b41af1630eff6371a0d7be3a29e035576884d6b93dcb92e17b6aec65fc3f86")
    aead("04449a4db43156edcb2ed4adcbab10786707134576dc350a18a221383df945db", "015b724b39b5fe27b26e7225", "8b5a07878923166418d0b98805a615e890a9d289ccd8a2d6c44dc6c5d149027a82c17b653b2c1119cfa6e2a1e900f2f0afc278c1b520c988a424728786f2b2f471", "", "46d2a1ecc1a446a0a6e3011e455a4552984a5c10d911a88f81cc85e1f78f83bf3c54b93db85d3c79e2cfaef9c2886098e5213fd9d3481b34e3aec31f30e114cef484b347223c0c7f0aed24b548f7f9f1d5")
    aead("4821ba6856bb7a584eeb5a16a4c3b9db3ed14e80c034bab69ae72d8cca94e439", "e6f4594c0342bbfa79bdaec3", "", "cd3a13b43e6b2594fab209fe2f66f88f9b2d6747f08a7499103300b0634d9919", "")
}

test "open refuses anything changed" {
    let key = h("58aab3e6f67ea8ba5b389823e8303952c9ec12111431d343d4b427bf53b8562e")
    let nonce = h("a902f59b4c8530367a3b4efe")
    let sealed = chacha20poly1305.seal(b"attack at dawn", key: key, nonce: nonce, aad: b"header")
    assert chacha20poly1305.open(sealed, key: key, nonce: nonce, aad: b"header") == b"attack at dawn"
    for i in 0..len(sealed) {
        mut changed = [b for b in sealed]
        changed[i] = changed[i] ^ 1
        assert chacha20poly1305.open(kod_bytes_from_array(changed), key: key, nonce: nonce, aad: b"header") is none
    }
    assert chacha20poly1305.open(sealed, key: key, nonce: nonce, aad: b"headers") is none
    assert chacha20poly1305.open(sealed[..15], key: key, nonce: nonce, aad: b"header") is none
    let other = h("8a3ca6ef7d531583bb6591ce")
    assert chacha20poly1305.open(sealed, key: key, nonce: other, aad: b"header") is none
}
