// The C library functions the standard library calls, declared once, so a
// module can have a function of the same name as one of them (posix.poll,
// process.kill). Pointers are int64 addresses from `unsafe`; a C `int`
// result needs `unsafe.c_int`. See docs/unsafe.md.

// Files and descriptors.
extern func read(anon fd: int64, anon buf: int64, anon n: int64) -> int64
extern func write(anon fd: int64, anon buf: int64, anon n: int64) -> int64
extern func close(anon fd: int64) -> int64
extern func isatty(anon fd: int64) -> int64
extern func pipe(anon fds: int64) -> int64
extern func open(anon path: int64, anon flags: int64,...) -> int64
extern func lseek(anon fd: int64, anon pos: int64, anon whence: int64) -> int64
extern func fcntl(anon fd: int64, anon cmd: int64,...) -> int64
extern func fflush(anon stream: int64) -> int64
extern func poll(anon fds: int64, anon count: int64, anon timeout_ms: int64) -> int64
extern func unlink(anon path: int64) -> int64
extern func fsync(anon fd: int64) -> int64
extern func ftruncate(anon fd: int64, anon size: int64) -> int64
extern func fstat(anon fd: int64, anon buf: int64) -> int64
extern func rename(anon from: int64, anon to: int64) -> int64
extern func mkdir(anon path: int64, anon mode: int64) -> int64
extern func rmdir(anon path: int64) -> int64
extern func opendir(anon path: int64) -> int64
extern func readdir(anon dir: int64) -> int64
extern func closedir(anon dir: int64) -> int64

// Memory mappings, and waiting for events (kqueue).
extern func mmap(anon addr: int64, anon len: int64, anon prot: int64, anon flags: int64, anon fd: int64, anon offset: int64) -> int64
extern func munmap(anon addr: int64, anon len: int64) -> int64
extern func mprotect(anon addr: int64, anon len: int64, anon prot: int64) -> int64
extern func mincore(anon addr: int64, anon len: int64, anon vec: int64) -> int64
extern func madvise(anon addr: int64, anon len: int64, anon advice: int64) -> int64
extern func getpagesize() -> int64
extern func memmove(anon dst: int64, anon src: int64, anon n: int64) -> int64
extern func kqueue() -> int64
extern func kevent(anon kq: int64, anon changes: int64, anon n_changes: int64, anon events: int64, anon n_events: int64, anon timeout: int64) -> int64

// Processes and signals.
extern func kill(anon pid: int64, anon sig: int64) -> int64
extern func sigaction(anon sig: int64, anon action: int64, anon old: int64) -> int64
extern func setitimer(anon which: int64, anon value: int64, anon old: int64) -> int64
extern func waitpid(anon pid: int64, anon status: int64, anon options: int64) -> int64
extern func fork() -> int64
extern func getpid() -> int64
extern func dup2(anon fd: int64, anon to: int64) -> int64
extern func exit(anon status: int64) -> none
extern func execvp(anon file: int64, anon argv: int64) -> int64
extern func posix_spawnp(anon pid: int64, anon file: int64, anon actions: int64, anon attr: int64, anon argv: int64, anon envp: int64) -> int64
extern func posix_spawn_file_actions_init(anon actions: int64) -> int64
extern func posix_spawn_file_actions_destroy(anon actions: int64) -> int64
extern func posix_spawn_file_actions_adddup2(anon actions: int64, anon fd: int64, anon to: int64) -> int64
extern func posix_spawn_file_actions_addopen(anon actions: int64, anon fd: int64, anon path: int64, anon flags: int64, anon mode: int64) -> int64
extern func posix_spawn_file_actions_addchdir(anon actions: int64, anon path: int64) -> int64

// The environment.
extern func getenv(anon name: int64) -> int64
// The working directory into `buf` of `size` bytes; 0 when it doesn't fit.
extern func getcwd(anon buf: int64, anon size: int64) -> int64
extern func setenv(anon name: int64, anon value: int64, anon overwrite: int64) -> int64
extern func unsetenv(anon name: int64) -> int64

// Clocks.
extern func clock_gettime(anon clock: int64, anon ts: int64) -> int64
extern func clock_getres(anon clock: int64, anon ts: int64) -> int64
extern func nanosleep(anon request: int64, anon remaining: int64) -> int64

// Sockets. A struct addrinfo and a struct sockaddr are read with unsafe at
// their macOS offsets.
extern func socket(anon domain: int64, anon kind: int64, anon protocol: int64) -> int64
extern func connect(anon fd: int64, anon addr: int64, anon addr_len: int64) -> int64
extern func bind(anon fd: int64, anon addr: int64, anon addr_len: int64) -> int64
extern func listen(anon fd: int64, anon backlog: int64) -> int64
extern func accept(anon fd: int64, anon addr: int64, anon addr_len: int64) -> int64
extern func shutdown(anon fd: int64, anon how: int64) -> int64
extern func setsockopt(anon fd: int64, anon level: int64, anon option: int64, anon value: int64, anon value_len: int64) -> int64
extern func getsockopt(anon fd: int64, anon level: int64, anon option: int64, anon value: int64, anon value_len: int64) -> int64
extern func getsockname(anon fd: int64, anon addr: int64, anon addr_len: int64) -> int64
extern func getpeername(anon fd: int64, anon addr: int64, anon addr_len: int64) -> int64
extern func inet_ntop(anon family: int64, anon addr: int64, anon buf: int64, anon size: int64) -> int64
extern func getaddrinfo(anon host: int64, anon service: int64, anon hints: int64, anon list: int64) -> int64
extern func freeaddrinfo(anon list: int64) -> none
extern func gai_strerror(anon code: int64) -> int64

// Files through stdio, and their status.
extern func fopen(anon path: int64, anon mode: int64) -> int64
extern func fclose(anon file: int64) -> int64
extern func fread(anon buf: int64, anon size: int64, anon count: int64, anon file: int64) -> int64
extern func fwrite(anon buf: int64, anon size: int64, anon count: int64, anon file: int64) -> int64
extern func ferror(anon file: int64) -> int64
extern func freopen(anon path: int64, anon mode: int64, anon file: int64) -> int64
extern func getline(anon line: int64, anon cap: int64, anon file: int64) -> int64
extern func stat(anon path: int64, anon buf: int64) -> int64

// Memory and errors.
extern func realloc(anon addr: int64, anon size: int64) -> int64
extern func strerror(anon err: int64) -> int64

// SHA-256 from CommonCrypto, part of the system library. A CC_SHA256_CTX is
// 104 bytes; a digest 32.
extern func CC_SHA256_Init(anon ctx: int64) -> int64
extern func CC_SHA256_Update(anon ctx: int64, anon data: int64, anon len: int64) -> int64
extern func CC_SHA256_Final(anon digest: int64, anon ctx: int64) -> int64
