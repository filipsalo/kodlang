// HMAC (RFC 2104) over SHA-2, and comparing MACs in constant time. See
// docs/crypto.md.
import "crypto/sha2" { Algo, Hasher }
import "crypto/sha2"

func mac(anon algo: Algo, key: bytes, data: bytes) -> bytes {
    let block = algo.block_size()
    mut k = key
    if len(k) > block {
        k = sha2.digest(algo, k)
    }
    mut inner: [int64] = []
    mut outer: [int64] = []
    for i in 0..block {
        let b = if i < len(k) { k[i] } else { 0 }
        inner += [b ^ 0x36]
        outer += [b ^ 0x5c]
    }
    mut h = Hasher(algo)
    h.update(kod_bytes_from_array(inner))
    h.update(data)
    let first = h.finish()
    mut o = Hasher(algo)
    o.update(kod_bytes_from_array(outer))
    o.update(first)
    return o.finish()
}

// Whether `a` and `b` hold the same bytes, looking at every byte of two values
// of one length whatever they hold.
func equal(anon a: bytes, anon b: bytes) -> bool {
    if len(a) != len(b) {
        return false
    }
    mut diff = 0
    for i in 0..len(a) {
        diff = diff | (a[i] ^ b[i])
    }
    return diff == 0
}
