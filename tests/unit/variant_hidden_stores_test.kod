// A `.Variant` stored into an array or a field takes its enum from there.
import "./../variant_hidden_mid"

test "variants stored into arrays and fields" {
    mut fs = variant_hidden_mid.list()
    fs += [.Circle(r: 2)]
    fs = fs + [.Square(side: 3)]
    fs[0] = .Circle(r: 6)
    fs = [.Circle(r: 10)] + fs
    mut h = variant_hidden_mid.Holder()
    h.fs += [.Circle(r: 4)]
    h.fs = h.fs + [.Square(side: 5)]
    h.fs[1] = .Circle(r: 8)
    assert variant_hidden_mid.total(fs) == 21
    assert variant_hidden_mid.total(h.fs) == 12
}
