type Pt = struct {
    x: int64 = 0
    ys: [int64] = []
}

type Holder = shared struct {
    m: Map[str, [str]] = Map[str, [str]]()
}

type Log = shared struct {
    text: str = ""

    func at(self, anon tag: str, anon v: str) -> str {
        self.text = self.text + tag
        return v
    }
}

func main() -> int64 {
    // Counting and grouping with a default.
    let words = ["a", "bb", "a", "cc", "a"]
    mut counts = Map[str, int64]()
    mut groups = Map[int64, [str]]()
    for w in words {
        counts[w, default: 0] += 1
        groups[len(w), default: []] += [w]
    }
    print(f"{counts} {groups}")

    // Reading with a default doesn't add the key.
    print(f"{counts["z", default: 7]} {len(counts)}")

    // Without a default the key is there; elements and fields of entries.
    mut pts = Map[str, Pt]()
    pts["p"] = Pt()
    pts["p"].x = 5
    pts["p"].ys += [1, 2]
    pts["p"].ys[0] = 9
    mut grid = Map[int64, [int64]]()
    grid[0] = [0, 0]
    grid[0][1] += 4
    let p = pts["p", default: Pt()]
    print(f"{p.x} {p.ys} {grid}")

    // A map in a field of a shared struct, and maps of maps.
    let h = Holder()
    h.m["k", default: []] += ["v"]
    h.m["k"] += ["w"]
    mut nested = Map[str, Map[str, int64]]()
    nested["a", default: Map[str, int64]()]["b", default: 0] += 3
    nested["a"]["b"] += 1
    print(f"{h.m} {nested}")

    // The value another holder has is left alone.
    let before = groups
    groups[1, default: []] += ["d"]
    print(f"{before[1]? or []} {groups[1]? or []}")

    // The map, the key, then the value.
    let log = Log()
    mut m = Map[str, str]()
    m[log.at("k", "x"), default: ""] += log.at("v", "y")
    print(f"{log.text} {m}")
    return 0
}

// expected output:
// {a: 3, bb: 1, cc: 1} {1: [a, a, a], 2: [bb, cc]}
// 7 3
// 5 [9, 2] {0: [0, 4]}
// {k: [v, w]} {a: {b: 4}}
// [a, a, a] [a, a, a, d]
// kv {x: y}
