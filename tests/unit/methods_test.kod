// Methods on a struct, with and without arguments.
type Point = shared struct {
    x: int64
    y: int64
    func sum(self) -> int64 {
        return self.x + self.y
    }
    func scale(self, factor: int64) -> int64 {
        return (self.x + self.y) * factor
    }
}

test "methods with and without arguments" {
    let p: Point = Point(x: 3, y: 4)
    let s: int64 = p.sum()
    assert s.to_str() == "7"
    let t: int64 = p.scale(factor: 2)
    assert t.to_str() == "14"
}
