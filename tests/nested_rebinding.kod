// A block can bind a name that an enclosing block or a parameter still has
// bound. The outer binding keeps its own value and type, also on the paths
// where the block doesn't run.
type A = struct {
    x: int64

    func show(self) -> str {
        return f"A{self.x}"
    }
}

type B = struct {
    x: int64

    func show(self) -> str {
        return f"B{self.x}"
    }
}

func param_in_if(anon item: A, anon flag: bool) -> str {
    if flag {
        let item = B(x: 9)
        return item.show()
    }
    return item.show()
}

func let_in_if(anon n: int64) -> str {
    let r = A(x: 1)
    if n > 5 {
        let r = B(x: 2)
        print(r.show())
    }
    return r.show()
}

func arm_binding(anon o: str?) -> int64 {
    let x = 5
    match o {
        Some(x) -> print(x)
        none -> print("none")
    }
    return x + 1
}

func loop_var(anon xs: [str]) -> int64 {
    let x = 5
    for x in xs {
        print(x)
    }
    return x + 1
}

func if_is_param(anon b: A, o: str?) -> int64 {
    if o is Some(b) {
        print(b)
    }
    return b.x
}

func value_arm(anon n: int64?, m: int64?) -> int64 {
    return match n {
        Some(v) -> match m {
            Some(v) -> v
            none -> 0
        }
        none -> 1
    }
}

func main() -> int64 {
    print(param_in_if(A(x: 1), false))
    print(param_in_if(A(x: 1), true))
    print(let_in_if(1))
    print_int(arm_binding("hi"))
    print_int(loop_var(["a"]))
    print_int(if_is_param(A(x: 3), o: "hi"))
    print_int(value_arm(1, m: 2))
    return 0
}

// expected output:
// A1
// B9
// A1
// hi
// 6
// a
// 6
// hi
// 3
// 2
