    ]
    for row in rows {
        let x = kod_f64_from_bits(row[0].parse_int()? or 0)
        assert [f"{x:.0f}", f"{x:.2f}", f"{x:.3f}", f"{x:.17f}", f"{x:.0e}", f"{x:.5e}", f"{x:.16e}"] == row[1..8]
        assert f"{0.0 - x:.2f}" == "-" + row[2]
    }
}

