import "arrays"

type Color = enum {
    Red
    Green
}

test "contains: compares by ==, with strs by content" {
    assert arrays.contains([1, 2], 2)
    assert not arrays.contains([1, 2], 3)
    let joined = "a" + "b"
    assert arrays.contains(["ab"], joined)
    assert not arrays.contains(["ab"], "a")
    assert arrays.contains([Color.Red, Color.Green], .Green)
}

test "contains: empty" {
    assert not arrays.contains([], 1)
    let none_here: [str] = []
    assert not arrays.contains(none_here, "a")
}

test "equal: length and elements in order" {
    assert arrays.equal([1, 2], [1, 2])
    assert not arrays.equal([1, 2], [2, 1])
    assert not arrays.equal([1], [1, 2])
    assert arrays.equal(["a"], ["a"])
    let no_strs: [str] = []
    assert arrays.equal(no_strs, [])
}

test "* repeats an array into a new one" {
    let flags = [false] * 4
    assert len(flags) == 4
    for f in flags {
        assert not f
    }
    assert arrays.equal([1, 2] * 3, [1, 2, 1, 2, 1, 2])
    assert len([7] * 0) == 0
    assert len([7] * -2) == 0
    let xs = [3, 4]
    let twice = xs * 2
    assert arrays.equal(twice, [3, 4, 3, 4])
    assert arrays.equal(xs, [3, 4])
    mut grown = [0] * 2
    grown += [1]
    assert arrays.equal(grown, [0, 0, 1])
}

test "* repeats counted elements, each a value of its own" {
    let words = ["a", "b"] * 3
    assert "".join(words) == "ababab"
    mut rows = [[0]] * 2
    rows[0] += [1]
    assert len(rows[0]) == 2
    assert len(rows[1]) == 1
}

test "pop takes the last element off" {
    mut xs = [1, 2, 3]
    assert must arrays.pop(mut xs) == 3
    assert xs == [1, 2]
    mut empty: [int64] = []
    assert arrays.pop(mut empty) is none
    // Another holder keeps what it had.
    mut words = ["a", "b"]
    let kept = words
    assert must arrays.pop(mut words) == "b"
    assert words == ["a"]
    assert kept == ["a", "b"]
    mut stack: [str] = []
    for i in 0..100 {
        stack += [i.to_str()]
    }
    mut total = 0
    for arrays.pop(mut stack) is str(s) {
        total += s.parse_int()? or 0
    }
    assert total == 4950
    assert len(stack) == 0
}

test "xs = xs[..n] keeps the first elements" {
    mut xs = [5, 6, 7, 8]
    xs = xs[..2]
    assert xs == [5, 6]
    xs = xs[0..-1]
    assert xs == [5]
    xs = xs[..10]
    assert xs == [5]
    let other = xs
    xs = xs[..0]
    assert xs == []
    assert other == [5]
}

test "reversed gives the elements last first" {
    assert arrays.reversed([1, 2, 3]) == [3, 2, 1]
    assert arrays.reversed(["a"]) == ["a"]
    let none_given: [int64] = []
    assert arrays.reversed(none_given) == []
}

type Stack = struct {
    items: [str] = []
}

test "s.xs = s.xs[..n] keeps the first elements of a field" {
    mut s = Stack(items: ["a", "b", "c"])
    let saved = s
    s.items = s.items[..-1]
    assert s.items == ["a", "b"]
    assert saved.items == ["a", "b", "c"]
    s.items = s.items[0..1]
    assert s.items == ["a"]
}
