// CRC-32 against known reference values (matches Python's
// `zlib.crc32` / the gzip polynomial).

import "hash/crc32"

test "one-shot reference values" {
    assert crc32.compute(b"") == 0
    assert crc32.compute(b"a") == 3904355907
    assert crc32.compute(b"hello") == 907060870
    assert crc32.compute(b"The quick brown fox jumps over the lazy dog") == 1095738169
}

test "streaming matches one-shot" {
    // Feeding the same bytes split arbitrarily yields the same CRC as one-shot.
    mut c: crc32.Crc32 = crc32.make_crc32()
    c.update_bytes(b"The quick brown fox")
    c.update_bytes(b" jumps over the lazy dog")
    assert c.final() == 1095738169
}

test "lengths either side of 8 bytes, and bytes mixed with buffers" {
    // Lengths either side of the 8 bytes the hardware path takes at once.
    let digits = b"0123456789abcdef0123"
    mut got: [int64] = []
    for n in [7, 8, 9, 15, 16, 17, 20] {
        got += [crc32.compute(digits[0..n])]
    }
    assert got == [2378107118, 763378421, 939184570, 371833746, 1757737011, 1264810695, 499335874]

    // Single bytes and buffers mixed.
    mut m: crc32.Crc32 = crc32.make_crc32()
    m.update('x')
    m.update_bytes(digits)
    m.update('y')
    assert m.final() == 904196069
}
