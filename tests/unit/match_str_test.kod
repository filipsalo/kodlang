// A match expression on str subjects.
func classify(anon s: str) -> str {
	return match s {
		"hello" -> "greeting"
		"bye" -> "farewell"
		else "unknown"
	}
}

test "match on strings" {
	assert classify("hello") == "greeting"
	assert classify("bye") == "farewell"
	assert classify("what") == "unknown"
}
