// Match expressions bind payload fields the same way match statements do:
// qualified and implicit patterns, multi-field, str and struct payloads,
// plus T? and Result subjects. Runs under both frontends.

type Point = struct {
	x: int64
	y: int64
}

type Shape = enum {
	Circle(r: int64)
	Rect(w: int64, h: int64)
	Label(text: str)
	At(p: Point)
	Empty
}

type IoError = struct {
	message: str
	func to_str(self) -> str { return self.message }
}

func plain(anon s: Shape) -> int64 {
	return match s {
		Shape.Circle(r) -> r
		else 0
	}
}

func tripled(anon s: Shape) -> int64 {
	let v: int64 = match s {
		.Circle(r) -> r * 3
		else 0
	}
	return v
}

func area(anon s: Shape) -> int64 {
	return match s {
		Shape.Circle(r) -> 3 * r * r
		Shape.Rect(w, h) -> w * h
		.At(p) -> p.x * p.y
		else -1
	}
}

func describe(anon s: Shape) -> str {
	return match s {
		.Circle(r) -> f"circle {r}"
		.Rect(w, h) -> f"rect {w}x{h}"
		.Label(text) -> "label " + text
		.At(p) -> f"at ({p.x}, {p.y})"
		.Empty -> "empty"
	}
}

func double(anon n: int64) -> int64 {
	return n * 2
}

func find(anon n: int64) -> int64? {
	if n > 0 {
		return n
	}
	return none
}

func parse(anon n: int64) -> int64 or Error {
	if n < 0 {
		throw IoError(message: "negative")
	}
	return n + 100
}

func main() -> int64 {
	print_int(plain(Shape.Circle(r: 2)))
	print_int(plain(Shape.Empty))
	print_int(tripled(.Circle(r: 5)))
	print_int(area(Shape.Circle(r: 2)))
	print_int(area(Shape.Rect(w: 4, h: 6)))
	print_int(area(Shape.At(p: Point(x: 3, y: 7))))
	print_int(area(Shape.Empty))
	print(describe(Shape.Circle(r: 1)))
	print(describe(Shape.Rect(w: 2, h: 3)))
	print(describe(Shape.Label(text: "hi")))
	print(describe(Shape.At(p: Point(x: -1, y: 9))))
	print(describe(Shape.Empty))

	let s: Shape = Shape.Rect(w: 10, h: 20)
	// `f"{e}"` lowers to `"" + str(e)`; f-string interpolations can't
	// hold a `{`, so spell out the lowered form.
	print("sum=" + str(match s { .Rect(w, h) -> w + h  else 0 }))
	print_int(double(match s { Shape.Rect(w, h) -> h - w  else 0 }))

	let label: Shape = Shape.Label(text: "kod")
	let name: str = match label {
		.Label(text) -> text + "!"
		else ""
	}
	print(name)

	print_int(match find(7) { Some(n) -> n + 1  none -> 0 })
	print_int(match find(-7) { Some(n) -> n + 1  none -> 0 })
	print_int(match parse(5) { Ok(v) -> v  Err(e) -> -1 })
	print(match parse(-5) { Ok(v) -> v.to_str()  Err(e) -> e.to_str() })
	return 0
}

// expected output:
// 2
// 0
// 15
// 12
// 24
// 21
// -1
// circle 1
// rect 2x3
// label hi
// at (-1, 9)
// empty
// sum=30
// 20
// kod!
// 8
// 0
// 105
// negative

// expected status:
// 0
