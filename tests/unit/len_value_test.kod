// As a value, `len` is its `str` form, wherever the name falls back to it.
test "len as a value" {
    let lv = len
    assert lv("xy") == 2
    let f: func(str) -> int64 = len
    assert f("abcd") == 4
    if true {
        let len = 4
        assert len == 4
    }
    let after = len
    assert after("abc") == 3
}
