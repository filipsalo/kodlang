// A generic type's method is compiled for an instance only when something uses it.

type Pt = shared struct {
    x: int64
    y: int64
}

type Box[T] = shared struct {
    items: [T]

    // Pt has no `==`, so this can't compile for Box[Pt].
    func has(self, anon v: T) -> bool {
        for item in self.items {
            if item == v {
                return true
            }
        }
        return false
    }

    func count(self) -> int64 {
        return len(self.items)
    }

    // Only a chain of calls reaches this one.
    func first_label(self) -> str {
        return self.label_of(self.items[0])
    }

    func label_of(self, anon v: T) -> str {
        return f"<{v}>"
    }

    // Grows without end if it is ever compiled.
    func wrapped(self) -> int64 {
        return Box[[T]](items: [self.items]).wrapped()
    }
}

// What `Ops.op_index_set` was called with, in order.
mut index_sets: [str] = []

// Every way a method gets used without a plain call on a struct value.
type Ops[T] = shared struct {
    v: T

    func op_add(self, other: Ops[T]) -> Ops[T] {
        return Ops[T](v: other.v)
    }

    func op_eq(self, other: Ops[T]) -> bool {
        return true
    }

    func op_lt(self, other: Ops[T]) -> bool {
        return false
    }

    func op_index(self, anon i: int64) -> int64 {
        return i + 1
    }

    func op_index_set(self, anon i: int64, anon v: int64) -> none {
        index_sets += [f"set {i} {v}"]
    }

    func to_str(self) -> str {
        return "ops"
    }

    func len(self) -> int64 {
        return 7
    }

    func broken(self) -> T {
        return self.v.no_such_method()
    }
}

interface Counted {
    func count(self) -> int64
}

interface Named {
    func name(self) -> str
    func size(self) -> int64
}

// Boxed to an interface, so its methods are called through a vtable alone.
type Tag[T] = shared struct {
    v: T

    func name(self) -> str {
        return f"tag {self.v}"
    }

    func size(self) -> int64 {
        return self.helper()
    }

    func helper(self) -> int64 {
        return 3
    }

    func broken(self) -> int64 {
        return self.v.no_such_method()
    }
}

func show(anon n: Named) -> str {
    return f"{n.name()} {n.size()}"
}

func maybe_count(anon b: Box[Pt]?) -> int64? {
    return b?.count()
}

test "a method that can't compile for an instance isn't compiled for it" {
    let points = Box[Pt](items: [Pt(x: 1, y: 2), Pt(x: 3, y: 4)])
    assert points.count() == 2
    let counted: Counted = points
    assert counted.count() == 2
    assert (maybe_count(points)? or 0) == 2
}

test "the same method compiles for an instance that can take it" {
    let ints = Box[int64](items: [1, 2])
    assert ints.has(2) == true
    assert ints.has(3) == false
    assert ints.first_label() == "<1>"
}

test "operators, to_str and len use methods" {
    let a = Ops[int64](v: 1)
    let b = Ops[int64](v: 2)
    assert (a + b).v == 2
    assert (a == b) == true
    assert (a != b) == false
    assert (a < b) == false
    assert a[4] == 5
    a[5] = 6
    assert index_sets == ["set 5 6"]
    assert f"{a}" == "ops"
    assert len(a) == 7
}

test "methods called only through a vtable" {
    assert show(Tag[int64](v: 9)) == "tag 9 3"
}
