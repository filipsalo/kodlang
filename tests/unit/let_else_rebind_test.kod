// What `pick` and `second` saw of the name they rebind, in order.
mut seen_ints: [int64] = []
mut seen_strs: [str] = []

func parse_num(anon s: str) -> int64? {
    if len(s) == 0 {
        return none
    }
    mut n = 0
    for c in s.code_points() {
        if c < '0' or c > '9' {
            return none
        }
        n = n * 10 + c - '0'
    }
    return n
}

func pick(anon o: str?) -> int64 {
    let x = 5
    let .Some(x) = o else {
        seen_ints += [x]
        return 0
    }
    seen_strs += [x]
    return 1
}

type Pair = shared struct {
    a: int64
    b: int64
}

func second(anon o: Pair?) -> int64 {
    let p = "no pair"
    let .Some(p) = o else {
        seen_strs += [p]
        return -1
    }
    return p.b
}

test "the else of a rebinding let else sees the old binding" {
    mut total = 0
    mut bad: [str] = []
    for arg in ["12", "x7", "30"] {
        let .Some(arg) = parse_num(arg) else {
            bad += [f"bad: {arg}"]
            continue
        }
        total += arg
    }
    assert bad == ["bad: x7"]
    assert total == 42
}

test "a rebinding let else in a function" {
    assert pick(none) == 0
    assert pick("hi") == 1
    assert seen_ints == [5]
    assert seen_strs == ["hi"]
}

test "a rebinding let else of a struct" {
    assert second(none) == -1
    assert seen_strs == ["no pair"]
    assert second(Pair(a: 1, b: 2)) == 2
}
