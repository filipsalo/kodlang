type Pt = struct {
    x: int64
}

type Tone = enum {
    Low
    High
}

type R = int64 or Error

type Oops = struct {
    code: int64

    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

func value() -> int64 {
    return 1
}

func make(anon n: int64) -> Pt {
    return Pt(x: n)
}

func rank(anon t: Tone) -> int64 {
    match t {
        .Low -> return 1
        .High -> return 2
    }
}

