// A `.Variant` belongs to the enum of the slot it goes to or of the other
// side of `==`, even when this module declares a variant of that name too.
import "./variant_slots_dep"

type Mark = enum {
    Start
    End
    Red
}

type Pair = struct {
    tok: variant_slots_dep.Tok
    mark: Mark
}

func last() -> variant_slots_dep.Tok {
    return .End
}

func pick(anon n: int64) -> variant_slots_dep.Tok {
    return match n {
        0 -> .End
        else -> .Word(s: "w")
    }
}

func shade(c: variant_slots_dep.Color = .Red) -> bool {
    return variant_slots_dep.is_red(c)
}

func main() -> int64 {
    print_int(variant_slots_dep.count_words([.Word(s: "a"), .End, .Word(s: "b")]))
    print(f"{variant_slots_dep.is_end(.End)} {variant_slots_dep.is_red(.Red)}")
    let t: variant_slots_dep.Tok = .End
    print(f"{t == .End} {.End == t} {t != .End} {variant_slots_dep.is_end(t)}")
    mut u = variant_slots_dep.Tok.Word(s: "x")
    u = .End
    print(f"{variant_slots_dep.is_end(u)}")
    let p = Pair(tok: .End, mark: .End)
    print(f"{variant_slots_dep.is_end(p.tok)} {p.mark == Mark.End}")
    p.tok = .Word(s: "y")
    p.tok = .End
    print(f"{variant_slots_dep.is_end(p.tok)}")
    let ts = [variant_slots_dep.Tok.Word(s: "z")]
    ts[0] = .End
    print(f"{variant_slots_dep.is_end(ts[0])}")
    print(f"{variant_slots_dep.is_end(last())} {variant_slots_dep.is_end(pick(0))} {variant_slots_dep.is_end(pick(1))}")
    let cell = variant_slots_dep.Cell(t: .End)
    print(f"{variant_slots_dep.is_end(cell.t)} {variant_slots_dep.is_red(cell.tag)}")
    let h = variant_slots_dep.Held.Holds(t: .End)
    if h is .Holds(inner) {
        print(f"{variant_slots_dep.is_end(inner)}")
    }
    let m = Map[variant_slots_dep.Color, int64]()
    m[.Red] = 1
    m.set(.Green, 2)
    print(f"{m[variant_slots_dep.Color.Red]? or 0} {m.get(.Green)? or 0} {len(m)} {shade()}")
    return 0
}

// expected output:
// 2
// true true
// true true false true
// true
// true true
// true
// true
// true true false
// true false
// true
// 1 2 2 true
