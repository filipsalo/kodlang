// A store evaluates its receiver, then its index or key, then the value,
// and a compound `+=` or `-=` evaluates each of them once.
type Grid = shared struct {
    cells: [int64] = [0, 0, 0]

    func op_index(self, anon i: int64) -> int64 {
        return self.cells[i]
    }

    func op_index_set(self, anon i: int64, anon v: int64) -> none {
        self.cells[i] = v
    }
}

type Cell = shared struct {
    v: int64 = 0
}

type Row = shared struct {
    xs: [int64] = [0, 0, 0]
}

type Log = shared struct {
    text: str = ""
    n: int64 = 0

    func at(self, anon tag: str, anon v: int64) -> int64 {
        self.text = self.text + tag
        return v
    }

    func key(self, anon tag: str) -> str {
        self.text = self.text + tag
        return tag
    }

    func row(self, anon r: Row) -> Row {
        self.text = self.text + "r"
        return r
    }

    func grid(self, anon g: Grid) -> Grid {
        self.text = self.text + "r"
        return g
    }

    func cell(self, anon c: Cell) -> Cell {
        self.text = self.text + "r"
        return c
    }

    func tick(self) -> int64 {
        self.n += 1
        return self.n
    }

    func show(self) -> str {
        let t = self.text
        self.text = ""
        return t
    }
}

// Its `op_index` logs, so indexing it is a call.
type Loud = shared struct {
    name: str
    log: Log

    func op_index(self, anon k: str) -> int64 {
        self.log.text = self.log.text + self.name
        return 1
    }
}

type Holder = shared struct {
    log: Log
    cells: [Cell] = [Cell(), Cell(), Cell()]

    func op_index(self, anon k: str) -> Cell {
        self.log.text = self.log.text + "h"
        return self.cells[1]
    }
}

test "a user op_index in the receiver, the index and the value" {
    let l = Log()
    let a = Loud(name: "a", log: l)
    let b = Loud(name: "b", log: l)
    mut xs = [0, 0, 0]
    xs[a["k"]] = b["v"]
    assert l.show() == "ab"
    let g = Grid()
    g[a["k"]] = b["v"]
    assert l.show() == "ab"
    let h = Holder(log: l)
    h["k"].v = b["v"]
    assert l.show() == "hb"
    xs[a["k"]] += b["v"]
    assert l.show() == "ab"
    g[a["k"]] -= b["v"]
    assert l.show() == "ab"
    assert xs[1] == 2
    assert g[1] == 0
    assert h.cells[1].v == 1
}

test "receiver, then index or key, then value" {
    let l = Log()
    mut xs = [0, 0, 0]
    xs[l.tick()] = l.tick() * 10
    assert xs == [0, 20, 0]
    let row = Row()
    l.row(row).xs[l.at("i", 0)] = l.at("v", 5)
    assert l.show() == "riv"
    xs[l.at("i", 2)] = l.at("v", 7)
    assert l.show() == "iv"
    mut m = Map[str, int64]()
    m[l.key("k")] = l.at("v", 3)
    assert l.show() == "kv"
    let g = Grid()
    l.grid(g)[l.at("i", 1)] = l.at("v", 9)
    assert l.show() == "riv"
    let c = Cell()
    l.cell(c).v = l.at("v", 6)
    assert l.show() == "rv"
    l.row(row).xs[l.at("i", 2)] += l.at("v", 4)
    assert l.show() == "riv"
    l.grid(g)[l.at("i", 1)] += l.at("v", 1)
    assert l.show() == "riv"
    l.cell(c).v -= l.at("v", 2)
    assert l.show() == "rv"
    assert row.xs == [5, 0, 4]
    let k = m["k"]? or 0
    assert k == 3
    assert g[1] == 10
    assert c.v == 4
}
