import "encoding/hex"

test "encode" {
    assert hex.encode(b"") == ""
    assert hex.encode(b"\x00\x01\xab\xff") == "0001abff"
    assert hex.encode(b"Kod") == "4b6f64"
}

test "decode" {
    assert must hex.decode("") == b""
    assert must hex.decode("0001abff") == b"\x00\x01\xab\xff"
    assert must hex.decode("ABcd") == b"\xab\xcd"
    assert hex.decode("abc") is Error
    assert hex.decode("0g") is Error
    assert hex.decode(" 0") is Error
}
