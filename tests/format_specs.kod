// Format specs in f-strings and the format methods. The expected output is
// Python's format() for the same spec and value, except that a float precision
// with no type is fixed point, as in Rust, and `%` scales by 100 exactly where
// Python multiplies in floating point first.

type Color = enum {
    Red
    Green
}

type Pt = struct {
    x: int64
    y: int64

    func to_str(self) -> str {
        return f"({self.x}, {self.y})"
    }
}

func main() -> int64 {
    print(f"[{0}][{0:5}][{0:<5}][{0:^6}][{0:>6}][{0:05}][{0:+}][{0: }][{0:+05}][{0:x}][{0:X}][{0:#x}][{0:#X}][{0:o}][{0:#o}][{0:b}][{0:#b}][{0:08b}][{0:#010b}][{0:,}][{0:_}][{0:_x}][{0:_b}][{0:,d}][{0:*^9}][{0:->7}][{0:0>4}][{0:+,}][{0:#_x}][{0:12,}][{0:015,}]")
    print(f"[{7}][{7:5}][{7:<5}][{7:^6}][{7:>6}][{7:05}][{7:+}][{7: }][{7:+05}][{7:x}][{7:X}][{7:#x}][{7:#X}][{7:o}][{7:#o}][{7:b}][{7:#b}][{7:08b}][{7:#010b}][{7:,}][{7:_}][{7:_x}][{7:_b}][{7:,d}][{7:*^9}][{7:->7}][{7:0>4}][{7:+,}][{7:#_x}][{7:12,}][{7:015,}]")
    print(f"[{(-7)}][{(-7):5}][{(-7):<5}][{(-7):^6}][{(-7):>6}][{(-7):05}][{(-7):+}][{(-7): }][{(-7):+05}][{(-7):x}][{(-7):X}][{(-7):#x}][{(-7):#X}][{(-7):o}][{(-7):#o}][{(-7):b}][{(-7):#b}][{(-7):08b}][{(-7):#010b}][{(-7):,}][{(-7):_}][{(-7):_x}][{(-7):_b}][{(-7):,d}][{(-7):*^9}][{(-7):->7}][{(-7):0>4}][{(-7):+,}][{(-7):#_x}][{(-7):12,}][{(-7):015,}]")
    print(f"[{42}][{42:5}][{42:<5}][{42:^6}][{42:>6}][{42:05}][{42:+}][{42: }][{42:+05}][{42:x}][{42:X}][{42:#x}][{42:#X}][{42:o}][{42:#o}][{42:b}][{42:#b}][{42:08b}][{42:#010b}][{42:,}][{42:_}][{42:_x}][{42:_b}][{42:,d}][{42:*^9}][{42:->7}][{42:0>4}][{42:+,}][{42:#_x}][{42:12,}][{42:015,}]")
