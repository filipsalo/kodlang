// Unannotated bindings of enum and cross-module constructor calls.
import "json"
import "./../infer_ctor_kinds_dep"

type Dir = enum {
    North(steps: int64)
    South(steps: int64)
}

test "an enum constructor binds without an annotation" {
    let n = Dir.North(steps: 2)
    match n {
        .North(steps) -> assert steps == 2
        .South(_steps) -> fail("south")
    }
}

test "a cross-module constructor binds without an annotation" {
    let t = infer_ctor_kinds_dep.Thing(a: 1, s: "x")
    assert t.s == "x"
    assert t.a == 1
    let v = infer_ctor_kinds_dep.Shape.Square(side: 3)
    match v {
        .Circle(_r) -> fail("circle")
        .Square(side) -> assert side == 3
    }
    let j = json.Value.Number(value: 4)
    match j {
        .Number(value) -> assert value == 4
        else -> fail("not a number")
    }
}
