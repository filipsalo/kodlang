// A pattern that can't match `none` tests what an optional holds, without `Some`.
type Color = enum {
    Red
    Rgb(v: int64)
}

type Cell = enum {
    Paint(c: Color?)
    Count(n: int64?)
}

func color_name(anon c: Color?) -> str {
    return match c {
        .Red -> "red"
        .Rgb(0) -> "black"
        .Rgb(v) -> f"rgb {v}"
        none -> "none"
    }
}

func count_name(anon n: int64?) -> str {
    match n {
        0 -> return "zero"
        -1 -> return "minus one"
        none -> return "unknown"
        else -> return "some"
    }
}

func word(anon w: str?) -> str {
    return match w {
        "hi" -> "greeting"
        none -> "silence"
        else -> "words"
    }
}

func flag(anon b: bool?) -> str {
    return match b {
        true -> "yes"
        false -> "no"
        none -> "unset"
    }
}

func cell_name(anon c: Cell) -> str {
    return match c {
        .Paint(.Red) -> "red paint"
        .Paint(.Rgb(v)) -> f"paint {v}"
        .Paint(none) -> "no paint"
        .Count(7) -> "seven"
        .Count(_) -> "count"
    }
}

func main() -> int64 {
    print(color_name(.Red))
    print(color_name(.Rgb(v: 0)))
    print(color_name(.Rgb(v: 5)))
    print(color_name(none))
    print(count_name(0))
    print(count_name(-1))
    print(count_name(3))
    print(count_name(none))
    print(word("hi"))
    print(word("x"))
    print(word(none))
    print(flag(true))
    print(flag(false))
    print(flag(none))
    print(cell_name(.Paint(c: .Red)))
    print(cell_name(.Paint(c: .Rgb(v: 2))))
    print(cell_name(.Paint(c: none)))
    print(cell_name(.Count(n: 7)))
    print(cell_name(.Count(n: none)))
    let c: Color? = .Rgb(v: 1)
    if c is .Rgb(v) {
        print_int(v)
    }
    print(f"{c is .Rgb(_)} {c is .Red} {c is not .Red}")
    let gone: Color? = none
    print(f"{gone is .Red}")
    let .Rgb(w) = c else { return 1 }
    print_int(w)
    return 0
}

// expected output:
// red
// black
// rgb 5
// none
// zero
// minus one
// some
// unknown
// greeting
// words
// silence
// yes
// no
// unset
// red paint
// paint 2
// no paint
// seven
// count
// 1
// true false true
// false
// 1
