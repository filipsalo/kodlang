// `*=` and the other compound assignments, `min`, `max` and `abs`.

type Money = struct {
    cents: int64

    func op_mul(self, k: int64) -> Money {
        return Money(cents: self.cents * k)
    }

    func op_mod(self, k: int64) -> Money {
        return Money(cents: self.cents % k)
    }

    func op_lt(self, other: Money) -> bool {
        return self.cents < other.cents
    }
}

test "each operator" {
    mut x = 3
    x *= 2 + 1
    assert x == 9
    x /= 2
    assert x == 4
    x %= 3
    assert x == 1
    x |= 12
    assert x == 13
    x &= 6
    assert x == 4
    x ^= 1
    assert x == 5
    x <<= 4
    assert x == 80
    x >>= 1
    assert x == 40
    x -= 41
    x >>= 63
    assert x == 1
    mut f = 2.5
    f *= 2.0
    f /= 4.0
    assert f == 1.25
}

type Counter = shared struct {
    n: int64
    xs: [int64]
}

mut looked: int64 = 0

func at() -> int64 {
    looked += 1
    return 1
}

test "fields, elements, map entries and repeated arrays" {
    let c = Counter(n: 5, xs: [1, 2, 3])
    c.n *= 4
    c.xs[2] <<= 3
    assert c.n == 20 and c.xs == [1, 2, 24]
    looked = 0
    c.xs[at()] |= 8
    assert c.xs[1] == 10 and looked == 1
    mut m = Map[str, int64]()
    m["a", default: 1] *= 5
    m["a", default: 1] <<= 1
    assert (m["a"]? or 0) == 10
    mut xs = [1, 2]
    let before = xs
    xs *= 2
    assert xs == [1, 2, 1, 2] and before == [1, 2]
}

test "structs with the operator" {
    mut v = Money(cents: 7)
    v *= 3
    assert v.cents == 21
    v %= 4
    assert v.cents == 1
}

test "operators next to other tokens" {
    let a = 6
    let b = 3
    assert a / b == 2 and a % b == 0 and a & b == 2 and a | b == 7 and a ^ b == 5
    assert a >= b and b <= a and a << 1 == 12 and a >> 1 == 3
    mut x = 2
    x *= -1
    x /= -1
    assert x == 2
    // A comment after one.
    x *= 3  // and a `/=` in it
    assert x == 6
}

test "min and max" {
    assert min(1, 2) == 1 and min(2, 1) == 1 and max(1, 2) == 2 and max(2, 1) == 2
    assert min("pear", "apple") == "apple" and max(1.5, 0.5) == 1.5
    assert min(Money(cents: 3), Money(cents: 2)).cents == 2
    assert max(-5, min(5, 9)) == 5
    // The first, when neither is smaller.
    let nan = 0.0 / 0.0
    assert min(nan, 1.0).is_nan() and min(1.0, nan) == 1.0
}

test "a name of one's own" {
    let min = 4
    assert min == 4 and max(min, 3) == 4
}

test "abs" {
    assert (-3).abs() == 3 and 3.abs() == 3 and 0.abs() == 0
    let lowest = -9223372036854775807
    assert lowest.abs() == 9223372036854775807
    assert (2 - 7).abs() == 5
}
