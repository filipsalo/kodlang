import "crypto/random"
import "crypto/rsa" { PrivateKey }
import "crypto/rsa"
import "crypto/sha2" { Algo }
import "encoding/hex"

func h(anon s: str) -> bytes {
    return must hex.decode(s)
}

// PKCS #1 v1.5 signatures are the same each time: OpenSSL's, byte for byte.
// PSS ones have a random salt, so they are checked instead.
func pkcs1(anon key: str, anon algo: Algo, anon want: str) -> none {
    let k = must PrivateKey(h(key))
    let message = b"The quick brown fox jumps over the lazy dog"
    assert hex.encode(k.sign_pkcs1(algo: algo, message: message)) == want
    let pss = k.sign_pss(algo: algo, message: message)
    assert rsa.verify_pss(k.public, algo: algo, message: message, signature: pss)
    assert not rsa.verify_pss(k.public, algo: algo, message: message + b".", signature: pss)
    assert k.sign_pss(algo: algo, message: message) != pss
}

test "signatures OpenSSL makes too" {
    pkcs1("", .Sha256, "")
    pkcs1("", .Sha384, "")
    pkcs1("", .Sha512, "")
    pkcs1("", .Sha256, "")
    pkcs1("", .Sha384, "")
    pkcs1("", .Sha512, "")
    pkcs1("", .Sha256, "")
    pkcs1("", .Sha384, "")
    pkcs1("", .Sha512, "")
    pkcs1("", .Sha256, "")
    pkcs1("", .Sha384, "")
    pkcs1("", .Sha512, "")
}

test "keys refused" {
    let good = h("")
    assert PrivateKey(good[..len(good) - 1]) is Error
    assert PrivateKey(b"") is Error
    // A changed prime: n is no longer p q.
    mut changed = [b for b in good]
    changed[len(good) - 200] = changed[len(good) - 200] ^ 2
    assert PrivateKey(kod_bytes_from_array(changed)) is Error
    let k = must PrivateKey(good)
    assert k.public.bits() == 2048
    let _ = random.secure_bytes(1)
}
