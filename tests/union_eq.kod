// `==` and `!=` on a union: equal when both hold the same member and those are `==`.
type Color = enum {
    Red
    Blue
}
type V = struct {
    n: int64
    func op_eq(self, anon other: V) -> bool { return self.n == other.n }
}
type Id = int64 | str
type Wide = int64 | str | bool
type Any = Color | V | float64 | bytes

func id_of(anon s: str) -> Id {
    print(f"id {s}")
    return s
}

func main() -> int64 {
    let a: Id = 1
    let b: Id = 1
    let c: Id = "1"
    let d: Id = "1"
    print(f"{a == b} {a == c} {c == d} {a != c} {c != d}")
    let lit = c == "1"
    let lit_left = "1" == c
    print(f"{a == 1} {1 == a} {a == 2} {lit} {lit_left} {c == 1} {a != 1}")
    let w: Wide = 1
    let t: Wide = true
    print(f"{a == w} {w == a} {c == w} {t == true} {t != a}")
    let x: Any = .Red
    let y: Any = V(n: 4)
    let z: Any = 1.5
    let e: Any = b"hi"
    print(f"{x == .Red} {x == .Blue} {x == Color.Red} {y == V(n: 4)} {y == V(n: 5)} {y == x}")
    let same_bytes = e == b"hi"
    print(f"{z == 1.5} {z != 2.5} {same_bytes}")
    // Left to right, each side once.
    let calls = id_of("p") == id_of("p")
    print(calls)
    mut hits = 0
    for v in [a, b, c, d] {
        if v == 1 {
            hits += 1
        }
    }
    print(hits)
    return 0
}

// expected output:
// true false true true false
// true true false true true false false
// true true false true true
// true false true true false false
// true true true
// id p
// id p
// true
// 2
