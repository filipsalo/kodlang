    assert r.stderr.contains(".kod_compile_test.kod:8:13: error: `.Circle` is ambiguous: `variant_ambiguous_xmod_dep.Shape` and `Ring` both declare it; write `Ring.Circle` or give the value a type")
    assert r.stderr.contains("tests/variant_ambiguous_xmod_dep.kod:16:17: error: `.Fast` is ambiguous: `Mode` and `variant_ambiguous_xmod_base.Gear` both declare it; write `Mode.Fast` or give the value a type")
}

test "implicit variants with a type to go to when several enums declare them" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Figure = enum {
            Square(side: int64)
            Circle(r: int64)
            Dot
        }
        type Shape = enum {
            Circle(r: int64)
            Rect(w: int64, h: int64)
            Dot
        }
        type Holder = struct {
            s: Shape = .Dot
        }
        func area(anon s: Shape) -> int64 {
            match s {
                .Circle(r) -> return 3 * r * r
                .Rect(w, h) -> return w * h
                .Dot -> return 0
            }
        }
        func make() -> Shape {
            return .Circle(r: 2)
        }
        func main() -> int64 {
            let e: Shape = .Circle(r: 1)
            let d: Shape = .Dot
            let o: Shape? = none
            let xs: [Shape] = [.Circle(r: 1), .Dot]
            mut ys: [Shape] = []
            ys += [.Rect(w: 2, h: 3)]
            let m: Shape = match len(xs) {
                1 -> .Circle(r: 3)
                else -> .Dot
            }
            if e is .Circle(r) {
                print_int(r)
            }
            if d == .Dot {
                print("dot")
            }
            match Figure.Circle(r: 4) {
                .Circle(r) -> print_int(r)
                else -> print("other")
            }
            return area(.Circle(r: 2)) + area(make()) + area(Shape.Circle(r: 1)) + area(o? or .Dot) + area(m) + area(Holder().s) + len(ys)
        }
        """)
    assert len(errs) == 0
}

func arm_block_errors(anon arm: str) -> [codegen.Diagnostic] {
    let source = """
        func main() -> int64 {
            let n = 1
            let v = match n {
                1 -> ARM
                else -> 0
            }
            return v
        }
        """
    return test_support.try_compile(source.replace("ARM", to: arm))
}

test "a match arm's block must end in a value" {
    for arm in ["{\n let a = 2\n }", "{\n }", "{\n if true {\n print(\"x\")\n }\n }"] {
        let errs = arm_block_errors(arm)
        assert len(errs) >= 1
        assert errs[0].message == "error: a match arm's block must end with an expression, the arm's value"
        assert errs[0].line == 4
    }
}

test "a match arm's block may end in a value, a return or a throw" {
    assert len(arm_block_errors("{\n let a = 2\n a + 1\n }")) == 0
    assert len(arm_block_errors("{\n return 3\n }")) == 0
    assert len(arm_block_errors("{\n let a = 2\n kod_panic(\"no\")\n }")) == 0
}

test "a block arm's value is checked against the match's type" {
    let errs = test_support.try_compile("""
        func main() -> int64 {
            let s: str = match 1 {
                1 -> {
                    let a = 2
                    a + 1
                }
                else -> "x"
            }
            return 0
        }
        """)
    assert len(errs) >= 1
    assert errs[0].message.contains("expected `str`")
}

test "what a block arm binds is not visible after it" {
    let errs = test_support.try_compile("""
        func main() -> int64 {
            let v = match 1 {
                1 -> {
                    let inner = 2
                    inner
                }
                else -> 0
            }
            return inner + v
        }
        """)
    assert len(errs) >= 1
    assert errs[0].message.contains("inner")
}

func iface_convert_errors(anon body: str) -> [codegen.Diagnostic] {
    let source = """
        interface Reader {
            func read(self) -> int64
        }
        interface Writer {
            func write(self) -> int64
        }
        interface Loud {
            func read(self) -> str
        }
        interface Both {
            func read(self) -> int64
            func write(self) -> int64
        }
        type File = struct {
            func read(self) -> int64 {
                return 1
            }
            func write(self) -> int64 {
                return 2
            }
        }
        func main() -> int64 {
            let both: Both = File()
            BODY
            return 0
        }
        """
    return test_support.try_compile(source.replace("BODY", to: body))
}

test "an interface converts to one with a subset of its methods" {
    assert len(iface_convert_errors("let r: Reader = both")) == 0
    assert len(iface_convert_errors("let w: Writer = both\n let r: Reader = both")) == 0
}

test "an interface does not convert to one with a method it lacks or with another type" {
    let errs = iface_convert_errors("let r: Reader = both\n let b: Both = r")
    assert len(errs) == 1
    assert errs[0].message == "error: expected `Both`, got `Reader`"
    let loud = iface_convert_errors("let l: Loud = both")
    assert len(loud) == 1
    assert loud[0].message == "error: expected `Loud`, got `Both`"
}

test "arrays of interface values do not convert" {
    let errs = iface_convert_errors("let xs: [Both] = [both]\n let ys: [Reader] = xs")
    assert len(errs) == 1
    assert errs[0].message == "error: expected `[Reader]`, got `[Both]`"
}

func init_errors(anon body: str) -> [codegen.Diagnostic] {
    let source = """
        type A = struct {
            n: int64
            func init(m: int64 = 1) -> A {
                return A(n: m)
            }
            func again(self) -> A {
                return A(n: self.n + 1)
            }
        }
        func main() -> int64 {
            BODY
            return 0
        }
        """
    return test_support.try_compile(source.replace("BODY", to: body))
}

test "a struct with init is built through it, and its own functions use the fields" {
    assert len(init_errors("let a = A()\n let b = A(m: 5)\n let c = a.again()")) == 0
}

test "a field label outside the struct says init is the constructor" {
    let errs = init_errors("let a = A(n: 5)")
    assert len(errs) == 2
    assert errs[0].message == "error: parameter 0 of `A` expected label `m`, got `n`"
    assert errs[1].message == "error: `A` declares `init`, so it is built with that and not from its fields"
}

test "init arguments are checked like a call's" {
    let errs = init_errors("let a = A(m: \"x\")")
    assert len(errs) == 1
    assert errs[0].message.contains("expected `int64`, got `str`")
}

test "init must return its struct or a result of it" {
    let errs = test_support.try_compile("""
        type B = struct {
            n: int64
            func init(m: int64) -> int64 {
                return m
            }
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: `B.init` must return `B` or `B or Error`"
    assert errs[0].line == 3
}

test "a generic struct can't declare init yet" {
    let errs = test_support.try_compile("""
        type G[T] = struct {
            v: T
            func init(v: T) -> G[T] {
                return G[T](v: v)
            }
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: generic struct `G` can't declare `init` yet"
}

test "a dropped fallible init is an error like any dropped result" {
    let errs = test_support.try_compile("""
        type P = struct {
            n: int64
            func init(n: int64) -> P or Error {
                return P(n: n)
            }
        }
        func main() -> int64 {
            P(n: 1)
            return 0
        }
        """)
    assert len(errs) >= 1
}

func private_errors(anon body: str) -> [codegen.Diagnostic] {
    let source = """
        type A = struct {
            _n: int64
            _seen: int64 = 0
            tag: str = ""
            _hook: func(int64) -> int64 = twice
            func init(m: int64 = 1) -> A {
                return A(_n: m)
            }
            func bump(self) -> none {
                self._n = self._n + 1
                self._seen += self._hook(self._n)
            }
            func op_add(self, other: A) -> A {
                return A(_n: self._n + other._n)
            }
        }
        type G[T] = struct {
            _v: T = 0
            func get(self) -> T {
                return self._v
            }
            func with(self, v: T) -> G[T] {
                return G[T](_v: v)
            }
        }
        type D = struct {
            _d: int64 = 3
            n: int64
        }
        func twice(anon x: int64) -> int64 {
            return x * 2
        }
        func main() -> int64 {
            mut a = A(m: 2)
            let o: A? = a
            BODY
            return 0
        }
        """
    return test_support.try_compile(source.replace("BODY", to: body))
}

test "a struct's own functions use its private fields, and a default fills one in outside" {
    assert len(private_errors("a.bump()\n let s = a + a\n a.tag = \"x\"\n let d = D(n: 1)\n let g = G[int64]().with(v: 2).get()")) == 0
}

test "a private field can't be read outside its struct" {
    let errs = private_errors("print_int(a._n)")
    assert len(errs) == 1
    assert errs[0].message == "error: field `_n` is private to `A`"
    assert errs[0].line == 36
}

test "a private field can't be assigned outside its struct" {
    let errs = private_errors("a._seen = 0\n a._seen += 1")
    assert len(errs) == 2
    for e in errs {
        assert e.message == "error: field `_seen` is private to `A`"
    }
}

test "a private field can't be named in the field constructor outside its struct" {
    let errs = private_errors("let d = D(_d: 1, n: 2)\n let g = G[int64](_v: 1)")
    assert len(errs) == 2
    assert errs[0].message == "error: field `_d` is private to `D`"
    assert errs[1].message == "error: field `_v` is private to `G[int64]`"
}

test "a private field can't be reached through ?. or called outside its struct" {
    let errs = private_errors("let n = o?._n\n let h = a._hook(1)")
    assert len(errs) == 2
    assert errs[0].message == "error: field `_n` is private to `A`"
    assert errs[1].message == "error: field `_hook` is private to `A`"
}

test "another struct's methods can't use a private field" {
    let errs = test_support.try_compile("""
        type A = struct {
            _n: int64 = 0
        }
        type B = struct {
            a: A
            func peek(self) -> int64 {
                return self.a._n
            }
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: field `_n` is private to `A`"
}

test "a misspelt private field still gets a did-you-mean" {
    let errs = private_errors("a._sen = 1")
    assert len(errs) == 1
    assert errs[0].message.contains("has no field `_sen`")
    assert errs[0].message.contains("_seen")
}

func private_method_errors(anon body: str) -> [codegen.Diagnostic] {
    let source = """
        type A = struct {
            n: int64
            func _twice(self) -> int64 {
                return self.n * 2
            }
            func four(self) -> int64 {
                return self._twice() + A(n: self.n)._twice()
            }
        }
        type G[T] = struct {
            v: T
            func _get(self) -> T {
                return self.v
            }
            func get(self) -> T {
                return self._get()
            }
        }
        type B = struct {
            a: A
            func peek(self) -> int64 {
                return self.a.four()
            }
        }
        func main() -> int64 {
            let a = A(n: 2)
            let o: A? = a
            BODY
            return 0
        }
        """
    return test_support.try_compile(source.replace("BODY", to: body))
}

test "a struct's own functions call its private methods" {
    assert len(private_method_errors("print_int(a.four())\n print_int(G[int64](v: 1).get())\n print_int(B(:a).peek())")) == 0
}

test "a private method can't be called outside its struct" {
    let errs = private_method_errors("print_int(a._twice())\n let g = G[int64](v: 1)._get()\n let t = o?._twice()")
    assert len(errs) == 3
    assert errs[0].message == "error: method `_twice` is private to `A`"
    assert errs[0].line == 28
    assert errs[1].message == "error: method `_get` is private to `G[int64]`"
    assert errs[2].message == "error: method `_twice` is private to `A`"
}

test "another struct's methods can't call a private method" {
    let errs = test_support.try_compile("""
        type A = struct {
            n: int64 = 0
            func _secret(self) -> int64 {
                return 1
            }
        }
        type B = struct {
            a: A
            func peek(self) -> int64 {
                return self.a._secret()
            }
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: method `_secret` is private to `A`"
}

test "a primitive's private method is private to its module" {
    let errs = test_support.try_compile("""
        func main() -> int64 {
            if "abc"._matches_at("b", 1) {
                return 1
            }
            return 0
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: method `_matches_at` is private to `str`"
}

test "an interface can't declare a private method" {
    let errs = test_support.try_compile("""
        interface Secret {
            func _code(self) -> int64
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: interface `Secret` can't declare private method `_code`"
    assert errs[0].line == 2
}

func op_errors(anon body: str) -> [codegen.Diagnostic] {
    let source = """
        type V = struct {
            n: int64
            func op_add(self, other: V) -> V {
                return V(n: self.n + other.n)
            }
            func op_lt(self, other: V) -> bool {
                return self.n < other.n
            }
            func op_eq(self, other: V) -> int64 {
                return 1
            }
            func op_mul(self) -> V {
                return self
            }
        }
        type Plain = struct {
            n: int64
        }
        func main() -> int64 {
            let a = V(n: 1)
            let p = Plain(n: 1)
            BODY
            return 0
        }
        """
    return test_support.try_compile(source.replace("BODY", to: body))
}

test "operators call the struct's methods" {
    assert len(op_errors("let b = a + a\n let c = a < a\n let d = a > a\n let e = a >= a\n mut m = a\n m += a")) == 0
}

test "an operator the struct doesn't declare says which method to add" {
    let errs = op_errors("let b = a - a\n let c = p + p\n let d = p < p\n let e = p == p")
    assert len(errs) == 4
    assert errs[0].message == "error: `-` needs `int64` operands, got `V`; declare `op_sub` on `V` to use it"
    assert errs[1].message == "error: `+` doesn't take `Plain` operands; declare `op_add` on `Plain` to use it"
    assert errs[2].message == "error: `<` doesn't take `Plain` operands; declare `op_lt` on `Plain` to use it"
    assert errs[3].message == "error: `==` doesn't compare structs; compare their fields, or declare `op_eq`"
}

test "an operator method takes one operand and a comparison returns bool" {
    let errs = op_errors("let x = a * a\n let y = a == a")
    assert len(errs) == 2
    assert errs[0].message == "error: `V.op_mul` must take one operand"
    assert errs[1].message == "error: `V.op_eq` must return `bool`"
}

test "the operand of an operator method is checked against its parameter" {
    let errs = op_errors("let b = a + 5")
    assert len(errs) == 1
    assert errs[0].message.contains("expected `V`, got `int64`")
}

func float_errors(anon body: str) -> [codegen.Diagnostic] {
    let source = "func f(anon x: float64) -> float64 { return x }\nfunc main() -> int64 {\n" + body + "\n return 0\n}\n"
    return test_support.try_compile(source)
}

test "float arithmetic and comparison compile" {
    assert len(float_errors("let a = 1.5\n let b = -a + a * 2.0 - a / 4.0\n let c = a < b\n let d = a == b\n mut e = a\n e += 1.0\n e -= a")) == 0
}

test "a float and an int are never mixed" {
    let errs = float_errors("let n = 3\n let a = 1.5 + 1\n let b = n * 0.5\n let c = 1.5 < 2\n let d = 2.5 - n")
    assert len(errs) == 4
    assert errs[0].message == "error: cannot add `float64` and `int64`"
    assert errs[1].message == "error: `*` needs `int64` operands, got `float64`"
    assert errs[2].message == "error: cannot compare `float64` with `int64`"
    assert errs[3].message == "error: `-` needs `float64` operands, got `int64`"
}

test "a float has no remainder or bit operators" {
    let errs = float_errors("let a = 1.5 % 2.0\n let b = 1.5 & 2.5\n let c = 1.5 << 1")
    assert len(errs) == 3
    assert errs[0].message == "error: `%` needs `int64` operands, got `float64`"
    assert errs[1].message == "error: `&` needs `int64` operands, got `float64`"
    assert errs[2].message == "error: `<<` needs `int64` operands, got `float64`"
}

test "a float is not an int64 or a condition" {
    let errs = float_errors("let a: int64 = 1.5\n let b: float64 = 2\n let c = f(1)\n if 1.5 { print(\"x\") }")
    assert len(errs) == 4
    assert errs[0].message == "error: expected `int64`, got `float64`"
    assert errs[1].message == "error: expected `float64`, got `int64`"
    assert errs[2].message == "error: expected `float64`, got `int64`"
    assert errs[3].message == "error: an `if` condition must be a `bool`, got `float64`"
}

test "a float can't be a map key or a pattern" {
    let errs = float_errors("let m: Map[float64, int64] = Map[float64, int64]()")
    assert len(errs) == 1
    assert errs[0].message == "error: `float64` can't be a `Map` key; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    let pat = float_errors("let x = 1.5\n match x {\n 1.5 -> print(\"a\")\n else print(\"b\")\n }")
    assert len(pat) == 1
    assert pat[0].message == "error: a float can't be a pattern; test it with `==` or a comparison"
}

test "a float literal needs a digit after its point" {
    let errs = float_errors("let a = 1.to_str()\n let b = 2.5.to_str()\n let c = 1e3.to_str()")
    assert len(errs) == 0
}

test "generic function: a type parameter no argument settles" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func empty[T]() -> [T] {
            let out: [T] = []
            return out
        }
        func pair[A, B](a: A) -> int64 {
            let _ = a
            return 1
        }
        func id[T](anon x: T) -> T {
            return x
        }
        func main() -> int64 {
            let xs: [int64] = empty()
            print(len(xs))
            print(pair(a: 1))
            print(id(none))
            print(id([]))
            return 0
        }
        """)
    assert len(errs) == 4
    assert errs[0].message == "error: cannot infer `T` in the call to `empty`; write the type arguments: `empty[T](...)`"
    assert errs[1].message == "error: cannot infer `B` in the call to `pair`; write the type arguments: `pair[A, B](...)`"
    assert errs[2].message == "error: cannot infer `T` in the call to `id`; write the type arguments: `id[T](...)`"
    assert errs[3].message == "error: cannot infer `T` in the call to `id`; write the type arguments: `id[T](...)`"
}

test "generic function: bad arguments are reported instead of what they leave unsettled" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func id[T](anon x: T) -> T {
            return x
        }
        func main() -> int64 {
            print(id())
            print(id(not_there))
            print(id(1, 2))
            return 0
        }
        """)
    assert len(errs) == 3
    assert errs[0].message == "error: `id` missing argument at position 0"
    assert errs[1].message == "error: unknown name `not_there`"
    assert errs[2].message == "error: `id` takes 1 argument, got 2"
}

test "generic function: the first argument settles the parameter for the rest" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func pick[T](a: T, b: T) -> T {
            let _ = b
            return a
        }
        func main() -> int64 {
            print(pick(a: 1, b: "x"))
            return 0
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: expected `int64`, got `str`"
}

test "generic function: explicit type arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func pair[A, B](a: A) -> int64 {
            let _ = a
            return 1
        }
        func plain(anon x: int64) -> int64 {
            return x
        }
        func main() -> int64 {
            print(pair[int64](a: 1))
            print(plain[int64](1))
            print(pair[int64, Nope](a: 1))
            return 0
        }
        """)
    assert len(errs) == 3
    assert errs[0].message == "error: `pair` expects 2 type arguments, got 1"
    assert errs[1].message == "error: `plain` is not generic"
    assert test_support.any_message_contains(errs, needle: "unknown type `Nope`")
}

test "generic function: a value needs its type arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func id[T](anon x: T) -> T {
            return x
        }
        func take(f: func(int64) -> int64) -> int64 {
            return f(1)
        }
        func main() -> int64 {
            let f = id
            print(take(f: id))
            print(take(f: id[str]))
            print(take(f: id[int64]))
            return 0
        }
        """)
    assert len(errs) == 3
    assert errs[0].message == "error: generic function `id` needs its type arguments to be a value: `id[...]`"
    assert errs[1].message == "error: generic function `id` needs its type arguments to be a value: `id[...]`"
    assert test_support.any_message_contains(errs, needle: "expected `func(int64) -> int64`, got `func(str) -> str`")
}

test "generic function: a body error names the instance and is reported once" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum {
            Red
            Green
        }
        type Mood = enum {
            Glad
            Sad
        }
        func largest[T](a: T, b: T) -> T {
            if a < b {
                return b
            }
            return a
        }
        func never_called[T](anon x: T) -> T {
            return x.no_such_method()
        }
        func main() -> int64 {
            let c = largest(a: Color.Red, b: Color.Green)
            let m = largest(a: Mood.Glad, b: Mood.Sad)
            print(c is .Red and m is .Sad)
            print(largest(a: 1, b: 2))
            return 0
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: `<` doesn't take `Color` operands (in `largest[Color]`)"
}

test "generic function: a signature is checked even with no call" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f[T](anon x: Nope, y: T) -> T {
            let _ = x
            return y
        }
        func wide[T](a: T, b: T, c: T, d: T, e: T, g: T, h: T, i: T, j: T) -> T {
            return a
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "unknown type `Nope`")
    assert test_support.any_message_contains(errs, needle: "`wide` takes 9 parameters, but a function can take at most 8")
}

test "generic function: an instance chain that never ends" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func grow[T](anon x: T, n: int64) -> int64 {
            if n == 0 {
                return 0
            }
            return grow([x], n: n - 1)
        }
        func main() -> int64 {
            print(grow(1, n: 3))
            return 0
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: generic function `grow` is 64 instances deep; each one calls another with a new type"
}

test "generic function: where type parameters can't be declared or named" {
    let main_errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main[T]() -> int64 {
            return 0
        }
        """)
    assert len(main_errs) == 1
    assert main_errs[0].message == "error: `main` can't be generic"
    let method_errs: [codegen.Diagnostic] = test_support.try_compile("""
        type S = struct {
            func m[T](self, anon x: T) -> T {
                return x
            }
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(method_errs) == 1
    assert method_errs[0].message == "error: a method can't declare its own type parameters; put them on the struct"
    let dup_errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f[T, T](anon x: T) -> T {
            return x
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(dup_errs) == 1
    assert dup_errs[0].message == "error: type parameter `T` is declared twice"
    let lit_errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f[T](anon x: T) -> T {
            let g = func(anon y: T) -> T {
                return y
            }
            return g(x)
        }
        func main() -> int64 {
            print(f(1))
            return 0
        }
        """)
    assert test_support.any_message_contains(lit_errs, needle: "unknown type `T`")
}

test "generic type: instances that never end stop at a limit" {
    let field_errs: [codegen.Diagnostic] = test_support.try_compile("""
        type W[T] = struct {
            v: T
            next: W[[T]]?
        }
        func main() -> int64 {
            let w = W[int64](v: 1, next: none)
            print(w.v)
            return 0
        }
        """)
    assert len(field_errs) == 1
    assert field_errs[0].message == "error: generic type `W` is 64 instances deep; each one names another with a new type"
    let enum_errs: [codegen.Diagnostic] = test_support.try_compile("""
        type W[T] = enum {
            Leaf(v: T)
            Node(next: W[[T]])
        }
        func main() -> int64 {
            let w: W[int64] = .Leaf(v: 1)
            print(w is .Leaf(_))
            return 0
        }
        """)
    assert len(enum_errs) == 1
    assert enum_errs[0].message == "error: generic type `W` is 64 instances deep; each one names another with a new type"
    let method_errs: [codegen.Diagnostic] = test_support.try_compile("""
        type W[T] = struct {
            v: T
            func up(self) -> int64 {
                let n = W[[T]](v: [self.v])
                return n.up()
            }
        }
        func main() -> int64 {
            print(W[int64](v: 1).up())
            return 0
        }
        """)
    assert len(method_errs) == 1
    assert method_errs[0].message == "error: generic type `W` is 64 instances deep; each one names another with a new type"
}

test "generic instances: a chain through a struct and a function, or one that branches, stops too" {
    let mixed_errs: [codegen.Diagnostic] = test_support.try_compile("""
        type W[T] = struct {
            v: T
            func up(self) -> int64 {
                return grow([self.v])
            }
        }
        func grow[T](anon x: T) -> int64 {
            return W[T](v: x).up()
        }
        func main() -> int64 {
            print(grow(1))
            return 0
        }
        """)
    assert len(mixed_errs) == 1
    assert test_support.any_message_contains(mixed_errs, needle: "is 64 instances deep")
    let branching_errs: [codegen.Diagnostic] = test_support.try_compile("""
        type W[T] = struct {
            a: W[[T]]?
            b: W[T?]?
        }
        func main() -> int64 {
            let w = W[int64](a: none, b: none)
            let _ = w
            return 0
        }
        """)
    assert test_support.any_message_contains(branching_errs, needle: "is 64 instances deep")
    let nested_errs: [codegen.Diagnostic] = test_support.try_compile("""
        func both[T](anon x: T, n: int64) -> int64 {
            if n == 0 {
                return 0
            }
            let y: T? = x
            return both([x], n: n - 1) + both(y, n: n - 1)
        }
        func main() -> int64 {
            print(both(1, n: 2))
            return 0
        }
        """)
    assert len(nested_errs) == 1
    assert nested_errs[0].message == "error: generic function `both` makes a module's instances pass 4096; its calls keep making new types"
}
