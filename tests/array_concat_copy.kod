// Binary `+` on arrays builds a new array and leaves both operands
// unchanged; only `+=` appends in place. Compiled code used to append
// into the left operand, so `a + [3]` grew `a` and every later `a + ...`
// shared (and overwrote) the same header.

type Point = struct {
	x: int64
	y: int64
}

type Bag = struct {
	items: [int64]
}

func show(anon xs: [int64]) -> str {
	mut out = "["
	mut first = true
	for x in xs {
		if first == false {
			out += ", "
		}
		out += x.to_str()
		first = false
	}
	return out + "]"
}

func main() -> int64 {
	let a: [int64] = [1, 2]
	let b: [int64] = a + [3]
	let c: [int64] = a + [99]
	print(f"a={show(a)} b={show(b)} c={show(c)}")

	let d: [int64] = [7] + a
	let e: [int64] = a + b + c
	print(f"d={show(d)} e={show(e)} a={show(a)} b={show(b)}")

	let empty: [int64] = []
	let one: [int64] = empty + [1]
	let two: [int64] = empty + [2]
	print(f"empty={show(empty)} one={show(one)} two={show(two)}")

	mut grown: [int64] = a + [5]
	grown += [6]
	print(f"grown={show(grown)} a={show(a)}")

	mut built: [int64] = []
	mut i = 0
	for i < 5 {
		built = built + [i * 10]
		i += 1
	}
	let snapshot: [int64] = built
	built = built + [50]
	print(f"built={show(built)} snapshot={show(snapshot)}")

	mut appended: [int64] = []
	mut j = 0
	for j < 1000 {
		appended += [j]
		j += 1
	}
	print(f"appended={len(appended)} last={appended[-1]}")

	mut doubled: [int64] = [1, 2]
	doubled += doubled
	print(f"doubled={show(doubled)}")

	let names: [str] = ["ann", "bob"]
	let more: [str] = names + ["cid"]
	let other: [str] = names + ["dee"]
	print(f"names={len(names)} more={more[2]} other={other[2]} {len(more)} {len(other)}")

	let pts: [Point] = [Point(x: 1, y: 2)]
	let pts2: [Point] = pts + [Point(x: 3, y: 4)]
	let pts3: [Point] = pts + [Point(x: 8, y: 9)]
	let p2: Point = pts2[1]
	let p3: Point = pts3[1]
	print(f"pts={len(pts)} pts2={len(pts2)} {p2.x},{p2.y} pts3={len(pts3)} {p3.x},{p3.y}")

	mut bag = Bag(items: [1])
	bag.items += [2]
	let bigger: [int64] = bag.items + [3]
	print(f"bag={show(bag.items)} bigger={show(bigger)}")
	return 0
}

// expected output:
// a=[1, 2] b=[1, 2, 3] c=[1, 2, 99]
// d=[7, 1, 2] e=[1, 2, 1, 2, 3, 1, 2, 99] a=[1, 2] b=[1, 2, 3]
// empty=[] one=[1] two=[2]
// grown=[1, 2, 5, 6] a=[1, 2]
// built=[0, 10, 20, 30, 40, 50] snapshot=[0, 10, 20, 30, 40]
// appended=1000 last=999
// doubled=[1, 2, 1, 2]
// names=2 more=cid other=dee 3 3
// pts=1 pts2=2 3,4 pts3=2 8,9
// bag=[1, 2] bigger=[1, 2, 3]

// expected status:
// 0
