test "an error in a generic method body is reported once and names the instance" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Greet {
            func hi(self) -> str
        }
        type Gen[T] = struct {
            v: T
            func get(self) -> T {
                return self.vv
            }
            func poke(self, anon g: Greet) -> none {
                zz = 5
                print(g.hii())
                let fp: func(int64) -> int64 = one
                print_int(fp())
                print_int(one())
            }
        }
        type Dog = struct {
            func hi(self) -> str {
                return "woof"
            }
        }
        func one(anon x: int64) -> int64 {
            return x
        }
        func main() -> int64 {
            let a = Gen[int64](v: 1)
            let b = Gen[str](v: "s")
            print_int(a.get())
            print(b.get())
            a.poke(Dog())
            b.poke(Dog())
            return 0
        }
        """)
    assert len(errs) == 5
    assert test_support.any_message_contains(errs, needle: "struct `Gen[int64]` has no field `vv`; did you mean `v`?")
    assert test_support.any_message_contains(errs, needle: "unknown name `zz`")
    assert test_support.any_message_contains(errs, needle: "interface `Greet` has no method `hii`")
    assert test_support.any_message_contains(errs, needle: "`fp` takes 1 argument, got 0")
    assert test_support.any_message_contains(errs, needle: "`one` missing argument at position 0")
}

test "a generic enum's errors are reported once and name the template or instance" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        type Holder[T] = struct {
            m: Maybe[T]
            func peek(self) -> none {
                match self.m {
                    .Just(a, b) -> print("two")
                }
            }
        }
        func main() -> int64 {
            let h = Holder[int64](m: .Nothing)
            let g = Holder[str](m: .Nothing)
            h.peek()
            g.peek()
            return 0
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "match on `Maybe[int64]` doesn't cover variant `Nothing`")
    assert test_support.any_message_contains(errs, needle: "`Maybe.Just` has 1 payload field, pattern binds 2")
}

test "a pattern that doesn't resolve reports only itself" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Pt = struct {
            x: int64
        }
        type Shape = enum {
            Dot(p: Pt)
            Circle(radius: int64)
        }
        type Oops = struct {
            code: int64
            func to_str(self) -> str {
                return "oops"
            }
        }
        func fails() -> int64 or Error {
            throw Oops(code: 3)
        }
        func main() -> int64 {
            let s: Shape = .Circle(radius: 5)
            let n = match s {
                .Dott(p) -> p.x
                else -> 0
            }
            print_int(n)
            match s {
                .Circel(r) -> print_int(r)
                .Dot(p) -> print_int(p.x)
            }
            let .Dott(q) = s else { return 1 }
            print_int(q.x)
            match fails() {
                Ok(v) -> print_int(v)
                Err(e) -> {
                    match e {
                        Opps(o) -> print_int(o.code)
                        else -> {}
                    }
                }
            }
            match s {
                .Dot(a, b) -> print_int(b.x)
                else -> {}
            }
            return 0
        }
        """)
    assert len(errs) == 5
    assert test_support.any_message_contains(errs, needle: "enum `Shape` has no variant `Dott`")
    assert test_support.any_message_contains(errs, needle: "enum `Shape` has no variant `Circel`")
    assert test_support.any_message_contains(errs, needle: "`Opps` is not a struct type")
    assert test_support.any_message_contains(errs, needle: "`Shape.Dot` has 1 payload field, pattern binds 2")
}

test "a pattern naming a generic enum takes the subject's instance" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        type Box[T] = enum {
            Full(item: T)
            Empty
        }
        type Pt = struct {
            x: int64
        }
        func main() -> int64 {
            let m: Maybe[Pt] = .Just(value: Pt(x: 1))
            match m {
                Maybe.Just(p) -> print_int(p.x)
                Maybe.Nothing -> print("nothing")
            }
            let b: Box[int64] = .Full(item: 2)
            match b {
                Maybe.Just(q) -> print(q.name)
                else -> print("else")
            }
            let o: int64 or Error = .Ok(value: 3)
            let n = match o {
                Result.Ok(v) -> v + 1
                Result.Err(e) -> 0
            }
            return n
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "`Maybe.Just` is not a variant of `Box[int64]`")
}

test "annotated generic enum constructors compile in every position" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        func main() -> int64 {
            let k = 1
            let m: Maybe[int64] = Maybe.Nothing
            if m == Maybe.Nothing {
                print("eq")
            }
            if Maybe.Nothing != m {
                print("ne")
            }
            let x: Maybe[int64] = match k {
                1 -> Maybe.Just(value: 1)
                else -> Maybe.Nothing
            }
            mut y: Maybe[int64] = x
            y = match k {
                1 -> .Nothing
                else -> Maybe.Just(value: 2)
            }
            return 0
        }
        """)
    assert len(errs) == 0
}

test "an annotated match checks each arm against the annotation" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type B = enum {
            Miss
            Hit(n: int64)
        }
        func main() -> int64 {
            let k = 1
            let xs: [str] = [match k {
                1 -> 5
                else -> 6
            }]
            let b: B = match k {
                1 -> .Hit(n: 1)
                else -> "miss"
            }
            return 0
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "expected `str`, got `int64`")
    assert test_support.any_message_contains(errs, needle: "expected `B`, got `str`")
}

test "a variant pattern on a value that isn't an enum" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum {
            Red
            Green(level: int64)
        }
        type Bx = struct {
            w: int64
        }
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        func main() -> int64 {
            let c: Color? = .Red
            match c {
                .Red -> print("red")
                Color.Green(l) -> print_int(l + 1)
            }
            let n: int64 = 3
            let k = match n {
                .Some(v) -> v + 1
                .Ok(w) -> w + 2
                else -> 0
            }
            print_int(k)
            if Bx(w: 1) is .Green(w) {
                print_int(w.size)
            }
            let o: int64? = 4
            if o is Maybe.Just(j) {
                print_int(j + 1)
            }
            let .Some(s) = n else { return 1 }
            print_int(s + 1)
            let .Red = c else { return 1 }
            return 0
        }
        """)
    assert len(errs) == 8
    assert test_support.any_message_contains(errs, needle: "`.Red` matches a `Color`, not a `Color?`; unwrap it first with `c?` or `c? or default`, or match `.Some(v)`")
    assert test_support.any_message_contains(errs, needle: "`Color.Green` matches a `Color`, not a `Color?`")
    assert test_support.any_message_contains(errs, needle: "`.Some` needs an optional value, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`.Ok` needs a `T or Error` value, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`.Green` needs an enum value, got `Bx`")
    assert test_support.any_message_contains(errs, needle: "`Maybe.Just` needs an enum value, got `int64?`")
}

test "a literal pattern on a value of another type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n: int64? = 3
            match n {
                3 -> print("three")
                4 -> print("four")
            }
            let s: str? = "hi"
            let k = match s {
                "hi" -> 1
                else -> 2
            }
            if n is 3 {
                print("is three")
            }
            let t = "x"
            match t {
                3 -> print("three")
                else -> print("other")
            }
            let b = false
            match b {
                true -> print("t")
                false -> print("f")
            }
            return k
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "cannot match a `int64?` value against a `int64` literal; unwrap it first with `n?` or `n? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot match a `str?` value against a `str` literal; unwrap it first with `s?` or `s? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot match a `str` value against a `int64` literal")
}

test "a match used as a value needs a value from every arm" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func noop() -> none {}
        func main() -> int64 {
            let k = 1
            let x = match k {
                1 -> noop()
                else -> 5
            }
            let y: int64 = match k {
                1 -> 2
                else -> kod_panic("unreachable")
            }
            let c = match k {
                1 -> none
                else -> none
            }
            mut q = match k {
                1 -> none
                else -> none
            }
            q = 5
            return x + y
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "this arm has no value, but the match is used as a value")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `c`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `q`; add a type annotation")
}

test "a let-else whose else block can complete" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func die(anon msg: str) -> none {
            kod_panic(msg)
        }
        func f(anon o: int64?, k: int64) -> int64 {
            let .Some(a) = o else { print("none") }
            let .Some(b) = o else {}
            let .Some(c) = o else {
                if k > 0 {
                    return 1
                }
            }
            let .Some(d) = o else { die("d") }
            let .Some(e) = o else {
                if k > 0 {
                    return 1
                } else {
                    kod_panic("e")
                }
            }
            let .Some(g) = o else {
                match k {
                    1 -> return 1
                    else -> die("g")
                }
            }
            for i in [1, 2] {
                let .Some(x) = o else { continue }
                let .Some(y) = o else { break }
            }
            return a + b + c + d + e + g
        }
        func main() -> int64 {
            return f(none, k: 1)
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "the else block of a let-else must leave the scope (return, throw, break, continue or panic)")
}

test "a let-else's else block sees the name's old binding" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type A = struct {
            tag: str
        }
        type B = struct {
            n: int64
            m: int64
        }
        func f(anon o: int64?) -> int64 {
            let x = "old"
            let .Some(x) = o else {
                print_int(x)
                return 0
            }
            return x
        }
        func g(anon o: B?) -> int64 {
            let p = A(tag: "a")
            let .Some(p) = o else {
                print_int(p.m)
                return -1
            }
            return p.n
        }
        func main() -> int64 {
            return f(none) + g(none)
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "expected `int64`, got `str`")
    assert test_support.any_message_contains(errs, needle: "no field `m`")
}

test "a match returned into a `none or Error` needs no arm values" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func a() -> none {
            print("a")
        }
        func pick(anon k: int64) -> none or Error {
            return match k {
                1 -> a()
                else -> a()
            }
        }
        func main() -> int64 {
            let r = must pick(1)
            return 0
        }
        """)
