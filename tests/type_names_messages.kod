// A message writes a type by its bare name, unless another module of the
// program declares a type of that name too. Then it is written the way this
// module would write it, or with its file when it can't name the module.
import "./type_names_pa"
import "./type_names_pb"

type Pt = struct {
    z: int64
}

type Solo = struct {
    n: int64
}

interface Sized {
    func size(self) -> int64
    func weight(self) -> int64
}

func takes_pa(anon p: type_names_pa.Pt) -> int64 {
    return p.x
}

func main() -> int64 {
    let a: type_names_pa.Pt = type_names_pb.make(1, 2)
    let b: Pt = type_names_pa.make(1)
    let c: type_names_pa.Pt = Pt(z: 3)
    takes_pa(type_names_pb.make(1, 2))
    let d: Pt = type_names_pa.far_pt()
    let e: Solo = type_names_pa.make(1)
    let f: type_names_pa.Mode = type_names_pb.Mode.Dim
    let g: [type_names_pa.Pt] = [type_names_pb.make(1, 2)]
    let h: type_names_pa.Pt? = type_names_pb.make(1, 2)
    let i: type_names_pa.Box[int64] = type_names_pb.IntBox(v: 1)
    let j: Sized = type_names_pa.make(1)
    let k: Solo = Pt(z: 1)
    let l = type_names_pa.Pt(z: 3)
    let m = type_names_pa.Pt()
    let n = type_names_pa.Pt(1)
    return 0
}

