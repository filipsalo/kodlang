func get(anon flag: bool) -> int64? {
    if flag {
        return 42
    }
    return none
}

test "if is Some binds the value" {
    if get(true) is Some(v) {
        assert v == 42
    } else {
        fail("no value")
    }
    if get(false) is Some(_v) {
        fail("should not match")
    }
    // Still works as bool:
    let x: int64? = none
    assert x is none
}
