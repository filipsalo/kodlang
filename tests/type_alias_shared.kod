// Two modules may each declare an alias of one name for the same type.
import "process"
import "./type_alias_shared_dep"

type Num = int64
type Ids = [int64]
type Run = process.ProcessResult

func main() -> int64 {
    let ids: Ids = [1, 2, 3]
    let n: Num = type_alias_shared_dep.total(ids)
    let r: Run = process.ProcessResult(status: 4, stdout: "", stderr: "")
    print_int(n + type_alias_shared_dep.status(r))
    return 0
}

// expected output:
// 10
