// The interpreter writes an enum the module aliases by that name, as the
// compiler does.
import "./type_names_pb"
import "./type_names_pa"

type Shape = type_names_pb.Shape

func main() -> int64 {
    let s = .Circle(r: 2)
    return 0
}

// expected status:
// 1
// expected stderr:
// 9:13: error: `.Circle` is ambiguous: `Shape` and `type_names_pa.Shape` both declare it; write `type_names_pa.Shape.Circle` or give the value a type
// expected mode:
// interpret
