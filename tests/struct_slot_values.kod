// A struct-typed let evaluates whatever expression produces its value.

type Foo = struct {
    n: int64
}

type Oops = struct {
    func to_str(self) -> str {
        return "oops"
    }
}

func mk(anon ok: bool) -> Foo? {
    if ok {
        return Foo(n: 10)
    }
    return none
}

func make(anon n: int64) -> Foo or Error {
    if n < 0 {
        throw Oops()
    }
    return Foo(n: n * 100)
}

func pick(anon k: int64) -> Foo {
    let f: Foo = match k {
        1 -> Foo(n: 1)
        else -> Foo(n: 2)
    }
    return f
}

func try_store(anon n: int64) -> int64 or Error {
    let h: Foo = try make(n)
    print(f"try-store {h.n}")
    return h.n
}

func main() -> int64 {
    print(f"match-store {pick(1).n} {pick(5).n}")
    let g: Foo = mk(true)? or Foo(n: 3)
    let g2: Foo = mk(false)? or Foo(n: 3)
    print(f"unwrap-store {g.n} {g2.n}")
    let ok: int64 = must try_store(2)
    print(f"ok {ok}")
    match try_store(-1) {
        Ok(v) -> print(f"should not reach {v}")
        Err(e) -> print(f"err {e.to_str()}")
    }
    return 0
}

// expected output:
// match-store 1 2
// unwrap-store 10 3
// try-store 200
// ok 200
// err oops
// expected status:
// 0
