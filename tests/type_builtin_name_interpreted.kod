// The interpreter rejects a type named like a builtin one before it runs.
type Option = struct {
    v: int64
}

func main() -> int64 {
    print("ran")
    return 0
}

// expected status:
// 1
// expected stderr:
// 2:6: error: `Option` is the name of a builtin type; give this type another name
// expected mode:
// interpret
