// Provided methods of an interface in another module: for a type there, for
// one here, through the interface and on the type itself.
import "./../interface_provided_dep" { Source, Ones }

type Up = shared struct {
    at: int64 = 0

    func next(self) -> int64 {
        self.at += 1
        return self.at
    }
}

func total(anon s: Source) -> int64 {
    mut sum = 0
    for x in s.take(3) {
        sum += x
    }
    return sum
}

test "provided methods from another module" {
    let ones = Ones().take(2, from: 5)
    assert ones[0] + ones[1] == 12
    let ups = Up().take(3)
    assert ups[2] == 3
    assert total(Up()) == 6
    assert total(Ones()) == 3
}
