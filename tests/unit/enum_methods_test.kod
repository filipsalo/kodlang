// Methods declared in an enum body: on a local, a payload variant, an
// imported enum, through `?.`, chained, with defaults, and `to_str` in
// f-strings.
import "./../enum_methods_dep" { Level }

type Shape = enum {
    Circle(r: int64)
    Rect(w: int64, h: int64)
    Empty

    func area(self) -> int64 {
        return match self {
            .Circle(r) -> 3 * r * r
            .Rect(w, h) -> w * h
            .Empty -> 0
        }
    }

    func scaled(self, by: int64) -> Shape {
        return match self {
            .Circle(r) -> .Circle(r: r * by)
            .Rect(w, h) -> .Rect(w: w * by, h: h * by)
            .Empty -> .Empty
        }
    }

    func bigger(self, than other: Shape) -> bool {
        return self.area() > other.area()
    }

    func to_str(self) -> str {
        return match self {
            .Circle(r) -> f"circle {r}"
            .Rect(w, h) -> f"rect {w}x{h}"
            .Empty -> "nothing"
        }
    }
}

type Dir = enum {
    North
    South

    func flip(self) -> Dir {
        return match self {
            .North -> .South
            .South -> .North
        }
    }
}

func pick(anon b: bool) -> Shape? {
    if b {
        return .Circle(r: 2)
    }
    return none
}

test "methods on a local, chained and with labels" {
    let s: Shape = .Rect(w: 2, h: 3)
    assert s.area() == 6
    assert s.scaled(by: 2).area() == 24
    assert s.bigger(than: .Circle(r: 1)) == true
    let shapes: [Shape] = [.Circle(r: 1), .Empty, s]
    mut total = 0
    for sh in shapes {
        total += sh.area()
    }
    assert total == 9
}

test "to_str in f-strings" {
    let s: Shape = .Rect(w: 2, h: 3)
    assert f"{s}" == "rect 2x3"
    assert f"[{s.scaled(by: 3)}] [{Shape.Empty}]" == "[rect 6x9] [nothing]"
    assert f"{Dir.North.flip()} {Dir.North.flip().flip()}" == "South North"
}

test "methods through ?. and on an imported enum" {
    assert (pick(true)?.area()? or -1) == 12
    assert (pick(false)?.area()? or -1) == -1
    let l: Level = .High(by: 3)
    assert l.weight() == 31
    assert l.weight(base: 2) == 7
    assert Level.Low.weight() == 10
}
