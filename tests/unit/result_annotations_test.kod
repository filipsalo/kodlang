// `T or Error` as an annotation, parameter, field, alias and return type.

type Oops = shared struct {
    message: str
    func to_str(self) -> str { return self.message }
}

type Outcome = int64 or Error

type Attempt = shared struct {
    label: str
    result: int64 or Error
}

func half(anon n: int64) -> int64 or Error {
    if n % 2 == 1 {
        throw Oops(message: f"{n} is odd")
    }
    return n / 2
}

func quarter(anon n: int64) -> Outcome {
    let h = try half(n)
    if h == 0 {
        throw Oops(message: "nothing left")
    }
    return try half(h)
}

func show(anon r: int64 or Error) -> str {
    match r {
        Ok(v) -> return f"ok {v}"
        Err(e) -> return f"err {e.to_str()}"
    }
}

test "results in annotations, aliases and fields" {
    let a: int64 or Error = half(4)
    assert show(a) == "ok 2"
    let b: Outcome = half(3)
    assert show(b) == "err 3 is odd"
    let t = Attempt(label: "six", result: half(6))
    assert f"{t.label}: {show(t.result)}" == "six: ok 3"
}

test "an alias as a return type" {
    assert show(quarter(8)) == "ok 2"
    assert show(quarter(6)) == "err 3 is odd"
    assert show(quarter(0)) == "err nothing left"
    assert must quarter(4) == 1
    if quarter(5) is Err(e) {
        assert e.to_str() == "5 is odd"
    } else {
        fail("quarter(5) succeeded")
    }
}
