// Python-style chained comparisons. `a < b < c` is `(a < b) and
// (b < c)` with `b` computed once. Mixed-op chains (`a < b == c`)
// also work; each link short-circuits independently.
func bang() -> int64 {
    fail("bang() called")
    return 0
}

test "chained comparisons" {
    // Basic 3-way chain.
    assert 1 < 2 < 3
    assert not (3 < 2 < 1)
    assert not (1 < 3 < 2)

    // 4-way chain.
    assert 1 < 2 < 3 < 4

    // Mixed operators.
    assert 1 <= 1 == 1
    assert 5 > 3 >= 3

    // Equality chain.
    let a: int64 = 42
    let b: int64 = 42
    let c: int64 = 42
    assert a == b == c
}

test "a chain short-circuits when its first link fails" {
    if 1 > 2 < bang() {
        fail("short-circuit: should not run")
    }
}
