// Arrays of bools, of arrays of ints and of arrays of strings.
func count_true(anon flags: [bool]) -> int64 {
    mut n = 0
    for f in flags {
        if f {
            n += 1
        }
    }
    return n
}

test "arrays of bools" {
    let flags: [bool] = [true, false, true]
    assert f"{flags[0]} {flags[1]}" == "true false"
    if flags[1] != false {
        fail("second is not false")
    }
    assert f"{count_true(flags)}" == "2"
    let more = [false, true]
    assert f"{more[1]} {len(flags + more)}" == "true 5"
}

test "arrays of int arrays" {
    let grid: [[int64]] = [[1, 2], [3]]
    mut rows: [str] = []
    for row in grid {
        mut total = 0
        for x in row {
            total += x
        }
        rows += [f"{len(row)} {total}"]
    }
    assert rows == ["2 3", "1 3"]
    assert f"{grid[0][1]} {grid[-1][0]}" == "2 3"
    let wider = grid + [[4, 5, 6]]
    assert f"{len(wider)} {wider[2][2]}" == "3 6"
    let head = grid[0..1]
    assert f"{len(head)} {head[0][0]}" == "1 1"
}

test "arrays of str arrays" {
    let words = [["a", "b"], ["c"]]
    assert words[0][1] + words[1][0] == "bc"
    mut all: [str] = []
    for ws in words {
        for w in ws {
            all += [w]
        }
    }
    assert all == ["a", "b", "c"]
}
