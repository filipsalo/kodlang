// A load the compiler makes once and reuses (docs/ir.md, step 13) must still
// see every change to what it read: a store between, through the same
// reference or another, a call, an append, a copy on write, a free, a loop's
// next time round, a branch that changed it. And where nothing changes, the
// reused value must be the right one. The pass runs only in functions that
// change an array in place, so each test does.

type Box = shared struct {
    n: int64
    xs: [int64]
    next: Box?
}

type Sorter = shared struct {
    xs: [int64]

    func swap(self, anon i: int64, anon j: int64) -> none {
        let t = self.xs[i]
        self.xs[i] = self.xs[j]
        self.xs[j] = t
    }

    func sort(self, anon lo: int64, anon hi: int64) -> none {
        if lo >= hi {
            return
        }
        let p = self.xs[(lo + hi) / 2]
        mut i = lo
        mut j = hi
        for i <= j {
            for self.xs[i] < p {
                i = i + 1
            }
            for self.xs[j] > p {
                j = j - 1
            }
            if i <= j {
                let t = self.xs[i]
                self.xs[i] = self.xs[j]
                self.xs[j] = t
                i = i + 1
                j = j - 1
            }
        }
        self.sort(lo, j)
        self.sort(i, hi)
    }
}

func bump(anon b: Box) -> none {
    b.n += 100
    b.xs += [7]
}

func same(anon b: Box) -> Box {
    return b
}

func noop(anon n: int64) -> int64 {
    return n
}

test "a field written between two reads, through the same reference" {
    let b = Box(n: 1, xs: [0], next: none)
    b.xs[0] = 1
    let first = b.n
    b.n = 2
    let second = b.n
    assert first == 1
    assert second == 2
}

test "a field written through another reference to the same struct" {
    let b = Box(n: 1, xs: [1, 2], next: none)
    let other = same(b)
    b.xs[0] = 3
    let first = b.n
    let len_before = len(b.xs)
    other.n = 5
    other.xs = [9]
    assert first == 1
    assert b.n == 5
    assert len_before == 2
    assert len(b.xs) == 1
    b.xs[0] = 9
    assert b.xs[0] == 9
}

test "a call between two reads" {
    let b = Box(n: 1, xs: [1], next: none)
    b.xs[0] = 1
    let a = b.n + len(b.xs)
    bump(b)
    let c = b.n + len(b.xs)
    assert a == 2
    assert c == 103
    assert b.xs[1] == 7
}

test "an append between two reads of the length and an element" {
    let b = Box(n: 0, xs: [5], next: none)
    b.xs[0] = 5
    let n0 = len(b.xs)
    let e0 = b.xs[0]
    b.xs += [6]
    let n1 = len(b.xs)
    let e1 = b.xs[n1 - 1]
    assert n0 == 1
    assert e0 == 5
    assert n1 == 2
    assert e1 == 6
}

test "an element stored, then the same element loaded" {
    let b = Box(n: 0, xs: [1, 2, 3], next: none)
    let i = noop(1)
    let before = b.xs[i]
    b.xs[i] = 20
    let after = b.xs[i]
    assert before == 2
    assert after == 20
    mut ys = [1, 2, 3]
    let y0 = ys[i]
    ys[i] = y0 + 40
    assert ys[i] == 42
}

test "an element of another index stored between" {
    let b = Box(n: 0, xs: [1, 2, 3], next: none)
    let i = noop(0)
    let j = noop(0)
    let before = b.xs[i]
    b.xs[j] = 10
    assert before == 1
    assert b.xs[i] == 10
}

test "a loop reads what the last time round wrote" {
    let b = Box(n: 0, xs: [0], next: none)
    mut seen: [int64] = []
    for k in 0..4 {
        seen += [b.n]
        b.n = b.n + k
        b.xs[0] = b.xs[0] + b.n
    }
    assert seen == [0, 0, 1, 3]
    assert b.n == 6
    assert b.xs[0] == 10
    // The same with an inner loop that only reads.
    mut total = 0
    for k in 0..3 {
        mut m = 0
        for m < len(b.xs) {
            total += b.xs[m]
            m += 1
        }
        b.xs[0] = k
    }
    assert total == 11
}

test "a branch that changes what the join reads" {
    for flag in [true, false] {
        let b = Box(n: 1, xs: [1, 2], next: none)
        let before = b.n + b.xs[1]
        if flag {
            b.n = 10
            b.xs[1] = 20
        } else {
            b.xs = [3, 4, 5]
        }
        let after = b.n + b.xs[1]
        assert before == 3
        if flag {
            assert after == 30
        } else {
            assert after == 5
            assert len(b.xs) == 3
        }
    }
}

test "copy on write: a shared array changed through one holder" {
    let b = Box(n: 0, xs: [1, 2, 3], next: none)
    let kept = b.xs
    let first = b.xs[0]
    b.xs[0] = 100
    b.xs[1] = 200
    assert first == 1
    assert kept == [1, 2, 3]
    assert b.xs == [100, 200, 3]
    mut xs = [4, 5]
    mut ys = xs
    let x0 = xs[0]
    ys[0] = 40
    ys[1] = 50
    assert x0 == 4
    assert xs == [4, 5]
    assert ys == [40, 50]
}

test "a read after a release freed what an earlier read went through" {
    let inner = Box(n: 7, xs: [1, 2, 3], next: none)
    let b = Box(n: 0, xs: [], next: inner)
    let n0 = b.next?.n? or -1
    let l0 = len(b.next?.xs? or [])
    b.next = Box(n: 8, xs: [4], next: none)
    let n1 = b.next?.n? or -1
    let l1 = len(b.next?.xs? or [])
    assert n0 == 7
    assert l0 == 3
    assert n1 == 8
    assert l1 == 1
    let c = Box(n: 0, xs: [1, 2, 3, 4], next: none)
    c.xs[3] = 4
    let e0 = c.xs[3]
    c.xs = [9, 9]
    assert e0 == 4
    assert len(c.xs) == 2
    assert c.xs[1] == 9
}

test "reused loads give the right values" {
    let s = Sorter(xs: [5, 1, 4])
    s.swap(0, 2)
    assert s.xs == [4, 1, 5]
    s.swap(1, 1)
    assert s.xs == [4, 1, 5]
    s.swap(-1, 0)
    assert s.xs == [5, 1, 4]
    // A shared array: the first store copies it, the second goes to the copy.
    let kept = s.xs
    s.swap(0, 1)
    assert kept == [5, 1, 4]
    assert s.xs == [1, 5, 4]
    mut xs: [int64] = []
    mut x: int64 = 12345
    for _ in 0..2000 {
        x = (x * 1103515245 + 12345) % 2147483648
        xs += [x % 1000]
    }
    let sorter = Sorter(:xs)
    sorter.sort(0, len(xs) - 1)
    mut before = 0
    mut after = 0
    for k in 0..len(xs) {
        before += xs[k]
        after += sorter.xs[k]
        if k > 0 {
            assert sorter.xs[k - 1] <= sorter.xs[k]
        }
    }
    assert before == after
}
