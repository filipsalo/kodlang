// Every chain's middle operands keep their own stack slot, so several chains
// in one function survive the calls that compare str values.
func bucket(anon w: str) -> int64 {
    if "a" <= w <= "c" { return 1 }
    if "d" <= w <= "f" { return 2 }
    if "g" <= w < "m" <= "n" { return 3 }
    return 0
}

func noisy(anon n: int64) -> int64 {
    print(f"noisy {n}")
    return n
}

func word(anon s: str) -> str {
    return s
}

func main() -> int64 {
    let a = "apple"
    let b = "apples"
    let z = "zebra"
    print(f"{a < b < z} {z < b < a} {a < z < b} {a < b < word("pear") < z}")
    if a < b < z { print("str chain 1") }
    if z > b > a { print("str chain 2") }
    if a <= word(a) < b < z { print("str chain 3") }
    if a < word("banana") < word("cherry") < "apex" { print("str chain BUG") } else { print("str chain 4") }
    print(f"{bucket("b")} {bucket("e")} {bucket("h")} {bucket("x")} {bucket("")}")
    let lo: int64 = 1
    let hi: int64 = 9
    let in1 = lo < noisy(5) < hi
    let in2 = lo < noisy(2) < noisy(3) < hi
    let in3 = hi < noisy(4) < lo
    print(f"{in1} {in2} {in3}")
    if lo <= noisy(1) < noisy(6) <= hi { print("int chain 1") }
    if 0 < noisy(7) < 8 < noisy(10) { print("int chain 2") }
    return 0
}

// expected output:
// true false false true
// str chain 1
// str chain 2
// str chain 3
// str chain 4
// 1 2 3 0 0
// noisy 5
// noisy 2
// noisy 3
// noisy 4
// true true false
// noisy 1
// noisy 6
// int chain 1
// noisy 7
// noisy 10
// int chain 2
