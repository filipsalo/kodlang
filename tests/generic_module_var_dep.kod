// Checked by tests/unit/generic_module_var_test.kod: a generic function that
// assigns this module's variables is compiled into the module that calls it.

mut _count: int64 = 0
mut _seen: [int64] = [0]

func note[T](anon x: T) -> int64 {
    _count += 1
    _seen += [_count]
    _seen[0] = _count
    _bump()
    return _count
}

// Small enough to be inlined into each instance of `note`.
func _bump() -> none {
    _seen += [-1]
}

func seen() -> [int64] {
    return _seen
}
