// The system's `gunzip` reads what `deflate.gzip` writes, stored, with fixed
// codes (a short input) and with dynamic codes (a long one), at a few levels.

import "compress/deflate"
import "io"
import "process"

func roundtrip(anon label: str, anon input: bytes, anon compressed: bytes) -> none {
    let path: str = f"/tmp/kod_gzip_{label}.gz"
    let rc: int64 = io.write_file(path, kod_bytes_to_str(compressed))
    if rc != 0 {
        print(f"{label}: write failed")
        return none
    }
    let r: process.ProcessResult = process.run(["gunzip", "-c", path])
    if r.status != 0 {
        print(f"{label}: gunzip failed")
        return none
    }
    if kod_str_to_bytes(r.stdout) == input {
        print(f"{label}: ok")
    } else {
        print(f"{label}: mismatch")
    }
}

func main() -> int64 {
    let short: bytes = b"The quick brown fox jumps over the lazy dog."
    mut long = ""
    for i in 0..3000 {
        long += f"{i} {i * i % 1000} fox dog "
    }
    let input = kod_str_to_bytes(long)
    roundtrip("stored", short, deflate.gzip(short, level: 0))
    roundtrip("short", short, deflate.gzip(short))
    roundtrip("level1", input, deflate.gzip(input, level: 1))
    roundtrip("level6", input, deflate.gzip(input))
    roundtrip("level9", input, deflate.gzip(input, level: 9))
    return 0
}

// expected output:
// stored: ok
// short: ok
// level1: ok
// level6: ok
// level9: ok
// expected status:
// 0
