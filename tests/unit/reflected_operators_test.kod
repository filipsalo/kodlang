// The right operand's op_r* method is called whenever the left operand has
// no method for the operator, whatever the left operand's type.

type Vec = shared struct {
    x: float64
    y: float64

    func op_rmul(self, k: float64) -> Vec {
        return Vec(x: self.x * k, y: self.y * k)
    }

    func op_radd(self, s: str) -> str {
        return f"{s}({self.x}, {self.y})"
    }
}

type Scale = shared struct {
    k: int64
}

type Grid = shared struct {
    n: int64

    func op_rmul(self, s: Scale) -> Grid {
        return Grid(n: self.n * s.k)
    }

    func op_rdiv(self, s: Scale) -> int64 {
        return s.k / self.n
    }
}

// The left operand's own method wins, even over a reflected one on the right.
type Left = shared struct {
    n: int64

    func op_sub(self, g: Grid) -> str {
        return "Left.op_sub"
    }
}

type Mark = enum {
    On
    Off
}

type Count = shared struct {
    n: int64

    func op_rmod(self, m: Mark) -> int64 {
        return match m {
            .On -> self.n
            .Off -> 0
        }
    }

    func op_rsub(self, b: bool) -> int64 {
        if b {
            return self.n
        }
        return -self.n
    }
}

type Total = shared struct {
    n: int64

    func op_rsub(self, g: Grid) -> str {
        return "Total.op_rsub"
    }
}

test "reflected operators on primitives on the left" {
    let v = 2.0 * Vec(x: 1.0, y: 2.5)
    assert f"{v.x} {v.y}" == "2.0 5.0"
    assert "v" + Vec(x: 1.0, y: 2.0) == "v(1.0, 2.0)"
}

test "reflected operators on structs on the left" {
    let g = Scale(k: 3) * Grid(n: 4)
    assert g.n == 12
    assert Scale(k: 12) / Grid(n: 4) == 3
}

test "the left operand's own method wins" {
    assert Left(n: 1) - Grid(n: 2) == "Left.op_sub"
    assert Grid(n: 1) - Total(n: 2) == "Total.op_rsub"
}

test "reflected operators on enums and bools on the left" {
    assert Mark.On % Count(n: 7) == 7
    assert Mark.Off % Count(n: 7) == 0
    assert true - Count(n: 5) == 5
    assert false - Count(n: 5) == -5
}
