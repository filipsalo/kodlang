// `<`, `<=`, `>` and `>=` on two str or bytes values compare contents byte by byte.

test "str ordering" {
    let a = "zebra"
    let b = "apple"
    assert f"{a < b} {b < a} {a > b} {a >= b} {b <= a}" == "false true true true true"
    let c = "apples"
    assert f"{b < c} {c < b} {b <= b} {b >= b} {b < b}" == "true false true true false"
    assert f"{b < c < a} {"" < b} {"é" > "z"}" == "true true true"
}

test "bytes ordering" {
    let x = b"ab"
    let y = b"b"
    assert f"{x < y} {x > y} {x <= x}" == "true false true"
}

test "sorting with >" {
    mut words = ["pear", "fig", "apple"]
    mut swapped = true
    for swapped {
        swapped = false
        mut i = 0
        for i + 1 < len(words) {
            if words[i] > words[i + 1] {
                let t = words[i]
                words[i] = words[i + 1]
                words[i + 1] = t
                swapped = true
            }
            i = i + 1
        }
    }
    assert words == ["apple", "fig", "pear"]
}
