// `for x in v` on a struct with `values(self) -> [T]`.

type Bag = shared struct {
    xs: [str] = []

    func values(self) -> [str] {
        return self.xs
    }
}

type Pair = struct {
    a: int64
    b: int64

    func values(self) -> [int64] {
        return [self.a, self.b]
    }
}

test "a struct with values() is iterated" {
    let bag = Bag(xs: ["a", "b"])
    mut out = ""
    for s in bag {
        out += s
    }
    assert out == "ab"
    mut total = 0
    for x in Pair(a: 3, b: 4) {
        total += x
    }
    assert total == 7
    assert [x + 1 for x in Pair(a: 1, b: 2)] == [2, 3]
}
