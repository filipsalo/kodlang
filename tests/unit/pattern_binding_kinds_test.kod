// Pattern bindings take their kinds from the matched variant.

type Val = enum {
    I(value: int64)
    S(value: str)
}

type Other = enum {
    Named(id: int64)
}

type Item = enum {
    Named(label: str)
    Count(n: int64)
}

type Box = shared struct {
    id: int64
    name: str
}

func describe(anon v: Val) -> str {
    match v {
        .I(value) -> return f"int {value}"
        .S(value) -> return f"str {value}"
    }
}

func describe_expr(anon v: Val) -> str {
    let d: str = match v {
        .I(value) -> f"int {value}"
        .S(value) -> f"str {value}"
    }
    return d
}

func show_items(anon items: [Item]) -> [str] {
    mut out: [str] = []
    for o in items {
        match o {
            .Named(label) -> out += [f"named {label}"]
            .Count(n) -> out += [f"count {n}"]
        }
    }
    return out
}

func show_boxes(anon boxes: [Box?]) -> [str] {
    mut out: [str] = []
    for o in boxes {
        match o {
            Some(b) -> out += [b.name]
            none -> out += ["empty"]
        }
    }
    for o in boxes {
        let .Some(b) = o else { continue }
        out += [f"let-else {b.name}"]
    }
    return out
}

test "bindings in match statements and expressions" {
    assert describe(Val.I(value: 7)) == "int 7"
    assert describe(Val.S(value: "seven")) == "str seven"
    assert describe_expr(Val.S(value: "eight")) == "str eight"
}

test "bindings in a for loop and an is test" {
    assert show_items([Item.Named(label: "first"), Item.Count(n: 2)]) == ["named first", "count 2"]
    let o: Other = Other.Named(id: 1)
    if o is .Named(id) {
        assert f"other {id}" == "other 1"
    } else {
        fail("o is not named")
    }
}

test "bindings from optional structs" {
    let full: Box? = Box(id: 1, name: "boxed")
    assert show_boxes([full, none]) == ["boxed", "empty", "let-else boxed"]
}
