// Enums with and without payloads: construction, `==` and `match`.
type Direction = enum {
    North
    South
}

type Message = enum {
    Text(content: str)
    Number(value: int64)
}

test "comparing a payloadless variant" {
    let d: Direction = Direction.North
    assert d == Direction.North
}

test "matching variants with payloads" {
    let m: Message = Message.Text(content: "hello")
    match m {
        Message.Text(content) -> assert content == "hello"
        Message.Number(_value) -> fail("Number")
    }

    let m2: Message = Message.Number(value: 42)
    match m2 {
        Message.Text(_content) -> fail("Text")
        Message.Number(value) -> assert value == 42
    }
}
