// The interpreter reports a function a module both declares and imports.
import "./import_name_twice_pb" { shift }

func shift(anon x: int64) -> int64 {
    return x + 1
}

func main() -> int64 {
    print(f"{shift(1)}")
    return 0
}

// expected status:
// 1
// expected stderr:
// 4:6: error: `shift` is already imported on line 2
// expected mode:
// interpret
