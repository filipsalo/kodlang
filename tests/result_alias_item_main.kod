// main declared with an alias of `T or Error` listed in the import.
import "./result_alias_dep"
import "./result_alias_dep" { Outcome }

func half(anon n: int64) -> Outcome {
    if n % 2 != 0 {
        throw result_alias_dep.Oops(message: f"{n} is odd")
    }
    return n / 2
}

func main() -> Outcome {
    if half(3) is Err(e) {
        print(f"caught {e.to_str()}")
    }
    let a = try half(8)
    print(f"half {a}")
    return a
}

// expected output:
// caught 3 is odd
// half 4
// expected status:
// 4
