// Outside where a local is bound, its name means the function of that
// name, both as a value and in a call.
func f() -> int64 {
    return 1
}

func one() -> int64 {
    return 1
}

func twice(anon x: int64) -> int64 {
    return x * 2
}

func apply(anon g: func(int64) -> int64, anon x: int64) -> int64 {
    return g(x)
}

test "a local's name means the function outside its scope" {
    if true {
        let f = func() -> int64 {
            return 2
        }
        assert f() == 2
        let g = f
        assert g() == 2
    }
    assert f() == 1
    let g = f
    assert g() == 1
    mut n = 0
    for k in [1] {
        let twice = func(anon x: int64) -> int64 {
            return x * 100
        }
        n += apply(twice, k)
    }
    n += apply(twice, 1)
    assert n == 102
    let z = one
    let one = 7
    assert z() + one == 8
    mut label = "other"
    if n > 0 {
        label = "positive"
    }
    assert label == "positive"
}
