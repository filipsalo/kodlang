// `?.` short-circuit field access and method calls on a `T?` struct.

type Point = shared struct {
    x: int64
    y: int64

    func magnitude_sq(self) -> int64 {
        return self.x * self.x + self.y * self.y
    }
}

func origin_or(anon given: Point?, set: bool) -> Point? {
    mut p = given
    if set {
        p = Point(x: 3, y: 4)
    }
    return p
}

type Tag = shared struct {
    name: str
}

func tag_name(anon t: Tag?) -> str? {
    return t?.name
}

func tag_name_or_dash(anon t: Tag?) -> str {
    return t?.name? or "-"
}

test "?. on a field" {
    let present: Point? = origin_or(none, set: true)
    let missing: Point? = origin_or(none, set: false)

    // Present: x?.x is Some(3).
    let xp: int64? = present?.x
    match xp {
        Some(v) -> assert v == 3
        none -> fail("missing")
    }

    // Missing: x?.x is none — the field is never read.
    let xm: int64? = missing?.x
    match xm {
        Some(v) -> fail(f"got {v}")
        none -> {}
    }

    // Unwrap chains compose with postfix `?` for a final default.
    let yp: int64 = present?.y? or -1
    assert yp == 4

    let ym: int64 = missing?.y? or -1
    assert ym == -1
}

test "?. on a method call" {
    let present: Point? = origin_or(none, set: true)
    let missing: Point? = origin_or(none, set: false)

    // Method call: present?.magnitude_sq() is Some(25).
    match present?.magnitude_sq() {
        Some(v) -> assert v == 25
        none -> fail("missing")
    }

    // Method call short-circuits on none.
    match missing?.magnitude_sq() {
        Some(v) -> fail(f"got {v}")
        none -> {}
    }
}

test "?. returning a str field" {
    let tag: Tag? = Tag(name: "red")
    assert (tag_name(tag)? or "none") == "red"
    assert (tag_name(none)? or "none") == "none"
    assert tag_name_or_dash(tag) == "red"
    assert tag_name_or_dash(none) == "-"
}
