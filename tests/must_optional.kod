// `must x` on a `T?`: the `T`, or a stop at the `none`.

type User = struct {
    name: str
    nick: str?
}

func find(anon id: int64) -> User? {
    if id < 0 {
        return none
    }
    return User(name: f"user{id}", nick: f"n{id}")
}

func twice(anon n: int64) -> int64 {
    return n * 2
}

func main() -> int64 {
    let n: int64? = 4
    let a = must n
    print(a + 1)
    print(twice(must n))
    print((must find(1)).name)
    print(must find(2)?.nick)
    print(must "a,b".find(","))
    let m = Map[str, int64]()
    m.set("k", 9)
    print(must m.get("k"))
    let missing: int64? = none
    print(must missing)
    print("not reached")
    return 0
}

// expected output:
// 5
// 8
// user1
// n2
// 1
// 9
// expected stderr:
// must on none
// expected status:
// 1
