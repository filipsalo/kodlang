// `mut` parameters: what the callee assigns reaches the caller's variable.
type Stop = shared struct {
    message: str

    func to_str(self) -> str {
        return self.message
    }
}

type Counter = shared struct {
    n: int64 = 0

    func add_to(self, anon s: str, mut seen: [str]) -> none {
        seen += [s]
        self.n += 1
    }
}

func bump(anon mut x: int64) -> none {
    x = x + 1
}

func count(anon s: str, mut seen: [str]) -> int64 {
    seen += [s]
    return len(seen)
}

func replace(mut xs: [int64]) -> none {
    xs = [7, 8, 9]
    xs[0] = 6
}

func rename(mut name: str, suffix: str) -> none {
    name = name + suffix
}

func both(mut a: [int64], mut b: [int64]) -> none {
    a += [1]
    b += [2]
    count_through(xs: mut a)
}

func count_through(mut xs: [int64]) -> none {
    xs += [len(xs)]
}

func early(anon stop: bool, mut xs: [int64]) -> int64 {
    xs += [1]
    if stop {
        return -1
    }
    xs += [2]
    return len(xs)
}

func fails(anon fail: bool, mut log: [str]) -> int64 or Error {
    log += ["start"]
    if fail {
        throw Stop(message: "no")
    }
    log += ["end"]
    return 1
}

func outer(mut log: [str]) -> int64 or Error {
    let r = try fails(true, log: mut log)
    log += ["unreached"]
    return r
}

test "mut int and str parameters" {
    mut n = 1
    bump(mut n)
    bump(mut n)
    assert n == 3

    mut name = "kod"
    rename(name: mut name, suffix: "lang")
    assert name == "kodlang"
}

test "mut array parameters" {
    mut seen: [str] = []
    assert count("a", seen: mut seen) == 1
    assert count("b", seen: mut seen) == 2
    assert seen == ["a", "b"]

    mut xs = [1]
    replace(xs: mut xs)
    assert xs == [6, 8, 9]

    mut a: [int64] = []
    mut b: [int64] = []
    both(a: mut a, b: mut b)
    assert a == [1, 1]
    assert b == [2]
}

test "mut parameters written back on an early return or a throw" {
    mut e: [int64] = []
    assert early(true, xs: mut e) == -1
    assert e == [1]
    assert early(false, xs: mut e) == 3
    assert e == [1, 1, 2]

    mut log: [str] = []
    if outer(log: mut log) is Error(err) {
        assert f"{err}" == "no"
        assert log == ["start"]
    } else {
        fail("outer succeeded")
    }
}

test "a mut parameter to a method" {
    let c = Counter()
    mut words: [str] = []
    for w in ["x", "y"] {
        c.add_to(w, seen: mut words)
    }
    assert c.n == 2
    assert words == ["x", "y"]
}
