type NotFound = struct {
    key: str

    func to_str(self) -> str {
        return f"not found: {self.key}"
    }
}

type BadInput = struct {
    pos: int64

    func to_str(self) -> str {
        return f"bad input at {self.pos}"
    }
}

func find(anon key: str) -> int64 or Error {
    if key == "" {
        throw BadInput(pos: 0)
    }
    if key != "a" {
        throw NotFound(:key)
    }
    return 1
}

func failure(anon key: str) -> Error {
    match find(key) {
        Ok(_v) -> return NotFound(key: "none")
        Err(e) -> return e
    }
}

