// A default argument in another module that calls an unknown function is
// reported in that module, though this module declares a function of that name.
// Checked by tests/compile_errors_test.kod.
import "./xmod_default_unknown_dep"

func nowhere() -> int64 {
    return 2
}

func main() -> int64 {
    return xmod_default_unknown_dep.f()
}

// expected mode:
// skip
