// An array literal on the left of `+` is built as the right operand's element type.
interface Shape {
    func area(self) -> int64
}
type Sq = struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type A = enum {
    Hit(n: int64)
    Miss
}
type B = enum {
    Miss
    Hit(n: int64)
}
type Maybe[T] = enum {
    Just(value: T)
    Nothing
}
func show_b(anon b: B) -> str {
    return match b {
        .Miss -> "miss"
        .Hit(n) -> f"hit {n}"
    }
}
func show_m(anon m: Maybe[str]) -> str {
    return match m {
        .Just(value) -> f"just {value}"
        .Nothing -> "nothing"
    }
}
func main() -> int64 {
    let ms: [Maybe[str]] = [.Nothing]
    let ys = [.Just(value: "z")] + ms
    for m in ys {
        print(show_m(m))
    }
    let bs: [B] = [.Miss]
    let ds = [.Hit(n: 3)] + bs
    for d in ds {
        print(show_b(d))
    }
    let shapes: [Shape] = [Sq(s: 2)]
    let zs = [Sq(s: 3)] + shapes
    for z in zs {
        print_int(z.area())
    }
    print_int(len([Sq(s: 5)] + shapes))
    return 0
}

// expected output:
// just z
// nothing
// hit 3
// miss
// 9
// 4
// 2
