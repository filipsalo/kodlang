// Running code under a deterministic simulation (docs/simulation.md): the
// scheduler, clock and network it uses are in stdlib/tasks.kod and
// stdlib/net/tcp.kod; this is where a test asks for one.
import "env"
import "panics"
import "tasks"
import "time" { Time }

// 2026-01-01 00:00:00 UTC, in nanoseconds: where a simulation's calendar
// starts unless told.
let DEFAULT_START_NS: int64 = 1767225600000000000

// The digest of the last run that ended.
mut _last_digest: int64 = 0

func simulating() -> bool {
    return tasks.simulating()
}

func seed() -> int64 {
    return tasks.sim_seed()
}

func digest() -> int64 {
    return _last_digest
}

// Runs `body` under the seeds from `from`, `count` of them (KOD_SIM_SEEDS, when
// set, instead), one after another, the calendar at `start`; the first that
// fails ends it with a panic that names its seed.
func run(count: int64 = 100, from: int64 = 0, start: Time? = none, body: func() -> none) -> none {
    mut n = count
    if env.get("KOD_SIM_SEEDS") is str(text) {
        n = text.parse_int()? or count
    }
    for s in from..from + n {
        if one(s, body, :start) is panics.Panic(p) {
            panic(f"simulation: seed {s} failed: {p.message}\n{p.backtrace}")
        }
    }
}

// Runs `body` under `seed` alone; a panic in it goes on as it was.
func replay(anon seed: int64, start: Time? = none, body: func() -> none) -> none {
    if one(seed, body, :start) is panics.Panic(p) {
        panics.again(p)
    }
}

// `body` under `seed`: the panic that stopped it, or none.
func one(anon seed: int64, anon body: func() -> none, start: Time?) -> panics.Panic? {
    mut epoch = DEFAULT_START_NS
    if start is Time(t) {
        epoch = t.seconds * 1000000000 + t.nanos
    }
    tasks.sim_begin(seed, epoch_ns: epoch)
    let failed = panics.run(body)
    _last_digest = tasks.sim_end()
    return failed
}
