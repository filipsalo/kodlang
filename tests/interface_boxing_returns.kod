// A struct returned as an interface's Ok or Some, or stored through op_index_set, is boxed.
interface Animal {
    func name(self) -> str
}

type Cat = struct {
    n: str
    func name(self) -> str { return self.n }
}

func mk() -> Animal or Error {
    return Cat(n: "res-cat")
}

func mko() -> Animal? {
    return Cat(n: "opt-cat")
}

func main() -> int64 {
    let a = must mk()
    print(a.name())
    match mko() {
        Some(b) -> print(b.name())
        none -> print("none")
    }
    let m: Map[str, Animal] = Map[str, Animal]()
    m.set("a", Cat(n: "via-set"))
    match m.get("a") {
        Some(v) -> print(v.name())
        none -> print("miss a")
    }
    m["b"] = Cat(n: "via-index")
    match m.get("b") {
        Some(v) -> print(v.name())
        none -> print("miss b")
    }
    return 0
}

// expected output:
// res-cat
// opt-cat
// via-set
// via-index
