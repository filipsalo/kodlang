// For tests/unit/struct_fields_test.kod: a struct with a private field.
type Token = struct {
    _secret: int64
    shown: str

    func init(anon n: int64) -> Token {
        return Token(_secret: n, shown: f"t{n}")
    }
}

func make_token(anon n: int64) -> Token {
    return Token(n)
}

func token_key(anon t: Token) -> int64 {
    return hash(t)
}

