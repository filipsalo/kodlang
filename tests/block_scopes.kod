// Every block has its own scope: a binding may hide one still in force,
// whatever kind either is, and the hidden one is back after the block with
// its own value, type and mutability.
import "./alias_local_dep"

type A = struct {
    x: int64

    func show(self) -> str {
        return f"A{self.x}"
    }

    func swap(self, anon flag: bool) -> str {
        if flag {
            let self = B(x: self.x + 1)
            return self.show()
        }
        return self.show()
    }
}

type B = struct {
    x: int64

    func show(self) -> str {
        return f"B{self.x}"
    }
}

interface Shape {
    func area(self) -> int64
}

type Pt = struct {
    x: int64

    func area(self) -> int64 {
        return self.x
    }
}

func pick(anon n: int64) -> int64? {
    if n > 0 {
        return n
    }
    return none
}

func param(anon item: A, anon flag: bool) -> str {
    if flag {
        let item = B(x: 9)
        return item.show()
    }
    return item.show()
}

func levels(anon n: int64) -> str {
    mut x = 1
    mut out = ""
    if n > 0 {
        let x = "two"
        out += x
        if n > 1 {
            mut x = 3
            x += 1
            out += f"{x}"
        }
        out += x
    }
    x = x + 10
    return f"{out} {x}"
}

func siblings(anon n: int64) -> int64 {
    let v = 100
    mut total = 0
    if n > 0 {
        let v = "abc"
        total += len(v)
    }
    if n > 1 {
        let v = n * 2
        total += v
    }
    return total + v
}

func sibling_mut(anon n: int64) -> str {
    mut a = 0
    mut out = ""
    if n > 5 {
        let a = 7
        out += f"{a} "
    }
    for a in [1, 2] {
        a = a * 10
        out += f"{a} "
    }
    match pick(n) {
        Some(a) -> {
            a += 100
            out += f"{a} "
        }
        none -> out += "none "
    }
    a = a + 1
    return f"{out}{a}"
}

func loop_break(anon xs: [int64]) -> int64 {
    let x = 7
    mut seen = 0
    for v in xs {
        let x = v * 10
        if x > 20 {
            break
        }
        seen += x
    }
    return seen + x
}

func loops(anon x: [str]) -> int64 {
    mut sum = 0
    for x in x {
        for x in [1, 2] {
            sum += x
        }
        sum += len(x) * 10
    }
    return sum + len(x)
}

func if_is(anon o: int64?) -> int64 {
    if o is Some(o) {
        return o + 1
    } else {
        print(f"{o is none}")
    }
    return 0
}

func arms(anon v: int64?) -> str {
    let w = "outer"
    match v {
        Some(w) -> {
            if w > 3 {
                let w = f"big{w}"
                return w
            }
            return f"small{w}"
        }
        none -> return w
    }
}

func let_else(anon v: int64?) -> str {
    let s = "start"
    if true {
        let .Some(s) = v else {
            return f"none after {s}"
        }
        return f"got {s}"
    }
    return s
}

func match_values(anon v: int64?) -> int64 {
    let q = 5
    let r = match v {
        Some(q) -> match pick(q - 1) {
            Some(q) -> q * 100
            none -> q
        }
        none -> q
    }
    return r + q
}

func alias(anon flag: bool) -> int64 {
    let dep = A(x: 1)
    if flag {
        let dep = dep.x + 1
        return dep
    }
    return dep.x
}

func alias_back() -> int64 {
    return alias_local_dep.value()
}

func label(x: int64) -> str {
    return f"x={x}"
}

func args(anon x: int64) -> str {
    mut out = label(:x)
    if x > 0 {
        mut x = x * 10
        x += 1
        out += f" {label(:x)} {x}"
    }
    return out
}

func downcast(anon s: Shape, anon Pt: int64) -> str {
    if Pt > 0 {
        let Pt = 7
        if s is Pt {
            return f"is Pt {Pt}"
        }
    }
    return f"{Pt}"
}

func under(anon a: int64?, anon b: int64?) -> int64 {
    match a {
        .Some(_) -> {
            match b {
                .Some(_) -> return 1
                else -> return 2
            }
        }
        else -> return 3
    }
}

func main() -> int64 {
    print(A(x: 1).swap(true))
    print(A(x: 1).swap(false))
    print(param(A(x: 1), true))
    print(param(A(x: 1), false))
    print(levels(0))
    print(levels(1))
    print(levels(2))
    print_int(siblings(2))
    print(sibling_mut(1))
    print(sibling_mut(9))
    print_int(loop_break([1, 2, 3]))
    print_int(loops(["a", "bb"]))
    print_int(if_is(4))
    print_int(if_is(none))
    print(arms(5))
    print(arms(2))
    print(arms(none))
    print(let_else(7))
    print(let_else(none))
    print_int(match_values(4))
    print_int(match_values(1))
    print_int(match_values(none))
    print_int(alias(true))
    print_int(alias(false))
    print_int(alias_back())
    print(args(2))
    print(downcast(Pt(x: 2), 1))
    print(downcast(Pt(x: 2), 0))
    print_int(under(1, 2))
    print_int(under(1, none))
    print_int(under(none, 1))
    return 0
}

// expected output:
// B2
// A1
// B9
// A1
//  11
// twotwo 11
// two4two 11
// 107
// 10 20 101 1
// 7 10 20 109 1
// 37
// 38
// 5
// true
// 0
// big5
// small2
// outer
// got 7
// none after start
// 305
// 6
// 10
// 2
// 1
// 1
// x=2 x=21 21
// is Pt 7
// 0
// 1
// 2
// 3
