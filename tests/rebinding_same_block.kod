// A block may bind a name again itself, and so may a block after one
// whose binding of the name has ended.
func twice(anon n: int64) -> int64 {
    let n = n * 2
    return n
}

func main() -> int64 {
    let x = 1
    let x = x + 1
    print_int(x)
    if x > 0 {
        let y = "first"
        print(y)
    }
    if x > 1 {
        let y = 3
        print_int(y)
    }
    for s in ["a", "b"] {
        let s = s + "!"
        print(s)
    }
    for s in [10] {
        print_int(s)
    }
    let o: int64? = 4
    match o {
        Some(v) -> {
            let v = v + 1
            print_int(v)
        }
        none -> print("none")
    }
    print_int(twice(4))
    return 0
}

// expected output:
// 2
// first
// 3
// a!
// b!
// 10
// 5
// 8
