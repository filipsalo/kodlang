// `return` of a call that never returns needs no value of the function's
// type, whether the callee is a function, a method or an imported
// module's function.
import "./return_diverging_call_dep"

type Reader = struct {
    v: int64

    func fail(self, anon msg: str) -> none {
        kod_panic(msg)
    }

    func get(self) -> int64 {
        if self.v >= 0 {
            return self.v
        }
        return self.fail("negative value")
    }
}

func die(anon msg: str) -> none {
    kod_panic(msg)
}

func checked(anon n: int64) -> int64 {
    if n >= 0 {
        return n
    }
    return die("negative")
}

func doubled(anon n: int64) -> int64 {
    if n >= 0 {
        return n * 2
    }
    return return_diverging_call_dep.die("negative")
}

func label(anon n: int64) -> str {
    let s = match n {
        1 -> "one"
        else -> return_diverging_call_dep.die("not one")
    }
    return s
}

func main() -> int64 {
    print_int(checked(1))
    print_int(Reader(v: 2).get())
    print_int(doubled(3))
    print(label(1))
    print_int(Reader(v: -1).get())
    return 0
}

// expected output:
// 1
// 2
// 6
// one
// expected status:
// 1
// expected stderr:
// panic: negative value
