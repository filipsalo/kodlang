// After `if x is ...`, `x` has the type the test proves in the block that runs.
interface Shape {
    func area(self) -> int64
}
type Circle = struct {
    r: int64

    func area(self) -> int64 {
        return 3 * self.r * self.r
    }
}
type Square = struct {
    s: int64

    func area(self) -> int64 {
        return self.s * self.s
    }
}
type Id = int64 | str

func circle_r(anon shape: Shape) -> int64 {
    if shape is Circle {
        return shape.r
    }
    return -1
}

// `is none` narrows the `else`, which can narrow again.
func id_text(anon id: Id | none) -> str {
    if id is none {
        return "none"
    } else if id is int64 {
        return f"int {id + 1}"
    } else if id is str {
        return f"str {len(id)}"
    }
    return "unreachable"
}

func plus_one(anon n: int64?) -> int64 {
    if n is not none {
        return n + 1
    }
    return 0
}

func chained(anon n: int64?) -> bool {
    if n is not none and n > 3 {
        return true
    }
    return false
}

func doubled(anon n: int64?) -> int64 {
    if n is Some {
        return n * 2
    }
    return 0
}

func not_square(anon s: Shape) -> str {
    if s is not Square {
        return "not a square"
    } else {
        return f"square {s.s}"
    }
}

func result_value(anon r: int64 or Error) -> int64 {
    if r is Ok {
        return r + 1
    }
    return 0
}

// A block that assigns to the name doesn't narrow it.
func reassigned(anon n: int64?) -> int64 {
    mut m = n
    if m is not none {
        m = none
        return 1
    }
    return 0
}

// After the block, the name has its declared type again.
func outside(anon n: int64?) -> str {
    if n is not none {
        print_int(n)
    }
    return f"{n is none}"
}

// An early exit narrows the rest of its block.
func total(anon xs: [int64?], limit: int64 or Error) -> int64 {
    if limit is Err(e) {
        print(e.to_str())
        return 0
    }
    mut sum = 0
    for x in xs {
        if x is none {
            continue
        }
        sum += x
    }
    if sum > limit {
        return limit
    }
    return sum
}

func circle_or(anon s: Shape) -> int64 {
    if s is not Circle {
        return -1
    }
    return s.r
}

func both(anon a: int64?, anon b: int64?) -> int64 {
    if a is none {
        return 0
    }
    if b is none {
        return a
    }
    return a + b
}

// A rest that assigns the name isn't narrowed.
func assigned_after(anon n: int64?) -> str {
    mut m = n
    if m is none {
        return "none"
    }
    m = none
    return f"{m is none}"
}

// A call that never returns ends the block as an exit does.
func die() -> none {
    panic("no value")
}

func helper_exit(anon n: int64?) -> int64 {
    if n is none {
        die()
    }
    return n
}

func main() -> int64 {
    print_int(helper_exit(3))
    print_int(total([1, none, 3], limit: .Ok(value: 10)))
    print_int(total([7, 8], limit: .Ok(value: 10)))
    print_int(circle_or(Circle(r: 4)))
    print_int(circle_or(Square(s: 4)))
    print_int(both(1, 2))
    print_int(both(5, none))
    print_int(both(none, 2))
    print(assigned_after(1))
    print_int(circle_r(Circle(r: 3)))
    print_int(circle_r(Square(s: 1)))
    print(id_text(none))
    print(id_text(4))
    print(id_text("ab"))
    print_int(plus_one(5))
    print_int(plus_one(none))
    print(f"{chained(5)} {chained(2)} {chained(none)}")
    print_int(doubled(4))
    print(not_square(Circle(r: 1)))
    print(not_square(Square(s: 2)))
    print_int(result_value(.Ok(value: 4)))
    print_int(reassigned(1))
    print(outside(7))
    return 0
}

// expected output:
// 3
// 4
// 10
// 4
// -1
// 3
// 5
// 0
// true
// 3
// -1
// none
// int 5
// str 2
// 6
// 0
// true false false
// 8
// not a square
// square 2
// 5
// 1
// 7
// false
