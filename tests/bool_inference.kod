// Comparisons, `and`/`or` and `is` produce a bool.

func presence(anon o: int64?) -> none {
    let w = o is not none
    print(f"{w} {o is none}")
}

func main() -> int64 {
    let u = 3 == 3
    let v = true and false
    print(f"{u} {v}")
    print(f"{1 == 1} {2 < 1} {1 != 1} {2 >= 2}")
    let c = 1 < 2 < 3
    let o = false or u
    print(f"{c} {o.to_str()}")
    presence(5)
    presence(none)
    return 0
}

// expected output:
// true false
// true false false true
// true true
// true false
// false true
// expected status:
// 0
