// Arrays are values: assigning shares, changing copies.
type Holder = shared struct {
    xs: [int64]
}

type Point = shared struct {
    x: int64
}

func total(anon xs: [int64]) -> int64 {
    mut sum = 0
    for x in xs {
        sum += x
    }
    return sum
}

func fill(anon n: int64, mut xs: [int64]) -> none {
    for i in 0..n {
        xs += [i]
    }
}

test "assigning shares, changing copies, fields have their own" {
    mut xs = [1, 2, 3]
    let a = xs
    xs[0] = 10
    xs += [4]
    assert a == [1, 2, 3]
    assert xs == [10, 2, 3, 4]

    // A field has its own array, both ways.
    let h = Holder(:xs)
    h.xs[1] = 20
    xs[2] = 30
    assert h.xs == [10, 20, 3, 4]
    assert xs == [10, 2, 30, 4]
}

test "elements are values at any depth" {
    mut grid = [[0, 0], [0, 0]]
    let row = grid[0]
    mut copy = grid
    grid[0][1] = 5
    grid[1] += [7]
    assert grid == [[0, 5], [0, 0, 7]]
    assert row == [0, 0]
    assert copy == [[0, 0], [0, 0]]
    copy[1][0] = 9
    assert grid == [[0, 5], [0, 0, 7]]
    assert copy == [[0, 0], [9, 0]]
}

test "rows made by * are separate" {
    mut rows = [[0] * 2] * 3
    rows[1][0] = 1
    assert rows == [[0, 0], [1, 0], [0, 0]]
}

test "a loop goes over the array as it was when it started" {
    mut ys = [1, 2]
    for y in ys {
        ys += [y * 10]
        ys[0] = 0
    }
    assert ys == [0, 2, 10, 20]
}

test "a map keeps the array it was given" {
    mut m = Map[str, [int64]]()
    mut zs = [1]
    m.set("k", zs)
    zs += [2]
    assert (m.get("k")? or []) == [1]
    assert zs == [1, 2]
}

test "a mut parameter changes the caller's own array" {
    mut big: [int64] = []
    fill(5, xs: mut big)
    let before = big
    fill(2, xs: mut big)
    assert total(before) == 10
    assert total(big) == 11
    assert len(before) == 5
    assert len(big) == 7
}

test "a loop that keeps the array each time keeps each version" {
    mut counts = [0, 0, 0]
    mut versions: [[int64]] = []
    for i in 0..3 {
        counts[i] = i + 1
        let now = counts
        versions += [now]
    }
    assert versions == [[1, 0, 0], [1, 2, 0], [1, 2, 3]]
    mut marks = [false] * 4
    for k in 0..4 {
        marks[k] = true
    }
    assert marks == [true, true, true, true]
}

test "a loop reads a field's array while it changes other fields" {
    let hold = Holder(xs: [3, 1, 4, 1, 5])
    let scan = Point(x: 0)
    mut at = 0
    for at < len(hold.xs) and hold.xs[at] != 4 {
        scan.x += hold.xs[at]
        at += 1
    }
    assert at == 2
    assert scan.x == 4
}

test "an array of structs holds the same structs" {
    let p = Point(x: 1)
    let ps = [p]
    p.x = 2
    assert ps[0].x == 2
}
