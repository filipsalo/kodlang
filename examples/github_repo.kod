// Summarise a GitHub repository over its JSON API.
//
//   kod run examples/github_repo.kod anthropics/anthropic-sdk-python
//
// Environment:
//   GITHUB_TOKEN  sent as a bearer token when set (needed for private repos)
//   GITHUB_API    the API root, https://api.github.com by default
//
// Exit status: 0 on success, 1 when the request fails or the repository is
// not found, 2 on a bad command line.
import "env"
import "io"
import "json"
import "net/http" { Client, Query, with_query }
import "time" { Duration }

func fail(anon message: str) -> none {
    io.write_stderr("error: " + message + "\n")
}

// A string field, or `fallback` when it is missing, null or not a string.
func text_of(anon v: json.Value, key: str, fallback: str) -> str {
    return json.as_str(json.get(v, key: key))? or fallback
}

func number_of(anon v: json.Value, key: str) -> int64 {
    return json.as_int(json.get(v, key: key))? or 0
}

// The `message` the API puts in an error body, if the body is JSON.
func api_message(anon body: str) -> str {
    let parsed = json.parse(body)
    if parsed is Ok(v) {
        return text_of(v, key: "message", fallback: "")
    }
    return ""
}

// The GitHub API: one Client for all requests, so that they share a connection,
// set up with what every request needs.
type GitHub = struct {
    client: Client
    root: str

    // GET `path` and parse the JSON answer; any status outside 2xx is an ApiError.
    func get(self, anon path: str) -> json.Value or Error {
        let response = try self.client.get(self.root + path)
        if response.ok() == false {
            throw ApiError(status: response.status, reason: response.reason, detail: api_message(response.text()))
        }
        return try json.parse(response.text())
    }

    func repo(self, anon name: str) -> json.Value or Error {
        return try self.get("/repos/" + name)
    }

    func open_issues(self, anon name: str, limit: int64) -> json.Value or Error {
        let query = Query()
        query.add("state", "open")
        query.add("per_page", limit.to_str())
        return try self.get(with_query("/repos/" + name + "/issues", query))
    }
}

func connect(anon root: str) -> GitHub {
    // 15 seconds for each request as a whole, however slowly the server sends it.
    let client = Client(deadline: Duration(seconds: 15))
    client.headers.add("Accept", "application/vnd.github+json")
    if env.get("GITHUB_TOKEN") is Some(token) {
        client.headers.add("Authorization", "Bearer " + token)
    }
    return GitHub(client: client, root: root)
}

type ApiError = struct {
    status: int64
    reason: str
    detail: str

    func to_str(self) -> str {
        if len(self.detail) > 0 {
            return f"{self.status} {self.reason}: {self.detail}"
        }
        return f"{self.status} {self.reason}"
    }
}

func print_repo(anon repo: json.Value) -> none {
    print(text_of(repo, key: "full_name", fallback: "?"))
    print("  " + text_of(repo, key: "description", fallback: "(no description)"))
    print(f"  language: {text_of(repo, key: "language", fallback: "unknown")}")
    print(f"  stars: {number_of(repo, key: "stargazers_count")}, forks: {number_of(repo, key: "forks_count")}")
    let license = json.get(repo, key: "license")
    print(f"  license: {text_of(license, key: "spdx_id", fallback: "none")}")
}

func print_issues(anon issues: json.Value) -> none {
    let items = json.as_array(issues)
    if items is none {
        return
    }
    print("open issues:")
    mut shown: int64 = 0
    for issue in items {
        print(f"  #{number_of(issue, key: "number")} {text_of(issue, key: "title", fallback: "?")}")
        shown = shown + 1
    }
    if shown == 0 {
        print("  none")
    }
}

func main(argv: [str]) -> int64 {
    if len(argv) != 2 or argv[1].contains("/") == false {
        io.write_stderr("usage: github_repo OWNER/REPO\n")
        return 2
    }
    let github = connect(env.get("GITHUB_API")? or "https://api.github.com")

    let repo = github.repo(argv[1])
    if repo is Err(e) {
        fail(e.to_str())
        return 1
    }
    print_repo(repo)

    let issues = github.open_issues(argv[1], limit: 3)
    if issues is Err(e) {
        fail(e.to_str())
        return 1
    }
    print_issues(issues)
    github.client.close()
    return 0
}
