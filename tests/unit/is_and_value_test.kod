// An `and` chain outside a condition binds what its `is` patterns name for the
// operands after them.

type Tok = enum {
    Num(n: int64)
    Word(text: str)
}

func small(anon t: Tok) -> bool {
    return t is .Num(n) and n < 10
}

func both(anon a: int64?, anon b: int64?) -> bool {
    return a is Some(x) and b is Some(y) and x == y
}

func check(anon ok: bool) -> bool {
    return ok
}

test "a let, a return and an argument" {
    let t = Tok.Num(n: 3)
    let s = t is .Num(n) and n > 2
    assert s
    assert small(t)
    assert not small(.Num(n: 12))
    assert not small(.Word(text: "a"))
    assert both(1, 1)
    assert not both(1, 2)
    assert not both(none, 2)
    assert check(t is .Num(k) and k == 3)
}

test "operands before the `is`, and results" {
    let ready = true
    let o: int64? = 5
    let r: int64 or Error = 4
    assert ready and o is Some(v) and v == 5
    assert not (false and o is Some(v) and v == 5)
    assert r is int64(v) and v == 4
    assert [x for x in [1, 2, 3] if (x > 1 and o is Some(v) and v > x)] == [2, 3]
}

test "in an assert and a condition it still binds for the body" {
    let o: int64? = 7
    assert o is Some(v) and v == 7
    mut seen = 0
    if o is Some(v) and v > 1 {
        seen = v
    }
    assert seen == 7
}
