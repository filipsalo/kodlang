// `is` recovers a struct from an interface value boxed in another module,
// such as an error that an imported function throws.
import "./../downcast_xmod_dep"
import "./../downcast_xmod_dep" { Pt, Oops }

test "is recovers a struct boxed in another module" {
    let m = downcast_xmod_dep.boxed()
    if m is Pt(p) {
        assert p.x == 42
    } else {
        fail("not pt")
    }
    match m {
        Pt(p) -> assert p.name() == "pt42"
        else -> fail("?")
    }
}

test "is recovers an error another module throws" {
    match downcast_xmod_dep.fail(1) {
        Ok(_v) -> fail("ok")
        Err(e) -> {
            if e is Oops(o) {
                assert o.code == 11
            } else {
                fail(e.to_str())
            }
        }
    }
    assert downcast_xmod_dep.which(downcast_xmod_dep.Pt(x: 5)) == "dep sees pt 5"
}
