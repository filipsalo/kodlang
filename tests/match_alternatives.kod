// Patterns joined with `|` share an arm, in a match statement or expression.

type Op = enum {
    Add
    Sub
    Mul
    Lit(n: int64)
}

func kind(op: Op) -> str {
    match op {
        .Add | .Sub -> return "additive"
        Op.Mul | .Lit(_) -> return "other"
    }
}

func size(n: int64) -> str {
    return match n {
        1 | 2 | 3 -> "small"
        10 |
        20 -> "round"
        else "big"
    }
}

func opt(o: int64?) -> str {
    return match o {
        none | Some(_) -> "either"
    }
}

func main() -> int64 {
    print(kind(op: .Add))
    print(kind(op: .Sub))
    print(kind(op: .Mul))
    print(kind(op: .Lit(n: 4)))
    print(size(n: 2))
    print(size(n: 20))
    print(size(n: 7))
    print(opt(o: none))
    let name = "b"
    match name {
        "a" | "b" -> {
            let shout = name + "!"
            print(shout)
        }
        else print("no")
    }
    mut total = 0
    for op in [Op.Add, .Mul, .Sub] {
        match op {
            .Add | .Sub -> total += 1
            else none
        }
    }
    print_int(total)
    print_int(1 | 2)
    return 0
}

// expected output:
// additive
// additive
// other
// other
// small
// round
// big
// either
// b!
// 2
// 3
