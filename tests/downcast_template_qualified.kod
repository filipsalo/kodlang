// A downcast to a generic type written through a module is reported as written.
import "./downcast_generic_xmod_dep"

func main() -> int64 {
    let s: downcast_generic_xmod_dep.Shape = downcast_generic_xmod_dep.boxed()
    let held = s is _: downcast_generic_xmod_dep.Box
    if s is b: downcast_generic_xmod_dep.Box {
        return 1
    }
    match s {
        b: downcast_generic_xmod_dep.Box -> return 2
        else -> return 0
    }
}

// expected errors:
// 6:16: error: `downcast_generic_xmod_dep.Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = downcast_generic_xmod_dep.Box[int64]`
// 7:8: error: `downcast_generic_xmod_dep.Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = downcast_generic_xmod_dep.Box[int64]`
// 10:11: error: `downcast_generic_xmod_dep.Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = downcast_generic_xmod_dep.Box[int64]`
