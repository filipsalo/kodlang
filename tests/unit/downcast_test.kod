// Interface downcasting: recover a thrown error's concrete type from the
// boxed `Error`, via `match` and the `is` operator. Runs under both frontends.

type DiskFull = shared struct {
    bytes: int64
    func to_str(self) -> str { return "disk full" }
}

type NotFound = shared struct {
    path: str
    func to_str(self) -> str { return "not found" }
}

func open_(anon which: int64) -> int64 or Error {
    if which == 1 {
        throw DiskFull(bytes: 100)
    }
    throw NotFound(path: "/etc/x")
}

test "is recovers a thrown error's concrete type" {
    match open_(1) {
        Ok(_v) -> fail("ok")
        Err(e) -> {
            if e is DiskFull(d) {
                assert d.bytes == 100
            } else {
                fail("not DiskFull")
            }
            if e is NotFound {
                fail("unexpected NotFound")
            }
        }
    }
}

test "match recovers a thrown error's concrete type" {
    match open_(2) {
        Ok(_v) -> fail("ok")
        Err(e) -> {
            match e {
                NotFound(n) -> assert n.path == "/etc/x"
                else -> fail("not NotFound")
            }
        }
    }
}
