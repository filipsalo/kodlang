// Methods on the float64 primitive type. A float64 is the bit pattern of an
// IEEE 754 double in an ordinary 8-byte slot, and the externs take and return
// those bits. Codegen compiles a call to any of them to an instruction or two
// (`float_intrinsic`); to_str is primitives/float_text. Not user-extensible:
// the codegen reaches into this specific module by hardcoded path.

import "primitives/float_text"

extern func kod_f64_to_i64(anon x: float64) -> int64
extern func kod_f64_abs(anon x: float64) -> float64
extern func kod_f64_floor(anon x: float64) -> float64
extern func kod_f64_ceil(anon x: float64) -> float64
extern func kod_f64_round(anon x: float64) -> float64
extern func kod_f64_sqrt(anon x: float64) -> float64
extern func kod_f64_is_nan(anon x: float64) -> int64
extern func kod_f64_is_inf(anon x: float64) -> int64

func to_str(self: float64) -> str {
	return float_text.format(self)
}

func to_int64(self: float64) -> int64 {
	return kod_f64_to_i64(self)
}

func abs(self: float64) -> float64 {
	return kod_f64_abs(self)
}

func floor(self: float64) -> float64 {
	return kod_f64_floor(self)
}

func ceil(self: float64) -> float64 {
	return kod_f64_ceil(self)
}

func round(self: float64) -> float64 {
	return kod_f64_round(self)
}

func sqrt(self: float64) -> float64 {
	return kod_f64_sqrt(self)
}

func is_nan(self: float64) -> bool {
	return kod_f64_is_nan(self) != 0
}

func is_inf(self: float64) -> bool {
	return kod_f64_is_inf(self) != 0
}
