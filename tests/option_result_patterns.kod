// .Some/.None on a T? and .Ok/.Err on a T or Error match in match, is and let-else.
type Oops = struct {
    message: str
    func to_str(self) -> str { return self.message }
}
type Color = enum {
    Red
    Green
}
func half(anon n: int64) -> int64 or Error {
    if n % 2 == 1 {
        throw Oops(message: "odd")
    }
    return n / 2
}
func first(anon n: int64) -> Color? {
    if n == 0 {
        return .Red
    }
    return none
}
func main() -> int64 {
    let o: int64? = 5
    if o is .Some(v) {
        print(f"is some {v}")
    }
    match o {
        .Some(v) -> print(f"match some {v}")
        .None -> print("match none")
    }
    let n: int64? = none
    match n {
        .Some(v) -> print(f"n some {v}")
        .None -> print("n none")
    }
    if n is .None {
        print("n is none")
    }
    let label = match o {
        .Some(v) -> f"label {v}"
        .None -> "label none"
    }
    print(label)
    let isn = n is .None
    let iss = o is .Some
    print(f"{isn} {iss} {o is .None} {n is not .None}")
    let c = first(0)
    match c {
        .Some(col) -> {
            if col is .Red {
                print("red")
            }
        }
        .None -> print("no color")
    }
    let r = half(8)
    match r {
        .Ok(v) -> print(f"ok {v}")
        .Err(e) -> print(f"err {e.to_str()}")
    }
    if r is .Ok(v) {
        print(f"is ok {v}")
    }
    let q = half(3)
    let msg = match q {
        .Ok(v) -> f"ok {v}"
        .Err(e) -> f"err {e.to_str()}"
    }
    print(msg)
    print(f"{r is .Ok} {q is .Ok} {q is .Err} {r is not .Err}")
    let made: int64 or Error = .Ok(value: 3)
    match made {
        Ok(v) -> print(f"made ok {v}")
        Err(e) -> print("made err")
    }
    print_int(must made)
    return 0
}

// expected output:
// is some 5
// match some 5
// n none
// n is none
// label 5
// true true false false
// red
// ok 4
// is ok 4
// err odd
// true false true true
// made ok 3
// 3
