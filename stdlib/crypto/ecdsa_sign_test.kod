import "crypto/ecdsa" { PrivateKey }
import "crypto/ecdsa"
import "crypto/random"
import "crypto/sha2" { Algo }
import "encoding/hex"

func h(anon s: str) -> bytes {
    return must hex.decode(s)
}

func rfc(anon key: PrivateKey, anon algo: Algo, anon message: bytes, anon r: str, anon s: str) -> none {
    let (got_r, got_s) = key.sign_rs(algo: algo, message: message)
    assert hex.encode(got_r) == r and hex.encode(got_s) == s
    let der = key.sign(algo: algo, message: message)
    assert key.public_key().verify(algo: algo, message: message, signature: der)
}

test "RFC 6979 A.2.5 and A.2.6" {
    let keyP256 = must PrivateKey(.P256, scalar: h("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721"))
    assert hex.encode(keyP256.public_key().point()) == "0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299"
    rfc(keyP256, .Sha256, b"sample", "efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716", "f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")
    rfc(keyP256, .Sha384, b"sample", "0eafea039b20e9b42309fb1d89e213057cbf973dc0cfc8f129edddc800ef7719", "4861f0491e6998b9455193e34e7b0d284ddd7149a74b95b9261f13abde940954")
    rfc(keyP256, .Sha512, b"sample", "8496a60b5e9b47c825488827e0495b0e3fa109ec4568fd3f8d1097678eb97f00", "2362ab1adbe2b8adf9cb9edab740ea6049c028114f2460f96554f61fae3302fe")
    rfc(keyP256, .Sha256, b"test", "f1abb023518351cd71d881567b1ea663ed3efcf6c5132b354f28d3b0b7d38367", "019f4113742a2b14bd25926b49c649155f267e60d3814b4c0cc84250e46f0083")
    rfc(keyP256, .Sha384, b"test", "83910e8b48bb0c74244ebdf7f07a1c5413d61472bd941ef3920e623fbccebeb6", "8ddbec54cf8cd5874883841d712142a56a8d0f218f5003cb0296b6b509619f2c")
    rfc(keyP256, .Sha512, b"test", "461d93f31b6540894788fd206c07cfa0cc35f46fa3c91816fff1040ad1581a04", "39af9f15de0db8d97e72719c74820d304ce5226e32dedae67519e840d1194e55")
    let keyP384 = must PrivateKey(.P384, scalar: h("6b9d3dad2e1b8c1c05b19875b6659f4de23c3b667bf297ba9aa47740787137d896d5724e4c70a825f872c9ea60d2edf5"))
    assert hex.encode(keyP384.public_key().point()) == "04ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc138015d9b72d7d57244ea8ef9ac0c621896708a59367f9dfb9f54ca84b3f1c9db1288b231c3ae0d4fe7344fd2533264720"
    rfc(keyP384, .Sha256, b"sample", "21b13d1e013c7fa1392d03c5f99af8b30c570c6f98d4ea8e354b63a21d3daa33bde1e888e63355d92fa2b3c36d8fb2cd", "f3aa443fb107745bf4bd77cb3891674632068a10ca67e3d45db2266fa7d1feebefdc63eccd1ac42ec0cb8668a4fa0ab0")
    rfc(keyP384, .Sha384, b"sample", "94edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe46", "99ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8")
    rfc(keyP384, .Sha512, b"sample", "ed0959d5880ab2d869ae7f6c2915c6d60f96507f9cb3e047c0046861da4a799cfe30f35cc900056d7c99cd7882433709", "512c8cceee3890a84058ce1e22dbc2198f42323ce8aca9135329f03c068e5112dc7cc3ef3446defceb01a45c2667fdd5")
    rfc(keyP384, .Sha256, b"test", "6d6defac9ab64dabafe36c6bf510352a4cc27001263638e5b16d9bb51d451559f918eedaf2293be5b475cc8f0188636b", "2d46f3becbcc523d5f1a1256bf0c9b024d879ba9e838144c8ba6baeb4b53b47d51ab373f9845c0514eefb14024787265")
    rfc(keyP384, .Sha384, b"test", "8203b63d3c853e8d77227fb377bcf7b7b772e97892a80f36ab775d509d7a5feb0542a7f0812998da8f1dd3ca3cf023db", "ddd0760448d42d8a43af45af836fce4de8be06b485e9b61b827c2f13173923e06a739f040649a667bf3b828246baa5a5")
    rfc(keyP384, .Sha512, b"test", "a0d5d090c9980faf3c2ce57b7ae951d31977dd11c775d314af55f76c676447d06fb6495cd21b4b6e340fc236584fb277", "976984e59b4c77b0e8e4460dca3d9f20e07b9bb1f63beefaf576f6b2e8b224634a2092cd3792e0159ad9cee37659c736")
}

test "random keys sign what they verify" {
    for curve in [ecdsa.Curve.P256, ecdsa.Curve.P384] {
        for _i in 0..3 {
            let key = must PrivateKey(curve, scalar: random.secure_bytes(curve.size()))
            let public = key.public_key()
            let message = random.secure_bytes(40)
            let sig = key.sign(algo: .Sha256, message: message)
            assert public.verify(algo: .Sha256, message: message, signature: sig)
            assert not public.verify(algo: .Sha256, message: message + b"x", signature: sig)
            assert key.sign(algo: .Sha256, message: message) == sig
        }
    }
}

test "keys refused" {
    assert PrivateKey(.P256, scalar: kod_bytes_from_array([0] * 32)) is Error
    assert PrivateKey(.P256, scalar: kod_bytes_from_array([255] * 32)) is Error
    assert PrivateKey(.P256, scalar: kod_bytes_from_array([1] * 31)) is Error
}
