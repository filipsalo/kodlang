import "posix"
import "term"

test "styles wrap text in escape codes and reset after" {
    assert term.bold("a") == "\u{1b}[1ma\u{1b}[0m"
    assert term.dim("a") == "\u{1b}[2ma\u{1b}[0m"
    assert term.red("a") == "\u{1b}[31ma\u{1b}[0m"
    assert term.green("a") == "\u{1b}[32ma\u{1b}[0m"
    assert term.yellow("a") == "\u{1b}[33ma\u{1b}[0m"
    assert term.red(term.bold("a")) == "\u{1b}[31m\u{1b}[1ma\u{1b}[0m\u{1b}[0m"
}

test "a file is not a terminal, so it gets no colour" {
    let f = must posix.open_read("stdlib/term_test.kod")
    assert not f.is_terminal()
    assert not term.colour(f)
    must f.close()
}

test "a closed descriptor is not a terminal" {
    assert not posix.Fd(fd: -1).is_terminal()
}
