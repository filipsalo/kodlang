// Panics in tasks, under a catch (docs/panics.md#tasks).
import "net/tcp"
import "panics"
import "tasks"
import "testing"
import "time" { Duration, monotonic_ns, sleep }

extern func rc_live_bytes() -> int64

func caught(anon body: func() -> none) -> str {
    if panics.run(body) is panics.Panic(p) {
        return p.message
    }
    return "none"
}

func part(anon n: int64) -> int64 {
    return 100 / n
}

func note(anon log: Log, anon what: str) -> none {
    log.lines += [what]
}

type Log = shared struct {
    lines: [str] = []
}

func naps(anon log: Log, anon name: str, ms: int64) -> int64 or Error {
    let t0 = monotonic_ns()
    sleep(Duration(ms: ms))
    // A cancelled task's sleep ends early.
    if monotonic_ns() - t0 >= ms * 1000000 {
        note(log, f"{name} done")
    }
    return ms
}

func two_parts(anon log: Log) -> int64 {
    let a = spawn part(5)
    let b = spawn part(0)
    let sum = a.wait() + b.wait()
    note(log, "not here")
    return sum
}

test "a task's panic goes to the function it belongs to" {
    let log = Log()
    assert caught(func() { print(two_parts(log)) }) == "integer division by zero"
    assert len(log.lines) == 0
}

func waits_at_the_end(anon log: Log) -> str {
    spawn part(0)
    note(log, "spawned")
    return "made" + "!"
}

test "a function that doesn't wait panics as it returns" {
    let log = Log()
    assert caught(func() {
        print(waits_at_the_end(log))
        note(log, "not here")
    }) == "integer division by zero"
    assert log.lines == ["spawned"]
}

func busy_elsewhere(anon log: Log) -> none {
    spawn part(0)
    let numbers = tasks.Channel[int64]()
    // Nothing ever sends.
    let _n = numbers.receive()
    note(log, "not here")
}

func asleep(anon log: Log) -> none {
    spawn part(0)
    let _r = naps(log, "asleep", ms: 5000)
    note(log, "not here")
}

func reading(anon log: Log) -> none {
    spawn part(0)
    let Ok(l) = tcp.listen("127.0.0.1", port: 0) else {
        return
    }
    let _r = l.accept()
    note(log, "not here")
}

test "a function that waits is woken by its task's panic" {
    let log = Log()
    assert caught(func() { busy_elsewhere(log) }) == "integer division by zero"
    assert caught(func() { asleep(log) }) == "integer division by zero"
    assert caught(func() { reading(log) }) == "integer division by zero"
    assert len(log.lines) == 0
}

func one_fails(anon log: Log) -> none {
    let slow = spawn naps(log, "slow", ms: 5000)
    spawn part(0)
    let _r = slow.wait()
    note(log, "not here")
}

test "the function's other tasks are cancelled" {
    let log = Log()
    assert caught(func() { one_fails(log) }) == "integer division by zero"
    assert len(log.lines) == 0
}

func spawns_then_panics(anon log: Log) -> none {
    spawn naps(log, "left", ms: 5000)
    tasks.give_way()
    panic("the function's own")
}

test "an abandoned function's tasks are cancelled and waited for" {
    let log = Log()
    assert caught(func() { spawns_then_panics(log) }) == "the function's own"
    assert len(log.lines) == 0
    assert caught(func() { spawns_then_panics_both() }) == "the function's own"
}

func spawns_then_panics_both() -> none {
    spawn part(0)
    panic("the function's own")
}

func outer(anon log: Log) -> none {
    spawn part(0)
    // A catch inside the function the task belongs to isn't the one for it.
    let inner = panics.run(func() {
        let _r = naps(log, "in", ms: 5000)
        note(log, "not here")
    })
    if inner is panics.Panic(_p) {
        note(log, "nor here")
    }
}

test "the catch around the function takes it, not one inside" {
    let log = Log()
    assert caught(func() { outer(log) }) == "integer division by zero"
    assert len(log.lines) == 0
}

func deep(anon n: int64) -> int64 {
    if n == 0 {
        return part(0)
    }
    let t = spawn deep(n - 1)
    return t.wait()
}

test "a panic comes up through tasks of tasks" {
    let p = panics.run(func() { print(deep(4)) })
    let Some(it) = p else {
        fail("no panic")
        return
    }
    assert it.message == "integer division by zero"
    assert it.backtrace.starts_with("backtrace:\n  #0  deep (")
    assert it.backtrace.contains("spawned at:\n  #0  deep (")
}

test "the task goes on after the catch" {
    let log = Log()
    for _ in 0..3 {
        assert caught(func() { asleep(log) }) == "integer division by zero"
        // Not cancelled, and nothing left to panic with.
        assert naps(log, "after", ms: 1) is Ok(_n)
        tasks.give_way()
    }
    assert log.lines == ["after done", "after done", "after done"]
}

func late(anon log: Log) -> str {
    let t = spawn part(0)
    for not t_ended(log) {
        tasks.give_way()
    }
    return f"{t.wait()}"
}

mut _rounds: int64 = 0

func t_ended(anon log: Log) -> bool {
    _rounds += 1
    return _rounds > 3
}

test "waiting for a task that panicked panics" {
    let log = Log()
    assert caught(func() { print(late(log)) }) == "integer division by zero"
}

test "the helpers pass a panic on" {
    assert caught(func() {
        let _r = tasks.all([func() -> int64 or Error { return part(1) }, func() -> int64 or Error { return part(0) }])
    }) == "integer division by zero"
    assert caught(func() {
        let _r = tasks.first([func() -> int64 or Error { return part(0) }, func() -> int64 or Error { return try slow_one() }])
    }) == "integer division by zero"
    assert caught(func() { let _r = tasks.map_concurrently([3, 2, 1, 0, 5], part, limit: 2) }) == "integer division by zero"
    assert caught(func() {
        let _r = tasks.within(Duration(seconds: 5), func() -> int64 { return part(0) })
    }) == "integer division by zero"
    assert tasks.map_concurrently([1, 2], part, limit: 2) == [100, 50]
}

func slow_one() -> int64 or Error {
    sleep(Duration(seconds: 5))
    return 1
}

func counting(anon to: int64) -> tasks.Channel[int64] {
    for i in 0..to {
        yield 100 / (3 - i)
    }
}

test "a generator's panic comes out where its values are received" {
    mut got: [int64] = []
    assert caught(func() {
        for v in counting(10) {
            got += [v]
        }
    }) == "integer division by zero"
    assert got == [33, 50, 100]
}

test "a detached task's panic ends the program" {
    let r = testing.run(func() {
        let _p = panics.run(func() {
            spawn detached part(0)
            sleep(Duration(seconds: 2))
        })
    })
    assert r.status == 1
    assert r.stderr.starts_with("panic: integer division by zero\nbacktrace:\n  #0  spawn part (")
}

test "a detached task can catch its own" {
    let log = Log()
    spawn detached catches(log)
    sleep(Duration(ms: 1))
    assert log.lines == ["integer division by zero"]
}

func catches(anon log: Log) -> none {
    note(log, caught(func() { print(part(0)) }))
}

test "a task under no catch ends the program" {
    let r = testing.run(func() { print(two_parts(Log())) })
    assert r.status == 1
    assert r.stderr.starts_with("panic: integer division by zero\nbacktrace:\n  #0  spawn part (")
}

test "a deadlock isn't caught" {
    let r = testing.run(func() {
        let _p = panics.run(func() {
            spawn naps(Log(), "n", ms: 1)
            let _n = tasks.Channel[int64]().receive()
        })
    })
    assert r.status == 1
    assert r.stderr.starts_with("panic: all tasks are asleep: deadlock\n")
}

mut _tries: int64 = 0
mut _slow_value: int64 = slow_value()

func slow_value() -> int64 {
    _tries += 1
    sleep(Duration(ms: 2))
    if _tries < 3 {
        panic(f"try {_tries}")
    }
    return 7
}

func reads_slow() -> str {
    mut got = ""
    let p = caught(func() { got = f"{_slow_value}" })
    return f"{p} {got}"
}

test "a task waiting for a variable works it out when the other's try panics" {
    let a = spawn reads_slow()
    let b = spawn reads_slow()
    let c = spawn reads_slow()
    assert a.wait() == "try 1 "
    assert b.wait() == "try 2 "
    assert c.wait() == "none 7"
}

test "two tasks catch at once" {
    let log = Log()
    spawn each(log, "a")
    spawn each(log, "b")
    tasks.give_way()
    sleep(Duration(ms: 30))
    assert len(log.lines) == 20
    for i, line in log.lines {
        assert line == f"a {i / 2}" or line == f"b {i / 2}"
    }
}

func each(anon log: Log, anon name: str) -> none {
    for i in 0..10 {
        let got = caught(func() {
            sleep(Duration(ms: 1))
            panic(f"{name} {i}")
        })
        note(log, got)
    }
}

test "what panics in tasks leave is freed" {
    let log = Log()
    let rounds = [
        func() { print(two_parts(log)) },
        func() { asleep(log) },
        func() { one_fails(log) },
        func() { spawns_then_panics(log) },
        func() { outer(log) },
        func() { print(deep(3)) },
        func() { let _r = tasks.map_concurrently([3, 2, 1, 0, 5], part, limit: 2) },
        func() {
            for v in counting(10) {
                let _v = v
            }
        },
    ]
    for k, body in rounds {
        for _ in 0..256 {
            assert caught(body) == "integer division by zero" or k == 3
        }
        let before = rc_live_bytes()
        for _ in 0..256 {
            let _m = caught(body)
        }
        let left = rc_live_bytes() - before
        // The scheduler's queues shrink only now and then.
        if left > 256 * 16 {
            fail(f"round {k} leaves {left} bytes")
        }
    }
}
