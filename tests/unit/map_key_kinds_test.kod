// Map keys match as `==` compares them: bytes by content, so a freshly
// sliced equal key finds its entry, and enums by variant, so a `.Red` built
// in another array literal finds the same entry.

type Color = enum {
    Red
    Green
    Blue
}

test "bytes keys match by content" {
    let raw = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    mut bm = Map[bytes, int64]()
    mut i = 0
    for i < 40 {
        bm.set(raw[i..i + 2], i)
        i = i + 1
    }
    let again = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    mut found = 0
    mut j = 0
    for j < 40 {
        if bm.get(again[j..j + 2]) is Some(v) {
            if v == j {
                found = found + 1
            }
        }
        j = j + 1
    }
    assert found == 40
    assert len(bm) == 40
    assert hash(raw[3..9]) == hash(again[3..9])
}

test "enum keys match by variant" {
    mut cm = Map[Color, int64]()
    let first: [Color] = [.Red, .Green, .Blue]
    mut n = 0
    for c in first {
        cm.set(c, n)
        n = n + 1
    }
    let second: [Color] = [.Blue, .Red, .Green]
    mut got: [int64] = []
    for c in second {
        got += [cm.get(c)? or -1]
        cm.set(c, 10)
    }
    assert got == [2, 0, 1]
    assert len(cm) == 3
    assert hash(first[0]) == hash(second[1])
}
