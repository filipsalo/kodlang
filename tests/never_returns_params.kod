// A helper that ends in a method of `self` or of a parameter never returns.
type Reporter = struct {
    tag: str

    func fail(self, anon msg: str) -> none {
        kod_panic(f"{self.tag}: {msg}")
    }

    func fail_loudly(self, anon msg: str) -> none {
        print(self.tag)
        self.fail(msg)
    }
}

func die(anon r: Reporter, anon msg: str) -> none {
    r.fail(msg)
}

func die_int_param(anon kod_panic: int64, anon msg: str) -> none {
    print_int(kod_panic)
    kod_panic(msg)
}

func pick(anon n: int64, r: Reporter) -> int64 {
    if n > 0 {
        return n
    }
    die(r, "negative")
}

func pick_self(anon n: int64, r: Reporter) -> int64 {
    if n > 0 {
        return n
    }
    r.fail_loudly("negative")
}

func pick_int(anon n: int64) -> int64 {
    if n > 0 {
        return n
    }
    die_int_param(5, "negative")
}

func main() -> int64 {
    let r = Reporter(tag: "r")
    print_int(pick(1, :r) + pick_self(2, :r) + pick_int(3))
    print_int(pick_self(-1, :r))
    return 0
}

// expected output:
// 6
// r
// expected status:
// 1
// expected stderr:
// panic: r: negative
