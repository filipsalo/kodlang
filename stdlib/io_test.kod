// Direct in-process tests for `stdlib/io.kod`. Migrated from
// tests/io_read_file.kod — exercising `read_file` here doesn't need
// build_and_run since the test program already has `io` available.
// Fixture path is relative to the project root (where `kod test` runs).

import "io"
import "libc"
import "time"
import "unsafe"

test "read_file returns full contents and reports the right length" {
    let s: str = must io.read_file("tests/io_fixture.txt")
    assert s == "hello world\n"
    assert len(s) == 12
}

test "write_file then read_file round-trips, bytes and all" {
    let path = "build/io_test_roundtrip.tmp"
    let text = "line one\n\u{0}zero inside\n" + "x".repeat(200000)
    assert io.write_file(path, text) == 0
    assert (must io.read_file(path)) == text
    assert io.write_file(path, "") == 0
    assert (must io.read_file(path)) == ""
}

test "read_file says why it fails" {
    let missing = io.read_file("tests/no-such-file-on-purpose.txt")
    assert missing is Error
    if missing is Error(e) {
        assert e.to_str() == "open tests/no-such-file-on-purpose.txt: No such file or directory"
    }
    let folder = io.read_file("tests")
    assert folder is Error
    if folder is Error(e) {
        assert e.to_str() == "read tests: Is a directory"
    }
}

test "write_file fails quietly" {
    assert io.write_file("/no/such/dir/on/purpose/x.txt", "x") == -1
}

test "read_file reads a pipe to its end" {
    assert (must io.read_file("/dev/null")) == ""
}

test "is_file is true only for an existing regular file" {
    assert io.is_file("tests/io_fixture.txt")
    assert not io.is_file("tests")
    assert not io.is_file("tests/no-such-file-on-purpose.txt")
    assert not io.is_file("/dev/null")
}

test "file_size" {
    let path = f"/tmp/kod-io-size-{libc.getpid()}"
    assert io.write_file(path, "12345") == 0
    assert (io.file_size(path)? or -1) == 5
    assert io.write_file(path, "") == 0
    assert (io.file_size(path)? or -1) == 0
    let _ = libc.unlink(unsafe.c_str(path))
    assert io.file_size(path) is none
    assert io.file_size("stdlib") is none
}

test "file_info" {
    let path = f"/tmp/kod-io-info-{libc.getpid()}"
    assert io.write_file(path, "12345") == 0
    if io.file_info(path) is io.FileInfo(info) {
        assert info.is_file and not info.is_dir and info.size == 5
        let age = time.unix_ns() - info.modified_ns
        assert -1000000000 < age < 10000000000
    } else {
        fail("no file")
    }
    let _ = libc.unlink(unsafe.c_str(path))
    assert io.file_info(path) is none
    if io.file_info("stdlib") is io.FileInfo(info) {
        assert info.is_dir and not info.is_file
    } else {
        fail("no directory")
    }
}
