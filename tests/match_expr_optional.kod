// A none or optional arm makes a match expression optional; each arm is wrapped or boxed for the match's type.
interface Shape {
    func area(self) -> int64
}
type Sq = struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type Circle = struct {
    r: int64
    func area(self) -> int64 { return 3 * self.r * self.r }
}
type Tag = struct {
    name: str
}

func mixed(anon k: int64, t: Tag?) -> str? {
    return match k {
        1 -> t?.name
        else -> "fallback"
    }
}

func maybe_num(anon k: int64) -> int64? {
    return match k {
        0 -> 0
        1 -> 10
        else -> none
    }
}

func zero(anon k: int64) -> int64? {
    return match k {
        1 -> 1
        else -> 0
    }
}

func pick(anon k: int64) -> Shape {
    return match k {
        1 -> Sq(s: 4)
        else -> Circle(r: 3)
    }
}

func main() -> int64 {
    let t: Tag? = Tag(name: "red")
    print(mixed(1, :t)? or "none")
    print(mixed(2, :t)? or "none")
    print(mixed(1, t: none)? or "none")
    let k = 2
    let a: str? = match k {
        1 -> "x"
        else -> none
    }
    print(a? or "none")
    let b = match k {
        2 -> "y"
        else -> none
    }
    print(b? or "-")
    let c = match k {
        1 -> "z"
        else -> none
    }
    if c == none {
        print("c is none")
    }
    print_int(maybe_num(0)? or -1)
    print_int(maybe_num(1)? or -1)
    print_int(maybe_num(2)? or -1)
    print_int(zero(5)? or -1)
    let s: Shape = match k {
        1 -> Sq(s: 2)
        else -> Circle(r: 1)
    }
    print_int(s.area())
    let shapes: [Shape] = [match k {
        2 -> Sq(s: 3)
        else -> Circle(r: 2)
    }]
    print_int(shapes[0].area())
    print_int(pick(1).area())
    print_int(pick(2).area())
    return 0
}

// expected output:
// red
// fallback
// none
// none
// y
// c is none
// 0
// 10
// -1
// 0
// 3
// 9
// 16
// 27
