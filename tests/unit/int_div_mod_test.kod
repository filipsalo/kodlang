import "panics"

// Integer `/` and `%` truncate toward zero (C-style, matching ARM64 sdiv),
// so the remainder takes the dividend's sign, on negative operands too.
test "division and remainder truncate toward zero" {
    assert (0 - 7) / 2 == -3        // not -4
    assert (0 - 7) % 3 == -1        // not 2
    assert 7 % (0 - 3) == 1         // not -2
    assert (0 - 7) / (0 - 2) == 3
    assert 7 / 2 == 3
}

func caught(anon body: func() -> none) -> str {
    if panics.run(body) is panics.Panic(p) {
        return p.message
    }
    return "none"
}

test "the quotient that doesn't fit panics" {
    let min = -9223372036854775808
    let minus_one = 0 - 1
    assert caught(func() { print(min / minus_one) }) == "integer overflow"
    assert min % minus_one == 0
    // A nonzero divisor, literal or not, never panics.
    assert min / 2 == -4611686018427387904
}
