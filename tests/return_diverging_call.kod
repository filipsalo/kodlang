// `return` of a call that never returns needs no value of the function's
// type, whether the callee is a function, a method or an imported
// module's function.
import "./return_diverging_call_dep"

type Reader = struct {
    v: int64

    func fail(self, anon msg: str) -> none {
        kod_panic(msg)
    }

    func get(self) -> int64 {
        if self.v >= 0 {
            return self.v
        }
        return self.fail("negative value")
    }
}

func die(anon msg: str) -> none {
    kod_panic(msg)
}

func checked(anon n: int64) -> int64 {
    if n >= 0 {
        return n
    }
    return die("negative")
}

func doubled(anon n: int64) -> int64 {
    if n >= 0 {
        return n * 2
    }
    return return_diverging_call_dep.die("negative")
}

func label(anon n: int64) -> str {
    let s = match n {
        1 -> "one"
        else -> return_diverging_call_dep.die("not one")
    }
    return s
}

// A method on a local counts where the call is written.
func via_local(anon n: int64) -> int64 {
    let r = Reader(v: n)
    if n >= 0 {
        return n + 10
    }
    return r.fail("negative local")
}

func arm_local(anon n: int64) -> int64 {
    let r = Reader(v: n)
    let x = match n {
        1 -> 11
        else -> r.fail("not one")
    }
    return x
}

func or_local(anon m: int64?) -> int64 {
    let r = Reader(v: 0)
    return m? or r.fail("no value")
}

func main() -> int64 {
    print_int(via_local(2))
    print_int(arm_local(1))
    print_int(or_local(13))
    print_int(checked(1))
    print_int(Reader(v: 2).get())
    print_int(doubled(3))
    print(label(1))
    print_int(Reader(v: -1).get())
    return 0
}

// expected output:
// 12
// 11
// 13
// 1
// 2
// 6
// one
// expected status:
// 1
// expected stderr:
// panic: negative value
