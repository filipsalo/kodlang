// `try` can return from the middle of an expression that has values pushed
// on the stack: an array literal, call arguments or slice bounds.
type ParseError = shared struct {
    text: str
    func to_str(self) -> str { return f"bad {self.text}" }
}

type Box = shared struct {
    v: int64
}

func parse(anon s: str) -> int64 or Error {
    if s == "1" { return 1 }
    if s == "2" { return 2 }
    if s == "3" { return 3 }
    throw ParseError(text: s)
}

func collect(anon xs: [str]) -> [int64] or Error {
    mut out: [int64] = []
    for x in xs {
        out += [try parse(x)]
    }
    return out
}

func triple(anon xs: [str]) -> [int64] or Error {
    return [len(xs), try parse(xs[0]), try parse(xs[1])]
}

func nested(anon xs: [str]) -> [[int64]] or Error {
    return [[7], [8, try parse(xs[0])], [try parse(xs[1])]]
}

func boxes(anon xs: [str]) -> [Box] or Error {
    let bs = [Box(v: 10), Box(v: try parse(xs[0])), Box(v: try parse(xs[1]))]
    return bs
}

func add3(anon a: int64, anon b: int64, anon c: int64) -> int64 {
    return a + b + c
}

func summed(anon xs: [str]) -> int64 or Error {
    return add3(100, try parse(xs[0]), add3(10, try parse(xs[1]), 1000))
}

func window(anon xs: [int64], from: str, to: str) -> [int64] or Error {
    return xs[try parse(from)..try parse(to)]
}

func ints(anon xs: [int64]) -> str {
    mut s = ""
    for x in xs {
        s = f"{s} {x}"
    }
    return s
}

func show(anon r: [int64] or Error) -> str {
    return match r {
        Ok(xs) -> f"ok{ints(xs)}"
        Err(e) -> e.to_str()
    }
}

test "try in an array literal" {
    assert show(collect(["1", "2", "3"])) == "ok 1 2 3"
    assert show(collect(["1", "x", "3"])) == "bad x"
    assert show(triple(["2", "3"])) == "ok 2 2 3"
    assert show(triple(["2", "y"])) == "bad y"
    let n1 = match nested(["1", "z"]) {
        Ok(xss) -> f"nested {len(xss)}"
        Err(e) -> e.to_str()
    }
    assert n1 == "bad z"
    let n2 = match nested(["1", "2"]) {
        Ok(xss) -> f"nested{ints(xss[1])}"
        Err(e) -> e.to_str()
    }
    assert n2 == "nested 8 1"
    let b1 = match boxes(["q", "1"]) {
        Ok(bs) -> f"boxes {len(bs)}"
        Err(e) -> e.to_str()
    }
    assert b1 == "bad q"
    let b2 = match boxes(["3", "2"]) {
        Ok(bs) -> f"boxes {bs[0].v} {bs[1].v} {bs[2].v}"
        Err(e) -> e.to_str()
    }
    assert b2 == "boxes 10 3 2"
}

test "try in call arguments" {
    let s1 = match summed(["1", "w"]) {
        Ok(n) -> f"summed {n}"
        Err(e) -> e.to_str()
    }
    assert s1 == "bad w"
    let s2 = match summed(["1", "2"]) {
        Ok(n) -> f"summed {n}"
        Err(e) -> e.to_str()
    }
    assert s2 == "summed 1113"
}

test "try in slice bounds" {
    let xs = [10, 20, 30, 40]
    assert show(window(xs, from: "1", to: "3")) == "ok 20 30"
    assert show(window(xs, from: "1", to: "v")) == "bad v"
    assert show(window(xs, from: "u", to: "3")) == "bad u"
}
