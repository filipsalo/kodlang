test "a million bytes" {
    let a = kod_bytes_from_array([97] * 1000000)
    assert hex.encode(sha2.sha256(a)) == "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"
    assert hex.encode(sha2.sha512(a)) == "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b"
}

test "pieces, finishing early and copies" {
    for algo in [sha2.Algo.Sha256, sha2.Algo.Sha384, sha2.Algo.Sha512] {
        let data = pattern(700)
        for piece in [1, 7, 63, 64, 65, 128, 300] {
            mut h = sha2.Hasher(algo)
            mut at = 0
            for at < len(data) {
                let end = min(at + piece, len(data))
                h.update(data[at..end])
                at = end
            }
            assert h.finish() == sha2.digest(algo, data)
        }
        mut h = sha2.Hasher(algo)
        h.update(data[..100])
        let saved = h
        assert h.finish() == sha2.digest(algo, data[..100])
        h.update(data[100..])
        assert h.finish() == sha2.digest(algo, data)
        assert saved.finish() == sha2.digest(algo, data[..100])
        assert len(h.finish()) == algo.size()
    }
}
