// Compile-error tests: programs the compiler must reject, each checked
// against the errors snippet_errors reports for it.

import "kod/test_support"

// The operands of an array `+` that aren't literals or matches must have one type.
test "array + operands must have one type" {
    let errs = test_support.snippet_errors("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = shared struct {
            s: int64
            func area(self) -> int64 { return self.s * self.s }
        }
        func take(anon xs: [Shape]) -> int64 {
            return len(xs)
        }
        func main() -> int64 {
            let nums: [int64] = [1]
            let names: [str] = ["a"]
            let sqs = [Sq(s: 6)]
            let shapes: [Shape] = [Sq(s: 2)]
            let a = nums + names
            let b = sqs + shapes
            let c = [Sq(s: 1)] + shapes + sqs
            let d = nums + 1
            let e: [Shape] = sqs + [Sq(s: 1)]
            mut f: [Shape] = []
            f += [Sq(s: 1)] + sqs
            print_int(take(shapes + [Sq(s: 3)] + sqs))
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:16:20: error: cannot concatenate `[int64]` and `[str]`")
    assert errs.contains("<test>:17:19: error: cannot concatenate `[Sq]` and `[Shape]`")
    assert errs.contains("<test>:18:35: error: cannot concatenate `[Shape]` and `[Sq]`")
    assert errs.contains("<test>:19:20: error: cannot concatenate `[int64]` and `int64`")
    assert errs.contains("<test>:20:22: error: expected `[Shape]`, got `[Sq]`")
    assert errs.contains("<test>:22:23: error: cannot concatenate `[Shape]` and `[Sq]`")
    assert errs.contains("<test>:23:42: error: cannot concatenate `[Shape]` and `[Sq]`")
}

// A block's function value can't be called after the block.
test "a block's function value can't be called after the block" {
    let errs = test_support.snippet_errors("""
        func main() -> int64 {
            if true {
                let f = func(anon n: int64) -> int64 {
                    return n + 1
                }
                print_int(f(1))
            }
            print_int(f(2))
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:8:15: error: `f` is declared in a block that has ended; declare it outside the block to call it here")
}

// A message about a binding that hides another names it as written.
test "messages name a hiding binding as written" {
    let errs = test_support.snippet_errors("""
        type P = shared struct {
            v: int64
        }

        type Holder = shared struct {
            v: int64
        }

        func double(anon n: int64) -> int64 {
            return n * 2
        }

        func errs(anon n: int64, anon p: P, anon o: int64?, anon h: Holder?, anon s: str) -> int64 {
            mut x = 1
            let count = 2
            let g = double
            let q = 1
            if n > 0 {
                let x = 2
                x = 3
                let p = P(v: n)
                print_int(p.nope())
                let q = none
                let count = 3
                print_int(countt1)
                countt1 = 4
                let g = 5
                print_int(g(1))
                let o = o
                let y: int64 = o
                print_int(o or 1)
                let h = h
                h.v = 3
                let s = s
                for c in s {
                    print(c)
                }
            }
            if n > 1 {
                let g = double
                print_int(g(1, 2))
            }
            return x + count + g(1) + q
        }

        func main() -> int64 {
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:20:9: error: cannot reassign immutable binding `x`; declare it with `mut`")
    assert errs.contains("<test>:22:19: error: unknown method `nope` on `p` of type `P`")
    assert errs.contains("<test>:23:17: error: cannot infer the type of `q`; add a type annotation")
    assert errs.contains("<test>:25:19: error: unknown name `countt1`; did you mean `count`?")
    assert errs.contains("<test>:26:9: error: unknown name `countt1`; declare it with `mut countt1 = ...`; did you mean `count`?")
    assert errs.contains("<test>:28:19: error: `g` is a local of type `int64`, not a function")
    assert errs.contains("<test>:30:24: error: expected `int64`, got `int64?`; unwrap it first with `must o` or `o? or default`")
    assert errs.contains("<test>:31:19: error: `or` needs `bool` operands, got `int64?`; did you mean `o? or default`?")
    assert errs.contains("<test>:33:11: error: cannot access field `v` on a value of type `Holder?`; unwrap it first, as in `if h is Some(v) { v.v = ... }`")
    assert errs.contains("<test>:41:19: error: `g` takes 1 argument, got 2")
}

// A `let` in a block that hides an outer `mut` can't be reassigned there.
test "a let hiding an outer mut can't be reassigned" {
    let errs = test_support.snippet_errors("""
        func main() -> int64 {
            mut x = 1
            x = 2
            if x > 1 {
                let x = 5
                print_int(x)
                x = 6
            }
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:7:9: error: cannot reassign immutable binding `x`; declare it with `mut`")
}

// A binding in a block that holds no function hides an outer function value
// of its name, so the call is the compiler's error.
test "a non-function binding in a block hides an outer function value" {
    let errs = test_support.snippet_errors("""
        func double(anon n: int64) -> int64 {
            return n * 2
        }

        func main() -> int64 {
            let g = double
            print_int(g(1))
            if true {
                let g = 5
                print_int(g)
                print_int(g(1))
            }
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:11:19: error: `g` is a local of type `int64`, not a function")
}

// Calling a local that holds no function, with no function of its name,
// is the compiler's error, spelled with the local's Kod type.
test "calling a local that holds no function" {
    let errs = test_support.snippet_errors("""
        func main() -> int64 {
            print("start")
            let g = 5
            print_int(g(1))
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:4:15: error: `g` is a local of type `int64`, not a function")
}

// A `T or Error` is spelled from its Ok payload, not by the name of
// the type behind it.
test "a non-function `T or Error` local is spelled from its Ok payload" {
    let errs = test_support.snippet_errors("""
        type Oops = shared struct {
            code: int64

            func to_str(self) -> str {
                return "oops"
            }
        }

        func might(anon n: int64) -> int64 or Error {
            if n == 0 {
                throw Oops(code: 1)
            }
            return n
        }

        func main() -> int64 {
            print("start")
            let g = might(1)
            print_int(g(1))
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:19:15: error: `g` is a local of type `int64 or Error`, not a function")
}

// A downcast names a struct or a generic instance, not a generic type itself.
test "a downcast can't name a generic type itself" {
    let errs = test_support.snippet_errors("""
        interface Shape {
            func area(self) -> int64
        }

        type Box[T] = shared struct {
            v: T

            func area(self) -> int64 {
                return 1
            }
        }

        type Pair[A, B] = shared struct {
            a: A
            b: B

            func area(self) -> int64 {
                return 2
            }
        }

        func main() -> int64 {
            let s: Shape = Box[int64](v: 1)
            let held = s is Box
            if s is Box {
                return 1
            }
            if s is Box(b) {
                return 2
            }
            match s {
                Pair(p) -> return 3
                else -> return 0
            }
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:24:16: error: `Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = Box[int64]`")
    assert errs.contains("<test>:25:8: error: `Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = Box[int64]`")
    assert errs.contains("<test>:28:8: error: `Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = Box[int64]`")
    assert errs.contains("<test>:31:11: error: `Pair` is generic; downcast to one of its instances through a type alias such as `type IntPair = Pair[int64, int64]`")
}

// A struct field declared twice is an error at the second one.
test "a struct field declared twice" {
    let errs = test_support.snippet_errors("""
        type Pt = shared struct {
            x: int64
            y: int64
            x: str
        }

        func main() -> int64 {
            let p = Pt(x: 1, y: 2)
            return p.y
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:4:5: error: `Pt.x` is already declared on line 2")
}

// Two parameters of one function, method, interface method, extern or
// function literal can't share a name.
test "two parameters can't share a name" {
    let errs = test_support.snippet_errors("""
        type Pt = shared struct {
            x: int64

            func shift(self, anon by: int64, step by: int64) -> int64 {
                return self.x + by
            }
        }

        type Box[T] = shared struct {
            v: T

            func put(self, anon v: T, again v: T) -> none {
                self.v = v
            }
        }

        interface Shape {
            func area(self, anon k: int64, scale k: int64) -> int64
        }

        extern func c_measure(anon s: str, also s: str) -> int64

        func pick(anon a: int64, b a: str) -> str {
            return a
        }

        func main() -> int64 {
            let f = func(anon n: int64, anon n: int64) -> int64 {
                return n
            }
            print(pick(1, b: "x"))
            print_int(Pt(x: 1).shift(2, step: 3))
            print_int(f(1, 2))
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:4:38: error: parameter `by` is declared twice; give one of them another name")
    assert errs.contains("<test>:12:31: error: parameter `v` is declared twice; give one of them another name")
    assert errs.contains("<test>:18:36: error: parameter `k` is declared twice; give one of them another name")
    assert errs.contains("<test>:21:36: error: parameter `s` is declared twice; give one of them another name")
    assert errs.contains("<test>:23:26: error: parameter `a` is declared twice; give one of them another name")
    assert errs.contains("<test>:28:33: error: parameter `n` is declared twice; give one of them another name")
}

// An enum variant declared twice is an error at the second one.
test "an enum variant declared twice" {
    let errs = test_support.snippet_errors("""
        type Kind = enum {
            A
            B(n: int64)
            A
        }

        func main() -> int64 {
            let k = Kind.B(n: 1)
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:4:5: error: `Kind.A` is already declared on line 2")
}

// An error in a generic body names the instance, once per line of the template.
test "an error in a generic body names the instance once" {
    let errs = test_support.snippet_errors("""
        type Color = enum {
            Red
            Green
        }

        func largest[T](a: T, b: T) -> T {
            if a < b {
                return b
            }
            return a
        }

        func unused[T](anon x: T) -> T {
            return x.no_such_method()
        }

        func main() -> int64 {
            let c = largest(a: Color.Red, b: Color.Green)
            let d = largest(a: Color.Green, b: Color.Red)
            print(c is .Red and d is .Red)
            print(largest(a: 1, b: 2))
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:7:8: error: `<` doesn't take `Color` operands; declare `op_lt` on `Color` to use it (in `largest[Color]`)")
}

// Parameters are immutable by default; reassigning one is a compile
// error. (Declaring `anon mut x` instead would make this compile.)
test "reassigning a parameter" {
    let errs = test_support.snippet_errors("""
        func bump(anon x: int64) -> int64 {
            x = x + 1
            return x
        }

        func main() -> int64 {
            return bump(41)
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:2:5: error: cannot reassign immutable binding `x`; declare it with `mut`")
}

// A `let` binding is immutable; reassigning it is a compile error.
// (Declaring `mut limit` instead would make this compile.)
test "reassigning a let binding" {
    let errs = test_support.snippet_errors("""
        func main() -> int64 {
            let limit: int64 = 10
            limit = 20
            return limit
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:3:5: error: cannot reassign immutable binding `limit`; declare it with `mut`")
}

// An error in an f-string's value is reported where the value is written.
test "an f-string value's error is reported where it's written" {
    let errs = test_support.snippet_errors("""
        func main() -> int64 {
            print(f"n: {9223372036854775808}")
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:2:17: error: integer literal `9223372036854775808` doesn't fit in `int64`, whose largest value is 9223372036854775807")
}

// A prefix `-` takes the whole call, so the smallest int64 can't be its receiver.
test "the smallest int64 can't be the receiver of a call under prefix -" {
    let errs = test_support.snippet_errors("""
        func main() -> int64 {
            print(-9223372036854775808.to_str())
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:2:12: error: integer literal `9223372036854775808` doesn't fit in `int64`, whose largest value is 9223372036854775807; the `-` negates the whole expression after it, so write `(-9223372036854775808)` for the smallest `int64`")
}

// An integer literal must fit in int64; 2^63 only right after a prefix `-`.
test "an integer literal must fit in int64" {
    let errs = test_support.snippet_errors("""
        func main() -> int64 {
            let ok = -9223372036854775808 + 9223372036854775807
            let big = 9223372036854775808
            return ok + big
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:3:15: error: integer literal `9223372036854775808` doesn't fit in `int64`, whose largest value is 9223372036854775807")
}

// The compiler rejects labelled arguments out of parameter order, instead
// of binding them by position.
test "labelled arguments out of parameter order" {
    let errs = test_support.snippet_errors("""
        func move(x: int64, y: int64) -> int64 {
            return x * 10 + y
        }

        func main() -> int64 {
            print_int(move(x: 1, y: 2))
            print_int(move(y: 2, x: 1))
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:7:20: error: parameter 0 of `move` expected label `x`, got `y`")
}

test "in-place map updates need a mut binding and `default:`" {
    let errs = test_support.snippet_errors("""
        func main() -> int64 {
            let m = Map[str, [int64]]()
            m["a", default: []] += [1]
            mut n = Map[str, int64]()
            n["a", other: 1] += 1
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:3:5: error: cannot change `m`, an immutable binding; declare it with `mut`")
    assert errs.contains("<test>:5:12: error: expected `default:` after the key, got `other`")
}

// A bad key that reaches a Map through another generic type's parameter
// is reported at that type's argument, naming the instance.
test "a bad Map key through a generic parameter is reported at the argument" {
    let errs = test_support.snippet_errors("""
        type Pt = shared struct {
            x: int64
        }

        type Index[T] = shared struct {
            m: Map[T, int64]

            func count(self) -> int64 {
                return len(self.m)
            }
        }

        type Tagged[T] = enum {
            Many(m: Map[T, str])
            Empty
        }

        type Shape = enum {
            Dot
            Circle(r: int64)
        }

        func count(anon i: Index[Pt]) -> int64 {
            return i.count()
        }

        func tags(anon t: Tagged[Shape]) -> int64 {
            return 0
        }

        func main() -> int64 {
            let i = Index[[int64]](m: Map[[int64], int64]())
            return i.count()
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:23:26: error: `Pt` can't be a `Map` key in `Index[Pt]`; keys are `int64`, `str`, `bytes`, `bool`, enums without payloads or unions of those")
    assert errs.contains("<test>:27:26: error: `Shape` can't be a `Map` key in `Tagged[Shape]`; some of its variants have payloads; keys are `int64`, `str`, `bytes`, `bool`, enums without payloads or unions of those")
    assert errs.contains("<test>:32:19: error: `[int64]` can't be a `Map` key in `Index[[int64]]`; keys are `int64`, `str`, `bytes`, `bool`, enums without payloads or unions of those")
}

test "misuse of mut parameters" {
    let errs = test_support.snippet_errors("""
        type Box = shared struct {
            xs: [int64]
        }

        func add(mut xs: [int64]) -> none {
            xs += [1]
        }

        func pair(mut a: [int64], mut b: [int64]) -> none {
            a += b
        }

        func plain(xs: [int64]) -> int64 {
            return len(xs)
        }

        func main() -> int64 {
            mut xs = [1]
            let ys = [2]
            let box = Box(xs: [3])
            add(:xs)
            add(xs: mut ys)
            add(xs: mut box.xs)
            print(plain(xs: mut xs))
            pair(a: mut xs, b: mut xs)
            let f = add
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:21:10: error: `xs` is a `mut` parameter of `add`: pass `mut xs`")
    assert errs.contains("<test>:22:17: error: cannot pass `ys` as `mut`: it's an immutable binding; declare it with `mut`")
    assert errs.contains("<test>:23:17: error: only a `mut` local or parameter can be passed as `mut`; copy `box.xs` into a `mut` local and assign it back")
    assert errs.contains("<test>:24:25: error: `xs` isn't a `mut` parameter of `plain`; remove the `mut`")
    assert errs.contains("<test>:25:28: error: `xs` is passed as `mut` twice in this call")
    assert errs.contains("<test>:26:13: error: `add` has a `mut` parameter, so it can only be called by name")
}

// A local's name can't be used before its `let` or after the block, arm
// or loop that bound it, unless a function of that name is there instead.
test "a local can't be read before its let or after its block" {
    let errs = test_support.snippet_errors("""
        type P = shared struct {
            x: int64
        }

        func before() -> int64 {
            let y = later + 1
            let later = 3
            return y + later
        }

        func after_block(anon n: int64) -> int64 {
            if n > 0 {
                let r = n * 2
                print_int(r)
            } else {
                let r = 0
                print_int(r)
            }
            return r
        }

        func after_arm(anon o: int64?) -> int64 {
            match o {
                Some(v) -> print_int(v)
                none -> print("none")
            }
            return v
        }

        func after_loop(anon xs: [P]) -> int64 {
            for p in xs {
                print_int(p.x)
            }
            return p.x
        }

        func assign_after(anon n: int64) -> int64 {
            if n > 0 {
                mut total = n
                total += 1
            }
            total = 5
            return 0
        }

        func main() -> int64 {
            print_int(before())
            print_int(after_block(1))
            print_int(after_arm(2))
            print_int(after_loop([P(x: 3)]))
            print_int(assign_after(4))
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:6:13: error: `later` is read before its `let`")
    assert errs.contains("<test>:19:12: error: `r` is declared in a block that has ended; declare it outside the block to use it here")
    assert errs.contains("<test>:27:12: error: `v` is declared in a block that has ended; declare it outside the block to use it here")
    assert errs.contains("<test>:34:12: error: `p` is declared in a block that has ended; declare it outside the block to use it here")
    assert errs.contains("<test>:42:5: error: `total` is declared in a block that has ended; declare it outside the block to use it here")
}

// The compiler asks for a constructor value's label.
test "a constructor value needs its field label" {
    let errs = test_support.snippet_errors("""
        type Point = shared struct {
            x: int64
            y: int64
        }

        func main() -> int64 {
            print_int(Point(x: 1, y: 2).x)
            let p = Point(3, y: 4)
            print_int(p.x)
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:8:19: error: argument 1 of `Point` needs a field label (`x:`)")
}

// A method can't take the name of a field of its struct.
test "a method can't take the name of a field" {
    let errs = test_support.snippet_errors("""
        type Bag = shared struct {
            items: [int64]
            len: int64 = 0

            func len(self) -> int64 {
                return len(self.items) + self.len
            }
        }

        func main() -> int64 {
            let b = Bag(items: [1, 2], len: 10)
            print_int(b.len())
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:5:10: error: `Bag.len` is already declared on line 3")
}

test "changing value structs needs mut" {
    let errs = test_support.snippet_errors("""
        type Point = struct {
            x: int64

            func reset(self) -> none {
                self.x = 0
            }

            func set(mut self, anon x: int64) -> none {
                self.x = x
            }
        }

        type Node = struct {
            weak up: Node?
        }

        type Graph = shared struct {
            func clear(mut self) -> none {
            }
        }

        interface Settable {
            func set(self, anon x: int64) -> none
        }

        func use(anon p: Point) -> none {
            p.x = 1
            p.set(2)
        }

        func main() -> int64 {
            let p = Point(x: 1)
            p.x = 2
            p.set(3)
            for q in [p] {
                q.x = 4
            }
            let s: Settable = Point(x: 0)
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:5:9: error: cannot change `self`; declare the method with `mut self`")
    assert errs.contains("<test>:14:10: error: only a shared struct has weak fields")
    assert errs.contains("<test>:18:10: error: a shared struct's methods change it through any `self`; remove the `mut`")
    assert errs.contains("<test>:27:5: error: cannot change `p`, an immutable binding; declare it with `mut`")
    assert errs.contains("<test>:28:5: error: cannot change `p`, an immutable binding; declare it with `mut`")
    assert errs.contains("<test>:33:5: error: cannot change `p`, an immutable binding; declare it with `mut`")
    assert errs.contains("<test>:34:5: error: cannot change `p`, an immutable binding; declare it with `mut`")
    assert errs.contains("<test>:36:9: error: cannot change `q`, an immutable binding; declare it with `mut`")
    assert errs.contains("<test>:38:23: error: struct `Point` doesn't implement interface `Settable`: method `set` has a `mut` parameter")
}

// Only the builtins declare the names the compiler finds their types by.
test "builtin type names are reserved" {
    let errs = test_support.snippet_errors("""
        type Option = shared struct {
            v: int64
        }

        interface Map {
            func get(self) -> int64
        }

        type Result = enum {
            Good
            Bad
        }

        type Error = int64

        type Stringable = shared struct {
            text: str
        }

        type ExitCode = [int64]

        func main() -> int64 {
            return 0
        }
        """)
    assert errs != ""
    assert errs.contains("<test>:5:11: error: `Map` is the name of a builtin type; give this type another name")
    assert errs.contains("<test>:9:6: error: `Result` is the name of a builtin type; give this type another name")
    assert errs.contains("<test>:14:6: error: `Error` is the name of a builtin type; give this type another name")
    assert errs.contains("<test>:16:6: error: `Stringable` is the name of a builtin type; give this type another name")
    assert errs.contains("<test>:20:6: error: `ExitCode` is the name of a builtin type; give this type another name")
}
