// A bare type name in a dep is an error there even when the entry, parsed
// first, declares that type.
import "./type_bare_cross_module_late_dep"

type Late = struct {
    n: int64
}

func main() -> int64 {
    return type_bare_cross_module_late_dep.take(Late(n: 1))
}

// expected stderr:
// tests/type_bare_cross_module_late_dep.kod:1:19: error: unknown type `Late`
// expected status:
// 1
