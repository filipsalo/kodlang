import "crypto/chacha20poly1305"
import "encoding/hex"

func h(anon s: str) -> bytes {
    return must hex.decode(s)
}

func stream(anon key: str, anon nonce: str, anon counter: int64, anon data: str, anon want: str) -> none {
    assert hex.encode(chacha20poly1305.chacha20(h(data), key: h(key), nonce: h(nonce), counter: counter)) == want
}

func mac(anon key: str, anon data: str, anon want: str) -> none {
    assert hex.encode(chacha20poly1305.poly1305(h(data), key: h(key))) == want
}

func aead(anon key: str, anon nonce: str, anon plaintext: str, anon aad: str, anon want: str) -> none {
    let sealed = chacha20poly1305.seal(h(plaintext), key: h(key), nonce: h(nonce), aad: h(aad))
    assert hex.encode(sealed) == want
    assert chacha20poly1305.open(sealed, key: h(key), nonce: h(nonce), aad: h(aad)) == h(plaintext)
}

test "RFC 8439 2.8.2" {
    let key = h("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    let nonce = h("070000004041424344454647")
    let aad = h("50515253c0c1c2c3c4c5c6c7")
    let plaintext = kod_str_to_bytes("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.")
    let sealed = chacha20poly1305.seal(plaintext, key: key, nonce: nonce, aad: aad)
    assert hex.encode(sealed) == "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691"
    assert chacha20poly1305.open(sealed, key: key, nonce: nonce, aad: aad) == plaintext
}

