// `?` after an array or generic type makes it optional.

type Box[T] = shared struct {
    v: T
}

type Holder = shared struct {
    names: [str]?
    box: Box[int64]?

    func count(self) -> int64 {
        return len(self.names? or [])
    }
}

func find(anon n: int64) -> [int64]? {
    if n == 0 {
        return none
    }
    return [n, n + 1]
}

func total(anon xs: [int64]?) -> int64 {
    mut t: int64 = 0
    for x in xs? or [] {
        t += x
    }
    return t
}

test "an optional array from a function" {
    let a = find(0)
    assert a is none
    let b = find(3)
    if b is Some(xs) {
        assert len(xs) == 2
    } else {
        fail("b is none")
    }
    assert total(b) == 7
    assert total(none) == 0
    assert total([5, 6]) == 11
    let m = match b {
        Some(v) -> len(v)
        none -> 0
    }
    assert m == 2
}

test "optional array and generic fields" {
    let h = Holder(names: ["a"], box: Box[int64](v: 4))
    assert h.count() == 1
    assert Holder(names: none, box: none).count() == 0
    if h.box is Some(bx) {
        assert bx.v == 4
    } else {
        fail("box is none")
    }
}

test "assigning an optional array" {
    mut d: [int64]? = none
    d = [1, 2, 3]
    assert len(d? or []) == 3
}
