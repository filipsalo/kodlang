type Pair = struct {
    x: float64
    y: float64 = 0.5
}

type Box[T] = struct {
    value: T
}

func half(anon x: float64) -> float64 {
    return x / 2.0
}

func maybe(anon on: bool) -> float64? {
    if on {
        return 1.25
    }
    return none
}

test "literals" {
    assert 1.5 == 1.5
    assert 0.25 + 0.25 == 0.5
    assert 2e3 == 2000.0
    assert 1.5e-3 == 0.0015
    assert 6.02e23 > 6.0e23
    assert 1 000 000.5 == 1000000.5
    assert 1.to_str() == "1"
}

test "arithmetic" {
    assert 1.5 + 2.25 == 3.75
    assert 5.0 - 7.5 == -2.5
    assert 1.5 * 4.0 == 6.0
    assert 7.0 / 2.0 == 3.5
    assert -(2.5) == 0.0 - 2.5
    let x = 3.0
    assert -x == -3.0
    mut y = 1.0
    y += 0.5
    y -= 0.25
    assert y == 1.25
    assert 1.0 + 2.0 * 3.0 == 7.0
    assert (1.0 + 2.0) * 3.0 == 9.0
}

test "comparison" {
    assert 1.0 < 2.0
    assert 2.0 > 1.0
    assert 1.0 <= 1.0
    assert 1.0 >= 1.0
    assert 1.0 != 2.0
    assert 1.0 < 2.0 < 3.0
    assert (3.0 < 2.0) == false
    assert -0.0 == 0.0
}

test "ieee special values" {
    let zero = 0.0
    let inf = 1.0 / zero
    let nan = zero / zero
    assert inf > 1e308
    assert inf.is_inf()
    assert (-inf).is_inf()
    assert nan.is_nan()
    assert (nan == nan) == false
    assert nan != nan
    assert (nan < 1.0) == false
    assert (nan > 1.0) == false
    assert (nan <= nan) == false
    assert (nan >= nan) == false
    assert 1.0.is_nan() == false
    assert 1.0.is_inf() == false
}

test "to_str is the shortest text that reads back" {
    assert 1.5.to_str() == "1.5"
    assert 2.0.to_str() == "2.0"
    assert (0.0).to_str() == "0.0"
    assert (-2.5).to_str() == "-2.5"
    assert (0.1 + 0.2).to_str() == "0.30000000000000004"
    assert 0.1.to_str() == "0.1"
    assert 100.0.to_str() == "100.0"
    assert 123456789.5.to_str() == "123456789.5"
    assert 0.000001.to_str() == "0.000001"
    assert 0.0000001.to_str() == "1e-7"
    assert 1e21.to_str() == "1e+21"
    assert 1e20.to_str() == "100000000000000000000.0"
    assert 1.5e-7.to_str() == "1.5e-7"
    assert 6.02e23.to_str() == "6.02e+23"
    assert 5e-324.to_str() == "5e-324"
    assert 1.7976931348623157e308.to_str() == "1.7976931348623157e+308"
}

test "to_str of the special values" {
    let zero = 0.0
    assert (1.0 / zero).to_str() == "inf"
    assert (-1.0 / zero).to_str() == "-inf"
    assert (zero / zero).to_str() == "nan"
    assert (-zero).to_str() == "-0.0"
}

test "f-strings and addition to a str" {
    let x = 2.5
    assert f"{x}" == "2.5"
    assert f"x = {x * 2.0}!" == "x = 5.0!"
    assert "n=" + x.to_str() == "n=2.5"
}

test "conversions" {
    assert 3.to_float64() == 3.0
    assert (-7).to_float64() == -7.0
    assert 3.99.to_int64() == 3
    assert (-3.99).to_int64() == -3
    assert 0.5.to_int64() == 0
    assert 1e30.to_int64() == 9223372036854775807
    assert (-1e30).to_int64() == -9223372036854775807 - 1
    let zero = 0.0
    assert (zero / zero).to_int64() == 0
    assert 9007199254740993.to_float64().to_int64() == 9007199254740992
}

test "parse_float" {
    assert "1.5".parse_float()? == 1.5
    assert "-0.25".parse_float()? == -0.25
    assert "+3".parse_float()? == 3.0
    assert "2e3".parse_float()? == 2000.0
    assert "2.5E-1".parse_float()? == 0.25
    assert ".5".parse_float()? == 0.5
    assert "5.".parse_float()? == 5.0
    assert "".parse_float() is none
    assert "abc".parse_float() is none
    assert "1.5x".parse_float() is none
    assert " 1.5".parse_float() is none
    assert "1.5 ".parse_float() is none
    assert "inf".parse_float() is none
    assert "nan".parse_float() is none
    assert "0x10".parse_float() is none
    assert "-".parse_float() is none
    assert "1e".parse_float() is none
    let big = "1e999".parse_float()?
    assert big.is_inf()
}

test "math" {
    assert (-2.5).abs() == 2.5
    assert 2.5.abs() == 2.5
    assert 2.5.floor() == 2.0
    assert (-2.5).floor() == -3.0
    assert 2.5.ceil() == 3.0
    assert (-2.5).ceil() == -2.0
    assert 2.5.round() == 3.0
    assert (-2.5).round() == -3.0
    assert 2.4.round() == 2.0
    assert 9.0.sqrt() == 3.0
    assert 2.0.sqrt() > 1.41421
    assert 2.0.sqrt() < 1.41422
    assert (-1.0).sqrt().is_nan()
}

test "round trip through to_str and parse_float" {
    let xs = [0.1, 1.0 / 3.0, 123456.789, 1e-10, 5e-324, 1.7976931348623157e308, -0.0001]
    for x in xs {
        assert x.to_str().parse_float()? == x
    }
}

test "variables, parameters, fields, arrays, optionals" {
    let a: float64 = 4.0
    assert half(a) == 2.0
    assert half(half(a)) == 1.0
    let p = Pair(x: 1.5)
    assert p.y == 0.5
    p.x = p.x * 2.0
    assert p.x == 3.0
    let q = Pair(x: 1.0, y: 2.0)
    assert q.x + q.y == 3.0

    mut xs: [float64] = [1.5, 2.5]
    xs += [3.5]
    assert len(xs) == 3
    assert xs[0] + xs[2] == 5.0
    xs[1] = 0.25
    assert xs[1] == 0.25
    mut total = 0.0
    for x in xs {
        total += x
    }
    assert total == 5.25
    let ys: [float64] = []
    assert len(ys) == 0
    let rows: [[float64]] = [[1.0], [2.0, 3.0]]
    assert rows[1][1] == 3.0

    assert maybe(true)? == 1.25
    assert maybe(false) is none
    assert (maybe(false)? or 9.5) == 9.5
    if maybe(true) is Some(v) {
        assert v == 1.25
    }
    let b = Box[float64](value: 2.5)
    assert b.value == 2.5
}

test "match on a float subject with a guard-free wildcard" {
    let x = 1.5
    let name = match x > 1.0 {
        true -> "big"
        false -> "small"
    }
    assert name == "big"
}
