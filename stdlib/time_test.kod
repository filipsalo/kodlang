import "time"
import "time" { Duration, Time }

test "monotonic_ns: never goes backwards" {
    let a: int64 = time.monotonic_ns()
    let b: int64 = time.monotonic_ns()
    assert b >= a
}

test "monotonic_ns: increases across a small busy wait" {
    // Spin a tiny accumulator to let the clock advance — enough
    // iterations that any reasonable clock_gettime ticks at least
    // once. Asserts a strict increase, which would only fail on a
    // truly broken (frozen) clock.
    let t0: int64 = time.monotonic_ns()
    mut sum: int64 = 0
    mut i: int64 = 0
    for i < 200000 {
        sum = sum + i
        i = i + 1
    }
    let t1: int64 = time.monotonic_ns()
    assert t1 > t0
    // Defeat dead-code elimination of `sum`.
    assert sum != -1
}

test "unix_ns: looks like a real timestamp" {
    // 2020-01-01 UTC == 1577836800 seconds == 1577836800000000000 ns.
    // Any sane wall clock should be past that. Upper bound is the
    // year 2200 — keeps the test from breaking on truly skewed
    // clocks while still catching a hard-zero return.
    let t: int64 = time.unix_ns()
    assert t > 1577836800000000000
    assert t < 7258118400000000000
}

test "sleep: waits at least that long" {
    let t0: int64 = time.monotonic_ns()
    time.sleep(Duration(ms: 50))
    let dt: int64 = time.monotonic_ns() - t0
    assert dt >= 50000000
    assert dt < 2000000000
}

test "sleep: zero and negative return at once" {
    let t0: int64 = time.monotonic_ns()
    time.sleep(Duration())
    time.sleep(Duration(ms: -5))
    assert time.monotonic_ns() - t0 < 40000000
}

test "Duration: the units add up" {
    assert Duration().ns == 0
    assert Duration(ns: 7).ns == 7
    assert Duration(us: 3).ns == 3000
    assert Duration(ms: 2).ns == 2000000
    assert Duration(seconds: 5).ns == 5000000000
    assert Duration(minutes: 2).ns == 120000000000
    assert Duration(hours: 1).ns == 3600000000000
    assert Duration(minutes: 1, seconds: 30) == Duration(seconds: 90)
    assert Duration(hours: 1, minutes: 1, seconds: 1, ms: 1, us: 1, ns: 1).ns == 3661001001001
}

test "Duration: arithmetic" {
    let a = Duration(seconds: 2)
    let b = Duration(ms: 500)
    assert (a + b).ns == 2500000000
    assert (a - b).ns == 1500000000
    assert (a * 3).ns == 6000000000
    assert (3 * a).ns == 6000000000
    assert (a / 4).ns == 500000000
    assert (-a).ns == -2000000000
    assert (b - a).ns == -1500000000
    mut c = a
    c += b
    c -= Duration(ms: 100)
    assert c.ns == 2400000000
    assert a.ns == 2000000000
}

test "Duration: comparison" {
    let a = Duration(seconds: 2)
    let b = Duration(ms: 2000)
    let c = Duration(seconds: 3)
    assert a == b
    assert a != c
    assert a < c
    assert c > a
    assert a <= b
    assert a >= b
    assert not (c < a)
    assert Duration(ms: -1) < Duration()
    assert Duration(seconds: 1) < Duration(seconds: 2) < Duration(seconds: 3)
}

test "Duration: as_ms and as_seconds truncate toward zero" {
    assert Duration(ms: 1999).as_seconds() == 1
    assert Duration(ms: -1999).as_seconds() == -1
    assert Duration(us: 2999).as_ms() == 2
    assert Duration(seconds: 3).as_ms() == 3000
    assert Duration(ns: 999999).as_ms() == 0
}

test "Duration: ceil_ms rounds a positive duration up" {
    assert Duration().ceil_ms() == 0
    assert Duration(ns: 1).ceil_ms() == 1
    assert Duration(us: 500).ceil_ms() == 1
    assert Duration(ms: 3).ceil_ms() == 3
    assert Duration(ms: 3, ns: 1).ceil_ms() == 4
    assert Duration(ms: -3, ns: -1).ceil_ms() == -3
}

test "Duration: to_str" {
    assert Duration().to_str() == "0s"
    assert Duration(ns: 40).to_str() == "40ns"
    assert Duration(us: 12, ns: 500).to_str() == "12.5us"
    assert Duration(us: 1).to_str() == "1us"
    assert Duration(ms: 250).to_str() == "250ms"
    assert Duration(ms: 1, us: 5).to_str() == "1.005ms"
    assert Duration(seconds: 1).to_str() == "1s"
    assert Duration(seconds: 1, ms: 500).to_str() == "1.5s"
    assert Duration(seconds: 59, ms: 1).to_str() == "59.001s"
    assert Duration(minutes: 1, seconds: 30).to_str() == "1m30s"
    assert Duration(minutes: 2).to_str() == "2m0s"
    assert Duration(hours: 1).to_str() == "1h0m0s"
    assert Duration(hours: 1, minutes: 2, seconds: 3).to_str() == "1h2m3s"
    assert Duration(seconds: -90).to_str() == "-1m30s"
    assert Duration(ms: -250).to_str() == "-250ms"
    assert f"{Duration(ms: 1500)}" == "1.5s"
}

test "Time: parse agrees with Python's datetime" {
    let cases: [Stamp] = [
        Stamp(text: "1970-01-01T00:00:00Z", seconds: 0, shown: "1970-01-01T00:00:00Z"),
        Stamp(text: "2026-11-05T12:34:56Z", seconds: 1793882096, shown: "2026-11-05T12:34:56Z"),
        Stamp(text: "2000-02-29T23:59:59Z", seconds: 951868799, shown: "2000-02-29T23:59:59Z"),
        Stamp(text: "1900-03-01T00:00:00Z", seconds: -2203891200, shown: "1900-03-01T00:00:00Z"),
        Stamp(text: "1969-12-31T23:59:59Z", seconds: -1, shown: "1969-12-31T23:59:59Z"),
        Stamp(text: "0001-01-01T00:00:00Z", seconds: -62135596800, shown: "0001-01-01T00:00:00Z"),
        Stamp(text: "9999-12-31T23:59:59Z", seconds: 253402300799, shown: "9999-12-31T23:59:59Z"),
        Stamp(text: "2024-02-29T00:00:00+05:30", seconds: 1709145000, shown: "2024-02-28T18:30:00Z"),
        Stamp(text: "2026-01-01T00:30:00-08:00", seconds: 1767256200, shown: "2026-01-01T08:30:00Z"),
        Stamp(text: "1600-02-29T12:00:00Z", seconds: -11670955200, shown: "1600-02-29T12:00:00Z"),
    ]
    for c in cases {
        let t = time.parse(c.text)?
        assert t.seconds == c.seconds
        assert t.nanos == 0
        assert t.to_str() == c.shown
        // What it prints reads back as the same moment.
        assert time.parse(c.shown)? == t
    }
}

test "Time: utc gives the calendar fields, before 1970 too" {
    let a = (time.parse("2024-02-28T18:30:07Z")?).utc()
    assert a.year == 2024 and a.month == 2 and a.day == 28
    assert a.hour == 18 and a.minute == 30 and a.second == 7
    let b = (time.parse("1969-12-31T23:59:59Z")?).utc()
    assert b.year == 1969 and b.month == 12 and b.day == 31
    assert b.hour == 23 and b.minute == 59 and b.second == 59
    let c = (time.parse("0001-01-01T00:00:00Z")?).utc()
    assert c.year == 1 and c.month == 1 and c.day == 1
    let d = (time.parse("2000-03-01T00:00:00Z")?).utc()
    assert d.year == 2000 and d.month == 3 and d.day == 1
}

test "Time: every day from 1890 to 2110 reads back through parse_date" {
    mut day = (time.parse_date("1890-01-01")?).seconds
    let end = (time.parse_date("2110-01-01")?).seconds
    mut count = 0
    for day < end {
        let t = Time(seconds: day)
        let shown = t.to_str()
        assert time.parse_date(shown[0..10])? == t
        day += 86400
        count += 1
    }
    assert count == 80353
}

test "Time: a fraction and lowercase letters" {
    let a = time.parse("2026-01-02t03:04:05.25z")?
    assert a.nanos == 250000000
    assert a.to_str() == "2026-01-02T03:04:05.25Z"
    assert (time.parse("2026-01-02T03:04:05.000000001Z")?).nanos == 1
    assert (time.parse("2026-01-02T03:04:05.1234567899Z")?).nanos == 123456789
    assert (time.parse("2026-01-02T03:04:05.5+01:00")?).to_str() == "2026-01-02T02:04:05.5Z"
    // Before 1970, a fraction still counts up from its whole second.
    assert (time.parse("1969-12-31T23:59:59.5Z")?).seconds == -1
    assert (time.parse("1969-12-31T23:59:59.5Z")?).to_str() == "1969-12-31T23:59:59.5Z"
}

test "Time: a leap second is the second after it" {
    assert (time.parse("2016-12-31T23:59:60Z")?).to_str() == "2017-01-01T00:00:00Z"
}

test "Time: what isn't a timestamp is none" {
    let bad: [str] = [
        "",
        "2026",
        "2026-11-05",
        "2026-11-05T12:34:56",
        "2026-11-05 12:34:56Z",
        "2026-11-05T12:34:56ZZ",
        "2026-11-05T12:34:56Z ",
        " 2026-11-05T12:34:56Z",
        "2026-02-29T00:00:00Z",
        "2100-02-29T00:00:00Z",
        "2026-13-01T00:00:00Z",
        "2026-00-01T00:00:00Z",
        "2026-04-31T00:00:00Z",
        "2026-01-00T00:00:00Z",
        "2026-01-01T24:00:00Z",
        "2026-01-01T00:60:00Z",
        "2026-01-01T00:00:61Z",
        "2026-01-01T00:00:00.Z",
        "2026-01-01T00:00:00.5",
        "2026-01-01T00:00:00+01",
        "2026-01-01T00:00:00+0100",
        "2026-01-01T00:00:00+24:00",
        "2026-01-01T00:00:00+01:60",
        "2026-01-01T00:00:00+01:00Z",
        "20a6-01-01T00:00:00Z",
        "2026-0a-01T00:00:00Z",
        "2026-01-01T0a:00:00Z",
        "-026-01-01T00:00:00Z",
        "2026/01/01T00:00:00Z",
        "2026-01-01T00-00-00Z",
    ]
    for text in bad {
        assert time.parse(text) is none
    }
    for text in ["", "2026-1-1", "2026-02-30", "2026-01-01T", "2026/01/01", "abcd-ef-gh"] {
        assert time.parse_date(text) is none
    }
}

test "Time: arithmetic and order" {
    let a = time.parse("2026-01-01T00:00:00Z")?
    let b = time.parse("2026-01-03T12:00:00.5Z")?
    assert (b - a).as_days() == 2
    assert (b - a).as_hours() == 60
    assert (b - a).as_ms() == 216000500
    assert a - b == Duration(ns: 0 - (b - a).ns)
    assert a + (b - a) == b
    assert b + (a - b) == a
    assert a < b and b > a and a <= a and a != b
    // Backwards across a whole second, keeping nanos in range.
    let c = (time.parse("2026-01-01T00:00:00.25Z")?) + Duration(ms: -500)
    assert c.to_str() == "2025-12-31T23:59:59.75Z"
    let d = (time.parse("2026-01-01T00:00:00.75Z")?) + Duration(ms: 500)
    assert d.to_str() == "2026-01-01T00:00:01.25Z"
}

test "Time: now is the wall clock" {
    let before = time.unix_ns() / 1000000000
    let t = time.now()
    assert t.seconds >= before and t.seconds <= before + 60
    assert t.nanos >= 0 and t.nanos < 1000000000
    assert t.utc().year >= 2024
}

type Stamp = struct {
    text: str
    seconds: int64
    shown: str
}
