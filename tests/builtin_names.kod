// An unqualified `len`, `str`, `hash` or `panic` is a local or
// parameter first (but a local can't be `str`, the name of a type), then the module's own function or an import item, then
// the builtin.
import "./builtin_names_dep"
import "./builtin_names_dep" { str }

type Point = struct {
    x: int64
}

func hash(anon p: Point) -> int64 {
    return p.x * 10
}

func len(anon a: int64, anon b: int64) -> int64 {
    return a + b
}

func panic(anon m: str) -> none {
    print(f"own {m}")
}

func local_names() -> none {
    let panic = func(m: str) -> none {
        print(f"local {m}")
    }
    panic("x")
}

func param_names(anon hash: func(str) -> int64, anon panic: func(str) -> none) -> int64 {
    panic("y")
    return hash("abc")
}

func soft(anon m: str) -> none {
    print(f"soft {m}")
}

func seven(anon s: str) -> int64 {
    return 7
}

func main() -> int64 {
    print_int(hash(Point(x: 4)))
    print_int(len(2, 3))
    panic("call")
    print(str(12))
    local_names()
    print_int(param_names(seven, soft))
    print_int(builtin_names_dep.hash("abc"))
    print_int(builtin_names_dep.len([1, 2]))
    print(builtin_names_dep.str(5))
    builtin_names_dep.panic("q")
    return 0
}

// expected output:
// 40
// 5
// own call
// num
// local x
// soft y
// 7
// 7
// 99
// num
// dep q 2
