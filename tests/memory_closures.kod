// A closure's cell, and what it holds, go when the last reference does.
extern func rc_live_bytes() -> int64

type Thunk = func() -> str

type Box = struct {
    name: str
    run: func() -> str = plain
}

func plain() -> str {
    return "plain"
}

func make(anon s: str) -> func() -> str {
    return func() -> str {
        return s
    }
}

func nested(anon s: str) -> func() -> func() -> str {
    return func() -> func() -> str {
        return func() -> str {
            return s
        }
    }
}

func grows(anon f: func() -> none) -> bool {
    f()
    let start = rc_live_bytes()
    for _ in 0..1000 {
        f()
    }
    return rc_live_bytes() - start > 8000
}

func made_and_dropped() -> none {
    let f = make("a" + "b")
    let _ = f()
}

func called_as_temporary() -> none {
    let _ = make("a" + "b")()
}

func nested_dropped() -> none {
    let _ = nested("a" + "b")()()
}

func in_array() -> none {
    mut fs: [func() -> str] = []
    for i in 0..3 {
        let s = f"{i}" + "x"
        fs += [func() -> str { return s }]
    }
    for f in fs {
        let _ = f()
    }
}

func in_field() -> none {
    let s = "a" + "b"
    let b = Box(name: "n" + "m", run: func() -> str { return s })
    let _ = b.run()
    b.run = make("c" + "d")
    let _ = b.run()
    b.run = plain
}

func in_optional() -> none {
    let s = "a" + "b"
    let o: Thunk? = func() -> str { return s }
    let _ = o?()
}

func reassigned() -> none {
    mut f = make("a" + "b")
    f = make("c" + "d")
    f = plain
    let _ = f()
}

func returns_capture() -> none {
    let s = "a" + "b"
    let f = func() -> str { return s }
    let got = f()
    let _ = got + "c"
}

// The cell a call is running in goes away during the call.
func replaced_while_running() -> str {
    let b = Box(name: "x")
    let s = "still" + " here"
    b.run = func() -> str {
        b.run = plain
        return s + "!"
    }
    let got = b.run()
    b.run = plain
    return got
}

func cycle_broken() -> none {
    let b = Box(name: "x" + "y")
    b.run = func() -> str { return b.name }
    let _ = b.run()
    b.run = plain
}

func cycle() -> none {
    let b = Box(name: "x" + "y")
    b.run = func() -> str { return b.name }
}

func main() -> int64 {
    print(grows(made_and_dropped))
    print(grows(called_as_temporary))
    print(grows(nested_dropped))
    print(grows(in_array))
    print(grows(in_field))
    print(grows(in_optional))
    print(grows(reassigned))
    print(grows(returns_capture))
    print(grows(func() -> none { let _ = replaced_while_running() }))
    print(grows(cycle_broken))
    print(replaced_while_running())
    // Documented: the one kind of leak there is.
    print(grows(cycle))
    return 0
}

// expected output:
// false
// false
// false
// false
// false
// false
// false
// false
// false
// false
// still here!
// true

// expected status:
// 0
