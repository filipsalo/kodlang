import "./xmod_alias_util"

func f(x: int64 = xmod_alias_util.seed()) -> int64 {
    return x
}

func level(l: xmod_alias_util.Level = xmod_alias_util.Level.High(n: 1)) -> int64 {
    match l {
        .Low -> return 0
        .High(n) -> return n
    }
}

func low(l: xmod_alias_util.Level = xmod_alias_util.Level.Low) -> int64 {
    if l is .Low {
        return 1
    }
    return 0
}

type Cfg = struct {
    p: xmod_alias_util.Pair = xmod_alias_util.Pair(a: 1, b: 0)
}

