// Calls of short functions and methods whose bodies are statements are
// compiled in place: early returns, loops with break and continue, scalar
// locals, nested calls, struct parameters, and names that mean what they
// mean in the callee's module, whatever the caller's locals are called.

import "./inline_stmts_dep" { Counter }

mut calls: int64 = 0

func next(anon tag: str) -> int64 {
    calls += 1
    print(f"next {tag}")
    return calls
}

type Reader = struct {
    data: [int64]
    pos: int64 = 0
    buf: int64 = 0
    count: int64 = 0

    func need(self, anon n: int64) -> none {
        for self.count < n {
            mut b: int64 = 0
            if self.pos < len(self.data) {
                b = self.data[self.pos]
                self.pos += 1
            }
            self.buf = self.buf | (b << self.count)
            self.count += 8
        }
    }

    func drop(self, anon n: int64) -> none {
        self.buf = self.buf >> n
        self.count -= n
        return none
    }

    func bits(self, anon n: int64) -> int64 {
        self.need(n)
        let v = self.buf & ((1 << n) - 1)
        self.drop(n)
        return v
    }
}

type Pt = struct {
    x: int64
    y: int64
}

func manhattan(anon a: Pt, anon b: Pt) -> int64 {
    mut dx = a.x - b.x
    if dx < 0 {
        dx = 0 - dx
    }
    mut dy = a.y - b.y
    if dy < 0 {
        dy = 0 - dy
    }
    return dx + dy
}

func sign(anon x: int64) -> int64 {
    if x < 0 {
        return -1
    }
    if x == 0 {
        return 0
    }
    return 1
}

// The first multiple of `k` from `from`, skipping 13: continue and break in a loop.
func first_multiple(anon k: int64, from: int64) -> int64 {
    mut i = from
    for true {
        i += 1
        if i == 13 {
            continue
        }
        if i % k == 0 {
            break
        }
    }
    return i
}

func pick(a: int64 = 1, cc: int64 = 3) -> int64 {
    return a * 10 + cc
}

func fact(anon n: int64) -> int64 {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

func ratio(anon a: int64, anon b: int64) -> int64 {
    let q = a / b
    return q
}

func main() -> int64 {
    mut r = Reader(data: [0xB5, 0x3C, 0xFF])
    let a = r.bits(3)
    let b = r.bits(7)
    let c = r.bits(12)
    print(f"{a} {b} {c} {r.pos} {r.count}")

    // The caller's own `LIMIT`, `helper`, `n` and `total` don't reach the callee.
    let LIMIT: int64 = 100
    let helper: int64 = 9
    mut total: int64 = 0
    mut cnt = Counter()
    for n in [4, -2, 1, 2, 3, 5, 6] {
        cnt.add(n)
        cnt.note(n)
        total += n
    }
    print(f"{cnt.total} {cnt.steps} {cnt.log} {total} {LIMIT} {helper}")

    print(f"{sign(-5)} {sign(0)} {sign(next("s"))}")
    print(manhattan(Pt(x: 1, y: 7), Pt(x: 4, y: 2)))
    let p = Pt(x: -3, y: 3)
    let q = Pt(x: 3, y: -3)
    print(manhattan(p, q))
    print(f"{first_multiple(5, from: 10)} {first_multiple(13, from: 0)} {first_multiple(next("k"), from: next("f"))}")
    print(fact(10))
    // `pick`'s parameter `cc` is gone again once `sign`'s argument is worked out.
    print(sign(pick(cc: -90)))
    let cc = Pt(x: 2, y: 5)
    print(manhattan(cc, p))
    mut sum: int64 = 0
    for i in 1..1000 {
        sum += sign(i - 500) * ratio(i, i)
    }
    print(sum)
    print(ratio(7, 0))
    return 0
}

// expected output:
// 5 22 4047 3 2
// -1 6 4;-2;1;2;3;5;6; 19 100 9
// next s
// -1 0 1
// 8
// 12
// next k
// next f
// 15 26 4
// 3628800
// -1
// 7
// 0
// expected stderr:
// panic: integer division by zero
// expected status:
// 1
