// A function returns an enum value that the caller matches on.
type Color = enum {
    Red
    Green
    Blue
}

func pick(anon n: int64) -> Color {
    if n == 0 {
        return Color.Red
    }
    if n == 1 {
        return Color.Green
    }
    return Color.Blue
}

func name(anon c: Color) -> str {
    match c {
        Color.Red -> return "red"
        Color.Green -> return "green"
        Color.Blue -> return "blue"
    }
    return "unknown"
}

test "functions return enum values" {
    assert name(pick(0)) == "red"
    assert name(pick(1)) == "green"
    assert name(pick(2)) == "blue"
}
