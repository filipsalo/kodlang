// `?.` on a field and on a method leaves the register pool intact, so the
// values computed after it each keep their own register.
type Tag = shared struct {
    name: str
    n: int64
    func up(self) -> str { return self.name + "!" }
}

func find(anon k: int64) -> Tag? {
    if k > 0 {
        return Tag(name: f"t{k}", n: k)
    }
    return none
}

test "values after ?. keep their registers" {
    let a = find(2)
    let b = find(0)
    assert (a?.n? or -1) == 2
    assert (b?.n? or -1) == -1
    assert (a?.up()? or "none") == "t2!"
    assert (b?.up()? or "none") == "none"
    let x = 1
    let y = 2
    let z = 3
    assert f"{x == 1} {y == 1} {x != 1} {y != 1} {x + y + z}" == "true false false true 6"
    let w = (a?.n? or 0) + (b?.n? or 10) + len(a?.up()? or "") * 100
    assert f"{w} {x} {y} {z}" == "312 1 2 3"
}
