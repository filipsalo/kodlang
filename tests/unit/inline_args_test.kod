// A function compiled into its caller (inlining) reads its arguments as a call does.

type Groups = shared struct {
    parent: [int64]

    func find(self, anon x: int64) -> int64 {
        mut x = x
        for self.parent[x] != x {
            x = self.parent[x]
        }
        return x
    }

    func join(self, anon a: int64, anon b: int64) -> bool {
        let x = self.find(a)
        let y = self.find(b)
        self.parent[x] = y
        return x != y
    }
}

func rounded(anon x: int64) -> int64 {
    mut x = x
    for x < 10 {
        x += 3
    }
    return x
}

func hidden(anon x: int64) -> int64 {
    let y = x
    if y > 0 {
        let x = y * 2
        return x
    }
    return x
}

type P = struct {
    n: int64

    func more(self, anon k: int64) -> int64 {
        return self.n * 100 + k
    }
}

func later(anon p: P) -> int64 {
    mut p = p
    p.n += 5
    return p.n
}

func inc(mut n: int64) -> int64 {
    n += 1
    return n
}

func pair(anon a: int64, anon b: int64) -> int64 {
    let c = a * 100
    return c + b
}

func one(anon a: int64, anon b: int64) -> int64 {
    return a * 100 + b
}

test "a parameter bound again in the body isn't the caller's variable" {
    let a = 1
    assert rounded(a) == 10 and a == 1
    mut sum = 0
    for i in 0..3 {
        let b = i
        sum += rounded(b)
        assert b == i
        assert hidden(b) == i * 2 and b == i
    }
    assert sum == 33
    let g = Groups(parent: [0, 1, 2, 3])
    for i in 0..3 {
        let x = 0
        let y = i + 1
        assert g.join(x, y)
        assert x == 0 and y == i + 1
    }
    let p = P(n: 1)
    assert later(p) == 6 and p.n == 1
}

test "an argument is read before a later one changes the variable" {
    mut n = 1
    assert pair(n, inc(n: mut n)) == 102 and n == 2
    assert one(n, inc(n: mut n)) == 203 and n == 3
    for i in 0..2 {
        assert pair(n, inc(n: mut n)) == (3 + i) * 101 + 1
    }
    let p = pair(n, if n > 1 {
        n = 9
        n
    } else { 0 })
    assert p == 509
}
