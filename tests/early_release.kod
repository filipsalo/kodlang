// Locals holding arrays, maps and value structs are released after their
// last use; what they borrowed or shared must still be right.
type Pt = struct {
    xs: [int64] = []
}

type Box = shared struct {
    items: [str] = []
}

func first_or(anon xs: [int64]?, anon d: int64) -> int64 {
    let .Some(found) = xs else { return d }
    let n = len(found)
    return found[0] + n
}

func fill(mut xs: [int64]) -> none {
    let extra = [7, 8]
    xs += extra
}

func main() -> int64 {
    // An alias that's done with leaves the other holder alone.
    let b = Box()
    b.items += ["a"]
    let saved = b.items
    print(len(saved))
    b.items += ["b"]
    b.items += ["c"]
    print(b.items)

    // A let-else binding keeps what it borrows from alive.
    let maybe: [int64]? = [5, 6]
    print(first_or(maybe, -1))

    // A captured local lives as long as the closure.
    let base = [1, 2, 3]
    let total = func() -> int64 {
        mut s = 0
        for x in base {
            s += x
        }
        return s
    }
    print(total())

    // Used in a loop: alive for the whole loop, breaks included.
    let steps = [1, 2, 3, 4]
    mut acc = 0
    for i in 0..10 {
        if i >= len(steps) {
            break
        }
        let local = [steps[i]] * 2
        acc += local[0] + local[1]
    }
    print(acc)

    // Match bindings borrow from the subject for the statement.
    let opt: Pt? = Pt(xs: [9])
    match opt {
        Some(p) -> print(p.xs)
        none -> print("none")
    }

    // Nested blocks and a value struct copied before its last use.
    mut p = Pt(xs: [1])
    if true {
        let q = p
        p.xs += [2]
        print(f"{q.xs} {p.xs}")
    }

    // A `mut` parameter's local copy and a local of the callee.
    mut ys = [0]
    fill(xs: mut ys)
    print(ys)

    // A name bound again in its block: only the newest binding goes early.
    let x = 3
    let x = [x, 4]
    let x = len(x) + 1
    let x = [x] * 2
    print(x)

    // Maps too.
    mut m = Map[str, [int64]]()
    let row = [1]
    m.set("r", row)
    m.set("s", [2])
    print(f"{len(m)} {m.get("r")? or []}")
    return 0
}

// expected output:
// 1
// [a, b, c]
// 7
// 6
// 20
// [9]
// [1] [1, 2]
// [0, 7, 8]
// [3, 3]
// 2 [1]
