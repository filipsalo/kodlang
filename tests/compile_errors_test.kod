    assert errs != ""
    assert errs.contains("tests/type_bare_generic_ctor_scoped.kod:12:13: error: unknown type `Box`; tests/type_bare_generic_ctor_dep.kod declares `Box`: write `type_bare_generic_ctor_dep.Box` or list it in the import (`{ Box }`)")
    assert errs.contains("tests/type_bare_generic_ctor_scoped.kod:17:13: error: unknown type `Wrap`; tests/type_bare_generic_ctor_dep.kod declares `Wrap`: write `type_bare_generic_ctor_dep.Wrap` or list it in the import (`{ Wrap }`)")
}

// The compiler checks the type names a function body writes even in a
// function that never runs.
test "type names are checked in a function that never runs" {
    let errs = test_support.file_errors("tests/type_check_before_main.kod")
    assert errs != ""
    assert errs.contains("7:12: error: `downcast_generic_xmod_dep.Box` is generic; downcast to one of its instances through a type alias such as `type IntBox = downcast_generic_xmod_dep.Box[int64]`")
}

// The compiler checks a constructor's `m.T` even if it never runs.
test "a constructor's `m.T` is checked even if it never runs" {
    let errs = test_support.file_errors("tests/type_check_before_main_ctor.kod")
    assert errs != ""
    assert errs.contains("6:45: error: module `qualified_type_wrong_module_kb` has no function or type `NotFound`")
}

// The compiler checks a variant's `m.E` even if it never runs.
test "a variant's `m.E` is checked even if it never runs" {
    let errs = test_support.file_errors("tests/type_check_before_main_variant.kod")
    assert errs != ""
    assert errs.contains("6:44: error: module `qualified_type_wrong_module_kb` has no type `E`")
}

// A message qualifies a type only when another module declares one of that
// name: an alias doesn't, whatever it stands for, as a message writes the type
// it stands for.
test "an alias doesn't make a message qualify a type" {
    let errs = test_support.file_errors("tests/type_names_alias_messages.kod")
    assert errs != ""
    assert errs.contains("tests/type_names_alias_messages.kod:9:20: error: expected `int64`, got `Pt`")
    assert errs.contains("tests/type_names_alias_messages.kod:10:20: error: expected `int64`, got `Label`")
    assert errs.contains("tests/type_names_alias_messages.kod:11:20: error: expected `int64`, got `Mode`")
}

// The compiler names a struct in its construction errors
// through the module when another module declares a type of that name.
test "construction errors qualify a struct another module also declares" {
    let errs = test_support.file_errors("tests/type_names_construct.kod")
    assert errs != ""
    assert errs.contains("8:30: error: struct `type_names_pa.Pt` has no field `z`; did you mean `x`?")
}

// An alias of the same name in another module doesn't make the compiler
// qualify a struct in its errors.
test "an alias elsewhere doesn't qualify a struct in construction errors" {
    let errs = test_support.file_errors("tests/type_names_construct_alias.kod")
    assert errs != ""
    assert errs.contains("8:30: error: struct `Pt` has no field `z`; did you mean `x`?")
}

// A message writes a type by its bare name, unless another module of the
// program declares a type of that name too. Then it is written the way this
// module would write it, or with its file when it can't name the module.
test "messages write a type bare unless another module declares that name" {
    let errs = test_support.file_errors("tests/type_names_messages.kod")
    assert errs != ""
    assert errs.contains("tests/type_names_messages.kod:26:31: error: expected `type_names_pa.Pt`, got `type_names_pb.Pt`")
    assert errs.contains("tests/type_names_messages.kod:27:17: error: expected `Pt`, got `type_names_pa.Pt`")
    assert errs.contains("tests/type_names_messages.kod:28:31: error: expected `type_names_pa.Pt`, got `Pt`")
    assert errs.contains("tests/type_names_messages.kod:29:14: error: expected `type_names_pa.Pt`, got `type_names_pb.Pt`")
    assert errs.contains("tests/type_names_messages.kod:30:17: error: expected `Pt`, got `Pt (tests/type_names_far.kod)`")
    assert errs.contains("tests/type_names_messages.kod:31:19: error: expected `Solo`, got `type_names_pa.Pt`")
    assert errs.contains("tests/type_names_messages.kod:32:33: error: expected `type_names_pa.Mode`, got `type_names_pb.Mode`")
    assert errs.contains("tests/type_names_messages.kod:33:34: error: expected `type_names_pa.Pt`, got `type_names_pb.Pt`")
    assert errs.contains("tests/type_names_messages.kod:34:32: error: expected `type_names_pa.Pt?`, got `type_names_pb.Pt`")
    assert errs.contains("tests/type_names_messages.kod:35:39: error: expected `type_names_pa.Box[int64]`, got `type_names_pb.Box[int64]`")
    assert errs.contains("tests/type_names_messages.kod:36:20: error: struct `type_names_pa.Pt` doesn't implement interface `Sized`: missing method `weight`")
    assert errs.contains("tests/type_names_messages.kod:37:19: error: expected `Solo`, got `Pt`")
    assert errs.contains("tests/type_names_messages.kod:38:30: error: struct `type_names_pa.Pt` has no field `z`; did you mean `x`?")
    assert errs.contains("tests/type_names_messages.kod:39:13: error: struct `type_names_pa.Pt` requires field `x` (it has no default)")
    assert errs.contains("tests/type_names_messages.kod:40:30: error: argument 1 of `type_names_pa.Pt` needs a field label (`x:`)")
}

// An ambiguous `.Variant` writes each enum the way the module would: its own
// by its bare name, an imported one through its alias.
test "an ambiguous variant names each enum as the module would" {
    let errs = test_support.file_errors("tests/type_names_variant.kod")
    assert errs != ""
    assert errs.contains("tests/type_names_variant.kod:12:13: error: `.Circle` is ambiguous: `type_names_pa.Shape` and `Shape` both declare it; write `Shape.Circle` or give the value a type")
}

// An enum the module aliases is written by that name in an ambiguous
// `.Variant`, as the module would write it.
test "an ambiguous variant names an aliased enum by its alias" {
    let errs = test_support.file_errors("tests/type_names_variant_alias.kod")
    assert errs != ""
    assert errs.contains("tests/type_names_variant_alias.kod:10:13: error: `.Circle` is ambiguous: `type_names_pa.Shape` and `Shape` both declare it; write `Shape.Circle` or give the value a type")
}

// None of the enums this module sees declares `On`, but two loaded modules do,
// each an enum named `Mode`. The module can't write either, so each is named
// with its file.
test "an ambiguous variant names enums the module can't write by their files" {
    let errs = test_support.file_errors("tests/type_names_variant_far.kod")
    assert errs != ""
    assert errs.contains("tests/type_names_variant_far.kod:8:13: error: `.On` is ambiguous: `Mode (tests/type_names_pa.kod)` and `Mode (tests/type_names_pb.kod)` both declare it; give the value a type")
}

// Aliases of generic instances aren't enums of their own: an ambiguous
// `.Variant` names the two modules' generic enums.
test "an ambiguous variant names generic enums, not aliases of instances" {
    let errs = test_support.file_errors("tests/type_names_variant_instance.kod")
    assert errs != ""
    assert errs.contains("tests/type_names_variant_instance.kod:11:13: error: `.Just` is ambiguous: `type_names_pa.Maybe` and `type_names_pb.Maybe` both declare it; write `type_names_pb.Maybe.Just` or give the value a type")
}

// `.Circle` here is ambiguous between two enums this module can't name,
// so the error suggests giving it a type rather than an enum to write.
test "an ambiguous variant between enums the module can't name" {
    let errs = test_support.file_errors("tests/variant_hidden.kod")
    assert errs != ""
    assert errs.contains("tests/variant_hidden.kod:7:13: error: `.Circle` is ambiguous: `Figure` and `Shape` both declare it; give the value a type")
}

// A default argument in another module that calls an unknown function is
// reported in that module, though this module declares a function of that name.
test "an unknown function in another module's default argument" {
    let errs = test_support.file_errors("tests/xmod_default_unknown.kod")
    assert errs != ""
    assert errs.contains("tests/xmod_default_unknown_dep.kod:1:19: error: unknown function `nowhere`")
}
