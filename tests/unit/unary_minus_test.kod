// A prefix `-` negates the whole call, field access, index or `?` after
// it, an unwrap's default included, and binds tighter than the binary
// operators.

type P = shared struct {
    x: int64
    rows: [[int64]] = [[1, 2], [3, 4]]

    func get(self) -> int64 {
        return self.x * 2
    }
}

func twice(anon n: int64) -> int64 {
    return n * 2
}

test "unary minus binds to the whole postfix expression" {
    let xs = [5, 6, 7]
    let p = P(x: 4)
    mut m = Map[str, int64]()
    m["k"] = 9
    assert -xs[0] == -5
    assert -xs[-1] + 1 == -6
    assert -p.x == -4
    assert -twice(3) == -6
    assert -p.get() == -8
    assert -p.rows[1][0] == -3
    let hit = -m.get("k")? or 0
    assert hit == -9
    let miss = -m.get("none")? or 3
    assert miss == -3
    assert -xs[1] * 2 == -12
    assert 10 - -p.x == 14
    assert -(xs[0] + 1) * -2 == 12
}
