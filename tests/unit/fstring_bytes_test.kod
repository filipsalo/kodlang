// A `bytes` value interpolates as its contents, as `str(b)` converts it.

test "bytes interpolate as their contents" {
    let raw = b"raw"
    let empty = b""
    assert f"[{raw}] [{empty}] [{raw + b"!"}]" == "[raw] [] [raw!]"
    assert str(raw[1..3]) == "aw"
    assert f"{len(raw)} {raw[0]}" == "3 114"
}
