type Pt = struct {
    x: int64
}

type Tone = enum {
    Low
    High
}

func value() -> int64 {
    return 1
}

func make(anon n: int64) -> Pt {
    return Pt(x: n)
}

func rank(anon t: Tone) -> int64 {
    match t {
        .Low -> return 1
        .High -> return 2
    }
}

