// A literal with no type to go to is built as its first element's type.
interface Shape {
    func area(self) -> int64
}
type Sq = shared struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}
type Color = enum {
    Red
    Green
}
test "an interface first element boxes the rest" {
    let sh: Shape = Sq(s: 2)
    mut areas: [int64] = []
    for y in [sh, Sq(s: 3)] {
        areas += [y.area()]
    }
    assert areas == [4, 9]
    let shapes: [Shape] = [Sq(s: 1)]
    mut firsts: [int64] = []
    for row in [shapes, [Sq(s: 4)]] {
        firsts += [row[0].area()]
    }
    assert firsts == [1, 16]
}

test "an optional first element wraps the rest" {
    let a: int64? = 3
    mut got: [int64] = []
    for x in [a, 5, none] {
        got += [x? or 0]
    }
    assert got == [3, 5, 0]
    assert ([a, 7][1]? or 0) == 7
}

test "an enum first element types the variants after it" {
    let c = Color.Green
    mut names: [str] = []
    for k in [c, .Red] {
        names += [match k {
            .Red -> "red"
            .Green -> "green"
        }]
    }
    assert names == ["green", "red"]
}
