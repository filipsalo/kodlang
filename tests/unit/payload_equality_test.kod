// `==` and `hash` on optionals and on enums with payloads.
import "arrays"
import "sets" { Set }

type Tok = enum {
    Num(n: int64)
    Word(text: str, tags: [str])
    Eof
}

type Maybe = enum {
    Just(v: int64?)
    Nothing
}

type Tree = enum {
    Leaf(n: int64)
    Node(kids: [Tree])
}

type At = struct {
    pos: int64
    tok: Tok
}

func parse(anon s: str) -> Tok {
    return match s.parse_int() {
        Some(n) -> Tok.Num(:n)
        else -> Tok.Word(text: s, tags: [])
    }
}

test "an optional equals another of its type, or a value of it" {
    mut xs = [1, 2, 3]
    assert arrays.pop(mut xs) == 3
    assert arrays.pop(mut xs) != 3
    let a: int64? = 5
    let c: int64? = 5
    let b: int64? = none
    assert a == c
    assert a != b
    assert b == b
    assert a == 5
    assert 5 == a
    assert b != 5
    let s: str? = "x"
    assert s == "x"
    assert s != "y"
    let m = Map[str, bool]()
    assert m.get("missing") != true
}

test "enums compare variant and payload" {
    let t = Tok.Num(n: 1)
    assert t == .Num(n: 1)
    assert t != .Num(n: 2)
    assert t != Tok.Eof
    assert parse("hi") == .Word(text: "hi", tags: [])
    assert parse("hi") != .Word(text: "hi", tags: ["x"])
    assert [parse("1"), parse("a")] == [Tok.Num(n: 1), Tok.Word(text: "a", tags: [])]
    assert Maybe.Just(v: 3) == .Just(v: 3)
    assert Maybe.Just(v: 3) != .Just(v: none)
    assert Maybe.Just(v: none) == .Just(v: none)
    assert Tree.Node(kids: [.Leaf(n: 1)]) == .Node(kids: [.Leaf(n: 1)])
    assert Tree.Node(kids: [.Leaf(n: 1)]) != .Node(kids: [.Leaf(n: 2)])
    assert At(pos: 1, tok: .Eof) == At(pos: 1, tok: .Eof)
    assert At(pos: 1, tok: .Num(n: 2)) != At(pos: 1, tok: .Num(n: 3))
}

test "enums with payloads and optionals are keys" {
    mut m = Map[Tok, int64]()
    m.set(Tok.Num(n: 1), 10)
    m.set(Tok.Word(text: "a", tags: ["x"]), 20)
    m.set(Tok.Eof, 30)
    m.set(Tok.Num(n: 1), 11)
    assert len(m) == 3
    assert m[Tok.Num(n: 1), default: 0] == 11
    assert m[Tok.Word(text: "a", tags: ["x"]), default: 0] == 20
    assert m[Tok.Num(n: 2), default: -1] == -1
    mut o = Map[int64?, str]()
    o.set(none, "none")
    o.set(3, "three")
    let k: int64? = 3
    assert o[k, default: ""] == "three"
    assert o[none, default: ""] == "none"
    mut seen = Set[Tree]()
    seen.add(Tree.Node(kids: [.Leaf(n: 1)]))
    seen.add(Tree.Node(kids: [.Leaf(n: 1)]))
    seen.add(Tree.Leaf(n: 1))
    assert len(seen) == 2
    assert hash(Tok.Num(n: 1)) == hash(Tok.Num(n: 1))
    assert hash(Tok.Num(n: 1)) != hash(Tok.Num(n: 2))
    let none_int: int64? = none
    assert hash(none_int) != hash(k)
}
