interface Shape {
    func area(self) -> int64
}

type Box[T] = struct {
    v: T

    func area(self) -> int64 {
        return 7
    }
}

type IntBox = Box[int64]

func boxed() -> Shape {
    return IntBox(v: 3)
}

func holds_int_box(anon s: Shape) -> bool {
    return s is _: IntBox
}

func unbox(anon s: Shape) -> int64 {
    if s is b: IntBox {
        return b.v
    }
    return -1
}

