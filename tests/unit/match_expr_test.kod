// `match` as an expression: a function's return value and a let's value.
func digit_name(anon c: int64) -> str {
	return match c {
		'0' -> "zero"
		'1' -> "one"
		'2' -> "two"
		else "other"
	}
}

test "match on chars in a return" {
	assert digit_name('1') == "one"
	assert digit_name('2') == "two"
	assert digit_name('9') == "other"
}

test "match as a let value" {
	let x: int64 = 42
	let label: str = match x {
		1 -> "one"
		42 -> "forty-two"
		else "other"
	}
	assert label == "forty-two"
}
