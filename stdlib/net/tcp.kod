// TCP connections as file descriptors. See docs/io.md.
// kod:cc tcp.c

import "stream" { IoError, IoKind, os_error }
import "posix" { Fd, kod_io_errno }
import "time" { Duration }

extern func kod_tcp_connect(anon host: str, anon port: int64, anon timeout_ms: int64) -> int64
extern func kod_tcp_listen(anon host: str, anon port: int64, anon backlog: int64) -> int64
extern func kod_tcp_accept(anon fd: int64) -> int64
extern func kod_tcp_port(anon fd: int64) -> int64
extern func kod_tcp_set_timeout(anon fd: int64, anon ms: int64) -> int64
extern func kod_tcp_gai_message() -> str
extern func kod_tcp_idle(anon fd: int64) -> int64
extern func kod_fd_close(anon fd: int64) -> int64

func bad_input(anon op: str, anon detail: str) -> IoError {
    return IoError(kind: .InvalidInput, op: op, errno: 0, detail: detail)
}

// The error for a failed call that may have been a name that didn't resolve.
func last_error(anon op: str, resolving: str) -> IoError {
    let gai = kod_tcp_gai_message()
    if len(gai) > 0 and kod_io_errno() == 0 {
        return IoError(kind: .HostNotFound, op: resolving, errno: 0, detail: gai)
    }
    return os_error(op, errno: kod_io_errno())
}

func connect(anon host: str, port: int64, timeout: Duration = Duration(seconds: 10)) -> Fd or Error {
    let op = f"connect {host}:{port}"
    if len(host) == 0 {
        throw bad_input(op, "empty host")
    }
    if port < 0 or port > 65535 {
        throw bad_input(op, "port out of range")
    }
    let fd = kod_tcp_connect(host, port, timeout.ceil_ms())
    if fd < 0 {
        throw last_error(op, resolving: f"resolve {host}")
    }
    return Fd(fd: fd)
}

func set_timeout(anon f: Fd, timeout: Duration) -> none or Error {
    if kod_tcp_set_timeout(f.fd, timeout.ceil_ms()) < 0 {
        throw os_error("set timeout", errno: kod_io_errno())
    }
}

// True if nothing is waiting to be read from `f`: no data, and the peer has not
// closed it.
func is_idle(anon f: Fd) -> bool {
    return kod_tcp_idle(f.fd) != 0
}

type Listener = struct {
    fd: int64

    func accept(self) -> Fd or Error {
        let c = kod_tcp_accept(self.fd)
        if c < 0 {
            throw os_error("accept", errno: kod_io_errno())
        }
        return Fd(fd: c)
    }

    func port(self) -> int64 {
        return kod_tcp_port(self.fd)
    }

    func close(self) -> none or Error {
        if kod_fd_close(self.fd) < 0 {
            throw os_error("close", errno: kod_io_errno())
        }
    }
}

func listen(anon host: str, port: int64, backlog: int64 = 128) -> Listener or Error {
    let op = f"listen {host}:{port}"
    if port < 0 or port > 65535 {
        throw bad_input(op, "port out of range")
    }
    let fd = kod_tcp_listen(host, port, backlog)
    if fd < 0 {
        throw last_error(op, resolving: f"resolve {host}")
    }
    return Listener(fd: fd)
}
