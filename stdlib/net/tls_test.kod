import "net/tls" { connect, TlsStream }
import "net/tcp"
import "stream" { IoError, IoKind, BufReader, read_all, write_str }
import "process"
import "time"
import "io"

// These tests run `openssl s_server` from macOS's own /usr/bin/openssl, on a
// throwaway self-signed certificate for `localhost`.

func cert_path() -> str {
    return "build/tls_test_cert.pem"
}

func key_path() -> str {
    return "build/tls_test_key.pem"
}

func s(anon x: bytes) -> str {
    return kod_bytes_to_str(x)
}

func make_certificate() -> none {
    if io.is_file(cert_path()) and io.is_file(key_path()) {
        return
    }
    let r = process.run(["/usr/bin/openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout", key_path(), "-out", cert_path(), "-subj", "/CN=localhost", "-days", "30", "-addext", "subjectAltName=DNS:localhost", "-addext", "extendedKeyUsage=serverAuth"])
    assert r.status == 0
}

type Server = struct {
    pid: str
    port: int64
}

// Starts `s_server -www` on a free port, with `version` ("-tls1_2" or
// "-tls1_3"); it stops by itself after two minutes if a test dies.
func start_server(anon version: str) -> Server {
    make_certificate()
    let l = must tcp.listen("127.0.0.1", port: 0)
    let port = l.port()
    must l.close()
    let script = f"perl -e 'alarm 120; exec @ARGV' /usr/bin/openssl s_server -accept {port} -cert {cert_path()} -key {key_path()} -www -quiet {version} >/dev/null 2>&1 </dev/null & echo $!"
    let r = process.run(["sh", "-c", script])
    assert r.status == 0
    let pid = r.stdout.trim()
    mut tries: int64 = 0
    for tries < 100 {
        let c = tcp.connect("127.0.0.1", port: port)
        if c is Ok(conn) {
            must conn.close()
            return Server(pid: pid, port: port)
        }
        time.sleep_ms(50)
        tries = tries + 1
    }
    assert false
    return Server(pid: pid, port: port)
}

func stop(anon sv: Server) -> none {
    process.run(["kill", sv.pid])
}

func kind_of(anon r: TlsStream or Error) -> IoKind? {
    if r is Err(e) {
        if e is IoError(io) {
            return io.kind
        }
        return .Other
    }
    return none
}

func is_kind(anon r: TlsStream or Error, anon want: IoKind) -> bool {
    let k = kind_of(r)
    if k is none {
        return false
    }
    return (k? or .Other) == want
}

test "a request over TLS gets the server's answer" {
    let sv = start_server("-tls1_2")
    let conn = must connect("localhost", port: sv.port, trust_file: cert_path())
    must write_str(conn, "GET / HTTP/1.0\r\n\r\n")
    let answer = s(must read_all(conn))
    assert answer.starts_with("HTTP/1.0 200 ok")
    assert answer.contains("</HTML>")
    must conn.close()
    stop(sv)
}

test "a BufReader reads lines over TLS" {
    let sv = start_server("-tls1_2")
    let conn = must connect("localhost", port: sv.port, trust_file: cert_path())
    must write_str(conn, "GET / HTTP/1.0\r\n\r\n")
    let br = BufReader(inner: conn)
    assert ((must br.read_line())? or "!") == "HTTP/1.0 200 ok"
    must conn.close()
    stop(sv)
}

test "a certificate that is not trusted fails with a Tls error" {
    let sv = start_server("-tls1_2")
    let r = connect("localhost", port: sv.port)
    assert is_kind(r, .Tls)
    stop(sv)
}

test "a certificate for another name fails with a Tls error" {
    let sv = start_server("-tls1_2")
    let r = connect("127.0.0.1", port: sv.port, trust_file: cert_path())
    assert is_kind(r, .Tls)
    stop(sv)
}

test "a trust_file that is missing or holds no certificate is an error" {
    let sv = start_server("-tls1_2")
    assert connect("localhost", port: sv.port, trust_file: "build/no_such_file.pem") is Err(_)
    assert connect("localhost", port: sv.port, trust_file: key_path()) is Err(_)
    stop(sv)
}

test "a server that only speaks TLS 1.3 fails with a Tls error" {
    let sv = start_server("-tls1_3")
    let r = connect("localhost", port: sv.port, trust_file: cert_path())
    assert is_kind(r, .Tls)
    stop(sv)
}

test "a server that does not speak TLS fails" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let r = connect("127.0.0.1", port: l.port(), trust_file: "", timeout_ms: 300)
    assert r is Err(_)
    must l.close()
}

test "a silent server times the handshake out" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let r = connect("127.0.0.1", port: l.port(), trust_file: "", timeout_ms: 200)
    assert is_kind(r, .TimedOut)
    must l.close()
}

test "a refused connection is ConnectionRefused" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let port = l.port()
    must l.close()
    assert is_kind(connect("localhost", port: port), .ConnectionRefused)
}

test "a read times out after set_timeout" {
    let sv = start_server("-tls1_2")
    let conn = must connect("localhost", port: sv.port, trust_file: cert_path())
    must conn.set_timeout(ms: 150)
    let r = conn.read(10)
    assert r is Err(_)
    if r is Err(e) {
        if e is IoError(io) {
            assert io.kind == .TimedOut
        }
    }
    must conn.close()
    stop(sv)
}

test "closing twice or writing after close is an error, not a crash" {
    let sv = start_server("-tls1_2")
    let conn = must connect("localhost", port: sv.port, trust_file: cert_path())
    must conn.close()
    assert conn.close() is Err(_)
    assert conn.write(kod_str_to_bytes("x")) is Err(_)
    assert conn.read(10) is Err(_)
    stop(sv)
}
