    assert errs != ""
    assert errs.contains("tests/type_bare_generic_ctor.kod:7:13: error: unknown type `Box`; tests/type_bare_generic_ctor_dep.kod declares `Box`: write `type_bare_generic_ctor_dep.Box` or list it in the import (`{ Box }`)")
    assert errs.contains("tests/type_bare_generic_ctor.kod:8:13: error: unknown type `Wrap`; tests/type_bare_generic_ctor_dep.kod declares `Wrap`: write `type_bare_generic_ctor_dep.Wrap` or list it in the import (`{ Wrap }`)")
}

// A generic constructor of a type that only another module declares gets the
