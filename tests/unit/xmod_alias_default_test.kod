import "./../xmod_alias_default_dep"
import "./../xmod_alias_other"

test "defaults through import aliases in another module" {
    assert xmod_alias_default_dep.f() == 1
    assert xmod_alias_default_dep.level() == 1
    assert xmod_alias_default_dep.low() == 1
    assert xmod_alias_default_dep.Cfg().p.a == 1
    assert xmod_alias_other.seed() == 2
}
