// What the `print` methods were asked to show, in order.
mut shown: [str] = []

interface Printable {
    func print(self) -> none
}

type Point = shared struct {
    x: int64
    y: int64
    func print(self) -> none {
        shown += [f"Point({self.x}, {self.y})"]
    }
}

type Name = shared struct {
    value: str
    func print(self) -> none {
        shown += [self.value]
    }
}

func show(anon p: Printable) -> none {
    p.print()
}

test "a call through an interface reaches each struct's method" {
    let pt: Point = Point(x: 3, y: 4)
    let n: Name = Name(value: "hi")
    show(pt)
    show(n)
    assert shown == ["Point(3, 4)", "hi"]
}
