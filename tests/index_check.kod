// Indexing checks bounds with one compare when the index is in range; a
// negative index counts from the end, for reads, stores and `+=`, on arrays
// and strings, and one past either end panics with the index as counted.

func main() -> int64 {
    mut a: [int64] = [10, 20, 30]
    let s = "abc"
    a[-1] = 33
    a[-3] += 1
    a[1] = a[-2] * 2
    print(f"{a[-1]} {a[-3]} {a[0]} {a[1]} {a[2]}")
    print(f"{s[-1]} {s[-3]} {s[0]} {s[2]}")
    mut total: int64 = 0
    for i in 0..3 {
        total += a[i] + a[-1 - i]
    }
    print(total)
    let far = -4
    print(a[far])
    return 0
}

// expected output:
// 33 11 11 40 33
// 99 97 97 99
// 168
// expected stderr:
// panic: index -1 out of bounds for array of length 3
// expected status:
// 1
