// After `if x is ...`, `x` has the type the test proves in the block that runs.
interface Shape {
    func area(self) -> int64
}
type Circle = shared struct {
    r: int64

    func area(self) -> int64 {
        return 3 * self.r * self.r
    }
}
type Square = shared struct {
    s: int64

    func area(self) -> int64 {
        return self.s * self.s
    }
}
type Id = int64 | str

func circle_r(anon shape: Shape) -> int64 {
    if shape is Circle {
        return shape.r
    }
    return -1
}

// `is none` narrows the `else`, which can narrow again.
func id_text(anon id: Id | none) -> str {
    if id is none {
        return "none"
    } else if id is int64 {
        return f"int {id + 1}"
    } else if id is str {
        return f"str {len(id)}"
    }
    return "unreachable"
}

func plus_one(anon n: int64?) -> int64 {
    if n is not none {
        return n + 1
    }
    return 0
}

func chained(anon n: int64?) -> bool {
    if n is not none and n > 3 {
        return true
    }
    return false
}

func doubled(anon n: int64?) -> int64 {
    if n is Some {
        return n * 2
    }
    return 0
}

func not_square(anon s: Shape) -> str {
    if s is not Square {
        return "not a square"
    } else {
        return f"square {s.s}"
    }
}

func result_value(anon r: int64 or Error) -> int64 {
    if r is Ok {
        return r + 1
    }
    return 0
}

// A block that assigns to the name doesn't narrow it.
func reassigned(anon n: int64?) -> int64 {
    mut m = n
    if m is not none {
        m = none
        return 1
    }
    return 0
}

// After the block, the name has its declared type again.
mut seen: [int64] = []

func outside(anon n: int64?) -> str {
    if n is not none {
        seen += [n]
    }
    return f"{n is none}"
}

// An early exit narrows the rest of its block.
func total(anon xs: [int64?], limit: int64 or Error) -> int64 {
    if limit is Err(e) {
        print(e.to_str())
        return 0
    }
    mut sum = 0
    for x in xs {
        if x is none {
            continue
        }
        sum += x
    }
    if sum > limit {
        return limit
    }
    return sum
}

func circle_or(anon s: Shape) -> int64 {
    if s is not Circle {
        return -1
    }
    return s.r
}

func both(anon a: int64?, anon b: int64?) -> int64 {
    if a is none {
        return 0
    }
    if b is none {
        return a
    }
    return a + b
}

// A rest that assigns the name isn't narrowed.
func assigned_after(anon n: int64?) -> str {
    mut m = n
    if m is none {
        return "none"
    }
    m = none
    return f"{m is none}"
}

// A call that never returns ends the block as an exit does.
func die() -> none {
    panic("no value")
}

func helper_exit(anon n: int64?) -> int64 {
    if n is none {
        die()
    }
    return n
}

test "an early exit narrows the rest of the block" {
    assert helper_exit(3) == 3
    assert total([1, none, 3], limit: .Ok(value: 10)) == 4
    assert total([7, 8], limit: .Ok(value: 10)) == 10
    assert circle_or(Circle(r: 4)) == 4
    assert circle_or(Square(s: 4)) == -1
    assert both(1, 2) == 3
    assert both(5, none) == 5
    assert both(none, 2) == 0
    assert assigned_after(1) == "true"
}

test "is narrows the block that runs" {
    assert circle_r(Circle(r: 3)) == 3
    assert circle_r(Square(s: 1)) == -1
    assert id_text(none) == "none"
    assert id_text(4) == "int 5"
    assert id_text("ab") == "str 2"
    assert plus_one(5) == 6
    assert plus_one(none) == 0
    assert f"{chained(5)} {chained(2)} {chained(none)}" == "true false false"
    assert doubled(4) == 8
    assert not_square(Circle(r: 1)) == "not a square"
    assert not_square(Square(s: 2)) == "square 2"
    assert result_value(.Ok(value: 4)) == 5
    assert reassigned(1) == 1
}

test "after the block the name has its declared type" {
    assert outside(7) == "false"
    assert seen == [7]
}
