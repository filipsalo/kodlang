test "arguments converted for their parameters" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s * self.s }
        }
        type Color = enum {
            Red
            Green
        }
        func shape(anon s: Shape) -> int64 { return s.area() }
        func opt(anon n: int64?) -> int64 { return n? or 0 }
        func col(anon c: Color) -> int64 { return 0 }
        func take(anon xs: [Shape]) -> int64 { return len(xs) }
        func dbl(anon x: int64) -> int64 { return x * 2 }
        func apply(anon f: func(int64) -> int64, anon x: int64) -> int64 { return f(x) }
        func main() -> int64 {
            let n = shape(Sq(s: 2)) + opt(5) + opt(none) + col(.Red) + col(Color.Green)
            return n + take([]) + take([Sq(s: 1)]) + apply(dbl, 3)
        }
        """)
    assert len(errs) == 0
}

test "a method argument must have its parameter's type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Scaler {
            func scale(self, anon by: int64) -> int64
        }
        type Box = struct {
            n: int64
            func scale(self, anon by: int64) -> int64 { return self.n * by }
            func bump(self, by: int64 = 1) -> int64 { return self.n + by }
            func label(self, anon s: str) -> str { return s }
        }
        func main() -> int64 {
            let m = Map[str, int64]()
            m.set(5, 1)
            let g = m.get(5)
            let b = Box(n: 1)
            b.label(3)
            let s: Scaler = b
            s.scale("a")
            let c: Box? = b
            c?.bump(by: "a")
            "a".contains(5)
            return 0
        }
        """)
    assert len(errs) == 6
    assert errs[0].message == "error: expected `str`, got `int64`"
    assert errs[0].line == 12
    assert errs[1].message == "error: expected `str`, got `int64`"
    assert errs[1].line == 13
    assert errs[2].message == "error: expected `str`, got `int64`"
    assert errs[2].line == 15
    assert errs[3].message == "error: expected `int64`, got `str`"
    assert errs[3].line == 17
    assert errs[4].message == "error: expected `int64`, got `str`"
    assert errs[4].line == 19
    assert errs[5].message == "error: expected `str`, got `int64`"
    assert errs[5].line == 20
}

