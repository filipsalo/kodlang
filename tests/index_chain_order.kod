// An indexed or sliced value is computed before its index and bounds, and
// a comparison chain computes its operands left to right, each once, and
// stops at the first comparison that is false.

type Log = struct {
    text: str = ""
    n: int64 = 0

    func at(self, anon s: str, anon v: int64) -> int64 {
        self.text = self.text + s
        return v
    }

    func word(self, anon s: str) -> str {
        self.text = self.text + s
        return s
    }

    func ages(self) -> Map[str, int64] {
        self.text = self.text + "m"
        let m = Map[str, int64]()
        m["k"] = 7
        return m
    }

    func nums(self) -> [int64] {
        self.text = self.text + "a"
        return [10, 20, 30]
    }

    func tick(self) -> int64 {
        self.n += 1
        return self.n
    }

    func flush(self) -> str {
        let t = self.text
        self.text = ""
        return t
    }
}

type Grid = struct {
    w: int64

    func op_index(self, anon i: int64) -> int64 {
        return self.w * i
    }
}

func grid(anon log: Log) -> Grid {
    log.word("g")
    return Grid(w: 3)
}

func main() -> int64 {
    let l = Log()
    print(f"{l.nums()[l.at("i", 1)]} {l.flush()}")
    print(f"{l.word("str")[l.at("i", 0)]} {l.flush()}")
    print(f"{l.ages()[l.word("k")]? or 0} {l.flush()}")
    print(f"{grid(l)[l.at("i", 2)]} {l.flush()}")
    print(f"{len(l.nums()[l.at("lo", 0)..l.at("hi", 2)])} {l.flush()}")
    print(f"{l.word("str")[l.at("lo", 1)..]} {l.flush()}")
    print(f"{l.at("a", 1) < l.at("b", 2) < l.at("c", 3)} {l.flush()}")
    print(f"{l.at("a", 3) < l.at("b", 2) < l.at("c", 3)} {l.flush()}")
    print(f"{l.at("a", 1) < l.at("b", 0) < l.at("c", 3) < l.at("d", 4)} {l.flush()}")
    print(f"{l.word("x") < l.word("y") <= l.word("z")} {l.flush()}")
    print(f"{l.n < l.tick() < 5} {l.n}")
    return 0
}

// expected output:
// 20 ai
// 115 stri
// 7 mk
// 6 gi
// 2 alohi
// tr strlo
// true abc
// false ab
// false ab
// true xyz
// true 1
