// An annotated match and an `==` operand build implicit variants as the expected enum.
interface Shape {
    func area(self) -> int64
}

type Sq = shared struct {
    s: int64
    func area(self) -> int64 { return self.s * self.s }
}

type A = enum {
    Up
    Hit(n: int64)
    Miss
}

type B = enum {
    Miss
    Hit(n: int64)
    Up
}

type Maybe[T] = enum {
    Just(value: T)
    Nothing
}

func show(anon b: B) -> str {
    return match b {
        .Miss -> "miss"
        .Hit(n) -> f"hit {n}"
        .Up -> "up"
    }
}

func just(anon m: Maybe[int64]) -> str {
    return match m {
        .Just(v) -> f"just {v}"
        .Nothing -> "nothing"
    }
}

test "an annotated match builds its arms as the expected enum" {
    let k = 1
    let mb: B = match k {
        1 -> .Hit(n: 5)
        else -> .Miss
    }
    assert show(mb) == "hit 5"
    mut mc: B = .Up
    mc = match k {
        1 -> .Miss
        else -> .Up
    }
    assert show(mc) == "miss"
    let ys: [Shape] = match k {
        1 -> [Sq(s: 6)]
        else -> []
    }
    assert ys[0].area() == 36
    let m: Maybe[int64] = match k {
        1 -> .Just(value: 1)
        else -> .Nothing
    }
    assert just(m) == "just 1"
}

test "an == operand builds the other side's enum" {
    let b: B = .Up
    assert b == .Up
    assert .Up == b
    assert b != .Miss
    assert not (b == .Miss)
    let n: Maybe[int64] = .Nothing
    let m: Maybe[int64] = .Just(value: 1)
    assert n == .Nothing
    assert .Nothing == n
    assert m != .Nothing
    assert not (m == .Nothing)
}
