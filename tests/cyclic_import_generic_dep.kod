import "./unit/cyclic_import_generic_test"

type Cell[T] = shared struct {
    item: T
}

type PtBox = cyclic_import_generic_test.Box[cyclic_import_generic_test.Pt]
type PtCell = Cell[cyclic_import_generic_test.Pt]

func boxed(anon p: cyclic_import_generic_test.Pt) -> cyclic_import_generic_test.Box[cyclic_import_generic_test.Pt] {
    return PtBox(v: p)
}

func unbox(anon b: cyclic_import_generic_test.Box[cyclic_import_generic_test.Pt]) -> cyclic_import_generic_test.Pt {
    return b.v
}

func hold(anon ps: [cyclic_import_generic_test.Pt]) -> [Cell[cyclic_import_generic_test.Pt]] {
    mut out: [Cell[cyclic_import_generic_test.Pt]] = []
    for p in ps {
        out += [PtCell(item: p)]
    }
    return out
}

func first(anon cells: [Cell[cyclic_import_generic_test.Pt]]) -> cyclic_import_generic_test.Pt {
    return cells[0].item
}

