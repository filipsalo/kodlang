// A bare type name in a dep is an error there even when the entry declares
// that type, and the hint says where it is.
import "./type_bare_cross_module_late_dep"

type Late = struct {
    n: int64
}

func main() -> int64 {
    return type_bare_cross_module_late_dep.take(Late(n: 1))
}

// expected stderr:
// tests/type_bare_cross_module_late_dep.kod:1:19: error: unknown type `Late`; tests/type_bare_cross_module_late.kod declares `Late`: import it to use it here
// expected status:
// 1
