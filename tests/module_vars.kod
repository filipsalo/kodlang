// Module-level variables: worked out once at first use, shared by every function,
// read from other modules, assigned only in their own.
import "./module_vars_dep"
import "./module_vars_dep" { hits }

type Mode = enum {
    Fast
    Safe
}

type Point = struct {
    x: int64
    y: int64
}

mut counter: int64 = 0
mut total: float64 = 0.5
mut label: str = "start"
mut items: [int64] = [1, 2]
mut seen: Map[str, int64] = Map[str, int64]()
mut origin: Point = Point(x: 1, y: 2)
mut mode: Mode = Mode.Fast
mut last: str? = none
mut ready: bool = false
mut order: [str] = []

// Initializers run at first use, in that order, whatever order they're declared in.
mut first: int64 = note("first", value: second + 1)
mut second: int64 = note("second", value: 10)

func add_one(anon n: int64) -> int64 {
    return n + 1
}

// A constant or variable that holds a function is called like one.
let STEP: func(int64) -> int64 = add_one
mut step: func(int64) -> int64 = add_one

func note(anon what: str, value: int64) -> int64 {
    order += [what]
    return value
}

func bump() -> int64 {
    counter += 1
    return counter
}

func remember(anon key: str) -> none {
    seen.set(key, len(seen))
    last = key
}

func main() -> int64 {
    bump()
    bump()
    print_int(bump())
    total = total * 3.0
    print(f"{total}")
    label = label + "-" + "end"
    print(label)
    items += [3]
    items[0] = 10
    print(", ".join([str(items[0]), str(items[1]), str(items[2])]))
    remember("a")
    remember("b")
    print_int(seen.get("b")? or -1)
    print(last? or "none")
    origin.x = 5
    origin = Point(x: origin.x, y: 9)
    print(f"{origin.x} {origin.y}")
    mode = .Safe
    print(str(mode is .Safe))
    ready = not ready
    print(str(ready))
    print_int(first)
    print(" ".join(order))

    module_vars_dep.hit("x")
    print_int(module_vars_dep.hit("y"))
    print_int(hits)
    print(" ".join(module_vars_dep.names))
    module_vars_dep.names[0] = "z"
    print(module_vars_dep.names[0])
    print("before greeting")
    print(module_vars_dep.greeting)
    print(module_vars_dep.greeting)
    module_vars_dep.set_secret("shown")
    print(module_vars_dep.secret())

    print_int(STEP(1) + step(2))
    let offset = 100
    step = func(n: int64) -> int64 { return n + offset }
    print_int(step(2))
    print_int(module_vars_dep.transform(5))
    module_vars_dep.use_square()
    print_int(module_vars_dep.transform(5))

    // A local hides the variable.
    let counter = 100
    print_int(counter)
    return 0
}

// expected output:
// 3
// 1.5
// start-end
// 10, 2, 3
// 1
// b
// 5 9
// true
// true
// 11
// second first
// 2
// 2
// x y
// z
// before greeting
// greeting worked out
// hello
// hello
// shown
// 5
// 102
// 10
// 25
// 100
