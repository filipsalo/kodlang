// Says it is ready, waits for a line on stdin, answers and exits 3.
// tests/stdio_test.py runs it with `kod run` and talks to it through pipes.
import "io"

func main() -> int64 {
    print("ready")
    io.flush_stdout()
    let line: str = io.read_stdin_line()
    print(f"got {line}")
    return 3
}

// expected mode:
// skip
