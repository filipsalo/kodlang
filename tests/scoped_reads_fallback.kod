// Outside where a local is bound, its name means the function of that
// name, both as a value and in a call.
func f() -> int64 {
    return 1
}

func one() -> int64 {
    return 1
}

func twice(anon x: int64) -> int64 {
    return x * 2
}

func apply(anon g: func(int64) -> int64, anon x: int64) -> int64 {
    return g(x)
}

func main() -> int64 {
    if true {
        let f = func() -> int64 {
            return 2
        }
        print_int(f())
        let g = f
        print_int(g())
    }
    print_int(f())
    let g = f
    print_int(g())
    mut n = 0
    for k in [1] {
        let twice = func(anon x: int64) -> int64 {
            return x * 100
        }
        n += apply(twice, k)
    }
    n += apply(twice, 1)
    print_int(n)
    let z = one
    let one = 7
    print_int(z() + one)
    mut label = "other"
    if n > 0 {
        label = "positive"
    }
    print(label)
    return 0
}

// expected output:
// 2
// 2
// 1
// 1
// 102
// 8
// positive
