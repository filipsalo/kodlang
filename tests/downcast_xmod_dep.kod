interface Named {
    func name(self) -> str
}

type Pt = struct {
    x: int64

    func name(self) -> str {
        return f"pt{self.x}"
    }
}

type Oops = struct {
    code: int64

    func to_str(self) -> str {
        return f"oops {self.code}"
    }
}

func boxed() -> Named {
    return Pt(x: 42)
}

func fail(anon n: int64) -> int64 or Error {
    if n > 0 {
        throw Oops(code: n + 10)
    }
    return n
}

func which(anon n: Named) -> str {
    if n is Pt(p) {
        return f"dep sees pt {p.x}"
    }
    return "dep sees another"
}

