// Each module's type names are its own: two modules may declare a type of
// one name, and they are different types wherever a value was made.
import "./../type_names_pa"
import "./../type_names_pb"
import "./../type_names_re"

interface Sized {
    func size(self) -> int64
}

type Pt = shared struct {
    x: int64

    func size(self) -> int64 {
        return 100 + self.x
    }
}

type Shape = enum {
    Circle(r: int64)
    Line(n: int64)
}

type Mode = enum {
    On
    Off
}

type Label = bool

// One template, different arguments, and two same-named templates.
type PaPtBox = type_names_pa.Box[type_names_pa.Pt]
type PbPtBox = type_names_pa.Box[type_names_pb.Pt]
type MyPtBox = type_names_pa.Box[Pt]
type OtherMyPtBox = type_names_pb.Box[Pt]
// Arguments nested in an array, an optional and a generic instance.
type ArrBox = type_names_pa.Box[[type_names_pa.Pt]]
type OptBox = type_names_pa.Box[type_names_pa.Pt?]
type MapBox = type_names_pa.Box[Map[str, type_names_pa.Pt]]
type PbArrBox = type_names_pa.Box[[type_names_pb.Pt]]

func area(anon s: Shape) -> int64 {
    match s {
        .Circle(r) -> return r * 5
        .Line(n) -> return n
    }
}

func show(anon s: Sized) -> str {
    return f"{s is type_names_pa.Pt} {s is type_names_pb.Pt} {s is Pt} {s is type_names_pa.IntBox} {s is type_names_pb.IntBox}"
}

test "same-named structs and interfaces" {
    // Same-named structs, each with its own layout and methods.
    let a = type_names_pa.make(1)
    let b = type_names_pb.make(2, 3)
    let c = Pt(x: 4)
    assert a.size() == 1
    assert b.size() == 5
    assert c.size() == 104
    // `is` tells the declarations apart wherever the value was boxed.
    assert show(a) == "true false false false false"
    assert show(b) == "false true false false false"
    assert show(c) == "false false true false false"
    assert show(type_names_pa.IntBox(v: 7)) == "false false false true false"
    assert show(type_names_pb.IntBox(v: 8)) == "false false false false true"
    assert f"{type_names_pa.is_pt(a)} {type_names_pb.is_pt(a)} {type_names_pa.is_pt(b)} {type_names_pb.is_pt(b)}" == "true false false true"
    let sb: Sized = b
    let got = match sb {
        type_names_pa.Pt(p) -> p.x
        type_names_pb.Pt(p) -> p.y
        else -> -1
    }
    assert got == 3
    if sb is type_names_pb.Pt(p) {
        assert p.x + p.y == 5
    } else {
        fail("not a pb.Pt")
    }
}

test "same-named generic templates and their instances" {
    let a = type_names_pa.make(1)
    let b = type_names_pb.make(2, 3)
    let c = Pt(x: 4)
    // Two same-named generic templates: each instance belongs to its template.
    let ia = type_names_pa.IntBox(v: 1)
    let ib = type_names_pb.IntBox(v: 1)
    assert f"{type_names_pa.is_int_box(ia)} {type_names_pb.is_int_box(ia)} {type_names_pa.is_int_box(ib)} {type_names_pb.is_int_box(ib)} {ia.size()} {ib.size()}" == "true false false true 1 2"
    // Boxed in the module that declares it, tested here.
    let boxed_a = type_names_pa.boxed(7)
    let boxed_b = type_names_pb.boxed(8)
    assert f"{boxed_a is type_names_pa.IntBox} {boxed_a is type_names_pb.IntBox} {boxed_b is type_names_pa.IntBox} {boxed_b is type_names_pb.IntBox}" == "true false false true"
    // One template with same-named arguments: different instances.
    let pab: Sized = PaPtBox(v: a)
    let pbb: Sized = PbPtBox(v: b)
    let myb: Sized = MyPtBox(v: c)
    let omb: Sized = OtherMyPtBox(v: c)
    assert f"{pab is PaPtBox} {pab is PbPtBox} {pbb is PbPtBox} {pbb is PaPtBox} {myb is MyPtBox} {myb is OtherMyPtBox} {omb is OtherMyPtBox} {omb is MyPtBox}" == "true false true false true false true false"
    // Nested argument kinds.
    let arr: Sized = ArrBox(v: [a])
    let opt: Sized = OptBox(v: none)
    let mp: Sized = MapBox(v: Map[str, type_names_pa.Pt]())
    assert f"{arr is ArrBox} {arr is OptBox} {arr is MapBox} {opt is OptBox} {opt is ArrBox} {mp is MapBox} {mp is OptBox}" == "true false false true false true false"
    // The same, boxed in the module that declares the template, and tested there.
    let na = type_names_pa.boxed_nested(0)
    let nb = type_names_pa.boxed_nested(1)
    let nc = type_names_pa.boxed_nested(2)
    assert f"{na is ArrBox} {na is PbArrBox} {nb is OptBox} {nb is ArrBox} {nc is MapBox} {nc is OptBox}" == "true false true false true false"
    assert f"{type_names_pa.is_arr_box(ArrBox(v: [a]))} {type_names_pa.is_arr_box(PbArrBox(v: [b]))}" == "true false"
}

test "same-named enums" {
    // Same-named enums: `m.E.V`, a match in each module, and Map keys of each.
    assert type_names_pa.area(type_names_pa.Shape.Circle(r: 2)) == 6
    assert type_names_pb.area(type_names_pb.Shape.Circle(r: 2)) == 8
    assert area(Shape.Circle(r: 2)) == 10
    assert type_names_pa.area(.Dot) == 0
    assert type_names_pb.area(.Square(s: 3)) == 9
    assert area(.Line(n: 7)) == 7
    mut ma = Map[type_names_pa.Mode, int64]()
    ma[type_names_pa.Mode.On] = 1
    mut mb = Map[type_names_pb.Mode, int64]()
    mb[type_names_pb.Mode.On] = 2
    mb[.Dim] = 3
    mut mc = Map[Mode, int64]()
    mc[Mode.Off] = 4
    assert f"{ma[type_names_pa.Mode.On]? or -1} {ma[.Off]? or -1} {mb[.On]? or -1} {mb[type_names_pb.Mode.Dim]? or -1} {mc[Mode.Off]? or -1} {mc[.On]? or -1}" == "1 -1 2 3 4 -1"
}

test "same-named generic enums and error types" {
    if type_names_pa.just(1) is .Just(ja) {
        assert ja == 1
    } else {
        fail("pa.just is not Just")
    }
    if type_names_pb.just(1) is .Just(jb) {
        assert jb == 2
    } else {
        fail("pb.just is not Just")
    }
    match type_names_pa.fail(5) {
        Ok(n) -> fail(f"ok {n}")
        Err(ea) -> assert f"{ea is type_names_pa.Oops} {ea is type_names_pb.Oops} {ea.to_str()}" == "true false pa oops 5"
    }
    match type_names_pb.fail(6) {
        Ok(n) -> fail(f"ok {n}")
        Err(eb) -> assert f"{eb is type_names_pa.Oops} {eb is type_names_pb.Oops} {eb.to_str()}" == "false true pb oops 6"
    }
}

test "same-named aliases" {
    // Aliases of different types may share a name.
    assert type_names_pa.describe("x") == "pa label x"
    let lb = type_names_pb.Label(text: "t")
    let my: Label = true
    let sa: type_names_pa.Score = [1, 2]
    let sc: type_names_pb.Score = 3
    assert lb.text == "t"
    assert my
    assert len(sa) == 2
    assert sc == 3
    // An alias passes a type on under its own name.
    let r: type_names_re.Pt = type_names_re.origin()
    let rb = type_names_re.boxed()
    assert f"{r.size()} {rb is type_names_re.Pt} {rb is type_names_pb.Pt} {rb is type_names_pa.Pt}" == "0 true true false"
    assert type_names_pa.far_pt().z == 9
}
