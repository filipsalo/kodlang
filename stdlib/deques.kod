// A double-ended queue on a ring buffer: O(1) at both ends.
//
// API: `Deque[T]()`, `push_back`, `push_front`, `pop_front`, `pop_back`,
// `front`, `back`, `len`, `is_empty`, `values`.
//
// The ring holds `count` elements from `head`, wrapping around. Slots outside
// them hold copies of elements still in it, never ones taken out, so nothing
// is kept alive that the deque no longer has; an empty deque holds none.
type Deque[T] = struct {
    ring: [T] = []
    head: int64 = 0
    count: int64 = 0

    func push_back(mut self, anon item: T) -> none {
        self.make_room(item)
        self.ring[(self.head + self.count) % len(self.ring)] = item
        self.count += 1
    }

    func push_front(mut self, anon item: T) -> none {
        self.make_room(item)
        self.head = (self.head + len(self.ring) - 1) % len(self.ring)
        self.ring[self.head] = item
        self.count += 1
    }

    // The first element, taken out, or none when there are none.
    func pop_front(mut self) -> T? {
        if self.count == 0 {
            return none
        }
        let item = self.ring[self.head]
        self.count -= 1
        if self.count == 0 {
            self.clear()
            return item
        }
        // The slot gets a copy of the new first element.
        let next = (self.head + 1) % len(self.ring)
        self.ring[self.head] = self.ring[next]
        self.head = next
        return item
    }

    // The last element, taken out, or none when there are none.
    func pop_back(mut self) -> T? {
        if self.count == 0 {
            return none
        }
        let last = (self.head + self.count - 1) % len(self.ring)
        let item = self.ring[last]
        self.count -= 1
        if self.count == 0 {
            self.clear()
            return item
        }
        self.ring[last] = self.ring[self.head]
        return item
    }

    func front(self) -> T? {
        if self.count == 0 {
            return none
        }
        return self.ring[self.head]
    }

    func back(self) -> T? {
        if self.count == 0 {
            return none
        }
        return self.ring[(self.head + self.count - 1) % len(self.ring)]
    }

    func len(self) -> int64 {
        return self.count
    }

    func is_empty(self) -> bool {
        return self.count == 0
    }

    // The elements, front to back, as a new array.
    func values(self) -> [T] {
        let n = len(self.ring)
        return [self.ring[(self.head + i) % n] for i in 0..self.count]
    }

    func clear(mut self) -> none {
        self.ring = []
        self.head = 0
        self.count = 0
    }

    // Room for one more: a full ring doubles, its elements laid out from 0 and the
    // new slots filled with copies of `item`.
    func make_room(mut self, anon item: T) -> none {
        let n = len(self.ring)
        if self.count < n {
            return
        }
        if n == 0 {
            self.ring = [item] * 4
            self.head = 0
            return
        }
        self.ring = self.values() + [item] * n
        self.head = 0
    }
}
