import "io"
import "testing"
import "unsafe"

test "durations keep three significant figures" {
    assert testing.format_duration(208) == "0.21 μs"
    assert testing.format_duration(3920) == "3.92 μs"
    assert testing.format_duration(45678) == "45.7 μs"
    assert testing.format_duration(123456) == "123 μs"
    assert testing.format_duration(1234567) == "1.23 ms"
    assert testing.format_duration(12345678) == "12.3 ms"
    assert testing.format_duration(1234567890) == "1.23 s"
    assert testing.format_duration(61000000000) == "61.0 s"
}

test "a duration rounds half up" {
    assert testing.format_duration(1005) == "1.01 μs"
    assert testing.format_duration(9994) == "9.99 μs"
    assert testing.format_duration(999) == "1.00 μs"
}

test "a zero duration is below the clock's resolution" {
    let s = testing.format_duration(0)
    assert s.starts_with("<0.")
    assert s.ends_with(" μs")
}

// testing.run: a function in a process of its own.

test "run gives what the function printed and its status" {
    let r = testing.run(func() {
        print("out")
        kod_eprint("err")
    })
    assert r.status == 0
    assert r.signal == 0
    assert r.stdout == "out\n"
    assert r.stderr == "err\n"
}

test "run reports a panic with status 1 and its message" {
    let r = testing.run(func() {
        let xs = [1]
        print_int(xs[5])
    })
    assert r.status == 1
    assert r.stderr.contains("panic: index 5 out of bounds for array of length 1")
}

test "run reports fail with status 2" {
    let r = testing.run(func() {
        fail("not like this")
    })
    assert r.status == 2
    assert r.stderr.contains("not like this")
}

test "an assert in run's function panics, as outside a test" {
    let r = testing.run(func() {
        assert 1 == 2
    })
    assert r.status == 1
    assert r.stderr.contains("1 == 2")
}

test "run reports the signal that ended it" {
    let r = testing.run(func() {
        let _ = unsafe.load64(8)
    })
    assert r.status == -1
    assert r.signal == 11
}

test "run gives the function the stdin asked for" {
    let r = testing.run(func() {
        print(io.read_stdin_line())
        print(io.read_stdin_line())
    }, stdin: "a\nb\n")
    assert r.stdout == "a\nb\n"
}

test "run keeps what the child changes in the child" {
    mut n = 1
    let r = testing.run(func() {
        n += 1
        print_int(n)
    })
    assert r.stdout == "2\n"
    assert n == 1
}

test "run takes output of any size" {
    let r = testing.run(func() {
        for i in 0..100000 {
            print_int(i)
        }
    })
    assert r.status == 0
    assert len(r.stdout.split("\n")) == 100001
}

test "run captures C's own stdout buffer too" {
    let r = testing.run(func() {
        print("a")
        putchar(98)
    })
    assert r.stdout.contains("a\n")
    assert r.stdout.contains("b")
}
