// A function named like an import alias doesn't hide the module.
import "./alias_func_dep"

func alias_func_dep() -> int64 {
    return 5
}

func high() -> alias_func_dep.Tone {
    return .High
}

func bumped(n: int64 = alias_func_dep.value() + 1) -> int64 {
    return n
}

type Holder = struct {
    a: int64 = alias_func_dep.value()
}

func checked(anon n: int64) -> alias_func_dep.R {
    if n < 0 {
        throw alias_func_dep.Oops(code: n)
    }
    return n * 2
}

func doubled(anon n: int64) -> alias_func_dep.R {
    let v = try checked(n)
    return v + 1
}

func main() -> int64 {
    print_int(alias_func_dep())
    print_int(alias_func_dep.value())
    let p: alias_func_dep.Pt = alias_func_dep.make(7)
    print_int(p.x)
    print_int(alias_func_dep.rank(high()))
    let f = alias_func_dep
    print_int(f())
    print_int(bumped() + Holder().a)
    match checked(4) {
        .Ok(v) -> print_int(v)
        .Err(e) -> print(f"err {e}")
    }
    match doubled(-3) {
        .Ok(v) -> print_int(v)
        .Err(e) -> print(f"err {e}")
    }
    return 0
}

// expected output:
// 5
// 1
// 7
// 2
// 5
// 3
// 8
// err oops -3
