test "another key's signature" {
    let other = must PublicKey(.P256, point: h("04eadaa52b02c10f698e2bf6a3147c05d810a3706d63b232fd4c80844d196a162c8a2595b02b0af9ec347c22e7d6e8310522f81a3d2daa06a942399c52723a9dba"))
    assert not other.verify(algo: .Sha256, message: b"The quick brown fox jumps over the lazy dog", signature: h("3044022023fa6c9f7f838630f61f7b18fa216bede25f2b30df54d9cb6295041bbc7491d80220748465a977e5daf15f2dd0679f8db886e08ab30db1642e6c5489149f8b006f71"))
    let mine = must PublicKey(.P256, point: h("04247c7c7e2bb9f084bef617c95bafd53040496c8ebb665080ec2d3c30167ab5fed1b8c89ddec4a8e895eeee05045cd4372ca5bb63fd2d6ace8d3dcae83f5682ab"))
    assert mine.verify(algo: .Sha256, message: b"The quick brown fox jumps over the lazy dog", signature: h("3044022023fa6c9f7f838630f61f7b18fa216bede25f2b30df54d9cb6295041bbc7491d80220748465a977e5daf15f2dd0679f8db886e08ab30db1642e6c5489149f8b006f71"))
}

test "keys refused" {
    let good = h("04247c7c7e2bb9f084bef617c95bafd53040496c8ebb665080ec2d3c30167ab5fed1b8c89ddec4a8e895eeee05045cd4372ca5bb63fd2d6ace8d3dcae83f5682ab")
    assert PublicKey(.P256, point: flip(good, 64)) is Error
    assert PublicKey(.P256, point: good[..64]) is Error
    assert PublicKey(.P384, point: good) is Error
    assert PublicKey(.P256, point: h("02") + good[1..]) is Error
    assert PublicKey(.P256, point: h("04") + kod_bytes_from_array([255] * 64)) is Error
}

test "signatures that aren't strict DER" {
    let key = must PublicKey(.P256, point: h("04247c7c7e2bb9f084bef617c95bafd53040496c8ebb665080ec2d3c30167ab5fed1b8c89ddec4a8e895eeee05045cd4372ca5bb63fd2d6ace8d3dcae83f5682ab"))
    let sig = h("3044022023fa6c9f7f838630f61f7b18fa216bede25f2b30df54d9cb6295041bbc7491d80220748465a977e5daf15f2dd0679f8db886e08ab30db1642e6c5489149f8b006f71")
    let message = b"The quick brown fox jumps over the lazy dog"
    assert key.verify(algo: .Sha256, message: message, signature: sig)
    assert not key.verify(algo: .Sha256, message: message, signature: sig + h("00"))
    assert not key.verify(algo: .Sha256, message: message, signature: sig[..len(sig) - 1])
    assert not key.verify(algo: .Sha256, message: message, signature: h("3081") + sig[1..])
    let Some((r, s)) = ecdsa.parse_signature(sig) else { panic("not DER") }
    let zero = h("00")
    assert not key.verify_rs(algo: .Sha256, message: message, r: zero, s: s)
    assert not key.verify_rs(algo: .Sha256, message: message, r: r, s: zero)
    let n = h("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")
    assert not key.verify_rs(algo: .Sha256, message: message, r: r, s: n)
    assert not key.verify(algo: .Sha256, message: message, signature: h("3006020100020101"))
    assert ecdsa.parse_signature(h("300802020001020101")) is none
    assert ecdsa.parse_signature(h("3006020181020101")) is none
}
