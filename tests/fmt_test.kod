// `kod fmt` (docs/cli.md): rewriting files and directories, `--check`, and
// files that don't parse. Each test works in a directory of its own under
// build/, made and removed by the test.

import "io"
import "libc"
import "process"

let UNFORMATTED: str = "func f() {\nlet x=1\n}\n"
let FORMATTED: str = "func f() {\n    let x = 1\n}\n"

// The repository root, where the tests run.
func root() -> str {
    return (must process.output(["pwd"])).stdout.trim()
}

// A fresh scratch directory under build/, as an absolute path.
func scratch(anon name: str) -> str {
    let dir = f"{root()}/build/tmp_fmt_{name}_{libc.getpid()}"
    let _gone = process.run(["rm", "-rf", dir])
    let _made = process.run(["mkdir", "-p", f"{dir}/sub/.hidden", f"{dir}/build"])
    return dir
}

func remove(anon dir: str) -> none {
    let _gone = process.run(["rm", "-rf", dir])
}

// `kod fmt` with `args`, run in `dir`.
func fmt_in(anon dir: str, anon args: [str]) -> process.Output {
    let kod = f"{root()}/build/apps/kod/kod"
    return must process.output([kod, "fmt"] + args, :dir)
}

test "kod fmt rewrites the files it is given and those below a directory, and names them" {
    let dir = scratch("rewrite")
    io.write_file(f"{dir}/a.kod", UNFORMATTED)
    io.write_file(f"{dir}/sub/b.kod", UNFORMATTED)
    io.write_file(f"{dir}/sub/done.kod", FORMATTED)
    io.write_file(f"{dir}/sub/notes.txt", UNFORMATTED)
    let r = fmt_in(dir, ["a.kod", "sub"])
    let a = io.read_file(f"{dir}/a.kod")
    let b = io.read_file(f"{dir}/sub/b.kod")
    let notes = io.read_file(f"{dir}/sub/notes.txt")
    remove(dir)
    assert r.status == 0
    assert r.stdout == "a.kod\nsub/b.kod\n"
    assert a == FORMATTED
    assert b == FORMATTED
    assert notes == UNFORMATTED
}

test "kod fmt skips directories whose names start with a dot, and build/" {
    let dir = scratch("skip")
    io.write_file(f"{dir}/sub/.hidden/c.kod", UNFORMATTED)
    io.write_file(f"{dir}/build/d.kod", UNFORMATTED)
    let r = fmt_in(dir, ["."])
    let c = io.read_file(f"{dir}/sub/.hidden/c.kod")
    let d = io.read_file(f"{dir}/build/d.kod")
    remove(dir)
    assert r.status == 0
    assert r.stdout == ""
    assert c == UNFORMATTED
    assert d == UNFORMATTED
}

test "kod fmt --check writes nothing, names what would change, and exits 1 if anything would" {
    let dir = scratch("check")
    io.write_file(f"{dir}/a.kod", UNFORMATTED)
    io.write_file(f"{dir}/b.kod", FORMATTED)
    let unformatted = fmt_in(dir, ["--check", "a.kod", "b.kod"])
    let a = io.read_file(f"{dir}/a.kod")
    let formatted = fmt_in(dir, ["--check", "b.kod"])
    remove(dir)
    assert unformatted.status == 1
    assert unformatted.stdout == "a.kod\n"
    assert a == UNFORMATTED
    assert formatted.status == 0
    assert formatted.stdout == ""
}

test "kod fmt leaves a file with a syntax error alone, shows the error and exits 1" {
    let dir = scratch("bad")
    io.write_file(f"{dir}/bad.kod", "func f( {\nlet x=1\n")
    io.write_file(f"{dir}/a.kod", UNFORMATTED)
    let r = fmt_in(dir, ["bad.kod", "a.kod"])
    let bad = io.read_file(f"{dir}/bad.kod")
    let a = io.read_file(f"{dir}/a.kod")
    remove(dir)
    assert r.status == 1
    assert r.stderr.contains("bad.kod:1:9: error:")
    assert bad == "func f( {\nlet x=1\n"
    // The other files are formatted all the same.
    assert a == FORMATTED
}

test "kod fmt with a path that isn't there says so and exits 1" {
    let dir = scratch("missing")
    let r = fmt_in(dir, ["nothere"])
    remove(dir)
    assert r.status == 1
    assert r.stderr.contains("kod fmt: no such file or directory: nothere")
}
