// A store evaluates its receiver, then its index or key, then the value,
// and a compound `+=` or `-=` evaluates each of them once.
type Grid = struct {
    cells: [int64] = [0, 0, 0]

    func op_index(self, anon i: int64) -> int64 {
        return self.cells[i]
    }

    func op_index_set(self, anon i: int64, anon v: int64) -> none {
        self.cells[i] = v
    }
}

type Cell = struct {
    v: int64 = 0
}

type Log = struct {
    text: str = ""
    n: int64 = 0

    func at(self, anon tag: str, anon v: int64) -> int64 {
        self.text = self.text + tag
        return v
    }

    func key(self, anon tag: str) -> str {
        self.text = self.text + tag
        return tag
    }

    func arr(self, anon xs: [int64]) -> [int64] {
        self.text = self.text + "r"
        return xs
    }

    func grid(self, anon g: Grid) -> Grid {
        self.text = self.text + "r"
        return g
    }

    func cell(self, anon c: Cell) -> Cell {
        self.text = self.text + "r"
        return c
    }

    func tick(self) -> int64 {
        self.n += 1
        return self.n
    }

    func show(self) -> none {
        print(self.text)
        self.text = ""
    }
}

func main() -> int64 {
    let l = Log()
    let xs = [0, 0, 0]
    xs[l.tick()] = l.tick() * 10
    print(f"{xs[0]} {xs[1]} {xs[2]}")
    l.arr(xs)[l.at("i", 0)] = l.at("v", 5)
    l.show()
    xs[l.at("i", 2)] = l.at("v", 7)
    l.show()
    let m = Map[str, int64]()
    m[l.key("k")] = l.at("v", 3)
    l.show()
    let g = Grid()
    l.grid(g)[l.at("i", 1)] = l.at("v", 9)
    l.show()
    let c = Cell()
    l.cell(c).v = l.at("v", 6)
    l.show()
    l.arr(xs)[l.at("i", 2)] += l.at("v", 4)
    l.show()
    l.grid(g)[l.at("i", 1)] += l.at("v", 1)
    l.show()
    l.cell(c).v -= l.at("v", 2)
    l.show()
    print(f"{xs[0]} {xs[1]} {xs[2]} {m["k"]? or 0} {g[1]} {c.v}")
    return 0
}

// expected output:
// 0 20 0
// riv
// iv
// kv
// riv
// rv
// riv
// riv
// rv
// 5 20 11 3 10 4
