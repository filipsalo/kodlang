// `==` and `!=` compare arrays element by element; f-strings, `str` and
// `print` show them as their elements in brackets.

type Color = enum {
    Red
    Green

    func to_str(self) -> str {
        match self {
            .Red -> return "red"
            .Green -> return "green"
        }
    }
}

type Point = shared struct {
    x: int64
    y: int64

    func to_str(self) -> str {
        return f"({self.x}, {self.y})"
    }

    func op_eq(self, anon other: Point) -> bool {
        return self.x == other.x and self.y == other.y
    }
}

func main() -> int64 {
    print([1, 2] == [1, 2])
    print([1, 2] == [2, 1])
    print([1, 2] == [1, 2, 3])
    print(["a", "b"] != ["a", "b"])
    print([[1], [2, 3]] == [[1], [2, 3]])
    let none_yet: [int64] = []
    print(none_yet == [])
    print([Color.Red] == [Color.Red])
    print([Point(x: 1, y: 2)] == [Point(x: 1, y: 2)])
    print([true, false] != [true, true])

    print([1, 2, 3])
    print(f"{["a", "b"]}")
    print(str([[1], []]))
    print(none_yet)
    print([Color.Red, Color.Green])
    print([Point(x: 1, y: 2)])
    print(f"flags {[true, false]} and {[1.5]}")
    return 0
}

// expected output:
// true
// false
// false
// false
// true
// true
// true
// true
// true
// [1, 2, 3]
// [a, b]
// [[1], []]
// []
// [red, green]
// [(1, 2)]
// flags [true, false] and [1.5]
// expected status:
// 0
