// Until blocks get scopes, a block's function value can be called after it.
func twice(anon n: int64) -> int64 {
    return n * 2
}

func main() -> int64 {
    if true {
        let f = func(anon n: int64) -> int64 {
            return n + 1
        }
        let twice = func(anon n: int64) -> int64 {
            return n * 100
        }
        print_int(f(1))
        print_int(twice(1))
    }
    print_int(f(2))
    print_int(twice(2))
    return 0
}

// expected output:
// 2
// 100
// 3
// 4
