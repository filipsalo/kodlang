// Environment variables. See docs/builtins.md.

extern func kod_env_has(anon name: str) -> int64
extern func kod_env_get(anon name: str) -> str
extern func kod_env_set(anon name: str, anon value: str) -> int64
extern func kod_env_unset(anon name: str) -> none

// A name an environment can hold: not empty, no `=`, no NUL byte.
func valid_name(anon name: str) -> bool {
    if len(name) == 0 {
        return false
    }
    let n = len(name)
    mut i: int64 = 0
    for i < n {
        if name[i] == 61 or name[i] == 0 {
            return false
        }
        i = i + 1
    }
    return true
}

func has_nul(anon s: str) -> bool {
    let n = len(s)
    mut i: int64 = 0
    for i < n {
        if s[i] == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

func get(anon name: str) -> str? {
    if valid_name(name) == false or kod_env_has(name) == 0 {
        return none
    }
    return kod_env_get(name)
}

func set(anon name: str, anon value: str) -> none or Error {
    if valid_name(name) == false {
        throw InvalidName(name: name)
    }
    if has_nul(value) {
        throw InvalidValue(name: name)
    }
    if kod_env_set(name, value) < 0 {
        throw InvalidName(name: name)
    }
}

func unset(anon name: str) -> none {
    if valid_name(name) {
        kod_env_unset(name)
    }
}

type InvalidName = struct {
    name: str

    func to_str(self) -> str {
        return "env: " + self.name + " is not a valid variable name"
    }
}

type InvalidValue = struct {
    name: str

    func to_str(self) -> str {
        return "env: the value for " + self.name + " has a NUL byte"
    }
}
