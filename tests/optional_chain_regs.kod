// `?.` on a field and on a method leaves the register pool intact, so the
// values computed after it each keep their own register.
type Tag = struct {
    name: str
    n: int64
    func up(self) -> str { return self.name + "!" }
}

func find(anon k: int64) -> Tag? {
    if k > 0 {
        return Tag(name: f"t{k}", n: k)
    }
    return none
}

func main() -> int64 {
    let a = find(2)
    let b = find(0)
    print_int(a?.n? or -1)
    print_int(b?.n? or -1)
    print(a?.up()? or "none")
    print(b?.up()? or "none")
    let x = 1
    let y = 2
    let z = 3
    print(f"{x == 1} {y == 1} {x != 1} {y != 1} {x + y + z}")
    let w = (a?.n? or 0) + (b?.n? or 10) + len(a?.up()? or "") * 100
    print(f"{w} {x} {y} {z}")
    return 0
}

// expected output:
// 2
// -1
// t2!
// none
// true false false true 6
// 312 1 2 3
