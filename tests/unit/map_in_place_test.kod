type Pt = struct {
    x: int64 = 0
    ys: [int64] = []
}

type Holder = shared struct {
    m: Map[str, [str]] = Map[str, [str]]()
}

type Log = shared struct {
    text: str = ""

    func at(self, anon tag: str, anon v: str) -> str {
        self.text = self.text + tag
        return v
    }
}

test "counting and grouping with a default" {
    let words = ["a", "bb", "a", "cc", "a"]
    mut counts = Map[str, int64]()
    mut groups = Map[int64, [str]]()
    for w in words {
        counts[w, default: 0] += 1
        groups[len(w), default: []] += [w]
    }
    assert f"{counts}" == "{a: 3, bb: 1, cc: 1}"
    assert f"{groups}" == "{1: [a, a, a], 2: [bb, cc]}"

    // Reading with a default doesn't add the key.
    assert counts["z", default: 7] == 7
    assert len(counts) == 3

    // The value another holder has is left alone.
    let before = groups
    groups[1, default: []] += ["d"]
    assert (before[1]? or []) == ["a", "a", "a"]
    assert (groups[1]? or []) == ["a", "a", "a", "d"]
}

test "elements and fields of entries" {
    // Without a default the key is there.
    mut pts = Map[str, Pt]()
    pts["p"] = Pt()
    pts["p"].x = 5
    pts["p"].ys += [1, 2]
    pts["p"].ys[0] = 9
    mut grid = Map[int64, [int64]]()
    grid[0] = [0, 0]
    grid[0][1] += 4
    let p = pts["p", default: Pt()]
    assert p.x == 5
    assert p.ys == [9, 2]
    assert f"{grid}" == "{0: [0, 4]}"
}

test "a map in a field of a shared struct, and maps of maps" {
    let h = Holder()
    h.m["k", default: []] += ["v"]
    h.m["k"] += ["w"]
    mut nested = Map[str, Map[str, int64]]()
    nested["a", default: Map[str, int64]()]["b", default: 0] += 3
    nested["a"]["b"] += 1
    assert f"{h.m}" == "{k: [v, w]}"
    assert f"{nested}" == "{a: {b: 4}}"
}

test "the map, the key, then the value" {
    let log = Log()
    mut m = Map[str, str]()
    m[log.at("k", "x"), default: ""] += log.at("v", "y")
    assert log.text == "kv"
    assert f"{m}" == "{x: y}"
}
