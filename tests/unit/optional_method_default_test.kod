// `x?.method(...)` fills the arguments it leaves out from the method's
// defaults, like an ordinary method call; a none receiver skips the call
// and its arguments.

type Counter = shared struct {
    value: int64

    func bump(self, by: int64 = 1, times: int64 = 1) -> int64 {
        self.value = self.value + by * times
        return self.value
    }
}

mut evaluated: int64 = 0

func noisy() -> int64 {
    evaluated += 1
    return 3
}

test "?. fills in the method's defaults" {
    let c: Counter? = Counter(value: 10)
    assert (c?.bump()? or -1) == 11
    assert (c?.bump(by: 2)? or -1) == 13
    assert (c?.bump(by: 1, times: 2)? or -1) == 15
    let gone: Counter? = none
    assert (gone?.bump()? or -1) == -1
    assert (gone?.bump(by: noisy())? or -1) == -1
    assert evaluated == 0
    assert (c?.bump(by: noisy())? or -1) == 18
    assert evaluated == 1
}
