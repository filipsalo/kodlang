// Tasks that wait for I/O, timers and child processes let the others run
// (docs/tasks.md).

import "arrays"
import "libc"
import "net/tcp"
import "posix"
import "posix" { Fd }
import "process"
import "stream" { IoError }
import "tasks"
import "time"
import "time" { Duration, monotonic_ns }
import "unsafe"

mut trace: [str] = []

func nap(anon ms: int64) -> int64 {
    time.sleep(Duration(ms: ms))
    return ms
}

func ms_since(anon t0: int64) -> int64 {
    return (monotonic_ns() - t0) / 1000000
}

test "tasks sleep at the same time" {
    let t0 = monotonic_ns()
    let a = spawn nap(100)
    let b = spawn nap(100)
    let c = spawn nap(100)
    assert a.wait() + b.wait() + c.wait() == 300
    let took = ms_since(t0)
    assert 100 <= took < 250
}

test "a task that gives way doesn't hold up one that sleeps" {
    let t0 = monotonic_ns()
    let sleeper = spawn nap(50)
    mut turns: int64 = 0
    for ms_since(t0) < 200 and turns < 100000000 {
        tasks.give_way()
        turns += 1
        if turns % 1000 == 0 {
            // The sleeper ends while this one is busy.
            if ms_since(t0) >= 60 {
                break
            }
        }
    }
    assert sleeper.wait() == 50
    assert ms_since(t0) < 200
}

func note(anon what: str) -> none {
    trace += [what]
}

func run_child() -> int64 or Error {
    let child = try process.start(["sleep", "0.2"], stdin: .Null, stdout: .Null, stderr: .Null)
    let status = try child.wait()
    note("child done")
    return status
}

func tick(anon n: int64) -> none {
    for i in 0..n {
        time.sleep(Duration(ms: 20))
        note(f"tick {i}")
    }
}

test "waiting for a child process lets the others run" {
    trace = []
    let t0 = monotonic_ns()
    let child = spawn run_child()
    spawn tick(3)
    assert must child.wait() == 0
    assert trace[0..3] == ["tick 0", "tick 1", "tick 2"]
    assert trace[3] == "child done"
    assert ms_since(t0) < 400
}

func serve_once(anon l: tcp.Listener) -> str or Error {
    let conn = try l.accept()
    let data = try conn.read(100)
    try conn.write(data)
    try conn.close()
    return kod_bytes_to_str(data)
}

test "a server and a client in one program" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let server = spawn serve_once(l)
    let conn = must tcp.connect("127.0.0.1", port: l.port())
    must conn.write(kod_str_to_bytes("ping"))
    // Without tasks waiting for I/O this read would hold up the server.
    let back = must conn.read(100)
    assert kod_bytes_to_str(back) == "ping"
    assert must server.wait() == "ping"
    must conn.close()
    must l.close()
}

func long_bytes(anon n: int64) -> bytes {
    mut s = "0123456789abcdef"
    for len(s) < n {
        s = s + s
    }
    return kod_str_to_bytes(s[0..n])
}

func send_all(anon conn: Fd, anon data: bytes) -> none or Error {
    try conn.write_all(data)
    try conn.close()
}

test "a write nobody reads doesn't hold up the other tasks" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let data = long_bytes(8000000)
    let client = must tcp.connect("127.0.0.1", port: l.port())
    let conn = must l.accept()
    let sender = spawn send_all(conn, data)
    let t0 = monotonic_ns()
    assert nap_task() == 20
    assert ms_since(t0) < 500
    // It goes on as it is read, and all of it comes.
    let back = must client.read_all()
    assert sender.wait() is Ok(_)
    assert back == data
    must client.close()
    must l.close()
}

func nap_task() -> int64 {
    let t = spawn nap(20)
    return t.wait()
}

test "a write to a full pipe doesn't hold up the other tasks" {
    let child = must process.start(["sh", "-c", "sleep 0.3; wc -c"], stdin: .Pipe, stdout: .Pipe, stderr: .Null)
    let data = long_bytes(300000)
    let sender = spawn send_all(child.stdin, data)
    let t0 = monotonic_ns()
    assert nap_task() == 20
    assert ms_since(t0) < 200
    let out = must child.stdout.read_all()
    assert kod_bytes_to_str(out).trim() == "300000"
    assert sender.wait() is Ok(_)
    assert must child.wait() == 0
}

test "with one task, a sleep just sleeps" {
    let t0 = monotonic_ns()
    time.sleep(Duration(ms: 30))
    assert ms_since(t0) >= 30
}

func accept_forever(anon l: tcp.Listener) -> none or Error {
    let conn = l.accept()
    if conn is Err(e) and e is IoError(io) and io.kind == .Cancelled {
        note("accept cancelled")
    }
    try conn
}

func give_up(anon l: tcp.Listener) -> none or Error {
    spawn accept_forever(l)
    time.sleep(Duration(ms: 20))
    throw IoError(kind: .InvalidInput, op: "give_up", errno: 0, detail: "no")
}

test "a function that returns an error cancels its tasks" {
    trace = []
    let l = must tcp.listen("127.0.0.1", port: 0)
    let t0 = monotonic_ns()
    assert give_up(l) is Err(_)
    assert trace == ["accept cancelled"]
    assert ms_since(t0) < 500
    must l.close()
}

func nap_then_note(anon ms: int64) -> none {
    time.sleep(Duration(ms: ms))
    note("woke")
}

func receive_or_note(anon ch: tasks.Channel[int64]) -> none {
    if ch.receive() is none {
        note("receive gave up")
    }
}

func fail_with_waiters(anon ch: tasks.Channel[int64]) -> none or Error {
    spawn nap_then_note(5000)
    spawn receive_or_note(ch)
    tasks.give_way()
    throw IoError(kind: .InvalidInput, op: "fail", errno: 0, detail: "no")
}

test "a cancelled task's sleep ends and its receive gives none" {
    trace = []
    let t0 = monotonic_ns()
    assert fail_with_waiters(tasks.Channel[int64]()) is Err(_)
    assert ms_since(t0) < 500
    assert arrays.contains(trace, "woke")
    assert arrays.contains(trace, "receive gave up")
}

func ok_after(anon ms: int64) -> int64 {
    time.sleep(Duration(ms: ms))
    return ms
}

test "within gives the result in time, or a timeout and cancels" {
    assert must tasks.within(Duration(ms: 500), func() -> int64 { return ok_after(10) }) == 10
    let t0 = monotonic_ns()
    let late = tasks.within(Duration(ms: 50), func() -> int64 { return ok_after(5000) })
    if late is Err(e) and e is IoError(io) {
        assert io.kind == .TimedOut
    } else {
        fail("no timeout")
    }
    assert ms_since(t0) < 500
}

func slow_value(anon ms: int64, anon value: int64) -> int64 or Error {
    time.sleep(Duration(ms: ms))
    return value
}

func slow_failure(anon ms: int64) -> int64 or Error {
    time.sleep(Duration(ms: ms))
    throw IoError(kind: .InvalidInput, op: "slow", errno: 0, detail: "failed")
}

test "tasks.all gives the results in order, at the same time" {
    let t0 = monotonic_ns()
    let got = must tasks.all([
        func() -> int64 or Error { return slow_value(60, 1) },
        func() -> int64 or Error { return slow_value(20, 2) },
        func() -> int64 or Error { return slow_value(40, 3) },
    ])
    assert got == [1, 2, 3]
    assert ms_since(t0) < 150
}

test "tasks.all gives the first error and cancels the rest" {
    let t0 = monotonic_ns()
    let got = tasks.all([
        func() -> int64 or Error { return slow_value(5000, 1) },
        func() -> int64 or Error { return slow_failure(20) },
    ])
    assert got is Err(_)
    assert ms_since(t0) < 500
}

test "tasks.first gives the first success and cancels the rest" {
    let t0 = monotonic_ns()
    let got = tasks.first([
        func() -> int64 or Error { return slow_value(5000, 1) },
        func() -> int64 or Error { return slow_failure(10) },
        func() -> int64 or Error { return slow_value(30, 3) },
    ])
    assert must got == 3
    assert ms_since(t0) < 500
    let none_ok = tasks.first([func() -> int64 or Error { return slow_failure(5) }])
    assert none_ok is Err(_)
}

mut running: int64 = 0
mut most: int64 = 0

func square_slowly(anon x: int64) -> int64 {
    running += 1
    if running > most {
        most = running
    }
    time.sleep(Duration(ms: 20))
    running -= 1
    return x * x
}

test "tasks.map_concurrently keeps the order and the limit" {
    most = 0
    let t0 = monotonic_ns()
    let got = tasks.map_concurrently([1, 2, 3, 4, 5, 6], square_slowly, limit: 3)
    assert got == [1, 4, 9, 16, 25, 36]
    assert most == 3
    assert ms_since(t0) < 120
}

func bump_slowly(anon m: tasks.Mutex) -> none {
    m.lock()
    let seen = counter
    time.sleep(Duration(ms: 10))
    counter = seen + 1
    m.unlock()
}

mut counter: int64 = 0

// Returns once the three have ended.
func bump_three(anon m: tasks.Mutex) -> none {
    spawn bump_slowly(m)
    spawn bump_slowly(m)
    spawn bump_slowly(m)
}

test "a Mutex keeps a value held across a wait" {
    counter = 0
    bump_three(tasks.Mutex())
    assert counter == 3
}

func later_send(anon ch: tasks.Channel[int64], anon ms: int64, anon value: int64) -> none {
    time.sleep(Duration(ms: ms))
    ch.send(value)
}

test "select takes whichever receive can go first" {
    let a = tasks.Channel[int64]()
    let b = tasks.Channel[int64]()
    spawn later_send(a, 80, 1)
    spawn later_send(b, 10, 2)
    mut got: int64 = 0
    select {
        receive(a) is x -> got = x? or -1
        receive(b) is y -> got = (y? or -1) * 10
    }
    assert got == 20
    // The other is still there to receive.
    assert must a.receive() == 1
}

test "select with else takes it when nothing can go" {
    let ch = tasks.Channel[int64]()
    mut which = ""
    select {
        receive(ch) -> which = "received"
        else -> which = "else"
    }
    assert which == "else"
}

test "select's after goes when nothing else has" {
    let ch = tasks.Channel[int64]()
    let t0 = monotonic_ns()
    mut which = ""
    select {
        receive(ch) -> which = "received"
        after(Duration(ms: 30)) -> which = "after"
    }
    assert which == "after"
    assert 30 <= ms_since(t0) < 300
}

func receive_into(anon ch: tasks.Channel[str], anon out: tasks.Channel[str]) -> none {
    out.send(must ch.receive())
}

test "select sends when a task waits to receive" {
    let ch = tasks.Channel[str]()
    let out = tasks.Channel[str](capacity: 1)
    spawn receive_into(ch, out)
    mut sent = false
    select {
        send(ch, "hello") -> sent = true
        after(Duration(ms: 500)) -> sent = false
    }
    assert sent
    assert must out.receive() == "hello"
}

test "select on a closed channel's receive gives none" {
    let ch = tasks.Channel[int64]()
    ch.close()
    mut closed = false
    select {
        receive(ch) is v -> closed = v is none
    }
    assert closed
}

test "select picks among ready arms at random" {
    let a = tasks.Channel[int64](capacity: 100)
    let b = tasks.Channel[int64](capacity: 100)
    for i in 0..100 {
        a.send(i)
        b.send(i)
    }
    mut from_a: int64 = 0
    for _ in 0..100 {
        select {
            receive(a) -> from_a += 1
            receive(b) -> from_a += 0
        }
    }
    assert 10 < from_a < 90
}

func read_with_timeout(anon conn: posix.Fd) -> str {
    must tcp.set_timeout(conn, timeout: Duration(ms: 50))
    let got = conn.read(10)
    if got is Err(e) and e is IoError(io) {
        return f"{io.kind}"
    }
    return "read"
}

test "a socket's timeout holds in a task, while the others run" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let conn = must tcp.connect("127.0.0.1", port: l.port())
    let peer = must l.accept()
    let t0 = monotonic_ns()
    let reader = spawn read_with_timeout(conn)
    let sleeper = spawn nap(200)
    assert reader.wait() == "TimedOut"
    let took = ms_since(t0)
    assert 50 <= took < 150
    assert sleeper.wait() == 200
    // A look at whether anything waits to be read doesn't wait.
    let other = spawn nap(10)
    assert tcp.is_idle(conn)
    assert other.wait() == 10
    must conn.close()
    must peer.close()
    must l.close()
}

mut slow_inits: int64 = 0

func slow_init() -> str {
    slow_inits += 1
    time.sleep(Duration(ms: 30))
    return "worked out"
}

// Its initializer waits, so a second task reads it while the first works it out.
mut worked_out: str = slow_init()

func read_worked_out() -> str {
    return worked_out
}

test "a module variable another task is initializing is waited for, not worked out again" {
    let a = spawn read_worked_out()
    let b = spawn read_worked_out()
    assert a.wait() == "worked out"
    assert b.wait() == "worked out"
    assert worked_out == "worked out"
    assert slow_inits == 1
}

mut flag_set: bool = false

func set_flag_later() -> none {
    time.sleep(Duration(ms: 20))
    flag_set = true
}

func spin_until_flag() -> int64 {
    let t0 = monotonic_ns()
    mut turns: int64 = 0
    for not flag_set and ms_since(t0) < 2000 {
        turns += 1
    }
    return ms_since(t0)
}

test "a task busy in a loop is preempted, so the others run" {
    flag_set = false
    let busy = spawn spin_until_flag()
    spawn set_flag_later()
    assert busy.wait() < 500
}

// Mixes integers and floats in registers across a loop, long enough to be
// preempted many times on the way.
func churn(anon n: int64) -> str {
    mut a: int64 = 1
    mut b: int64 = 2
    mut c: int64 = 3
    mut x: float64 = 0.5
    mut y: float64 = 1.5
    for i in 0..n {
        a = (a * 31 + i) % 1000003
        b = (b + a * 7) % 999983
        c = c ^ (a + b)
        x = x * 0.999 + (a % 100).to_float64() / 100.0
        y = y + x * 0.001
    }
    return f"{a} {b} {c} {x} {y}"
}

test "a preempted loop goes on with every register as it was" {
    let n: int64 = 10000000
    let alone = churn(n)
    let t0 = monotonic_ns()
    let first = spawn churn(n)
    let second = spawn churn(n)
    let third = spawn churn(n)
    assert first.wait() == alone
    assert second.wait() == alone
    assert third.wait() == alone
    // Long enough that each was preempted many times.
    assert ms_since(t0) > 50
}

type Holder = shared struct {
    xs: [int64]

    // Scans for the first 2, through `self.xs` at each step, with no call in
    // the loop that would make its loads be made again anyway.
    func first_two(self, anon from: int64) -> int64 {
        mut i = from
        for self.xs[i] != 2 {
            i = (i + 1) % 3
        }
        return i
    }
}

func replace_later(anon h: Holder) -> none {
    time.sleep(Duration(ms: 20))
    h.xs = [1, 2, 1]
}

test "after a preemption, a loop reads what another task stored" {
    let h = Holder(xs: [1, 1, 1])
    let t0 = monotonic_ns()
    let reader = spawn h.first_two(0)
    spawn replace_later(h)
    assert reader.wait() == 1
    assert ms_since(t0) < 500
}

type Filler = shared struct {
    xs: [int64]

    // Writes through `self.xs` at each step, long enough to be preempted,
    // with no call in the loop.
    func fill(self, anon n: int64) -> int64 {
        for k in 0..n {
            self.xs[k % 3] = 5
        }
        return n
    }
}

func swap_in_later(anon f: Filler) -> [int64] {
    time.sleep(Duration(ms: 10))
    let kept = [1, 2, 3]
    f.xs = kept
    time.sleep(Duration(ms: 20))
    return kept
}

test "after a preemption, a loop's write copies an array another task shares" {
    let f = Filler(xs: [0, 0, 0])
    let t0 = monotonic_ns()
    let swapper = spawn swap_in_later(f)
    let filler = spawn f.fill(100000000)
    assert swapper.wait() == [1, 2, 3]
    assert filler.wait() == 100000000
    assert f.xs == [5, 5, 5]
    assert ms_since(t0) > 30
}

func fill_local(anon n: int64, sent: tasks.Channel[[int64]]) -> [int64] {
    mut xs = [0, 0, 0]
    sent.send(xs)
    for k in 0..n {
        xs[k % 3] = 5
    }
    return xs
}

test "a preempted loop's writes to a local array stay its own" {
    let sent = tasks.Channel[[int64]](capacity: 1)
    let filler = spawn fill_local(100000000, :sent)
    let copy = must sent.receive()
    tasks.give_way()
    assert copy == [0, 0, 0]
    assert filler.wait() == [5, 5, 5]
    assert copy == [0, 0, 0]
}

func fib(anon n: int64) -> int64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

func woke_after(anon ms: int64, anon t0: int64) -> int64 {
    time.sleep(Duration(ms: ms))
    return ms_since(t0)
}

test "a task that recurses without a loop is preempted too" {
    let t0 = monotonic_ns()
    let busy = spawn fib(37)
    let sleeper = spawn woke_after(10, t0)
    assert sleeper.wait() < 50
    assert busy.wait() == 24157817
}

// How many bytes the file has, read until its end.
func read_to_end(anon path: str) -> int64 {
    let f = must posix.open_read(path)
    mut n: int64 = 0
    for true {
        let data = must f.read(65536)
        if len(data) == 0 {
            break
        }
        n += len(data)
    }
    must f.close()
    return n
}

test "a task reads a file to its end" {
    let path = f"/tmp/kod-tasks-io-{libc.getpid()}.txt"
    let f = must posix.create(path)
    mut text = "x"
    for len(text) < 100000 {
        text += text
    }
    must f.write_str(text)
    must f.close()
    let got = tasks.within(Duration(seconds: 2), func() -> int64 { return read_to_end(path) })
    let _ = libc.unlink(unsafe.c_str(path))
    assert (got? or -1) == 131072
}

test "a cancelled task doesn't read a file" {
    let reading = spawn read_after_cancel()
    tasks.give_way()
    reading.cancel()
    assert reading.wait() == "read: Operation canceled"
}

func read_after_cancel() -> str {
    time.sleep(Duration(seconds: 1))
    let f = must posix.open_read("stdlib/tasks.kod")
    let got = f.read(10)
    must f.close()
    if got is Err(e) {
        return e.to_str()
    }
    return "read"
}

// ---- closing what another task waits for ----

// How a read of `f` ends.
func reading(anon f: Fd) -> str {
    let got = f.read(100)
    if got is Err(e) {
        return e.to_str()
    }
    return f"{len(got)} bytes"
}

func filling(anon f: Fd) -> str {
    let piece = kod_str_to_bytes("x" + "0123456789abcdef".repeat(4096))
    for true {
        if f.write(piece) is Err(e) {
            return e.to_str()
        }
    }
    return ""
}

func accepting(anon l: tcp.Listener) -> str {
    let got = l.accept()
    if got is Err(e) {
        return e.to_str()
    }
    must got.close()
    return "accepted"
}

// Two ends of a connection.
func connected() -> [Fd] {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let accepted = spawn must_accept(l)
    let c = must tcp.connect("127.0.0.1", port: l.port())
    let s = accepted.wait()
    must l.close()
    return [c, s]
}

func must_accept(anon l: tcp.Listener) -> Fd {
    return must l.accept()
}

let GONE: str = "Bad file descriptor"

test "closing a connection wakes the task that reads it" {
    let ends = connected()
    let r = spawn reading(ends[0])
    time.sleep(Duration(ms: 20))
    let t0 = monotonic_ns()
    must ends[0].close()
    assert r.wait() == f"read: {GONE}"
    assert ms_since(t0) < 20
    must ends[1].close()
}

test "with a timeout too, long before it" {
    let ends = connected()
    must tcp.set_timeout(ends[0], timeout: Duration(seconds: 2))
    let r = spawn reading(ends[0])
    time.sleep(Duration(ms: 20))
    let t0 = monotonic_ns()
    must ends[0].close()
    assert r.wait() == f"read: {GONE}"
    assert ms_since(t0) < 20
    must ends[1].close()
}

test "closing wakes the task that writes, and the one that reads" {
    let ends = connected()
    let w = spawn filling(ends[0])
    let r = spawn reading(ends[0])
    time.sleep(Duration(ms: 50))
    must ends[0].close()
    assert w.wait() == f"write: {GONE}"
    assert r.wait() == f"read: {GONE}"
    must ends[1].close()
}

test "closing a listener wakes the task that accepts" {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let a = spawn accepting(l)
    time.sleep(Duration(ms: 20))
    must l.close()
    assert a.wait() == f"accept: {GONE}"
    // And again fails, rather than close what has the number now.
    assert l.close() is Err(_)
}

test "closing a pipe to a child wakes the task that reads it" {
    let child = must process.start(["sleep", "10"], stdout: .Pipe)
    let r = spawn reading(child.stdout)
    time.sleep(Duration(ms: 20))
    must child.stdout.close()
    assert r.wait() == f"read: {GONE}"
    must child.kill()
    let _ = child.wait()
}

test "a task that is woken doesn't read what has the number next" {
    let ends = connected()
    let r = spawn reading(ends[0])
    time.sleep(Duration(ms: 20))
    let number = ends[0].fd
    must ends[0].close()
    // Before it runs.
    let f = must posix.open_read("stdlib/tasks.kod")
    assert unsafe.c_int(libc.dup2(f.fd, number)) == number
    let next = Fd(fd: number)
    assert r.wait() == f"read: {GONE}"
    assert must next.read(10) == must (must posix.open_read("stdlib/tasks.kod")).read(10)
    must next.close()
    must f.close()
    must ends[1].close()
}

test "a descriptor's number used again is waited for as any" {
    for _i in 0..20 {
        let ends = connected()
        let r = spawn reading(ends[0])
        time.sleep(Duration(ms: 1))
        must ends[1].write_str("hello")
        assert r.wait() == "5 bytes"
        let again = spawn reading(ends[0])
        time.sleep(Duration(ms: 1))
        must ends[0].close()
        assert again.wait() == f"read: {GONE}"
        must ends[1].close()
    }
}

test "closing what nobody waits for any more" {
    let ends = connected()
    let r = spawn reading(ends[0])
    time.sleep(Duration(ms: 10))
    r.cancel()
    assert r.wait() == "read: Operation canceled"
    must ends[0].close()
    time.sleep(Duration(ms: 10))
    must ends[1].close()
}

// As `connected`, the server's end not blocking.
func half_nonblocking() -> [Fd] {
    let l = must tcp.listen("127.0.0.1", port: 0)
    let c = must tcp.connect("127.0.0.1", port: l.port())
    let s = must l.accept(nonblocking: true)
    must l.close()
    return [c, s]
}

func send_digits(anon f: Fd, anon n: int64) -> str {
    let piece = kod_str_to_bytes("0123456789".repeat(10000))
    mut left = n
    for left > 0 {
        must f.write_all(piece)
        left -= len(piece)
    }
    must f.close()
    return "sent"
}

// How much comes until the end, each read after a pause of `ms`.
func receive_digits(anon f: Fd, ms: int64) -> int64 {
    mut n: int64 = 0
    for true {
        if ms > 0 {
            time.sleep(Duration(:ms))
        }
        let got = must f.read(65536)
        if len(got) == 0 {
            return n
        }
        // All of it in order.
        assert got[0] == 48 + n % 10
        n += len(got)
    }
    return n
}

test "a nonblocking connection, in tasks" {
    let ends = half_nonblocking()
    let sent = spawn send_digits(ends[1], 5000000)
    assert receive_digits(ends[0], ms: 1) == 5000000
    assert sent.wait() == "sent"
    must ends[0].close()
    let others = half_nonblocking()
    let got = spawn receive_digits(others[1], ms: 0)
    assert send_digits(others[0], 5000000) == "sent"
    assert got.wait() == 5000000
    must others[1].close()
}

test "a nonblocking connection, with no other task" {
    let ends = half_nonblocking()
    must ends[0].write_str("hello")
    assert len(must ends[1].read(10)) == 5
    must ends[1].write_str("back")
    assert len(must ends[0].read(10)) == 4
    must ends[0].close()
    assert len(must ends[1].read(10)) == 0
    must ends[1].close()
    // What is yet to come, and a reader that is slow.
    let l = must tcp.listen("127.0.0.1", port: 0)
    let child = must process.start(["sh", "-c", f"(sleep 0.1; printf hello) | nc 127.0.0.1 {l.port()} | (sleep 0.1; wc -c)"], stdout: .Pipe)
    let conn = must l.accept(nonblocking: true)
    assert len(must conn.read(10)) == 5
    must conn.write_all(kod_str_to_bytes("x".repeat(3000000)))
    must conn.close()
    assert kod_bytes_to_str(must child.stdout.read(100)).trim() == "3000000"
    let _ = child.wait()
    must l.close()
}

test "a write that could go on is given up when its task is cancelled" {
    let ends = half_nonblocking()
    let taking = spawn receive_any(ends[0])
    let w = spawn filling(ends[1])
    time.sleep(Duration(ms: 30))
    w.cancel()
    assert w.wait() == "write: Operation canceled"
    must ends[1].close()
    assert taking.wait() > 0
    must ends[0].close()
}

func receive_any(anon f: Fd) -> int64 {
    mut n: int64 = 0
    for true {
        let got = must f.read(65536)
        if len(got) == 0 {
            return n
        }
        n += len(got)
    }
    return n
}

test "a nonblocking connection that is closed or goes away" {
    let ends = half_nonblocking()
    let w = spawn filling(ends[1])
    let r = spawn reading(ends[1])
    time.sleep(Duration(ms: 20))
    must ends[1].close()
    assert w.wait() == f"write: {GONE}" and r.wait() == f"read: {GONE}"
    must ends[0].close()
    let more = half_nonblocking()
    let w2 = spawn filling(more[1])
    time.sleep(Duration(ms: 20))
    must more[0].close()
    assert w2.wait().starts_with("write: ")
    must more[1].close()
}

test "waiting for what isn't open, or can't be waited for" {
    let r = spawn reading(Fd(fd: 4321))
    let w = spawn filling(Fd(fd: 4321))
    assert r.wait() == f"read: {GONE}" and w.wait() == f"write: {GONE}"
    // Closed by C, between the wait's beginning and the next look for events.
    let ends = connected()
    let late = spawn reading(ends[0])
    tasks.give_way()
    libc.close(ends[0].fd)
    assert late.wait() == f"read: {GONE}"
    must ends[1].close()
}

test "closed at once, its number taken by another that is read too" {
    for _i in 0..20 {
        let ends = connected()
        let r = spawn reading(ends[0])
        tasks.give_way()
        let number = ends[0].fd
        must ends[0].close()
        let others = connected()
        let again = spawn reading(others[0])
        tasks.give_way()
        must others[1].write_str("hello")
        assert again.wait() == "5 bytes"
        assert r.wait() == f"read: {GONE}"
        assert number > 0
        must others[0].close()
        must others[1].close()
        must ends[1].close()
    }
}

test "more tasks begin to wait at once than go along with one look" {
    mut pairs: [[Fd]] = []
    mut readers: [tasks.Task[str]] = []
    for _i in 0..100 {
        let ends = connected()
        pairs += [ends]
        readers += [spawn reading(ends[0])]
    }
    tasks.give_way()
    for ends in pairs {
        must ends[1].write_str("hi")
    }
    for r in readers {
        assert r.wait() == "2 bytes"
    }
    for ends in pairs {
        must ends[0].close()
        must ends[1].close()
    }
}

func nothing() -> int64 {
    return 0
}

test "a wait given up before the next look, among many" {
    mut pairs: [[Fd]] = []
    mut readers: [tasks.Task[str]] = []
    for _i in 0..80 {
        pairs += [connected()]
    }
    for ends in pairs {
        readers += [spawn reading(ends[0])]
    }
    // Lets them begin, without a look for events (as give_way would be).
    let _ = (spawn nothing()).wait()
    for i in [0, 40, 63, 64, 79] {
        readers[i].cancel()
        assert readers[i].wait() == "read: Operation canceled"
        readers[i] = spawn reading(pairs[i][0])
        let _ = (spawn nothing()).wait()
    }
    for ends in pairs {
        must ends[1].write_str("hi")
    }
    for r in readers {
        assert r.wait() == "2 bytes"
    }
    for ends in pairs {
        must ends[0].close()
        must ends[1].close()
    }
}
