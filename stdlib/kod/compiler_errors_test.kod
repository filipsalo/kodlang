}

test "a bad Map key is reported at the type argument that is the key" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Pt = struct { x: int64 }
        type Sq = struct { s: int64 }
        type Cell = struct { c: int64 }
        type Index[V, K] = struct { m: Map[K, V] = Map[K, V]() }
        type Rows[V, K] = struct { m: Map[[K], V] }
        type Box[T] = struct {
            v: T
            func count(self) -> int64 {
                let m = Map[T, int64]()
                return len(m)
            }
        }
        func count(anon i: Index[int64, Pt]) -> int64 {
            return len(i.m)
        }
        func rows(anon r: Rows[int64, str]) -> int64 {
            return len(r.m)
        }
        func main() -> int64 {
            let j = Index[str, Sq]()
            let b = Box[Cell](v: Cell(c: 1))
            return b.count() + len(j.m)
        }
        """)
    assert len(errs) == 4
    assert errs[0].message == "error: `Pt` can't be a `Map` key in `Index[int64, Pt]`; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[0].line == 13
    assert errs[0].col == 33
    assert errs[1].message == "error: `[str]` can't be a `Map` key in `Rows[int64, str]`; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[1].line == 16
    assert errs[1].col == 19
    assert errs[2].message == "error: `Sq` can't be a `Map` key in `Index[str, Sq]`; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[2].line == 20
    assert errs[2].col == 24
    assert errs[3].message == "error: `Cell` can't be a `Map` key in `Box[Cell]`; keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert errs[3].line == 9
    assert errs[3].col == 21
}

test "a bad key in a generic method names the instance only when its argument is the key" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Pt = struct { x: int64 }
        type Sq = struct { s: int64 }
        type Cell = struct { c: int64 }
        type Index[T] = struct { m: Map[T, int64] = Map[T, int64]() }
        type E[V, K] = enum {
            A(m: Map[K, V])
            B
        }
        type Nest[T] = struct {
            v: T
            func count(self) -> int64 {
                let i = Index[T]()
                return len(i.m)
            }
        }
        type Lit[T] = struct {
            v: T
            func count(self) -> int64 {
                let m = Map[Sq, T]()
                return len(m)
            }
        }
        type Tag[T] = struct {
            v: T
            func count(self) -> int64 {
                let e: E[str, T] = .B
                return 0
            }
        }
        func main() -> int64 {
            let n = Nest[Pt](v: Pt(x: 1))
            let l = Lit[str](v: "s")
            let t = Tag[Cell](v: Cell(c: 1))
            return n.count() + l.count() + t.count()
        }
        """)
    let keys = "keys are `int64`, `str`, `bytes`, `bool` or enums without payloads"
    assert len(errs) == 3
    assert errs[0].message == f"error: `Pt` can't be a `Map` key in `Index[Pt]`; {keys} (in `Nest[Pt]`)"
    assert errs[0].line == 12
    assert errs[1].message == f"error: `Sq` can't be a `Map` key; {keys} (in `Lit[str]`)"
    assert errs[1].line == 19
    assert errs[2].message == f"error: `Cell` can't be a `Map` key in `E[str, Cell]`; {keys} (in `Tag[Cell]`)"
    assert errs[2].line == 26
}

test "hashable Map keys and hashed values compile cleanly" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum { Red Green }
        type Keyed = struct { by_color: Map[Color, int64] = Map[Color, int64]() }
        type ByName = Map[str, Color]
        func main() -> int64 {
            let a = Map[str, int64]()
            let b = Map[int64, str]()
            let c = Map[bool, int64]()
            let d = Map[bytes, int64]()
            let e: ByName = ByName()
            let k = Keyed()
            k.by_color[.Red] = 1
            a["x"] = 1
            b[2] = "y"
            c[true] = 3
            d[b"z"] = 4
            e["r"] = .Red
            return hash(Color.Green) + hash(true) + hash("s") + hash(b"x") + hash(3) + len(a) + len(b) + len(c) + len(d) + len(e)
        }
        """)
    assert len(errs) == 0
}

test "a function that returns a value can't reach its end" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box[T] = struct {
            v: T
            func label(self) -> str {
                if len(f"{self.v}") > 3 {
                    return "long"
                }
            }
        }
        func no_else(anon d: bool) -> int64 {
            if d {
                return 1
            }
        }
        func each(anon xs: [int64]) -> int64 {
            for x in xs {
                return x
            }
        }
        func breaks(anon d: bool) -> int64 {
            for true {
                if d {
                    break
                }
            }
        }
        func maybe(anon n: int64) -> int64? {
            if n > 0 {
                return n
            }
        }
        func chain(anon n: int64) -> str {
            if n > 0 {
                return "pos"
            } else if n < 0 {
                return "neg"
            }
        }
        func spins() -> int64 {
            spin()
        }
        func spin() -> none {
            spin()
        }
        func main() -> int64 {
            let f = func(n: int64) -> int64 {
                if n > 0 {
                    return n
                }
            }
            let a = Box[int64](v: 1).label()
            let b = Box[str](v: "s").label()
            return 0
        }
        """)
    assert len(errs) == 8
    assert errs[0].message == "error: `no_else` can reach its end without returning a value; it returns `int64`, so add a `return` (or a `kod_panic(...)`) at the end"
    assert errs[0].line == 9
    assert errs[0].col == 6
    assert errs[1].message.contains("`each` can reach its end without returning a value")
    assert errs[2].message.contains("`breaks` can reach its end without returning a value")
    assert errs[3].message == "error: `maybe` can reach its end without returning a value; it returns `int64?`, so add a `return` (`return none` for no value) at the end"
    assert errs[4].message.contains("`chain` can reach its end without returning a value; it returns `str`")
    assert errs[5].message.contains("`spins` can reach its end without returning a value")
    assert errs[6].message.contains("this function literal can reach its end without returning a value")
    assert errs[7].message.contains("`Box.label` can reach its end without returning a value; it returns `str`")
    assert errs[7].line == 3
}

test "a `break` after a statement that ends every path doesn't leave the loop" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func spin() -> none {
            for true {
                kod_panic("x")
                break
            }
        }
        func after_spin() -> int64 {
            spin()
        }
        func after_return(anon n: int64) -> int64 {
            for true {
                if n > 0 {
                    return n
                    break
                }
                match n {
                    0 -> {
                        kod_panic("zero")
                        break
                    }
                    else -> continue
                }
            }
        }
        func live(anon n: int64) -> int64 {
            for true {
                if n > 0 {
                    print_int(n)
                    break
                }
            }
        }
        func main() -> int64 {
            return after_spin() + after_return(1) + live(2)
        }
        """)
    assert len(errs) == 1
    assert errs[0].message.contains("`live` can reach its end without returning a value")
}

test "an error in a generic instance's body names the instance once" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum { Red Green }
        type Box[T] = struct {
            v: T
            func less(self, anon other: T) -> bool {
                return self.v < other
            }
            func same(self) -> bool {
                return true
            }
        }
        type CB = Box[Color]
        type BB = Box[bool]
        func main() -> int64 {
            let b = CB(v: .Red)
            let s = BB(v: true)
            if b.same() and s.same() {
                return 0
            }
            return 1
        }
        """)
    assert len(errs) == 1
    assert errs[0].message == "error: `<` doesn't take `Color` operands (in `Box[Color]`)"
    assert errs[0].line == 5
}

test "reaching the end isn't reported on top of other errors" {
    let parse_errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f(anon x: int64) -> int64 {
            let y = [1, 2
            return x
        }
        """)
    assert len(parse_errs) == 1
    assert parse_errs[0].message == "error: expected `]`, got `return`"
    let typo_errs: [codegen.Diagnostic] = test_support.try_compile("""
        func g(anon x: int64) -> int64 {
            retrun x
        }
        """)
    assert len(typo_errs) == 1
    assert typo_errs[0].message.contains("unknown name `retrun`")
    let recovery_errs: [codegen.Diagnostic] = test_support.try_compile("""
        func double(anon x: int64) -> int64 {
            return x * 2
        }
        let g: func(int64) -> int64 = double
        """)
    assert len(recovery_errs) > 0
    assert test_support.any_message_contains(recovery_errs, needle: "can reach its end") == false
    let lambda_errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let f = func(x: int64) -> int64 { if x > 0 { return 1 } }
            return f(1)
        }
        """)
    assert len(lambda_errs) == 1
    assert lambda_errs[0].message.contains("this function literal can reach its end")
    assert lambda_errs[0].line == 2
    assert lambda_errs[0].col == 13
}

test "functions that return on every path compile cleanly" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Dir = enum { Up Down }
        type Err = struct {
            msg: str
            func to_str(self) -> str { return self.msg }
        }
        type P = struct {
            n: int64
            func fail(self, anon msg: str) -> none { kod_panic(msg) }
            func get(self) -> int64 {
                if self.n > 0 {
                    return self.n
                }
                self.fail("bad")
            }
        }
        func die(anon msg: str) -> none {
            kod_panic(msg)
        }
        func by_match(anon d: Dir) -> int64 {
            match d {
                .Up -> return 1
                .Down -> {
                    return 2
                }
            }
        }
        func spin(anon k: int64) -> int64 {
            for true {
                if k > 0 {
                    return k
                }
            }
        }
        func panics(anon n: int64) -> int64 {
            if n > 0 {
                return n
            }
            kod_panic("negative")
        }
        func helper_tail(anon n: int64) -> str {
            if n > 0 {
                return "pos"
            }
            die("negative")
        }
        func via_panic() -> int64 {
            panics_last()
        }
        func via_cycle() -> int64 {
            cycles_back()
        }
        func panics_last() -> none {
            cycles_back()
            kod_panic("done")
        }
        func cycles_back() -> none {
            panics_last()
        }
        func fallible(anon n: int64) -> none or Error {
            if n > 0 {
                throw Err(msg: "pos")
            }
        }
        func thrower(anon n: int64) -> int64 or Error {
            if n > 0 {
                return n
            }
            throw Err(msg: "neg")
        }
        func dead_code(anon n: int64) -> int64 {
            return n
            print("never")
        }
        func every_branch(anon n: int64) -> str {
            if n > 0 {
                return "pos"
            } else if n < 0 {
                return "neg"
            } else {
                return "zero"
            }
        }
        func unwrap(anon o: int64?) -> int64 {
            let .Some(v) = o else { return 0 }
            return v
        }
        func none_opt(anon n: int64) -> int64? {
            if n > 0 {
                return n
            }
            return none
        }
        func main() -> int64 {
            let p = P(n: 1)
            return by_match(.Up) + spin(1) + panics(1) + len(helper_tail(1)) + must thrower(1) + dead_code(1) + len(every_branch(1)) + unwrap(3) + (none_opt(1)? or 0) + p.get()
        }
        """)
    assert len(errs) == 0
}

test "bool conditions and operands compile cleanly" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let flags = 5
            let b = flags > 2
            let o: int64? = none
            if (flags & 1) != 0 and b == true {
                print("odd")
            }
            if (o is not none) or b != false {
                print("yes")
            }
            let n = o? or 3
            assert n == 3
            return 0
        }
        """)
    assert len(errs) == 0
}

test "an unwrap default of another type is an error" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum { Red Green }
        func main() -> int64 {
            let n: int64? = none
            let z = n? or "s"
            let c: Color? = none
            let d = c? or 3
            let e = c? or .Blue
            let f = n? or c? or 4
            let g = n? or kod_panic("no n")
            let h = n? or print("no n")
            return 0
        }
        """)
    assert len(errs) == 5
    assert test_support.any_message_contains(errs, needle: "expected `int64`, got `none`")
    assert test_support.any_message_contains(errs, needle: "expected `int64`, got `str`")
    assert test_support.any_message_contains(errs, needle: "expected `Color`, got `int64`")
    assert test_support.any_message_contains(errs, needle: "unknown implicit variant `.Blue`")
}

test "interpolating an optional suggests unwrapping it" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let n: int64? = 5
            print(f"n = {n}")
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `int64?` to `str`; unwrap it first with `n?` or `n? or default`")
}

test "unwrap hints name the optional value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type T = struct { s: str }
        func name_of(anon t: T?) -> str {
            return t?.s
        }
        func main() -> int64 {
            let m = Map[str, [int64]]()
            let xs = m.get("k")
            print_int(xs[0])
            print_int(m.get("k")[0])
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "cannot index a value of type `[int64]?`; unwrap it first with `xs?` or `xs? or default`")
    assert test_support.any_message_contains(errs, needle: "expected `str`, got `str?`; unwrap it first with `?` or `? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot index a value of type `[int64]?`; unwrap it first with `?` or `? or default`")
}

test "interpolating values that have no string form" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum {
            Red
            Green
        }
        type Plain = struct { x: int64 }
        interface Shape {
            func area(self) -> int64
        }
        type Square = struct {
            side: int64
            func area(self) -> int64 { return self.side * self.side }
        }
        func twice(anon n: int64) -> int64 { return n * 2 }
        func main() -> int64 {
            let c = Color.Red
            let xs = [1, 2]
            let p = Plain(x: 1)
            let sh: Shape = Square(side: 2)
            let f = twice
            print(f"{c}")
            print(f"{xs}")
            print(f"{p}")
            print(f"{sh}")
            print(str(f))
            return 0
        }
        """)
    assert len(errs) == 5
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `Color` to `str`")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `[int64]` to `str`")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `Plain` to `str`; `Plain` has no `to_str` method")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `Shape` to `str`; `Shape` doesn't declare `to_str`")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `func(int64) -> int64` to `str`")
}

test "a to_str that isn't func to_str(self) -> str can't be interpolated" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type P = struct {
            x: int64
            func to_str(self, pad: int64) -> str { return f"P{self.x + pad}" }
        }
        type Q = struct {
            x: int64
            func to_str(self) -> int64 { return self.x }
        }
        interface Counted {
            func to_str(self) -> int64
        }
        func show(anon c: Counted) -> none {
            print(f"{c}")
        }
        func main() -> int64 {
            print(f"{P(x: 1)}")
            print(str(Q(x: 2)))
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `P` to `str`; `P.to_str` isn't `func to_str(self) -> str`")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `Q` to `str`; `Q.to_str` isn't `func to_str(self) -> str`")
    assert test_support.any_message_contains(errs, needle: "cannot convert a value of type `Counted` to `str`; `Counted.to_str` isn't `func to_str(self) -> str`")
}

test "a type used as an interface must implement it" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
            func name(self, upper: bool) -> str
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s * self.s }
            func name(self, caps: bool = false) -> str { return "sq" }
        }
        type P = struct { x: int64 }
        type R = struct {
            w: int64
            func area(self, k: int64) -> int64 { return self.w * k }
            func name(self, upper: bool) -> str { return "r" }
        }
        type Boom = struct {
            code: int64
            func to_str(self) -> int64 { return self.code }
        }
        func total(anon s: Shape) -> int64 { return s.area() }
        func make() -> Shape { return P(x: 2) }
        func risky() -> int64 or Error { throw Boom(code: 1) }
        func main() -> int64 {
            let ok: Shape = Sq(s: 2)
            let a: Shape = P(x: 1)
            let b: Shape = 5
            let c: Shape = R(w: 1)
            print_int(total(P(x: 3)))
            let xs: [Shape] = [Sq(s: 1), P(x: 4)]
            let s: Stringable = Boom(code: 2)
            return 0
        }
        """)
    assert len(errs) == 8
    assert test_support.any_message_contains(errs, needle: "struct `P` doesn't implement interface `Shape`: missing method `area`")
    assert test_support.any_message_contains(errs, needle: "`int64` doesn't implement interface `Shape`: missing method `area`")
    assert test_support.any_message_contains(errs, needle: "struct `R` doesn't implement interface `Shape`: method `area` is `func(int64) -> int64`, not `func() -> int64`")
    assert test_support.any_message_contains(errs, needle: "struct `Boom` doesn't implement interface `Error`: method `to_str` is `func() -> int64`, not `func() -> str`")
    assert test_support.any_message_contains(errs, needle: "struct `Boom` doesn't implement interface `Stringable`: method `to_str` is `func() -> int64`, not `func() -> str`")
}

test "interpolating an interface that declares to_str is not an error" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Celsius = struct {
            degrees: int64
            func to_str(self) -> str { return f"{self.degrees}C" }
        }
        func main() -> int64 {
            let t: Stringable = Celsius(degrees: 21)
            print(f"{t}")
            return 0
        }
        """)
    assert len(errs) == 0
}

test "a let value of the wrong type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let x: int64 = "s"
            let f: bool = 1
            return 0
        }
        """)
    assert len(errs) == 2
    assert test_support.any_message_contains(errs, needle: "expected `int64`, got `str`")
    assert test_support.any_message_contains(errs, needle: "expected `bool`, got `int64`")
}

test "assigning a value of the wrong type" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { n: int64 }
        func main() -> int64 {
            mut x: int64 = 1
            x = "s"
            let b = Box(n: 1)
            b.n = "s"
            mut s = "a"
            s = none
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "expected `int64`, got `str`")
    assert test_support.any_message_contains(errs, needle: "expected `str`, got `none`")
}

test "values that fit the declared type compile cleanly" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Foo = struct {
            n: int64
            tag: int64? = none
        }
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        func twice(anon n: int64) -> int64 { return n * 2 }
        func main() -> int64 {
            let o: int64? = 5
            let gone: int64? = none
            let sh: Shape = Sq(s: 2)
            let shapes: [Shape] = [Sq(s: 1)]
            let foos: [Foo] = []
            let opts: [int64?] = [1, none]
            let opt: Option[int64] = .Some(value: 3)
            let f: func(int64) -> int64 = twice
            let foo = Foo(n: 1)
            foo.tag = 5
            foo.tag = none
            mut n: int64 = 0
            n = foo.n + 1
            return 0
        }
        """)
    assert len(errs) == 0
}

test "an unannotated generic enum constructor can't be inferred" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        func main() -> int64 {
            let m = Maybe.Just(value: 41)
            match m {
                .Just(value) -> print_int(value + 1)
                .Nothing -> print("nothing")
            }
            let c = .Just(value: 7)
            let n = Maybe.Nothing
            let r = Result.Ok(5)
            let o = Option.Some(3)
            if o is .Some(x) {
                print_int(x * 3)
            }
            match Maybe.Just(value: 1) {
                .Just(v) -> print_int(v)
                else -> {}
            }
            return 0
        }
        """)
    assert len(errs) == 6
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `m`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `c`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `n`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `r`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of `o`; add a type annotation")
    assert test_support.any_message_contains(errs, needle: "cannot infer the type of this expression; bind it to an annotated `let` first")
}

test "a value going to a declared type isn't told to get an annotation" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Named {
            func name(self) -> str
        }
        func make() -> Nope {
            return 1
        }
        func take(anon n: int64, o: int64?, i: Named) -> int64 {
            return n
        }
        func main() -> int64 {
            let b: int64 = make()
            return take(make(), o: make(), i: make()) + b
        }
        """)
    assert test_support.any_message_contains(errs, needle: "unknown type `Nope`")
    assert test_support.any_message_contains(errs, needle: "bind it to an annotated") == false
}

test "a generic enum constructor takes its type from where it goes" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        type MaybeInt = Maybe[int64]
        func show(anon m: Maybe[int64]) -> none {
            if m is .Just(v) {
                print_int(v)
            }
        }
        func make(anon n: int64) -> Maybe[int64] {
            if n > 0 {
                return Maybe.Just(value: n)
            }
            return .Nothing
        }
        func parse(anon n: int64) -> int64 or Error {
            return .Ok(value: n)
        }
        func main() -> int64 {
            let a: Maybe[int64] = Maybe.Just(value: 41)
            let b: Maybe[int64] = .Just(value: 1)
            let c: MaybeInt? = .Just(value: 2)
            show(a)
            show(Maybe.Just(value: 3))
            show(.Nothing)
            show(make(4))
            let o: Option[int64] = Option.Some(value: 5)
            return must parse(1)
        }
        """)
    assert len(errs) == 0
}

test "an alias target with wrong type arguments" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct { x: int64 }
        type Pair[A, B] = struct {
            first: A
            second: B
        }
        type B = Map[str]
        type C = [Map[str]]
        type D = Box[int64]
        type P = Pair
        func main() -> int64 {
            let b: B = Map[str, int64]()
            b.set("a", 1)
            print_int(b.len())
            let c: C = []
            print_int(c[0].len())
            let d: D = Box(x: 1)
            print_int(d.x)
            let p: P = Pair[int64, int64](first: 1, second: 2)
            print_int(p.first)
            let q = Pair[P, int64](first: p, second: 1)
            let r: B? = none
            return 0
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "`Map` expects 2 type arguments, got 1")
    assert test_support.any_message_contains(errs, needle: "`Box` is not generic")
    assert test_support.any_message_contains(errs, needle: "generic struct `Pair` needs type arguments: write `Pair[A, B]`")
}

test "an unresolved alias isn't reported again where it's used" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Pair[A, B] = struct {
            first: A
            second: B
        }
        type A = Nope
        func main() -> int64 {
            let p = Pair[A, int64](first: 1, second: 2)
            let r: A[int64] = 1
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown type `Nope`")
}

test "operators don't take optional operands" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let seen = Map[str, bool]()
            seen.set("a", true)
            if seen.get("a") == true {
                print("seen")
            }
            let ob: bool? = true
            if ob != false {
                print("ne")
            }
            let flag = true
            let oi: int64? = 1
            if flag == oi {
                print("x")
            }
            let n: int64? = 3
            if n == 3 {
                print("three")
            }
            let m = n + 1
            if n < 4 {
                print("lt")
            }
            if n == none or none != n {
                print("none")
            }
            if n? == 3 and (n? or 0) + 1 == 4 {
                print("ok")
            }
            return 0
        }
        """)
    assert len(errs) == 6
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool?` with `bool`; unwrap it first with `?` or `? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool?` with `bool`; unwrap it first with `ob?` or `ob? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot compare `bool` with `int64?`; unwrap it first with `oi?` or `oi? or default`")
    assert test_support.any_message_contains(errs, needle: "cannot compare `int64?` with `int64`; unwrap it first with `n?` or `n? or default`")
    assert test_support.any_message_contains(errs, needle: "`+` doesn't take an optional operand; unwrap it first with `n?` or `n? or default`")
    assert test_support.any_message_contains(errs, needle: "`<` doesn't take an optional operand; unwrap it first with `n?` or `n? or default`")
}

test "an optional in a comparison chain gets the unwrap hint of a value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let m = Map[str, int64]()
            if 0 < m.get("a") < 5 {
                print("a")
            }
            if m.get("b") < 5 < 9 {
                print("b")
            }
            return 0
        }
        """)
    assert len(errs) == 2
    assert errs[0].message == "error: `<` doesn't take an optional operand; unwrap it first with `?` or `? or default`"
    assert errs[0].line == 3
    assert errs[1].message == "error: `<` doesn't take an optional operand; unwrap it first with `?` or `? or default`"
    assert errs[1].line == 6
}

test "a value of unknown type doesn't cascade wherever it's used" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Box = struct {
            x: int64
            func get(self) -> int64 { return self.x }
        }
        interface Shower {
            func show(self) -> str
        }
        func take(anon s: str) -> none {
            print(s)
        }
        func takei(anon s: Shower) -> none {
            print(s.show())
        }
        func main() -> int64 {
            let b = Box(x: 1)
            mut w = b.nope()
            let z0 = w + 1
            let z1 = 1 + w.x
            let z2 = [w, w]
            print(f"{w + 1}")
            w.x = 5
            print_int(len(w))
            let z4 = w?.x
            let z5 = w?.m(1)
            let z6 = w(1)
            let z8 = match w {
                1 -> 2
                else -> 3
            }
            if w is none {
                print("none")
            }
            let .Some(r) = w else { return 1 }
            print_int(r.x)
            for q in w {
                print(q.name)
            }
            let s = w[1..2]
            w[0] = 1
            take(w)
            takei(w)
            let z9: int64? = w
            let z10: Shower = w
            if w == true and w {
                print("t")
            }
            let z12 = w? or 0
            let z13 = w.get()
            let z14 = w.x.y.z
            let z20 = hash(w)
            let z21 = [1, 2][w]
            w += 1
            return w
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "unknown method `nope` on `b`")
}

test "a parameter of unknown type doesn't cascade" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f(anon o: int64?) -> Strr {
            return o
        }
        func g(anon a: Strr) -> int64 {
            a.x = 1
            let n = [a]
            return len(a)
        }
        func h(anon a: Strr?) -> int64 {
            let v = a?.x
            return 0
        }
        func k(anon cb: func(Strr) -> int64) -> none {
            print(f"{cb}")
            if cb {
                print("cb")
            }
        }
        func main() -> int64 {
            return 0
        }
        """)
    assert len(errs) == 4
    for e in errs {
        assert e.message.contains("unknown type `Strr`")
    }
}

test "an uninferable value is reported where it's used" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Maybe[T] = enum {
            Just(value: T)
            Nothing
        }
        func take(anon n: int64) -> none {
            print_int(n)
        }
        func give() -> int64 {
            return Maybe.Just(value: 1)
        }
        func main() -> int64 {
            take(Maybe.Just(value: 2))
            mut n: int64 = 0
            n = Maybe.Nothing
            let xs = [1, Maybe.Just(value: 3)]
            return 0
        }
        """)
    assert len(errs) == 4
    for e in errs {
        assert e.message.contains("cannot infer the type of this expression")
    }
}

test "an implicit variant the expected enum doesn't declare" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Dir = enum {
            Left
            Right
        }
        type Move = enum {
            Up
            Down
        }
        func main() -> int64 {
            let d: Dir = .Up
            let o: Dir? = .Down
            let r: Result[int64, str] = .Some(value: 1)
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "enum `Dir` has no variant `Up`")
    assert test_support.any_message_contains(errs, needle: "enum `Dir` has no variant `Down`")
    assert test_support.any_message_contains(errs, needle: "enum `Result[int64, str]` has no variant `Some`")
}

test "try, must and ? need a fallible or optional value" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func f() -> int64 or Error {
            let n = 5
            let c = try n
            return c
        }
        func g(anon r: int64 or Error) -> int64 {
            return try r
        }
        func main() -> int64 {
            let n = 5
            let b = n? or 3
            let a = must n
            let o: int64? = 4
            let ok = must f() + (o? or 0) + o?
            return 0
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "`try` needs a `T or Error` value, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`try` only works in a function that returns `T or Error`")
    assert test_support.any_message_contains(errs, needle: "`?` needs an optional value, got `int64`")
    assert test_support.any_message_contains(errs, needle: "`must` needs a `T or Error` value, got `int64`")
}

test "match expression arms of different types" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        type Circle = struct {
            r: int64
            func area(self) -> int64 { return self.r }
        }
        func main() -> int64 {
            let k = 1
            let x = match k {
                1 -> "a"
                else -> 2
            }
            let s = match k {
                1 -> Sq(s: 2)
                else -> Circle(r: 1)
            }
            let n: str = match k {
                1 -> "a"
                else -> none
            }
            let ok: Shape = match k {
                1 -> Sq(s: 2)
                else -> Circle(r: 1)
            }
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "expected `str`, got `int64`")
    assert test_support.any_message_contains(errs, needle: "expected `Sq`, got `Circle`")
    assert test_support.any_message_contains(errs, needle: "expected `str`, got `none`")
}

test "a pattern naming another enum" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(radius: int64)
            Rect(w: int64, h: int64)
        }
        type Other = enum {
            Square
            Circle(r: int64, extra: int64)
        }
        func main() -> int64 {
            let s: Shape = .Circle(radius: 5)
            match s {
                Other.Square -> print("square")
                Shape.Circle(r) -> print_int(r)
                else -> print("else")
            }
            if s is Other.Circle(r, e) {
                print_int(r + e)
            }
            let n = match s {
                Other.Square -> 1
                else -> 2
            }
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "`Other.Square` is not a variant of `Shape`")
    assert test_support.any_message_contains(errs, needle: "`Other.Circle` is not a variant of `Shape`")
}

test "an implicit variant pattern from another enum" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Shape = enum {
            Circle(radius: int64)
            Rect(w: int64, h: int64)
        }
        type Other = enum {
            Square
            Circle(r: int64, extra: int64)
        }
        func main() -> int64 {
            let s: Shape = .Circle(radius: 5)
            match s {
                .Square -> print("square")
                .Circle(r) -> print_int(r)
                else -> print("else")
            }
            let n = match s {
                .Square -> 1
                else -> 2
            }
            let .Square = s else { return 1 }
            return 0
        }
        """)
    assert len(errs) == 3
    for e in errs {
        assert e.message.contains("enum `Shape` has no variant `Square`")
    }
}

test "a plain value where a `T or Error` is declared" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let r: int64 or Error = 3
            let ok: int64 or Error = .Ok(value: 3)
            return 0
        }
        """)
    assert len(errs) == 1
    assert test_support.any_message_contains(errs, needle: "expected `int64 or Error`, got `int64`; write `.Ok(value: ...)` for a successful result")
}

test ".Some and .None patterns on an optional" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        func main() -> int64 {
            let o: int64? = 5
            match o {
                .Some(v) -> print_int(v)
                .None -> print("none")
            }
            let n = match o {
                .Some(v) -> v
                .None -> 0
            }
            return n
        }
        """)
    assert len(errs) == 0
}

test "`is` binds tighter than `and` and `or`" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum {
            Red
            Green
        }
        func main() -> int64 {
            let f = true
            let o: int64? = none
            if f and o is none {
                print("both")
            }
            if o is not none or f {
                print("either")
            }
            let c: Color = .Red
            let red = c is .Red and o is none
            return 0
        }
        """)
    assert len(errs) == 0
}

test "an `is` pattern that binds inside a larger condition" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        type Color = enum {
            Red
            Green
        }
        func main() -> int64 {
            let f = true
            let o: int64? = 3
            mut v = 0
            if f and o is Some(v) {
                print_int(v)
            }
            let c: Color = .Red
            let r: int64 or Error = .Ok(value: 1)
            let a = c is .Blue
            let b = r is Some
            let d = o is .Ok
            return 0
        }
        """)
    assert len(errs) == 4
    assert test_support.any_message_contains(errs, needle: "`is` can't bind `v` here")
    assert test_support.any_message_contains(errs, needle: "enum `Color` has no variant `Blue`")
    assert test_support.any_message_contains(errs, needle: "`is` on a `T or Error` value takes `Ok` or `Err`")
    assert test_support.any_message_contains(errs, needle: "`is` on an optional takes `none` or `Some`")
}

test "function values match function types exactly" {
    let errs: [codegen.Diagnostic] = test_support.try_compile("""
        interface Shape {
            func area(self) -> int64
        }
        type Sq = struct {
            s: int64
            func area(self) -> int64 { return self.s }
        }
        func sq_area(anon s: Sq) -> int64 {
            return s.s
        }
        func shape_area(anon s: Shape) -> int64 {
            return s.area()
        }
        func get_int() -> int64 {
            return 1
        }
        func main() -> int64 {
            let f: func(Shape) -> int64 = sq_area
            let g: func() -> int64? = get_int
            let h: func(Shape) -> int64 = shape_area
            let fs: [func() -> int64?] = [get_int]
            return 0
        }
        """)
    assert len(errs) == 3
    assert test_support.any_message_contains(errs, needle: "expected `func(Shape) -> int64`, got `func(Sq) -> int64`")
    assert test_support.any_message_contains(errs, needle: "expected `func() -> int64?`, got `func() -> int64`")
}

test "an [int64] isn't another array type" {
