// One of two modules that declare types of the same names.
import "./type_names_far"

interface Sized {
    func size(self) -> int64
}

type Pt = struct {
    x: int64

    func size(self) -> int64 {
        return self.x
    }
}

type Shape = enum {
    Circle(r: int64)
    Dot
}

type Mode = enum {
    On
    Off
}

type Box[T] = struct {
    v: T

    func size(self) -> int64 {
        return 1
    }
}

type IntBox = Box[int64]
type Label = str
type Score = [int64]

type Maybe[T] = enum {
    Just(v: T)
    Nothing
}

type Oops = struct {
    code: int64

    func to_str(self) -> str {
        return f"pa oops {self.code}"
    }
}

type ArrBox = Box[[Pt]]
type OptBox = Box[Pt?]
type MapBox = Box[Map[str, Pt]]

func describe(anon l: Label) -> str {
    return f"pa label {l}"
}

func make(anon x: int64) -> Pt {
    return Pt(:x)
}

func boxed(anon x: int64) -> Sized {
    return IntBox(v: x)
}

func is_int_box(anon s: Sized) -> bool {
    return s is IntBox
}

func boxed_nested(anon which: int64) -> Sized {
    if which == 0 {
        return ArrBox(v: [Pt(x: 1)])
    }
    if which == 1 {
        return OptBox(v: none)
    }
    return MapBox(v: Map[str, Pt]())
}

func is_arr_box(anon s: Sized) -> bool {
    return s is ArrBox
}

func is_pt(anon s: Sized) -> bool {
    return s is Pt
}

func area(anon s: Shape) -> int64 {
    match s {
        .Circle(r) -> return r * 3
        .Dot -> return 0
    }
}

func fail(anon n: int64) -> int64 or Error {
    throw Oops(code: n)
}

func just(anon n: int64) -> Maybe[int64] {
    return .Just(v: n)
}

func far_pt() -> type_names_far.Pt {
    return type_names_far.Pt(z: 9)
}

// expected mode:
// skip
