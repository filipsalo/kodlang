// `let x = match ...` takes its arms' type, with each arm's own bindings.

type W = enum {
    I(value: int64)
    S(value: str)
}

type Item = struct {
    name: str
}

func show(anon w: W) -> str {
    match w {
        .I(value) -> return f"int {value}"
        .S(value) -> return f"str {value}"
    }
}

func label(anon w: W) -> str {
    let d = match w {
        .S(value) -> value
        .I(value) -> f"#{value}"
    }
    return d + "!"
}

func main() -> int64 {
    print(show(.I(value: 5)))
    print(label(.S(value: "hey")))
    print(label(.I(value: 7)))
    let k = 2
    let word = match k {
        1 -> "one"
        else -> "many"
    }
    print(word + "?")
    print(f"{word} {word.char_count()}")
    let items: [Item?] = [Item(name: "a"), none]
    for o in items {
        let n = match o {
            Some(it) -> it.name
            none -> "-"
        }
        print(n + n)
    }
    let flag = match k {
        2 -> true
        else -> false
    }
    print(f"{flag}")
    return 0
}

// expected output:
// int 5
// hey!
// #7!
// many?
// many 4
// aa
// --
// true
